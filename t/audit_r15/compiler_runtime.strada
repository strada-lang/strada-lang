use lib "lib";

package R15BinOv;
use overload '""' => "to_s";
func new(str $v) scalar { return bless({"v" => $v}, "R15BinOv"); }
func to_s(scalar $self) str { return $self->{"v"}; }

package R15TieUtf8;
func TIESCALAR(str $cls, str $v) scalar { return bless({"v" => $v}, $cls); }
func FETCH(scalar $self) scalar { return $self->{"v"}; }
func STORE(scalar $self, scalar $v) void { $self->{"v"} = $v; }

package R15TieHash;
func TIEHASH(str $cls) scalar { return bless({"d" => {}}, $cls); }
func FETCH(scalar $self, str $k) scalar { return $self->{"d"}->{$k}; }
func STORE(scalar $self, str $k, scalar $v) void { $self->{"d"}->{$k} = $v; }
func EXISTS(scalar $self, str $k) int { return exists($self->{"d"}, $k); }
func DELETE(scalar $self, str $k) scalar { return delete($self->{"d"}->{$k}); }
func FIRSTKEY(scalar $self) scalar {
    my scalar $d = $self->{"d"};
    my array @k = sort(keys(%{$d}));
    $self->{"iter"} = \@k;
    $self->{"idx"} = 0;
    if (size(@k) == 0) { return undef; }
    $self->{"idx"} = 1;
    return $k[0];
}
func NEXTKEY(scalar $self, str $last) scalar {
    my scalar $it = $self->{"iter"};
    my int $idx = $self->{"idx"};
    if ($idx >= size($it)) { return undef; }
    $self->{"idx"} = $idx + 1;
    return $it->[$idx];
}

package R15TieArray;
func TIEARRAY(str $cls, scalar $init) scalar { return bless({"a" => $init}, $cls); }
func FETCHSIZE(scalar $self) int { return size($self->{"a"}); }
func FETCH(scalar $self, int $i) scalar { return $self->{"a"}->[$i]; }
func STORE(scalar $self, int $i, scalar $v) void { $self->{"a"}->[$i] = $v; }

package R15FracCmp;
use overload "<=>" => "cmp_num", "cmp" => "cmp_str";
func new(num $v) scalar { return bless({"v" => $v}, "R15FracCmp"); }
func cmp_num(scalar $a, scalar $b, int $rev) num {
    my num $lhs = ref($a) eq "R15FracCmp" ? $a->{"v"} : ($a + 0.0);
    my num $rhs = ref($b) eq "R15FracCmp" ? $b->{"v"} : ($b + 0.0);
    my num $d = $lhs - $rhs;
    if ($rev) { return -$d; }
    return $d;
}
func cmp_str(scalar $a, scalar $b, int $rev) num {
    return cmp_num($a, $b, $rev);
}

package R15NumOv;
use overload "0+" => "to_n", '""' => "to_s";
func new(num $v) scalar { return bless({"v" => $v}, "R15NumOv"); }
func to_n(scalar $self) num { return $self->{"v"}; }
func to_s(scalar $self) str { return "" . $self->{"v"}; }

package R15FreeDtor;
func new(scalar $slot_holder, int $do_throw) scalar {
    return bless({"holder" => $slot_holder, "throw" => $do_throw}, "R15FreeDtor");
}
func DESTROY(scalar $self) void {
    my scalar $h = $self->{"holder"};
    if (defined($h->{"ref"}) && !defined(${$h->{"ref"}})) {
        $h->{"was_undef"} = 1;
    }
    $h->{"ran"} = $h->{"ran"} + 1;
    if ($self->{"throw"}) {
        die("r15_free_destroy_boom");
    }
}

package R15CseMut;
use overload "==" => "eq_op";
func new(scalar $h, str $nextv) scalar {
    return bless({"h" => $h, "nextv" => $nextv}, "R15CseMut");
}
func eq_op(scalar $self, scalar $other, int $rev) int {
    $self->{"h"}->{"k"} = $self->{"nextv"};
    return ($other == 1) ? 1 : 0;
}

package R15Parent;
func p(scalar $self) int { return 1; }

package R15Child;
inherit R15Parent;
func m(scalar $self) int { return 2; }

package main;

our array @g_r15_goto_arr = ();
our hash %g_r15_goto_hash = ();

__C__ {
static void *r15_ext_echo_ptr(void *p) { return p; }
}

extern "C" {
    func r15_ext_echo_ptr(scalar $p) scalar;
}

func r15_make_nan() num {
    my num $z = 0.0;
    __C__ {
        return strada_new_num(0.0 / 0.0);
    }
    return $z;
}

func check(int $ok, str $msg) void {
    if (!$ok) {
        die("FAIL: " . $msg);
    }
}

func r15_collect(str $tag, scalar ...@rest) scalar {
    my array @out = ($tag);
    my int $i = 0;
    while ($i < size(@rest)) {
        push(@out, $rest[$i]);
        $i = $i + 1;
    }
    return \@out;
}

func r15_ret_arr_undef() array {
    return undef;
}

func r15_goto_destructure_fwd(int $skip) int {
    try {
        if ($skip) {
            goto R15_FWD_DONE;
        }
        my ($x, $y) = ("a" . "b", "c" . "d");
        our array @g_r15_fwd_a = ($x, $y);
        our hash %g_r15_fwd_h = ("k" => $x);
    R15_FWD_DONE:
        return 100 + $skip;
    } catch ($e) {
        return -1;
    }
}

func r15_goto_destructure_back() int {
    my int $iter = 0;
    my str $acc = "";
R15_BACK_LOOP:
    my ($p, $q) = ("p" . $iter, "q" . $iter);
    our array @g_r15_goto_arr = ($p, $q);
    our hash %g_r15_goto_hash = ("v" => $p . $q);
    $acc = $acc . $g_r15_goto_arr[0] . $g_r15_goto_hash{"v"} . ";";
    $iter = $iter + 1;
    if ($iter < 2) {
        goto R15_BACK_LOOP;
    }
    return ($acc eq "p0p0q0;p1p1q1;") ? 1 : 0;
}

func r15_wrap_inc(int $x) int {
    my int $y = $x + 1;
    if ($y < $x) { return 1; }
    return 0;
}

func r15_wrap_peq(int $x) int {
    $x += 1;
    return ($x < 0) ? 1 : 0;
}

func r15_wrap_dec(int $x) int {
    my int $y = $x - 1;
    if ($y > $x) { return 1; }
    return 0;
}

func r15_wrap_meq(int $x) int {
    $x -= 1;
    return ($x > 0) ? 1 : 0;
}

func r15_wrap_nested(int $x) int {
    my int $z = ($x + 1) + 0;
    return ($z < 0) ? 1 : 0;
}

func main() int {
    # R15-RT1: strada_tr /s squeeze on 0xFF (pack builds raw 0xFF bytes without UTF-8 encoding)
    my str $tr1 = core::pack("CC", 255, 255);
    $tr1 =~ tr/a//cs;
    check(core::byte_length($tr1) == 1 && core::get_byte($tr1, 0) == 255, "R15-RT1 tr /cs \\xff\\xff");
    my str $tr2 = "a" . core::pack("CC", 255, 255);
    $tr2 =~ tr/a//cs;
    check(core::byte_length($tr2) == 2 && core::get_byte($tr2, 0) == 97 && core::get_byte($tr2, 1) == 255, "R15-RT1 tr /cs a\\xff\\xff");

    # R15-RT2: overload "" binary NUL and UTF-8 in strada_concat_multi / strada_to_str
    my str $u8_cafe = "café";
    utf8::decode($u8_cafe);
    my scalar $ov_nul = R15BinOv::new("ab\x00cd");
    my scalar $ov_u8 = R15BinOv::new($u8_cafe);
    my str $c_nul = "" . $ov_nul . "!";
    my str $c_u8 = "" . $ov_u8 . "!";
    check(length($c_nul) == 6 && $c_nul eq "ab\x00cd!", "R15-RT2 overload '' NUL in concat_multi");
    check(utf8::is_utf8($c_u8) == 1 && length($c_u8) == 5 && $c_u8 eq ($u8_cafe . "!"), "R15-RT2 overload '' UTF-8 in concat_multi");

    # R15-RT3: PCRE2 substitution embedded NUL in replacement and pattern with meta/flags
    my str $rx1 = "hello world";
    $rx1 =~ s/w.*/a\x00b/g;
    check(core::byte_length($rx1) == 9 && $rx1 eq "hello a\x00b", "R15-RT3 s///g embedded NUL repl");
    my str $rx2 = replace("x a\x00b y", "a\x00b", "p\x00q");
    check(core::byte_length($rx2) == 7 && $rx2 eq "x p\x00q y", "R15-RT3 replace embedded NUL pat+repl");
    my str $rx3 = regex_replace_all("cat bat", "a", "[\x00$&]");
    check(core::byte_length($rx3) == 13 && $rx3 eq "c[\x00a]t b[\x00a]t", "R15-RT3 regex_replace_all $& + NUL");

    # R15-RT4: length/substr/index UTF-8 on tied scalar and "" overload
    my scalar $tu = undef;
    tie($tu, "R15TieUtf8", $u8_cafe);
    check(length($tu) == 4, "R15-RT4 length tied utf8 got " . length($tu));
    check(substr($tu, 3, 1) eq "é", "R15-RT4 substr tied utf8");
    check(index($tu, "é") == 3, "R15-RT4 index tied utf8");
    check(length($ov_u8) == 4 && substr($ov_u8, 3, 1) eq "é" && index($ov_u8, "é") == 3, "R15-RT4 overload '' utf8 len/substr/index");
    untie($tu);

    # R15-RT5: tied hash NUL key, sort %tied_hash, sprintf @tied_arr
    my hash %th = ();
    tie(%th, "R15TieHash");
    $th{"a\x00b"} = "v_nul";
    $th{"b"} = "v_b";
    check(exists($th{"a\x00b"}) == 1 && $th{"a\x00b"} eq "v_nul", "R15-RT5 tied hash NUL exists/fetch");
    my array @ks = sort(keys(%th));
    check(size(@ks) == 2 && core::byte_length($ks[0]) == 3 && $ks[0] eq "a\x00b", "R15-RT5 tied hash NUL keys");
    my array @sh = sort(%th);
    check(size(@sh) == 4 && $sh[0] eq "a\x00b" && $sh[3] eq "v_nul", "R15-RT5 sort %tied_hash size=" . size(@sh));
    my str $del_v = delete($th{"a\x00b"});
    check($del_v eq "v_nul" && exists($th{"a\x00b"}) == 0, "R15-RT5 tied hash NUL delete");
    untie(%th);

    my array @ta = ();
    tie(@ta, "R15TieArray", ["AA", "BB"]);
    my str $sp_ta = sprintf("%s-%s", @ta);
    check($sp_ta eq "AA-BB", "R15-RT5 sprintf @tied_arr got: " . $sp_ta);
    untie(@ta);

    # R15-RT6: fractional <=> / cmp autogeneration + NaN
    my scalar $f1 = R15FracCmp::new(1.0);
    my scalar $f2 = R15FracCmp::new(1.5);
    check(($f1 < $f2) == 1 && ($f1 <= $f2) == 1 && ($f1 > $f2) == 0 && ($f1 >= $f2) == 0 && ($f1 == $f2) == 0 && ($f1 != $f2) == 1,
          "R15-RT6 fractional <=>");
    check(($f1 lt $f2) == 1 && ($f1 le $f2) == 1 && ($f1 gt $f2) == 0 && ($f1 ge $f2) == 0 && ($f1 eq $f2) == 0 && ($f1 ne $f2) == 1,
          "R15-RT6 fractional cmp");
    my scalar $fnan = R15FracCmp::new(r15_make_nan());
    check(($fnan < $f1) == 0 && ($fnan <= $f1) == 0 && ($fnan > $f1) == 0 && ($fnan >= $f1) == 0 && ($fnan == $f1) == 0 && ($fnan != $f1) == 1,
          "R15-RT6 NaN <=> autogen");
    check(($fnan lt $f1) == 0 && ($fnan eq $f1) == 0 && ($fnan ne $f1) == 1,
          "R15-RT6 NaN cmp autogen");

    # R15-RT7: 0+ numification overload
    my scalar $no = R15NumOv::new(42.5);
    check((0 + $no) == 42.5 && int($no) == 42 && ($no + 1.5) == 44.0, "R15-RT7 0+ overload");

    # R15-RT8: circular STRADA_REF deref throws instead of hanging
    my scalar $cyc1 = undef;
    my scalar $cyc2 = \$cyc1;
    $cyc1 = \$cyc2;
    my int $cyc_h_caught = 0;
    try { my scalar $hv = $cyc1->{"k"}; } catch ($ce1) { $cyc_h_caught = ($ce1 =~ /Circular reference/) ? 1 : 0; }
    my int $cyc_a_caught = 0;
    try { my scalar $av = $cyc1->[0]; } catch ($ce2) { $cyc_a_caught = ($ce2 =~ /Circular reference/) ? 1 : 0; }
    $cyc1 = undef;
    $cyc2 = undef;
    check($cyc_h_caught == 1 && $cyc_a_caught == 1, "R15-RT8 circular STRADA_REF caught");

    # R15-RT10: pack n/Z2 and n/Z0 preserve explicit width
    my str $pk2 = core::pack("n/Z2", "ab");
    my str $pk0 = core::pack("n/Z0", "");
    my str $pkstar = core::pack("n/Z*", "ab");
    check(core::byte_length($pk2) == 4 && core::get_byte($pk2, 0) == 0 && core::get_byte($pk2, 1) == 2 && core::byte_substr($pk2, 2, 2) eq "ab",
          "R15-RT10 pack n/Z2");
    check(core::byte_length($pk0) == 2 && core::get_byte($pk0, 0) == 0 && core::get_byte($pk0, 1) == 0,
          "R15-RT10 pack n/Z0");
    check(core::byte_length($pkstar) == 5 && core::get_byte($pkstar, 1) == 3 && core::get_byte($pkstar, 4) == 0,
          "R15-RT10 pack n/Z*");

    # R15-C1: multiline string + // defined-or on heredoc opener line
    my scalar $c1_u = undef;
    my str $c1_s = ($c1_u // "ml1
ml2") . "|" . <<'R15C1_END';
h1
h2
R15C1_END
    check($c1_s eq "ml1\nml2|h1\nh2", "R15-C1 multiline + // on heredoc opener");

    # R15-C3: goto_hoist_stmts_decls for NODE_DESTRUCTURE and @/% our
    check(r15_goto_destructure_fwd(1) == 101 && r15_goto_destructure_fwd(0) == 100, "R15-C3 goto fwd destructure/our");
    check(r15_goto_destructure_back() == 1, "R15-C3 goto back destructure/our");

    # R15-C4: int64 signed wraparound under -O0 and -O2
    my int $imax = 9223372036854775807;
    my int $imin = -9223372036854775807 - 1;
    check(r15_wrap_inc($imax) == 1 && r15_wrap_peq($imax) == 1 && r15_wrap_dec($imin) == 1 && r15_wrap_meq($imin) == 1 && r15_wrap_nested($imax) == 1,
          "R15-C4 int64 wraparound");

    # R15-C5: nested container ++/-- autovivification
    my hash %nh = ();
    my int $p1 = $nh{"a"}{"b"}++;
    my int $p2 = ++$nh{"a"}{"b"};
    my array @na = ();
    my int $p3 = $na[0][1]--;
    my int $p4 = ++$nh{"list"}[2]{"c"};
    check($p1 == 0 && $nh{"a"}{"b"} == 2 && $p2 == 2 && $na[0][1] == -1 && $p3 == 0 && $p4 == 1 && $nh{"list"}[2]{"c"} == 1,
          "R15-C5 nested ++/-- autovivification");

    # R15-C6: free(\$var) clears var before DESTROY and is exception safe
    my scalar $slot_holder = {"ran" => 0, "was_undef" => 0, "ref" => undef};
    my scalar $fobj1 = R15FreeDtor::new($slot_holder, 0);
    $slot_holder->{"ref"} = \$fobj1;
    core::free(\$fobj1);
    check(!defined($fobj1) && $slot_holder->{"ran"} == 1 && $slot_holder->{"was_undef"} == 1,
          "R15-C6 free clears slot before DESTROY");

    my scalar $slot_holder2 = {"ran" => 0, "was_undef" => 0, "ref" => undef};
    my int $threw = 0;
    try {
        my scalar $fobj2 = R15FreeDtor::new($slot_holder2, 1);
        $slot_holder2->{"ref"} = \$fobj2;
        core::free(\$fobj2);
    } catch ($fe) {
        $threw = ($fe =~ /r15_free_destroy_boom/) ? 1 : 0;
    }
    check($threw == 1 && $slot_holder2->{"ran"} == 1 && $slot_holder2->{"was_undef"} == 1,
          "R15-C6 throwing DESTROY inside free(\$var) safe");

    # R15-C10: try-block scope-exit throwing DESTROY must be caught by catch and run before finally
    my scalar $slot_holder3 = {"ran" => 0, "was_undef" => 0, "ref" => undef};
    my int $threw_scope = 0;
    my str $fin_order = "";
    try {
        my scalar $fobj3 = R15FreeDtor::new($slot_holder3, 1);
        $fin_order = "try";
    } catch ($fe3) {
        $threw_scope = ($fe3 =~ /r15_free_destroy_boom/) ? 1 : 0;
        $fin_order = $fin_order . ":catch(" . $slot_holder3->{"ran"} . ")";
    } finally {
        $fin_order = $fin_order . ":fin(" . $slot_holder3->{"ran"} . ")";
    }
    check($threw_scope == 1 && $fin_order eq "try:catch(1):fin(1)",
          "R15-C10 try-scoped throwing DESTROY caught before finally got: " . $fin_order);

    # R15-C7: variadic/spread preserves array_flatten_kind>=1 non-array values
    my scalar $col1 = r15_collect("k", reverse("abc"));
    my scalar $col2 = r15_collect("k", r15_ret_arr_undef(), "z");
    # reverse("abc") as a call argument is list context: the one-element list ("abc") (Perl)
    check(size($col1) == 2 && $col1->[1] eq "abc", "R15-C7 variadic reverse('abc')");
    check(size($col2) == 3 && !defined($col2->[1]) && $col2->[2] eq "z", "R15-C7 variadic undef array-typed");

    # R15-C8: emit_condition_cse exception + overload mutation safety
    my hash %hcse = ("k" => ("val" . "0"));
    my int $cse_caught = 0;
    try {
        if ($hcse{"k"} && (1 / 0) && $hcse{"k"}) {
            check(0, "unreachable");
        }
    } catch ($e8) {
        $cse_caught = 1;
    }
    check($cse_caught == 1, "R15-C8 CSE exception caught");
    my scalar $mut = R15CseMut::new(\%hcse, "mutated");
    my int $cse_mut_ok = 0;
    if ($hcse{"k"} && $mut == 1 && $hcse{"k"} eq "mutated") {
        $cse_mut_ok = 1;
    }
    check($cse_mut_ok == 1, "R15-C8 CSE overload mutation not stale");

    # R15-C9: extern "C" returning scalar pointer preserves address
    my int $cbuf = c::alloc(16);
    my int $cgot = r15_ext_echo_ptr($cbuf);
    check($cgot == $cbuf && $cbuf != 0, "R15-C9 extern C scalar pointer return");
    c::free($cbuf);

    # R15-VM1: can() and isa() universal + class string
    my scalar $co = bless({}, "R15Child");
    check($co->can("isa") == 1 && can($co, "can") == 1 && ("R15Child"->isa("R15Parent")) == 1 && ("R15Child"->can("p")) == 1,
          "R15-VM1 can/isa parity");
    check(("R15Parent"->isa("R15Child")) == 0 && (""->can("isa")) == 0, "R15-VM1 negative can/isa");

    say("AUDIT_R15_COMPILER_RUNTIME_OK");
    return 0;
}
