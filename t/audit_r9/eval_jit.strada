#!/usr/bin/env strada
# Cycle 9 Audit regression tests: R9-EVAL1, R9-JIT1, R9-JIT2

use lib "lib";
use Eval;
use Strada::JIT;

our int $g_fail = 0;

func check(int $cond, str $msg) void {
    if ($cond == 0) {
        say("FAIL: " . $msg);
        $g_fail = $g_fail + 1;
    }
}

func main() int {
    # R9-EVAL1: block comments /* ; { */, [/] char classes, our $g = init() stripping
    my scalar $ev1 = Strada::Interpreter::eval_string('
        /* block comment with ; and { and } */
        my str $s = "a/b";
        $s =~ s/[/]/_/g;
        my int $m = ("/" =~ /[/]+/) ? 1 : 0;
        $s . ":" . $m;
    ');
    check(("" . $ev1) eq "a_b:1", "R9-EVAL1 tree-walk /* */ and [/] char class: " . $ev1);

    my scalar $ev2 = Strada::Interpreter::eval_string('
        our int $r9_ev_bumps = 0;
        func r9_ev_bump() int {
            $r9_ev_bumps = $r9_ev_bumps + 1;
            return 77;
        }
        our int $r9_ev_g = r9_ev_bump();
        $r9_ev_g . ":" . $r9_ev_bumps;
    ');
    my scalar $ev3 = Strada::Interpreter::eval_string('($r9_ev_g + 3) . ":" . $r9_ev_bumps;');
    check(("" . $ev2) eq "77:1" && ("" . $ev3) eq "80:1",
          "R9-EVAL1 our persistence without re-running initializer");

    my scalar $vm1 = Strada::Interpreter::eval_string_vm('
        /* comment ; { } */
        my str $v = "x/y";
        $v =~ s/[/]/:/g;
        $v;
    ');
    check(("" . $vm1) eq "x:y", "R9-EVAL1 eval_string_vm /* */ and [/]: " . $vm1);
    Strada::Interpreter::reset();

    # R9-JIT1: is_balanced & eval with /* */, q/qr/s/tr, heredocs, } + / and //
    check(Strada::JIT::is_balanced("/* closed } */ my int \$a = 1;") == 1, "R9-JIT1 closed /* */");
    check(Strada::JIT::is_balanced("/* unclosed comment") == 0, "R9-JIT1 unclosed /* */");
    check(Strada::JIT::is_balanced("my str \$s = q{abc [};") == 1, "R9-JIT1 q{...}");
    check(Strada::JIT::is_balanced("my str \$s = q|unclosed") == 0, "R9-JIT1 unclosed q|...");
    check(Strada::JIT::is_balanced("my str \$h = <<EOF;\n{\nEOF\n") == 1, "R9-JIT1 closed heredoc");
    check(Strada::JIT::is_balanced("my str \$h = <<EOF;\n{\n") == 0, "R9-JIT1 unclosed heredoc");

    Strada::JIT::init();
    Strada::JIT::eval('func r9_jit_fn(scalar $h, scalar $x) int {
        /* block ; { } comment */
        if ($h->{"k"} / 2 > 0) {
            my str $t = "a/b";
            $t =~ s/[/]/-/g;
            my str $q = q{hello};
            my int $dv = $x // 7;
            if ($t eq "a-b" && $q eq "hello") {
                return ($h->{"k"} / 2) + $dv;
            }
        }
        return 0;
    }');
    my scalar $jf = Strada::JIT::eval('
        my hash %h = ("k" => 10);
        return r9_jit_fn(\%h, undef);
    ');
    check(($jf + 0) == 12, "R9-JIT1 JIT func with /* */ } / and //: got=" . $jf);

    # R9-JIT2: C-keyword REPL variables ($errno, $free, $default) and restoring undef
    Strada::JIT::eval('my int $errno = 11; my str $free = "ok"; my scalar $default = "init";');
    my scalar $kw1 = Strada::JIT::eval('return $errno . ":" . $free . ":" . $default;');
    check(("" . $kw1) eq "11:ok:init", "R9-JIT2 C keyword REPL vars persisted: got=" . $kw1);

    Strada::JIT::eval('$default = undef;');
    my scalar $kw2 = Strada::JIT::eval('return defined($default) ? "DEF" : "UNDEF";');
    check(("" . $kw2) eq "UNDEF", "R9-JIT2 undef restored across cells: got=" . $kw2);

    Strada::JIT::reset();

    if ($g_fail == 0) {
        say("R9_EVAL_JIT_OK");
        return 0;
    }
    return 1;
}
