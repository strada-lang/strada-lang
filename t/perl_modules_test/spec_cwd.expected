canon [a//b] -> [a/b]
canon [/a/./b/] -> [/a/b]
canon [./a] -> [a]
canon [./] -> [.]
canon [/../../x] -> [/x]
canon [/..] -> [/]
canon [a/../b] -> [a/../b]
