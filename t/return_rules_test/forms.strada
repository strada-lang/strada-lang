around "hooked" func(scalar $orig, scalar $self) scalar { return $orig->($self); }
func AUTOLOAD(scalar $self, str $m, scalar ...@r) scalar { if ($m eq "au_list") { return (1, 2, 3); } return [1, 2, 3]; }
