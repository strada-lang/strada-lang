use lib "tools/stradapm";
use SemVer;
use Manifest;
use Resolver;

func main(int $argc, array @argv) int {
    my str $work_dir = $argc > 1 ? $argv[1] : "/tmp";
    my int $fail = 0;

    if (StradaPM::SemVer::satisfies("1.4.2", "^1.2.0") != 1 || StradaPM::SemVer::satisfies("2.0.0", "^1.2.0") != 0) {
        say("FAIL: StradaPM::SemVer::satisfies");
        $fail++;
    }
    my str $toml = "[package]\nname = \"spm\"\nversion = \"0.3.0\"\n\n[dependencies]\nutil = \"^2.0.0\"\n";
    my scalar $m = StradaPM::Manifest::parse_string($toml);
    if (StradaPM::Manifest::get_name($m) ne "spm" || StradaPM::Manifest::get_version($m) ne "0.3.0") {
        say("FAIL: StradaPM::Manifest::parse_string");
        $fail++;
    }
    my str $deps = $work_dir . "/spm_deps";
    my str $udir = $deps . "/util-2.1.0";
    core::mkdir($deps, 493);
    core::mkdir($udir, 493);
    core::spew($udir . "/Strada.toml", "[package]\nname = \"util\"\nversion = \"2.1.0\"\n");
    my scalar $res = StradaPM::Resolver::resolve($m, $deps);
    if (!defined($res) || !defined($res->{"util"}) || $res->{"util"}->{"version"} ne "2.1.0") {
        say("FAIL: StradaPM::Resolver::resolve");
        $fail++;
    }

    if ($fail == 0) {
        say("ALL_STRADAPM_OK");
        return 0;
    }
    return 1;
}
