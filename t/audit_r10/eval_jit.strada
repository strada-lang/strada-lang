#!/usr/bin/env strada
# Cycle 10 Audit regression tests: R10-VM5, R10-VM6, R10-VM10 (Eval VM)

use lib "lib";
use Eval;

our int $g_fail = 0;

func check(int $cond, str $msg) void {
    if ($cond == 0) {
        say("FAIL: " . $msg);
        $g_fail = $g_fail + 1;
    }
}

func check_eval(str $code, str $expected, str $label) void {
    my scalar $ev = Strada::Interpreter::eval_string($code);
    my scalar $vm = Strada::Interpreter::eval_string_vm($code);
    my str $ev_s = defined($ev) ? ("" . $ev) : "<UNDEF>";
    my str $vm_s = defined($vm) ? ("" . $vm) : "<UNDEF>";
    check($ev_s eq $expected && $vm_s eq $expected,
          $label . " (exp=" . $expected . " ev=" . $ev_s . " vm=" . $vm_s . ")");
}

func main() int {
    # R10-VM10: trailing non-expression statement return in eval_string / eval_string_vm
    check_eval('if (1) { 42; }', "42", "R10-VM10 trailing if true");
    check_eval('if (0) { 42; }', "<UNDEF>", "R10-VM10 trailing if false without else");
    check_eval('if (0) { 1; } else { 99; }', "99", "R10-VM10 trailing if false with else");
    check_eval('my int $x = 7;', "7", "R10-VM10 trailing my int decl");
    check_eval('our int $y = 11;', "<UNDEF>", "R10-VM10 top-level our decl");
    check_eval('if (1) { my int $z = 11; }', "11", "R10-VM10 trailing my int in if");
    check_eval('our int $y2 = 12; $y2;', "12", "R10-VM10 persistent our global readback");
    check_eval('{ 55; }', "55", "R10-VM10 trailing block");
    check_eval('while (0) { 1; }', "<UNDEF>", "R10-VM10 trailing while");
    check_eval('my int $a = 10; if (1) { my int $b = $a + 5; }', "15", "R10-VM10 trailing local var in if");

    # R10-VM5: 3-arg split in Eval
    check_eval('join("|", split(",", "a,b,c,d", 2))', "a|b,c,d", "R10-VM5 split limit positive");
    check_eval('join("|", split(",", "a,,", -1))', "a||", "R10-VM5 split limit negative");

    # R10-VM6: multi-arg die() & structured ref die() in Eval
    my str $die_code = '
        my str $out = "";
        try { die("hello ", "world", "!"); } catch ($e) { $out = "" . $e; }
        try { die({"code" => 404}); } catch ($e) { $out = $out . "|" . ref($e) . ":" . $e->{"code"}; }
        $out;
    ';
    check_eval($die_code, "hello world!|HASH:404", "R10-VM6 multi-arg die & ref die");

    Strada::Interpreter::reset();
    if ($g_fail == 0) {
        say("R10_EVAL_JIT_OK");
        return 0;
    }
    return 1;
}
