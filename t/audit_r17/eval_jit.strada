# Cycle 17 Eval, VM, JIT, YAML, JSON::PS Regression Suite
use lib "lib";
use Eval;
use Strada::JIT;
use YAML;
use JSON::PS;

package R17JpsTie;
func TIESCALAR(str $cls, scalar $v) scalar {
    return bless({"v" => $v, "f" => 0}, $cls);
}
func FETCH(scalar $s) scalar {
    $s->{"f"} = $s->{"f"} + 1;
    return $s->{"v"};
}
func STORE(scalar $s, scalar $val) void {
    $s->{"v"} = $val;
}

package main;

func check(int $cond, str $msg) void {
    if (!$cond) {
        say("FAIL: " . $msg);
        core::exit(1);
    }
}

func main() int {
    Strada::Interpreter::reset();

    # B9 & B10: worker VMs with weakrefs, cyclic objects, and concurrent root GC
    my scalar $vm_wres = Strada::Interpreter::eval(q{
        package R17VmObj;
        func new(str $v) scalar { return bless({"v" => $v}, "R17VmObj"); }
        package main;

        my array @gw = (undef, undef, undef, undef);
        my array @th_list = ();
        for (my int $i = 0; $i < 4; $i = $i + 1) {
            my int $idx = $i;
            push(@th_list, thread::create(func () scalar {
                my scalar $c1 = {};
                my scalar $c2 = {};
                $c1->{"n"} = $c2;
                $c2->{"p"} = $c1;
                my scalar $temp_w_target = R17VmObj::new("w" . $idx);
                $gw[$idx] = $temp_w_target;
                core::weaken($gw[$idx]);

                my scalar $live_obj = R17VmObj::new("L" . $idx);
                my scalar $wl = $live_obj;
                core::weaken($wl);
                for (my int $k = 0; $k < 200; $k = $k + 1) {
                    my scalar $churn = {"k" => $k};
                }
                my str $tag = defined($wl) ? $wl->{"v"} : "DEAD";
                return [$tag, $live_obj, $wl];
            }));
        }
        core::gc_collect();
        core::gc_collect();
        my int $ok = 1;
        for (my int $i = 0; $i < 4; $i = $i + 1) {
            my scalar $res = thread::join($th_list[$i]);
            if ($res->[0] ne "L" . $i || !defined($res->[2]) || $res->[2]->{"v"} ne "L" . $i) {
                $ok = 0;
            }
            $res->[1] = undef;
        }
        # Worker exited & transferred has_weakrefs + objects to root; root GC must clear $gw[$i]
        core::gc_collect();
        for (my int $i = 0; $i < 4; $i = $i + 1) {
            if (defined($gw[$i])) {
                $ok = 0;
            }
        }
        $ok;
    });
    check($vm_wres == 1, "B9/B10 worker VMs weakrefs & concurrent GC");

    # B11: VM forward goto cleans exited block locals/destructors
    my scalar $vm_goto = Strada::Interpreter::eval(q{
        package R17GotoDtor;
        our $destroyed = 0;
        func reset() void { $destroyed = 0; }
        func count() int { return $destroyed; }
        func new() scalar { return bless({}, "R17GotoDtor"); }
        func DESTROY(scalar $self) void { $destroyed = $destroyed + 1; }
        package main;

        R17GotoDtor::reset();
        my int $runs = 0;
        if (1) {
            my scalar $d1 = R17GotoDtor::new();
            $runs = $runs + 1;
            goto FWD_OUT;
        }
        $runs = $runs + 100;
    FWD_OUT:
        core::gc_collect();
        my int $seen = R17GotoDtor::count();
        my int $bk = 0;
    BACK_LBL:
        $bk = $bk + 1;
        if ($bk < 3) { goto BACK_LBL; }
        $runs . ":" . $seen . ":" . $bk;
    });
    check($vm_goto eq "1:1:3", "B11 VM forward goto cleans block local dtor got=" . $vm_goto);

    # B12: VM 0-param callables clamp excess args across call paths
    my scalar $vm_z = Strada::Interpreter::eval(q{
        package R17ZeroM;
        func z() int { return 77; }
        func inst_z(scalar $self) int { return 88; }
        package main;

        func z0() int { return 55; }
        my scalar $cl = func () int { return 66; };
        my scalar $obj = bless({}, "R17ZeroM");
        my str $mname = "inst_z";
        z0(1, 2, 3) . ":" . R17ZeroM::z(4, 5) . ":" . $cl->(6, 7) . ":" . $obj->$mname(8, 9);
    });
    check($vm_z eq "55:77:66:88", "B12 VM 0-param clamp got=" . $vm_z);

    # B15: Eval multiline heredocs & regexes containing quotes/;/#
    my scalar $ev1 = Strada::Interpreter::eval(
        "my str \$s = \"a;b\";\n" .
        "my int \$r = (\$s =~ /['\";#]/) ? 1 : 0;\n" .
        "my str \$h1 = <<'R17_E1';\nalpha;beta\n{ \"x\" }\nR17_E1\n" .
        "\$r . \":\" . \$h1"
    );
    check($ev1 eq "1:alpha;beta\n{ \"x\" }", "B15 eval multiline regex + heredoc got=" . $ev1);

    my scalar $ev2 = Strada::Interpreter::eval(
        "my int \$x = 1;\nmy str \$h2 = <<\"R17_E2\"\nlineA\nR17_E2"
    );
    check($ev2 eq "lineA", "B15 eval final heredoc without trailing semi got=" . $ev2);

    # B16: Strada::JIT my ($a, $b) = ... persistence & multiline heredocs
    Strada::JIT::init();
    Strada::JIT::eval('my ($ja, $jb) = (11, 31);');
    my scalar $j_sum = Strada::JIT::eval('$ja + $jb');
    my scalar $ja_v = Strada::JIT::get("ja");
    my scalar $jb_v = Strada::JIT::get("jb");
    check($j_sum == 42 && $ja_v == 11 && $jb_v == 31,
          "B16 JIT my ($a, $b) destructure persisted");

    my scalar $j_hd = Strada::JIT::eval(
        "my str \$jh = <<'R17_J1';\nfirst;\nsecond\nR17_J1\nreturn \$jh;"
    );
    check($j_hd eq "first;\nsecond\n", "B16 JIT heredoc statement got=" . $j_hd);
    my scalar $j_hd2 = Strada::JIT::eval(
        "my str \$k = <<'R17_J2';\nsemi;\nR17_J2\n\$k . \"!\""
    );
    check($j_hd2 eq "semi;\n!", "B16 JIT trailing expr after heredoc got=" . $j_hd2);
    Strada::JIT::reset();

    # B19: YAML block scalar trailing comment / doc markers vs under-indent error
    my scalar $y_ok = YAML::Load("doc:\n  msg: |\n    line1\n    line2\n# trailing comment\n---\n");
    check($y_ok->{"doc"}->{"msg"} eq "line1\nline2\n", "B19 YAML valid block scalar + comment + ---");

    my int $y_threw = 0;
    try {
        YAML::Load("doc:\n  msg: |\n    indented\n   under\n");
    } catch ($ye) {
        if (index($ye, "block scalar line indented less than block indent") >= 0) {
            $y_threw = 1;
        }
    }
    check($y_threw == 1, "B19 YAML under-indented block scalar throws parse error");

    # B20: JSON::PS is_bool and encode unwrap tied scalars
    my scalar $tb_true = "";
    my scalar $tb_false = "";
    my scalar $tb_str = "";
    my scalar $ot = tie($tb_true, "R17JpsTie", JSON::PS::true());
    my scalar $of = tie($tb_false, "R17JpsTie", JSON::PS::false());
    my scalar $os = tie($tb_str, "R17JpsTie", "ok");
    check(JSON::PS::is_bool($tb_true) == 1 && JSON::PS::is_bool($tb_false) == 1 && JSON::PS::is_bool($tb_str) == 0,
          "B20 JSON::PS::is_bool unwraps tied scalars");
    my str $jenc = JSON::PS::encode({"t" => $tb_true, "f" => $tb_false, "s" => $tb_str});
    check(index($jenc, "\"t\":true") >= 0 && index($jenc, "\"f\":false") >= 0 && index($jenc, "\"s\":\"ok\"") >= 0,
          "B20 JSON::PS::encode handles tied scalars got=" . $jenc);
    untie($tb_true);
    untie($tb_false);
    untie($tb_str);

    Strada::Interpreter::reset();
    say("AUDIT_R17_EVAL_JIT_OK");
    return 0;
}
