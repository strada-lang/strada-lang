# EXPECT: 3 1 2 9 3 3 3 9 0 2 3 c 10,12,14 1|3 2 2 9 3 5 3 9 1 4 3 c 10,12,14 2
# { %base, k => 1 }, { $t ? (k => 1) : (), z => 2 }, { f() } and
# { map {...} @a } build a hash from the list (they were parse errors);
# `my $n = (7, 8, 9)` is the last item with every item evaluated;
# foreach over `$t ? @a : @b` aliases the chosen array's elements.
our int $calls = 0;
func bump() int { $calls++; return 4; }
func pairs() array { return ("p", 1, "q", 2); }
func main() int {
    my array @OUT = ();
    my array @m = (5, 6, 7);
    my array @o = (1);
    my hash %base = (q => 1, r => 2);
    my $br = \%base;
    foreach my $t (0, 1) {
        my $h1 = { %base, k => 1 };
        my $h2 = { $t ? (k => 1) : (), z => 2 };
        my $h3 = { pairs() };
        my $h4 = { %$br, q => 9, "x" . $t => 1 };
        my $h5 = { a => 1, (b => 2, c => 3), $t ? %base : () };
        my $h6 = { map { $_ => 1 } @m };
        my $n = (7, 8, 9);
        my $c; $c = (bump(), bump(), $t);
        my hash %st = (); $st{"k"} = (1, 2, @m);
        my $q = qw(a b c);
        foreach my $v ($t ? @o : @m) { $v = $v * 2; }
        push(@OUT, join(" ", scalar(keys(%$h1)), scalar(keys(%$h2)), scalar(keys(%$h3)), $h4->{"q"}, scalar(keys(%$h4)), scalar(keys(%$h5)), scalar(keys(%$h6)), $n, $c, $calls, $st{"k"}, $q, join(",", @m), join(",", @o)));
    }
    say(join("|", @OUT));
    return 0;
}
