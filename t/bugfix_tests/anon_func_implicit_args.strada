# EXPECT: 3:1,2,3:2:topicK 0:::topicK a/b+c/2 z//0 42|1:7::7K,1:8::8K
# Anonymous `func { ... }` / `fn { ... }` without a parameter list (Perl's
# `sub { }`) take their arguments in @_, and `func ($a, ...@rest)` collects
# the rest; both were parse errors.
func main() int {
    my $k = "K";
    $_ = "topic";
    my $f = func { return scalar(@_) . ":" . join(",", @_) . ":" . $_[1] . ":" . $_ . $k; };
    my $g = func ($a, ...@rest) { return $a . "/" . join("+", @rest) . "/" . scalar(@rest); };
    my $h = fn { my $x = shift; return $x * 2; };
    my $line = $f->(1, 2, 3) . " " . $f->() . " " . $g->("a", "b", "c") . " " . $g->("z") . " " . $h->(21);
    my @l = map { $f->($_) } (7, 8);
    say($line . "|" . join(",", @l));
    return 0;
}
