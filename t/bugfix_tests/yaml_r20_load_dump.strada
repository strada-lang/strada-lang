# EXPECT: plain continued|2|x,y;z|233,32,133,32,27,32,160,32,8232,32,8233,32,7,32,11,32,32,128512,128512|  two-indented\n| x\n  y|  x\n\n|undef,1,undef|[]\n|{}\n|ARRAY0|HASH0|num,num,int|ERR
# Audit 20 S2-4..S2-10: YAML::Load truncated multi-line plain scalars (and
# dropped the rest of the document), misparsed compact nested sequences
# "- - x", kept \u \U \N \_ \L \P \e \a \v "\ " escapes literally, ignored
# block scalar indentation indicators (|2, >1-, |+2), loaded an empty
# mapping value as "" instead of undef, Dump([])/Dump({}) gave "" (so no
# round trip), and integers beyond int64 saturated to INT64_MAX/MIN.
use lib "lib";
use YAML;
func show(str $s) str {
    return replace_all($s, "\n", "\\n");
}
func main() int {
    my array @out = ();
    my scalar $h = YAML::Load("a: plain\n  continued\nb: 2\n");
    push(@out, $h->{"a"});
    push(@out, "" . $h->{"b"});
    my scalar $s = YAML::Load("- - x\n  - y\n- z\n");
    push(@out, join(",", @{$s->[0]}) . ";" . $s->[1]);
    my str $e = YAML::Load("a: \"\\u00e9 \\N \\e \\_ \\L \\P \\a \\v \\ \\U0001F600\\ud83d\\ude00\"\n")->{"a"};
    my array @codes = ();
    my int $i = 0;
    while ($i < length($e)) {
        push(@codes, ord(substr($e, $i, 1)));
        $i = $i + 1;
    }
    push(@out, join(",", @codes));
    push(@out, show(YAML::Load("a: |2\n    two-indented\n")->{"a"}));
    push(@out, show(YAML::Load("a: >1-\n  x\n   y\n")->{"a"}));
    push(@out, show(YAML::Load("a: |+2\n    x\n\n")->{"a"}));
    my scalar $n = YAML::Load("a:\nb: 1\nc: # nothing\n");
    push(@out, (defined($n->{"a"}) ? "def" : "undef") . "," . $n->{"b"} . "," . (defined($n->{"c"}) ? "def" : "undef"));
    push(@out, show(YAML::Dump([])));
    push(@out, show(YAML::Dump({})));
    my scalar $ra = YAML::Load(YAML::Dump([]));
    my scalar $rh = YAML::Load(YAML::Dump({}));
    push(@out, ref($ra) . size(@$ra));
    push(@out, ref($rh) . size(keys(%$rh)));
    my scalar $big = YAML::Load("n: 99999999999999999999\nm: -99999999999999999999\nk: 9223372036854775807\n");
    push(@out, typeof($big->{"n"}) . "," . typeof($big->{"m"}) . "," . typeof($big->{"k"}));
    # Content that is neither a continuation nor "key: value" is an error, not silently dropped
    my str $err = "no error";
    try { YAML::Load("a: 1\njunk\nb: 2\n"); } catch ($x) { $err = "ERR"; }
    push(@out, $err);
    say(join("|", @out));
    return 0;
}
