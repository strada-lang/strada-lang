# EXPECT: 31 20 1,9 2 12 1 b
# A list slice, (LIST)[i, j] and (f())[0]: a parse error for more than one
# index ("expected ']'"), and an index into the value for one. Now a slice
# of the list, as in Perl; `($x + 1) * 2` and other parenthesized
# expressions are unaffected.
func lst() { return (3, 1, 2); }
func main() int {
    my ($a, $b) = (lst())[0, 1];
    my $c = (10, 20, 30)[1];
    my array @d = (lst(), 9)[1, 3];
    my $e = (lst())[2];
    my array @x = (5, 6, 7);
    my $f = ($x[0] + 1) * 2;
    my $g = (split(",", "a,b,c"))[1];
    say($a . $b . " " . $c . " " . join(",", @d) . " " . $e . " " . $f . " " . (sort(lst()))[0] . " " . $g);
    return 0;
}
