# EXPECT: 1||1||3#cdef|bcd|ef|bcde||de|abcdef|#abc,def,g|a,bcd,efg|a,b,c,d,e,f,g#a|b,,c,,|a|b||c|||a|b||c|a|b|c#foo:bar|foo:bar:x:y|ab:ab|X:b:Y:|n#b<n><n>a|bXnana|b$&n$&n$&|\1b|b|ba|$1b|-a-c-
# Audit 20 S1-11: scalar/list vmethods vs TT: list.defined(n), substr with
# negative offset/length (Perl semantics), chunk with negative size, split with
# a limit, match(pat, 1) global, replace's global flag and backreferences ($N
# only; $& and \1 literal; missing group -> ""). Expected from Perl TT 3.106.
use lib "lib";
use Template;
func r(str $tpl, scalar $vars) str {
    my scalar $tt = Template::new({});
    my str $o = "";
    try { $o = $tt->process_string($tpl, $vars); }
    catch ($e) { $o = "ERR " . (Template::Exception::is_exception($e) ? Template::Exception::as_string($e) : ("" . $e)); }
    return str::replace($o, "\n", "/");
}
func main() int {
    my array @out = ();
    push(@out, r("[% l.defined(1) %]|[% l.defined(9) %]|[% l.defined(-1) %]|[% l.defined('x') %]|[% l.item(-1) %]", {"l" => [1, 2, 3]}));
    push(@out, r("[% s.substr(2) %]|[% s.substr(1,3) %]|[% s.substr(-2) %]|[% s.substr(1,-1) %]|[% s.substr(10) %]|[% s.substr(-3,-1) %]|[% s.substr(-9) %]|[% s.substr(-9, 2) %]", {"s" => "abcdef"}));
    push(@out, r("[% s.chunk(3).join(',') %]|[% s.chunk(-3).join(',') %]|[% s.chunk(0).join(',') %]", {"s" => "abcdefg"}));
    push(@out, r("[% c.split(',', 2).join('|') %]|[% c.split(',', -1).join('|') %]|[% c.split(',').join('|') %]|[% d.split(',\\s*').join('|') %]", {"c" => "a,b,,c,,", "d" => "a, b,c"}));
    push(@out, r("[% m = s.match('(\\w+)=(\\w+)'); m.join(':') %]|[% s.match('(\\w+)=(\\w+)', 1).join(':') %]|[% v = 'abab'; v.match('ab', 1).join(':') %]|[% v = 'aXbY'; v.match('([XY])(.?)', 1).join(':') %]|[% s.match('Q', 1) ? 'y' : 'n' %]", {"s" => "foo=bar x=y"}));
    push(@out, r("[% s.replace('a(.)', '<\$1>') %]|[% s.replace('a', 'X', 0) %]|[% s.replace('a', '\$&') %]|[% v = 'ab'; v.replace('(a)', '\\1') %]|[% v.replace('(a)', '\$2') %]|[% v.replace('(a)(b)', '\$2\$1') %]|[% v.replace('(a)', '\\\$1') %]|[% v = 'abbc'; v.replace('b*', '-') %]", {"s" => "banana"}));
    say(join("#", @out));
    return 0;
}
