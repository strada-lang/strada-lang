# EXPECT: 0 [] 1 a 0 def
# `our int $n;` / `our str $s;` / `our num $f;` without an initializer hold
# their type's empty value (0, "", 0), like `my int $n;`.
our int $n;
our str $s;
our int $c;
our str $t;
our num $f;
func main() int {
    $c++;
    $t .= "a";
    say($n . " [" . $s . "] " . $c . " " . $t . " " . $f . " " . (defined($n) ? "def" : "undef"));
    return 0;
}
