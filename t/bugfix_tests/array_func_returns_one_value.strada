# EXPECT: a 1 3 xy 3 b x
# `return ("a");` / `return "a";` from a function declared `array` returns a
# one-item list: one element in a list, the value itself to a scalar (Perl).
# It returned the bare value, which `my @a = (0, one(), 9)` happened to
# handle but `use strict "types"` reported as "returning a str value".
use strict "types";
func one() array { return ("a"); }
func bare() array<str> { return "x" . "y"; }
func num1() array { return (1 + 2); }
func two() array { return ("a", "b"); }
func main() int {
    my $n = one();
    my array @m = one();
    my array @l = (0, one(), 9);
    my $b = bare();
    my array @k = (0, num1(), 9);
    my $t = two();
    my array @f = one();
    say($n . " " . scalar(@m) . " " . scalar(@l) . " " . $b . " " . scalar(@k) . " " . $t . " " . (scalar(@f) == 1 ? "x" : "?"));
    return 0;
}
