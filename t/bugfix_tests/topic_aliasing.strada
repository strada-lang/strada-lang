# EXPECT: top,top,r2,top,ctop,top,x11x22xy11y22y,10-20-30,top|p,q|b|1,2,3|AxAyA,BxByB|t|top|aa,bb,m set
# foreach without a loop variable, map and grep alias the global $_ (Perl),
# so a function called from the body sees the element; $_ comes back after
# the loop on every exit (last, next, return, throw) and nested loops stack.
# It used to be a hidden local: callees saw the outer $_. In compiled
# closures $_ was a captured copy, so the loop and `$_ = ...` never reached
# the real $_.
func peek() str { return defined($_) ? $_ : "u"; }
func ret_mid() str { foreach ((1, 2, 3)) { return "r" . peek() if $_ == 2; } return "none"; }
func thr() void { foreach (("t1", "t2")) { die("boom") if $_ eq "t2"; } }
func main() int {
    my @o;
    $_ = "top";
    foreach (("a", "b", "c")) { last if $_ eq "b"; }
    push(@o, peek());
    foreach (("a", "b")) { next; }
    push(@o, peek());
    push(@o, ret_mid());
    push(@o, peek());
    try { thr(); } catch ($e) { push(@o, "c" . peek()); }
    push(@o, peek());
    my @n;
    foreach (("x", "y")) { my $outer = $_; foreach ((1, 2)) { push(@n, $outer . $_ . peek()); } push(@n, peek()); }
    push(@o, join("", @n));
    my @w = (1, 2, 3);
    foreach (@w) { $_ = $_ * 10; }
    push(@o, join("-", @w));
    push(@o, peek());
    my @m = map { peek() } ("p", "q");
    my @g = grep { peek() eq "b" } ("a", "b", "c");
    my @r = map { peek() } (1..3);
    my @nn = map { my $o2 = $_; join("", map { $o2 . peek() } ("x", "y")) . peek() } ("A", "B");
    my @k = map { next if $_ eq "s"; peek() } ("s", "t");
    my $f = func () { my @co; foreach (("a", "b")) { push(@co, peek() . $_); } push(@co, $_); $_ = "set"; return join(",", @co); };
    $_ = "m";
    my $fr = $f->();
    say(join(",", @o) . "|" . join(",", @m) . "|" . join(",", @g) . "|" . join(",", @r) . "|" . join(",", @nn) . "|" . join(",", @k) . "|top|" . $fr . " " . $_);
    return 0;
}
