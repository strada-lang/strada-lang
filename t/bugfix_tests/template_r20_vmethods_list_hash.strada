# EXPECT: 2|1,3,4|01,a,b,3,4|3,4|1,a,b|1x,y,a,b|y,a|x,b#1,2,3,4,6|1,2,3,4,6,3,4,8|a,b|2#ac|b|0,1,2#a,b|1,2|1,2,a,b|ab
# Audit 20 S1 follow-up: list.splice, list.import (defined items of list
# args only), list.merge, list.hash(n), hash.import, hash.list('keys'|'values'|
# 'each'). Expected output from Perl TT 3.106.
use lib "lib";
use Template;
func r(str $tpl, scalar $vars) str {
    my scalar $tt = Template::new({});
    my str $o = "";
    try { $o = $tt->process_string($tpl, $vars); }
    catch ($e) { $o = "ERR " . (Template::Exception::is_exception($e) ? Template::Exception::as_string($e) : ("" . $e)); }
    return str::replace($o, "\n", "/");
}
func main() int {
    my array @out = ();
    push(@out, r("[% l = [1,2,3,4] %][% l.splice(1,1).join(',') %]|[% l.join(',') %]|[% l.splice(1, 0, 'a', 'b').size %][% l.join(',') %]|[% l.splice(-2).join(',') %]|[% l.join(',') %]|[% l.splice(0, 1, ['x','y']).join(',') %][% l.join(',') %]|[% l.splice(1, -1).join(',') %]|[% l.join(',') %]", {}));
    push(@out, r("[% l = [1,2]; m = [3, 4] %][% CALL l.import(m, 5, [6]); l.join(',') %]|[% l.merge(m, 7, [8]).join(',') %]|[% h = {a=>1}; g = {b=>2} %][% h.import(g) %][% h.keys.sort.join(',') %]|[% h.import(5) %][% h.size %]", {}));
    push(@out, r("[% l = ['a','b','c'] %][% h = l.hash(1) %][% h.1 %][% h.3 %]|[% h = l.hash %][% h.a %]|[% h = l.hash(0) %][% h.keys.sort.join(',') %]", {}));
    push(@out, r("[% h = {a=>1, b=>2} %][% h.list('keys').sort.join(',') %]|[% h.list('values').sort.join(',') %]|[% h.list('each').sort.join(',') %]|[% FOREACH p IN h.list %][% p.key %][% END %]", {}));
    say(join("#", @out));
    return 0;
}
