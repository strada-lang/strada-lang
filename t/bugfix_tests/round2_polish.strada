# EXPECT: ok
# Regression tests for:
# - multithreaded small-hash pool safety (hash_pool_small gated on !strada_threading_active)
# - custom-block `sort { $a cmp $b } %h` flattening hash entries
# - C standard library symbol names (`$pow`, `$sqrt`, `$free`) as Strada variable names
# - `chomp` / `chop` preserving UTF-8 character semantics on character-flagged strings

func hash_churn_worker() int {
    my int $sum = 0;
    my int $i = 0;
    while ($i < 3000) {
        my scalar $h = { "v" => $i, "k" => $i + 1 };
        $sum = $sum + $h->{"v"};
        $i = $i + 1;
    }
    return $sum;
}

func main() int {
    # 1. Multithreaded small-hash pool churn
    my scalar $t1 = thread::create(fn () int { return hash_churn_worker(); });
    my scalar $t2 = thread::create(fn () int { return hash_churn_worker(); });
    my scalar $t3 = thread::create(fn () int { return hash_churn_worker(); });
    my int $r1 = thread::join($t1);
    my int $r2 = thread::join($t2);
    my int $r3 = thread::join($t3);
    if ($r1 != 4498500 || $r2 != 4498500 || $r3 != 4498500) {
        say("bad thread hash sum: " . $r1 . "," . $r2 . "," . $r3);
        return 1;
    }

    # 2. Custom-block sort over %hash
    my hash %h = ("b" => "d", "a" => "c");
    my array @s = sort { $a cmp $b } %h;
    if (join(",", @s) ne "a,b,c,d") {
        say("bad sort hash: " . join(",", @s));
        return 1;
    }

    # 3. Variable names matching <math.h>/<stdlib.h> symbols
    my int $pow = -2 ** 2;
    my num $sqrt = math::sqrt(16.0);
    my int $free = 10;
    if ($pow != -4 || $sqrt != 4.0 || $free != 10) {
        say("bad math/stdlib var names: " . $pow . "," . $sqrt . "," . $free);
        return 1;
    }

    # 4. chomp / chop preserving UTF-8 character flag
    my str $u1 = "café\n";
    chomp($u1);
    my str $u2 = "café!";
    chop($u2);
    if (length($u1) != 4 || length($u2) != 4 || $u1 ne "café" || $u2 ne "café") {
        say("bad utf8 chomp/chop: " . length($u1) . "," . length($u2));
        return 1;
    }

    say("ok");
    return 0;
}
