# EXPECT: |||0,1,2,3|b,c|0
# Audit 20 S1-7: list.push / list.unshift / hash.delete return "" (no output);
# hash.delete removes every key given. Expected from Perl TT.
use lib "lib";
use Template;
func r(str $tpl, scalar $vars) str {
    my scalar $tt = Template::new({});
    my str $o = "";
    try { $o = $tt->process_string($tpl, $vars); }
    catch ($e) { $o = "ERR " . (Template::Exception::is_exception($e) ? Template::Exception::as_string($e) : ("" . $e)); }
    return str::replace($o, "\n", "/");
}
func main() int {
    my array @out = ();
    push(@out, r("[% l = [1,2]; l.push(3) %]|[% l.unshift(0) %]|[% h.delete('a') %]|[% l.join(',') %]|[% h.keys.sort.join(',') %]|[% h.delete('b', 'c') %][% h.size %]", {"h" => {"a" => 1, "b" => 2, "c" => 3}}));
    say(join("#", @out));
    return 0;
}
