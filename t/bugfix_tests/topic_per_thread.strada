# EXPECT: pool_bad=0 task_bad=0 tasks=6 main=main
# $_ is per OS thread and per green task: async::map workers and Async::Loop
# tasks each run foreach/map over $_ with calls (a shared $_ raced), and the
# main program keeps its own $_.
use lib "lib";
use Async::Loop;
use Async::Task;
func peek() str { return defined($_) ? $_ : "u"; }
func work(int $id) str {
    my $bad = 0;
    foreach my $round (1..200) {
        foreach (("a" . $id, "b" . $id)) { $bad++ if peek() ne $_; }
        my @m = map { peek() } (1..5);
        $bad++ if join("", @m) ne "12345";
    }
    return $bad;
}
func main() int {
    $_ = "main";
    my $res = async::map(func ($x) { return work($x); }, [1, 2, 3, 4, 5, 6, 7, 8]);
    my $total = 0;
    foreach my $r (@$res) { $total = $total + $r; }
    my $loop = Async::Loop::new();
    my @tb;
    foreach my $t (1..3) {
        $loop->spawn(func () {
            foreach (("t" . $t, "u" . $t)) {
                Async::Task::sleep(5);
                push(@tb, peek() eq $_ ? 0 : 1);
            }
        });
    }
    $loop->run();
    my $tbad = 0;
    foreach my $v (@tb) { $tbad = $tbad + $v; }
    say("pool_bad=" . $total . " task_bad=" . $tbad . " tasks=" . scalar(@tb) . " main=" . peek());
    return 0;
}
