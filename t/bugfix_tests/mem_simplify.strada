# EXPECT: ok
# Stage 5 verification for memory management simplification (Stages 1-4):
# - Pure struct_size + uint16_t flags (UTF-8, blessed, weakref, DESTROY)
# - Per-variable __C__ vs closure cell boxing in the same function
# - Closure-cell cycles + weak refs reclaimed by strada_gc_collect()
# - TLS mortal temps across normal, method, SUPER::, closure (>16 & spread),
#   and variadic calls when later arguments throw inside nested try/catch

my int $g_live_objs = 0;

package MSObj;

func new(str $name) scalar {
    my hash %self = ();
    $self{"name"} = $name;
    $g_live_objs = $g_live_objs + 1;
    return bless(\%self, "MSObj");
}

func DESTROY(scalar $self) void {
    $g_live_objs = $g_live_objs - 1;
}

func name(scalar $self) str {
    return $self->{"name"};
}

package MSBase;

func s_combine(scalar $self, scalar $a, scalar $b, scalar $c) str {
    return $a->name() . ":" . $b->name() . ":" . $c->name();
}

func m_spread(scalar $self, scalar ...@args) str {
    return "cnt=" . scalar(@args);
}

package MSChild;
extends MSBase;

func s_combine(scalar $self, scalar $a, scalar $b, scalar $c) str {
    return "child:" . SUPER::s_combine($self, $a, $b, $c);
}

func m_multi(scalar $self, scalar $a, scalar $b, scalar $c, scalar $d, scalar $e) str {
    return $a->name() . "," . $b->name() . "," . $c->name() . "," . $d->name() . "," . $e->name();
}

package main;

struct MSBox {
    int a;
    num b;
}

func mk_obj(str $tag) scalar {
    return MSObj::new("tag_" . $tag);
}

func throw_obj(str $msg) scalar {
    throw($msg);
    return MSObj::new("unreachable");
}

func combine5(scalar $a, scalar $b, scalar $c, scalar $d, scalar $e) str {
    return $a->name() . "|" . $b->name() . "|" . $c->name() . "|" . $d->name() . "|" . $e->name();
}

func var_combine(scalar $first, scalar ...@rest) str {
    return $first->name() . "+" . scalar(@rest);
}

func keep_outer(scalar $obj, str $inner_res) str {
    return $obj->name() . "/" . $inner_res;
}

func try_catch_inner(str $label) str {
    my scalar $child = bless({}, "MSChild");
    my scalar $cls20 = func (
        scalar $a1, scalar $a2, scalar $a3, scalar $a4, scalar $a5,
        scalar $a6, scalar $a7, scalar $a8, scalar $a9, scalar $a10,
        scalar $a11, scalar $a12, scalar $a13, scalar $a14, scalar $a15,
        scalar $a16, scalar $a17, scalar $a18, scalar $a19, scalar $a20
    ) str {
        return $a1->name() . "-" . $a20->name();
    };
    my scalar $cls_sp = func (scalar $head, scalar $a, scalar $b, scalar $c) str {
        return $head->name() . ":" . $a->name() . ":" . $b->name() . ":" . $c->name();
    };
    my array @arr = (mk_obj("sp_a"), mk_obj("sp_b"));

    my str $seen = "";
    try {
        combine5(mk_obj("n1"), mk_obj("n2"), mk_obj("n3"), throw_obj("E1"), mk_obj("n5"));
    } catch ($e1) {
        $seen = $seen . $e1;
    }
    try {
        $child->m_multi(mk_obj("m1"), mk_obj("m2"), mk_obj("m3"), throw_obj("E2"), mk_obj("m5"));
    } catch ($e2) {
        $seen = $seen . "," . $e2;
    }
    try {
        $child->s_combine(mk_obj("s1"), mk_obj("s2"), throw_obj("E3"));
    } catch ($e3) {
        $seen = $seen . "," . $e3;
    }
    try {
        $child->m_spread(mk_obj("ms1"), ...@arr, throw_obj("E4"));
    } catch ($e4) {
        $seen = $seen . "," . $e4;
    }
    try {
        $cls20->(
            mk_obj("1"), mk_obj("2"), mk_obj("3"), mk_obj("4"), mk_obj("5"),
            mk_obj("6"), mk_obj("7"), mk_obj("8"), mk_obj("9"), mk_obj("10"),
            mk_obj("11"), mk_obj("12"), mk_obj("13"), mk_obj("14"), mk_obj("15"),
            mk_obj("16"), mk_obj("17"), throw_obj("E5"), mk_obj("19"), mk_obj("20")
        );
    } catch ($e5) {
        $seen = $seen . "," . $e5;
    }
    try {
        $cls_sp->(mk_obj("c1"), ...@arr, throw_obj("E6"));
    } catch ($e6) {
        $seen = $seen . "," . $e6;
    }
    try {
        var_combine(mk_obj("v1"), ...@arr, throw_obj("E7"));
    } catch ($e7) {
        $seen = $seen . "," . $e7;
    }
    return $label . ":" . $seen;
}

func test_c_block_and_closure() int {
    my int $x = 10;
    my int $c_only = 5;
    my scalar $inc = func (int $d) int {
        $x = $x + $d;
        return $x;
    };
    __C__ {
        int64_t v = strada_to_int(c_only);
        strada_decref(c_only);
        c_only = strada_new_int(v * 3);
    }
    my int $r1 = $inc->(7);
    my int $r2 = $inc->(5);
    if ($r1 != 17 || $r2 != 22 || $x != 22 || $c_only != 15) {
        return 0;
    }
    return 1;
}

func test_flags_and_struct_size() int {
    my str $u = "caf" . core::byte(195) . core::byte(169);
    if (utf8::decode($u) != 1 || utf8::is_utf8($u) != 1 || length($u) != 4) {
        return 0;
    }

    my MSBox $bx;
    $bx->a = 9;
    $bx->b = 2.5;
    if ($bx->a != 9) {
        return 0;
    }

    my scalar $raw = core::cstruct_new(64);
    core::cstruct_set_int($raw, 0, 1234567);
    my int $sz_ok = 0;
    __C__ {
        if (raw->struct_size == 64 && raw->flags == 0) {
            strada_decref(sz_ok);
            sz_ok = strada_new_int(1);
        }
    }
    if ($sz_ok != 1 || core::cstruct_get_int($raw, 0) != 1234567) {
        return 0;
    }

    my hash %w = ();
    my int $live_before = $g_live_objs;
    {
        my scalar $o = MSObj::new("weak_check");
        $w{"o"} = $o;
        core::weaken($w{"o"});
        if (!core::isweak($w{"o"}) || core::blessed($w{"o"}) ne "MSObj") {
            return 0;
        }
        if ($g_live_objs != $live_before + 1) {
            return 0;
        }
    }
    if (defined($w{"o"}) || $g_live_objs != $live_before) {
        return 0;
    }
    return 1;
}

func test_closure_cell_cycle() int {
    my int $live_before = $g_live_objs;
    my hash %w = ();
    {
        my scalar $tracked = MSObj::new("cycled");
        my scalar $f = undef;
        $f = func () int {
            if (defined($tracked) && defined($f)) {
                return 1;
            }
            return 0;
        };
        if ($f->() != 1) {
            return 0;
        }
        my scalar $cell_ref = \$tracked;
        my scalar $fn_cell_ref = \$f;
        $w{"fn_cell"} = $fn_cell_ref;
        $w{"obj"} = $tracked;
        $w{"cell"} = $cell_ref;
        core::weaken($w{"fn_cell"});
        core::weaken($w{"obj"});
        core::weaken($w{"cell"});
        if (!core::isweak($w{"fn_cell"}) || !core::isweak($w{"obj"}) || !core::isweak($w{"cell"})) {
            return 0;
        }
    }
    __C__ {
        strada_gc_collect();
    }
    if (defined($w{"fn_cell"}) || defined($w{"obj"}) || defined($w{"cell"})) {
        return 0;
    }
    if ($g_live_objs != $live_before) {
        return 0;
    }
    return 1;
}

func test_call_happy_paths() int {
    my scalar $child = bless({}, "MSChild");
    my scalar $cls16 = func (
        scalar $a1, scalar $a2, scalar $a3, scalar $a4, scalar $a5,
        scalar $a6, scalar $a7, scalar $a8, scalar $a9, scalar $a10,
        scalar $a11, scalar $a12, scalar $a13, scalar $a14, scalar $a15,
        scalar $a16
    ) str {
        return $a1->name() . "-" . $a16->name();
    };
    my scalar $cls_var20 = \&var_combine;
    my scalar $cls_sp = func (scalar $head, scalar $a, scalar $b, scalar $c) str {
        return $head->name() . ":" . $a->name() . ":" . $b->name() . ":" . $c->name();
    };
    my array @arr = (mk_obj("ha"), mk_obj("hb"));

    my str $r1 = combine5(mk_obj("1"), mk_obj("2"), mk_obj("3"), mk_obj("4"), mk_obj("5"));
    if ($r1 ne "tag_1|tag_2|tag_3|tag_4|tag_5") { return 0; }

    my str $r2 = $child->m_multi(mk_obj("m1"), mk_obj("m2"), mk_obj("m3"), mk_obj("m4"), mk_obj("m5"));
    if ($r2 ne "tag_m1,tag_m2,tag_m3,tag_m4,tag_m5") { return 0; }

    my str $r3 = $child->s_combine(mk_obj("s1"), mk_obj("s2"), mk_obj("s3"));
    if ($r3 ne "child:tag_s1:tag_s2:tag_s3") { return 0; }

    my str $r4 = $child->m_spread(mk_obj("ms1"), ...@arr, mk_obj("ms4"));
    if ($r4 ne "cnt=4") { return 0; }

    my str $r5 = $cls16->(
        mk_obj("1"), mk_obj("2"), mk_obj("3"), mk_obj("4"), mk_obj("5"),
        mk_obj("6"), mk_obj("7"), mk_obj("8"), mk_obj("9"), mk_obj("10"),
        mk_obj("11"), mk_obj("12"), mk_obj("13"), mk_obj("14"), mk_obj("15"),
        mk_obj("16")
    );
    if ($r5 ne "tag_1-tag_16") { return 0; }

    my str $r5v = $cls_var20->(
        mk_obj("1"), mk_obj("2"), mk_obj("3"), mk_obj("4"), mk_obj("5"),
        mk_obj("6"), mk_obj("7"), mk_obj("8"), mk_obj("9"), mk_obj("10"),
        mk_obj("11"), mk_obj("12"), mk_obj("13"), mk_obj("14"), mk_obj("15"),
        mk_obj("16"), mk_obj("17"), mk_obj("18"), mk_obj("19"), mk_obj("20")
    );
    if ($r5v ne "tag_1+19") { return 0; }

    my str $r6 = $cls_sp->(mk_obj("c0"), ...@arr, mk_obj("c3"));
    if ($r6 ne "tag_c0:tag_ha:tag_hb:tag_c3") { return 0; }

    my str $r7 = var_combine(mk_obj("v0"), ...@arr, mk_obj("v3"));
    if ($r7 ne "tag_v0+3") { return 0; }

    if ($g_live_objs != 2) { return 0; }
    return 1;
}

func main() int {
    if (test_flags_and_struct_size() != 1) {
        say("fail: flags_and_struct_size");
        return 1;
    }
    if (test_c_block_and_closure() != 1) {
        say("fail: c_block_and_closure");
        return 1;
    }
    if (test_closure_cell_cycle() != 1) {
        say("fail: closure_cell_cycle");
        return 1;
    }
    if (test_call_happy_paths() != 1 || $g_live_objs != 0) {
        say("fail: call_happy_paths live=" . $g_live_objs);
        return 1;
    }
    my str $res = keep_outer(mk_obj("outer"), try_catch_inner("inner"));
    if ($res ne "tag_outer/inner:E1,E2,E3,E4,E5,E6,E7") {
        say("fail: nested_throws: " . $res);
        return 1;
    }
    if ($g_live_objs != 0) {
        say("fail: live_objs=" . $g_live_objs);
        return 1;
    }
    say("ok");
    return 0;
}
