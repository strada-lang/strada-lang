# EXPECT: 9 9 9 9 9 9 2 2 3 9 9 19 3
# A call where one value is wanted is read in scalar context, as in Perl:
# `return @list` gives the count and `return (a, b, c)` its last item, in
# `my $n = f()`, `our $n = f()`, `$v = f()`, `$h{k} = f()`, `$a[i] = f()`,
# `$r->{k} = f()` and arithmetic. `my @a = f()` and `[f()]` keep the
# elements. The same whether or not the function is declared `array`. (It
# used to store the array, then, for `array` functions only, the count.)
package Lib;
func three() array { return (7, 8, 9); }
package main;
our $G = two();
func two() array { return (8, 9); }
func untyped() { my array @a = (1, 2, 3); return @a; }
func counted() array { my array @a = (4, 5, 6); return @a; }
func main() int {
    my $a = two();
    my scalar $b = Lib::three();
    my $c; $c = two();
    my hash %h = (); $h{"k"} = two();
    my array @e = (0); $e[0] = Lib::three();
    my $r = {}; $r->{"k"} = two();
    my array @keep = two();
    my $ref = [two()];
    my $u = untyped();
    my $t = 1 ? two() : 0;
    my int $n = two();
    say(join(" ", $a, $b, $c, $h{"k"}, $e[0], $r->{"k"}, scalar(@keep), scalar(@$ref), $u, $n, $G, two() + 10, counted() + 0));
    return 0;
}
