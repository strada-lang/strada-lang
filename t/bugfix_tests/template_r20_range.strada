# EXPECT: 3|012|1,2|0
# Audit 20 S1-1: a range inside a list literal ([1..3]) is the range itself,
# not a one-element list holding it. Expected output from Perl TT 3.106.
use lib "lib";
use Template;
func r(str $tpl, scalar $vars) str {
    my scalar $tt = Template::new({});
    my str $o = "";
    try { $o = $tt->process_string($tpl, $vars); }
    catch ($e) { $o = "ERR " . (Template::Exception::is_exception($e) ? Template::Exception::as_string($e) : ("" . $e)); }
    return str::replace($o, "\n", "/");
}
func main() int {
    my array @out = ();
    push(@out, r("[% r = [1..3]; r.size %]|[% FOREACH i IN [1..3] %][% loop.index %][% END %]|[% n = 2; r = [1..n]; r.join(',') %]|[% r = [3..1]; r.size %]", {}));
    say(join("#", @out));
    return 0;
}
