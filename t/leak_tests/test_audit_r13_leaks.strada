use lib "lib";
use JSON;
use compress;
use DBI;

package R13LkNum;
use overload '+' => "add_op", 'neg' => "neg_op", '""' => "as_str";
func new(int $v) scalar { return bless({"v" => $v}, "R13LkNum"); }
func add_op(scalar $self, scalar $other, int $rev) scalar {
    my int $o = ref($other) eq "R13LkNum" ? $other->{"v"} : ($other + 0);
    return R13LkNum::new($self->{"v"} + $o);
}
func neg_op(scalar $self) scalar { return R13LkNum::new(0 - $self->{"v"}); }
func as_str(scalar $self) str { return "N:" . $self->{"v"}; }

package R13LkStrOv;
use overload '""' => "to_s";
func new(str $v) scalar { return bless({"v" => $v}, "R13LkStrOv"); }
func to_s(scalar $self) str { return $self->{"v"}; }

package R13LkTie;
func TIESCALAR(str $cls, str $v) scalar { return bless({"v" => $v}, $cls); }
func FETCH(scalar $self) scalar { return $self->{"v"}; }
func STORE(scalar $self, scalar $v) void { $self->{"v"} = $v; }

package R13LkTieHash;
func TIEHASH(str $cls) scalar {
    return bless({"data" => {"a" => R13LkStrOv::new("ov"), "b" => "raw"}, "keys" => ["a", "b"], "pos" => 0}, $cls);
}
func FETCH(scalar $self, str $k) scalar { return $self->{"data"}->{$k}; }
func EXISTS(scalar $self, str $k) int { return exists($self->{"data"}, $k); }
func FIRSTKEY(scalar $self) scalar { $self->{"pos"} = 1; return $self->{"keys"}->[0]; }
func NEXTKEY(scalar $self, str $last) scalar {
    my int $p = $self->{"pos"};
    if ($p >= size($self->{"keys"})) { return undef; }
    $self->{"pos"} = $p + 1;
    return $self->{"keys"}->[$p];
}

package R13LkArr;
func new(int $a) scalar { my array @x = ($a, $a + 1); return bless(\@x, "R13LkArr"); }
func DESTROY(scalar $self) void { }

package main;

func main() int {
    my str $orig0 = $0;
    my int $i = 0;
    while ($i < 10) {
        # R13-C4: could_be_blessed via do{}, field access, unary, map, assign
