#!/usr/bin/env strada
# $_ aliasing (2026-11): foreach without a loop variable and map/grep blocks
# that call out publish the element as the per-thread $_, saved on the
# local() stack (strada_local_save_slot); `local $_` uses the same slot save;
# green tasks swap $_ at every switch. Every path must release what it saves.
use lib "lib";
use Async::Loop;
use Async::Task;
func peek() str { return defined($_) ? $_ : "u"; }
func thr() void { foreach (("t1", "t2")) { die("boom") if $_ eq "t2"; } }
func early() str { foreach (("e1", "e2")) { return peek() if $_ eq "e1"; } return ""; }
func main() int {
    $_ = "top" . "x";
    my $n = 0;
    foreach my $i (1..300) {
        foreach (("a" . $i, "b" . $i)) { $n = $n + length(peek()); }
        my @m = map { peek() . "!" } ("p" . $i, "q");
        my @g = grep { peek() ne "" } ("x", "y" . $i);
        if (1) { local $_ = "loc" . $i; $n = $n + length(peek()); }
        try { thr(); } catch ($e) { $n++; }
        $n = $n + length(early());
        $n = $n + scalar(@m) + scalar(@g);
    }
    my $loop = Async::Loop::new();
    foreach my $t (1..3) {
        $loop->spawn(func () {
            foreach (("t" . $t, "u" . $t)) { Async::Task::sleep(1); $n = $n + length(peek()); }
        });
    }
    $loop->run();
    say($n > 0 ? "ok" : "bad");
    return 0;
}
