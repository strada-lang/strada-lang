# Main.strada - Entry point for the Strada bytecode VM interpreter
# Supports file execution, -e inline evaluation, and interactive REPL modes.

use lib "../lib";
use lib "lib";
use Strada::Interpreter;

__C__ {
#ifdef HAVE_READLINE
#include <readline/readline.h>
#include <readline/history.h>
#endif

/* VM bytecode backend (linked from vm.c + vm_compiler.c) */
#include "vm.h"
#include "vm_compiler.h"
}

# -L library search paths from command line
my array @g_lib_paths = ();

# Read a line with prompt (uses GNU readline when available, falls back to fgets)
func read_line(str $prompt) str {
    my str $result = "";
    my int $got_line = 0;
    __C__ {
#ifdef HAVE_READLINE
        char *p = strada_to_str(prompt);
        char *line = readline(p);
        free(p);
        if (line) {
            strada_decref(result);
            result = strada_new_str(line);
            strada_decref(got_line);
            got_line = strada_new_int(1);
            free(line);
        } else {
            strada_decref(got_line);
            got_line = strada_new_int(0);
        }
#else
        char *p = strada_to_str(prompt);
        fprintf(stdout, "%s", p);
        fflush(stdout);
        free(p);
        char buffer[4096];
        if (fgets(buffer, sizeof(buffer), stdin)) {
            size_t len = strlen(buffer);
            if (len > 0 && buffer[len-1] == '\n') {
                buffer[len-1] = '\0';
            }
            strada_decref(result);
            result = strada_new_str(buffer);
            strada_decref(got_line);
            got_line = strada_new_int(1);
        } else {
            strada_decref(got_line);
            got_line = strada_new_int(0);
        }
#endif
    }
    if ($got_line == 0) {
        return undef;
    }
    return $result;
}

# Add a line to readline history (no-op without readline)
func history_add(str $line) void {
    __C__ {
#ifdef HAVE_READLINE
        char *l = strada_to_str(line);
        if (l && l[0] != '\0') {
            add_history(l);
        }
        free(l);
#endif
    }
}

# Initialize readline history
func history_init() void {
    __C__ {
#ifdef HAVE_READLINE
        using_history();
        stifle_history(1000);
#endif
    }
}

# Load history from file
func history_load(str $path) void {
    __C__ {
#ifdef HAVE_READLINE
        char *p = strada_to_str(path);
        read_history(p);
        free(p);
#endif
    }
}

# Save history to file
func history_save(str $path) void {
    __C__ {
#ifdef HAVE_READLINE
        char *p = strada_to_str(path);
        write_history(p);
        free(p);
#endif
    }
}

# Get path to history file (~/.strada_interp_history)
func get_history_path() str {
    my str $home = core::getenv("HOME");
    if (!defined($home)) { return ""; }
    if (length($home) == 0) { return ""; }
    return $home . "/.strada_interp_history";
}

func print_banner() void {
    say("Strada Interpreter v0.3");
    say("Type expressions or statements. Enter .help for commands, .quit to exit.");
    say("");
}

func print_help() void {
    say("REPL Commands:");
    say("  .help       Show this help message");
    say("  .vars       List variables in scope");
    say("  .funcs      List registered functions");
    say("  .load FILE  Load file definitions into REPL");
    say("  .clear      Reset interpreter state");
    say("  .quit       Exit the REPL");
    say("");
    say("Enter Strada code to evaluate. Function definitions are registered for later use.");
    say("Expressions return their value. Statements return undef.");
}

func starts_with(str $s, str $prefix) int {
    my int $plen = length($prefix);
    if (length($s) < $plen) { return 0; }
    if (substr($s, 0, $plen) eq $prefix) { return 1; }
    return 0;
}

func str_trim(str $s) str {
    my int $start = 0;
    my int $end = length($s);
    while ($start < $end) {
        my int $c = char_at($s, $start);
        if ($c == 32 || $c == 9 || $c == 10 || $c == 13) {
            $start = $start + 1;
        } else {
            last;
        }
    }
    while ($end > $start) {
        my int $c = char_at($s, $end - 1);
        if ($c == 32 || $c == 9 || $c == 10 || $c == 13) {
            $end = $end - 1;
        } else {
            last;
        }
    }
    return substr($s, $start, $end - $start);
}

# Is this input a complete statement (for multi-line REPL input)? Open
# braces/parens/brackets/strings, a heredoc whose terminator line has not
# been entered, and a trailing binary operator (`my $s = "a" .`) all mean
# more lines follow.
func is_balanced(str $input) int {
    my int $braces = 0;
    my int $parens = 0;
    my int $brackets = 0;
    my int $in_string = 0;
    my int $can_regex = 1;
    my int $i = 0;
    my int $len = length($input);
    my int $last_sig = 0;      # last significant character outside comments
    my int $prev_sig = 0;      # the one before it
    my array @hd_pending = (); # heredoc terminators whose bodies start at the next line
    while ($i < $len) {
        my int $c = char_at($input, $i);
        if ($in_string == 0) {
            if ($c == 10 && size(@hd_pending) > 0) {
                # heredoc bodies: skip lines up to each terminator line
                my int $hk = 0;
                while ($hk < size(@hd_pending)) {
                    my str $term = $hd_pending[$hk];
                    my int $found = 0;
                    while ($i < $len && $found == 0) {
                        my int $ls = $i + 1;
                        my int $le = $ls;
                        while ($le < $len && char_at($input, $le) != 10) { $le = $le + 1; }
                        my str $ln = str_trim(substr($input, $ls, $le - $ls));
                        $i = $le;
                        if ($ln eq $term) { $found = 1; }
                        if ($le >= $len) { last; }
                    }
                    if ($found == 0) { return 0; }
                    $hk = $hk + 1;
                }
                @hd_pending = ();
                $i = $i + 1;
                next;
            }
            if ($c == 35) { # '#' line comment
                while ($i < $len && char_at($input, $i) != 10) {
                    $i = $i + 1;
                }
                next;
            } elsif ($c == 47 && $i + 1 < $len && char_at($input, $i + 1) == 42) { # '/*' block comment
                $i = $i + 2;
                while ($i + 1 < $len && !(char_at($input, $i) == 42 && char_at($input, $i + 1) == 47)) {
                    $i = $i + 1;
                }
                if ($i + 1 < $len) { $i = $i + 1; }
                else { return 0; }
            } elsif ($c == 60 && $can_regex == 1 && $i + 1 < $len && char_at($input, $i + 1) == 60) {
                # '<<' where an operand is expected: a heredoc <<TAG / <<"TAG" /
                # <<'TAG' (the lexer's rule), else a shift
                my int $hj = $i + 2;
                my int $hq = 0;
                # <<~TAG (indented) and <<\TAG (literal)
                if ($hj < $len && char_at($input, $hj) == 126) { $hj = $hj + 1; }
                if ($hj < $len && char_at($input, $hj) == 92) { $hj = $hj + 1; }
                if ($hj < $len && (char_at($input, $hj) == 34 || char_at($input, $hj) == 39)) {
                    $hq = char_at($input, $hj);
                    $hj = $hj + 1;
                }
                my int $h0 = 0;
                if ($hj < $len) { $h0 = char_at($input, $hj); }
                my str $tag = "";
                if (($h0 >= 65 && $h0 <= 90) || ($h0 >= 97 && $h0 <= 122) || $h0 == 95) {
                    my int $hs = $hj;
                    while ($hj < $len && lex_pp_is_word_char(char_at($input, $hj)) == 1) { $hj = $hj + 1; }
                    if ($hq == 0 || ($hj < $len && char_at($input, $hj) == $hq)) {
                        $tag = substr($input, $hs, $hj - $hs);
                        if ($hq != 0) { $hj = $hj + 1; }
                    }
                }
                if (length($tag) > 0) {
                    push(@hd_pending, $tag);
                    $i = $hj;
                    $prev_sig = $last_sig;
                    $last_sig = 34;   # an operand
                    $can_regex = 0;
                    next;
                }
                $prev_sig = $last_sig;
                $last_sig = $c;
                $can_regex = 1;
            } elsif ($c == 47 && $can_regex == 1) { # '/' C line comment or regex literal
                if ($i + 1 < $len && char_at($input, $i + 1) == 47) { # '//'
                    while ($i < $len && char_at($input, $i) != 10) {
                        $i = $i + 1;
                    }
                    next;
                } else {
                    # Scan single-line /regex/ respecting escapes and [...] classes
                    my int $j = $i + 1;
                    my int $in_cc = 0;
                    my int $closed = 0;
                    while ($j < $len) {
                        my int $rc = char_at($input, $j);
                        if ($rc == 10) { last; }
                        if ($rc == 92) { $j = $j + 2; next; }
                        if ($rc == 91 && $in_cc == 0) { $in_cc = 1; }
                        elsif ($rc == 93 && $in_cc == 1) { $in_cc = 0; }
                        elsif ($rc == 47 && $in_cc == 0) { $closed = 1; last; }
                        $j = $j + 1;
                    }
                    $prev_sig = $last_sig;
                    if ($closed == 1) {
                        $i = $j;
                        $can_regex = 0;
                        $last_sig = 34;
                    } else {
                        $can_regex = 1;
                        $last_sig = $c;
                    }
                }
            } elsif ($c == 34 || $c == 39) { # '"' or "'"
                $in_string = $c;
                $can_regex = 0;
                $prev_sig = $last_sig;
                $last_sig = 34;
            } elsif ($c == 32 || $c == 9 || $c == 10 || $c == 13) { # whitespace keeps $can_regex
            } else {
                $prev_sig = $last_sig;
                $last_sig = $c;
                if ($c == 123) { $braces = $braces + 1; $can_regex = 1; }
                elsif ($c == 125) { $braces = $braces - 1; $can_regex = 0; }
                elsif ($c == 40) { $parens = $parens + 1; $can_regex = 1; }
                elsif ($c == 41) { $parens = $parens - 1; $can_regex = 0; }
                elsif ($c == 91) { $brackets = $brackets + 1; $can_regex = 1; }
                elsif ($c == 93) { $brackets = $brackets - 1; $can_regex = 0; }
                elsif (($c >= 48 && $c <= 57) || ($c >= 65 && $c <= 90) || ($c >= 97 && $c <= 122) || $c == 95 || $c == 36 || $c == 64 || $c == 37) {
                    $can_regex = 0;
                    $last_sig = 97;   # a word, number or variable
                } else {
                    $can_regex = 1;
                }
            }
        } else {
            if ($c == $in_string) { $in_string = 0; }
            elsif ($c == 92) { $i = $i + 1; }
        }
        $i = $i + 1;
    }
    if (size(@hd_pending) > 0) { return 0; }    # heredoc body not entered yet
    if ($braces != 0 || $parens != 0 || $brackets != 0 || $in_string != 0) { return 0; }
    # A trailing binary operator continues on the next line; `$i++` / `$i--`
    # end a statement.
    if (($last_sig == 43 || $last_sig == 45) && $prev_sig == $last_sig) { return 1; }
    # (`/`, `<` and `>` end operands too often -- s/a/b/, <$fh> -- to count,
    # except `->` and `=>`)
    if ($last_sig == 62 && ($prev_sig == 45 || $prev_sig == 61)) { return 0; }
    if ($last_sig == 46 || $last_sig == 43 || $last_sig == 45 || $last_sig == 42 ||
        $last_sig == 37 || $last_sig == 61 || $last_sig == 38 ||
        $last_sig == 124 || $last_sig == 94 || $last_sig == 44 || $last_sig == 63 ||
        $last_sig == 33 || $last_sig == 126) {
        return 0;
    }
    return 1;
}

# Get directory of a file path
func get_dirname(str $path) str {
    my int $last_slash = -1;
    my int $i = 0;
    while ($i < length($path)) {
        if (substr($path, $i, 1) eq "/") {
            $last_slash = $i;
        }
        $i = $i + 1;
    }
    if ($last_slash < 0) { return "."; }
    if ($last_slash == 0) { return "/"; }
    return substr($path, 0, $last_slash);
}

# Find project root by walking up from a directory looking for lib/Strada/Interpreter.strada
func find_project_root(str $dir) str {
    my str $resolved = core::realpath($dir);
    my str $check = (length($resolved) > 0) ? $resolved : $dir;
    my int $depth = 0;
    while ($depth < 10) {
        my str $lib_dir = $check . "/lib";
        my str $test_file = $lib_dir . "/Strada/Interpreter.strada";
        if (core::is_file($test_file) == 1) {
            return $check;
        }
        my str $parent = get_dirname($check);
        if ($parent eq $check) { last; }
        $check = $parent;
        $depth = $depth + 1;
    }
    return "";
}

# Find exe root directory
func get_exe_root() str {
    my str $exe_dir = "";
    __C__ {
        char __exe[1024];
        ssize_t __n = readlink("/proc/self/exe", __exe, sizeof(__exe) - 1);
        if (__n > 0) {
            __exe[__n] = 0;
            char *__sl = strrchr(__exe, '/');
            if (__sl) {
                *__sl = 0;
                strada_decref(exe_dir);
                exe_dir = strada_new_str(__exe);
            }
        }
    }
    if (length($exe_dir) == 0) { return ""; }
    return find_project_root($exe_dir);
}

# Build module search path list (-L paths, project root + lib/, optional extra dir).
func build_lib_paths(str $extra_dir) array {
    my array @lib_paths = ();
    my int $li = 0;
    while ($li < size(@g_lib_paths)) {
        push(@lib_paths, $g_lib_paths[$li]);
        $li = $li + 1;
    }
    my str $project_root = (length($extra_dir) > 0) ? find_project_root($extra_dir) : "";
    my str $exe_root = get_exe_root();
    if (length($project_root) > 0) {
        push(@lib_paths, $project_root);
        push(@lib_paths, $project_root . "/lib");
    } elsif (length($exe_root) > 0) {
        push(@lib_paths, $exe_root);
        push(@lib_paths, $exe_root . "/lib");
    }
    if (length($extra_dir) > 0) {
        push(@lib_paths, $extra_dir);
    }
    return @lib_paths;
}

# Parse and evaluate REPL input using the persistent VM session
func repl_eval(str $input) scalar {
    my str $trimmed = str_trim($input);
    if (length($trimmed) == 0) { return undef; }

    $trimmed = Strada::Interpreter::eval_append_trailing_semi($trimmed);

    return Strada::Interpreter::eval_string_vm_ex($trimmed, "<repl>", undef, 0);
}

# Display a result value
func display_result(scalar $val) void {
    if (!defined($val)) { return; }
    if (ref($val) eq "HASH" || ref($val) eq "ARRAY" || ref($val) eq "REF") {
        say(dumper($val));
    } else {
        say($val);
    }
}

# Load a file into the REPL VM session (registers functions/packages, skips main)
func load_file(str $filename) void {
    my str $source = slurp($filename);
    if (length($source) == 0) {
        say("Error: Could not read file: " . $filename);
        return;
    }

    my str $source_dir = get_dirname($filename);
    my array @load_libs = ($source_dir);
    Strada::Interpreter::eval_string_vm_ex($source, $filename, \@load_libs, 1);

    say("Loaded " . $filename);
}

# Interactive REPL
func run_repl() void {
    my array @repl_libs = build_lib_paths(".");
    Strada::Interpreter::set_eval_lib_paths(\@repl_libs);
    if (length("" . core::getenv("STRADA_USE_ARTIFACTS")) == 0) {
        core::setenv("STRADA_USE_ARTIFACTS", "0");
    }

    print_banner();

    history_init();
    my str $histfile = get_history_path();
    if (length($histfile) > 0) {
        history_load($histfile);
    }

    my str $buffer = "";
    my int $continuation = 0;

    while (1) {
        my str $prompt = "strada> ";
        if ($continuation == 1) {
            $prompt = "...     ";
        }

        my str $line = read_line($prompt);
        if (!defined($line)) {
            say("");
            last;
        }

        if ($continuation == 1) {
            $buffer = $buffer . "\n" . $line;
        } else {
            $buffer = $line;
        }

        if (!is_balanced($buffer)) {
            $continuation = 1;
            next;
        }
        $continuation = 0;

        my str $input = str_trim($buffer);
        if (length($input) == 0) { next; }

        history_add($input);

        # Handle REPL commands
        if ($input eq ".quit" || $input eq ".exit" || $input eq ".q") { last; }
        if ($input eq ".help" || $input eq ".h") { print_help(); next; }
        if ($input eq ".vars") {
            my scalar $vars = Strada::Interpreter::vm_eval_globals();
            my scalar $var_keys = [keys($vars)];
            my int $vk_len = size($var_keys);
            if ($vk_len == 0) {
                say("(no variables)");
            } else {
                my int $vi = 0;
                while ($vi < $vk_len) {
                    my str $vname = $var_keys->[$vi];
                    my scalar $vval = $vars->{$vname};
                    if (ref($vval) eq "HASH" || ref($vval) eq "ARRAY") {
                        say("  " . $vname . " = " . ref($vval));
                    } else {
                        say("  " . $vname . " = " . (defined($vval) ? $vval : "undef"));
                    }
                    $vi = $vi + 1;
                }
            }
            next;
        }
        if ($input eq ".funcs") {
            my scalar $func_hash = Strada::Interpreter::vm_eval_funcs();
            my scalar $func_keys = [keys($func_hash)];
            my int $fk_len = size($func_keys);
            if ($fk_len == 0) {
                say("(no user functions)");
            } else {
                my int $fi = 0;
                while ($fi < $fk_len) {
                    my str $fname = $func_keys->[$fi];
                    my int $pcnt = $func_hash->{$fname};
                    say("  " . $fname . "(" . $pcnt . " params)");
                    $fi = $fi + 1;
                }
            }
            next;
        }
        if ($input eq ".clear") {
            Strada::Interpreter::reset();
            say("State cleared.");
            next;
        }

        # .load FILE
        if (starts_with($input, ".load ")) {
            my str $filename = str_trim(substr($input, 6, length($input) - 6));
            if (core::is_file($filename) == 0) {
                say("Error: File not found: " . $filename);
                next;
            }
            try {
                load_file($filename);
            } catch ($e) {
                say("Error loading " . $filename . ": " . $e);
            }
            next;
        }

        # Evaluate
        try {
            my scalar $result = repl_eval($input);
            display_result($result);
        } catch ($e) {
            say("Error: " . $e);
        }
    }

    if (length($histfile) > 0) {
        history_save($histfile);
    }
    Strada::Interpreter::reset();
}

# Compile an AST program and execute it on the bytecode VM.
func run_vm_program(scalar $program, str $script_name, scalar $argv, str $restore_cwd) int {
    my int $result = 0;
    __C__ {
        extern int g_vm_whole_program;
        g_vm_whole_program = 1;
        VMProgram *vprog = vm_compile_program(program);
        g_vm_whole_program = 0;
        {
            char *__scwd = strada_to_str(restore_cwd);
            if (__scwd && __scwd[0]) { int __rc = chdir(__scwd); (void)__rc; }
            free(__scwd);
        }
        if (!vprog) {
            fprintf(stderr, "VM compile failed\n");
            strada_decref(result);
            result = STRADA_MAKE_TAGGED_INT(1);
        } else {
            /* Locate the runtime headers for __C__ block JIT compilation:
             * try <bindir>/../runtime then <bindir>/runtime relative to the
             * strada-interp binary. */
            {
                char __exe[1024];
                ssize_t __n = readlink("/proc/self/exe", __exe, sizeof(__exe) - 1);
                if (__n > 0) {
                    __exe[__n] = 0;
                    char *__sl = strrchr(__exe, '/');
                    if (__sl) {
                        *__sl = 0;
                        char __rt[1200];
                        snprintf(__rt, sizeof(__rt), "%s/../runtime", __exe);
                        char __hdr[1400];
                        snprintf(__hdr, sizeof(__hdr), "%s/strada_runtime.h", __rt);
                        if (access(__hdr, R_OK) != 0) {
                            snprintf(__rt, sizeof(__rt), "%s/runtime", __exe);
                            snprintf(__hdr, sizeof(__hdr), "%s/strada_runtime.h", __rt);
                        }
                        if (access(__hdr, R_OK) == 0)
                            vprog->runtime_include_path = strdup(__rt);
                    }
                }
            }
            const char *entry = "main";
            if (vm_program_find_func(vprog, "main") < 0) {
                if (vm_program_find_func(vprog, "run") >= 0) entry = "run";
                else {
                    fprintf(stderr, "Error: no 'main' or 'run' function\n");
                    entry = NULL;
                    strada_decref(result);
                    result = STRADA_MAKE_TAGGED_INT(1);
                }
            }
            if (entry) {
                VM *vvm = vm_new(vprog);
                {
                    char *fn_c = strada_to_str(script_name);
                    vvm->script_name = fn_c;
                    VMArray *vargv = vm_array_new(8);
                    if (argv && !STRADA_IS_TAGGED_INT(argv)) {
                        StradaArray *av = strada_deref_array(argv);
                        if (av) {
                            for (size_t ai = 0; ai < av->size; ai++) {
                                StradaValue *item = strada_array_get(av, (int64_t)ai);
                                char *s = strada_to_str(item);
                                vm_array_push(vargv, VM_MAKE_STR(s ? s : ""));
                                free(s);
                            }
                        }
                    }
                    vvm->argv = vargv;
                }
                VMValue vresult = vm_execute(vvm, entry);
                /* Run END blocks (LIFO order, mirroring the compiled backend) */
                vm_run_end_blocks(vvm);
                int64_t rc = VM_IS_ANY_INT(vresult) ? VM_ANY_INT_VAL(vresult) : 0;
                strada_decref(result);
                result = STRADA_MAKE_TAGGED_INT(rc);
                vm_free(vvm);
            }
            vm_program_free(vprog);
        }
    }
    return $result;
}

# Execute a file using the bytecode VM
func run_file_vm(str $filename, scalar $argv) int {
    my scalar $source_raw = core::slurp($filename);
    if (!defined($source_raw)) {
        say(STDERR, "strada-interp: cannot read " . $filename);
        return 2;
    }
    my str $source = $source_raw;
    my str $source_dir = get_dirname($filename);
    my str $project_root = find_project_root($source_dir);
    my array @lib_paths = build_lib_paths($source_dir);

    my str $saved_cwd = core::getcwd();
    # the lexer resolves `#include "x"` next to the including file, so it
    # needs a path that survives the chdir below
    my str $lex_fn = $filename;
    my scalar $abs_fn = core::realpath($filename);
    if (defined($abs_fn) && length("" . $abs_fn) > 0) { $lex_fn = "" . $abs_fn; }
    if (length($project_root) > 0) {
        core::chdir($project_root);
    }
    if (length("" . core::getenv("STRADA_USE_ARTIFACTS")) == 0) {
        core::setenv("STRADA_USE_ARTIFACTS", "0");
    }

    my scalar $tokens = lex_tokenize_file($source, $lex_fn);
    my scalar $parser = parser_new($tokens);
    parser_set_filename($parser, $filename);
    my array @empty = ();
    my scalar $program = parse_program($parser, \@lib_paths, \@empty, \@empty, \@empty);
    if (defined($program)) {
        $program->{"source_file"} = $filename;
    }

    return run_vm_program($program, $filename, $argv, $saved_cwd);
}

func print_usage() void {
    say("Strada Interpreter v0.3 (Bytecode VM)");
    say("Usage:");
    say("  strada-interp                          Interactive REPL");
    say("  strada-interp [OPTIONS] <file.strada>  Execute file");
    say("  strada-interp -e 'code'                Execute code string");
    say("");
    say("Options:");
    say("  -e CODE       Execute code (wraps in main() if needed)");
    say("  --vm          Use bytecode VM backend (default)");
    say("  -L PATH       Add library search path");
    say("  --no-gil      Threads run in parallel with no interpreter lock");
    say("  --gil-interval-us N  Lock handover interval for a busy thread (default 5000)");
    say("  --no-jit      Run bytecode in the interpreter loop only (no native code)");
    say("  --no-gc       Start with the runtime's cycle collector off");
    say("  --exit-task-wait-ms N  How long exit waits for running pool tasks (default 1000)");
    say("  --no-pool     Debug: no free-list pools in the runtime");
    say("  --debug-bless Debug: trace bless and method dispatch to stderr");
    say("  -h, --help    Show this help message");
}

func eval_has_entry_func(str $src) int {
    if (length($src) == 0) { return 0; }
    my scalar $toks = lex_tokenize($src);
    my int $n = size($toks);
    my int $brace_depth = 0;
    my str $cur_pkg = "main";
    my int $i = 0;
    while ($i < $n) {
        my scalar $t = $toks->[$i];
        my str $tt = $t->{"type"};
        if ($tt eq "LBRACE") {
            $brace_depth = $brace_depth + 1;
        } elsif ($tt eq "RBRACE") {
            if ($brace_depth > 0) { $brace_depth = $brace_depth - 1; }
        } elsif ($brace_depth == 0) {
            if ($tt eq "PACKAGE" && $i + 1 < $n) {
                my int $pi = $i + 1;
                my str $pkg = "";
                while ($pi < $n) {
                    my scalar $ptok = $toks->[$pi];
                    my str $pt = $ptok->{"type"};
                    if ($pt eq "SEMI" || $pt eq "LBRACE") { last; }
                    if (($pt eq "IDENT" || $pt eq "DOUBLE_COLON") && defined($ptok->{"value"})) {
                        $pkg = $pkg . $ptok->{"value"};
                    }
                    $pi = $pi + 1;
                }
                if (length($pkg) > 0) { $cur_pkg = $pkg; }
                $i = $pi;
                next;
            }
            if (($tt eq "FUNC" || ($tt eq "IDENT" && defined($t->{"value"}) && $t->{"value"} eq "fn")) && $i + 2 < $n) {
                my scalar $nt = $toks->[$i + 1];
                my scalar $at = $toks->[$i + 2];
                if ($cur_pkg eq "main" && $nt->{"type"} eq "IDENT" && defined($nt->{"value"}) &&
                    ($nt->{"value"} eq "main" || $nt->{"value"} eq "run") &&
                    ($at->{"type"} eq "LPAREN" || $at->{"type"} eq "LBRACE")) {
                    return 1;
                }
            }
        }
        $i = $i + 1;
    }
    return 0;
}

# Parse a -e code snippet into an AST program (wrapping top-level or bare statements in main)
func parse_eval_program(str $code) scalar {
    my str $trimmed = str_trim($code);
    if (length($trimmed) == 0) { return undef; }
    $trimmed = Strada::Interpreter::eval_append_trailing_semi($trimmed);

    my scalar $units = Strada::Interpreter::split_eval_units($trimmed, "main");
    my str $top_src = $units->{"top"};
    my str $body_src = $units->{"body"};
    my str $body_pkg = $units->{"body_pkg"};
    my scalar $segs = $units->{"segments"};
    my int $seg_cnt = defined($segs) ? size($segs) : 0;
    my str $source = $trimmed;
    if (length($body_src) == 0) {
        if (eval_has_entry_func($top_src) == 0) {
            $source = $top_src . "\npackage main;\nfunc main() int { return 0; }\n";
        }
    } elsif ($seg_cnt > 1) {
        $source = $top_src . "\n";
        my str $calls = "";
        my int $si = 0;
        while ($si < $seg_cnt) {
            my scalar $sg = $segs->[$si];
            my str $spkg = $sg->{"pkg"};
            my str $sfn = "__eval_seg_" . $si . "__";
            $source = $source . "package " . $spkg . ";\nfunc " . $sfn . "() void {\n" . $sg->{"body"} . "\n}\n";
            $calls = $calls . "    " . $spkg . "::" . $sfn . "();\n";
            $si = $si + 1;
        }
        $source = $source . "package main;\nfunc main() int {\n" . $calls . "    return 0;\n}\n";
    } elsif ($body_pkg ne "main") {
        $source = $top_src . "\npackage " . $body_pkg . ";\nfunc __eval_body__() void {\n" . $body_src . "\n}\npackage main;\nfunc main() int { " . $body_pkg . "::__eval_body__(); return 0; }\n";
    } else {
        my str $pfx = (length($top_src) > 0) ? ($top_src . "\npackage main;\n") : "";
        $source = $pfx . "func main() int {\n" . $body_src . "\nreturn 0;\n}\n";
    }

    my array @lib_paths = build_lib_paths("");
    if (length("" . core::getenv("STRADA_USE_ARTIFACTS")) == 0) {
        core::setenv("STRADA_USE_ARTIFACTS", "0");
    }

    my scalar $tokens = lex_tokenize($source);
    my scalar $parser = parser_new($tokens);
    parser_set_filename($parser, "<eval>");
    my array @empty = ();
    return parse_program($parser, \@lib_paths, \@empty, \@empty, \@empty);
}

# Execute a code string using the bytecode VM (-e)
func run_eval_vm(str $code, scalar $argv) int {
    my scalar $program = parse_eval_program($code);
    if (!defined($program)) { return 0; }
    return run_vm_program($program, "-e", $argv, "");
}

func main() int {
    my int $argc = size(@ARGV);

    # Parse options
    my str $script = "";
    my str $eval_code = "";
    my int $has_eval = 0;
    my array @script_args = ();
    my int $i = 0;
    my int $parsing_opts = 1;
    my int $gil_enabled = 1;
    my int $gil_us = 0;
    my int $rt_no_gc = 0;
    my int $vm_no_jit = 0;
    my int $rt_no_pool = 0;
    my int $rt_debug_bless = 0;
    my int $rt_exit_ms = -1;

    while ($i < $argc) {
        my str $arg = $ARGV[$i];

        if ($parsing_opts == 1 && ($arg eq "-h" || $arg eq "--help")) {
            print_usage();
            return 0;
        } elsif ($parsing_opts == 1 && $arg eq "--vm") {
            # Bytecode VM is the only backend; accepted for compatibility.
        } elsif ($parsing_opts == 1 && $arg eq "-e") {
            $has_eval = 1;
            $i = $i + 1;
            if ($i >= $argc) {
                say("Error: -e requires a code argument");
                return 1;
            }
            if (length($eval_code) > 0) {
                $eval_code = $eval_code . "\n" . $ARGV[$i];
            } else {
                $eval_code = $ARGV[$i];
            }
        } elsif ($parsing_opts == 1 && $arg eq "--no-gil") {
            $gil_enabled = 0;
        } elsif ($parsing_opts == 1 && $arg eq "--no-jit") {
            $vm_no_jit = 1;
        } elsif ($parsing_opts == 1 && $arg eq "--no-gc") {
            $rt_no_gc = 1;
        } elsif ($parsing_opts == 1 && $arg eq "--no-pool") {
            $rt_no_pool = 1;
        } elsif ($parsing_opts == 1 && $arg eq "--debug-bless") {
            $rt_debug_bless = 1;
        } elsif ($parsing_opts == 1 && $arg eq "--exit-task-wait-ms") {
            $i = $i + 1;
            $rt_exit_ms = -1;
            if ($i < $argc && $ARGV[$i] =~ /^[0-9]+$/) { $rt_exit_ms = int($ARGV[$i]); }
            if ($rt_exit_ms < 0 || $rt_exit_ms > 3600000) {
                say("Error: --exit-task-wait-ms requires a number of milliseconds from 0 to 3600000");
                return 1;
            }
        } elsif ($parsing_opts == 1 && $arg eq "--gil-polls") {
            # Compiler option; the VM always checks. Accepted so one flag set
            # works for both backends.
        } elsif ($parsing_opts == 1 && $arg eq "--gil-interval-us") {
            $i = $i + 1;
            if ($i < $argc) { $gil_us = int($ARGV[$i]); }
            if ($gil_us < 1 || $gil_us > 1000000) {
                say("Error: --gil-interval-us requires a number of microseconds from 1 to 1000000");
                return 1;
            }
        } elsif ($parsing_opts == 1 && $arg eq "-L") {
            $i = $i + 1;
            if ($i >= $argc) {
                say("Error: -L requires a path argument");
                return 1;
            }
            push(@g_lib_paths, $ARGV[$i]);
        } elsif ($parsing_opts == 1 && starts_with($arg, "-L")) {
            push(@g_lib_paths, substr($arg, 2, length($arg) - 2));
        } elsif ($parsing_opts == 1 && $arg eq "--") {
            $parsing_opts = 0;
        } elsif ($parsing_opts == 1 && starts_with($arg, "-")) {
            say("Unknown option: " . $arg);
            say("Use --help for usage information");
            return 1;
        } else {
            if (length($script) == 0 && $has_eval == 0) {
                $script = $arg;
            } else {
                push(@script_args, $arg);
            }
            $parsing_opts = 0;
        }

        $i = $i + 1;
    }

    # Thread lock settings: fixed before any program code runs.
    if ($gil_enabled == 0 || $gil_us > 0) {
        __C__ {
            strada_gil_configure((int)strada_to_int(gil_enabled), (long)strada_to_int(gil_us));
        }
    }

    # Other runtime settings given on the command line (never the environment).
    __C__ {
        if (strada_to_int(vm_no_jit)) vm_set_no_jit(1);
        if (strada_to_int(rt_no_pool)) strada_set_no_pool(1);
        if (strada_to_int(rt_no_gc)) strada_gc_set_enabled(0);
        if (strada_to_int(rt_debug_bless)) strada_set_debug_bless(1);
        if (strada_to_int(rt_exit_ms) >= 0) strada_set_exit_task_wait_ms((long)strada_to_int(rt_exit_ms));
    }

    # Eval mode (-e)
    if ($has_eval == 1) {
        try {
            return run_eval_vm($eval_code, \@script_args);
        } catch ($e) {
            say(STDERR, "VM error: " . $e);
            return 1;
        }
    }

    if (length($script) == 0) {
        run_repl();
        return 0;
    }

    # File mode
    my int $exit_code = 0;
    try {
        $exit_code = run_file_vm($script, \@script_args);
    } catch ($e) {
        say(STDERR, "VM error: " . $e);
        $exit_code = 1;
    }
    return $exit_code;
}
