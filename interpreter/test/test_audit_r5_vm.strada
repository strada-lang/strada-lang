        $sum = $sum + size(@tmp_arr);
    }
    {
        my int $after_arr = 7;
        $sum = $sum + $after_arr;
    }
    return $sum;
}

func test_vm5_07_signals() void {
    $g_rhs_called = 0;
    ok(ret_in_binop_left() == 42 && $g_rhs_called == 0, "VM5-07 return in binop left aborts RHS");
    ok(ret_in_call_first_arg() == 77 && $g_rhs_called == 0, "VM5-07 return in call arg aborts remaining args");

    my int $redo_tries = 0;
    my array @nums = (1, 2, 3, 4, 5);
    my array @mapped = map {
        if ($_ == 2) { next; }
        if ($_ == 3 && $redo_tries == 0) { $redo_tries = 1; redo; }
        if ($_ == 5) { last; }
        $_ * 10;
    } @nums;
    ok(join(",", @mapped) eq "10,30,40", "VM5-07 next/redo/last inside map");

    my int $g_redo = 0;
    my array @grepped = grep {
        if ($_ == 1) { next; }
        if ($_ == 2 && $g_redo == 0) { $g_redo = 1; redo; }
        if ($_ == 5) { last; }
        $_ % 2 == 0;
    } @nums;
    ok(join(",", @grepped) eq "2,4", "VM5-07 next/redo/last inside grep");

    my int $fin_ran = 0;
    my int $catch_ran = 0;
    try {
        goto AFTER_TRY;
    } catch ($e) {
        $catch_ran = 1;
    } finally {
        $fin_ran = 1;
    }
    AFTER_TRY:
    ok($fin_ran == 1 && $catch_ran == 0, "VM5-07 goto out of try runs finally without catch");
}

func test_vm5_08_default_throw() void {
    core::set_recursion_limit(15);
    $g_def_calls = 0;
    my int $caught = 0;
    my int $i = 0;
    while ($i < 20) {
        try {
            bad_default_fn();
        } catch ($e) {
            $caught = $caught + 1;
        }
        $i = $i + 1;
    }
    core::set_recursion_limit(1000);
    ok($caught == 20 && $g_def_calls == 20, "VM5-08 throwing default param does not leak call_depth");
    ok(bad_default_fn(10) == 11, "VM5-08 explicit arg skips throwing default");
    ok(opt_add_pair() == 119 && opt_add_pair(4) == 104 && opt_add_pair(4, 1) == 5 && opt_add_pair(0, 0) == 0, "VM5-08 multi-arg default parameters (including explicit 0)");
}

func test_vm5_09_and_11() void {
    my int $outer = 0;
    my array @items = (11, 22, 33);
    foreach $outer (@items) {
    }
    ok($outer == 33, "VM5-09 non-lexical foreach updates outer scalar");

    my scalar $obj = R5AroundC::new(5);
    ok($obj->calc(3) == 123, "VM5-09 MRO-chained around modifiers run child -> parent -> method");

    my hash %th = ();
    my scalar $tobj = tie(%th, "R5TrackTie");
    $th{"keep"} = "orig";
    {
        local $th{"keep"} = "temp_keep";
        local $th{"added"} = "temp_add";
        ok($th{"keep"} eq "temp_keep" && $th{"added"} eq "temp_add", "VM5-09 local tied hash inside block");
    }
    ok($th{"keep"} eq "orig" && !exists($th{"added"}), "VM5-09 local tied hash restored on block exit");
    my str $logs = $tobj->logs();
    ok(index($logs, "STORE:keep=temp_keep") >= 0 && index($logs, "DELETE:added") >= 0 && index($logs, "STORE:keep=orig") >= 0, "VM5-09 local tied hash invoked STORE and DELETE");
    untie(%th);

    my int $step = 0;
    my str $trace = "";
    goto START_SM;
    $trace = $trace . "SKIPPED:";
    START_SM:
    $step = $step + 1;
    $trace = $trace . $step;
    if ($step < 3) {
        goto START_SM;
    }
    ok($trace eq "123", "VM5-11 forward and backward goto state machine");

    my int $ticks = 0;
    OUTER: for (my int $oi = 0; $oi < 3; $oi = $oi + 1) {
        for (my int $ij = 0; $ij < 3; $ij = $ij + 1) {
            if ($ij == 1) {
                next OUTER;
            }
            $ticks = $ticks + 1;
        }
    }
    ok($ticks == 3, "VM5-11 next OUTER advances outer for step expression");
}

func test_sl5_03_08_rand_datetime() void {
    core::srand();
    core::srandom();
    math::srand();
    my num $rn = math::rand();
    ok($rn >= 0.0 && $rn <= 1.0, "SL5-03 0-arg srand/srandom/math::srand");

    my int $off = DateTime::timezone_offset();
    my str $tzn = DateTime::timezone_name();
    ok($off >= -50400 && $off <= 50400 && length($tzn) > 0, "SL5-08 DateTime timezone_offset & timezone_name");

    my scalar $dt = DateTime::make(2026, 6, 15, 14, 30, 0);
    my str $pad = "0123456789" x 30;
    my str $fmt = "%Y-" . $pad;
    my str $out = DateTime::format($dt, $fmt);
    ok(length($out) == 305 && index($out, "2026-0123456789") == 0, "SL5-08 DateTime::format >256 bytes");
}

func main() int {
    test_vm5_01_handles();
    test_vm5_04_regex();
    ok(test_vm5_05_many_block_locals() == 968, "VM5-05 >300 sequential block locals + mixed container/scalar");
    test_vm5_07_signals();
    test_vm5_08_default_throw();
    test_vm5_09_and_11();
    test_sl5_03_08_rand_datetime();

    my int $cc_a = 65;
    my int $cc_z = 90;
    my str $nl = '\n';
    my str $s0 = '0';
    my num $f0 = 0.0;
    ok('0' == 48 && '9' == 57 && $cc_a == 'A' && $cc_z == 'Z' && 'Z' == 90
       && '\n' == 10 && '\t' == 9 && '\r' == 13 && '\0' == 0
       && '\'' == 39 && '\\' == 92 && '"' == 34 && '\x7f' == 127
       && 'a' < 'z' && ord("A") == 65
       && typeof(48) eq "int" && 0xFF == 255 && 0b1010 == 10 && 0o77 == 63
       && length($nl) == 2 && $s0 eq '0' && $f0 == '0',
       "CC5-06 single-char comparisons 'x'");

    if ($g_fail > 0) {
        say("VM_INTERP_CORE_FAIL: " . $g_fail);
        return 1;
    }
    say("R5_VM_INTERP_CORE_OK");
    return 0;
}
