# Cycle 5 VM & Tree-Walk Interpreter regression tests (based on t/audit_r5/vm_interp_core.strada)

use lib "../lib";
use lib "lib";
use DateTime;

our int $g_fail = 0;

func ok(int $cond, str $label) void {
    if ($cond == 0) {
        say("FAIL: " . $label);
        $g_fail = $g_fail + 1;
    }
}

# --- VM5-08: throwing default parameter ---
our int $g_def_calls = 0;
func throw_default_helper() int {
    $g_def_calls = $g_def_calls + 1;
    throw("default_boom");
    return 0;
}

func bad_default_fn(int $x = throw_default_helper()) int {
    return $x + 1;
}

func opt_add_pair(int $a = 19, int $b = 100) int {
    return $a + $b;
}

# --- VM5-07 helpers ---
our int $g_rhs_called = 0;
func rhs_should_not_run() int {
    $g_rhs_called = $g_rhs_called + 1;
    return 1000;
}

func take_two_ints(int $a, int $b) int {
    return $a + $b;
}

func ret_in_binop_left() int {
    my array @xs = (1, 2);
    my int $v = scalar(map { return 42; } @xs) + rhs_should_not_run();
    return $v;
}

func ret_in_call_first_arg() int {
    my array @xs = (1, 2);
    return take_two_ints(scalar(map { return 77; } @xs), rhs_should_not_run());
}

# --- VM5-09: MRO-chained around modifiers ---
package R5AroundP;
func new(int $v) scalar {
    my hash %s = ("v" => $v);
    return bless(\%s, "R5AroundP");
}
func calc(scalar $self, int $x) int {
    return $self->{"v"} + $x;
}
around "calc" func(scalar $orig, scalar $self, int $x) int {
    return $orig->($self, $x * 2) + 100;
}

package R5AroundC;
extends R5AroundP;
func new(int $v) scalar {
    my hash %s = ("v" => $v);
    return bless(\%s, "R5AroundC");
}
around "calc" func(scalar $orig, scalar $self, int $x) int {
    return $orig->($self, $x + 1) + 10;
}

# --- VM5-09: Tied hash for local $h{"k"} ---
package R5TrackTie;
func TIEHASH(scalar ...@args) scalar {
    my hash %self = ();
    my hash %data = ();
    my array @log = ();
    $self{"data"} = \%data;
    $self{"log"} = \@log;
    return bless(\%self, "R5TrackTie");
}

func FETCH(scalar $self, str $key) scalar {
    push($self->{"log"}, "FETCH:" . $key);
    my scalar $d = $self->{"data"};
    return $d->{$key};
}

func STORE(scalar $self, str $key, scalar $val) void {
    push($self->{"log"}, "STORE:" . $key . "=" . (defined($val) ? ("" . $val) : "undef"));
    my scalar $d = $self->{"data"};
    $d->{$key} = $val;
}

func EXISTS(scalar $self, str $key) int {
    my scalar $d = $self->{"data"};
    return exists($d->{$key}) ? 1 : 0;
}

func DELETE(scalar $self, str $key) scalar {
    push($self->{"log"}, "DELETE:" . $key);
    my scalar $d = $self->{"data"};
    my scalar $old = $d->{$key};
    delete($d, $key);
    return $old;
}

func logs(scalar $self) str {
    return join(",", @{$self->{"log"}});
}

package main;

func uc_word(str $s) str {
    return uc($s);
}

func test_vm5_01_handles() void {
    my str $tmp = "/tmp/r5_interp_vm_io_test.txt";
    my scalar $wfd = core::open($tmp, "w");
    ok(defined($wfd), "VM5-01 open write filehandle");
    say($wfd, "line1");
    say($wfd, "line2");
    core::close($wfd);

    my scalar $rfd = core::open($tmp, "r");
    ok(defined($rfd), "VM5-01 open read filehandle");
    core::seek($rfd, 6, 0);
    my int $pos = core::tell($rfd);
    ok($pos == 6, "VM5-01 seek/tell keeps handle open");
    my str $rest = core::slurp_fh($rfd);
    ok($rest eq "line2\n", "VM5-01 slurp_fh after seek/tell");
    my int $rc = core::close($rfd);
    ok($rc == 1, "VM5-01 explicit close succeeds");
    my int $rc2 = core::close($rfd);
    ok($rc2 == 0, "VM5-01 second close on closed handle returns 0");
    core::unlink($tmp);

    my scalar $mwh = core::open_str("", "w");
    say($mwh, "mem_alpha");
    my str $got_mem = core::str_from_fh($mwh);
    ok($got_mem eq "mem_alpha\n", "VM5-01 open_str write + str_from_fh");
    core::close($mwh);

    my scalar $mrh = core::open_str("mem_first\nmem_second\n", "r");
    my str $rl = core::readline($mrh);
    ok($rl eq "mem_first", "VM5-01 open_str read + readline");
    core::close($mrh);

    my scalar $pfh = core::popen("echo vm5_popen_ok", "r");
    ok(defined($pfh), "VM5-01 popen returns valid handle");
    my str $pout = core::readline($pfh);
    ok($pout eq "vm5_popen_ok", "VM5-01 popen readline");
    my int $pc1 = core::pclose($pfh);
    ok($pc1 == 0, "VM5-01 pclose returns 0");
    my int $pc2 = core::pclose($pfh);
    ok($pc2 == -1, "VM5-01 double pclose returns -1 safely");
}

func test_vm5_04_regex() void {
    my str $s1 = "hello foo world";
    my int $c1 = ($s1 =~ s/(foo)/bar/);
    my array @caps1 = captures();
    ok($c1 == 1, "VM5-04 s/// returns count 1");
    ok($s1 eq "hello bar world", "VM5-04 s/// mutates target");
    ok($1 eq "foo" && size(@caps1) >= 2 && $caps1[1] eq "foo", "VM5-04 s/// populates \$1 and captures()");

    my str $s2 = "a1b22c333";
    my int $c2 = ($s2 =~ s/\d+/X/g);
    ok($c2 == 3 && $s2 eq "aXbXcX", "VM5-04 s///g returns count 3 and mutates target");

    my str $s3 = "ab cd";
    my int $c3 = ($s3 =~ s/([a-z]+)/uc_word($1)/ge);
    ok($c3 == 2 && $s3 eq "AB CD", "VM5-04 s///ge returns count and evaluates replacement");

    my str $s4 = "foo baz";
    my str $r4 = ($s4 =~ s/foo/bar/r);
    ok($r4 eq "bar baz" && $s4 eq "foo baz", "VM5-04 s///r returns modified copy without mutating");
    my str $r4_nomatch = ($s4 =~ s/nomatch/bar/r);
    ok($r4_nomatch eq "foo baz" && $s4 eq "foo baz", "VM5-04 s///r zero-match returns copy without mutating");
    my str $r4_lit = ("hi there" =~ s/there/strada/r);
    ok($r4_lit eq "hi strada", "VM5-04 s///r on string literal");
    my str $s4e = "ab cd";
    my str $r4e = ($s4e =~ s/([a-z]+)/uc_word($1)/ger);
    ok($r4e eq "AB CD" && $s4e eq "ab cd", "VM5-04 s///ger evaluates replacement without mutating target");

    my str $tr_in = "hello 123";
    my str $tr_out = ($tr_in =~ tr/a-z/A-Z/r);
    ok($tr_out eq "HELLO 123" && $tr_in eq "hello 123", "VM5-04 tr///r returns translated copy without mutating");
    my str $tr_lit = ("xyz" =~ tr/x-z/A-C/r);
    ok($tr_lit eq "ABC", "VM5-04 tr///r on string literal");

    my int $m5 = match("abc123", "([a-z]+)(\\d+)");
    ok($m5 == 1 && $1 eq "abc" && $2 eq "123", "VM5-04 match() populates \$1 and \$2");
}

