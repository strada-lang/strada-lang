func main() int {
    my array @nums = (5, 2, 8, 1, 9, 3);

    # Map
    my array @doubled = map { $_ * 2; } @nums;
    say(join(" ", @doubled));

    # Grep
    my array @big = grep { $_ > 4; } @nums;
    say(join(" ", @big));

    # Sort
    my array @sorted = sort { $a <=> $b; } @nums;
    say(join(" ", @sorted));

    # Sort descending
    my array @desc = sort { $b <=> $a; } @nums;
    say(join(" ", @desc));

    return 0;
}
