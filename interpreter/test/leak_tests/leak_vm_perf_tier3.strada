# Valgrind leak test for Tier 3 & Tier 4 VM optimizations (OSR JIT, tail calls, OOP IC, exceptions, workers)

package LeakT3Obj;
func new(str $cls, int $v) scalar { return bless({"val" => $v}, $cls); }
func inc(scalar $self, int $d) int {
    $self->{"val"} = $self->{"val"} + $d;
    return $self->{"val"};
}
func DESTROY(scalar $self) void {
    my int $x = $self->{"val"};
}

package LeakT3Alt;
func new(str $cls, int $v) scalar { return bless({"val" => $v}, $cls); }
func inc(scalar $self, int $d) int {
    $self->{"val"} = $self->{"val"} + $d * 2;
    return $self->{"val"};
}

package main;
our int $g_lt3 = 0;

func hot_loop(int $n) int {
    my int $acc = 0;
    for (my int $i = 0; $i < $n; $i++) {
        $acc += (($i & 15) + 1);
    }
    return $acc;
}

func tail_worker(int $n, int $acc) int {
    if ($n <= 0) { return $acc; }
    return tail_worker($n - 1, $acc + 1);
}

func throw_jit_deep(int $depth) int {
    if ($depth <= 0) { throw "leak_exc"; }
    return 1 + throw_jit_deep($depth - 1);
}

func main() int {
    # 1. Hot JIT loop + OSR
    my int $s = 0;
    for (my int $i = 0; $i < 100; $i++) {
        $s += hot_loop(200);
    }

    # 2. Deep JIT tail calls with tight recursion limit
    core::set_recursion_limit(200);
    my int $ts = 0;
    for (my int $i = 0; $i < 20; $i++) {
        $ts += tail_worker(1500, 0);
    }
    core::set_recursion_limit(0);

    # 3. OOP mono-IC + polymorphic IC + temporaries with DESTROY + globals/StrBuf append
    my scalar $o1 = LeakT3Obj::new("LeakT3Obj", 1);
    my scalar $o2 = LeakT3Alt::new("LeakT3Alt", 1);
    my int $oc = 0;
    my str $sb = "";
    for (my int $i = 0; $i < 200; $i++) {
        $oc += $o1->inc(1);
        $oc += (($i & 1) ? $o1 : $o2)->inc(1);
        $sb .= "x";
        $g_lt3 += 1;
        if (($i % 40) == 0) {
            my scalar $tmp = LeakT3Obj::new("LeakT3Obj", $i);
            $oc += $tmp->inc(2);
        }
    }

    # 4. Exceptions unwinding across compiled JIT call frames & OSR loops
    my int $ex = 0;
    for (my int $i = 0; $i < 60; $i++) {
        try {
            throw_jit_deep(5);
        } catch ($e) {
            if ($e eq "leak_exc") { $ex++; }
        }
    }
    try {
        for (my int $i = 0; $i < 120; $i++) {
            if ($i == 90) { throw "osr_end"; }
        }
    } catch ($e2) {
        if ($e2 eq "osr_end") { $ex += 10; }
    }

    # 5. Concurrent worker threads running JIT loops
    my array @ths = ();
    for (my int $t = 0; $t < 2; $t++) {
        push(@ths, thread::create(func () int {
            return hot_loop(1000) + tail_worker(500, 0);
        }));
    }
    my int $wsum = 0;
    for (my int $t = 0; $t < 2; $t++) {
        $wsum += thread::join($ths[$t]);
    }

    if ($s <= 0 || $ts != 30000 || $oc <= 0 || length($sb) != 200 || $g_lt3 != 200 || $ex != 70 || $wsum <= 0) {
        return 1;
    }
    say("LEAK_VM_PERF_TIER3_OK");
    return 0;
}
