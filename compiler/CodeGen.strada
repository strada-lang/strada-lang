# CodeGen.strada - C Code Generator for self-hosting Strada compiler
# Transforms AST into C source code

# ============================================================
# Code Generator State
# ============================================================

# Sanitize function names for C (replace :: with _)
# Module-only codegen filter (--object / -M).
# Returns 1 if the item should be SKIPPED because it was inlined from a
# `use`d module (and therefore lives in some other module's .o, not ours).
# Returns 0 in all other cases (full-program mode, or the item came from
# the file we're compiling).
#
# Items are tagged at parse time: load_module sets $item->{"from_use"} = 1
# on everything it transfers into the main program; top-level parse leaves
# this unset/0 on the file's own functions, globals, BEGIN/END blocks, and
# top-level __C__ blocks. So the filter is just a boolean check.
#
# Accepts either a program or codegen context (both carry module_only_mode).
func cg_skip_for_module(scalar $ctx, int $from_use) int {
    if ($ctx->{"module_only_mode"} != 1) { return 0; }
    if ($from_use == 1) { return 1; }
    return 0;
}

func sanitize_name(str $name) str {
    my str $result = "";
    my int $i = 0;
    my int $len = length($name);
    while ($i < $len) {
        my str $ch = substr($name, $i, 1);
        if ($ch eq ":") {
            # Check for :: sequence and replace with single _
            if ($i + 1 < $len && substr($name, $i + 1, 1) eq ":") {
                $result = $result . "_";
                $i = $i + 1;  # Skip the second colon
            } else {
                $result = $result . "_";
            }
        } else {
            # Map anything that is not a valid C identifier char to '_'. Without
            # this a crafted name (e.g. an import name containing ';', '(', or a
            # space) would inject raw tokens into the generated C symbol.
            my int $code = char_at($name, $i);
            if (($code >= '0' && $code <= '9') || ($code >= 'A' && $code <= 'Z') || ($code >= 'a' && $code <= 'z') || $code == '_') {
                $result = $result . $ch;
            } else {
                $result = $result . "_";
            }
        }
        $i = $i + 1;
    }
    return $result;
}

# Escape C keywords used as variable names by prefixing with v_
func escape_c_keyword(str $name) str {
    # C keywords that conflict with Strada variable names
    if ($name eq "for") { return "v_for"; }
    if ($name eq "while") { return "v_while"; }
    if ($name eq "if") { return "v_if"; }
    if ($name eq "else") { return "v_else"; }
    if ($name eq "switch") { return "v_switch"; }
    if ($name eq "case") { return "v_case"; }
    if ($name eq "default") { return "v_default"; }
    if ($name eq "break") { return "v_break"; }
    if ($name eq "continue") { return "v_continue"; }
    if ($name eq "return") { return "v_return"; }
    if ($name eq "goto") { return "v_goto"; }
    if ($name eq "do") { return "v_do"; }
    if ($name eq "int") { return "v_int"; }
    if ($name eq "char") { return "v_char"; }
    if ($name eq "float") { return "v_float"; }
    if ($name eq "double") { return "v_double"; }
    if ($name eq "void") { return "v_void"; }
    if ($name eq "long") { return "v_long"; }
    if ($name eq "short") { return "v_short"; }
    if ($name eq "unsigned") { return "v_unsigned"; }
    if ($name eq "signed") { return "v_signed"; }
    if ($name eq "const") { return "v_const"; }
    if ($name eq "static") { return "v_static"; }
    if ($name eq "extern") { return "v_extern"; }
    if ($name eq "register") { return "v_register"; }
    if ($name eq "volatile") { return "v_volatile"; }
    if ($name eq "auto") { return "v_auto"; }
    if ($name eq "struct") { return "v_struct"; }
    if ($name eq "union") { return "v_union"; }
    if ($name eq "enum") { return "v_enum"; }
    if ($name eq "typedef") { return "v_typedef"; }
    if ($name eq "sizeof") { return "v_sizeof"; }
    # C99/C11/C23 keywords
    if ($name eq "inline") { return "v_inline"; }
    if ($name eq "restrict") { return "v_restrict"; }
    if ($name eq "_Bool") { return "v_Bool"; }
    if ($name eq "_Complex") { return "v_Complex"; }
    if ($name eq "_Imaginary") { return "v_Imaginary"; }
    if ($name eq "_Alignas") { return "v_Alignas"; }
    if ($name eq "_Alignof") { return "v_Alignof"; }
    if ($name eq "_Atomic") { return "v_Atomic"; }
    if ($name eq "_Generic") { return "v_Generic"; }
    if ($name eq "_Noreturn") { return "v_Noreturn"; }
    if ($name eq "_Static_assert") { return "v_Static_assert"; }
    if ($name eq "_Thread_local") { return "v_Thread_local"; }
    if ($name eq "alignas") { return "v_alignas"; }
    if ($name eq "alignof") { return "v_alignof"; }
    if ($name eq "constexpr") { return "v_constexpr"; }
    if ($name eq "nullptr") { return "v_nullptr"; }
    if ($name eq "static_assert") { return "v_static_assert"; }
    if ($name eq "thread_local") { return "v_thread_local"; }
    if ($name eq "typeof_unqual") { return "v_typeof_unqual"; }
    # C macros for standard I/O and C99/GNU/POSIX identifiers
    if ($name eq "STDIN") { return "v_STDIN"; }
    if ($name eq "STDOUT") { return "v_STDOUT"; }
    if ($name eq "STDERR") { return "v_STDERR"; }
    if ($name eq "bool") { return "v_bool"; }
    if ($name eq "true") { return "v_true"; }
    if ($name eq "false") { return "v_false"; }
    if ($name eq "errno") { return "v_errno"; }
    if ($name eq "NULL") { return "v_NULL"; }
    if ($name eq "EOF") { return "v_EOF"; }
    if ($name eq "asm") { return "v_asm"; }
    if ($name eq "typeof") { return "v_typeof"; }
    # Standard <math.h> / <stdlib.h> / <string.h> symbols emitted in generated C
    if ($name eq "pow") { return "v_pow"; }
    if ($name eq "sin") { return "v_sin"; }
    if ($name eq "cos") { return "v_cos"; }
    if ($name eq "tan") { return "v_tan"; }
    if ($name eq "sqrt") { return "v_sqrt"; }
    if ($name eq "log") { return "v_log"; }
    if ($name eq "exp") { return "v_exp"; }
    if ($name eq "floor") { return "v_floor"; }
    if ($name eq "ceil") { return "v_ceil"; }
    if ($name eq "fabs") { return "v_fabs"; }
    if ($name eq "fmod") { return "v_fmod"; }
    if ($name eq "free") { return "v_free"; }
    if ($name eq "malloc") { return "v_malloc"; }
    if ($name eq "calloc") { return "v_calloc"; }
    if ($name eq "realloc") { return "v_realloc"; }
    if ($name eq "memcpy") { return "v_memcpy"; }
    if ($name eq "memset") { return "v_memset"; }
    if ($name eq "strlen") { return "v_strlen"; }
    if ($name eq "strcmp") { return "v_strcmp"; }
    if ($name eq "stdin") { return "v_stdin"; }
    if ($name eq "stdout") { return "v_stdout"; }
    if ($name eq "stderr") { return "v_stderr"; }
    return $name;
}

# Mangle top-level user function names that collide with standard C/POSIX symbols.
# Package-qualified names (Foo::open -> Foo_open), C-boundary/extern functions,
# main, and DESTROY are left untouched to preserve ABI and FFI.
func mangle_c_func_ident(str $sanitized, str $orig_name, int $is_c_boundary) str {
    if ($is_c_boundary == 1 || $orig_name eq "main" || $orig_name eq "DESTROY" || index($orig_name, "::") >= 0) {
        return "" . $sanitized;
    }
    if ($sanitized eq "open" || $sanitized eq "close" || $sanitized eq "read" || $sanitized eq "write"
        || $sanitized eq "lseek" || $sanitized eq "stat" || $sanitized eq "fstat" || $sanitized eq "lstat") { return "__strada_u_" . $sanitized; }
    if ($sanitized eq "access" || $sanitized eq "chmod" || $sanitized eq "chown" || $sanitized eq "mkdir"
        || $sanitized eq "rmdir" || $sanitized eq "unlink" || $sanitized eq "link" || $sanitized eq "symlink") { return "__strada_u_" . $sanitized; }
    if ($sanitized eq "readlink" || $sanitized eq "rename" || $sanitized eq "remove" || $sanitized eq "dup"
        || $sanitized eq "dup2" || $sanitized eq "pipe" || $sanitized eq "fork" || $sanitized eq "vfork") { return "__strada_u_" . $sanitized; }
    if ($sanitized eq "execve" || $sanitized eq "execvp" || $sanitized eq "execl" || $sanitized eq "wait"
        || $sanitized eq "waitpid" || $sanitized eq "kill" || $sanitized eq "raise" || $sanitized eq "signal") { return "__strada_u_" . $sanitized; }
    if ($sanitized eq "alarm" || $sanitized eq "pause" || $sanitized eq "sleep" || $sanitized eq "usleep"
        || $sanitized eq "getpid" || $sanitized eq "getppid" || $sanitized eq "getuid" || $sanitized eq "geteuid") { return "__strada_u_" . $sanitized; }
    if ($sanitized eq "getgid" || $sanitized eq "getegid" || $sanitized eq "chdir" || $sanitized eq "getcwd"
        || $sanitized eq "umask" || $sanitized eq "isatty" || $sanitized eq "fsync" || $sanitized eq "truncate") { return "__strada_u_" . $sanitized; }
    if ($sanitized eq "ftruncate" || $sanitized eq "realpath" || $sanitized eq "socket" || $sanitized eq "bind"
        || $sanitized eq "listen" || $sanitized eq "accept" || $sanitized eq "connect" || $sanitized eq "send") { return "__strada_u_" . $sanitized; }
    if ($sanitized eq "recv" || $sanitized eq "sendto" || $sanitized eq "recvfrom" || $sanitized eq "shutdown"
        || $sanitized eq "select" || $sanitized eq "poll" || $sanitized eq "fopen" || $sanitized eq "fclose") { return "__strada_u_" . $sanitized; }
    if ($sanitized eq "fread" || $sanitized eq "fwrite" || $sanitized eq "fseek" || $sanitized eq "ftell"
        || $sanitized eq "rewind" || $sanitized eq "fflush" || $sanitized eq "feof" || $sanitized eq "ferror") { return "__strada_u_" . $sanitized; }
    if ($sanitized eq "perror" || $sanitized eq "printf" || $sanitized eq "fprintf" || $sanitized eq "sprintf"
        || $sanitized eq "snprintf" || $sanitized eq "scanf" || $sanitized eq "sscanf" || $sanitized eq "getchar") { return "__strada_u_" . $sanitized; }
    if ($sanitized eq "putchar" || $sanitized eq "puts" || $sanitized eq "fputs" || $sanitized eq "fgets"
        || $sanitized eq "malloc" || $sanitized eq "calloc" || $sanitized eq "realloc" || $sanitized eq "free") { return "__strada_u_" . $sanitized; }
    if ($sanitized eq "abort" || $sanitized eq "exit" || $sanitized eq "_exit" || $sanitized eq "atexit"
        || $sanitized eq "system" || $sanitized eq "getenv" || $sanitized eq "setenv" || $sanitized eq "unsetenv") { return "__strada_u_" . $sanitized; }
    if ($sanitized eq "rand" || $sanitized eq "srand" || $sanitized eq "qsort" || $sanitized eq "bsearch"
        || $sanitized eq "atoi" || $sanitized eq "atol" || $sanitized eq "atof" || $sanitized eq "strtol") { return "__strada_u_" . $sanitized; }
    if ($sanitized eq "strtoul" || $sanitized eq "strtoll" || $sanitized eq "strtod" || $sanitized eq "strlen"
        || $sanitized eq "strcmp" || $sanitized eq "strncmp" || $sanitized eq "strcpy" || $sanitized eq "strncpy") { return "__strada_u_" . $sanitized; }
    if ($sanitized eq "strcat" || $sanitized eq "strncat" || $sanitized eq "strchr" || $sanitized eq "strrchr"
        || $sanitized eq "strstr" || $sanitized eq "strtok" || $sanitized eq "strerror" || $sanitized eq "index") { return "__strada_u_" . $sanitized; }
    if ($sanitized eq "rindex" || $sanitized eq "strcasecmp" || $sanitized eq "strncasecmp" || $sanitized eq "strdup"
        || $sanitized eq "strndup" || $sanitized eq "memcpy" || $sanitized eq "memmove" || $sanitized eq "memset") { return "__strada_u_" . $sanitized; }
    if ($sanitized eq "memcmp" || $sanitized eq "memchr" || $sanitized eq "time" || $sanitized eq "ctime"
        || $sanitized eq "gmtime" || $sanitized eq "localtime" || $sanitized eq "mktime" || $sanitized eq "strftime") { return "__strada_u_" . $sanitized; }
    if ($sanitized eq "difftime" || $sanitized eq "clock" || $sanitized eq "nanosleep" || $sanitized eq "sin"
        || $sanitized eq "cos" || $sanitized eq "tan" || $sanitized eq "asin" || $sanitized eq "acos") { return "__strada_u_" . $sanitized; }
    if ($sanitized eq "atan" || $sanitized eq "atan2" || $sanitized eq "sinh" || $sanitized eq "cosh"
        || $sanitized eq "tanh" || $sanitized eq "exp" || $sanitized eq "log" || $sanitized eq "log10") { return "__strada_u_" . $sanitized; }
    if ($sanitized eq "log2" || $sanitized eq "pow" || $sanitized eq "sqrt" || $sanitized eq "cbrt"
        || $sanitized eq "hypot" || $sanitized eq "ceil" || $sanitized eq "floor" || $sanitized eq "round") { return "__strada_u_" . $sanitized; }
    if ($sanitized eq "trunc" || $sanitized eq "fabs" || $sanitized eq "fmod" || $sanitized eq "remainder"
        || $sanitized eq "copysign" || $sanitized eq "fmax" || $sanitized eq "fmin" || $sanitized eq "abs") { return "__strada_u_" . $sanitized; }
    if ($sanitized eq "labs" || $sanitized eq "llabs" || $sanitized eq "div" || $sanitized eq "ldiv"
        || $sanitized eq "dlopen" || $sanitized eq "dlsym" || $sanitized eq "dlclose" || $sanitized eq "dlerror") {
        return "__strada_u_" . $sanitized;
    }
    # Every other identifier the runtime header (and the system headers it
    # includes, plus math.h) declares: a user function named random/getline/
    # basename/popen/sync/clone/stdin/... collided with it in C.
    if (c_ident_reserved($sanitized) == 1) { return "__strada_u_" . $sanitized; }
    return "" . $sanitized;
}

# Generated from `gcc -E` of runtime/strada_runtime.h and math.h
# (identifiers declared there that are not strada_-prefixed) plus a few
# macros/globals.
# (the list is searched in place: returning it from a function made a fresh
# ~10 KB string per identifier, which the frozen bootstrap's build of the
# compiler never released)
func c_ident_reserved(str $name) int {
    if (index(" _Exit _Fork _dl_find_object _dl_mcount_wrapper_check _exit _longjmp _setjmp _tolower _toupper a64l abort abs accept accept4 access acct acos acosf acosh acoshf acoshl acosl alarm aligned_alloc alloca arc4random arc4random_buf arc4random_uniform asctime asctime_r asin asinf asinh asinhf asinhl asinl asprintf assert at_quick_exit atan atan2 atan2f atan2l atanf atanh atanhf atanhl atanl atexit atof atoi atol atoll backtrace backtrace_symbols backtrace_symbols_fd basename bcmp bcopy bind bindresvport bindresvport6 brk bsearch byte_to_char_offset bzero calloc canonicalize_file_name cbrt cbrtf cbrtl ceil ceilf ceill cfgetispeed cfgetospeed cfmakeraw cfsetispeed cfsetospeed cfsetspeed chdir chown chroot clearenv clearerr clearerr_unlocked clock clock_adjtime clock_getcpuclockid clock_getres clock_gettime clock_nanosleep clock_settime clone close close_range closefrom confstr connect cookie_close_function_t cookie_read_function_t cookie_seek_function_t cookie_write_function_t copy_file_range copysign copysignf copysignl cos cosf cosh coshf coshl cosl creat creat64 crypt ctermid ctime ctime_r cuserid daemon daylight difftime div dladdr dladdr1 dlclose dlerror dlinfo dlmopen dlopen dlsym dlvsym dprintf drand48 drand48_r drem dremf dreml dup dup2 dup3 dysize eaccess ecvt ecvt_r endhostent endnetent endnetgrent endprotoent endrpcent endservent endusershell environ erand48 erand48_r erf erfc erfcf erfcl erff erfl errno euidaccess execl execle execlp execv execve execveat execvp execvpe exit exp exp2 exp2f exp2l expf expl explicit_bzero expm1 expm1f expm1l fabs fabsf fabsl faccessat fallocate fallocate64 fchdir fchown fchownat fclose fcloseall fcntl fcntl64 fcvt fcvt_r fdatasync fdim fdimf fdiml fdopen feof feof_unlocked ferror ferror_unlocked fexecve fflush fflush_unlocked ffs ffsl ffsll fgetc fgetc_unlocked fgetpos fgetpos64 fgets fgets_unlocked fileno fileno_unlocked finite finitef finitel flockfile floor floorf floorl fma fmaf fmal fmax fmaxf fmaxl fmemopen fm