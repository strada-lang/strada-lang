    if ($is_void == 1) {
        emit($cg, "strada_decref(__hca_new); (StradaValue*)NULL; })");
    } else {
        emit($cg, "__hca_new; })");
    }
}

# Compound assignment on array element: $a[$i] += expr (NODE_SUBSCRIPT)
# or $ref->[i] += expr (NODE_DEREF_ARRAY).
func gen_array_compound_assign(scalar $cg, scalar $target, scalar $rhs, str $op, int $is_void) void {
    my scalar $arr_expr;
    if ($target->{"type"} == NODE_DEREF_ARRAY()) {
        $arr_expr = $target->{"ref"};
    } else {
        $arr_expr = $target->{"array"};
    }
    my scalar $idx_expr = $target->{"index"};
    my int $rhs_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $rhs) == 1;
    my int $arr_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $arr_expr) == 1;
    my int $aca_autoviv = 0;
    if (autoviv_link_type($arr_expr) == 1) {
        $aca_autoviv = 1;
        $arr_cleanup = 0;
    }

    my str $aca_opch = "";
    if ($is_void == 1 && $cg->{"uses_tie"} == 0) {
        if ($op eq "+=") { $aca_opch = "'+'"; }
        elsif ($op eq "-=") { $aca_opch = "'-'"; }
        elsif ($op eq "*=") { $aca_opch = "'*'"; }
        elsif ($op eq "/=") { $aca_opch = "'/'"; }
        elsif ($op eq ".=") { $aca_opch = "'.'"; }
    }
    if (length($aca_opch) > 0) {
        emit($cg, "({ StradaValue *__aca_arr = ");
        if ($aca_autoviv == 1) {
            $cg->{"autoviv"} = 2;
        }
        gen_expression($cg, $arr_expr);
        emit($cg, "; StradaValue *__aca_rhs = ");
        gen_expression($cg, $rhs);
        emit($cg, "; ");
        if ($op eq "/=") {
            emit($cg, "if (strada_to_num(__aca_rhs) == 0.0) { ");
            if ($rhs_cleanup == 1) { emit($cg, "strada_decref(__aca_rhs); "); }
            if ($arr_cleanup == 1) { emit($cg, "strada_decref(__aca_arr); "); }
            emit($cg, "strada_throw(\"Illegal division by zero\"); } ");
        }
        emit($cg, "strada_array_compound(__aca_arr, ");
        emit_int_operand($cg, $idx_expr);
        emit($cg, ", __aca_rhs, " . $aca_opch . "); ");
        if ($rhs_cleanup == 1) { emit($cg, "strada_decref(__aca_rhs); "); }
        if ($arr_cleanup == 1) { emit($cg, "strada_decref(__aca_arr); "); }
        emit($cg, "(StradaValue*)NULL; })");
        return;
    }

    emit($cg, "({ StradaValue *__aca_arr = ");
    if ($aca_autoviv == 1) {
        $cg->{"autoviv"} = 2;
    }
    gen_expression($cg, $arr_expr);
    emit($cg, "; int64_t __aca_idx = ");
    emit_int_operand($cg, $idx_expr);
    if ($cg->{"uses_tie"} == 1) {
        emit($cg, "; StradaValue *__aca_old = strada_av_fetch_sv(__aca_arr, __aca_idx); ");
    } else {
        emit($cg, "; StradaValue *__aca_old = strada_array_get_owned(strada_deref_array(__aca_arr), __aca_idx); ");
    }
    if ($op eq "//=" || $op eq "&&=" || $op eq "||=") {
        my str $short_cond2 = "strada_defined_bool(__aca_old)";
        if ($op eq "&&=") { $short_cond2 = "!strada_to_bool(__aca_old)"; }
        elsif ($op eq "||=") { $short_cond2 = "strada_to_bool(__aca_old)"; }
        emit($cg, "StradaValue *__aca_new; if (" . $short_cond2 . ") { __aca_new = __aca_old; } else { StradaValue *__aca_rhs = ");
        gen_expression($cg, $rhs);
        emit($cg, "; ");
        if ($rhs_cleanup == 0) {
            emit($cg, "__aca_rhs = strada_copy_scalar_il(__aca_rhs); ");
        }
        if ($cg->{"uses_tie"} == 1) {
            emit($cg, "strada_av_store_sv(__aca_arr, __aca_idx, __aca_rhs); ");
        } else {
            emit($cg, "strada_array_set(strada_deref_array(__aca_arr), __aca_idx, __aca_rhs); ");
        }
        emit($cg, "strada_decref(__aca_old); __aca_new = __aca_rhs; } ");
        if ($arr_cleanup == 1) { emit($cg, "strada_decref(__aca_arr); "); }
        if ($is_void == 1) {
            emit($cg, "strada_decref(__aca_new); (StradaValue*)NULL; })");
        } else {
            emit($cg, "__aca_new; })");
        }
        return;
    }
    emit($cg, "StradaValue *__aca_rhs = ");
    gen_expression($cg, $rhs);
    emit($cg, "; ");
    if ($op eq "%=") {
        emit($cg, "int64_t __aca_ml = strada_to_int(__aca_old); int64_t __aca_mr = strada_to_int(__aca_rhs); if (__aca_mr == 0) { strada_decref(__aca_old); ");
        if ($rhs_cleanup == 1) { emit($cg, "strada_decref(__aca_rhs); "); }
        if ($arr_cleanup == 1) { emit($cg, "strada_decref(__aca_arr); "); }
        emit($cg, "strada_safe_mod(__aca_ml, 0); } StradaValue *__aca_new = strada_new_int_il(strada_floored_mod(__aca_ml, __aca_mr)); ");
    } elsif ($op eq "/=") {
        emit($cg, "double __aca_dl = strada_to_num(__aca_old); double __aca_dr = strada_to_num(__aca_rhs); if (__aca_dr == 0.0) { strada_decref(__aca_old); ");
        if ($rhs_cleanup == 1) { emit($cg, "strada_decref(__aca_rhs); "); }
        if ($arr_cleanup == 1) { emit($cg, "strada_decref(__aca_arr); "); }
        emit($cg, "strada_throw(\"Illegal division by zero\"); } StradaValue *__aca_new = strada_safe_div(__aca_dl, __aca_dr); ");
    } else {
        emit($cg, "StradaValue *__aca_new = ");
        if ($op eq "+=") {
            emit($cg, "(STRADA_IS_TAGGED_INT(__aca_old) && STRADA_IS_TAGGED_INT(__aca_rhs) ? strada_new_int_il(STRADA_TAGGED_INT_VAL(__aca_old) + STRADA_TAGGED_INT_VAL(__aca_rhs)) : strada_new_num(strada_to_num(__aca_old) + strada_to_num(__aca_rhs)))");
        } elsif ($op eq "-=") {
            emit($cg, "(STRADA_IS_TAGGED_INT(__aca_old) && STRADA_IS_TAGGED_INT(__aca_rhs) ? strada_new_int_il(STRADA_TAGGED_INT_VAL(__aca_old) - STRADA_TAGGED_INT_VAL(__aca_rhs)) : strada_new_num(strada_to_num(__aca_old) - strada_to_num(__aca_rhs)))");
        } elsif ($op eq ".=") {
            emit($cg, "strada_concat_sv(__aca_old, __aca_rhs)");
        } elsif ($op eq "*=") {
            emit($cg, "(STRADA_IS_TAGGED_INT(__aca_old) && STRADA_IS_TAGGED_INT(__aca_rhs) ? strada_new_int_il((int64_t)((uint64_t)STRADA_TAGGED_INT_VAL(__aca_old) * (uint64_t)STRADA_TAGGED_INT_VAL(__aca_rhs))) : strada_new_num(strada_to_num(__aca_old) * strada_to_num(__aca_rhs)))");
        } elsif ($op eq "**=") {
            emit($cg, "strada_new_num(pow(strada_to_num(__aca_old), strada_to_num(__aca_rhs)))");
        } elsif ($op eq "x=") {
            emit($cg, "strada_string_repeat(__aca_old, (int64_t)strada_to_int(__aca_rhs))");
        } elsif ($op eq "&=") {
            emit($cg, "strada_new_int_il(strada_to_int(__aca_old) & strada_to_int(__aca_rhs))");
        } elsif ($op eq "|=") {
            emit($cg, "strada_new_int_il(strada_to_int(__aca_old) | strada_to_int(__aca_rhs))");
        } elsif ($op eq "^=") {
            emit($cg, "strada_new_int_il(strada_to_int(__aca_old) ^ strada_to_int(__aca_rhs))");
        } elsif ($op eq "<<=") {
            emit($cg, "({ int64_t __bl = strada_to_int(__aca_old); int64_t __br = strada_to_int(__aca_rhs); strada_new_int_il((__br < 0 || __br >= 64) ? 0 : (int64_t)((uint64_t)__bl << __br)); })");
        } elsif ($op eq ">>=") {
            emit($cg, "({ int64_t __bl = strada_to_int(__aca_old); int64_t __br = strada_to_int(__aca_rhs); strada_new_int_il((__br < 0 || __br >= 64) ? (__bl < 0 ? -1 : 0) : (__bl >> __br)); })");
        } else {
            emit($cg, "strada_new_num(strada_to_num(__aca_old))");
        }
        emit($cg, "; ");
    }
    if ($cg->{"uses_tie"} == 1) {
        emit($cg, "strada_av_store_sv(__aca_arr, __aca_idx, __aca_new); ");
    } else {
        emit($cg, "strada_array_set(strada_deref_array(__aca_arr), __aca_idx, __aca_new); ");
    }
    emit($cg, "strada_decref(__aca_old); ");
    if ($rhs_cleanup == 1) { emit($cg, "strada_decref(__aca_rhs); "); }
    if ($arr_cleanup == 1) { emit($cg, "strada_decref(__aca_arr); "); }
    if ($is_void == 1) {
        emit($cg, "strada_decref(__aca_new); (StradaValue*)NULL; })");
    } else {
        emit($cg, "__aca_new; })");
    }
}

