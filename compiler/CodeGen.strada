# CodeGen.strada - C Code Generator for self-hosting Strada compiler
# Transforms AST into C source code

# ============================================================
# Code Generator State
# ============================================================

# Sanitize function names for C (replace :: with _)
# Module-only codegen filter (--object / -M).
# Returns 1 if the item should be SKIPPED because it was inlined from a
# `use`d module (and therefore lives in some other module's .o, not ours).
# Returns 0 in all other cases (full-program mode, or the item came from
# the file we're compiling).
#
# Items are tagged at parse time: load_module sets $item->{"from_use"} = 1
# on everything it transfers into the main program; top-level parse leaves
# this unset/0 on the file's own functions, globals, BEGIN/END blocks, and
# top-level __C__ blocks. So the filter is just a boolean check.
#
# Accepts either a program or codegen context (both carry module_only_mode).
func cg_skip_for_module(scalar $ctx, int $from_use) int {
    if ($ctx->{"module_only_mode"} != 1) { return 0; }
    if ($from_use == 1) { return 1; }
    return 0;
}

func sanitize_name(str $name) str {
    my str $result = "";
    my int $i = 0;
    my int $len = length($name);
    while ($i < $len) {
        my str $ch = substr($name, $i, 1);
        if ($ch eq ":") {
            # Check for :: sequence and replace with single _
            if ($i + 1 < $len && substr($name, $i + 1, 1) eq ":") {
                $result = $result . "_";
                $i = $i + 1;  # Skip the second colon
            } else {
                $result = $result . "_";
            }
        } else {
            # Map anything that is not a valid C identifier char to '_'. Without
            # this a crafted name (e.g. an import name containing ';', '(', or a
            # space) would inject raw tokens into the generated C symbol.
            my int $code = char_at($name, $i);
            if (($code >= ord("0") && $code <= ord("9")) || ($code >= ord("A") && $code <= ord("Z")) || ($code >= ord("a") && $code <= ord("z")) || $code == ord("_")) {
                $result = $result . $ch;
            } else {
                $result = $result . "_";
            }
        }
        $i = $i + 1;
    }
    return $result;
}

# Escape C keywords used as variable names by prefixing with v_
func escape_c_keyword(str $name) str {
    # C keywords that conflict with Strada variable names
    if ($name eq "for") { return "v_for"; }
    if ($name eq "while") { return "v_while"; }
    if ($name eq "if") { return "v_if"; }
    if ($name eq "else") { return "v_else"; }
    if ($name eq "switch") { return "v_switch"; }
    if ($name eq "case") { return "v_case"; }
    if ($name eq "default") { return "v_default"; }
    if ($name eq "break") { return "v_break"; }
    if ($name eq "continue") { return "v_continue"; }
    if ($name eq "return") { return "v_return"; }
    if ($name eq "goto") { return "v_goto"; }
    if ($name eq "do") { return "v_do"; }
    if ($name eq "int") { return "v_int"; }
    if ($name eq "char") { return "v_char"; }
    if ($name eq "float") { return "v_float"; }
    if ($name eq "double") { return "v_double"; }
    if ($name eq "void") { return "v_void"; }
    if ($name eq "long") { return "v_long"; }
    if ($name eq "short") { return "v_short"; }
    if ($name eq "unsigned") { return "v_unsigned"; }
    if ($name eq "signed") { return "v_signed"; }
    if ($name eq "const") { return "v_const"; }
    if ($name eq "static") { return "v_static"; }
    if ($name eq "extern") { return "v_extern"; }
    if ($name eq "register") { return "v_register"; }
    if ($name eq "volatile") { return "v_volatile"; }
    if ($name eq "auto") { return "v_auto"; }
    if ($name eq "struct") { return "v_struct"; }
    if ($name eq "union") { return "v_union"; }
    if ($name eq "enum") { return "v_enum"; }
    if ($name eq "typedef") { return "v_typedef"; }
    if ($name eq "sizeof") { return "v_sizeof"; }
    # C99/C11/C23 keywords
    if ($name eq "inline") { return "v_inline"; }
    if ($name eq "restrict") { return "v_restrict"; }
    if ($name eq "_Bool") { return "v_Bool"; }
    if ($name eq "_Complex") { return "v_Complex"; }
    if ($name eq "_Imaginary") { return "v_Imaginary"; }
    if ($name eq "_Alignas") { return "v_Alignas"; }
    if ($name eq "_Alignof") { return "v_Alignof"; }
    if ($name eq "_Atomic") { return "v_Atomic"; }
    if ($name eq "_Generic") { return "v_Generic"; }
    if ($name eq "_Noreturn") { return "v_Noreturn"; }
    if ($name eq "_Static_assert") { return "v_Static_assert"; }
    if ($name eq "_Thread_local") { return "v_Thread_local"; }
    if ($name eq "alignas") { return "v_alignas"; }
    if ($name eq "alignof") { return "v_alignof"; }
    if ($name eq "constexpr") { return "v_constexpr"; }
    if ($name eq "nullptr") { return "v_nullptr"; }
    if ($name eq "static_assert") { return "v_static_assert"; }
    if ($name eq "thread_local") { return "v_thread_local"; }
    if ($name eq "typeof_unqual") { return "v_typeof_unqual"; }
    # C macros for standard I/O and C99/GNU/POSIX identifiers
    if ($name eq "STDIN") { return "v_STDIN"; }
    if ($name eq "STDOUT") { return "v_STDOUT"; }
    if ($name eq "STDERR") { return "v_STDERR"; }
    if ($name eq "bool") { return "v_bool"; }
    if ($name eq "true") { return "v_true"; }
    if ($name eq "false") { return "v_false"; }
    if ($name eq "errno") { return "v_errno"; }
    if ($name eq "NULL") { return "v_NULL"; }
    if ($name eq "EOF") { return "v_EOF"; }
    if ($name eq "asm") { return "v_asm"; }
    if ($name eq "typeof") { return "v_typeof"; }
    # Standard <math.h> / <stdlib.h> / <string.h> symbols emitted in generated C
    if ($name eq "pow") { return "v_pow"; }
    if ($name eq "sin") { return "v_sin"; }
    if ($name eq "cos") { return "v_cos"; }
    if ($name eq "tan") { return "v_tan"; }
    if ($name eq "sqrt") { return "v_sqrt"; }
    if ($name eq "log") { return "v_log"; }
    if ($name eq "exp") { return "v_exp"; }
    if ($name eq "floor") { return "v_floor"; }
    if ($name eq "ceil") { return "v_ceil"; }
    if ($name eq "fabs") { return "v_fabs"; }
    if ($name eq "fmod") { return "v_fmod"; }
    if ($name eq "free") { return "v_free"; }
    if ($name eq "malloc") { return "v_malloc"; }
    if ($name eq "calloc") { return "v_calloc"; }
    if ($name eq "realloc") { return "v_realloc"; }
    if ($name eq "memcpy") { return "v_memcpy"; }
    if ($name eq "memset") { return "v_memset"; }
    if ($name eq "strlen") { return "v_strlen"; }
    if ($name eq "strcmp") { return "v_strcmp"; }
    if ($name eq "stdin") { return "v_stdin"; }
    if ($name eq "stdout") { return "v_stdout"; }
    if ($name eq "stderr") { return "v_stderr"; }
    return $name;
}

# Mangle top-level user function names that collide with standard C/POSIX symbols.
# Package-qualified names (Foo::open -> Foo_open), C-boundary/extern functions,
# main, and DESTROY are left untouched to preserve ABI and FFI.
func mangle_c_func_ident(str $sanitized, str $orig_name, int $is_c_boundary) str {
    if ($is_c_boundary == 1 || $orig_name eq "main" || $orig_name eq "DESTROY" || index($orig_name, "::") >= 0) {
        return "" . $sanitized;
    }
    if ($sanitized eq "open" || $sanitized eq "close" || $sanitized eq "read" || $sanitized eq "write"
        || $sanitized eq "lseek" || $sanitized eq "stat" || $sanitized eq "fstat" || $sanitized eq "lstat"
        || $sanitized eq "access" || $sanitized eq "chmod" || $sanitized eq "chown" || $sanitized eq "mkdir"
        || $sanitized eq "rmdir" || $sanitized eq "unlink" || $sanitized eq "link" || $sanitized eq "symlink"
        || $sanitized eq "readlink" || $sanitized eq "rename" || $sanitized eq "remove" || $sanitized eq "dup"
        || $sanitized eq "dup2" || $sanitized eq "pipe" || $sanitized eq "fork" || $sanitized eq "vfork"
        || $sanitized eq "execve" || $sanitized eq "execvp" || $sanitized eq "execl" || $sanitized eq "wait"
        || $sanitized eq "waitpid" || $sanitized eq "kill" || $sanitized eq "raise" || $sanitized eq "signal"
        || $sanitized eq "alarm" || $sanitized eq "pause" || $sanitized eq "sleep" || $sanitized eq "usleep"
        || $sanitized eq "getpid" || $sanitized eq "getppid" || $sanitized eq "getuid" || $sanitized eq "geteuid"
        || $sanitized eq "getgid" || $sanitized eq "getegid" || $sanitized eq "chdir" || $sanitized eq "getcwd"
        || $sanitized eq "umask" || $sanitized eq "isatty" || $sanitized eq "fsync" || $sanitized eq "truncate"
        || $sanitized eq "ftruncate" || $sanitized eq "realpath" || $sanitized eq "socket" || $sanitized eq "bind"
        || $sanitized eq "listen" || $sanitized eq "accept" || $sanitized eq "connect" || $sanitized eq "send"
        || $sanitized eq "recv" || $sanitized eq "sendto" || $sanitized eq "recvfrom" || $sanitized eq "shutdown"
        || $sanitized eq "select" || $sanitized eq "poll" || $sanitized eq "fopen" || $sanitized eq "fclose"
        || $sanitized eq "fread" || $sanitized eq "fwrite" || $sanitized eq "fseek" || $sanitized eq "ftell"
        || $sanitized eq "rewind" || $sanitized eq "fflush" || $sanitized eq "feof" || $sanitized eq "ferror"
        || $sanitized eq "perror" || $sanitized eq "printf" || $sanitized eq "fprintf" || $sanitized eq "sprintf"
        || $sanitized eq "snprintf" || $sanitized eq "scanf" || $sanitized eq "sscanf" || $sanitized eq "getchar"
        || $sanitized eq "putchar" || $sanitized eq "puts" || $sanitized eq "fputs" || $sanitized eq "fgets"
        || $sanitized eq "malloc" || $sanitized eq "calloc" || $sanitized eq "realloc" || $sanitized eq "free"
        || $sanitized eq "abort" || $sanitized eq "exit" || $sanitized eq "_exit" || $sanitized eq "atexit"
        || $sanitized eq "system" || $sanitized eq "getenv" || $sanitized eq "setenv" || $sanitized eq "unsetenv"
        || $sanitized eq "rand" || $sanitized eq "srand" || $sanitized eq "qsort" || $sanitized eq "bsearch"
        || $sanitized eq "atoi" || $sanitized eq "atol" || $sanitized eq "atof" || $sanitized eq "strtol"
        || $sanitized eq "strtoul" || $sanitized eq "strtoll" || $sanitized eq "strtod" || $sanitized eq "strlen"
        || $sanitized eq "strcmp" || $sanitized eq "strncmp" || $sanitized eq "strcpy" || $sanitized eq "strncpy"
        || $sanitized eq "strcat" || $sanitized eq "strncat" || $sanitized eq "strchr" || $sanitized eq "strrchr"
        || $sanitized eq "strstr" || $sanitized eq "strtok" || $sanitized eq "strerror" || $sanitized eq "index"
        || $sanitized eq "rindex" || $sanitized eq "strcasecmp" || $sanitized eq "strncasecmp" || $sanitized eq "strdup"
        || $sanitized eq "strndup" || $sanitized eq "memcpy" || $sanitized eq "memmove" || $sanitized eq "memset"
        || $sanitized eq "memcmp" || $sanitized eq "memchr" || $sanitized eq "time" || $sanitized eq "ctime"
        || $sanitized eq "gmtime" || $sanitized eq "localtime" || $sanitized eq "mktime" || $sanitized eq "strftime"
        || $sanitized eq "difftime" || $sanitized eq "clock" || $sanitized eq "nanosleep" || $sanitized eq "sin"
        || $sanitized eq "cos" || $sanitized eq "tan" || $sanitized eq "asin" || $sanitized eq "acos"
        || $sanitized eq "atan" || $sanitized eq "atan2" || $sanitized eq "sinh" || $sanitized eq "cosh"
        || $sanitized eq "tanh" || $sanitized eq "exp" || $sanitized eq "log" || $sanitized eq "log10"
        || $sanitized eq "log2" || $sanitized eq "pow" || $sanitized eq "sqrt" || $sanitized eq "cbrt"
        || $sanitized eq "hypot" || $sanitized eq "ceil" || $sanitized eq "floor" || $sanitized eq "round"
        || $sanitized eq "trunc" || $sanitized eq "fabs" || $sanitized eq "fmod" || $sanitized eq "remainder"
        || $sanitized eq "copysign" || $sanitized eq "fmax" || $sanitized eq "fmin" || $sanitized eq "abs"
        || $sanitized eq "labs" || $sanitized eq "llabs" || $sanitized eq "div" || $sanitized eq "ldiv"
        || $sanitized eq "dlopen" || $sanitized eq "dlsym" || $sanitized eq "dlclose" || $sanitized eq "dlerror") {
        return "__strada_u_" . $sanitized;
    }
    return "" . $sanitized;
}

# Format an integer literal safely as a 64-bit C expression without signed overflow UB
func c_int64_lit(str $val) str {
    if ($val eq "9223372036854775808") {
        return "((int64_t)9223372036854775808ULL)";
    }
    if (length($val) >= 2 && (substr($val, 0, 2) eq "0x" || substr($val, 0, 2) eq "0X")) {
        return "((int64_t)" . $val . "ULL)";
    }
    if (length($val) >= 10) {
        return $val . "LL";
    }
    return "" . $val;
}

# Compute djb2 hash at compile time (matches strada_hash_string in runtime)
func djb2_hash(str $input_str) int {
    my int $h = 5381;
    my int $idx = 0;
    my int $slen = length($input_str);
    while ($idx < $slen) {
        my int $ch = char_at($input_str, $idx);
        my int $shifted = $h * 32;
        $h = $shifted + $h + $ch;
        $idx = $idx + 1;
    }
    return $h;
}

func djb2_hash_32(str $input_str) int {
    my int $h = 5381;
    my int $idx = 0;
    my int $slen = length($input_str);
    while ($idx < $slen) {
        my int $ch = char_at($input_str, $idx);
        $h = (($h * 33) + $ch) % 4294967296;
        $idx = $idx + 1;
    }
    return $h;
}

# Returns 1 if every byte of $s is printable ASCII (1..127). Only then does the
# compile-time djb2_hash_32 match the runtime hash: strada_hash_string reads
# `signed char`, so bytes >= 128 (UTF-8 / high-bit) hash differently than
# char_at's unsigned bytes. Gates the pre-hashed literal-key fast path so a
# non-ASCII key never gets a mismatching precomputed hash (which would miss).
func key_is_hashable_ascii(str $s) int {
    my int $slen = length($s);
    if ($slen == 0) {
        return 0;
    }
    my int $idx = 0;
    while ($idx < $slen) {
        my int $ch = char_at($s, $idx);
        if ($ch < 1 || $ch > 127) {
            return 0;
        }
        $idx = $idx + 1;
    }
    return 1;
}

# Emit an owned hash fetch for a compile-time-literal string key. For ASCII keys,
# use the pre-hashed fast path strada_hv_fetch_owned_ph(hash_expr, "key", HASHu),
# which skips re-running DJB2 over the constant key on every access (the same
# scheme already used for `has` accessors and constructors). Non-ASCII keys fall
# back to strada_hv_fetch_owned. Handles both an owned (needs_cleanup) and a
# borrowed hash/ref sub-expression. Shared by NODE_HASH_ACCESS / NODE_DEREF_HASH.
func emit_hash_fetch_literal(scalar $cg, scalar $hash_expr, str $key_val, int $needs_cleanup) void {
    my int $ascii = key_is_hashable_ascii($key_val);
    if ($needs_cleanup == 1) {
        emit($cg, "({ StradaValue *__hl_tmp = ");
        gen_expression($cg, $hash_expr);
        emit($cg, "; StradaValue *__hl_res = ");
        if ($ascii == 1) {
            emit($cg, "strada_hv_fetch_owned_ph(__hl_tmp, ");
            gen_str_literal_c($cg, $key_val);
            emit($cg, ", " . djb2_hash_32($key_val) . "u)");
        } else {
            emit($cg, "strada_hv_fetch_owned(__hl_tmp, ");
            gen_str_literal_c($cg, $key_val);
            emit($cg, ")");
        }
        emit($cg, "; strada_decref(__hl_tmp); __hl_res; })");
    } else {
        if ($ascii == 1) {
            emit($cg, "strada_hv_fetch_owned_ph(");
            gen_expression($cg, $hash_expr);
            emit($cg, ", ");
            gen_str_literal_c($cg, $key_val);
            emit($cg, ", " . djb2_hash_32($key_val) . "u)");
        } else {
            emit($cg, "strada_hv_fetch_owned(");
            gen_expression($cg, $hash_expr);
            emit($cg, ", ");
            gen_str_literal_c($cg, $key_val);
            emit($cg, ")");
        }
    }
}

func codegen_new(str $filename, int $debug_info, int $enable_profiling, int $enable_stack_trace, int $full_profile) scalar {
    my hash %cg = ();
    # StringBuilder for O(1) amortized append (no O(n^2) string concat)
    $cg{"output_sb"} = sb_new();
    $cg{"preamble_content"} = "";  # Saved preamble when doing multi-phase
    $cg{"funcs_content"} = "";     # Saved funcs when doing multi-phase
    $cg{"oop_fwd_decls"} = "";     # OOP init forward declarations (generated after methods tracked)
    # Module-only (separate compilation): mangled names of functions called but
    # neither defined nor declared in this translation unit. get_output() emits an
    # `extern StradaValue* name();` for each so C doesn't default the call to an
    # int return and truncate the 64-bit StradaValue* pointer it really returns.
    $cg{"auto_externs"} = {};
    # Module-only codegen mode (copied from program in generate() so the cg_skip_for_module
    # helper works equivalently whether called with the program or the cg context).
    $cg{"module_only_mode"} = 0;
    $cg{"module_target"} = "";
    $cg{"split_dir"} = "";
    $cg{"split_includes"} = "";
    $cg{"split_ext_globals"} = "";
    $cg{"split_common_decls"} = "";
    $cg{"split_fwd_decls"} = "";
    $cg{"split_markers"} = "";
    $cg{"split_fn_codes"} = [];
    $cg{"split_fn_pkgs"} = [];
    $cg{"split_fn_c0"} = [];
    $cg{"split_fn_proto_map"} = {};
    $cg{"split_fn_proto_order"} = [];
    $cg{"split_glob_ext_map"} = {};
    $cg{"split_glob_ext_order"} = [];
    $cg{"split_anon_proto_map"} = {};
    $cg{"split_anon_proto_order"} = [];
    $cg{"indent"} = 0;
    $cg{"debug_info"} = $debug_info;  # Emit #line directives for debugging
    $cg{"enable_profiling"} = $enable_profiling;  # Emit function profiling code
    $cg{"enable_stack_trace"} = $enable_stack_trace;  # Emit stack trace push/pop calls
    $cg{"full_profile"} = $full_profile;  # Emit line-level profiling code
    $cg{"last_line"} = 0;  # Track last emitted line to avoid duplicates
    $cg{"functions"} = {};  # Map function name -> function info
    $cg{"owned_call_builtins"} = build_owned_call_builtins();  # owned-return builtin set (see build_owned_call_builtins)
    $cg{"in_extern"} = 0;   # Track if we're inside an extern function
    $cg{"extern_params"} = {};  # Map param name -> type for extern functions
    $cg{"in_main"} = 0;     # Track if we're inside main function
    $cg{"package"} = "";    # Current package name
    $cg{"filename"} = $filename;  # Source file name for __FILE__
    $cg{"map_counter"} = 0;     # Counter for unique map variable names
    $cg{"sort_counter"} = 0;    # Counter for unique sort variable names
    $cg{"grep_counter"} = 0;    # Counter for unique grep variable names
    $cg{"foreach_counter"} = 0; # Counter for unique foreach variable names
    $cg{"redo_counter"} = 0;    # Counter for unique redo labels
    $cg{"current_redo_label"} = ""; # Current innermost redo label for unlabeled redo
    $cg{"call_context"} = 0;   # Call context for dynamic functions (0=scalar, 1=array, 2=hash)
    $cg{"autoviv"} = 0;        # Autovivification flag for nested hash assignment targets
    $cg{"in_map_block"} = 0;  # Track if inside map block (for $_)
    $cg{"in_sort_block"} = 0; # Track if inside sort block (for $a, $b)
    $cg{"in_grep_block"} = 0; # Track if inside grep block (for $_)
    $cg{"anon_func_counter"} = 0;  # Counter for unique anonymous function names
    $cg{"anon_func_decls"} = "";   # Forward declarations for anonymous functions
    $cg{"anon_func_defs"} = "";    # Function definitions for anonymous functions
    $cg{"in_anon_func"} = 0;       # Track if inside anonymous function
    $cg{"anon_param_str"} = "";    # Comma-separated param names
    $cg{"anon_local_str"} = "";    # Comma-separated local names
    $cg{"anon_capture_str"} = "";  # Comma-separated capture names
    $cg{"anon_capture_count"} = 0; # Number of captures
    $cg{"current_func_name"} = ""; # Current function name for profiling
    $cg{"ret_is_int"} = 0;         # 1 while generating an int-returning function body
    $cg{"ret_is_num"} = 0;         # 1 while generating a num-returning function body
    $cg{"global_count"} = 0;       # Number of global variables
    my array @empty_globals = ();
    $cg{"globals"} = \@empty_globals;  # Array of global variable declarations
    $cg{"switch_counter"} = 0;     # Counter for unique switch variable names
    # OOP method registration - per-package tracking
    my hash %empty_pkg_methods = ();
    $cg{"pkg_methods"} = \%empty_pkg_methods;  # Hash: package -> array of method info
    my array @empty_pkg_list = ();
    $cg{"pkg_list"} = \@empty_pkg_list;        # Array of package names (to avoid keys())
    $cg{"pkg_count"} = 0;                      # Number of packages
    $cg{"pkg_seen"} = "|";                     # String of seen package names (for fast lookup)
    $cg{"method_wrappers"} = "";   # Generated wrapper functions
    # Scope tracking for memory management (using string-encoded var lists for bootstrap compat)
    # Each scope is stored as "var1,var2,var3" string (bootstrap doesn't support scalar(@arr))
    my array @scope_vars = ();   # Array of scope strings
    my array @scope_counts = (); # Parallel array of counts
    $cg{"scope_vars"} = \@scope_vars;
    $cg{"scope_counts"} = \@scope_counts;
    $cg{"scope_depth"} = 0;
    $cg{"cleanup_enabled"} = 1;  # Enable scope-based memory cleanup
    $cg{"tu_has_try"} = 0;       # 1 if any function/block in TU or external boundary can throw/catch
    $cg{"cand_boxed_vars"} = {}; # Candidate variables captured by nested closures in current function
    $cg{"active_boxed_vars"} = {}; # Active __cell_<name> variables in current lexical scope
    $cg{"file_globals"} = {};    # File-level my global C names
    $cg{"try_depth"} = 0;        # Track nesting depth in try blocks (for proper cleanup on return)
    $cg{"catch_cleanup_count"} = 0;  # Track catch vars on cleanup stack (for proper cleanup on throw)
    # foreach lists currently on the cleanup stack (innermost last), with the
    # scope depth each loop started at, so an early exit (return, labeled
    # last/next, goto) pops and releases them; the loop's own pop is skipped then
    my array @fe_cl_names = ();
    my array @fe_cl_depths = ();
    $cg{"fe_cl_names"} = \@fe_cl_names;
    $cg{"fe_cl_depths"} = \@fe_cl_depths;
    $cg{"fe_cl_count"} = 0;
    $cg{"func_has_try"} = 0;     # Track if current function contains any try blocks (for volatile vars)
    # Track label-to-scope-depth for proper cleanup on labeled break/continue/redo
    my hash %label_depths = ();
    $cg{"label_depths"} = \%label_depths;
    my hash %label_next_depths = ();
    $cg{"label_next_depths"} = \%label_next_depths;
    my hash %label_redo_depths = ();
    $cg{"label_redo_depths"} = \%label_redo_depths;
    my hash %label_try_depths = ();
    $cg{"label_try_depths"} = \%label_try_depths;
    my hash %label_local_vars = ();
    $cg{"label_local_vars"} = \%label_local_vars;
    # Track loop body scope depth for unlabeled last/next/redo cleanup
    $cg{"loop_break_depth"} = 0;
    $cg{"loop_redo_depth"} = 0;
    $cg{"loop_local_var"} = "";
    # Track try_depth at the entry of the most recent loop. `last`/`next`/`redo`
    # inside a try body must STRADA_TRY_POP the try frames pushed inside
    # the loop before jumping out, or each pass leaves an unclosed try
    # frame — after 64 the static stack overflows and setjmp(*NULL)
    # segfaults.
    $cg{"loop_try_depth"} = 0;
    my array @try_finally_blocks = ();
    $cg{"try_finally_blocks"} = \@try_finally_blocks;
    $cg{"current_elem_var"} = "__elem_";
    $cg{"current_sort_a"} = "__sort_a_";
    $cg{"current_sort_b"} = "__sort_b_";
    # Per-scope list of vars whose strada_cleanup_push was elided (because
    # no enclosing try/catch frame could ever drain them). emit_scope_decref
    # must skip the matching cleanup_pop for these. Parallel to scope_vars.
    my array @scope_no_push_vars = ();
    $cg{"scope_no_push_vars"} = \@scope_no_push_vars;
    $cg{"current_no_push_str"} = "";
    # Track 'our' variables: maps C variable name -> "package::varname" registry key
    my hash %our_vars = ();
    $cg{"our_vars"} = \%our_vars;
    my array @our_shadow_names = ();
    my array @our_shadow_keys = ();
    $cg{"our_shadow_names"} = \@our_shadow_names;
    $cg{"our_shadow_keys"} = \@our_shadow_keys;
    $cg{"our_shadow_n"} = 0;
    # Track int-typed variables for integer arithmetic optimization
    my hash %int_vars = ();
    $cg{"int_vars"} = \%int_vars;
    my hash %num_vars = ();
    $cg{"num_vars"} = \%num_vars;
    # Track known blessed types for method devirtualization
    my hash %known_types = ();
    $cg{"known_types"} = \%known_types;
    # Operator overloading (set from program node in gen_program)
    $cg{"has_overloads"} = 0;
    my hash %empty_overloads = ();
    $cg{"overloads"} = \%empty_overloads;
    my hash %empty_overloaded_ops = ();
    $cg{"overloaded_ops"} = \%empty_overloaded_ops;
    # finally-block stack: blocks of enclosing try/finally statements,
    # emitted before return/last/next leaves them (see gen_finally_upto).
    my array @finally_blocks = ();
    $cg{"finally_blocks"} = \@finally_blocks;
    $cg{"finally_count"} = 0;
    $cg{"loop_finally_mark"} = 0;

    # Condition-level hash-fetch CSE state (see emit_condition_cse).
    # uses_tie is set from the program node in gen_program.
    $cg{"uses_tie"} = 0;
    $cg{"func_tracks_depth"} = 0;
    my hash %empty_struct_vars = ();
    $cg{"struct_vars"} = \%empty_struct_vars;
    my hash %empty_structs = ();
    $cg{"structs"} = \%empty_structs;
    my array @empty_struct_names = ();
    $cg{"struct_names"} = \@empty_struct_names;
    $cg{"struct_count"} = 0;
    my hash %empty_qw_imports = ();
    $cg{"qw_imports"} = \%empty_qw_imports;
    my hash %empty_raw_int = ();
    $cg{"raw_int_funcs"} = \%empty_raw_int;
    $cg{"cse_n"} = 0;
    my array @cse_ids = ();
    $cg{"cse_ids"} = \@cse_ids;
    my array @cse_nodes = ();
    $cg{"cse_nodes"} = \@cse_nodes;
    return \%cg;
}

# Push a new scope onto the scope stack
func scope_push(scalar $cg) void {
    my int $enabled = $cg->{"cleanup_enabled"};
    if ($enabled == 0) {
        return;
    }
    my scalar $vars = $cg->{"scope_vars"};
    my scalar $counts = $cg->{"scope_counts"};
    my scalar $no_push = $cg->{"scope_no_push_vars"};
    my int $depth = $cg->{"scope_depth"};
    push($vars, "");  # Empty scope
    push($counts, 0);
    push($no_push, "");
    $cg->{"scope_depth"} = $depth + 1;
}

# Track a variable in the current scope
func scope_track_var(scalar $cg, str $name) void {
    my int $enabled = $cg->{"cleanup_enabled"};
    if ($enabled == 0) {
        return;
    }
    my int $depth = $cg->{"scope_depth"};
    if ($depth == 0) {
        return;
    }
    my scalar $vars = $cg->{"scope_vars"};
    my scalar $counts = $cg->{"scope_counts"};
    my str $current = $vars->[$depth - 1];
    my int $count = $counts->[$depth - 1];
    if ($count == 0) {
        $vars->[$depth - 1] = $name;
    } else {
        $vars->[$depth - 1] = $current . "," . $name;
    }
    $counts->[$depth - 1] = $count + 1;
}

# Mark a tracked variable as "push was elided" so emit_scope_decref will
# skip the matching cleanup_pop. The var must already have been registered
# via scope_track_var (its decref still has to fire on scope exit).
func scope_mark_no_push(scalar $cg, str $name) void {
    my int $enabled = $cg->{"cleanup_enabled"};
    if ($enabled == 0) { return; }
    my int $depth = $cg->{"scope_depth"};
    if ($depth == 0) { return; }
    my scalar $no_push = $cg->{"scope_no_push_vars"};
    my str $current = $no_push->[$depth - 1];
    if (length($current) == 0) {
        $no_push->[$depth - 1] = $name;
    } else {
        $no_push->[$depth - 1] = $current . "," . $name;
    }
}

# Decide whether strada_cleanup_push for a new owned local is meaningful at
# the current codegen position. The push exists so an outer catch's
# strada_cleanup_drain_to can decref locals on exception unwind. The
# drain_to runs from the top of the stack down to the try-entry mark, so
# only entries pushed AFTER an active try frame matter. In `main()` no
# caller can hold a try frame for us — pushes from inside main are only
# useful while we're nested in some try{} block of our own.
func cleanup_push_useful(scalar $cg) int {
    if ($cg->{"cleanup_enabled"} == 0) { return 0; }
    if ($cg->{"tu_has_main"} == 1 && $cg->{"module_only_mode"} == 0 && $cg->{"tu_has_try"} == 0 && $cg->{"enable_stack_trace"} != 1) {
        return 0;
    }
    if ($cg->{"in_main"} == 1 && $cg->{"try_depth"} == 0) {
        return 0;
    }
    return 1;
}

# Emit cleanup for current scope and pop it
func scope_pop(scalar $cg) void {
    my int $enabled = $cg->{"cleanup_enabled"};
    if ($enabled == 0) {
        return;
    }
    my int $depth = $cg->{"scope_depth"};
    if ($depth == 0) {
        return;
    }
    my scalar $vars = $cg->{"scope_vars"};
    my scalar $counts = $cg->{"scope_counts"};
    my scalar $no_push = $cg->{"scope_no_push_vars"};
    my str $scope_str = $vars->[$depth - 1];
    my int $count = $counts->[$depth - 1];
    my str $no_push_str = $no_push->[$depth - 1];

    # Stash the no-push set on cg for emit_scope_decref to consult.
    my str $saved_no_push = $cg->{"current_no_push_str"};
    $cg->{"current_no_push_str"} = $no_push_str;
    emit_scope_decref($cg, $scope_str, $count);
    $cg->{"current_no_push_str"} = $saved_no_push;

    pop($vars);
    pop($counts);
    pop($no_push);
    $cg->{"scope_depth"} = $depth - 1;
}

# Check if a variable name is in a comma-separated string
func is_var_in_list(str $var, str $list) int {
    if (length($list) == 0) { return 0; }
    my int $pos = 0;
    my int $len = length($list);
    my str $cur = "";
    while ($pos <= $len) {
        if ($pos == $len) {
            if ($cur eq $var) { return 1; }
            $pos = $pos + 1;
        } else {
            my str $ch = substr($list, $pos, 1);
            if ($ch eq ",") {
                if ($cur eq $var) { return 1; }
                $cur = "";
            } else {
                $cur = $cur . $ch;
            }
            $pos = $pos + 1;
        }
    }
    return 0;
}

func emit_var_cleanup_stmt(scalar $cg, str $var_name, int $no_push) void {
    emit_indent($cg);
    if (length($var_name) > 6 && substr($var_name, 0, 6) eq "@cell:") {
        my str $cname = substr($var_name, 6, length($var_name) - 6);
        if ($no_push == 1) {
            emit($cg, "strada_cell_release(__cell_" . $cname . ");\n");
        } else {
            emit($cg, "strada_cleanup_pop(); strada_cell_release(__cell_" . $cname . ");\n");
        }
    } elsif ($no_push == 1) {
        emit($cg, "strada_decref(" . $var_name . ");\n");
    } else {
        emit($cg, "strada_cleanup_pop_decref(" . $var_name . ");\n");
    }
}

# Helper to emit decref for vars in a scope, skipping already-cleaned names
# Returns updated cleaned list (comma-separated) with this scope's vars added
func emit_scope_decref_skip(scalar $cg, str $scope_str, int $count, str $cleaned) str {
    if ($count == 0 || length($scope_str) == 0) {
        return $cleaned;
    }
    my int $in_anon = $cg->{"in_anon_func"};
    my str $capture_str = $cg->{"anon_capture_str"};
    my str $no_push_str = $cg->{"current_no_push_str"};
    if (!$no_push_str) { $no_push_str = ""; }

    my int $pos = 0;
    my int $len = length($scope_str);
    my str $var_name = "";
    while ($pos <= $len) {
        if ($pos == $len) {
            if (length($var_name) > 0) {
                if ($in_anon == 0 || is_var_in_list($var_name, $capture_str) == 0) {
                    if (is_var_in_list($var_name, $cleaned) == 0) {
                        emit_var_cleanup_stmt($cg, $var_name, is_var_in_list($var_name, $no_push_str));
                    }
                }
                if (length($cleaned) == 0) {
                    $cleaned = "" . $var_name;
                } else {
                    $cleaned = $cleaned . "," . $var_name;
                }
            }
            $pos = $pos + 1;
        } else {
            my str $ch = substr($scope_str, $pos, 1);
            if ($ch eq ",") {
                if (length($var_name) > 0) {
                    if ($in_anon == 0 || is_var_in_list($var_name, $capture_str) == 0) {
                        if (is_var_in_list($var_name, $cleaned) == 0) {
                            emit_var_cleanup_stmt($cg, $var_name, is_var_in_list($var_name, $no_push_str));
                        }
                    }
                    if (length($cleaned) == 0) {
                        $cleaned = $var_name;
                    } else {
                        $cleaned = $cleaned . "," . $var_name;
                    }
                }
                $var_name = "";
            } else {
                $var_name = $var_name . $ch;
            }
            $pos = $pos + 1;
        }
    }
    return $cleaned;
}

# Helper to emit decref (and cleanup-stack pop) for every var in a
# scope string. NODE_VAR_DECL pushes each owned local to the runtime
# cleanup stack at declaration so that a longjmp from a callee
# function unwinds our heap locals via the surrounding catch's
# strada_cleanup_drain_to. On the normal scope-exit path we have to
# pair each push with a matching cleanup_pop here AND decref the
# value to release ownership.
func emit_scope_decref(scalar $cg, str $scope_str, int $count) void {
    if ($count == 0 || length($scope_str) == 0) {
        return;
    }
    # Get capture list to skip captured variables in closures
    my int $in_anon = $cg->{"in_anon_func"};
    my str $capture_str = $cg->{"anon_capture_str"};

    # Pass 1: break direct self-reference cycles in every var
    # while ALL vars are still alive. Doing this after the first
    # decref would access freed memory when vars share storage
    # (e.g. `my $arr = deref_array(\$ref);` where both $ref and $arr
    # point to the same array). Breaking the cycle here just clears
    # self-ref slots inside hashes/arrays and decref's the cleared
    # ref — never frees the var itself.
    my int $p1 = 0;
    my int $l1 = length($scope_str);
    my str $vn1 = "";
    while ($p1 <= $l1) {
        my int $emit_now = 0;
        if ($p1 == $l1) {
            if (length($vn1) > 0) { $emit_now = 1; }
        } else {
            my str $c1 = substr($scope_str, $p1, 1);
            if ($c1 eq ",") {
                if (length($vn1) > 0) { $emit_now = 1; }
            } else {
                $vn1 = $vn1 . $c1;
            }
        }
        if ($emit_now == 1) {
            if (($in_anon == 0 || is_var_in_list($vn1, $capture_str) == 0)
                && (length($vn1) <= 6 || substr($vn1, 0, 6) ne "@cell:")) {
                # int- and num-declared vars are coerced to canonical INT/NUM on
                # every init and assignment, so they can never hold a container cycle.
                if (length("" . $cg->{"int_vars"}->{$vn1}) == 0
                    && length("" . $cg->{"num_vars"}->{$vn1}) == 0) {
                    emit_indent($cg);
                    emit($cg, "strada_break_self_cycle(" . $vn1 . ");\n");
                }
            }
            $vn1 = "";
        }
        $p1 = $p1 + 1;
    }

    # Pass 2: cleanup_pop + decref each var. Vars whose push was elided
    # (recorded in current_no_push_str) get only a decref — the matching
    # cleanup_pop would underflow the runtime stack.
    my str $no_push_str = $cg->{"current_no_push_str"};
    if (!$no_push_str) { $no_push_str = ""; }
    my int $pos = 0;
    my int $len = length($scope_str);
    my str $var_name = "";
    while ($pos <= $len) {
        if ($pos == $len) {
            if (length($var_name) > 0) {
                # Skip captured variables - they're accessed via __captures, not local vars
                if ($in_anon == 0 || is_var_in_list($var_name, $capture_str) == 0) {
                    emit_var_cleanup_stmt($cg, $var_name, is_var_in_list($var_name, $no_push_str));
                }
            }
            $pos = $pos + 1;
        } else {
            my str $ch = substr($scope_str, $pos, 1);
            if ($ch eq ",") {
                if (length($var_name) > 0) {
                    # Skip captured variables
                    if ($in_anon == 0 || is_var_in_list($var_name, $capture_str) == 0) {
                        emit_var_cleanup_stmt($cg, $var_name, is_var_in_list($var_name, $no_push_str));
                    }
                }
                $var_name = "";
            } else {
                $var_name = $var_name . $ch;
            }
            $pos = $pos + 1;
        }
    }
}

# Emit cleanup for current scope without popping (for early returns)
func scope_emit_cleanup(scalar $cg) void {
    my int $enabled = $cg->{"cleanup_enabled"};
    if ($enabled == 0) {
        return;
    }
    my int $depth = $cg->{"scope_depth"};
    if ($depth == 0) {
        return;
    }
    my scalar $vars = $cg->{"scope_vars"};
    my scalar $counts = $cg->{"scope_counts"};
    my str $scope_str = $vars->[$depth - 1];
    my int $count = $counts->[$depth - 1];
    emit_scope_decref($cg, $scope_str, $count);
}

# Emit cleanup for all scopes (for return statements)
func scope_emit_all_cleanup(scalar $cg) void {
    my int $enabled = $cg->{"cleanup_enabled"};
    if ($enabled == 0) {
        return;
    }
    my int $depth = $cg->{"scope_depth"};
    my scalar $vars = $cg->{"scope_vars"};
    my scalar $counts = $cg->{"scope_counts"};
    my scalar $no_push = $cg->{"scope_no_push_vars"};

    # Track already-cleaned variable names to avoid double-free when
    # inner scopes shadow outer variables with the same name
    my str $cleaned = "";
    my str $saved_no_push = $cg->{"current_no_push_str"};

    # Emit cleanup from innermost to outermost scope
    my int $d = $depth;
    while ($d > 0) {
        my str $scope_str = $vars->[$d - 1];
        my int $count = $counts->[$d - 1];
        $cg->{"current_no_push_str"} = $no_push->[$d - 1];
        $cleaned = emit_scope_decref_skip($cg, $scope_str, $count, $cleaned);

        $d = $d - 1;
    }
    $cg->{"current_no_push_str"} = $saved_no_push;

    # (catch variables are scope locals: the scope cleanup above already
    # popped and released them - popping them again here took an entry that
    # belongs to a caller)

    # foreach lists of the loops we are leaving
    emit_foreach_cleanup_from($cg, 0);

    # Also pop and decref function parameters (we incref'd and pushed them at function entry)
    # Skip for int-typed params (tagged ints are immortal) and leaf-safe bodies
    # (the wrap was elided at entry).
    my int $pn_count = $cg->{"func_param_count"} + 0;
    if ($pn_count > 0) {
        my scalar $param_names = $cg->{"func_param_names"};
        my scalar $param_skip = $cg->{"func_param_skip_wrap"};
        my int $pn_i = 0;
        while ($pn_i < $pn_count) {
            if ($param_skip->[$pn_i] == 0) {
                emit_indent($cg);
                emit($cg, "strada_cleanup_pop();\n");
                emit_indent($cg);
                my str $pname = $param_names->[$pn_i];
                emit($cg, "strada_decref(" . $pname . ");\n");
            } elsif ($param_skip->[$pn_i] == 2) {
                emit_indent($cg);
                my str $pname = $param_names->[$pn_i];
                emit($cg, "strada_decref(" . $pname . ");\n");
            }
            $pn_i = $pn_i + 1;
        }
    }
}

# Pop and release foreach lists of loops that started at depth >= min_depth
# (pass 0 for all of them). Used on paths that leave loops without reaching
# the loop's own cleanup_pop: return, throw outside any try, labeled
# last/next and goto.
func emit_foreach_cleanup_from(scalar $cg, int $min_depth) void {
    if ($cg->{"cleanup_enabled"} == 0) { return; }
    my int $n = $cg->{"fe_cl_count"} + 0;
    my scalar $names = $cg->{"fe_cl_names"};
    my scalar $depths = $cg->{"fe_cl_depths"};
    my int $i = $n - 1;
    while ($i >= 0) {
        my int $d = $depths->[$i] + 0;
        if ($d >= $min_depth) {
            emit_indent($cg);
            emit($cg, "strada_cleanup_pop();\n");
            emit_indent($cg);
            emit($cg, "strada_decref(" . $names->[$i] . ");\n");
        }
        $i = $i - 1;
    }
}

func foreach_cleanup_enter(scalar $cg, int $depth, str $name) void {
    my int $n = $cg->{"fe_cl_count"} + 0;
    my scalar $names = $cg->{"fe_cl_names"};
    my scalar $depths = $cg->{"fe_cl_depths"};
    $names->[$n] = $name;
    $depths->[$n] = $depth;
    $cg->{"fe_cl_count"} = $n + 1;
}

func foreach_cleanup_leave(scalar $cg) void {
    my int $n = $cg->{"fe_cl_count"} + 0;
    if ($n > 0) { $cg->{"fe_cl_count"} = $n - 1; }
}

func foreach_cleanup_reset(scalar $cg) void {
    my array @fe_cl_names = ();
    my array @fe_cl_depths = ();
    $cg->{"fe_cl_names"} = \@fe_cl_names;
    $cg->{"fe_cl_depths"} = \@fe_cl_depths;
    $cg->{"fe_cl_count"} = 0;
}

# Emit cleanup for scopes from current depth down to (but not including) target_depth
# Used for labeled break/continue to clean up intermediate scopes
func scope_emit_cleanup_to_depth(scalar $cg, int $target_depth) void {
    my int $enabled = $cg->{"cleanup_enabled"};
    if ($enabled == 0) {
        return;
    }
    my int $depth = $cg->{"scope_depth"};
    my scalar $vars = $cg->{"scope_vars"};
    my scalar $counts = $cg->{"scope_counts"};
    my scalar $no_push = $cg->{"scope_no_push_vars"};

    # Emit cleanup from innermost scope down to (but not including) target_depth
    # Track already-cleaned names to avoid double-free from variable shadowing
    my str $cleaned = "";
    my str $saved_no_push = $cg->{"current_no_push_str"};
    my int $d = $depth;
    while ($d > $target_depth) {
        my str $scope_str = $vars->[$d - 1];
        my int $count = $counts->[$d - 1];
        $cg->{"current_no_push_str"} = $no_push->[$d - 1];
        $cleaned = emit_scope_decref_skip($cg, $scope_str, $count, $cleaned);

        $d = $d - 1;
    }
    $cg->{"current_no_push_str"} = $saved_no_push;
}

# Emit STRADA_TRY_POP() for each active try block (for early returns in try blocks)
# Emit the finally blocks of enclosing try statements, innermost first,
# down to (and excluding) stack index $upto. While a finally is being
# emitted, the visible stack is truncated below it, so control flow
# INSIDE a finally only triggers OUTER finallys (no self-recursion).
func gen_finally_upto(scalar $cg, int $upto) void {
    my int $n = $cg->{"finally_count"};
    my scalar $blocks = $cg->{"finally_blocks"};
    my int $i = $n - 1;
    while ($i >= $upto) {
        my scalar $fb = $blocks->[$i];
        $cg->{"finally_count"} = $i;     # hide this + inner entries
        gen_block($cg, $fb);
        emit($cg, "\n");
        $cg->{"finally_count"} = $n;     # restore
        $i = $i - 1;
    }
}

func emit_try_cleanup(scalar $cg) void {
    my int $try_depth = $cg->{"try_depth"};
    while ($try_depth > 0) {
        emit_indent($cg);
        emit($cg, "STRADA_TRY_POP();\n");
        $try_depth = $try_depth - 1;
    }
}

# Unwind active try frames down to $target_td (0 for return, loop's try_depth
# for last/next/redo). Critically, each active try frame emits STRADA_TRY_POP()
# BEFORE running its own finally block (if any), with try_depth truncated to $ti
# during that finally block so any exception thrown inside finally propagates
# to the OUTER handler instead of jumping back into its own catch/guard!
func emit_try_unwind_to(scalar $cg, int $target_td) void {
    my int $cur_td = $cg->{"try_depth"} + 0;
    if ($cur_td <= $target_td) {
        return;
    }
    my scalar $tf_blocks = $cg->{"try_finally_blocks"};
    my int $saved_fc = $cg->{"finally_count"} + 0;
    my int $ti = $cur_td - 1;
    while ($ti >= $target_td) {
        emit_indent($cg);
        emit($cg, "STRADA_TRY_POP();\n");
        my scalar $fb = 0;
        if ($tf_blocks) {
            $fb = $tf_blocks->[$ti];
        }
        if ($fb) {
            $cg->{"try_depth"} = $ti;
            if ($cg->{"finally_count"} > 0) {
                $cg->{"finally_count"} = $cg->{"finally_count"} - 1;
            }
            emit_indent($cg);
            gen_block($cg, $fb);
            emit($cg, "\n");
        }
        $ti = $ti - 1;
    }
    $cg->{"try_depth"} = $cur_td;
    $cg->{"finally_count"} = $saved_fc;
}

# Register a function with its parameters for default arg handling
func codegen_register_function(scalar $cg, scalar $fn) void {
    my str $name = sanitize_name($fn->{"name"});
    my hash %info = ();
    $info{"param_count"} = $fn->{"param_count"};
    $info{"params"} = $fn->{"params"};
    $info{"return_type"} = $fn->{"return_type"};
    $info{"return_struct_name"} = "" . $fn->{"return_struct_name"};
    # Track if this is an extern function for call site conversion
    if ($fn->{"type"} == NODE_EXTERN_FUNC()) {
        # A `is_strada_extern_decl` extern is a body-less qualified extern
        # declaring a Strada function defined in another module. At call sites
        # it behaves like an ordinary Strada function (StradaValue* args/ret,
        # no raw-C-type conversion). Register it that way so the existing
        # call-emitter and needs_temp_cleanup paths just work -- the only
        # asymmetry vs. an in-module definition is in the forward-decl phase,
        # where we emit `extern StradaValue* X(StradaValue* ...)` so the
        # linker pulls the symbol from the other `.o`.
        if ($fn->{"is_strada_extern_decl"} == 1) {
            $info{"is_extern"} = 0;
            $info{"is_c_extern"} = 0;
            $info{"is_strada_extern_decl"} = 1;
        } else {
            $info{"is_extern"} = 1;
            # Track if this is a C-style extern (raw C types, direct calls)
            if ($fn->{"is_c_extern"} == 1) {
                $info{"is_c_extern"} = 1;
            } else {
                $info{"is_c_extern"} = 0;
            }
            $info{"is_strada_extern_decl"} = 0;
        }
    } else {
        $info{"is_extern"} = 0;
        $info{"is_c_extern"} = 0;
        $info{"is_strada_extern_decl"} = 0;
    }

    # Track variadic function info
    $info{"is_variadic"} = $fn->{"is_variadic"};
    $info{"variadic_param_idx"} = -1;
    if ($fn->{"is_variadic"} == 1) {
        my scalar $params = $fn->{"params"};
        my int $pc = $fn->{"param_count"};
        for (my int $i = 0; $i < $pc; $i = $i + 1) {
            if ($params->[$i]->{"is_variadic"} == 1) {
                $info{"variadic_param_idx"} = $i;
            }
        }
    }

    $info{"c_name"} = mangle_c_func_ident($name, "" . $fn->{"name"}, $info{"is_c_extern"});
    $cg->{"functions"}->{$name} = \%info;
}

# Check if a method has any before/after/around modifiers.
# Covers host-side modifiers AND modifier names advertised by import_lib
# metadata (mod: lines) — a .so registers its hooks at dlopen, after the
# host was compiled, so without this check devirtualization (and accessor
# inlining) would silently skip them.
func has_method_modifier(scalar $cg, str $method) int {
    my scalar $libmods = $cg->{"lib_modified_methods"};
    if ($libmods) {
        my int $lm_hit = $libmods->{$method} + 0;
        if ($lm_hit == 1) { return 1; }
    }
    my int $mc = $cg->{"method_modifier_count"};
    if ($mc == 0) { return 0; }
    my scalar $mods = $cg->{"method_modifiers"};
    my int $mi = 0;
    while ($mi < $mc) {
        if ($mods->[$mi]->{"method_name"} eq $method) {
            return 1;
        }
        $mi = $mi + 1;
    }
    return 0;
}

# Compile-time class-hierarchy walk: is $child_pkg a subclass of (or equal to)
# $target_pkg? UNIVERSAL is the implicit root (matches anything blessed).
# Used to constant-fold $obj->isa("X") when $obj's class is known statically.
func is_subclass_compile_time(scalar $cg, str $child_pkg, str $target_pkg, int $depth) int {
    if ($child_pkg eq $target_pkg) { return 1; }
    if ($target_pkg eq "UNIVERSAL") { return 1; }
    if ($depth > 32) { return 0; }
    my scalar $inh = $cg->{"inherits"};
    my int $ic = $cg->{"inherit_count"};
    my int $i = 0;
    while ($i < $ic) {
        my str $c = $inh->[$i]->{"child"};
        if ($c eq $child_pkg) {
            my str $p = $inh->[$i]->{"parent"};
            if (is_subclass_compile_time($cg, $p, $target_pkg, $depth + 1) == 1) {
                return 1;
            }
        }
        $i = $i + 1;
    }
    return 0;
}

# Two zero-arg accessor calls structurally equal? Compares method name and a
# NODE_VARIABLE receiver by name. Used by the CSE peephole — within a single
# expression there's no intervening write, so two reads of the same accessor on
# the same receiver variable must yield the same value.
func accessor_call_eq(scalar $a, scalar $b) int {
    if (!$a || !$b) { return 0; }
    if ($a->{"type"} != NODE_METHOD_CALL() || $b->{"type"} != NODE_METHOD_CALL()) { return 0; }
    if ($a->{"arg_count"} != 0 || $b->{"arg_count"} != 0) { return 0; }
    if ($a->{"method"} ne $b->{"method"}) { return 0; }
    my scalar $ar = $a->{"base_object"};
    if (!$ar) { $ar = $a->{"object"}; }
    my scalar $br = $b->{"base_object"};
    if (!$br) { $br = $b->{"object"}; }
    if (!$ar || !$br) { return 0; }
    if ($ar->{"type"} != NODE_VARIABLE() || $br->{"type"} != NODE_VARIABLE()) { return 0; }
    if ($ar->{"name"} ne $br->{"name"}) { return 0; }
    return 1;
}

# Is this expression a zero-arg call to an inline int-typed has accessor?
func is_inline_int_accessor_call(scalar $cg, scalar $expr) int {
    if (!$expr) { return 0; }
    if ($expr->{"type"} != NODE_METHOD_CALL()) { return 0; }
    if ($expr->{"arg_count"} != 0) { return 0; }
    if (length(is_inline_accessor($cg, $expr->{"method"})) == 0) { return 0; }
    return expr_is_int_typed($cg, $expr);
}

# Check if a zero-arg method call can be inlined as a direct hash access.
# Returns the attribute name if inlineable, empty string otherwise.
func is_inline_accessor(scalar $cg, str $method) str {
    # Skip UNIVERSAL methods
    if ($method eq "isa" || $method eq "can" || $method eq "new" || $method eq "DESTROY") {
        return "";
    }

    my str $pkg = $cg->{"current_fn_package"};
    if (length($pkg) == 0 || $pkg eq "main") { return ""; }

    my scalar $lookup = $cg->{"accessor_lookup"};
    if (!$lookup) { return ""; }

    # Check direct match: method is a has attr of current package
    my str $key = $pkg . "\t" . $method;
    if (length("" . $lookup->{$key}) > 0) {
        # Check no modifiers
        if (has_method_modifier($cg, $method) == 0) {
            return $method;
        }
        return "";
    }

    # Check inherited: walk parent chain via inherits
    my scalar $inherits = $cg->{"inherits"};
    my int $ic = $cg->{"inherit_count"};
    my int $ii = 0;
    while ($ii < $ic) {
        my scalar $entry = $inherits->[$ii];
        if ($entry->{"child"} eq $pkg) {
            my str $parent = $entry->{"parent"};
            my str $pkey = $parent . "\t" . $method;
            if (length("" . $lookup->{$pkey}) > 0) {
                # Check no override in current package
                my str $override = $pkg . "_" . $method;
                my scalar $funcs = $cg->{"functions"};
                if (length("" . $funcs->{$override}) == 0) {
                    if (has_method_modifier($cg, $method) == 0) {
                        return $method;
                    }
                }
            }
        }
        $ii = $ii + 1;
    }

    return "";
}

# Check if a 1-arg method call is an inline setter: $self->set_X(val) where X is has rw.
# Returns the attribute name if inlineable, empty string otherwise.
func is_inline_setter(scalar $cg, str $method) str {
    # Must start with "set_"
    if (length($method) <= 4) { return ""; }
    if (substr($method, 0, 4) ne "set_") { return ""; }
    my str $attr_name = substr($method, 4, length($method) - 4);

    my str $pkg = $cg->{"current_fn_package"};
    if (length($pkg) == 0 || $pkg eq "main") { return ""; }

    my scalar $ha_attrs = $cg->{"has_attrs"};
    my int $ha_count = $cg->{"has_attr_count"};
    my scalar $acc_lookup = $cg->{"accessor_lookup"};

    # Check direct match in current package
    my int $hi = 0;
    while ($hi < $ha_count) {
        my str $a_name = $ha_attrs->[$hi]->{"name"};
        my str $a_pkg = $ha_attrs->[$hi]->{"package"};
        my int $a_rw = $ha_attrs->[$hi]->{"rw"};
        if ($a_name eq $attr_name && $a_rw == 1) {
            if ($a_pkg eq $pkg || is_subclass_compile_time($cg, $pkg, $a_pkg, 0) == 1) {
                # Check no method override for the setter
                my str $override = $pkg . "_set_" . $attr_name;
                my scalar $funcs = $cg->{"functions"};
                # The auto-generated setter IS in functions, so check if there's a user override
                # by verifying the setter comes from has-attr (not user-defined)
                # Actually: we know it's auto-generated because it's in has_attrs with rw=1.
                # Only skip if there are method modifiers on the setter.
                if (has_method_modifier($cg, $method) == 0) {
                    return $attr_name;
                }
            }
        }
        $hi = $hi + 1;
    }

    # Check inherited attrs
    my scalar $inherits = $cg->{"inherits"};
    my int $ic = $cg->{"inherit_count"};
    my int $ii = 0;
    while ($ii < $ic) {
        if ($inherits->[$ii]->{"child"} eq $pkg) {
            my str $parent = $inherits->[$ii]->{"parent"};
            my int $pi = 0;
            while ($pi < $ha_count) {
                my str $pa_name = $ha_attrs->[$pi]->{"name"};
                my str $pa_pkg = $ha_attrs->[$pi]->{"package"};
                my int $pa_rw = $ha_attrs->[$pi]->{"rw"};
                if ($pa_name eq $attr_name && $pa_rw == 1 && $pa_pkg eq $parent) {
                    if (has_method_modifier($cg, $method) == 0) {
                        return $attr_name;
                    }
                }
                $pi = $pi + 1;
            }
        }
        $ii = $ii + 1;
    }

    return "";
}

# Returns 1 if the given AST node contains only operations that cannot throw,
# allocate via the slow path, or store the parameter outside the call frame.
# Used to decide whether the per-call incref / cleanup_push / cleanup_pop /
# decref wrap on scalar parameters can be elided for leaf methods.
func node_is_leaf_safe(scalar $cg, scalar $node) int {
    if (!$node) { return 1; }
    my int $t = $node->{"type"};
    if ($t == NODE_BLOCK()) {
        my scalar $stmts = $node->{"statements"};
        my int $sc = $node->{"statement_count"};
        my int $i = 0;
        while ($i < $sc) {
            if (node_is_leaf_safe($cg, $stmts->[$i]) == 0) { return 0; }
            $i = $i + 1;
        }
        return 1;
    }
    if ($t == NODE_RETURN_STMT()) {
        if ($node->{"value"}) { return node_is_leaf_safe($cg, $node->{"value"}); }
        return 1;
    }
    if ($t == NODE_EXPR_STMT()) {
        if ($node->{"expr"}) { return node_is_leaf_safe($cg, $node->{"expr"}); }
        return 1;
    }
    if ($t == NODE_BINARY_OP()) {
        my str $op = $node->{"op"};
        # Only arithmetic and numeric/relational ops. Excludes ".", "x", "=~",
        # "//", "and"/"or", etc. that can allocate or call user code.
        if ($op ne "+" && $op ne "-" && $op ne "*" && $op ne "/" && $op ne "%" &&
            $op ne "==" && $op ne "!=" && $op ne "<" && $op ne ">" &&
            $op ne "<=" && $op ne ">=" && $op ne "&&" && $op ne "||") {
            return 0;
        }
        if (node_is_leaf_safe($cg, $node->{"left"}) == 0) { return 0; }
        if (node_is_leaf_safe($cg, $node->{"right"}) == 0) { return 0; }
        return 1;
    }
    if ($t == NODE_UNARY_OP()) {
        return node_is_leaf_safe($cg, $node->{"operand"});
    }
    if ($t == NODE_VARIABLE()) { return 1; }
    if ($t == NODE_PARAM()) { return 1; }
    if ($t == NODE_INT_LITERAL()) { return 1; }
    if ($t == NODE_NUM_LITERAL()) { return 1; }
    if ($t == NODE_STR_LITERAL()) { return 1; }
    if ($t == NODE_METHOD_CALL()) {
        # Only zero-arg inline-accessor method calls are safe.
        if ($node->{"arg_count"} != 0) { return 0; }
        if (length(is_inline_accessor($cg, $node->{"method"})) == 0) { return 0; }
        my scalar $obj = $node->{"base_object"};
        if (!$obj) { $obj = $node->{"object"}; }
        return node_is_leaf_safe($cg, $obj);
    }
    if ($t == NODE_TERNARY()) {
        if (node_is_leaf_safe($cg, $node->{"condition"}) == 0) { return 0; }
        if (node_is_leaf_safe($cg, $node->{"true_expr"}) == 0) { return 0; }
        if (node_is_leaf_safe($cg, $node->{"false_expr"}) == 0) { return 0; }
        return 1;
    }
    if ($t == NODE_HASH_ACCESS()) {
        # $hash{key} — strada_hv_fetch_owned/_ph never throws (returns undef
        # on missing key) and doesn't escape the hash. Key must also be safe.
        if (node_is_leaf_safe($cg, $node->{"hash"}) == 0) { return 0; }
        if (node_is_leaf_safe($cg, $node->{"key"}) == 0) { return 0; }
        return 1;
    }
    if ($t == NODE_DEREF_HASH()) {
        # $ref->{key} — uses the same safe runtime path as NODE_HASH_ACCESS.
        if (node_is_leaf_safe($cg, $node->{"ref"}) == 0) { return 0; }
        if (node_is_leaf_safe($cg, $node->{"key"}) == 0) { return 0; }
        return 1;
    }
    if ($t == NODE_SUBSCRIPT()) {
        # $arr[idx] — strada_array_get/_owned never throws, returns undef
        # for out-of-bounds. Both array expression and index must be safe.
        if (node_is_leaf_safe($cg, $node->{"array"}) == 0) {
            if (node_is_leaf_safe($cg, $node->{"target"}) == 0) { return 0; }
        }
        if (node_is_leaf_safe($cg, $node->{"index"}) == 0) { return 0; }
        return 1;
    }
    if ($t == NODE_DEREF_ARRAY()) {
        if (node_is_leaf_safe($cg, $node->{"ref"}) == 0) { return 0; }
        if (node_is_leaf_safe($cg, $node->{"index"}) == 0) { return 0; }
        return 1;
    }
    # Conservative default: any other node could allocate, throw, or escape self.
    return 0;
}

# Stricter leaf check for stack-frame elision under enable_stack_trace == 1:
# excludes '/' and '%' (which can throw division-by-zero) while allowing
# non-throwing leaf expressions (literals, undef, vars, inline accessors,
# untied hash/array reads, and non-overloaded '.' string concat).
func node_is_leaf_safe_nothrow(scalar $cg, scalar $node) int {
    if (!$node) { return 1; }
    my int $t = $node->{"type"} + 0;
    if ($t == NODE_BLOCK()) {
        my scalar $stmts = $node->{"statements"};
        my int $sc = $node->{"statement_count"} + 0;
        my int $i = 0;
        while ($i < $sc) {
            if (node_is_leaf_safe_nothrow($cg, $stmts->[$i]) == 0) { return 0; }
            $i = $i + 1;
        }
        return 1;
    }
    if ($t == NODE_RETURN_STMT()) {
        if ($node->{"value"}) { return node_is_leaf_safe_nothrow($cg, $node->{"value"}); }
        return 1;
    }
    if ($t == NODE_EXPR_STMT()) {
        if ($node->{"expr"}) { return node_is_leaf_safe_nothrow($cg, $node->{"expr"}); }
        return 1;
    }
    if ($t == NODE_BINARY_OP()) {
        my str $op = "" . $node->{"op"};
        if ($op eq "+" || $op eq "-" || $op eq "*" ||
            $op eq "==" || $op eq "!=" || $op eq "<" || $op eq ">" ||
            $op eq "<=" || $op eq ">=" || $op eq "&&" || $op eq "||" || $op eq ".") {
            if (node_is_leaf_safe_nothrow($cg, $node->{"left"}) == 0) { return 0; }
            if (node_is_leaf_safe_nothrow($cg, $node->{"right"}) == 0) { return 0; }
            return 1;
        }
        return 0;
    }
    if ($t == NODE_UNARY_OP()) {
        return node_is_leaf_safe_nothrow($cg, $node->{"operand"});
    }
    if ($t == NODE_VARIABLE() || $t == NODE_PARAM() || $t == NODE_INT_LITERAL()
        || $t == NODE_NUM_LITERAL() || $t == NODE_STR_LITERAL() || $t == NODE_UNDEF()) {
        return 1;
    }
    if ($t == NODE_METHOD_CALL()) {
        if ($node->{"arg_count"} != 0) { return 0; }
        if (length(is_inline_accessor($cg, $node->{"method"})) == 0) { return 0; }
        my scalar $obj = $node->{"base_object"};
        if (!$obj) { $obj = $node->{"object"}; }
        return node_is_leaf_safe_nothrow($cg, $obj);
    }
    if ($t == NODE_TERNARY()) {
        if (node_is_leaf_safe_nothrow($cg, $node->{"condition"}) == 0) { return 0; }
        if (node_is_leaf_safe_nothrow($cg, $node->{"true_expr"}) == 0) { return 0; }
        if (node_is_leaf_safe_nothrow($cg, $node->{"false_expr"}) == 0) { return 0; }
        return 1;
    }
    if ($t == NODE_HASH_ACCESS()) {
        if (node_is_leaf_safe_nothrow($cg, $node->{"hash"}) == 0) { return 0; }
        return node_is_leaf_safe_nothrow($cg, $node->{"key"});
    }
    if ($t == NODE_DEREF_HASH()) {
        if (node_is_leaf_safe_nothrow($cg, $node->{"ref"}) == 0) { return 0; }
        return node_is_leaf_safe_nothrow($cg, $node->{"key"});
    }
    if ($t == NODE_SUBSCRIPT()) {
        if (node_is_leaf_safe_nothrow($cg, $node->{"array"}) == 0) { return 0; }
        return node_is_leaf_safe_nothrow($cg, $node->{"index"});
    }
    if ($t == NODE_DEREF_ARRAY()) {
        if (node_is_leaf_safe_nothrow($cg, $node->{"ref"}) == 0) { return 0; }
        return node_is_leaf_safe_nothrow($cg, $node->{"index"});
    }
    if ($t == NODE_ANON_ARRAY() || $t == NODE_ANON_HASH()) {
        return expr_cannot_throw($cg, $node);
    }
    return 0;
}

# Check if an expression is a string concatenation with a string literal on the left.
# Pattern: NODE_BINARY_OP(op=".") with left=NODE_STR_LITERAL
# Returns 1 if the pattern matches, 0 otherwise.
func is_concat_str_literal_left(scalar $expr) int {
    if ($expr->{"type"} != NODE_BINARY_OP()) { return 0; }
    if ($expr->{"op"} ne ".") { return 0; }
    if ($expr->{"left"}->{"type"} == NODE_STR_LITERAL()) { return 1; }
    return 0;
}

# Helper to get arg from packed args array
func gen_oop_helper_decl(scalar $sb) void {
    sb_append($sb, "/* OOP method dispatch helper */\n");
    sb_append($sb, "static StradaValue* __strada_get_arg(StradaValue* args, int idx) {\n");
    sb_append($sb, "    if (!args || STRADA_IS_TAGGED_INT(args) || args->type != STRADA_ARRAY) return NULL;\n");
    sb_append($sb, "    if ((size_t)idx >= args->value.av->size) return NULL;\n");
    sb_append($sb, "    return args->value.av->elements[args->value.av->head + idx];\n");
    sb_append($sb, "}\n\n");
}

# Track a method for OOP registration (per-package)
func codegen_track_method(scalar $cg, scalar $fn, str $pkg) void {
    my str $name = sanitize_name($fn->{"name"});

    # Skip main, extern functions, and functions starting with underscore
    if ($name eq "main") { return; }
    if ($fn->{"type"} == NODE_EXTERN_FUNC()) { return; }
    if (substr($name, 0, 1) eq "_") { return; }

    # Methods must have at least one parameter (self)
    # Functions with 0 params are class init functions, not methods
    my int $param_count = $fn->{"param_count"};
    if ($param_count == 0) { return; }

    # Check if function name starts with package prefix (e.g., Cannoli_)
    # Sanitize package name for packages with :: (e.g., Nesso::Record -> Nesso_Record)
    my str $prefix = sanitize_name($pkg) . "_";
    my int $prefix_len = length($prefix);
    if (length($name) <= $prefix_len) { return; }
    if (substr($name, 0, $prefix_len) ne $prefix) { return; }

    # Get method name without prefix
    my str $method = substr($name, $prefix_len, length($name) - $prefix_len);

    # Track method info
    my hash %minfo = ();
    $minfo{"func_name"} = $name;
    $minfo{"method_name"} = $method;
    $minfo{"param_count"} = $fn->{"param_count"};
    $minfo{"params"} = $fn->{"params"};
    $minfo{"return_type"} = $fn->{"return_type"};
    $minfo{"package"} = $pkg;
    $minfo{"is_variadic"} = $fn->{"is_variadic"};
    # Find variadic param index
    my int $variadic_idx = -1;
    if ($fn->{"is_variadic"} == 1) {
        my scalar $params = $fn->{"params"};
        my int $pc = $fn->{"param_count"};
        for (my int $vi = 0; $vi < $pc; $vi = $vi + 1) {
            if ($params->[$vi]->{"is_variadic"} == 1) {
                $variadic_idx = $vi;
            }
        }
    }
    $minfo{"variadic_param_idx"} = $variadic_idx;

    # Get or create the methods info for this package
    # Use string index check instead of exists() for bootstrap compatibility
    my str $pkg_marker = "|" . $pkg . "|";
    my str $seen = $cg->{"pkg_seen"};
    my int $found_idx = index($seen, $pkg_marker);
    if ($found_idx < 0) {
        # New package - initialize it
        my hash %pkg_info = ();
        my array @new_arr = ();
        $pkg_info{"methods"} = \@new_arr;
        $pkg_info{"count"} = 0;
        my scalar $pkg_methods = $cg->{"pkg_methods"};
        $pkg_methods->{$pkg} = \%pkg_info;
        # Also track package name in the list
        my int $pkg_idx = $cg->{"pkg_count"};
        $cg->{"pkg_list"}->[$pkg_idx] = $pkg;
        $cg->{"pkg_count"} = $pkg_idx + 1;
        # Mark as seen
        $cg->{"pkg_seen"} = $seen . $pkg . "|";
    }
    my scalar $pkg_methods = $cg->{"pkg_methods"};
    my scalar $pkg_info = $pkg_methods->{$pkg};
    my int $idx = $pkg_info->{"count"};
    $pkg_info->{"methods"}->[$idx] = \%minfo;
    $pkg_info->{"count"} = $idx + 1;
}

# Helper: emit strada_overload_register for a single operator if it's in the overload hash
func gen_overload_reg_if(scalar $sb, str $pkg, scalar $pkg_ol, scalar $methods, int $method_count, str $op) void {
    my str $method_name = "" . $pkg_ol->{$op};
    if (length($method_name) == 0) { return; }
    # Find the wrapper function for this method
    my int $i = 0;
    while ($i < $method_count) {
        my scalar $m = $methods->[$i];
        if ($m->{"method_name"} eq $method_name) {
            sb_append($sb, "    strada_overload_register(\"" . $pkg . "\", \"" . $op . "\", __wrap_" . $m->{"func_name"} . ");\n");
            return;
        }
        $i = $i + 1;
    }
}

# Helper: emit strada_overload_register for stringify ("") operator
func gen_overload_reg_stringify(scalar $sb, str $pkg, scalar $pkg_ol, scalar $methods, int $method_count) void {
    my str $method_name = "" . $pkg_ol->{"\"\""};
    if (length($method_name) == 0) { return; }
    # Find the wrapper function for this method
    my int $i = 0;
    while ($i < $method_count) {
        my scalar $m = $methods->[$i];
        if ($m->{"method_name"} eq $method_name) {
            sb_append($sb, "    strada_overload_register(\"" . $pkg . "\", \"\\\"\\\"\", __wrap_" . $m->{"func_name"} . ");\n");
            return;
        }
        $i = $i + 1;
    }
}

# The C expression for a parameter's default value when that default is a
# simple literal (an int, a negated int, a number, or a string of ordinary
# characters); "" for no default or anything more involved. Used by the method
# wrappers, which are assembled as text and cannot run the expression codegen.
func wrapper_default_literal(scalar $param) str {
    if (!$param) { return ""; }
    if ($param->{"has_default"} != 1) { return ""; }
    my scalar $dv = $param->{"default"};
    if (!$dv) { return ""; }
    my int $dt = $dv->{"type"};
    if ($dt == NODE_INT_LITERAL()) {
        my str $iv = "" . $dv->{"value"};
        if (bytes($iv) < 15) {
            return "STRADA_MAKE_TAGGED_INT(" . c_int64_lit($iv) . ")";
        }
        return "strada_new_int(" . c_int64_lit($iv) . ")";
    }
    if ($dt == NODE_NUM_LITERAL()) {
        return "strada_new_num(" . $dv->{"value"} . ")";
    }
    if ($dt == NODE_UNARY_OP()) {
        my str $du_op = $dv->{"op"};
        my scalar $du_arg = $dv->{"operand"};
        if ($du_op eq "-" && $du_arg) {
            if ($du_arg->{"type"} == NODE_INT_LITERAL()) {
                my str $uiv = "" . $du_arg->{"value"};
                if ($uiv eq "9223372036854775808") {
                    return "strada_new_int(INT64_MIN)";
                }
                if (bytes($uiv) < 15) {
                    return "STRADA_MAKE_TAGGED_INT(-" . c_int64_lit($uiv) . ")";
                }
                return "strada_new_int(-" . c_int64_lit($uiv) . ")";
            }
            if ($du_arg->{"type"} == NODE_NUM_LITERAL()) {
                return "strada_new_num(-" . $du_arg->{"value"} . ")";
            }
        }
        return "";
    }
    if ($dt == NODE_STR_LITERAL()) {
        my str $ds = $dv->{"value"};
        my str $dq = "";
        my int $di = 0;
        my int $dn = bytes($ds);
        while ($di < $dn) {
            my int $dc = char_at($ds, $di);
            if ($dc == 34 || $dc == 92) {
                $dq = $dq . "\\" . chr($dc);
            } elsif ($dc == 10) {
                $dq = $dq . "\\n";
            } elsif ($dc == 9) {
                $dq = $dq . "\\t";
            } elsif ($dc < 32 || $dc >= 127) {
                return "";      # leave unusual bytes to the ordinary path
            } else {
                $dq = $dq . chr($dc);
            }
            $di = $di + 1;
        }
        return "strada_new_str(\"" . $dq . "\")";
    }
    return "";
}

func wrapper_has_literal_default(scalar $m) int {
    my scalar $wh_params = $m->{"params"};
    if (!$wh_params) { return 0; }
    my int $wh_n = $m->{"param_count"};
    my int $wh_i = 1;
    while ($wh_i < $wh_n) {
        if (length(wrapper_default_literal($wh_params->[$wh_i])) > 0) { return 1; }
        $wh_i = $wh_i + 1;
    }
    return 0;
}

# Generate method wrapper functions for a single package
# $pkg_info is a hash with "methods" array and "count" int
func gen_method_wrappers_for_pkg(scalar $sb, str $pkg, scalar $pkg_info, int $has_overloads, scalar $overloads, scalar $method_modifiers, int $method_modifier_count) void {
    my int $method_count = $pkg_info->{"count"};
    my scalar $methods = $pkg_info->{"methods"};
    if ($method_count == 0) { return; }

    sb_append($sb, "/* OOP method wrappers for package " . $pkg . " */\n");

    my int $i = 0;
    while ($i < $method_count) {
        my scalar $m = $methods->[$i];
        my str $func_name = $m->{"func_name"};
        my int $param_count = $m->{"param_count"};
        my int $ret_type = $m->{"return_type"};
        my int $is_void = $ret_type == TYPE_VOID();

        # Generate wrapper: __wrap_FuncName(self, args) { ... }
        sb_append($sb, "static StradaValue* __wrap_" . $func_name . "(StradaValue* self, StradaValue* args) {\n");

        if ($param_count <= 1 && $m->{"is_variadic"} == 1) {
            # No-parens variadic function used as method: prepend self to args for @_
            # Use incref on self and args elements since the packed array takes shared ownership
            sb_append($sb, "    StradaValue *__packed = strada_new_array();\n");
            sb_append($sb, "    strada_incref(self);\n");
            sb_append($sb, "    strada_array_push_take(__packed->value.av, self);\n");
            sb_append($sb, "    if (args && args->type == STRADA_ARRAY && args->value.av) {\n");
            sb_append($sb, "        for (size_t __i = 0; __i < args->value.av->size; __i++) {\n");
            sb_append($sb, "            strada_incref(args->value.av->elements[args->value.av->head + __i]);\n");
            sb_append($sb, "            strada_array_push_take(__packed->value.av, args->value.av->elements[args->value.av->head + __i]);\n");
            sb_append($sb, "        }\n");
            sb_append($sb, "    }\n");
            if ($is_void == 1) {
                sb_append($sb, "    " . $func_name . "(__packed);\n");
                sb_append($sb, "    strada_decref(__packed);\n");
                sb_append($sb, "    return strada_undef_static();\n");
            } else {
                sb_append($sb, "    StradaValue *__r = " . $func_name . "(__packed);\n");
                sb_append($sb, "    strada_decref(__packed);\n");
                sb_append($sb, "    return __r;\n");
            }
        } elsif ($param_count <= 1) {
            # 0 or 1 param (just self)
            sb_append($sb, "    (void)args;\n");
            if ($is_void == 1) {
                sb_append($sb, "    " . $func_name . "(self);\n");
                sb_append($sb, "    return strada_undef_static();\n");
            } else {
                sb_append($sb, "    return " . $func_name . "(self);\n");
            }
        } else {
            # Multiple params - unpack from args
            my int $is_variadic = $m->{"is_variadic"};
            my int $variadic_idx = $m->{"variadic_param_idx"};

            if ($is_variadic == 1) {
                if ($variadic_idx == 1) {
                    sb_append($sb, "    StradaValue *__va_empty = args ? NULL : strada_new_array();\n");
                    sb_append($sb, "    StradaValue *__va_pass = args ? args : __va_empty;\n");
                    if ($is_void == 1) {
                        sb_append($sb, "    " . $func_name . "(self, __va_pass);\n");
                        sb_append($sb, "    if (__va_empty) strada_decref(__va_empty);\n");
                        sb_append($sb, "    return strada_undef_static();\n");
                    } else {
                        sb_append($sb, "    StradaValue *__va_res1 = " . $func_name . "(self, __va_pass);\n");
                        sb_append($sb, "    if (__va_empty) strada_decref(__va_empty);\n");
                        sb_append($sb, "    return __va_res1;\n");
                    }
                } else {
                    sb_append($sb, "    StradaArray *__args = args ? strada_deref_array(args) : NULL;\n");
                    sb_append($sb, "    StradaValue *__va_arr = strada_new_array();\n");
                    my int $var_start = $variadic_idx - 1;
                    sb_append($sb, "    if (__args) {\n");
                    sb_append($sb, "        for (size_t __vi = " . $var_start . "; __vi < __args->size; __vi++) {\n");
                    sb_append($sb, "            strada_array_push(strada_deref_array(__va_arr), __args->elements[__args->head + __vi]);\n");
                    sb_append($sb, "        }\n");
                    sb_append($sb, "    }\n");
                    my scalar $wv_params = $m->{"params"};
                    my int $wv_j = 1;
                    while ($wv_j < $variadic_idx) {
                        my int $wv_idx = $wv_j - 1;
                        my str $wv_lit = "";
                        if ($wv_params) {
                            $wv_lit = wrapper_default_literal($wv_params->[$wv_j]);
                        }
                        sb_append($sb, "    StradaValue *__wa" . $wv_idx . " = __strada_get_arg(args, " . $wv_idx . "); int __wo" . $wv_idx . " = 0;\n");
                        if (length($wv_lit) > 0) {
                            sb_append($sb, "    if (!__wa" . $wv_idx . ") { __wa" . $wv_idx . " = " . $wv_lit . "; __wo" . $wv_idx . " = 1; }\n");
                        } else {
                            sb_append($sb, "    if (!__wa" . $wv_idx . ") { __wa" . $wv_idx . " = strada_undef_static(); }\n");
                        }
                        $wv_j = $wv_j + 1;
                    }
                    if ($is_void == 1) {
                        sb_append($sb, "    " . $func_name . "(self");
                    } else {
                        sb_append($sb, "    StradaValue *__va_result = " . $func_name . "(self");
                    }
                    my int $j = 1;
                    while ($j < $variadic_idx) {
                        my int $arg_idx = $j - 1;
                        sb_append($sb, ", __wa" . $arg_idx);
                        $j = $j + 1;
                    }
                    sb_append($sb, ", __va_arr);\n");
                    $wv_j = 1;
                    while ($wv_j < $variadic_idx) {
                        sb_append($sb, "    if (__wo" . ($wv_j - 1) . ") strada_decref(__wa" . ($wv_j - 1) . ");\n");
                        $wv_j = $wv_j + 1;
                    }
                    sb_append($sb, "    strada_decref(__va_arr);\n");
                    if ($is_void == 1) {
                        sb_append($sb, "    return strada_undef_static();\n");
                    } else {
                        sb_append($sb, "    return __va_result;\n");
                    }
                }
            } elsif (wrapper_has_literal_default($m) == 1) {
                # A parameter with a default value. Direct calls fill defaults
                # in at the call site; a dynamically dispatched call arrives
                # here with the argument simply missing, and used to pass NULL
                # (undef) on: `$obj->method()` ignored the default whenever the
                # receiver's class was not known statically.
                my scalar $wd_params = $m->{"params"};
                my int $wd_j = 1;
                while ($wd_j < $param_count) {
                    my int $wd_idx = $wd_j - 1;
                    my str $wd_lit = wrapper_default_literal($wd_params->[$wd_j]);
                    sb_append($sb, "    StradaValue *__wa" . $wd_idx . " = __strada_get_arg(args, " . $wd_idx . "); int __wo" . $wd_idx . " = 0;\n");
                    if (length($wd_lit) > 0) {
                        sb_append($sb, "    if (!__wa" . $wd_idx . ") { __wa" . $wd_idx . " = " . $wd_lit . "; __wo" . $wd_idx . " = 1; }\n");
                    }
                    $wd_j = $wd_j + 1;
                }
                if ($is_void == 1) {
                    sb_append($sb, "    " . $func_name . "(self");
                } else {
                    sb_append($sb, "    StradaValue *__wr = " . $func_name . "(self");
                }
                $wd_j = 1;
                while ($wd_j < $param_count) {
                    sb_append($sb, ", __wa" . ($wd_j - 1));
                    $wd_j = $wd_j + 1;
                }
                sb_append($sb, ");\n");
                $wd_j = 1;
                while ($wd_j < $param_count) {
                    # strada_decref is a no-op on tagged ints, so one release
                    # covers every kind of literal default.
                    sb_append($sb, "    if (__wo" . ($wd_j - 1) . ") strada_decref(__wa" . ($wd_j - 1) . ");\n");
                    $wd_j = $wd_j + 1;
                }
                if ($is_void == 1) {
                    sb_append($sb, "    return strada_undef_static();\n");
                } else {
                    sb_append($sb, "    return __wr;\n");
                }
} else {
                if ($is_void == 1) {
                    sb_append($sb, "    " . $func_name . "(self");
                } else {
                    sb_append($sb, "    return " . $func_name . "(self");
                }
                my int $j = 1;
                while ($j < $param_count) {
                    my int $arg_idx = $j - 1;
                    sb_append($sb, ", __strada_get_arg(args, " . $arg_idx . ")");
                    $j = $j + 1;
                }
                sb_append($sb, ");\n");
                if ($is_void == 1) {
                    sb_append($sb, "    return strada_undef_static();\n");
                }
            }
        }

        sb_append($sb, "}\n\n");
        $i = $i + 1;
    }

    # Generate initialization function for this package
    my str $c_pkg = sanitize_name($pkg);

    sb_append($sb, "/* OOP method registration initializer */\n");
    sb_append($sb, "static int __" . $c_pkg . "_oop_initialized = 0;\n");
    sb_append($sb, "void __" . $c_pkg . "_oop_init(void) {\n");
    sb_append($sb, "    if (__" . $c_pkg . "_oop_initialized) return;\n");
    sb_append($sb, "    __" . $c_pkg . "_oop_initialized = 1;\n\n");

    $i = 0;
    while ($i < $method_count) {
        my scalar $m = $methods->[$i];
        my str $func_name = $m->{"func_name"};
        my str $method_name = $m->{"method_name"};

        sb_append($sb, "    strada_method_register(\"" . $pkg . "\", \"" . $method_name . "\", __wrap_" . $func_name . ");\n");
        $i = $i + 1;
    }

    # Generate overload registrations for this package
    if ($has_overloads == 1) {
        my str $pkg_ol_check = "" . $overloads->{$pkg};
        if (length($pkg_ol_check) > 0) {
            my scalar $pkg_ol = $overloads->{$pkg};
            sb_append($sb, "\n    /* Operator overloads */\n");
            # For each operator in the overload hash, find the matching wrapper
            # and emit strada_overload_register() calls.
            # We check each known operator individually (bootstrap-safe, no array iteration).
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, "+");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, "-");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, "*");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, "/");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, "%");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, "**");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, ".");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, "==");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, "!=");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, "<");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, ">");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, "<=");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, ">=");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, "<=>");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, "eq");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, "ne");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, "lt");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, "gt");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, "le");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, "ge");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, "cmp");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, "neg");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, "~");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, "bool");
            gen_overload_reg_if($sb, $pkg, $pkg_ol, $methods, $method_count, "!");
            # Stringify ("") overload - key in hash is two double-quote chars
            gen_overload_reg_stringify($sb, $pkg, $pkg_ol, $methods, $method_count);
        }
    }

    # Generate method modifier registrations for this package
    if ($method_modifier_count > 0) {
        my int $has_mod = 0;
        my int $mi = 0;
        while ($mi < $method_modifier_count) {
            my scalar $mod = $method_modifiers->[$mi];
            if ($mod->{"package"} eq $pkg) {
                if ($has_mod == 0) {
                    sb_append($sb, "\n    /* Method modifiers */\n");
                    $has_mod = 1;
                }
                my str $mod_type = $mod->{"mod_type"};
                my int $type_int = 0;
                if ($mod_type eq "before") {
                    $type_int = 1;
                } elsif ($mod_type eq "after") {
                    $type_int = 2;
                } elsif ($mod_type eq "around") {
                    $type_int = 3;
                }
                my str $func_name = $mod->{"func_name"};
                my str $method_name = $mod->{"method_name"};
                # Find the wrapper for this modifier function
                my int $wi = 0;
                while ($wi < $method_count) {
                    my scalar $wm = $methods->[$wi];
                    if ($wm->{"func_name"} eq $func_name) {
                        sb_append($sb, "    strada_modifier_register(\"" . $pkg . "\", \"" . $method_name . "\", " . $type_int . ", __wrap_" . $func_name . ");\n");
                        $wi = $method_count;
                    }
                    $wi = $wi + 1;
                }
            }
            $mi = $mi + 1;
        }
    }

    sb_append($sb, "}\n\n");
}

# Generate method wrappers for ALL packages
func gen_all_method_wrappers(scalar $cg) str {
    my int $num_pkgs = get_oop_pkg_count($cg);
    if ($num_pkgs == 0) { return ""; }

    my scalar $pkg_methods = $cg->{"pkg_methods"};
    my scalar $pkg_list = get_oop_packages($cg);

    my scalar $sb = sb_new();

    # Add the helper function once
    gen_oop_helper_decl($sb);

    # Get overload info
    my int $has_overloads = $cg->{"has_overloads"};
    my scalar $overloads = $cg->{"overloads"};

    # Get method modifier info
    my scalar $method_modifiers = $cg->{"method_modifiers"};
    my int $method_modifier_count = $cg->{"method_modifier_count"};

    # Generate wrappers for each package
    my int $i = 0;
    while ($i < $num_pkgs) {
        my str $pkg = $pkg_list->[$i];
        my scalar $pkg_info = $pkg_methods->{$pkg};
        gen_method_wrappers_for_pkg($sb, $pkg, $pkg_info, $has_overloads, $overloads, $method_modifiers, $method_modifier_count);
        $i = $i + 1;
    }

    return sb_to_string($sb);
}

# Get all packages that have registered methods
# Returns the pkg_list array reference (not a copy)
func get_oop_packages(scalar $cg) scalar {
    return $cg->{"pkg_list"};
}

# The Strada package name ("Base::Model") for a C-safe one ("Base_Model"):
# objects must be blessed with the name methods and inheritance are
# registered under. Falls back to the given name.
func strada_pkg_for_c(scalar $cg, str $c_pkg) str {
    my scalar $pl = $cg->{"pkg_list"};
    my int $n = $cg->{"pkg_count"} + 0;
    my int $i = 0;
    while ($i < $n) {
        my str $p = $pl->[$i];
        if (pkg_c_safe($p) eq $c_pkg) { return $p; }
        $i = $i + 1;
    }
    my scalar $inh = $cg->{"inherits"};
    my int $ic = $cg->{"inherit_count"} + 0;
    $i = 0;
    while ($i < $ic) {
        my str $ch = $inh->[$i]->{"child"};
        if (pkg_c_safe($ch) eq $c_pkg) { return $ch; }
        $i = $i + 1;
    }
    # has-attribute declarations are collected for the whole program up
    # front, so they also know classes defined later in the file
    my scalar $ha = $cg->{"has_attrs"};
    my int $hc = $cg->{"has_attr_count"} + 0;
    $i = 0;
    while ($i < $hc) {
        my str $hp = $ha->[$i]->{"package"};
        if (pkg_c_safe($hp) eq $c_pkg) { return $hp; }
        $i = $i + 1;
    }
    return $c_pkg;
}

func pkg_c_safe(str $p) str {
    my str $out = $p;
    my int $ci = index($out, "::");
    while ($ci >= 0) {
        $out = substr($out, 0, $ci) . "_" . substr($out, $ci + 2, length($out) - $ci - 2);
        $ci = index($out, "::");
    }
    return $out;
}

# Get count of packages
func get_oop_pkg_count(scalar $cg) int {
    return $cg->{"pkg_count"};
}

# Check if an expression could produce a blessed object at runtime.
# Returns 1 if the expression MIGHT be blessed, 0 if it CANNOT be.
# Used for operator overloading: only emit dispatch code when operands could be blessed.
func could_be_blessed(scalar $expr) int {
    my int $type = $expr->{"type"};

    # Variables with scalar/undef type could be blessed
    if ($type == NODE_VARIABLE()) {
        my int $var_type = $expr->{"var_type"};
        if ($var_type == TYPE_SCALAR() || $var_type == 0) {
            return 1;
        }
        # Typed variables (int, num, str) cannot be blessed
        return 0;
    }

    # Literals cannot be blessed
    if ($type == NODE_INT_LITERAL() || $type == NODE_NUM_LITERAL() || $type == NODE_STR_LITERAL()) {
        return 0;
    }
    if ($type == NODE_UNDEF()) {
        return 0;
    }

    # Function calls returning scalar could be blessed
    if ($type == NODE_CALL()) {
        return 1;
    }

    # Method calls always return scalar (could be blessed)
    if ($type == NODE_METHOD_CALL()) {
        return 1;
    }

    # Dynamic method calls could return blessed
    if ($type == NODE_DYN_METHOD_CALL()) {
        return 1;
    }

    # Hash/array dereference access could return blessed
    if ($type == NODE_HASH_ACCESS() || $type == NODE_DEREF_HASH() ||
        $type == NODE_DEREF_ARRAY() || $type == NODE_SUBSCRIPT()) {
        return 1;
    }

    # Ternary could return blessed
    if ($type == NODE_TERNARY()) {
        return 1;
    }

    # Closure calls could return blessed
    if ($type == NODE_CLOSURE_CALL()) {
        return 1;
    }

    # Binary/unary ops produce numeric/string results, not blessed
    # (unless they themselves use overloading, but the dispatch handles that)
    return 0;
}

# Generate overloaded binary operator dispatch
# Emits: ({ StradaValue *__ol_l = <left>; StradaValue *__ol_r = <right>;
#           StradaValue *__ol_res = strada_overload_binary(__ol_l, __ol_r, "op");
#           if (!__ol_res) __ol_res = <fallback>; __ol_res; })
# Emit the default (non-overloaded) fallback for a binary op using __ol_l, __ol_r temps
func emit_overload_binary_fallback(scalar $cg, str $op) void {
    if ($op eq "+") {
        emit($cg, "(STRADA_IS_TAGGED_INT(__ol_l) && STRADA_IS_TAGGED_INT(__ol_r) ? strada_new_int_il(STRADA_TAGGED_INT_VAL(__ol_l) + STRADA_TAGGED_INT_VAL(__ol_r)) : strada_new_num(strada_to_num(__ol_l) + strada_to_num(__ol_r)))");
    } elsif ($op eq "-") {
        emit($cg, "(STRADA_IS_TAGGED_INT(__ol_l) && STRADA_IS_TAGGED_INT(__ol_r) ? strada_new_int_il(STRADA_TAGGED_INT_VAL(__ol_l) - STRADA_TAGGED_INT_VAL(__ol_r)) : strada_new_num(strada_to_num(__ol_l) - strada_to_num(__ol_r)))");
    } elsif ($op eq "*") {
        emit($cg, "(STRADA_IS_TAGGED_INT(__ol_l) && STRADA_IS_TAGGED_INT(__ol_r) ? strada_new_int_il((int64_t)((uint64_t)STRADA_TAGGED_INT_VAL(__ol_l) * (uint64_t)STRADA_TAGGED_INT_VAL(__ol_r))) : strada_new_num(strada_to_num(__ol_l) * strada_to_num(__ol_r)))");
    } elsif ($op eq "/") {
        emit($cg, "strada_safe_div(strada_to_num(__ol_l), strada_to_num(__ol_r))");
    } elsif ($op eq "%") {
        emit($cg, "strada_safe_mod((int64_t)strada_to_int(__ol_l), (int64_t)strada_to_int(__ol_r))");
    } elsif ($op eq "**") {
        emit($cg, "strada_new_num(pow(strada_to_num(__ol_l), strada_to_num(__ol_r)))");
    } elsif ($op eq ".") {
        emit($cg, "strada_concat_sv(__ol_l, __ol_r)");
    } elsif ($op eq "==") {
        emit($cg, "strada_new_int(strada_to_num(__ol_l) == strada_to_num(__ol_r))");
    } elsif ($op eq "!=") {
        emit($cg, "strada_new_int(strada_to_num(__ol_l) != strada_to_num(__ol_r))");
    } elsif ($op eq "<") {
        emit($cg, "strada_new_int(strada_to_num(__ol_l) < strada_to_num(__ol_r))");
    } elsif ($op eq ">") {
        emit($cg, "strada_new_int(strada_to_num(__ol_l) > strada_to_num(__ol_r))");
    } elsif ($op eq "<=") {
        emit($cg, "strada_new_int(strada_to_num(__ol_l) <= strada_to_num(__ol_r))");
    } elsif ($op eq ">=") {
        emit($cg, "strada_new_int(strada_to_num(__ol_l) >= strada_to_num(__ol_r))");
    } else {
        emit($cg, "strada_new_num(strada_to_num(__ol_l))");
    }
}

# Emit string comparison fallback for overloaded ops
func emit_overload_strcmp_fallback(scalar $cg, str $op) void {
    emit($cg, "({ char *__sl = strada_to_str_ss(__ol_l); char *__sr = strada_to_str_ss(__ol_r); ");
    if ($op eq "eq") {
        emit($cg, "int __r = (strcmp(__sl, __sr) == 0); ");
    } elsif ($op eq "ne") {
        emit($cg, "int __r = (strcmp(__sl, __sr) != 0); ");
    } elsif ($op eq "lt") {
        emit($cg, "int __r = (strcmp(__sl, __sr) < 0); ");
    } elsif ($op eq "gt") {
        emit($cg, "int __r = (strcmp(__sl, __sr) > 0); ");
    } elsif ($op eq "le") {
        emit($cg, "int __r = (strcmp(__sl, __sr) <= 0); ");
    } elsif ($op eq "ge") {
        emit($cg, "int __r = (strcmp(__sl, __sr) >= 0); ");
    } elsif ($op eq "cmp") {
        emit($cg, "int __c = strcmp(__sl, __sr); int __r = (__c < 0) ? -1 : ((__c > 0) ? 1 : 0); ");
    } elsif ($op eq "<=>") {
        emit($cg, "double __nl = strada_to_num(__ol_l); double __nr = strada_to_num(__ol_r); int __r = (__nl < __nr) ? -1 : ((__nl > __nr) ? 1 : 0); ");
    } else {
        emit($cg, "int __r = 0; ");
    }
    emit($cg, "strada_cstr_free(__sl); strada_cstr_free(__sr); strada_new_int(__r); })");
}

func gen_overloaded_binary(scalar $cg, scalar $left, scalar $right, str $op) void {
    my int $left_tmp = 0;
    my int $right_tmp = 0;
    if ($cg->{"cleanup_enabled"} == 1) {
        $left_tmp = needs_temp_cleanup($cg, $left);
        $right_tmp = needs_temp_cleanup($cg, $right);
    }
    emit($cg, "({ StradaValue *__ol_l = ");
    gen_expression($cg, $left);
    emit($cg, "; StradaValue *__ol_r = ");
    gen_expression($cg, $right);
    emit($cg, "; StradaValue *__ol_res = strada_overload_binary(__ol_l, __ol_r, \"");
    emit($cg, $op);
    emit($cg, "\"); if (!__ol_res) { __ol_res = ");

    # Generate the fallback - dispatch to appropriate helper
    if ($op eq "eq" || $op eq "ne" || $op eq "lt" || $op eq "gt" || $op eq "le" || $op eq "ge" || $op eq "cmp" || $op eq "<=>") {
        emit_overload_strcmp_fallback($cg, $op);
    } else {
        emit_overload_binary_fallback($cg, $op);
    }
    emit($cg, "; }");
    # Clean up temporary operands
    if ($left_tmp == 1) {
        emit($cg, " strada_decref(__ol_l);");
    }
    if ($right_tmp == 1) {
        emit($cg, " strada_decref(__ol_r);");
    }
    emit($cg, " __ol_res; })");
}

# Generate overloaded unary operator dispatch
func gen_overloaded_unary(scalar $cg, scalar $operand, str $op) void {
    my int $op_tmp = 0;
    if ($cg->{"cleanup_enabled"} == 1) {
        $op_tmp = needs_temp_cleanup($cg, $operand);
    }
    emit($cg, "({ StradaValue *__ol_v = ");
    gen_expression($cg, $operand);
    emit($cg, "; StradaValue *__ol_res = strada_overload_unary(__ol_v, \"");
    emit($cg, $op);
    emit($cg, "\"); if (!__ol_res) { __ol_res = ");

    # Generate the fallback
    if ($op eq "neg") {
        emit($cg, "strada_new_num(-strada_to_num(__ol_v))");
    } elsif ($op eq "!") {
        emit($cg, "strada_new_int(!strada_to_bool(__ol_v))");
    } elsif ($op eq "~") {
        emit($cg, "strada_new_int(~strada_to_int(__ol_v))");
    } else {
        emit($cg, "strada_new_num(strada_to_num(__ol_v))");
    }
    emit($cg, "; }");
    if ($op_tmp == 1) {
        emit($cg, " strada_decref(__ol_v);");
    }
    emit($cg, " __ol_res; })");
}

# Generate overloaded string concatenation with stringify dispatch
func gen_overloaded_concat(scalar $cg, scalar $left, scalar $right) void {
    my int $left_tmp = 0;
    my int $right_tmp = 0;
    if ($cg->{"cleanup_enabled"} == 1) {
        $left_tmp = needs_temp_cleanup($cg, $left);
        $right_tmp = needs_temp_cleanup($cg, $right);
    }
    emit($cg, "({ StradaValue *__ol_l = ");
    gen_expression($cg, $left);
    emit($cg, "; StradaValue *__ol_r = ");
    gen_expression($cg, $right);
    emit($cg, ";");
    # Push the (possibly owned) operands so a throwing stringify
    # overload on either side doesn't leak the temp. Pop before the
    # normal-path decrefs below.
    if ($left_tmp == 1) { emit($cg, " strada_cleanup_push(__ol_l);"); }
    if ($right_tmp == 1) { emit($cg, " strada_cleanup_push(__ol_r);"); }
    emit($cg, " StradaValue *__ol_ls = strada_overload_stringify(__ol_l);");
    emit($cg, " StradaValue *__ol_rs = strada_overload_stringify(__ol_r);");
    emit($cg, " StradaValue *__ol_res = strada_concat_sv(__ol_ls ? __ol_ls : __ol_l, __ol_rs ? __ol_rs : __ol_r);");
    emit($cg, " if (__ol_ls) strada_decref(__ol_ls);");
    emit($cg, " if (__ol_rs) strada_decref(__ol_rs);");
    if ($right_tmp == 1) { emit($cg, " strada_cleanup_pop();"); }
    if ($left_tmp == 1) { emit($cg, " strada_cleanup_pop();"); }
    if ($left_tmp == 1) {
        emit($cg, " strada_decref(__ol_l);");
    }
    if ($right_tmp == 1) {
        emit($cg, " strada_decref(__ol_r);");
    }
    emit($cg, " __ol_res; })");
}

# Check if a binary operator might be overloaded for given operands
func check_overload_binary(scalar $cg, scalar $left, scalar $right, str $op) int {
    if ($cg->{"has_overloads"} == 0) {
        return 0;
    }
    # Check if this operator is overloaded (bootstrap-safe: no exists() on chained deref)
    my scalar $ol_ops = $cg->{"overloaded_ops"};
    my int $op_overloaded = length("" . $ol_ops->{$op}) > 0;
    # Comparison/equality operators can be DERIVED at runtime from an overloaded
    # <=> (numeric) or cmp (string) via fallback autogeneration. Emit the overload
    # path when the source op is overloaded too — strada_overload_binary derives,
    # and gen_overloaded_binary already falls back to a plain comparison when the
    # runtime class doesn't actually overload <=>/cmp.
    if ($op_overloaded == 0) {
        my str $src = "";
        if ($op eq "<" || $op eq "<=" || $op eq ">" || $op eq ">=" || $op eq "==" || $op eq "!=") {
            $src = "<=>";
        } elsif ($op eq "lt" || $op eq "le" || $op eq "gt" || $op eq "ge" || $op eq "eq" || $op eq "ne") {
            $src = "cmp";
        }
        if (length($src) > 0 && length("" . $ol_ops->{$src}) > 0) {
            $op_overloaded = 1;
        }
    }
    if ($op_overloaded == 0) {
        return 0;
    }
    if (expr_is_int_typed($cg, $left) == 1 && expr_is_int_typed($cg, $right) == 1) {
        return 0;
    }
    if (could_be_blessed($left) == 1 || could_be_blessed($right) == 1) {
        return 1;
    }
    return 0;
}

# Check if an expression is clearly a scalar value (not an array or function call)
# Used to determine if we need to wrap it when assigning to an array variable
func is_scalar_expr(scalar $expr) int {
    my int $type = $expr->{"type"};

    # Scalar variables ($x)
    if ($type == NODE_VARIABLE()) {
        my str $sigil = $expr->{"sigil"};
        if ($sigil eq "$") {
            return 1;
        }
        return 0;
    }

    # Literal values
    if ($type == NODE_INT_LITERAL() || $type == NODE_NUM_LITERAL() || $type == NODE_STR_LITERAL()) {
        return 1;
    }

    # $$ref / ${$ref}: one scalar. (@$ref and %$ref share the node type and
    # are whole containers.) Missing this made `my array @a = ($$ref);` an
    # alias of the dereferenced value instead of a one-element list.
    if ($type == NODE_DEREF_SCALAR()) {
        my str $ds_sigil = $expr->{"sigil"};
        if ($ds_sigil eq "$") {
            return 1;
        }
        return 0;
    }

    # Unary operators on scalars
    if ($type == NODE_UNARY_OP()) {
        return 1;
    }

    # Binary operators produce scalars (arithmetic, comparison, etc.)
    if ($type == NODE_BINARY_OP()) {
        return 1;
    }

    # Ternary produces a scalar
    if ($type == NODE_TERNARY()) {
        return 1;
    }

    # Array/hash subscript returns a scalar
    if ($type == NODE_SUBSCRIPT() || $type == NODE_HASH_ACCESS()) {
        return 1;
    }

    # Field access returns a scalar
    if ($type == NODE_FIELD_ACCESS()) {
        return 1;
    }

    # Everything else (function calls, deref, etc.) - assume not scalar
    return 0;
}

func emit(scalar $cg, str $text) void {
    # O(1) amortized append using StringBuilder
    sb_append($cg->{"output_sb"}, $text);
}

# Emit #line directive for source-level debugging
# Format: #line <line_number> "<filename>"
func emit_line_directive(scalar $cg, int $line) void {
    if ($cg->{"debug_info"} == 0) {
        return;
    }
    if ($line <= 0) {
        return;
    }
    # Avoid emitting duplicate line directives
    if ($line == $cg->{"last_line"}) {
        return;
    }
    $cg->{"last_line"} = $line;

    my str $filename = $cg->{"filename"};
    # Escape the filename — a `"`/`\`/newline in the source path would
    # otherwise break out of the #line string literal and inject C (CWE-94).
    # This directive is emitted per-statement under -g, so it fires even when
    # the program never uses __FILE__.
    emit($cg, "#line " . $line . " ");
    gen_str_literal_c($cg, $filename);
    emit($cg, "\n");
}

# Emit #line directive before a statement (with indent)
func emit_line_for_stmt(scalar $cg, scalar $stmt) void {
    if ($cg->{"debug_info"} == 0) {
        return;
    }
    # stmt should always be defined when called from gen_statement
    my int $line = $stmt->{"line"};
    if ($line > 0) {
        emit_line_directive($cg, $line);
    }
}

# Generate string comparison with proper cleanup of temporaries
# If one side is a string literal, use strada_str_*_lit to avoid creating temporaries
func gen_str_cmp(scalar $cg, scalar $expr, str $op) void {
    my scalar $left = $expr->{"left"};
    my scalar $right = $expr->{"right"};
    my int $left_type = $left->{"type"};
    my int $right_type = $right->{"type"};

    # Determine comparison function suffix and C operator
    my str $cmp_suffix = $op;
    my str $cmp_op = "== 0";
    if ($op eq "ne") {
        $cmp_op = "!= 0";
    } elsif ($op eq "lt") {
        $cmp_op = "< 0";
    } elsif ($op eq "gt") {
        $cmp_op = "> 0";
    } elsif ($op eq "le") {
        $cmp_op = "<= 0";
    } elsif ($op eq "ge") {
        $cmp_op = ">= 0";
    }

    # Case 1: Right side is string literal (without embedded NUL) - use strada_str_*_lit
    if ($right_type == NODE_STR_LITERAL() && index($right->{"value"}, "\x00") < 0) {
        if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $left) == 1) {
            emit($cg, "({ StradaValue *__cmp_l = ");
            gen_expression($cg, $left);
            emit($cg, "; int __cmp_r = strada_str_");
            emit($cg, $cmp_suffix);
            emit($cg, "_lit(__cmp_l, ");
            gen_str_literal_c($cg, $right->{"value"});
            emit($cg, "); strada_decref(__cmp_l); strada_new_int(__cmp_r); })");
        } else {
            emit($cg, "strada_new_int(strada_str_");
            emit($cg, $cmp_suffix);
            emit($cg, "_lit(");
            gen_expression($cg, $left);
            emit($cg, ", ");
            gen_str_literal_c($cg, $right->{"value"});
            emit($cg, "))");
        }
        return;
    }

    # Case 2: Left side is string literal (without embedded NUL) - swap and use strada_str_*_lit
    if ($left_type == NODE_STR_LITERAL() && index($left->{"value"}, "\x00") < 0) {
        my str $swapped = $cmp_suffix;
        if ($op eq "lt") {
            $swapped = "gt";
        } elsif ($op eq "gt") {
            $swapped = "lt";
        } elsif ($op eq "le") {
            $swapped = "ge";
        } elsif ($op eq "ge") {
            $swapped = "le";
        }
        # Check if right needs cleanup
        if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $right) == 1) {
            emit($cg, "({ StradaValue *__cmp_r = ");
            gen_expression($cg, $right);
            emit($cg, "; int __cmp_res = strada_str_");
            emit($cg, $swapped);
            emit($cg, "_lit(__cmp_r, ");
            gen_str_literal_c($cg, $left->{"value"});
            emit($cg, "); strada_decref(__cmp_r); strada_new_int(__cmp_res); })");
        } else {
            emit($cg, "strada_new_int(strada_str_");
            emit($cg, $swapped);
            emit($cg, "_lit(");
            gen_expression($cg, $right);
            emit($cg, ", ");
            gen_str_literal_c($cg, $left->{"value"});
            emit($cg, "))");
        }
        return;
    }

    # Case 3: Neither side is a string literal - use standard comparison
    # Must free both the strada_to_str_ss() results AND the StradaValue temporaries
    my int $left_needs_cleanup = needs_temp_cleanup($cg, $left);
    my int $right_needs_cleanup = needs_temp_cleanup($cg, $right);

    if ($cg->{"cleanup_enabled"} == 1 && ($left_needs_cleanup == 1 || $right_needs_cleanup == 1)) {
        emit($cg, "({ StradaValue *__cmp_lv = ");
        gen_expression($cg, $left);
        emit($cg, "; StradaValue *__cmp_rv = ");
        gen_expression($cg, $right);
        emit($cg, "; int __cmp_res = strada_sv_strcmp(__cmp_lv, __cmp_rv) ");
        emit($cg, $cmp_op);
        emit($cg, "; ");
        if ($left_needs_cleanup == 1) {
            emit($cg, "strada_decref(__cmp_lv); ");
        }
        if ($right_needs_cleanup == 1) {
            emit($cg, "strada_decref(__cmp_rv); ");
        }
        emit($cg, "strada_new_int(__cmp_res); })");
    } else {
        emit($cg, "({ int __cmp_res = strada_sv_strcmp(");
        gen_expression($cg, $left);
        emit($cg, ", ");
        gen_expression($cg, $right);
        emit($cg, ") ");
        emit($cg, $cmp_op);
        emit($cg, "; strada_new_int(__cmp_res); })");
    }
}

# Emit a C string literal with proper escaping
func gen_str_literal_c(scalar $cg, str $val) void {
    emit($cg, "\"");
    my int $i = 0;
    my int $len = bytes($val);
    my str $bs = chr(92);
    while ($i < $len) {
        my str $ch = substr_bytes($val, $i, 1);
        my int $byte = ord($ch);
        if ($byte == ord("\\")) {
            emit($cg, $bs);
            emit($cg, $bs);
        } elsif ($byte == ord("\"")) {
            emit($cg, $bs);
            emit($cg, chr(34));
        } elsif ($byte == ord("\n")) {
            emit($cg, $bs);
            emit($cg, "n");
        } elsif ($byte == ord("\r")) {
            emit($cg, $bs);
            emit($cg, "r");
        } elsif ($byte == ord("\t")) {
            emit($cg, $bs);
            emit($cg, "t");
        } elsif ($byte >= ord(" ") && $byte < 127) {
            emit($cg, $ch);
        } else {
            # Non-printable or high-bit byte - emit as \ooo (3-digit
            # octal). Previously used integer division (`$byte / 64`)
            # but Strada's `/` returns float and `my int` does not
            # truncate, so emit($cg, $o1) got a float like 3.53125
            # and emitted "3.531252.640625" etc., wrecking multi-byte
            # UTF-8 in string literals. Decompose by subtraction
            # instead - safe integer math, no division.
            my int $b2 = $byte;
            my int $o1 = 0;
            if ($b2 >= 192) { $o1 = 3; $b2 = $b2 - 192; }
            elsif ($b2 >= 128) { $o1 = 2; $b2 = $b2 - 128; }
            elsif ($b2 >= 64)  { $o1 = 1; $b2 = $b2 - 64; }
            my int $o2 = 0;
            if ($b2 >= 56) { $o2 = 7; $b2 = $b2 - 56; }
            elsif ($b2 >= 48) { $o2 = 6; $b2 = $b2 - 48; }
            elsif ($b2 >= 40) { $o2 = 5; $b2 = $b2 - 40; }
            elsif ($b2 >= 32) { $o2 = 4; $b2 = $b2 - 32; }
            elsif ($b2 >= 24) { $o2 = 3; $b2 = $b2 - 24; }
            elsif ($b2 >= 16) { $o2 = 2; $b2 = $b2 - 16; }
            elsif ($b2 >= 8)  { $o2 = 1; $b2 = $b2 - 8; }
            # $b2 is now 0-7 (the low octal digit)
            emit($cg, $bs);
            emit($cg, chr(48 + $o1));
            emit($cg, chr(48 + $o2));
            emit($cg, chr(48 + $b2));
        }
        $i = $i + 1;
    }
    emit($cg, "\"");
}

# Byte-lexicographic "$a comes before $b". The compiler's OWN source must stay
# parseable by the frozen bootstrap, which doesn't accept `sort { }` blocks or
# the lt/gt/cmp string operators (none appear elsewhere in compiler/*.strada),
# so ordering is done by hand with substr/ord/int compares — all bootstrap-safe.
func ae_str_before(str $a, str $b) int {
    my int $la = length($a);
    my int $lb = length($b);
    my int $n = $la;
    if ($lb < $n) { $n = $lb; }
    my int $i = 0;
    while ($i < $n) {
        my int $ca = ord(substr($a, $i, 1));
        my int $cb = ord(substr($b, $i, 1));
        if ($ca < $cb) { return 1; }
        if ($ca > $cb) { return 0; }
        $i = $i + 1;
    }
    if ($la < $lb) { return 1; }
    return 0;
}

func write_shard_if_changed(str $path, str $content) void {
    my int $same = 0;
    my int $fd = core::open_fd($path, "r");
    if ($fd >= 0) {
        close_fd($fd);
        my str $old = slurp($path);
        if ($old eq $content) {
            $same = 1;
        }
    }
    if ($same == 0) {
        spew($path, $content);
        my str $obj = substr($path, 0, length($path) - 2) . ".o";
        core::unlink($obj);
    }
}

# Get accumulated output as a single string
func get_output(scalar $cg) str {
    # Get the current output from StringBuilder
    my str $final = sb_to_string($cg->{"output_sb"});

    # Check if we used multi-phase generation
    my str $preamble = $cg->{"preamble_content"};
    if (length($preamble) > 0) {
        my str $funcs = $cg->{"funcs_content"};
        my str $anon_decls = $cg->{"anon_func_decls"};
        my str $oop_decls = $cg->{"oop_fwd_decls"};

        # Build auto_externs block once (deterministic insertion sort)
        my str $ae_section = "";
        my scalar $auto_ext = $cg->{"auto_externs"};
        if (defined($auto_ext)) {
            my array @ae_names = keys(%{$auto_ext});
            my int $as_i = 1;
            while ($as_i < size(@ae_names)) {
                my str $as_key = $ae_names[$as_i];
                my int $as_j = $as_i - 1;
                while ($as_j >= 0 && ae_str_before($as_key, $ae_names[$as_j]) == 1) {
                    $ae_names[$as_j + 1] = $ae_names[$as_j];
                    $as_j = $as_j - 1;
                }
                $ae_names[$as_j + 1] = $as_key;
                $as_i = $as_i + 1;
            }
            my str $ae_block = "";
            my int $ae_i = 0;
            while ($ae_i < size(@ae_names)) {
                my str $ae_nm = $ae_names[$ae_i];
                if (!defined($cg->{"functions"}->{$ae_nm})) {
                    $ae_block = $ae_block . "extern StradaValue* " . $ae_nm . "();\n";
                }
                $ae_i = $ae_i + 1;
            }
            if (length($ae_block) > 0) {
                $ae_section = "/* Extern prototypes: cross-module/stdlib calls (separate compilation) */\n" . $ae_block;
            }
        }
        my str $anon_section = "";
        if (length($anon_decls) > 0) {
            $anon_section = "/* Anonymous function forward declarations */\n" . $anon_decls . "\n";
        }

        my str $split_dir = "" . $cg->{"split_dir"};
        if (length($split_dir) > 0) {
            my scalar $fn_codes = $cg->{"split_fn_codes"};
            my scalar $fn_pkgs = $cg->{"split_fn_pkgs"};
            my scalar $fn_c0 = $cg->{"split_fn_c0"};
            my int $fn_n = size($fn_codes);

            my hash %c_pkgs = ();
            my int $fi = 0;
            while ($fi < $fn_n) {
                if (($fn_c0->[$fi] + 0) == 1) {
                    my str $cp = "" . $fn_pkgs->[$fi];
                    if (length($cp) > 0) { $c_pkgs{$cp} = 1; }
                }
                $fi = $fi + 1;
            }

            my int $nbuckets = 24;
            my array @bucket_sbs = ();
            my array @bucket_cnt = ();
            my int $bi = 0;
            while ($bi < $nbuckets) {
                push(@bucket_sbs, sb_new());
                push(@bucket_cnt, 0);
                $bi = $bi + 1;
            }

            my scalar $sb0 = sb_new();
            sb_append($sb0, $preamble);
            if (length($oop_decls) > 0) { sb_append($sb0, $oop_decls); }
            if (length($ae_section) > 0) { sb_append($sb0, $ae_section); }
            if (length($anon_section) > 0) { sb_append($sb0, $anon_section); }

            $fi = 0;
            while ($fi < $fn_n) {
                my str $fcode = "" . $fn_codes->[$fi];
                my str $fpkg = "" . $fn_pkgs->[$fi];
                if (($fn_c0->[$fi] + 0) == 1 || ($c_pkgs{$fpkg} + 0) == 1) {
                    sb_append($sb0, $fcode);
                } else {
                    my int $bidx = djb2_hash_32($fpkg) % $nbuckets;
                    if ($bidx < 0) { $bidx = 0 - $bidx; }
                    sb_append($bucket_sbs[$bidx], $fcode);
                    $bucket_cnt[$bidx] = $bucket_cnt[$bidx] + 1;
                }
                $fi = $fi + 1;
            }
            sb_append($sb0, $funcs);
            sb_append($sb0, $final);

            my str $s0_path = $split_dir . "/shard_00.c";
            write_shard_if_changed($s0_path, sb_to_string($sb0));
            my str $manifest = $s0_path . "\n";

            # Per-shard minimal header: scan C identifiers in each shard's body
            # and emit only the referenced globals, Strada function prototypes,
            # OOP init prototypes, auto_externs, and anon_func prototypes so
            # adding/removing a function only invalidates shards that call it.
            my scalar $fn_pmap = $cg->{"split_fn_proto_map"};
            my scalar $glob_emap = $cg->{"split_glob_ext_map"};
            my scalar $anon_pmap = $cg->{"split_anon_proto_map"};
            my str $base_inc = "" . $cg->{"split_includes"}
                . "extern StradaValue *ARGV;\nextern StradaValue *ARGC;\nextern StradaValue *v_STDIN;\nextern StradaValue *v_STDOUT;\nextern StradaValue *v_STDERR;\nextern StradaValue *__child_status;\n"
                . "extern StradaValue *__program_name;\nextern StradaValue *_;\n"
                . $cg->{"split_common_decls"};
            if ($cg->{"full_profile"} == 1) {
                $base_inc = $base_inc . "extern STRADA_SHARD_HIDDEN int __fp_file_id;\n";
            }

            my hash %ae_map = ();
            if (defined($auto_ext)) {
                my array @ak = keys(%{$auto_ext});
                my int $aki = 0;
                while ($aki < size(@ak)) {
                    my str $anm = $ak[$aki];
                    if (!defined($cg->{"functions"}->{$anm})) {
                        $ae_map{$anm} = "extern StradaValue* " . $anm . "();\n";
                    }
                    $aki = $aki + 1;
                }
            }

            $bi = 0;
            while ($bi < $nbuckets) {
                my int $snum = $bi + 1;
                my str $tag = "" . $snum;
                if ($snum < 10) { $tag = "0" . $snum; }
                my str $spath = $split_dir . "/shard_" . $tag . ".c";
                if ($bucket_cnt[$bi] > 0) {
                    my str $bbody = sb_to_string($bucket_sbs[$bi]);
                    my array @toks = split("[^A-Za-z0-9_]+", $bbody);
                    my hash %seen_id = ();
                    my array @used_globs = ();
                    my array @used_fns = ();
                    my array @used_oops = ();
                    my array @used_aes = ();
                    my array @used_anons = ();
                    my int $ti = 0;
                    my int $tn = size(@toks);
                    while ($ti < $tn) {
                        my str $id = $toks[$ti];
                        if (length($id) > 0 && ($seen_id{$id} + 0) == 0) {
                            $seen_id{$id} = 1;
                            my str $gd = "" . $glob_emap->{$id};
                            if (length($gd) > 0) { push(@used_globs, $id); }
                            my str $fd = "" . $fn_pmap->{$id};
                            if (length($fd) > 0) { push(@used_fns, $id); }
                            if (length($id) > 11 && substr($id, 0, 2) eq "__" && substr($id, length($id) - 9, 9) eq "_oop_init") {
                                push(@used_oops, $id);
                            }
                            my str $ad = "" . $ae_map{$id};
                            if (length($ad) > 0) { push(@used_aes, $id); }
                            my str $nd = "" . $anon_pmap->{$id};
                            if (length($nd) > 0) { push(@used_anons, $id); }
                        }
                        $ti = $ti + 1;
                    }
                    # Sort each small per-shard identifier list for deterministic output
                    my scalar $sh_sb = sb_new();
                    sb_append($sh_sb, $base_inc);
                    my int $si1 = 1;
                    while ($si1 < size(@used_globs)) {
                        my str $kv = $used_globs[$si1];
                        my int $sj = $si1 - 1;
                        while ($sj >= 0 && ae_str_before($kv, $used_globs[$sj]) == 1) {
                            $used_globs[$sj + 1] = $used_globs[$sj];
                            $sj = $sj - 1;
                        }
                        $used_globs[$sj + 1] = $kv;
                        $si1 = $si1 + 1;
                    }
                    $si1 = 0;
                    while ($si1 < size(@used_globs)) {
                        sb_append($sh_sb, $glob_emap->{$used_globs[$si1]});
                        $si1 = $si1 + 1;
                    }

                    $si1 = 1;
                    while ($si1 < size(@used_fns)) {
                        my str $kv = $used_fns[$si1];
                        my int $sj = $si1 - 1;
                        while ($sj >= 0 && ae_str_before($kv, $used_fns[$sj]) == 1) {
                            $used_fns[$sj + 1] = $used_fns[$sj];
                            $sj = $sj - 1;
                        }
                        $used_fns[$sj + 1] = $kv;
                        $si1 = $si1 + 1;
                    }
                    $si1 = 0;
                    while ($si1 < size(@used_fns)) {
                        sb_append($sh_sb, $fn_pmap->{$used_fns[$si1]});
                        $si1 = $si1 + 1;
                    }

                    $si1 = 0;
                    while ($si1 < size(@used_oops)) {
                        sb_append($sh_sb, "void " . $used_oops[$si1] . "(void);\n");
                        $si1 = $si1 + 1;
                    }

                    $si1 = 1;
                    while ($si1 < size(@used_aes)) {
                        my str $kv = $used_aes[$si1];
                        my int $sj = $si1 - 1;
                        while ($sj >= 0 && ae_str_before($kv, $used_aes[$sj]) == 1) {
                            $used_aes[$sj + 1] = $used_aes[$sj];
                            $sj = $sj - 1;
                        }
                        $used_aes[$sj + 1] = $kv;
                        $si1 = $si1 + 1;
                    }
                    $si1 = 0;
                    while ($si1 < size(@used_aes)) {
                        sb_append($sh_sb, $ae_map{$used_aes[$si1]});
                        $si1 = $si1 + 1;
                    }

                    $si1 = 0;
                    while ($si1 < size(@used_anons)) {
                        sb_append($sh_sb, $anon_pmap->{$used_anons[$si1]});
                        $si1 = $si1 + 1;
                    }

                    sb_append($sh_sb, "\n");
                    sb_append($sh_sb, $bbody);
                    write_shard_if_changed($spath, sb_to_string($sh_sb));
                    $manifest = $manifest . $spath . "\n";
                } else {
                    core::unlink($spath);
                    core::unlink($split_dir . "/shard_" . $tag . ".o");
                }
                $bi = $bi + 1;
            }
            spew($split_dir . "/shards.txt", $manifest);
            return "/* Strada split-shard build */\n" . $cg->{"split_markers"};
        }

        # Build result: preamble + oop_decls + auto_externs + anon_decls + funcs + final
        my scalar $out_sb = sb_new();
        sb_append($out_sb, $preamble);
        if (length($oop_decls) > 0) {
            sb_append($out_sb, $oop_decls);
        }
        if (length($ae_section) > 0) {
            sb_append($out_sb, $ae_section);
        }
        if (length($anon_section) > 0) {
            sb_append($out_sb, $anon_section);
        }
        sb_append($out_sb, $funcs);
        sb_append($out_sb, $final);
        return sb_to_string($out_sb);
    }

    return $final;
}

# Set output - for save/restore pattern in anonymous functions
func set_output(scalar $cg, str $text) void {
    sb_clear($cg->{"output_sb"});
    sb_append($cg->{"output_sb"}, $text);
}

func emit_line(scalar $cg, str $text) void {
    emit_indent($cg);
    emit($cg, $text . "\n");
}

func emit_indent(scalar $cg) void {
    my int $i = 0;
    while ($i < $cg->{"indent"}) {
        emit($cg, "    ");
        $i = $i + 1;
    }
}

# Emit stack_pop if stack/recursion tracking is enabled for this function
func emit_stack_pop(scalar $cg) void {
    if ($cg->{"func_tracks_depth"} == 1) {
        emit_indent($cg);
        emit($cg, "strada_stack_pop_il();\n");
    } elsif ($cg->{"func_tracks_depth"} == 2) {
        emit_indent($cg);
        emit($cg, "strada_depth_pop_il();\n");
    }
}

# Emit inline stack_pop (no indent, for use in single-line statements)
func emit_stack_pop_inline(scalar $cg) str {
    if ($cg->{"func_tracks_depth"} == 1) {
        return " strada_stack_pop_il();";
    }
    if ($cg->{"func_tracks_depth"} == 2) {
        return " strada_depth_pop_il();";
    }
    return "";
}

# Scan a statement to check if it contains any try blocks
# Returns 1 if try found, 0 otherwise
func stmt_has_try(scalar $stmt) int {
    # If $stmt is null, $stmt->{"type"} returns 0/undef which won't match any NODE_* constant
    my int $type = $stmt->{"type"} + 0;

    # Direct try statement
    if ($type == NODE_TRY_CATCH()) {
        return 1;
    }

    # Check block statements
    if ($type == NODE_BLOCK()) {
        my scalar $stmts = $stmt->{"statements"};
        my int $count = $stmt->{"statement_count"};
        my int $i = 0;
        while ($i < $count) {
            if (stmt_has_try($stmts->[$i]) == 1) {
                return 1;
            }
            $i = $i + 1;
        }
        return 0;
    }

    # Check if/elsif/else
    if ($type == NODE_IF_STMT()) {
        if (stmt_has_try($stmt->{"then_block"}) == 1) {
            return 1;
        }
        my int $ei = 0;
        my int $ec = $stmt->{"elsif_count"} + 0;
        my scalar $eblocks = $stmt->{"elsif_blocks"};
        while ($ei < $ec) {
            if (stmt_has_try($eblocks->[$ei]) == 1) {
                return 1;
            }
            $ei = $ei + 1;
        }
        if (stmt_has_try($stmt->{"else_block"}) == 1) {
            return 1;
        }
        return 0;
    }

    # Check while/do-while/for loops
    if ($type == NODE_WHILE_STMT() || $type == NODE_DO_WHILE_STMT() || $type == NODE_FOR_STMT()) {
        if (stmt_has_try($stmt->{"body"}) == 1) {
            return 1;
        }
        return 0;
    }

    # Check foreach
    if ($type == NODE_FOREACH_STMT()) {
        if (stmt_has_try($stmt->{"body"}) == 1) {
            return 1;
        }
        return 0;
    }

    # Check switch/case
    if ($type == NODE_SWITCH()) {
        my scalar $blocks = $stmt->{"blocks"};
        my int $count = $stmt->{"case_count"} + 0;
        my int $i = 0;
        while ($i < $count) {
            if (stmt_has_try($blocks->[$i]) == 1) {
                return 1;
            }
            $i = $i + 1;
        }
        if ($stmt->{"has_default"} && stmt_has_try($stmt->{"default_block"}) == 1) {
            return 1;
        }
        return 0;
    }

    return 0;
}

# Recursive check across any AST subtree (including NODE_DO_EXPR / NODE_ANON_FUNC) for try/catch
func ast_any_try(scalar $n) int {
    my str $rt = reftype($n);
    if ($rt eq "ARRAY") {
        my int $len = scalar(@{$n});
        my int $i = 0;
        while ($i < $len) {
            if (ast_any_try($n->[$i]) == 1) { return 1; }
            $i = $i + 1;
        }
        return 0;
    }
    if ($rt ne "HASH") { return 0; }
    if (($n->{"type"} + 0) == NODE_TRY_CATCH()) { return 1; }
    my scalar $ks = keys(%{$n});
    my int $kn = scalar(@{$ks});
    my int $k = 0;
    while ($k < $kn) {
        my scalar $v = $n->{$ks->[$k]};
        my str $vt = reftype($v);
        if ($vt eq "HASH" || $vt eq "ARRAY") {
            if (ast_any_try($v) == 1) { return 1; }
        }
        $k = $k + 1;
    }
    return 0;
}

# Check if a statement/subtree contains an inline __C__ block (in this function)
func stmt_has_c_block(scalar $n) int {
    my str $rt = reftype($n);
    if ($rt eq "ARRAY") {
        my int $len = scalar(@{$n});
        my int $i = 0;
        while ($i < $len) {
            if (stmt_has_c_block($n->[$i]) == 1) { return 1; }
            $i = $i + 1;
        }
        return 0;
    }
    if ($rt ne "HASH") { return 0; }
    if (($n->{"type"} + 0) == NODE_C_BLOCK()) { return 1; }
    my scalar $ks = keys(%{$n});
    my int $kn = scalar(@{$ks});
    my int $k = 0;
    while ($k < $kn) {
        my scalar $v = $n->{$ks->[$k]};
        my str $vt = reftype($v);
        if ($vt eq "HASH" || $vt eq "ARRAY") {
            if (stmt_has_c_block($v) == 1) { return 1; }
        }
        $k = $k + 1;
    }
    return 0;
}

func ast_collect_regex_var_refs(str $pat, scalar $out_hash) void {
    my int $len = length($pat);
    my int $i = 0;
    while ($i < $len) {
        my str $ch = substr($pat, $i, 1);
        if ($ch eq "\\") {
            $i = $i + 2;
        } elsif ($ch eq "$" && $i + 1 < $len) {
            my str $nch = substr($pat, $i + 1, 1);
            if ($nch eq "{") {
                my int $close = index($pat, "}", $i + 2);
                if ($close > $i + 2) {
                    my str $nm = substr($pat, $i + 2, $close - $i - 2);
                    $out_hash->{escape_c_keyword($nm)} = 1;
                    $i = $close + 1;
                    next;
                }
            } elsif ($nch eq "_" || ($nch ge "a" && $nch le "z") || ($nch ge "A" && $nch le "Z")) {
                my int $j = $i + 2;
                while ($j < $len) {
                    my str $jc = substr($pat, $j, 1);
                    if ($jc eq "_" || ($jc ge "a" && $jc le "z") || ($jc ge "A" && $jc le "Z") || ($jc ge "0" && $jc le "9")) {
                        $j = $j + 1;
                    } else {
                        last;
                    }
                }
                $out_hash->{escape_c_keyword(substr($pat, $i + 1, $j - $i - 1))} = 1;
                $i = $j;
                next;
            }
            $i = $i + 1;
        } else {
            $i = $i + 1;
        }
    }
}

func ast_collect_anon_var_refs(scalar $n, scalar $out_hash, int $inside_anon) void {
    my str $rt = reftype($n);
    if ($rt eq "ARRAY") {
        my int $len = scalar(@{$n});
        my int $i = 0;
        while ($i < $len) {
            ast_collect_anon_var_refs($n->[$i], $out_hash, $inside_anon);
            $i = $i + 1;
        }
        return;
    }
    if ($rt ne "HASH") { return; }
    my int $type = $n->{"type"} + 0;
    if ($type == NODE_ANON_FUNC()) {
        ast_collect_anon_var_refs($n->{"body"}, $out_hash, 1);
        return;
    }
    if ($inside_anon == 1) {
        if ($type == NODE_VARIABLE() && ("" . $n->{"sigil"}) ne "@" && ("" . $n->{"sigil"}) ne "%") {
            my str $vn = "" . $n->{"name"};
            if (length($vn) > 0 && index($vn, "::") < 0) {
                $out_hash->{escape_c_keyword($vn)} = 1;
            }
        } elsif ($type == NODE_READLINE()) {
            my str $rlvn = "" . $n->{"varname"};
            if (length($rlvn) > 0 && index($rlvn, "::") < 0) {
                $out_hash->{escape_c_keyword($rlvn)} = 1;
            }
        } elsif ($type == NODE_REGEX_MATCH() || $type == NODE_REGEX_SUBST()) {
            if (defined($n->{"pattern"})) {
                ast_collect_regex_var_refs("" . $n->{"pattern"}, $out_hash);
            }
            if ($type == NODE_REGEX_SUBST() && defined($n->{"replacement"})) {
                ast_collect_regex_var_refs("" . $n->{"replacement"}, $out_hash);
            }
        }
    }
    my scalar $ks = keys(%{$n});
    my int $kn = scalar(@{$ks});
    my int $k = 0;
    while ($k < $kn) {
        my scalar $v = $n->{$ks->[$k]};
        my str $vt = reftype($v);
        if ($vt eq "HASH" || $vt eq "ARRAY") {
            ast_collect_anon_var_refs($v, $out_hash, $inside_anon);
        }
        $k = $k + 1;
    }
}

# Check if a function body contains any try blocks
func func_body_has_try(scalar $body) int {
    # If $body is null, statement_count will be 0/undef, loop won't run
    my scalar $stmts = $body->{"statements"};
    my int $count = $body->{"statement_count"} + 0;
    my int $i = 0;
    while ($i < $count) {
        if (stmt_has_try($stmts->[$i]) == 1) {
            return 1;
        }
        $i = $i + 1;
    }
    return 0;
}

# Recursive check: does this statement (or any nested statement) contain
# a `local` declaration? Used by gen_function to decide whether to emit
# __local_saved_depth at function-top scope (so it stays visible across
# nested if/try/switch/loop blocks).
# Does anything under this AST node write to the scalar variable $name
# (assignment, compound assignment, =~ s///, tr///, ++/--, chomp/chop)?
# foreach uses it: its loop variable borrows the array element, so a loop
# that writes to it must own (incref) it instead.
func node_writes_var(scalar $n, str $name) int {
    my str $rt = reftype($n);
    if ($rt eq "ARRAY") {
        my int $len = scalar(@{$n});
        my int $i = 0;
        while ($i < $len) {
            if (node_writes_var($n->[$i], $name) == 1) { return 1; }
            $i = $i + 1;
        }
        return 0;
    }
    if ($rt ne "HASH") { return 0; }
    my int $type = $n->{"type"} + 0;
    my scalar $tgt;
    if ($type == NODE_ASSIGN() || $type == NODE_REGEX_SUBST() || $type == NODE_TR() || $type == NODE_REF()) {
        $tgt = $n->{"target"};
        if ($type == NODE_ASSIGN() && defined($tgt) && reftype($tgt) eq "HASH" && ($tgt->{"type"} + 0) == NODE_CALL()) {
            if (("" . $tgt->{"name"}) eq "substr") {
                my scalar $sa = $tgt->{"args"};
                if (defined($sa) && reftype($sa) eq "ARRAY" && scalar(@{$sa}) > 0) {
                    $tgt = $sa->[0];
                }
            }
        }
    }
    if ($type == NODE_INCREMENT()) { $tgt = $n->{"operand"}; }
    if ($type == NODE_DESTRUCTURE() && ($n->{"is_decl"} + 0) == 0) {
        my scalar $dvars = $n->{"vars"};
        my int $dvc = $n->{"var_count"} + 0;
        my int $di = 0;
        while ($di < $dvc) {
            my scalar $dv = $dvars->[$di];
            if (defined($dv) && reftype($dv) eq "HASH" && ("" . $dv->{"name"}) eq $name) { return 1; }
            $di = $di + 1;
        }
    }
    if ($type == NODE_CALL()) {
        my str $fn = "" . $n->{"name"};
        if ($fn eq "chomp" || $fn eq "chop") {
            my scalar $cargs = $n->{"args"};
            if (defined($cargs) && reftype($cargs) eq "ARRAY" && scalar(@{$cargs}) > 0) { $tgt = $cargs->[0]; }
        } elsif ($fn eq "substr") {
            my scalar $sargs = $n->{"args"};
            if (defined($sargs) && reftype($sargs) eq "ARRAY" && scalar(@{$sargs}) >= 4) { $tgt = $sargs->[0]; }
        }
    }
    if (defined($tgt) && reftype($tgt) eq "HASH") {
        if (($tgt->{"type"} + 0) == NODE_VARIABLE() && ("" . $tgt->{"name"}) eq $name) { return 1; }
    }
    my scalar $ks = keys(%{$n});
    my int $kn = scalar(@{$ks});
    my int $k = 0;
    while ($k < $kn) {
        my scalar $v = $n->{$ks->[$k]};
        my str $vt = reftype($v);
        if ($vt eq "HASH" || $vt eq "ARRAY") {
            if (node_writes_var($v, $name) == 1) { return 1; }
        }
        $k = $k + 1;
    }
    return 0;
}

func stmt_has_local(scalar $stmt) int {
    if (!$stmt || reftype($stmt) ne "HASH") { return 0; }
    my int $type = $stmt->{"type"} + 0;
    if ($type == NODE_LOCAL_DECL()) {
        return 1;
    }
    if ($type == NODE_ANON_FUNC()) {
        return 0;
    }
    if ($type == NODE_BLOCK() || $type == NODE_DO_EXPR()) {
        my scalar $stmts = $stmt->{"statements"};
        my int $count = $stmt->{"statement_count"} + 0;
        my int $i = 0;
        while ($i < $count) {
            if (stmt_has_local($stmts->[$i]) == 1) { return 1; }
            $i = $i + 1;
        }
        return 0;
    }
    if ($type == NODE_EXPR_STMT()) {
        return stmt_has_local($stmt->{"expr"});
    }
    if ($type == NODE_IF_STMT()) {
        if (stmt_has_local($stmt->{"then_block"}) == 1) { return 1; }
        if (stmt_has_local($stmt->{"else_block"}) == 1) { return 1; }
        my scalar $elsif_blocks = $stmt->{"elsif_blocks"};
        my int $elsif_count = $stmt->{"elsif_count"} + 0;
        my int $ei = 0;
        while ($ei < $elsif_count) {
            if (stmt_has_local($elsif_blocks->[$ei]) == 1) { return 1; }
            $ei = $ei + 1;
        }
        return 0;
    }
    if ($type == NODE_WHILE_STMT() || $type == NODE_DO_WHILE_STMT() || $type == NODE_FOR_STMT() || $type == NODE_FOREACH_STMT()) {
        return stmt_has_local($stmt->{"body"});
    }
    if ($type == NODE_TRY_CATCH()) {
        if (stmt_has_local($stmt->{"try_block"}) == 1) { return 1; }
        my scalar $cclauses = $stmt->{"catch_clauses"};
        my int $ccnt = $stmt->{"catch_count"} + 0;
        my int $ci = 0;
        while ($ci < $ccnt) {
            if ($cclauses && $cclauses->[$ci] && stmt_has_local($cclauses->[$ci]->{"catch_block"}) == 1) { return 1; }
            $ci = $ci + 1;
        }
        if (stmt_has_local($stmt->{"finally_block"}) == 1) { return 1; }
        return 0;
    }
    if ($type == NODE_SWITCH()) {
        my scalar $blocks = $stmt->{"blocks"};
        my int $count = $stmt->{"case_count"} + 0;
        my int $i = 0;
        while ($i < $count) {
            if ($blocks && stmt_has_local($blocks->[$i]) == 1) { return 1; }
            $i = $i + 1;
        }
        if ($stmt->{"has_default"} && stmt_has_local($stmt->{"default_block"}) == 1) { return 1; }
        return 0;
    }
    return 0;
}

func func_body_has_local(scalar $body) int {
    my scalar $stmts = $body->{"statements"};
    my int $count = $body->{"statement_count"} + 0;
    my int $i = 0;
    while ($i < $count) {
        if (stmt_has_local($stmts->[$i]) == 1) { return 1; }
        $i = $i + 1;
    }
    return 0;
}

# Returns 1 if anything inside AST subtree $n invokes a function, method,
# closure, or /e substitution (so unbounded recursion can only occur through
# functions where stmt_has_call(body) == 1; leaf functions pay zero cost).
func stmt_has_call(scalar $n) int {
    my str $rt = reftype($n);
    if ($rt eq "ARRAY") {
        my int $len = scalar(@{$n});
        my int $i = 0;
        while ($i < $len) {
            if (stmt_has_call($n->[$i]) == 1) { return 1; }
            $i = $i + 1;
        }
        return 0;
    }
    if ($rt ne "HASH") { return 0; }
    my int $type = $n->{"type"} + 0;
    if ($type == NODE_CALL() || $type == NODE_METHOD_CALL() ||
        $type == NODE_DYN_METHOD_CALL() || $type == NODE_CLOSURE_CALL() ||
        $type == NODE_SUPER_CALL()) {
        return 1;
    }
    if ($type == NODE_REGEX_SUBST() && index("" . $n->{"flags"}, "e") >= 0) {
        return 1;
    }
    my scalar $ks = keys(%{$n});
    my int $kn = scalar(@{$ks});
    my int $k = 0;
    while ($k < $kn) {
        my scalar $v = $n->{$ks->[$k]};
        my str $vt = reftype($v);
        if ($vt eq "HASH" || $vt eq "ARRAY") {
            if (stmt_has_call($v) == 1) { return 1; }
        }
        $k = $k + 1;
    }
    return 0;
}

# Resolve a call's function-info entry using direct name, current_fn_package prefix, and qw_imports fallback.
func resolve_callee_func_info(scalar $cg, str $raw_name) scalar {
    my scalar $funcs = $cg->{"functions"};
    if (!$funcs) { return 0; }
    my str $cname = sanitize_name($raw_name);
    my scalar $finfo = $funcs->{$cname};
    if ($finfo) { return $finfo; }
    if (index($raw_name, "::") < 0) {
        my str $fn_pkg = "" . $cg->{"current_fn_package"};
        if (length($fn_pkg) > 0 && $fn_pkg ne "main") {
            my str $prefixed = sanitize_name($fn_pkg) . "_" . $cname;
            my scalar $pfinfo = $funcs->{$prefixed};
            if ($pfinfo) { return $pfinfo; }
        }
        if (defined($cg->{"qw_imports"})) {
            my str $qpkg = $fn_pkg;
            if (length($qpkg) == 0) { $qpkg = "main"; }
            my str $qtarget = "" . $cg->{"qw_imports"}->{$qpkg . "::" . $raw_name};
            if (length($qtarget) > 0) {
                my scalar $qfinfo = $funcs->{sanitize_name($qtarget)};
                if ($qfinfo) { return $qfinfo; }
            }
        }
    }
    return 0;
}

# Resolve a native struct field on $obj_expr->$field_name; returns field info hash or 0.
func resolve_struct_field(scalar $cg, scalar $obj_expr, str $field_name) scalar {
    if ($cg->{"struct_count"} == 0) {
        return 0;
    }
    my scalar $structs = $cg->{"structs"};
    my str $sname = "";
    my int $ot = $obj_expr->{"type"} + 0;
    if ($ot == NODE_VARIABLE()) {
        my str $vname = escape_c_keyword($obj_expr->{"name"});
        $sname = "" . $cg->{"struct_vars"}->{$vname};
    } elsif ($ot == NODE_CALL()) {
        my scalar $finfo = resolve_callee_func_info($cg, "" . $obj_expr->{"name"});
        if ($finfo) {
            $sname = "" . $finfo->{"return_struct_name"};
        }
    }
    if (length($sname) > 0 && defined($structs->{$sname})) {
        my scalar $fmap = $structs->{$sname}->{"field_map"};
        if (defined($fmap->{$field_name})) {
            return $fmap->{$field_name};
        }
    }
    # Fallback when $obj_expr is untyped scalar: if exactly one declared struct has $field_name
    my scalar $snames = $cg->{"struct_names"};
    my int $sc = $cg->{"struct_count"};
    my scalar $found = 0;
    my int $matches = 0;
    my int $si = 0;
    while ($si < $sc) {
        my scalar $st = $structs->{$snames->[$si]};
        my scalar $fm = $st->{"field_map"};
        if (defined($fm->{$field_name})) {
            $found = $fm->{$field_name};
            $matches = $matches + 1;
        }
        $si = $si + 1;
    }
    if ($matches == 1) {
        return $found;
    }
    return 0;
}

# Emit StradaValue* declaration with volatile qualifier when function contains try blocks
# This is needed because setjmp/longjmp can corrupt non-volatile local variables
# that were modified after setjmp was called. Using volatile ensures the variable
# values survive longjmp in exception handling.
# IMPORTANT: Use "StradaValue * volatile" (volatile pointer) not "volatile StradaValue *"
# (pointer to volatile). The pointer value needs to survive longjmp.
# We check func_has_try (set before generating the function) to determine if volatile is needed.
func emit_sv_ptr_decl(scalar $cg, str $name) void {
    my int $has_try = $cg->{"func_has_try"} + 0;
    if ($has_try > 0) {
        emit($cg, "StradaValue * volatile " . $name);
    } else {
        emit($cg, "StradaValue *" . $name);
    }
}

func indent(scalar $cg) void {
    $cg->{"indent"} = $cg->{"indent"} + 1;
}

func dedent(scalar $cg) void {
    $cg->{"indent"} = $cg->{"indent"} - 1;
}

# Check if name is in comma-separated string (workaround for bootstrap limitation)
func str_contains_name(str $list, str $name) int {
    my str $search = "," . $name . ",";
    my str $padded = "," . $list . ",";
    my int $pos = index($padded, $search);
    if ($pos >= 0) { return 1; }
    return 0;
}

# Get index of name in comma-separated capture string
func get_capture_index(str $list, str $name) int {
    if ($list eq "") { return -1; }
    my int $idx = 0;
    my int $start = 0;
    my int $len = length($list);
    my int $i = 0;
    while ($i <= $len) {
        my str $ch = "";
        if ($i < $len) { $ch = substr($list, $i, 1); }
        if ($ch eq "," || $i == $len) {
            my str $part = substr($list, $start, $i - $start);
            if ($part eq $name) { return $idx; }
            $idx = $idx + 1;
            $start = $i + 1;
        }
        $i = $i + 1;
    }
    return -1;
}

# 1 when constructing class $c_pkg (C-safe name) with these literal-keyed
# arguments would leave a (required) attribute, its own or an inherited one,
# unset.
func inline_ctor_missing_required(scalar $cg, str $c_pkg, scalar $args, int $arg_count) int {
    my scalar $rq_attrs = $cg->{"has_attrs"};
    my int $rq_n = 0 + $cg->{"has_attr_count"};
    my str $rq_pkg = strada_pkg_for_c($cg, $c_pkg);
    my int $rq_i = 0;
    while ($rq_i < $rq_n) {
        my scalar $rq_attr = $rq_attrs->[$rq_i];
        if ($rq_attr->{"required"} == 1) {
            my str $rq_owner = $rq_attr->{"package"};
            if ($rq_owner eq $rq_pkg || pkg_c_safe($rq_owner) eq $c_pkg || is_subclass_compile_time($cg, $rq_pkg, $rq_owner, 0) == 1) {
                my str $rq_name = $rq_attr->{"name"};
                my int $rq_found = 0;
                my int $rq_k = 0;
                while ($rq_k < $arg_count) {
                    my scalar $rq_key = $args->[$rq_k];
                    if ($rq_key->{"type"} == NODE_STR_LITERAL()) {
                        my str $rq_kv = $rq_key->{"value"};
                        if ($rq_kv eq $rq_name) { $rq_found = 1; }
                    }
                    $rq_k = $rq_k + 2;
                }
                if ($rq_found == 0) { return 1; }
            }
        }
        $rq_i = $rq_i + 1;
    }
    return 0;
}

# 1 when $name is in a builtin namespace (core::/sys::, math::, async::, c::,
# thread::, utf8::) but is neither a function the program defines or imports
# nor one of the runtime entry points that are called by their plain C name.
func unknown_builtin_name(scalar $cg, str $name, str $c_name) int {
    my int $ub_sep = index($name, "::");
    if ($ub_sep < 0) { return 0; }
    my str $ub_ns = substr($name, 0, $ub_sep);
    if ($ub_ns ne "sys" && $ub_ns ne "core" && $ub_ns ne "math" && $ub_ns ne "async" &&
        $ub_ns ne "c" && $ub_ns ne "thread" && $ub_ns ne "utf8") {
        return 0;
    }
    # A program may define its own package with one of these names.
    my scalar $ub_all = $cg->{"all_func_names"};
    if ($ub_all) {
        my str $ub_hit = "" . $ub_all->{$c_name};
        if (length($ub_hit) > 0) { return 0; }
    }
    # Runtime functions spelled sys_NAME in C (aliases used by bootstrap output).
    if ($c_name eq "sys_file_mtime" || $c_name eq "sys_system" || $c_name eq "sys_qx" ||
        $c_name eq "sys_unlink" || $c_name eq "sys_realpath" || $c_name eq "sys_mkdir") {
        return 0;
    }
    return 1;
}

# ---- Lexical shadowing of `our` variables ---------------------------------
# our_vars maps a variable's C name to its global-registry key, and every
# variable reference consults it first. It is keyed by NAME only, so a function
# parameter or `my` variable with the same name as an `our` variable was read
# and written as the global: `our str $greeting; func greet(str $greeting)`
# ignored its argument. A declaration that shadows one blanks the entry (an
# empty key means "not an our variable") and records it; the enclosing block or
# function restores it on the way out.
func our_shadow_mark(scalar $cg) int {
    return 0 + $cg->{"our_shadow_n"};
}

func our_shadow_begin(scalar $cg, str $c_name) void {
    my scalar $os_vars = $cg->{"our_vars"};
    my str $os_key = "" . $os_vars->{$c_name};
    if (length($os_key) == 0) { return; }
    my int $os_n = 0 + $cg->{"our_shadow_n"};
    $cg->{"our_shadow_names"}->[$os_n] = $c_name;
    $cg->{"our_shadow_keys"}->[$os_n] = $os_key;
    $cg->{"our_shadow_n"} = $os_n + 1;
    $os_vars->{$c_name} = "";
}

func our_shadow_restore(scalar $cg, int $mark) void {
    my int $os_n = 0 + $cg->{"our_shadow_n"};
    my scalar $os_vars = $cg->{"our_vars"};
    while ($os_n > $mark) {
        $os_n = $os_n - 1;
        my str $os_name = $cg->{"our_shadow_names"}->[$os_n];
        $os_vars->{$os_name} = $cg->{"our_shadow_keys"}->[$os_n];
    }
    $cg->{"our_shadow_n"} = $os_n;
}

# The C expression that names scalar variable $var_name at the current point
# of code generation. Outside an anonymous function that is just its C name.
# Inside one it is the C name for a parameter or local, and the capture slot
# `(*__captures[N])` for anything else -- registering the capture on first use.
#
# EVERY codegen path that emits a variable's C name by hand (rather than via
# gen_expression on a NODE_VARIABLE) must go through this. A path that emits
# the bare name compiles fine in ordinary functions and then fails inside a
# closure with "'name' undeclared", because the closure never captured it:
# that was the bug for /$var/ patterns, $var++ on int variables and chomp($var).
func scalar_var_c_ref(scalar $cg, str $var_name, str $c_var_name) str {
    if (!$cg->{"in_anon_func"}) {
        if (($cg->{"active_boxed_vars"}->{$c_var_name} + 0) == 1) {
            return "(*__cell_" . $c_var_name . ")";
        }
        return $c_var_name;
    }
    if (str_contains_name($cg->{"anon_param_str"}, $var_name)) {
        if (($cg->{"active_boxed_vars"}->{$c_var_name} + 0) == 1) {
            return "(*__cell_" . $c_var_name . ")";
        }
        return $c_var_name;
    }
    if (str_contains_name($cg->{"anon_local_str"}, $var_name)) {
        if (($cg->{"active_boxed_vars"}->{$c_var_name} + 0) == 1) {
            return "(*__cell_" . $c_var_name . ")";
        }
        return $c_var_name;
    }
    my str $capture_str = $cg->{"anon_capture_str"};
    my int $idx = get_capture_index($capture_str, $var_name);
    if ($idx < 0) {
        if ($capture_str eq "") {
            $cg->{"anon_capture_str"} = $var_name;
        } else {
            $cg->{"anon_capture_str"} = $capture_str . "," . $var_name;
        }
        $idx = $cg->{"anon_capture_count"};
        $cg->{"anon_capture_count"} = $idx + 1;
    }
    return "(*__captures[" . $idx . "])";
}

# 1 when a regex pattern or s/// replacement mentions a variable: an unescaped
# `$` followed by a letter or underscore (or braced `${name}`).
func regex_pattern_has_interp(str $pattern) int {
    my int $len = length($pattern);
    my int $i = 0;
    while ($i < $len) {
        my str $ch = substr($pattern, $i, 1);
        if ($ch eq "\\") {
            $i = $i + 2;
        } elsif ($ch eq "$" && $i + 1 < $len) {
            my str $nch = substr($pattern, $i + 1, 1);
            if ($nch eq "_" || ($nch ge "a" && $nch le "z") || ($nch ge "A" && $nch le "Z")) {
                return 1;
            }
            # ${name}
            if ($nch eq "{" && $i + 2 < $len) {
                my int $close = index($pattern, "}", $i + 2);
                if ($close > $i + 2) {
                    my str $bch0 = substr($pattern, $i + 2, 1);
                    if ($bch0 eq "_" || ($bch0 ge "a" && $bch0 le "z") || ($bch0 ge "A" && $bch0 le "Z")) {
                        my int $bi = $i + 3;
                        my int $b_ok = 1;
                        while ($bi < $close) {
                            my str $bch = substr($pattern, $bi, 1);
                            if (!($bch eq "_" || ($bch ge "a" && $bch le "z") || ($bch ge "A" && $bch le "Z") || ($bch ge "0" && $bch le "9"))) {
                                $b_ok = 0;
                            }
                            $bi = $bi + 1;
                        }
                        if ($b_ok == 1) {
                            return 1;
                        }
                    }
                }
            }
            $i = $i + 1;
        } else {
            $i = $i + 1;
        }
    }
    return 0;
}

# Emit `char *__subst_pat = <the interpolated pattern as a C string>; ` for a
# substitution whose pattern mentions variables. The caller passes __subst_pat
# as the pattern and releases it with strada_cstr_free.
func gen_subst_pattern_prelude(scalar $cg, str $pattern) void {
    emit($cg, "StradaValue *__subst_psv = ");
    gen_regex_interpolated_pattern($cg, $pattern);
    emit($cg, "; char *__subst_pat = strada_to_str_ss(__subst_psv); strada_decref(__subst_psv); ");
}

# Generate code for regex pattern / replacement with variable interpolation.
# Always yields an OWNED StradaValue* that the caller must strada_decref.
func gen_regex_interpolated_pattern(scalar $cg, str $pattern) void {
    my array @parts = ();
    my int $num_parts = 0;
    my int $len = length($pattern);
    my int $i = 0;
    my str $literal = "";

    while ($i < $len) {
        my str $ch = substr($pattern, $i, 1);

        if ($ch eq "\\" && $i + 1 < $len) {
            $literal = $literal . "\\" . substr($pattern, $i + 1, 1);
            $i = $i + 2;
        } elsif ($ch eq "$") {
            # Save any accumulated literal
            if (length($literal) > 0) {
                my hash %part = ();
                $part{"type"} = "lit";
                $part{"value"} = $literal;
                push(@parts, \%part);
                $num_parts = $num_parts + 1;
                $literal = "";
            }

            # Parse variable name: $name, or braced ${name}. First char MUST be
            # [A-Za-z_] so $1..$9 backreferences and $ anchors remain literal.
            $i = $i + 1;
            my str $varname = "";
            if ($i < $len && substr($pattern, $i, 1) eq "{") {
                my int $close = index($pattern, "}", $i);
                if ($close > $i + 1) {
                    my str $braced = substr($pattern, $i + 1, $close - $i - 1);
                    my str $bfirst = substr($braced, 0, 1);
                    my int $b_ok = 0;
                    if ($bfirst eq "_" || ($bfirst ge "a" && $bfirst le "z") || ($bfirst ge "A" && $bfirst le "Z")) {
                        $b_ok = 1;
                        my int $bi = 1;
                        while ($bi < length($braced)) {
                            my str $bch = substr($braced, $bi, 1);
                            if (!($bch eq "_" || ($bch ge "a" && $bch le "z") || ($bch ge "A" && $bch le "Z") || ($bch ge "0" && $bch le "9"))) {
                                $b_ok = 0;
                            }
                            $bi = $bi + 1;
                        }
                    }
                    if ($b_ok == 1) {
                        $varname = $braced;
                        $i = $close + 1;
                    }
                }
            }
            if (length($varname) == 0 && $i < $len) {
                my str $vch0 = substr($pattern, $i, 1);
                if ($vch0 eq "_" || ($vch0 ge "a" && $vch0 le "z") || ($vch0 ge "A" && $vch0 le "Z")) {
                    while ($i < $len) {
                        my str $vch = substr($pattern, $i, 1);
                        if ($vch eq "_" || ($vch ge "a" && $vch le "z") || ($vch ge "A" && $vch le "Z") || ($vch ge "0" && $vch le "9")) {
                            $varname = $varname . $vch;
                            $i = $i + 1;
                        } else {
                            last;
                        }
                    }
                }
            }

            if (length($varname) > 0) {
                my hash %part = ();
                $part{"type"} = "var";
                $part{"value"} = $varname;
                push(@parts, \%part);
                $num_parts = $num_parts + 1;
            } else {
                # Not a variable - preserve $ as literal ($ anchor or $1 capture)
                $literal = $literal . "$";
            }
        } else {
            $literal = $literal . $ch;
            $i = $i + 1;
        }
    }

    # Save any remaining literal
    if (length($literal) > 0) {
        my hash %part = ();
        $part{"type"} = "lit";
        $part{"value"} = $literal;
        push(@parts, \%part);
        $num_parts = $num_parts + 1;
    }

    # Generate concatenation code
    if ($num_parts == 0) {
        emit($cg, "strada_new_str(\"\")");
        return;
    }
    if ($num_parts == 1) {
        my scalar $p = $parts[0];
        if ($p->{"type"} eq "var") {
            my str $vn = $p->{"value"};
            my str $cvn = escape_c_keyword($vn);
            my str $our_k = "" . $cg->{"our_vars"}->{$cvn};
            if (length($our_k) > 0) {
                emit($cg, "strada_global_get(strada_new_str(\"" . $our_k . "\"))");
            } else {
                my str $cref = scalar_var_c_ref($cg, $vn, $cvn);
                emit($cg, "({ StradaValue *__rv = " . $cref . "; strada_incref(__rv); __rv; })");
            }
        } else {
            # STRADA_NEW_STR_LIT preserves embedded NUL bytes (sizeof(LIT)-1)
            emit($cg, "STRADA_NEW_STR_LIT(\"");
            emit_escaped_string($cg, $p->{"value"});
            emit($cg, "\")");
        }
        return;
    }

    # Multiple parts - build with sequential concat (no leaked intermediates)
    emit($cg, "({ ");
    my int $pi = 0;
    while ($pi < $num_parts) {
        my scalar $p = $parts[$pi];
        emit($cg, "StradaValue *__rp" . $pi . " = ");
        if ($p->{"type"} eq "var") {
            my str $vn = $p->{"value"};
            my str $cvn = escape_c_keyword($vn);
            my str $our_k = "" . $cg->{"our_vars"}->{$cvn};
            if (length($our_k) > 0) {
                emit($cg, "strada_global_get(strada_new_str(\"" . $our_k . "\"))");
                $p->{"owned"} = 1;
            } else {
                emit($cg, scalar_var_c_ref($cg, $vn, $cvn));
                $p->{"owned"} = 0;
            }
        } else {
            emit($cg, "STRADA_NEW_STR_LIT(\"");
            emit_escaped_string($cg, $p->{"value"});
            emit($cg, "\")");
            $p->{"owned"} = 1;
        }
        emit($cg, "; ");
        $pi = $pi + 1;
    }
    # Build chain: first concat, then concat_inplace for rest (frees intermediates)
    emit($cg, "StradaValue *__rr = strada_concat_sv(__rp0, __rp1); ");
    $pi = 2;
    while ($pi < $num_parts) {
        emit($cg, "__rr = strada_concat_inplace(__rr, __rp" . $pi . "); ");
        $pi = $pi + 1;
    }
    # Free owned part temps (literals and our_vars globals)
    $pi = 0;
    while ($pi < $num_parts) {
        my scalar $p = $parts[$pi];
        if ($p->{"owned"} == 1) {
            emit($cg, "strada_decref(__rp" . $pi . "); ");
        }
        $pi = $pi + 1;
    }
    emit($cg, "__rr; })");
}

# Helper to emit an escaped C string
# A character for a C string literal: control characters (CR, ESC, ...)
# become 3-digit octal escapes, anything else is returned as is.
func c_ctrl_escape(str $ch) str {
    if (length($ch) != 1) { return $ch; }
    my int $code = ord($ch);
    if ($code >= 32 && $code != 127) { return $ch; }
    my int $o2 = $code / 64;
    my int $o1 = ($code / 8) % 8;
    my int $o0 = $code % 8;
    return "\\" . chr(48 + $o2) . chr(48 + $o1) . chr(48 + $o0);
}

func c_str_lit(str $s) str {
    my scalar $sb = sb_new();
    sb_append($sb, "\"");
    my int $i = 0;
    my int $len = bytes($s);
    while ($i < $len) {
        my int $code = char_at($s, $i);
        if ($code == ord("\\")) {
            sb_append($sb, "\\\\");
        } elsif ($code == ord("\"")) {
            sb_append($sb, "\\\"");
        } elsif ($code == ord("\n")) {
            sb_append($sb, "\\n");
        } elsif ($code == ord("\t")) {
            sb_append($sb, "\\t");
        } elsif ($code == ord("\r")) {
            sb_append($sb, "\\r");
        } elsif ($code == 0) {
            sb_append($sb, "\\000");
        } elsif ($code < ord(" ") || $code == 127) {
            my int $o2 = $code / 64;
            my int $o1 = ($code / 8) % 8;
            my int $o0 = $code % 8;
            sb_append($sb, "\\" . chr(48 + $o2) . chr(48 + $o1) . chr(48 + $o0));
        } else {
            sb_append($sb, substr_bytes($s, $i, 1));
        }
        $i = $i + 1;
    }
    sb_append($sb, "\"");
    return sb_to_string($sb);
}

func emit_escaped_string(scalar $cg, str $s) void {
    my int $i = 0;
    my int $len = bytes($s);
    while ($i < $len) {
        my int $code = char_at($s, $i);
        if ($code == ord("\\")) {
            emit($cg, "\\\\");
        } elsif ($code == ord("\"")) {
            emit($cg, "\\\"");
        } elsif ($code == ord("\n")) {
            emit($cg, "\\n");
        } elsif ($code == ord("\t")) {
            emit($cg, "\\t");
        } elsif ($code == ord("\r")) {
            emit($cg, "\\r");
        } elsif ($code == 0) {
            # 3-digit octal so a following digit isn't merged into the escape
            emit($cg, "\\000");
        } elsif ($code < ord(" ") || $code == 127) {
            my int $o2 = $code / 64;
            my int $o1 = ($code / 8) % 8;
            my int $o0 = $code % 8;
            emit($cg, "\\" . chr(48 + $o2) . chr(48 + $o1) . chr(48 + $o0));
        } else {
            emit($cg, substr_bytes($s, $i, 1));
        }
        $i = $i + 1;
    }
}

# ============================================================
# Type Conversion
# ============================================================

func type_to_c(int $type) str {
    if ($type == TYPE_INT()) { return "StradaValue*"; }
    if ($type == TYPE_NUM()) { return "StradaValue*"; }
    if ($type == TYPE_STR()) { return "StradaValue*"; }
    if ($type == TYPE_BOOL()) { return "StradaValue*"; }
    if ($type == TYPE_ARRAY()) { return "StradaValue*"; }
    if ($type == TYPE_HASH()) { return "StradaValue*"; }
    if ($type == TYPE_SCALAR()) { return "StradaValue*"; }
    if ($type == TYPE_VOID()) { return "void"; }
    if ($type == TYPE_DYNAMIC()) { return "StradaValue*"; }
    if ($type == TYPE_FUNCPTR()) { return "void*"; }  # Function pointer
    return "StradaValue*";
}

# ============================================================
# Expression Code Generation
# ============================================================

# Helper: emit a numeric operand efficiently
# For literals, emit the value directly; otherwise use strada_to_num()
func emit_num_operand(scalar $cg, scalar $expr) void {
    my int $type = $expr->{"type"};
    if ($type == NODE_INT_LITERAL()) {
        my str $val = $expr->{"value"};
        # Check if it's a hex, octal, or binary literal
        # Also check for leading zeros (octal in C)
        my str $first = substr($val, 0, 1);
        my str $second = "";
        if (length($val) > 1) {
            $second = substr($val, 1, 1);
        }
        if (substr($val, 0, 2) eq "0x" || substr($val, 0, 2) eq "0X" ||
            substr($val, 0, 2) eq "0o" || substr($val, 0, 2) eq "0O" ||
            substr($val, 0, 2) eq "0b" || substr($val, 0, 2) eq "0B") {
            # Cast hex/octal/binary to double
            emit($cg, "(double)(" . $val . ")");
        } elsif ($first eq "0" && length($val) > 1 && $second ne ".") {
            # Leading zero means octal in C - must cast to preserve value
            emit($cg, "(double)(" . $val . ")");
        } else {
            emit($cg, $val . ".0");
        }
    } elsif ($type == NODE_NUM_LITERAL()) {
        emit($cg, $expr->{"value"});
    } elsif ($type == NODE_BINARY_OP() && $cg->{"has_overloads"} == 0) {
        # Inline arithmetic sub-expressions: emit C arithmetic directly,
        # skipping intermediate StradaValue creation
        my str $op = $expr->{"op"};
        if ($op eq "+" || $op eq "-" || $op eq "*") {
            emit($cg, "(");
            emit_num_operand($cg, $expr->{"left"});
            emit($cg, " " . $op . " ");
            emit_num_operand($cg, $expr->{"right"});
            emit($cg, ")");
        } else {
            # Non-inlineable op: fall through to generic handler
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $expr) == 1) {
                emit($cg, "strada_to_num_take(");
                gen_expression($cg, $expr);
                emit($cg, ")");
            } else {
                emit($cg, "strada_to_num(");
                gen_expression($cg, $expr);
                emit($cg, ")");
            }
        }
    } else {
        # Check if expression creates a temp that needs cleanup
        if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $expr) == 1) {
            emit($cg, "strada_to_num_take(");
            gen_expression($cg, $expr);
            emit($cg, ")");
        } else {
            emit($cg, "strada_to_num(");
            gen_expression($cg, $expr);
            emit($cg, ")");
        }
    }
}

# Helper: emit an integer operand efficiently
# For literals, emit the value directly; otherwise use strada_to_int()
func emit_int_operand(scalar $cg, scalar $expr) void {
    my int $type = $expr->{"type"};
    if ($type == NODE_INT_LITERAL()) {
        # Emit with an explicit 64-bit cast so the surrounding C arithmetic /
        # shift is evaluated in int64, not 32-bit int. Without it `100000*100000`
        # and `1 << 40` overflowed before being boxed as a tagged int.
        emit($cg, "(int64_t)" . c_int64_lit("" . $expr->{"value"}));
    } elsif ($type == NODE_NUM_LITERAL()) {
        emit($cg, "(int64_t)" . $expr->{"value"});
    } elsif ($type == NODE_BINARY_OP() && $cg->{"has_overloads"} == 0) {
        # Inline arithmetic sub-expressions: emit C arithmetic directly,
        # skipping intermediate StradaValue creation
        my str $op = $expr->{"op"};
        if ($op eq "+" || $op eq "-" || $op eq "*") {
            # CSE peephole: same inline int accessor on both sides — fetch once.
            if (is_inline_int_accessor_call($cg, $expr->{"left"}) == 1 && accessor_call_eq($expr->{"left"}, $expr->{"right"}) == 1) {
                my int $cseid = $cg->{"tmp_counter"} + 0;
                $cg->{"tmp_counter"} = $cseid + 1;
                emit($cg, "({ int64_t __cse" . $cseid . " = ");
                emit_int_operand($cg, $expr->{"left"});
                emit($cg, "; __cse" . $cseid . " " . $op . " __cse" . $cseid . "; })");
            } else {
                emit($cg, "(");
                emit_int_operand($cg, $expr->{"left"});
                emit($cg, " " . $op . " ");
                emit_int_operand($cg, $expr->{"right"});
                emit($cg, ")");
            }
        } else {
            # Non-inlineable op: fall through to generic handler
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $expr) == 1) {
                emit($cg, "strada_to_int_take(");
                gen_expression($cg, $expr);
                emit($cg, ")");
            } else {
                emit($cg, "strada_to_int(");
                gen_expression($cg, $expr);
                emit($cg, ")");
            }
        }
    } elsif ($type == NODE_VARIABLE() && needs_temp_cleanup($cg, $expr) == 0) {
        emit($cg, "strada_to_int(");
        gen_expression($cg, $expr);
        emit($cg, ")");
    } elsif ($type == NODE_METHOD_CALL() && $expr->{"arg_count"} == 0 && length(is_inline_accessor($cg, $expr->{"method"})) > 0 && expr_is_int_typed($cg, $expr) == 1) {
        # Inline int accessor in int context: emit strada_hv_fetch_int_ph directly,
        # returning int64_t with no StradaValue temp / incref / decref.
        my str $imethod = $expr->{"method"};
        my int $ihash = djb2_hash_32($imethod);
        my scalar $itarget = $expr->{"base_object"};
        if (!$itarget) { $itarget = $expr->{"object"}; }
        my int $itarget_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $itarget) == 1;
        if ($itarget_cleanup == 1) {
            emit($cg, "({ StradaValue *__iao = ");
            gen_expression($cg, $itarget);
            emit($cg, "; int64_t __iar = strada_hv_fetch_int_ph(__iao, \"" . $imethod . "\", " . $ihash . "u); strada_decref(__iao); __iar; })");
        } else {
            emit($cg, "strada_hv_fetch_int_ph(");
            gen_expression($cg, $itarget);
            emit($cg, ", \"" . $imethod . "\", " . $ihash . "u)");
        }
    } else {
        # Int-returning function calls whose bodies are int arithmetic / params /
        # inner calls return tagged ints, so extract the tagged value inline — this
        # keeps the hot recursive-int path (e.g. fib's fib($n-1)+fib($n-2)) fast,
        # with no per-call branch. Calls that may return a *heap* int/num (e.g. a
        # body that does `return -1;`) are NOT routed here in comparison context —
        # the int comparison codegen sends those through emit_num_operand (double),
        # which reads them correctly. (See check_overload_binary / the cmp_int gate.)
        my int $is_int_call = 0;
        if (($type == NODE_CALL() || $type == NODE_METHOD_CALL()) && expr_is_int_typed($cg, $expr) == 1) {
            $is_int_call = 1;
            if ($type == NODE_CALL() && $expr->{"is_constant"} != 1) {
                my str $raw_callee = resolve_raw_int_callee($cg, $cg->{"raw_int_funcs"}, $expr->{"name"}, "" . $cg->{"current_fn_package"});
                if (length($raw_callee) > 0) {
                    my int $raw_exp_ac = ($cg->{"raw_int_funcs"}->{$raw_callee} + 0) - 1;
                    my int $raw_ac = $expr->{"arg_count"} + 0;
                    if ($raw_ac == $raw_exp_ac) {
                        my scalar $raw_args = $expr->{"args"};
                        emit($cg, "__strada_raw_" . $raw_callee . "(");
                        my int $rai = 0;
                        while ($rai < $raw_ac) {
                            emit_int_operand($cg, $raw_args->[$rai]);
                            emit($cg, ", ");
                            $rai = $rai + 1;
                        }
                        if ($cg->{"in_main"} == 1 && $cg->{"func_tracks_depth"} == 0) {
                            emit($cg, "0)");
                        } else {
                            emit($cg, "strada_current_depth_il())");
                        }
                        return;
                    }
                }
            }
        }
        if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $expr) == 1) {
            emit($cg, "strada_to_int_take(");
            gen_expression($cg, $expr);
            emit($cg, ")");
        } else {
            emit($cg, "strada_to_int(");
            gen_expression($cg, $expr);
            emit($cg, ")");
        }
    }
}

# Helper: determine if an expression is guaranteed to produce an integer value
# Used to select STRADA_MAKE_TAGGED_INT() (zero-alloc) vs strada_new_num() (heap-alloc)
# True when an expression's value is statically known to be NUMERIC —
# a tagged int, heap INT, or heap NUM — i.e. canonical storage for a
# num-declared variable. Strings/refs/unknowns return 0 and get coerced
# at num boundaries (see the num coercion in declarations/assignment/
# return). Arithmetic ops always produce numeric values regardless of
# operand types, so they pass without recursion.
func expr_is_numeric(scalar $cg, scalar $expr) int {
    my int $t = $expr->{"type"};
    if ($t == NODE_NUM_LITERAL() || $t == NODE_INT_LITERAL()) {
        return 1;
    }
    if ($t == NODE_VARIABLE()) {
        my str $vname = escape_c_keyword($expr->{"name"});
        if (length("" . $cg->{"num_vars"}->{$vname}) > 0) {
            return 1;
        }
        # int-declared vars are numeric too
        if (length("" . $cg->{"int_vars"}->{$vname}) > 0) {
            return 1;
        }
        return 0;
    }
    if ($t == NODE_BINARY_OP()) {
        my str $op = $expr->{"op"};
        if ($op eq "+" || $op eq "-" || $op eq "*" || $op eq "/"
            || $op eq "%" || $op eq "**") {
            return 1;
        }
        return 0;
    }
    if ($t == NODE_UNARY_OP()) {
        if ($expr->{"op"} eq "-") {
            return 1;
        }
        return 0;
    }
    if ($t == NODE_CALL()) {
        # math:: builtins and the timing calls return owned numerics
        my str $name = $expr->{"name"};
        if (length($name) > 6 && substr($name, 0, 6) eq "math::") {
            return 1;
        }
        if (length($name) > 6 && substr($name, 0, 6) eq "core::") {
            $name = "sys::" . substr($name, 6, length($name) - 6);
        }
        if ($name eq "sys::hires_time" || $name eq "sys::time") {
            return 1;
        }
    }
    # int-typed exprs (incl. int-returning user calls) are numeric
    if (expr_is_int_typed($cg, $expr) == 1) {
        return 1;
    }
    return 0;
}

func expr_is_int_typed(scalar $cg, scalar $expr) int {
    my int $type = $expr->{"type"};
    if ($type == NODE_INT_LITERAL()) {
        return 1;
    }
    # Variables declared as int
    if ($type == NODE_VARIABLE()) {
        my str $vname = escape_c_keyword($expr->{"name"});
        my scalar $iv = $cg->{"int_vars"};
        if (length("" . $iv->{$vname}) > 0) {
            return 1;
        }
        return 0;
    }
    if ($type == NODE_BINARY_OP()) {
        my str $op = $expr->{"op"};
        if ($op eq "+" || $op eq "-" || $op eq "*" || $op eq "%") {
            if (expr_is_int_typed($cg, $expr->{"left"}) == 1 && expr_is_int_typed($cg, $expr->{"right"}) == 1) {
                return 1;
            }
        }
        return 0;
    }
    # Method calls: check inline accessor or devirtualized method return type
    if ($type == NODE_METHOD_CALL()) {
        my int $arg_count = $expr->{"arg_count"};
        my str $method = $expr->{"method"};

        # Check 1: Inline accessor calls ($self->x() where x is has rw int $x)
        if ($arg_count == 0) {
            my str $cur_pkg = $cg->{"current_fn_package"};
            if (length($cur_pkg) > 0 && $cur_pkg ne "main") {
                my scalar $ha_attrs = $cg->{"has_attrs"};
                my int $ha_count = $cg->{"has_attr_count"};
                my scalar $acc_lookup = $cg->{"accessor_lookup"};
                my int $hai = 0;
                while ($hai < $ha_count) {
                    my str $attr_name = $ha_attrs->[$hai]->{"name"};
                    my str $attr_pkg = $ha_attrs->[$hai]->{"package"};
                    if ($attr_name eq $method && ($attr_pkg eq $cur_pkg || is_subclass_compile_time($cg, $cur_pkg, $attr_pkg, 0) == 1)) {
                        my int $at = $ha_attrs->[$hai]->{"attr_type"};
                        if ($at == TYPE_INT()) {
                            return 1;
                        }
                        return 0;
                    }
                    $hai = $hai + 1;
                }
            }
        }

        # Check 2: Devirtualized method calls (known object type → direct function)
        my scalar $meth_target = $expr->{"base_object"};
        if (!$meth_target) {
            $meth_target = $expr->{"object"};
        }
        if ($meth_target && $meth_target->{"type"} == NODE_VARIABLE()) {
            my str $kt_name = escape_c_keyword($meth_target->{"name"});
            my scalar $kt = $cg->{"known_types"};
            if ($kt) {
                my str $known_pkg = "" . $kt->{$kt_name};
                if (length($known_pkg) > 0) {
                    my str $direct_name = $known_pkg . "_" . $method;
                    my int $dci = index($direct_name, "::");
                    while ($dci >= 0) {
                        $direct_name = substr($direct_name, 0, $dci) . "_" . substr($direct_name, $dci + 2, length($direct_name) - $dci - 2);
                        $dci = index($direct_name, "::");
                    }
                    my scalar $fri = $cg->{"func_ret_int"};
                    if ($fri && length("" . $fri->{$direct_name}) > 0) {
                        return 1;
                    }
                }
            }
        }

        return 0;
    }
    # Function calls: check if function returns int (including same-package and qw_imports)
    if ($type == NODE_CALL()) {
        my str $raw_name = "" . $expr->{"name"};
        if ($raw_name eq "byte_index" || $raw_name eq "sys::byte_index" || $raw_name eq "core::byte_index") {
            return 1;
        }
        my str $fn_name = sanitize_name($raw_name);
        my scalar $fri = $cg->{"func_ret_int"};
        if ($fri) {
            if (length("" . $fri->{$fn_name}) > 0) {
                return 1;
            }
            if (index($raw_name, "::") < 0) {
                my str $fn_pkg = "" . $cg->{"current_fn_package"};
                if (length($fn_pkg) > 0 && $fn_pkg ne "main") {
                    my str $prefixed = sanitize_name($fn_pkg) . "_" . $fn_name;
                    if (length("" . $fri->{$prefixed}) > 0) {
                        return 1;
                    }
                }
                if (defined($cg->{"qw_imports"})) {
                    my str $qpkg = $fn_pkg;
                    if (length($qpkg) == 0) { $qpkg = "main"; }
                    my str $qtarget = "" . $cg->{"qw_imports"}->{$qpkg . "::" . $raw_name};
                    if (length($qtarget) > 0 && length("" . $fri->{sanitize_name($qtarget)}) > 0) {
                        return 1;
                    }
                }
            }
        }
        return 0;
    }
    if ($type == NODE_REGEX_SUBST()) {
        return 1;
    }
    return 0;
}

# True when gen_expression($cg, $expr) is statically guaranteed to produce a
# tagged integer (STRADA_IS_TAGGED_INT) on every return path — never a heap
# StradaValue*, so cleanup_push / cleanup_pop / decref are all no-ops.
# Note: binary + / - / * / % on int64_t values can exceed 2^62 and heap-box
# via strada_new_int_il, so they use the cheap !STRADA_IS_TAGGED_INT runtime check.
func expr_is_always_tagged_int(scalar $cg, scalar $expr) int {
    my int $type = $expr->{"type"};
    if ($type == NODE_INT_LITERAL() && $cg) {
        if (bytes("" . $expr->{"value"}) < 16) {
            return 1;
        }
        return 0;
    }
    return 0;
}

# Conservative predicate: returns 1 only when evaluating $expr cannot execute
# strada_throw / longjmp, so owned sibling temporaries evaluated alongside it
# in a direct argument list (strada_pack_args_take / strada_anon_array_take /
# strada_anon_hash_mask_ph) cannot leak on an exception unwind.
func expr_cannot_throw(scalar $cg, scalar $expr) int {
    if (!$expr) { return 1; }
    my int $t = $expr->{"type"} + 0;
    if ($t == NODE_INT_LITERAL() || $t == NODE_NUM_LITERAL() || $t == NODE_STR_LITERAL() || $t == NODE_UNDEF()) {
        return 1;
    }
    if ($t == NODE_ANON_FUNC() || $t == NODE_FUNC_REF()) {
        return 1;
    }
    if ($t == NODE_VARIABLE()) {
        if ($cg->{"uses_tie"} == 0) {
            return 1;
        }
        return 0;
    }
    if ($t == NODE_REF()) {
        if ($cg->{"uses_tie"} == 0) {
            return expr_cannot_throw($cg, $expr->{"target"});
        }
        return 0;
    }
    if ($t == NODE_HASH_ACCESS()) {
        if ($cg->{"uses_tie"} == 0) {
            if (expr_cannot_throw($cg, $expr->{"hash"}) == 1 && expr_cannot_throw($cg, $expr->{"key"}) == 1) {
                return 1;
            }
        }
        return 0;
    }
    if ($t == NODE_DEREF_HASH()) {
        if ($cg->{"uses_tie"} == 0) {
            if (expr_cannot_throw($cg, $expr->{"ref"}) == 1 && expr_cannot_throw($cg, $expr->{"key"}) == 1) {
                return 1;
            }
        }
        return 0;
    }
    if ($t == NODE_SUBSCRIPT()) {
        if ($cg->{"uses_tie"} == 0) {
            if (expr_cannot_throw($cg, $expr->{"array"}) == 1 && expr_cannot_throw($cg, $expr->{"index"}) == 1) {
                return 1;
            }
        }
        return 0;
    }
    if ($t == NODE_DEREF_ARRAY()) {
        if ($cg->{"uses_tie"} == 0) {
            if (expr_cannot_throw($cg, $expr->{"ref"}) == 1 && expr_cannot_throw($cg, $expr->{"index"}) == 1) {
                return 1;
            }
        }
        return 0;
    }
    if ($t == NODE_ANON_ARRAY()) {
        my scalar $els = $expr->{"elements"};
        my int $ec = $expr->{"element_count"} + 0;
        my int $ei = 0;
        while ($ei < $ec) {
            my scalar $el = $els->[$ei];
            if ($el->{"type"} == NODE_SPREAD() || array_flatten_kind($cg, $el) > 0) { return 0; }
            if (expr_cannot_throw($cg, $el) == 0) { return 0; }
            $ei = $ei + 1;
        }
        return 1;
    }
    if ($t == NODE_ANON_HASH()) {
        if ($expr->{"key_exprs"}) {
            my scalar $kes = $expr->{"key_exprs"};
            my int $pc0 = $expr->{"pair_count"} + 0;
            my int $ki = 0;
            while ($ki < $pc0) {
                if ($kes->[$ki]) { return 0; }
                $ki = $ki + 1;
            }
        }
        my scalar $vs = $expr->{"values"};
        my int $pc = $expr->{"pair_count"} + 0;
        my int $vi = 0;
        while ($vi < $pc) {
            if (expr_cannot_throw($cg, $vs->[$vi]) == 0) { return 0; }
            $vi = $vi + 1;
        }
        return 1;
    }
    if ($t == NODE_BINARY_OP()) {
        my str $op = "" . $expr->{"op"};
        if ($op eq "." && $cg->{"has_overloads"} == 0 && $cg->{"uses_tie"} == 0) {
            if (expr_cannot_throw($cg, $expr->{"left"}) == 1 && expr_cannot_throw($cg, $expr->{"right"}) == 1) {
                return 1;
            }
        }
        return 0;
    }
    return 0;
}

# ============================================================
# Unboxed int64_t Function Specialization (__strada_raw_*)
# ============================================================

func resolve_raw_int_callee(scalar $cg, scalar $raw_map, str $call_name, str $cur_pkg) str {
    if (!$raw_map) { return ""; }
    my str $c_name = sanitize_name($call_name);
    if (($raw_map->{$c_name} + 0) > 0) {
        return $c_name;
    }
    my int $has_colon = index($call_name, "::");
    if ($has_colon < 0) {
        if (length($cur_pkg) > 0 && $cur_pkg ne "main") {
            my str $prefixed = sanitize_name($cur_pkg) . "_" . $c_name;
            if (($raw_map->{$prefixed} + 0) > 0) {
                return $prefixed;
            }
        }
        if (defined($cg->{"qw_imports"})) {
            my str $qpkg = $cur_pkg;
            if (length($qpkg) == 0) { $qpkg = "main"; }
            my str $qtarget = "" . $cg->{"qw_imports"}->{$qpkg . "::" . $call_name};
            if (length($qtarget) > 0) {
                my str $qc = sanitize_name($qtarget);
                if (($raw_map->{$qc} + 0) > 0) {
                    return $qc;
                }
            }
        }
    }
    return "";
}

func raw_int_copy_scope(scalar $src) scalar {
    my hash %dst = ();
    my scalar $ks = keys(%{$src});
    my int $n = size($ks);
    my int $i = 0;
    while ($i < $n) {
        my str $k = $ks->[$i];
        $dst{$k} = $src->{$k};
        $i = $i + 1;
    }
    return \%dst;
}

func raw_int_cond_ok(scalar $cg, scalar $expr, scalar $in_scope, scalar $global_names, scalar $raw_map, str $cur_pkg) int {
    if (!$expr) { return 0; }
    my int $t = $expr->{"type"} + 0;
    if ($t == NODE_BINARY_OP()) {
        my str $op = $expr->{"op"};
        if ($op eq "&&" || $op eq "||") {
            if (raw_int_cond_ok($cg, $expr->{"left"}, $in_scope, $global_names, $raw_map, $cur_pkg) == 1 &&
                raw_int_cond_ok($cg, $expr->{"right"}, $in_scope, $global_names, $raw_map, $cur_pkg) == 1) {
                return 1;
            }
            return 0;
        }
    }
    if ($t == NODE_UNARY_OP() && $expr->{"op"} eq "!") {
        return raw_int_cond_ok($cg, $expr->{"operand"}, $in_scope, $global_names, $raw_map, $cur_pkg);
    }
    return raw_int_expr_ok($cg, $expr, $in_scope, $global_names, $raw_map, $cur_pkg);
}

func raw_int_expr_ok(scalar $cg, scalar $expr, scalar $in_scope, scalar $global_names, scalar $raw_map, str $cur_pkg) int {
    if (!$expr) { return 0; }
    my int $t = $expr->{"type"} + 0;
    if ($t == NODE_INT_LITERAL()) {
        return 1;
    }
    if ($t == NODE_VARIABLE()) {
        if ($expr->{"sigil"} ne "$") { return 0; }
        if (index($expr->{"name"}, "::") >= 0) { return 0; }
        my str $vn = escape_c_keyword($expr->{"name"});
        if (($global_names->{$vn} + 0) == 1) { return 0; }
        if (length("" . $cg->{"our_vars"}->{$vn}) > 0) { return 0; }
        if (($in_scope->{$vn} + 0) == 1) { return 1; }
        return 0;
    }
    if ($t == NODE_UNARY_OP()) {
        if ($expr->{"op"} eq "-") {
            return raw_int_expr_ok($cg, $expr->{"operand"}, $in_scope, $global_names, $raw_map, $cur_pkg);
        }
        return 0;
    }
    if ($t == NODE_BINARY_OP()) {
        my str $op = $expr->{"op"};
        if ($op eq "+" || $op eq "-" || $op eq "*" || $op eq "%" ||
            $op eq "==" || $op eq "!=" || $op eq "<" || $op eq ">" ||
            $op eq "<=" || $op eq ">=") {
            if (raw_int_expr_ok($cg, $expr->{"left"}, $in_scope, $global_names, $raw_map, $cur_pkg) == 1 &&
                raw_int_expr_ok($cg, $expr->{"right"}, $in_scope, $global_names, $raw_map, $cur_pkg) == 1) {
                return 1;
            }
        }
        return 0;
    }
    if ($t == NODE_TERNARY()) {
        if (raw_int_cond_ok($cg, $expr->{"condition"}, $in_scope, $global_names, $raw_map, $cur_pkg) == 1 &&
            raw_int_expr_ok($cg, $expr->{"true_expr"}, $in_scope, $global_names, $raw_map, $cur_pkg) == 1 &&
            raw_int_expr_ok($cg, $expr->{"false_expr"}, $in_scope, $global_names, $raw_map, $cur_pkg) == 1) {
            return 1;
        }
        return 0;
    }
    if ($t == NODE_ASSIGN()) {
        my scalar $tgt = $expr->{"target"};
        my str $aop = $expr->{"op"};
        if (!$tgt || $tgt->{"type"} != NODE_VARIABLE() || $tgt->{"sigil"} ne "$") { return 0; }
        if (index($tgt->{"name"}, "::") >= 0) { return 0; }
        my str $tvn = escape_c_keyword($tgt->{"name"});
        if (($in_scope->{$tvn} + 0) != 1 || ($global_names->{$tvn} + 0) == 1 || length("" . $cg->{"our_vars"}->{$tvn}) > 0) {
            return 0;
        }
        if ($aop eq "=" || $aop eq "+=" || $aop eq "-=" || $aop eq "*=") {
            return raw_int_expr_ok($cg, $expr->{"value"}, $in_scope, $global_names, $raw_map, $cur_pkg);
        }
        return 0;
    }
    if ($t == NODE_INCREMENT()) {
        my scalar $iop = $expr->{"operand"};
        if (!$iop || $iop->{"type"} != NODE_VARIABLE() || $iop->{"sigil"} ne "$") { return 0; }
        if (index($iop->{"name"}, "::") >= 0) { return 0; }
        my str $ivn = escape_c_keyword($iop->{"name"});
        if (($in_scope->{$ivn} + 0) == 1 && ($global_names->{$ivn} + 0) != 1 && length("" . $cg->{"our_vars"}->{$ivn}) == 0) {
            return 1;
        }
        return 0;
    }
    if ($t == NODE_CALL()) {
        if ($expr->{"is_constant"} == 1) { return 0; }
        my str $rc = resolve_raw_int_callee($cg, $raw_map, $expr->{"name"}, $cur_pkg);
        if (length($rc) == 0) { return 0; }
        my int $exp_ac = ($raw_map->{$rc} + 0) - 1;
        my int $ac = $expr->{"arg_count"} + 0;
        if ($ac != $exp_ac) { return 0; }
        my scalar $args = $expr->{"args"};
        my int $ai = 0;
        while ($ai < $ac) {
            if (raw_int_expr_ok($cg, $args->[$ai], $in_scope, $global_names, $raw_map, $cur_pkg) == 0) {
                return 0;
            }
            $ai = $ai + 1;
        }
        return 1;
    }
    return 0;
}

func raw_int_block_ok(scalar $cg, scalar $block, scalar $in_scope, scalar $all_declared, scalar $global_names, scalar $raw_map, str $cur_pkg) int {
    if (!$block || $block->{"type"} != NODE_BLOCK()) { return 0; }
    my scalar $sub_scope = raw_int_copy_scope($in_scope);
    my scalar $stmts = $block->{"statements"};
    my int $n = $block->{"statement_count"} + 0;
    my int $i = 0;
    while ($i < $n) {
        my scalar $st = $stmts->[$i];
        my int $st_t = $st->{"type"} + 0;
        if ($st_t == NODE_VAR_DECL()) {
            if ($st->{"var_type"} != TYPE_INT() || $st->{"sigil"} ne "$") { return 0; }
            if (length("" . $st->{"struct_name"}) > 0) { return 0; }
            if (!$st->{"init"}) { return 0; }
            my str $vn = escape_c_keyword($st->{"name"});
            if (($all_declared->{$vn} + 0) == 1) { return 0; }
            if (($global_names->{$vn} + 0) == 1) { return 0; }
            if (length("" . $cg->{"our_vars"}->{$vn}) > 0) { return 0; }
            if (raw_int_expr_ok($cg, $st->{"init"}, $sub_scope, $global_names, $raw_map, $cur_pkg) == 0) {
                return 0;
            }
            $sub_scope->{$vn} = 1;
            $all_declared->{$vn} = 1;
        } elsif ($st_t == NODE_BLOCK()) {
            if (raw_int_block_ok($cg, $st, $sub_scope, $all_declared, $global_names, $raw_map, $cur_pkg) == 0) {
                return 0;
            }
        } elsif ($st_t == NODE_IF_STMT()) {
            if (raw_int_cond_ok($cg, $st->{"condition"}, $sub_scope, $global_names, $raw_map, $cur_pkg) == 0) {
                return 0;
            }
            if (raw_int_block_ok($cg, $st->{"then_block"}, $sub_scope, $all_declared, $global_names, $raw_map, $cur_pkg) == 0) {
                return 0;
            }
            my scalar $econds = $st->{"elsif_conditions"};
            my scalar $eblocks = $st->{"elsif_blocks"};
            my int $ec = $st->{"elsif_count"} + 0;
            my int $ei = 0;
            while ($ei < $ec) {
                if (raw_int_cond_ok($cg, $econds->[$ei], $sub_scope, $global_names, $raw_map, $cur_pkg) == 0) {
                    return 0;
                }
                if (raw_int_block_ok($cg, $eblocks->[$ei], $sub_scope, $all_declared, $global_names, $raw_map, $cur_pkg) == 0) {
                    return 0;
                }
                $ei = $ei + 1;
            }
            if ($st->{"else_block"}) {
                if (raw_int_block_ok($cg, $st->{"else_block"}, $sub_scope, $all_declared, $global_names, $raw_map, $cur_pkg) == 0) {
                    return 0;
                }
            }
        } elsif ($st_t == NODE_WHILE_STMT()) {
            if (length("" . $st->{"label"}) > 0) { return 0; }
            if (raw_int_cond_ok($cg, $st->{"condition"}, $sub_scope, $global_names, $raw_map, $cur_pkg) == 0) {
                return 0;
            }
            if (raw_int_block_ok($cg, $st->{"body"}, $sub_scope, $all_declared, $global_names, $raw_map, $cur_pkg) == 0) {
                return 0;
            }
        } elsif ($st_t == NODE_RETURN_STMT()) {
            if (!$st->{"value"}) { return 0; }
            if (raw_int_expr_ok($cg, $st->{"value"}, $sub_scope, $global_names, $raw_map, $cur_pkg) == 0) {
                return 0;
            }
        } elsif ($st_t == NODE_EXPR_STMT()) {
            if (raw_int_expr_ok($cg, $st->{"expr"}, $sub_scope, $global_names, $raw_map, $cur_pkg) == 0) {
                return 0;
            }
        } else {
            return 0;
        }
        $i = $i + 1;
    }
    return 1;
}

func raw_int_always_returns(scalar $block) int {
    if (!$block || $block->{"type"} != NODE_BLOCK()) { return 0; }
    my scalar $stmts = $block->{"statements"};
    my int $n = $block->{"statement_count"} + 0;
    my int $i = 0;
    while ($i < $n) {
        my scalar $st = $stmts->[$i];
        my int $st_t = $st->{"type"} + 0;
        if ($st_t == NODE_RETURN_STMT()) { return 1; }
        if ($st_t == NODE_BLOCK() && raw_int_always_returns($st) == 1) { return 1; }
        if ($st_t == NODE_IF_STMT() && $st->{"else_block"}) {
            if (raw_int_always_returns($st->{"then_block"}) == 1 &&
                raw_int_always_returns($st->{"else_block"}) == 1) {
                my int $all_elsif = 1;
                my scalar $eblocks = $st->{"elsif_blocks"};
                my int $ec = $st->{"elsif_count"} + 0;
                my int $ei = 0;
                while ($ei < $ec) {
                    if (raw_int_always_returns($eblocks->[$ei]) == 0) { $all_elsif = 0; }
                    $ei = $ei + 1;
                }
                if ($all_elsif == 1) { return 1; }
            }
        }
        $i = $i + 1;
    }
    return 0;
}

func raw_int_expr_calls_self(scalar $cg, scalar $expr, scalar $raw_map, str $self_c, str $cur_pkg) int {
    if (!$expr) { return 0; }
    my int $t = $expr->{"type"} + 0;
    if ($t == NODE_CALL()) {
        my str $rc = resolve_raw_int_callee($cg, $raw_map, $expr->{"name"}, $cur_pkg);
        if ($rc eq $self_c) { return 1; }
        my scalar $args = $expr->{"args"};
        my int $ac = $expr->{"arg_count"} + 0;
        my int $ai = 0;
        while ($ai < $ac) {
            if (raw_int_expr_calls_self($cg, $args->[$ai], $raw_map, $self_c, $cur_pkg) == 1) { return 1; }
            $ai = $ai + 1;
        }
        return 0;
    }
    if ($t == NODE_UNARY_OP() || $t == NODE_INCREMENT()) {
        return raw_int_expr_calls_self($cg, $expr->{"operand"}, $raw_map, $self_c, $cur_pkg);
    }
    if ($t == NODE_BINARY_OP()) {
        if (raw_int_expr_calls_self($cg, $expr->{"left"}, $raw_map, $self_c, $cur_pkg) == 1) { return 1; }
        return raw_int_expr_calls_self($cg, $expr->{"right"}, $raw_map, $self_c, $cur_pkg);
    }
    if ($t == NODE_TERNARY()) {
        if (raw_int_expr_calls_self($cg, $expr->{"condition"}, $raw_map, $self_c, $cur_pkg) == 1) { return 1; }
        if (raw_int_expr_calls_self($cg, $expr->{"true_expr"}, $raw_map, $self_c, $cur_pkg) == 1) { return 1; }
        return raw_int_expr_calls_self($cg, $expr->{"false_expr"}, $raw_map, $self_c, $cur_pkg);
    }
    if ($t == NODE_ASSIGN()) {
        return raw_int_expr_calls_self($cg, $expr->{"value"}, $raw_map, $self_c, $cur_pkg);
    }
    return 0;
}

# True when at least one `return` statement in $block does NOT call $self_c
# (guards against unconditional infinite self-recursion like `r($n+1)+1` where
# gcc would turn tail accumulator recursion into an infinite loop instead of
# hitting the stack-overflow guard when recursion_limit == 0).
func raw_int_has_terminating_return(scalar $cg, scalar $block, scalar $raw_map, str $self_c, str $cur_pkg) int {
    if (!$block || $block->{"type"} != NODE_BLOCK()) { return 0; }
    my scalar $stmts = $block->{"statements"};
    my int $n = $block->{"statement_count"} + 0;
    my int $i = 0;
    while ($i < $n) {
        my scalar $st = $stmts->[$i];
        my int $st_t = $st->{"type"} + 0;
        if ($st_t == NODE_RETURN_STMT() && $st->{"value"}) {
            if (raw_int_expr_calls_self($cg, $st->{"value"}, $raw_map, $self_c, $cur_pkg) == 0) {
                return 1;
            }
        } elsif ($st_t == NODE_BLOCK()) {
            if (raw_int_has_terminating_return($cg, $st, $raw_map, $self_c, $cur_pkg) == 1) { return 1; }
        } elsif ($st_t == NODE_IF_STMT()) {
            if (raw_int_has_terminating_return($cg, $st->{"then_block"}, $raw_map, $self_c, $cur_pkg) == 1) { return 1; }
            my scalar $eblocks = $st->{"elsif_blocks"};
            my int $ec = $st->{"elsif_count"} + 0;
            my int $ei = 0;
            while ($ei < $ec) {
                if (raw_int_has_terminating_return($cg, $eblocks->[$ei], $raw_map, $self_c, $cur_pkg) == 1) { return 1; }
                $ei = $ei + 1;
            }
            if ($st->{"else_block"}) {
                if (raw_int_has_terminating_return($cg, $st->{"else_block"}, $raw_map, $self_c, $cur_pkg) == 1) { return 1; }
            }
        } elsif ($st_t == NODE_WHILE_STMT()) {
            if (raw_int_has_terminating_return($cg, $st->{"body"}, $raw_map, $self_c, $cur_pkg) == 1) { return 1; }
        }
        $i = $i + 1;
    }
    return 0;
}

func gen_raw_int_cond(scalar $cg, scalar $expr, str $cur_pkg) void {
    my int $t = $expr->{"type"} + 0;
    if ($t == NODE_BINARY_OP()) {
        my str $op = $expr->{"op"};
        if ($op eq "&&" || $op eq "||") {
            emit($cg, "(");
            gen_raw_int_cond($cg, $expr->{"left"}, $cur_pkg);
            emit($cg, " " . $op . " ");
            gen_raw_int_cond($cg, $expr->{"right"}, $cur_pkg);
            emit($cg, ")");
            return;
        }
        if ($op eq "==" || $op eq "!=" || $op eq "<" || $op eq ">" || $op eq "<=" || $op eq ">=") {
            emit($cg, "(");
            gen_raw_int_expr($cg, $expr->{"left"}, $cur_pkg);
            emit($cg, " " . $op . " ");
            gen_raw_int_expr($cg, $expr->{"right"}, $cur_pkg);
            emit($cg, ")");
            return;
        }
    }
    if ($t == NODE_UNARY_OP() && $expr->{"op"} eq "!") {
        emit($cg, "!(");
        gen_raw_int_cond($cg, $expr->{"operand"}, $cur_pkg);
        emit($cg, ")");
        return;
    }
    emit($cg, "((");
    gen_raw_int_expr($cg, $expr, $cur_pkg);
    emit($cg, ") != 0)");
}

func gen_raw_int_expr(scalar $cg, scalar $expr, str $cur_pkg) void {
    my int $t = $expr->{"type"} + 0;
    if ($t == NODE_INT_LITERAL()) {
        emit($cg, "(int64_t)" . $expr->{"value"});
        return;
    }
    if ($t == NODE_VARIABLE()) {
        emit($cg, escape_c_keyword($expr->{"name"}));
        return;
    }
    if ($t == NODE_UNARY_OP()) {
        emit($cg, "((int64_t)(-(uint64_t)(");
        gen_raw_int_expr($cg, $expr->{"operand"}, $cur_pkg);
        emit($cg, ")))");
        return;
    }
    if ($t == NODE_BINARY_OP()) {
        my str $op = $expr->{"op"};
        if ($op eq "+" || $op eq "-" || $op eq "*") {
            emit($cg, "((int64_t)((uint64_t)(");
            gen_raw_int_expr($cg, $expr->{"left"}, $cur_pkg);
            emit($cg, ") " . $op . " (uint64_t)(");
            gen_raw_int_expr($cg, $expr->{"right"}, $cur_pkg);
            emit($cg, ")))");
            return;
        }
        if ($op eq "%") {
            my int $mid = $cg->{"tmp_counter"} + 0;
            $cg->{"tmp_counter"} = $mid + 1;
            emit($cg, "({ int64_t __rml" . $mid . " = ");
            gen_raw_int_expr($cg, $expr->{"left"}, $cur_pkg);
            emit($cg, "; int64_t __rmr" . $mid . " = ");
            gen_raw_int_expr($cg, $expr->{"right"}, $cur_pkg);
            emit($cg, "; if (__rmr" . $mid . " == 0) strada_safe_mod(__rml" . $mid . ", 0); strada_floored_mod(__rml" . $mid . ", __rmr" . $mid . "); })");
            return;
        }
        if ($op eq "==" || $op eq "!=" || $op eq "<" || $op eq ">" || $op eq "<=" || $op eq ">=") {
            emit($cg, "((int64_t)(");
            gen_raw_int_expr($cg, $expr->{"left"}, $cur_pkg);
            emit($cg, " " . $op . " ");
            gen_raw_int_expr($cg, $expr->{"right"}, $cur_pkg);
            emit($cg, "))");
            return;
        }
    }
    if ($t == NODE_TERNARY()) {
        emit($cg, "(");
        gen_raw_int_cond($cg, $expr->{"condition"}, $cur_pkg);
        emit($cg, " ? ");
        gen_raw_int_expr($cg, $expr->{"true_expr"}, $cur_pkg);
        emit($cg, " : ");
        gen_raw_int_expr($cg, $expr->{"false_expr"}, $cur_pkg);
        emit($cg, ")");
        return;
    }
    if ($t == NODE_ASSIGN()) {
        my str $tvn = escape_c_keyword($expr->{"target"}->{"name"});
        my str $aop = $expr->{"op"};
        if ($aop eq "=") {
            emit($cg, "(" . $tvn . " = ");
            gen_raw_int_expr($cg, $expr->{"value"}, $cur_pkg);
            emit($cg, ")");
        } else {
            my str $bop = substr($aop, 0, 1);
            emit($cg, "(" . $tvn . " = (int64_t)((uint64_t)" . $tvn . " " . $bop . " (uint64_t)(");
            gen_raw_int_expr($cg, $expr->{"value"}, $cur_pkg);
            emit($cg, ")))");
        }
        return;
    }
    if ($t == NODE_INCREMENT()) {
        my str $ivn = escape_c_keyword($expr->{"operand"}->{"name"});
        my str $iop = "+";
        if ($expr->{"op"} eq "--") { $iop = "-"; }
        if ($expr->{"is_prefix"} == 1) {
            emit($cg, "(" . $ivn . " = (int64_t)((uint64_t)" . $ivn . " " . $iop . " 1ULL))");
        } else {
            my int $iid = $cg->{"tmp_counter"} + 0;
            $cg->{"tmp_counter"} = $iid + 1;
            emit($cg, "({ int64_t __ri" . $iid . " = " . $ivn . "; " . $ivn . " = (int64_t)((uint64_t)__ri" . $iid . " " . $iop . " 1ULL); __ri" . $iid . "; })");
        }
        return;
    }
    if ($t == NODE_CALL()) {
        my str $rc = resolve_raw_int_callee($cg, $cg->{"raw_int_funcs"}, $expr->{"name"}, $cur_pkg);
        my scalar $args = $expr->{"args"};
        my int $ac = $expr->{"arg_count"} + 0;
        emit($cg, "__strada_raw_" . $rc . "(");
        my int $ai = 0;
        while ($ai < $ac) {
            gen_raw_int_expr($cg, $args->[$ai], $cur_pkg);
            emit($cg, ", ");
            $ai = $ai + 1;
        }
        emit($cg, "__strada_depth + 1)");
        return;
    }
}

func gen_raw_int_block(scalar $cg, scalar $block, str $cur_pkg) void {
    emit($cg, "{\n");
    indent($cg);
    my scalar $stmts = $block->{"statements"};
    my int $n = $block->{"statement_count"} + 0;
    my int $i = 0;
    while ($i < $n) {
        gen_raw_int_stmt($cg, $stmts->[$i], $cur_pkg);
        $i = $i + 1;
    }
    dedent($cg);
    emit_indent($cg);
    emit($cg, "}");
}

func gen_raw_int_stmt(scalar $cg, scalar $st, str $cur_pkg) void {
    my int $st_t = $st->{"type"} + 0;
    if ($st_t == NODE_VAR_DECL()) {
        my str $vn = escape_c_keyword($st->{"name"});
        emit_indent($cg);
        emit($cg, "int64_t " . $vn . " = ");
        gen_raw_int_expr($cg, $st->{"init"}, $cur_pkg);
        emit($cg, ";\n");
        return;
    }
    if ($st_t == NODE_BLOCK()) {
        emit_indent($cg);
        gen_raw_int_block($cg, $st, $cur_pkg);
        emit($cg, "\n");
        return;
    }
    if ($st_t == NODE_IF_STMT()) {
        emit_indent($cg);
        emit($cg, "if (");
        gen_raw_int_cond($cg, $st->{"condition"}, $cur_pkg);
        emit($cg, ") ");
        gen_raw_int_block($cg, $st->{"then_block"}, $cur_pkg);
        my scalar $econds = $st->{"elsif_conditions"};
        my scalar $eblocks = $st->{"elsif_blocks"};
        my int $ec = $st->{"elsif_count"} + 0;
        my int $ei = 0;
        while ($ei < $ec) {
            emit($cg, " else if (");
            gen_raw_int_cond($cg, $econds->[$ei], $cur_pkg);
            emit($cg, ") ");
            gen_raw_int_block($cg, $eblocks->[$ei], $cur_pkg);
            $ei = $ei + 1;
        }
        if ($st->{"else_block"}) {
            emit($cg, " else ");
            gen_raw_int_block($cg, $st->{"else_block"}, $cur_pkg);
        }
        emit($cg, "\n");
        return;
    }
    if ($st_t == NODE_WHILE_STMT()) {
        emit_indent($cg);
        emit($cg, "while (");
        gen_raw_int_cond($cg, $st->{"condition"}, $cur_pkg);
        emit($cg, ") ");
        gen_raw_int_block($cg, $st->{"body"}, $cur_pkg);
        emit($cg, "\n");
        return;
    }
    if ($st_t == NODE_RETURN_STMT()) {
        emit_indent($cg);
        emit($cg, "return ");
        gen_raw_int_expr($cg, $st->{"value"}, $cur_pkg);
        emit($cg, ";\n");
        return;
    }
    if ($st_t == NODE_EXPR_STMT()) {
        emit_indent($cg);
        gen_raw_int_expr($cg, $st->{"expr"}, $cur_pkg);
        emit($cg, ";\n");
        return;
    }
}

# Helper: emit a bool operand efficiently
# For literals, emit the value directly; otherwise use strada_to_bool()
func emit_bool_operand(scalar $cg, scalar $expr) void {
    my int $type = $expr->{"type"};
    if ($type == NODE_INT_LITERAL()) {
        my str $val = $expr->{"value"};
        if ($val eq "0") {
            emit($cg, "0");
        } else {
            emit($cg, "1");
        }
    } elsif ($type == NODE_NUM_LITERAL()) {
        my str $val = $expr->{"value"};
        if ($val eq "0" || $val eq "0.0") {
            emit($cg, "0");
        } else {
            emit($cg, "1");
        }
    } else {
        # Check if expression creates a temp that needs cleanup
        if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $expr) == 1) {
            # Wrap in statement expression to capture and cleanup temp
            emit($cg, "({ StradaValue *__bool_tmp = ");
            gen_expression($cg, $expr);
            emit($cg, "; int __bool_val = strada_to_bool(__bool_tmp); strada_decref(__bool_tmp); __bool_val; })");
        } else {
            emit($cg, "strada_to_bool(");
            gen_expression($cg, $expr);
            emit($cg, ")");
        }
    }
}

# Helper: emit an expression as a C string in extern mode
# Converts non-string types (int, num) to strings using helper functions
func emit_extern_str_operand(scalar $cg, scalar $expr) void {
    my int $type = $expr->{"type"};

    # String literals - emit as raw C string
    if ($type == NODE_STR_LITERAL()) {
        gen_expression($cg, $expr);
        return;
    }

    # Integer literals - convert to string
    if ($type == NODE_INT_LITERAL()) {
        emit($cg, "strada_int_to_cstr(" . $expr->{"value"} . ")");
        return;
    }

    # Number literals - convert to string
    if ($type == NODE_NUM_LITERAL()) {
        emit($cg, "strada_num_to_cstr(" . $expr->{"value"} . ")");
        return;
    }

    # Variables - check extern_params for type and convert if needed
    if ($type == NODE_VARIABLE()) {
        my str $var_name = $expr->{"name"};
        my scalar $extern_params = $cg->{"extern_params"};
        if ($extern_params) {
            my scalar $param_type = $extern_params->{$var_name};
            if ($param_type) {
                if ($param_type == TYPE_INT() || $param_type == TYPE_BOOL() || $param_type == TYPE_INT32() || $param_type == TYPE_INT64()) {
                    emit($cg, "strada_int_to_cstr(" . $var_name . ")");
                    return;
                } elsif ($param_type == TYPE_NUM() || $param_type == TYPE_FLOAT32() || $param_type == TYPE_FLOAT64()) {
                    emit($cg, "strada_num_to_cstr(" . $var_name . ")");
                    return;
                }
            }
        }
        # String type or unknown - emit as-is
        emit($cg, $var_name);
        return;
    }

    # Binary op (nested concatenation) - recurse
    if ($type == NODE_BINARY_OP() && $expr->{"op"} eq ".") {
        emit($cg, "strada_cstr_concat(");
        emit_extern_str_operand($cg, $expr->{"left"});
        emit($cg, ", ");
        emit_extern_str_operand($cg, $expr->{"right"});
        emit($cg, ")");
        return;
    }

    # Other expressions - just emit (assume they return char*)
    gen_expression($cg, $expr);
}

# Helper: emit a while condition for regex /g match with position tracking
func emit_regex_g_condition(scalar $cg, scalar $expr, str $pos_var) void {
    my str $pattern = $expr->{"pattern"};
    my str $flags = $expr->{"flags"};
    my str $op = $expr->{"op"};

    # Get the target string
    emit($cg, "({ char *__re_str = strada_to_str(");
    gen_expression($cg, $expr->{"target"});
    emit($cg, "); int __re_res = ");
    if ($op eq "!~") { emit($cg, "!"); }
    emit($cg, "strada_regex_match_global(__re_str, \"");
    # Emit pattern with C escaping
    my int $i = 0;
    my int $len = length($pattern);
    while ($i < $len) {
        my str $ch = substr($pattern, $i, 1);
        if ($ch eq "\\") { emit($cg, "\\\\"); }
        elsif ($ch eq "\"") { emit($cg, "\\\""); }
        elsif ($ch eq "\n") { emit($cg, "\\n"); }
        elsif ($ch eq "\t") { emit($cg, "\\t"); }
        else { emit($cg, c_ctrl_escape($ch)); }
        $i = $i + 1;
    }
    emit($cg, "\", \"" . $flags . "\", &" . $pos_var . "); free(__re_str); __re_res; })");
}

# ===== Condition-level CSE for repeated literal-key hash fetches =====
# `if ($h{"k"} > 0 && $h{"k"} < 100)` probes the hash twice. When the
# condition tree is PURE (no calls, assignments, increments, regex ops —
# nothing that could mutate %h or depend on evaluation order) and the
# program never uses tie (a tied FETCH is observable per-mention), each
# duplicated fetch is hoisted into a temp evaluated once per condition
# evaluation. Short-circuit note: the hoisted fetch runs even when the
# `&&` left side is false — safe for untied hashes (plain reads have no
# side effects and do not autovivify).

# Is the expression tree pure enough to hoist hash fetches across?
# Strict whitelist: anything unrecognized (calls, method calls, regex
# matches, assignments, ++/--) disables CSE for the whole condition.
func cond_cse_pure(scalar $expr) int {
    my int $t = $expr->{"type"};
    if ($t == NODE_VARIABLE() || $t == NODE_INT_LITERAL() || $t == NODE_NUM_LITERAL()
        || $t == NODE_STR_LITERAL() || $t == NODE_UNDEF()) {
        return 1;
    }
    if ($t == NODE_BINARY_OP()) {
        if (cond_cse_pure($expr->{"left"}) == 0) { return 0; }
        return cond_cse_pure($expr->{"right"});
    }
    if ($t == NODE_UNARY_OP()) {
        return cond_cse_pure($expr->{"operand"});
    }
    if ($t == NODE_TERNARY()) {
        if (cond_cse_pure($expr->{"condition"}) == 0) { return 0; }
        if (cond_cse_pure($expr->{"true_expr"}) == 0) { return 0; }
        return cond_cse_pure($expr->{"false_expr"});
    }
    if ($t == NODE_HASH_ACCESS()) {
        if (cond_cse_pure($expr->{"hash"}) == 0) { return 0; }
        return cond_cse_pure($expr->{"key"});
    }
    return 0;
}

# Collect CSE candidates (literal-key accesses on simple hash variables)
# into $cg->{"cse_ids"} / $cg->{"cse_nodes"} parallel arrays.
func cond_cse_collect(scalar $cg, scalar $expr) void {
    my int $t = $expr->{"type"};
    if ($t == NODE_HASH_ACCESS()) {
        my scalar $h = $expr->{"hash"};
        my scalar $k = $expr->{"key"};
        if ($h->{"type"} == NODE_VARIABLE() && $k->{"type"} == NODE_STR_LITERAL()) {
            my int $n = $cg->{"cse_n"};
            $cg->{"cse_ids"}->[$n] = $h->{"name"} . chr(31) . $k->{"value"};
            $cg->{"cse_nodes"}->[$n] = $expr;
            $cg->{"cse_n"} = $n + 1;
        } else {
            cond_cse_collect($cg, $h);
            cond_cse_collect($cg, $k);
        }
        return;
    }
    if ($t == NODE_BINARY_OP()) {
        cond_cse_collect($cg, $expr->{"left"});
        cond_cse_collect($cg, $expr->{"right"});
        return;
    }
    if ($t == NODE_UNARY_OP()) {
        cond_cse_collect($cg, $expr->{"operand"});
        return;
    }
    if ($t == NODE_TERNARY()) {
        cond_cse_collect($cg, $expr->{"condition"});
        cond_cse_collect($cg, $expr->{"true_expr"});
        cond_cse_collect($cg, $expr->{"false_expr"});
        return;
    }
}

# Statement-position condition emitter (if/elsif/while/until/do-while/for).
# Applies the hash-fetch CSE when safe, else delegates to emit_condition.
# Expression-position conditions (ternaries) keep plain emit_condition.
func emit_condition_cse(scalar $cg, scalar $expr) void {
    if ($cg->{"uses_tie"} == 1 || $cg->{"cleanup_enabled"} != 1) {
        emit_condition($cg, $expr);
        return;
    }
    if (cond_cse_pure($expr) == 0) {
        emit_condition($cg, $expr);
        return;
    }
    $cg->{"cse_n"} = 0;
    cond_cse_collect($cg, $expr);
    my int $n = $cg->{"cse_n"};
    if ($n < 2) {
        emit_condition($cg, $expr);
        return;
    }
    my scalar $ids = $cg->{"cse_ids"};
    my scalar $nodes = $cg->{"cse_nodes"};
    # Count occurrences of each id.
    my hash %count = ();
    my int $i = 0;
    while ($i < $n) {
        my str $cid = $ids->[$i];
        $count{$cid} = $count{$cid} + 1;
        $i = $i + 1;
    }
    # Tag nodes of duplicated ids with a shared temp; emit each temp's
    # init (the real fetch) once, from the first — still untagged — node.
    my hash %temp_for = ();
    my array @temps = ();
    my int $temp_count = 0;
    my int $opened = 0;
    $i = 0;
    while ($i < $n) {
        my str $cid = $ids->[$i];
        if ($count{$cid} >= 2) {
            my str $tmp = "" . $temp_for{$cid};
            if (length($tmp) == 0) {
                my int $tc = $cg->{"tmp_counter"};
                $cg->{"tmp_counter"} = $tc + 1;
                $tmp = "__cse_" . $tc;
                if ($opened == 0) {
                    emit($cg, "(({ ");
                    $opened = 1;
                }
                emit($cg, "StradaValue *" . $tmp . " = ");
                gen_expression($cg, $nodes->[$i]);
                emit($cg, "; ");
                $temp_for{$cid} = $tmp;
                $temps[$temp_count] = $tmp;
                $temp_count = $temp_count + 1;
            }
            my scalar $nd = $nodes->[$i];
            $nd->{"cse_temp"} = $tmp;
        }
        $i = $i + 1;
    }
    if ($opened == 0) {
        emit_condition($cg, $expr);
        return;
    }
    emit($cg, "int __cse_c = ");
    emit_condition($cg, $expr);
    emit($cg, "; ");
    $i = 0;
    while ($i < $temp_count) {
        emit($cg, "strada_decref(" . $temps[$i] . "); ");
        $i = $i + 1;
    }
    emit($cg, "__cse_c; }))");
    # Clear tags: the same AST may be consulted again (e.g. needs_temp_cleanup
    # from an outer context) and must regenerate real fetches elsewhere.
    $i = 0;
    while ($i < $n) {
        my scalar $nd = $nodes->[$i];
        $nd->{"cse_temp"} = "";
        $i = $i + 1;
    }
}

# Helper: emit a condition as raw C boolean (avoids strada_new_int allocation)
# Used for while/for/if conditions to prevent memory leaks
func emit_condition(scalar $cg, scalar $expr) void {
    my int $type = $expr->{"type"};

    # Literals: emit 0 or 1 directly
    if ($type == NODE_INT_LITERAL()) {
        my str $val = $expr->{"value"};
        if ($val eq "0") {
            emit($cg, "0");
        } else {
            emit($cg, "1");
        }
        return;
    }
    if ($type == NODE_NUM_LITERAL()) {
        my str $val = $expr->{"value"};
        if ($val eq "0" || $val eq "0.0") {
            emit($cg, "0");
        } else {
            emit($cg, "1");
        }
        return;
    }

    # Binary operators: handle comparisons and logical ops without allocation
    if ($type == NODE_BINARY_OP()) {
        my str $op = $expr->{"op"};

        # Comparison operators: emit raw C comparison ONLY when not overloaded
        if ($op eq "==" || $op eq "!=" || $op eq "<" || $op eq ">" || $op eq "<=" || $op eq ">=") {
            if ($cg->{"has_overloads"} == 0 || check_overload_binary($cg, $expr->{"left"}, $expr->{"right"}, $op) == 0) {
                # Use int64_t path when both sides are int-typed (preserves full 64-bit precision!)
                if (expr_is_int_typed($cg, $expr->{"left"}) == 1 && expr_is_int_typed($cg, $expr->{"right"}) == 1) {
                    emit($cg, "(");
                    emit_int_operand($cg, $expr->{"left"});
                    emit($cg, " " . $op . " ");
                    emit_int_operand($cg, $expr->{"right"});
                    emit($cg, ")");
                } else {
                    emit($cg, "(");
                    emit_num_operand($cg, $expr->{"left"});
                    emit($cg, " " . $op . " ");
                    emit_num_operand($cg, $expr->{"right"});
                    emit($cg, ")");
                }
                return;
            }
        }

        # Logical AND: recurse on both sides
        if ($op eq "&&") {
            emit($cg, "(");
            emit_condition($cg, $expr->{"left"});
            emit($cg, " && ");
            emit_condition($cg, $expr->{"right"});
            emit($cg, ")");
            return;
        }

        # Logical OR: recurse on both sides
        if ($op eq "||") {
            emit($cg, "(");
            emit_condition($cg, $expr->{"left"});
            emit($cg, " || ");
            emit_condition($cg, $expr->{"right"});
            emit($cg, ")");
            return;
        }
    }

    # Unary NOT: recurse unless '!' is overloaded on a potentially blessed operand
    if ($type == NODE_UNARY_OP()) {
        my str $op = $expr->{"op"};
        if ($op eq "!") {
            my int $bang_ovl = 0;
            if ($cg->{"has_overloads"} == 1 && could_be_blessed($expr->{"operand"}) == 1) {
                my scalar $ol_ops_cond = $cg->{"overloaded_ops"};
                if ($ol_ops_cond && length("" . $ol_ops_cond->{"!"}) > 0) {
                    $bang_ovl = 1;
                }
            }
            if ($bang_ovl == 0) {
                emit($cg, "!(");
                emit_condition($cg, $expr->{"operand"});
                emit($cg, ")");
                return;
            }
        }
    }

    # Function call: handle defined() specially to avoid leak
    if ($type == NODE_CALL()) {
        my str $name = $expr->{"name"};
        if ($name eq "defined") {
            my scalar $args = $expr->{"args"};
            my scalar $arg = $args->[0];
            # Use non-allocating strada_defined_bool, cleanup arg if temporary
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $arg) == 1) {
                emit($cg, "({ StradaValue *__def_tmp = ");
                gen_expression($cg, $arg);
                emit($cg, "; int __def_res = strada_defined_bool(__def_tmp); strada_decref(__def_tmp); __def_res; })");
            } else {
                emit($cg, "strada_defined_bool(");
                gen_expression($cg, $arg);
                emit($cg, ")");
            }
            return;
        }
    }

    # Fallback: use strada_to_bool on the expression
    # If expression produces temporary value, capture and free it
    if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $expr) == 1) {
        emit($cg, "strada_to_bool_take(");
        gen_expression($cg, $expr);
        emit($cg, ")");
    } else {
        emit($cg, "strada_to_bool(");
        gen_expression($cg, $expr);
        emit($cg, ")");
    }
}

# Helper: check if expression is a simple variable (doesn't need cleanup)
func is_variable_expr(scalar $expr) int {
    my int $type = $expr->{"type"};
    if ($type == NODE_VARIABLE()) {
        return 1;
    }
    return 0;
}

# Helper: check if expression produces an owned StradaValue* that needs cleanup
# Returns 1 for expressions we KNOW produce owned pointers (literals, concat, arithmetic)
# Returns 0 for unknown types (function calls, etc.) to be safe
# Set of builtin call names whose results are owned StradaValue* (the
# caller must decref temps). Built ONCE into a hash at codegen_new time and
# probed with a single hash lookup in needs_temp_cleanup -- this used to be
# a ~300-arm `$name eq` chain evaluated on every call-argument check (7.5%
# of compile time on real programs). To register a new owned-return
# builtin, add its (sys::-normalized) name to this list.
func build_owned_call_builtins() scalar {
    my hash %owned_set = ();
    # builtins whose runtime function always returns a fresh value (audited:
    # every return path is strada_new_* or a newly built container), so a
    # result used as an argument is released after the call
    $owned_set{"sys::localtime"} = 1;
    $owned_set{"sys::gmtime"} = 1;
    $owned_set{"sys::time"} = 1;
    $owned_set{"sys::getpid"} = 1;
    $owned_set{"sys::getppid"} = 1;
    $owned_set{"sys::fork"} = 1;
    $owned_set{"sys::wait"} = 1;
    $owned_set{"sys::getcwd"} = 1;
    $owned_set{"sys::getlogin"} = 1;
    $owned_set{"sys::getgroups"} = 1;
    $owned_set{"sys::inet_ntoa"} = 1;
    $owned_set{"sys::inet_ntop"} = 1;
    $owned_set{"sys::fgets"} = 1;
    $owned_set{"sys::fgetc"} = 1;
    $owned_set{"sys::read_fd"} = 1;
    $owned_set{"sys::read_all_fd"} = 1;
    $owned_set{"sys::slurp_fd"} = 1;
    $owned_set{"sys::slurp_fh"} = 1;
    $owned_set{"sys::socket_recv"} = 1;
