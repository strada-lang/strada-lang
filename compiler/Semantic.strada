    $b{"sys::getsid"} = 1;
    $b{"sys::setpgid"} = 1;
    $b{"sys::getpgid"} = 1;
    $b{"sys::getpgrp"} = 1;
    $b{"sys::setpgrp"} = 1;

    # sys:: User/group ID control
    $b{"sys::setuid"} = 1;
    $b{"sys::setgid"} = 1;
    $b{"sys::seteuid"} = 1;
    $b{"sys::setegid"} = 1;
    $b{"sys::setreuid"} = 1;
