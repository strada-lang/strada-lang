# ============================================================
# Context Structure
# ============================================================

func ctx_new() scalar {
    my hash %ctx = ();
    my hash %funcs = ();
    my hash %kpkgs = ();
    $ctx{"functions"} = \%funcs;
    $ctx{"known_packages"} = \%kpkgs;
    $ctx{"builtins"} = get_builtins();
    $ctx{"scope"} = scope_new(0);
    $ctx{"current_func"} = 0;
    my hash %mro_cache = ();
    my hash %desc_cache = ();
    $ctx{"mro_cache"} = \%mro_cache;
    $ctx{"desc_cache"} = \%desc_cache;
    my hash %cls_ids = ();
    my array @cls_names = ();
    $ctx{"cls_ids"} = \%cls_ids;
    $ctx{"cls_names"} = \@cls_names;
    $ctx{"asg_root"} = 0;
    $ctx{"asg_set"} = 0;
    $ctx{"prog"} = 0;
    $ctx{"elem_where"} = "";
    $ctx{"cur_file"} = "";
    $ctx{"cur_pkg"} = "main";
    $ctx{"cur_block_line"} = 0;
    $ctx{"local_shadow_id"} = 0;
    $ctx{"errors"} = [];

    # Register built-in global variables: ARGV (array) and ARGC (int)
    my scalar $global_scope = $ctx{"scope"};
    scope_add_var($global_scope, "ARGV", "@", TYPE_ARRAY(), 0);
    scope_add_var($global_scope, "ARGC", "$", TYPE_INT(), 0);
    # Standard I/O filehandles
    scope_add_var($global_scope, "STDIN", "$", TYPE_SCALAR(), 0);
    scope_add_var($global_scope, "STDOUT", "$", TYPE_SCALAR(), 0);
    scope_add_var($global_scope, "STDERR", "$", TYPE_SCALAR(), 0);
    # Special variables
    scope_add_var($global_scope, "__child_status", "$", TYPE_INT(), 0);
    scope_add_var($global_scope, "__program_name", "$", TYPE_STR(), 0);
    scope_add_var($global_scope, "_", "$", TYPE_SCALAR(), 0);

    return \%ctx;
}

# ============================================================
# Registration Pass (First Pass)
# ============================================================

func register_functions(scalar $ctx, scalar $ast) void {
    my scalar $funcs = $ast->{"functions"};
    my int $count = $ast->{"function_count"};

    for (my int $i = 0; $i < $count; $i = $i + 1) {
        my scalar $fn = $funcs->[$i];
        my str $name = $fn->{"name"};
        my int $line = ast_get_line($fn);
        $ctx->{"cur_file"} = $fn->{"file"};

        # Check for duplicate function. Body-less extern declarations
        # (`extern func Pkg::name(...) ret;`) follow C semantics: a
        # declaration never conflicts with anything, a definition replaces
        # an earlier declaration, and only two *definitions* collide. This
        # matters for use-cycles broken via externs — several sibling
        # modules each declare the same `extern func Perla::CodeGen::emit`,
        # and `use`-inlining surfaces those duplicate declarations in one
        # compile unit (e.g. perla's CodeGen submodules).
        my int $new_is_decl = 0;
        if ($fn->{"is_extern"} == 1 && $fn->{"has_body"} != 1) { $new_is_decl = 1; }
        my scalar $existing_fn = $ctx->{"functions"}->{$name};
        my int $skip_register = 0;
        if ($existing_fn != 0) {
            if ($new_is_decl == 1) {
                # Duplicate declaration: keep whatever is registered (a
                # definition stays a definition; a prior decl is equivalent).
                $skip_register = 1;
            } elsif ($existing_fn->{"is_decl_only"} == 1) {
                # Definition arriving after a forward declaration: replace
                # the decl's info with the definition's (fall through).
                $skip_register = 0;
            } else {
                semantic_error($ctx, "function '" . $name . "' already defined", $line);
            }
        }

        my str $fn_pkg = "" . $fn->{"package"};
        if ($name eq "main") {
            $ctx->{"has_main"} = 1;
        }
        if (length($fn_pkg) > 0 && $fn_pkg ne "main") {
            $ctx->{"known_packages"}->{$fn_pkg} = 1;
            my str $c_fpkg = $fn_pkg;
            my int $pcol = index($c_fpkg, "::");
            while ($pcol >= 0) {
                $c_fpkg = substr($c_fpkg, 0, $pcol) . "_" . substr($c_fpkg, $pcol + 2, length($c_fpkg) - $pcol - 2);
                $pcol = index($c_fpkg, "::");
            }
            $ctx->{"known_packages"}->{$c_fpkg} = 1;
        }

        if ($skip_register == 0) {
            # Register function
            my hash %info = ();
            $info{"is_registered"} = 1;  # Marker to distinguish from unfound
            $info{"return_type"} = $fn->{"return_type"};
            $info{"param_count"} = $fn->{"param_count"};
            $info{"params"} = $fn->{"params"};
            $info{"is_extern"} = $fn->{"is_extern"};
            $info{"is_variadic"} = $fn->{"is_variadic"};
            $info{"is_decl_only"} = $new_is_decl;
            $info{"is_private"} = $fn->{"is_private"} + 0;
            $info{"package"} = $fn_pkg;
            $info{"from_use"} = $fn->{"from_use"} + 0;
            $info{"file"} = "" . $fn->{"file"};
            $info{"line"} = $line;
            $info{"node"} = $fn;
            $ctx->{"functions"}->{$name} = \%info;
        }
    }
}

# Register functions from import_lib statements
func register_import_lib_functions(scalar $ctx, scalar $ast) void {
    my int $lib_count = $ast->{"import_lib_count"};
    if ($lib_count == 0) {
        return;
    }

    my scalar $import_libs = $ast->{"import_libs"};

    for (my int $i = 0; $i < $lib_count; $i = $i + 1) {
        my scalar $lib_info = $import_libs->[$i];
        my scalar $lib_funcs = $lib_info->{"functions"};
        my int $fn_count = $lib_info->{"function_count"};

        for (my int $j = 0; $j < $fn_count; $j = $j + 1) {
            my scalar $fn_info = $lib_funcs->[$j];
            my str $name = $fn_info->{"name"};

            # Register function (skip if already exists)
            my scalar $existing_fn = $ctx->{"functions"}->{$name};
            if ($existing_fn != 0) {
                next;  # Function with this name already exists
            }

            my hash %info = ();
            $info{"is_registered"} = 1;
            $info{"return_type"} = $fn_info->{"return_type"};
            $info{"param_count"} = $fn_info->{"param_count"};
            $info{"params"} = $fn_info->{"params"};
            $info{"is_extern"} = 0;
            $info{"is_variadic"} = $fn_info->{"is_variadic"};
            $info{"variadic_param_idx"} = $fn_info->{"variadic_param_idx"};
            $info{"is_import_lib"} = 1;  # Mark as import_lib function
            $info{"line"} = 0;
            $ctx->{"functions"}->{$name} = \%info;
        }
    }
}

# Register functions from import_object statements (static linking)
func register_import_object_functions(scalar $ctx, scalar $ast) void {
    my int $obj_count = $ast->{"import_object_count"};
    if ($obj_count == 0) {
        return;
    }

    my scalar $import_objects = $ast->{"import_objects"};

    for (my int $i = 0; $i < $obj_count; $i = $i + 1) {
        my scalar $obj_info = $import_objects->[$i];
        my scalar $obj_funcs = $obj_info->{"functions"};
        my int $fn_count = $obj_info->{"function_count"};

        for (my int $j = 0; $j < $fn_count; $j = $j + 1) {
            my scalar $fn_info = $obj_funcs->[$j];
            my str $name = $fn_info->{"name"};

            # Register function (skip if already exists)
            my scalar $existing_fn = $ctx->{"functions"}->{$name};
            if ($existing_fn != 0) {
                next;  # Function with this name already exists
            }

            my hash %info = ();
            $info{"is_registered"} = 1;
            $info{"return_type"} = $fn_info->{"return_type"};
            $info{"param_count"} = $fn_info->{"param_count"};
            $info{"params"} = $fn_info->{"params"};
            $info{"is_extern"} = 0;
            $info{"is_variadic"} = $fn_info->{"is_variadic"};
            $info{"variadic_param_idx"} = $fn_info->{"variadic_param_idx"};
            $info{"is_import_object"} = 1;  # Mark as import_object function
            $info{"line"} = 0;
            $ctx->{"functions"}->{$name} = \%info;
        }
    }
}

# Register functions from import_archive statements (static .a archives)
func register_import_archive_functions(scalar $ctx, scalar $ast) void {
    my int $arch_count = $ast->{"import_archive_count"};
    if ($arch_count == 0) {
        return;
    }

    my scalar $import_archives = $ast->{"import_archives"};

    for (my int $i = 0; $i < $arch_count; $i = $i + 1) {
        my scalar $arch_info = $import_archives->[$i];
        my scalar $arch_funcs = $arch_info->{"functions"};
        my int $fn_count = $arch_info->{"function_count"};

        for (my int $j = 0; $j < $fn_count; $j = $j + 1) {
            my scalar $fn_info = $arch_funcs->[$j];
            my str $name = $fn_info->{"name"};

            my scalar $existing_fn = $ctx->{"functions"}->{$name};
            if ($existing_fn != 0) {
                next;
            }

            my hash %info = ();
            $info{"is_registered"} = 1;
            $info{"return_type"} = $fn_info->{"return_type"};
            $info{"param_count"} = $fn_info->{"param_count"};
            $info{"params"} = $fn_info->{"params"};
            $info{"is_extern"} = 0;
            $info{"is_variadic"} = $fn_info->{"is_variadic"};
            $info{"variadic_param_idx"} = $fn_info->{"variadic_param_idx"};
            $info{"is_import_archive"} = 1;
            $info{"line"} = 0;
            $ctx->{"functions"}->{$name} = \%info;
        }
    }
}

func sem_sanitize_pkg(str $pkg) str {
    if (length($pkg) == 0) { return "main"; }
    my str $res = $pkg;
    my int $ci = index($res, "::");
    while ($ci >= 0) {
        $res = substr($res, 0, $ci) . "_" . substr($res, $ci + 2, length($res) - $ci - 2);
        $ci = index($res, "::");
    }
    return $res;
}

func sem_our_key(str $opkg, str $sigil, str $name) str {
    if ($sigil eq "@") {
        return $opkg . "::@" . $name;
    }
    if ($sigil eq "%") {
        return $opkg . "::%" . $name;
    }
    return $opkg . "::" . $name;
}

func sem_our_cname(str $opkg, str $sigil, str $name) str {
    my str $sp = sem_sanitize_pkg($opkg);
    if ($sigil eq "@") {
        return "__our_arr_" . $sp . "__" . $name;
    }
    if ($sigil eq "%") {
        return "__our_hash_" . $sp . "__" . $name;
    }
    return "__our_" . $sp . "__" . $name;
}

# A local named like a user function of package main (same C identifier)
# hides the function from calls in its scope. Renamed, unless the enclosing
# function has a __C__ block (which refers to locals by their Strada name).
func sem_local_hides_func(scalar $ctx, str $name) int {
    my scalar $fns = $ctx->{"functions"};
    if (!defined($fns)) { return 0; }
    my scalar $fi = $fns->{$name};
    if (!defined($fi)) { return 0; }
    if (($fi->{"is_registered"} + 0) != 1) { return 0; }
    my scalar $cf = $ctx->{"current_func"};
    if (is_valid_node($cf) == 0) { return 0; }
    if (!exists($cf->{"__has_cblock"})) {
        my hash %cb_seen = ();
        $cf->{"__has_cblock"} = sem_has_cblock($cf->{"body"}, \%cb_seen);
    }
    if (($cf->{"__has_cblock"} + 0) == 1) { return 0; }
    return 1;
}

func sem_has_cblock(scalar $n, scalar $seen) int {
    my str $rt = reftype($n);
    if ($rt eq "ARRAY") {
        my int $len = size($n);
        for (my int $i = 0; $i < $len; $i = $i + 1) {
            my scalar $e = $n->[$i];
            if (length(reftype($e)) > 0) {
                if (sem_has_cblock($e, $seen) == 1) { return 1; }
            }
        }
        return 0;
    }
    if ($rt ne "HASH") { return 0; }
    my str $id = "" . $n;
    if (exists($seen->{$id})) { return 0; }
    $seen->{$id} = 1;
    if (exists($n->{"type"}) && ($n->{"type"} + 0) == NODE_C_BLOCK()) { return 1; }
    foreach my str $k (keys(%{$n})) {
        my scalar $v = $n->{$k};
        if (length(reftype($v)) > 0) {
            if (sem_has_cblock($v, $seen) == 1) { return 1; }
        }
    }
    return 0;
}

func sem_alloc_local_cname(scalar $ctx, scalar $scope, str $name) str {
    my scalar $p = $scope->{"parent"};
    while (is_valid_scope($p) == 1) {
        my scalar $pvars = $p->{"vars"};
        if (exists($pvars->{$name}) || exists($pvars->{"$:" . $name}) || exists($pvars->{"@:" . $name}) || exists($pvars->{"%:" . $name})) {
            my int $id = ($ctx->{"local_shadow_id"} + 0) + 1;
            $ctx->{"local_shadow_id"} = $id;
            return $name . "__lsh" . $id;
        }
        $p = $p->{"parent"};
    }
    return "";
}

# Register global variables in the global scope
func register_globals(scalar $ctx, scalar $ast) void {
    my int $global_count = $ast->{"global_count"};
    if ($global_count == 0) {
        return;
    }

    my scalar $globals = $ast->{"globals"};
    my scalar $scope = $ctx->{"scope"};

    for (my int $i = 0; $i < $global_count; $i = $i + 1) {
        my scalar $gvar = $globals->[$i];
        my str $name = $gvar->{"name"};
        my int $var_type = $gvar->{"var_type"};
        my int $line = ast_get_line($gvar);

        # Handle var decls, our decls, and const decls
        my int $gvar_type = $gvar->{"type"};
        my str $sigil = "$";  # Default for consts
        if ($gvar_type == NODE_VAR_DECL() || $gvar_type == NODE_OUR_DECL()) {
            $sigil = $gvar->{"sigil"};
            sem_scalar_decl_count($ctx, $gvar);
        }
        if ($gvar_type == NODE_CONST_DECL()) {
            # the same constant twice in one package and file is an error
            # (it was silently replaced by the later value)
            my str $cd_key = ("" . $gvar->{"file"}) . "\x01" . ("" . $gvar->{"package"}) . "\x01" . $name;
            if (!defined($ctx->{"const_seen"})) { my hash %cs0 = (); $ctx->{"const_seen"} = \%cs0; }
            if (exists($ctx->{"const_seen"}->{$cd_key})) {
                semantic_error($ctx, "constant '" . $name . "' already defined (previous definition at line " . $ctx->{"const_seen"}->{$cd_key} . ")", $line);
            } else {
                $ctx->{"const_seen"}->{$cd_key} = $line;
            }
        }
        $gvar->{"orig_name"} = $name;
        if ($gvar_type == NODE_OUR_DECL()) {
            my str $opkg = "" . $gvar->{"package"};
            if (length($opkg) == 0) { $opkg = "main"; }
            $gvar->{"our_key"} = sem_our_key($opkg, $sigil, $name);
            $gvar->{"name"} = sem_our_cname($opkg, $sigil, $name);
        }

        # File-level `my`/const variables are lexical, as in Perl: the same
        # name may be declared again later (another package in the same
        # file, or another module). Every declaration must become its own C
        # global, and each reference binds to the nearest declaration before
        # it in the same file. Meanwhile `our` globals are package-scoped
        # and keyed by their package so an `our` in PkgB never hijacks a
        # file-scoped `my` or PkgA's `our` with the same bare name.
        my scalar $root_vars = $scope->{"vars"};
        my scalar $prev = $root_vars->{$name};
        if (is_valid_node($prev) == 1 && $prev->{"is_global"} == 1) {
            my scalar $decls = $prev->{"decls"};
            my int $nd = size(@{$decls});
            if ($gvar_type != NODE_OUR_DECL()) {
                # later lexical declarations get a distinct C name
                $gvar->{"name"} = $name . "__shadow" . $nd;
            }
            push(@{$decls}, $gvar);
            next;
        }

        scope_add_var($scope, $name, $sigil, $var_type, $line);
        my scalar $ginfo = $root_vars->{$name};
        $ginfo->{"is_global"} = 1;
        if ($gvar_type == NODE_OUR_DECL()) {
            $ginfo->{"is_our"} = 1;
        }
        my array @first = ();
        push(@first, $gvar);
        $ginfo->{"decls"} = \@first;
    }
}

# "" for the main file, else the module file a node came from.
func sem_file_key(scalar $node) str {
    if ($node->{"from_use"} == 1) {
        return "" . $node->{"file"};
    }
    return "";
}

func resolve_global_decl_node(scalar $ctx, scalar $info, str $name, int $ref_line, str $sigil) scalar {
    if (length($name) < 0) { return 0; }
    my scalar $decls = $info->{"decls"};
    my scalar $fn = $ctx->{"current_func"};
    my str $fkey = "";
    my int $fline = $ref_line;
    if (is_valid_node($fn) == 1) {
        $fkey = sem_file_key($fn);
        if ($fline <= 0) { $fline = ast_get_line($fn); }
    } elsif (($ctx->{"cur_from_use"} + 0) == 1) {
        $fkey = "" . $ctx->{"cur_file"};
    }
    if ($fline <= 0) { $fline = $ctx->{"cur_block_line"} + 0; }
    my str $cur_pkg = "" . $ctx->{"cur_pkg"};
    if (length($cur_pkg) == 0) { $cur_pkg = "main"; }

    my scalar $best_node = 0;
    my int $best_line = -1;
    my scalar $pkg_our_node = 0;
    my scalar $file_fallback_node = 0;
    my int $i = 0;
    while ($i < size(@{$decls})) {
        my scalar $d = $decls->[$i];
        my int $dt = $d->{"type"};
        my str $dsig = "$";
        if ($dt == NODE_VAR_DECL() || $dt == NODE_OUR_DECL()) {
            $dsig = $d->{"sigil"};
        }
        if ($dsig eq $sigil) {
            my int $eligible = 0;
            if ($dt == NODE_OUR_DECL()) {
                my str $dpkg = "" . $d->{"package"};
                if (length($dpkg) == 0) { $dpkg = "main"; }
                if ($dpkg eq $cur_pkg) {
                    $eligible = 1;
                    if (is_valid_node($pkg_our_node) == 0) {
                        $pkg_our_node = $d;
                    }
                }
            } else {
                if (sem_file_key($d) eq $fkey) {
                    $eligible = 1;
                    if (is_valid_node($file_fallback_node) == 0) {
                        $file_fallback_node = $d;
                    }
                }
            }
            if ($eligible == 1 && sem_file_key($d) eq $fkey && $fline > 0) {
                my int $dl = ast_get_line($d);
                if ($dl < $fline && $dl > $best_line) {
                    $best_line = $dl;
                    $best_node = $d;
                }
            }
        }
        $i = $i + 1;
    }
    if (is_valid_node($best_node) == 1) { return $best_node; }
    if (is_valid_node($pkg_our_node) == 1) { return $pkg_our_node; }
    if (is_valid_node($file_fallback_node) == 1) { return $file_fallback_node; }
    return 0;
}

# For a reference to a global with several file-level declarations, the C
# name of the declaration that lexically precedes the reference/function.
func resolve_shadowed_global(scalar $ctx, scalar $info, str $name, int $ref_line, str $sigil) str {
    my scalar $d = resolve_global_decl_node($ctx, $info, $name, $ref_line, $sigil);
    if (is_valid_node($d) == 1) {
        return "" . $d->{"name"};
    }
    return $name;
}

func sem_resolve_vinfo_cname(scalar $ctx, scalar $vinfo, str $orig_name, int $line, str $sigil) str {
    my str $cn = "" . $vinfo->{"c_name"};
    if (length($cn) > 0) {
        return $cn;
    }
    if ($vinfo->{"is_global"} == 1 && defined($vinfo->{"decls"})) {
        my scalar $d = resolve_global_decl_node($ctx, $vinfo, $orig_name, $line, $sigil);
        if (is_valid_node($d) == 1) {
            return "" . $d->{"name"};
        }
        semantic_error($ctx, "undefined variable '" . $sigil . $orig_name . "'", $line);
    }
    return $orig_name;
}

# ============================================================
# Validation Pass (Second Pass)
# ============================================================

# ============================================================
# Stage-0 type checking (gradual, warning-only, --strict-types)
# ============================================================
# Computes a best-effort static type for an expression and compares it
# against declarations at the four sites where both sides are already in
# hand: var-decl initializers, plain assignments, call arguments, and
# returns. `scalar`/`dynamic`/unknown are BIVARIANT — compatible with
# everything in both directions — so untyped code never warns (the
# gradual escape hatch; the runtime's StradaValue checks remain the
# soundness backstop). int/num (and the C-interop numeric kinds)
# interconvert silently by design: flagging `my int $i = $x / 2`
# (/ returns num) would bury the real findings under documented-coercion
# noise. Name-resolution note: call return types use the plain registry
# lookup; an unqualified same-package call in a non-main package may
# miss and degrade to `scalar` — that can only SUPPRESS a warning, never
# fabricate one (unlike needs_temp_cleanup, where divergence leaked).

# Type diagnostics are errors in a file that says `use strict "types";`
# (ctx "strict_err") and warnings under --strict-types.
func sem_type_diag(scalar $ctx, str $msg, int $line) void {
    if ($ctx->{"strict_err"} == 1) {
        $ctx->{"in_type_diag"} = 1;
        semantic_error($ctx, $msg, $line);
        $ctx->{"in_type_diag"} = 0;
        return;
    }
    semantic_warn($ctx, $msg, $line);
}

func stage0_is_float(int $t) int {
    if ($t == TYPE_NUM() || $t == TYPE_FLOAT32() || $t == TYPE_FLOAT64() || $t == TYPE_LONG_DOUBLE()) {
        return 1;
    }
    return 0;
}

# stage0_types_compatible, plus the strict rule: a fractional value does not
# silently become an integer (write int(...)). int -> num stays implicit.
func sem_types_ok(scalar $ctx, int $expected, int $actual) int {
    if (stage0_types_compatible($expected, $actual) == 0) { return 0; }
    if ($ctx->{"strict_err"} == 1 && stage0_is_numeric($expected) == 1
        && stage0_is_float($expected) == 0 && stage0_is_float($actual) == 1) {
        return 0;
    }
    return 1;
}

# Per-function / per-declaration switch for the type checks.
func sem_set_strict(scalar $ctx, scalar $node) void {
    my int $node_strict = 0;
    if (is_valid_node($node) == 1) { $node_strict = $node->{"strict_types"} + 0; }
    $ctx->{"strict_err"} = $node_strict;
    if ($node_strict == 1 || $ctx->{"cli_strict"} == 1) {
        $ctx->{"strict_types"} = 1;
    } else {
        $ctx->{"strict_types"} = 0;
    }
}

# Element types as the checker carries them: a TYPE_* value, or 1000 + N for
# class N of ctx "cls_names" (`array<Dog>`; the declaration node has
# elem_type scalar and elem_class "Dog").
func sem_node_et(scalar $ctx, scalar $node, str $tkey, str $ckey) int {
    my int $raw_et = $node->{$tkey} + 0;
    if ($raw_et <= 0) { return 0; }
    my str $ecn = "" . $node->{$ckey};
    if (length($ecn) == 0) { return $raw_et; }
    my scalar $ids = $ctx->{"cls_ids"};
    if (exists($ids->{$ecn})) { return $ids->{$ecn} + 0; }
    my scalar $cnames = $ctx->{"cls_names"};
    my int $nid = 1000 + size($cnames);
    push(@{$cnames}, $ecn);
    $ids->{$ecn} = $nid;
    return $nid;
}

# Class an element type names ("" for int/num/str/scalar).
func sem_et_class(scalar $ctx, int $etype) str {
    if ($etype < 1000) { return ""; }
    return "" . $ctx->{"cls_names"}->[$etype - 1000];
}

# The type an element read has as a value: an object is a scalar.
func sem_et_plain(int $etype) int {
    if ($etype >= 1000) { return TYPE_SCALAR(); }
    return $etype;
}

# 1 when CLS is ANC or inherits from it (declared `extends` / `with`).
func sem_class_isa(scalar $ctx, str $cls, str $anc) int {
    if ($cls eq $anc) { return 1; }
    my scalar $imro = sem_class_mro($ctx, $cls);
    my int $imn = size($imro);
    my int $imi = 0;
    while ($imi < $imn) {
        if (("" . $imro->[$imi]) eq $anc) { return 1; }
        $imi = $imi + 1;
    }
    return 0;
}

func sem_inherit_call_walk(scalar $n, scalar $seen, scalar $out) void {
    my str $rt = reftype($n);
    if ($rt eq "ARRAY") {
        my int $len = size($n);
        for (my int $i = 0; $i < $len; $i = $i + 1) {
            my scalar $e = $n->[$i];
            if (length(reftype($e)) > 0) { sem_inherit_call_walk($e, $seen, $out); }
        }
        return;
    }
    if ($rt ne "HASH") { return; }
    my str $id = "" . $n;
    if (exists($seen->{$id})) { return; }
    $seen->{$id} = 1;
    if (is_valid_node($n) == 1 && $n->{"type"} == NODE_CALL() && ("" . $n->{"name"}) eq "inherit") {
        $out->{"found"} = 1;
        return;
    }
    foreach my str $k (keys(%{$n})) {
        my scalar $v = $n->{$k};
        if (length(reftype($v)) > 0) { sem_inherit_call_walk($v, $seen, $out); }
    }
}

# 1 when the declared inheritance of two classes is all there is: both are
# packages of this program and nothing calls inherit() at run time. Only
# then can the checker say two classes are unrelated.
func sem_classes_static(scalar $ctx, str $cls_a, str $cls_b) int {
    if ($ctx->{"known_packages"}->{$cls_a} != 1) { return 0; }
    if ($ctx->{"known_packages"}->{$cls_b} != 1) { return 0; }
    if (!defined($ctx->{"dyn_inherit"})) {
        my hash %iseen = ();
        my hash %iout = ();
        sem_inherit_call_walk($ctx->{"prog"}, \%iseen, \%iout);
        if (exists($iout{"found"})) { $ctx->{"dyn_inherit"} = 1; } else { $ctx->{"dyn_inherit"} = 0; }
    }
    if ($ctx->{"dyn_inherit"} == 1) { return 0; }
    return 1;
}

# 1 when one object can be of both classes: one class is the other or
# inherits from it, or some class inherits from both (a Duck `with Walker`
# and `with Swimmer`). 1 too when that cannot be decided.
func sem_classes_related(scalar $ctx, str $cls_a, str $cls_b) int {
    if ($cls_a eq $cls_b) { return 1; }
    if (sem_classes_static($ctx, $cls_a, $cls_b) == 0) { return 1; }
    if (sem_class_isa($ctx, $cls_a, $cls_b) == 1) { return 1; }
    if (sem_class_isa($ctx, $cls_b, $cls_a) == 1) { return 1; }
    my scalar $rdesc = sem_class_descendants($ctx, $cls_a);
    my int $rdn = size($rdesc);
    my int $rdi = 0;
    while ($rdi < $rdn) {
        if (sem_class_isa($ctx, "" . $rdesc->[$rdi], $cls_b) == 1) { return 1; }
        $rdi = $rdi + 1;
    }
    return 0;
}

# 1 when any package of the program declares `use overload`.
func sem_prog_has_overloads(scalar $ctx) int {
    if (defined($ctx->{"has_ov"})) { return $ctx->{"has_ov"} + 0; }
    my int $ov_found = 0;
    my scalar $ov_prog = $ctx->{"prog"};
    if ($ov_prog) {
        my scalar $ov_tab = $ov_prog->{"overloads"};
        if ($ov_tab) {
            my array @ov_keys = keys(%{$ov_tab});
            if (size(@ov_keys) > 0) { $ov_found = 1; }
        }
    }
    $ctx->{"has_ov"} = $ov_found;
    return $ov_found;
}

# May elements of type SRC go into a container of element type DEST?
# Classes: an error only when the two are unrelated (an `array<Animal>` may
# hold Dogs, and there is no cast to say so). A class container takes no
# int/num/str elements. Objects into an int/num/str container are not
# flagged (a single object stored there is not either).
func sem_et_compat(scalar $ctx, int $dest_et, int $src_et) int {
    my str $dcl = sem_et_class($ctx, $dest_et);
    my str $scl = sem_et_class($ctx, $src_et);
    if (length($dcl) > 0 && length($scl) > 0) { return sem_classes_related($ctx, $dcl, $scl); }
    if (length($dcl) > 0) {
        if ($src_et == TYPE_INT() || $src_et == TYPE_NUM() || $src_et == TYPE_STR()) { return 0; }
        return 1;
    }
    if (length($scl) > 0) { return 1; }
    return sem_types_ok($ctx, $dest_et, $src_et);
}

# Declared element type of the array/hash variable a node names (0 = none).
func sem_var_elem_type(scalar $ctx, scalar $vnode, str $sigil) int {
    if (is_valid_node($vnode) == 0) { return 0; }
    if ($vnode->{"type"} != NODE_VARIABLE()) { return 0; }
    my str $vname = "" . $vnode->{"orig_name"};
    if (length($vname) == 0) { $vname = "" . $vnode->{"name"}; }
    return sem_name_elem_type($ctx, $vname, $sigil, ast_get_line($vnode));
}

# Declared type of a scalar variable. A file-level name is one root entry
# for `$x`, `@x` and `%x` and every redeclaration, typed by the first of
# them: the scalar's type comes from the declaration the reference binds to.
func sem_scalar_decl_type(scalar $ctx, scalar $vinfo, str $vname, int $line) int {
    if ($vinfo->{"is_global"} == 1 && defined($vinfo->{"decls"})) {
        my scalar $sd = resolve_global_decl_node($ctx, $vinfo, $vname, $line, "$");
        if (is_valid_node($sd) == 0) { return TYPE_SCALAR(); }
        if ($sd->{"type"} == NODE_CONST_DECL()) { return $vinfo->{"type"}; }
        return $sd->{"var_type"} + 0;
    }
    return $vinfo->{"type"};
}

# The same by name. A file-level variable takes the element type from the
# declaration this reference binds to: the root scope keeps one entry per
# bare name, shared by every package, sigil and file-level redeclaration.
func sem_name_elem_type(scalar $ctx, str $vname, str $sigil, int $line) int {
    my scalar $lk = scope_lookup_var_sigil($ctx->{"scope"}, $vname, $sigil);
    if ($lk->{"found"} != 1) { return 0; }
    my scalar $nvinfo = $lk->{"info"};
    if ($nvinfo->{"is_global"} == 1 && defined($nvinfo->{"decls"})) {
        my scalar $gd = resolve_global_decl_node($ctx, $nvinfo, $vname, $line, $sigil);
        if (is_valid_node($gd) == 0) { return 0; }
        if ($gd->{"type"} != NODE_VAR_DECL() && $gd->{"type"} != NODE_OUR_DECL()) { return 0; }
        return sem_node_et($ctx, $gd, "elem_type", "elem_class");
    }
    return $nvinfo->{"elem_type"} + 0;
}

# Declared element type of what an expression yields as a whole array ("@")
# or hash ("%"): a variable's, or that of a call to a function whose return
# type carries one. 0 = not known.
func sem_src_elem_type(scalar $ctx, scalar $node, str $sigil) int {
    if (is_valid_node($node) == 0) { return 0; }
    my int $nt = $node->{"type"};
    if ($nt == NODE_VARIABLE()) {
        if (("" . $node->{"sigil"}) ne $sigil) { return 0; }
        return sem_var_elem_type($ctx, $node, $sigil);
    }
    if ($nt == NODE_CALL()) {
        my scalar $cfi = sem_call_fn_info($ctx, $node);
        if ($cfi->{"is_registered"} != 1) { return 0; }
        my int $want_rt = TYPE_ARRAY();
        if ($sigil eq "%") { $want_rt = TYPE_HASH(); }
        if ($cfi->{"return_type"} != $want_rt) { return 0; }
        my scalar $cfn = $cfi->{"node"};
        if (is_valid_node($cfn) == 0) { return 0; }
        return sem_node_et($ctx, $cfn, "return_elem_type", "return_elem_class");
    }
    return 0;
}

# The function table entry a call node resolved to (analyze_expression
# records the key: an unqualified or `Pkg::f` call is registered under
# another spelling than the node's name).
func sem_call_fn_info(scalar $ctx, scalar $node) scalar {
    my str $fk = "" . $node->{"sem_fn_key"};
    if (length($fk) > 0) { return $ctx->{"functions"}->{$fk}; }
    # not analyzed yet (a check that runs before the arguments are)
    my str $cn = "" . $node->{"name"};
    # a builtin always wins over a function of the same name, and the
    # analyzer never records a key for it
    if ($ctx->{"builtins"}->{$cn} == 1) { return $ctx->{"functions"}->{""}; }
    my scalar $direct = $ctx->{"functions"}->{$cn};
    if ($direct->{"is_registered"} == 1) { return $direct; }
    my int $qcol = rindex($cn, "::");
    if ($qcol > 0) {
        return $ctx->{"functions"}->{sem_pkg_fn_key($ctx, substr($cn, 0, $qcol), substr($cn, $qcol + 2, length($cn) - $qcol - 2))};
    }
    my str $cpk = "" . $ctx->{"cur_pkg"};
    if ($ctx->{"current_func"}) { $cpk = "" . $ctx->{"current_func"}->{"package"}; }
    if (length($cpk) == 0 || $cpk eq "main") { return $direct; }
    return $ctx->{"functions"}->{sem_pkg_fn_key($ctx, $cpk, $cn)};
}

# `Pkg::name` for a package function whose name carries the C prefix.
func sem_fn_display(str $pkg, str $fname) str {
    if (length($pkg) == 0 || $pkg eq "main") { return $fname; }
    my str $c_pk = $pkg;
    my int $pci = index($c_pk, "::");
    while ($pci >= 0) {
        $c_pk = substr($c_pk, 0, $pci) . "_" . substr($c_pk, $pci + 2, length($c_pk) - $pci - 2);
        $pci = index($c_pk, "::");
    }
    my int $plen = length($c_pk) + 1;
    if (length($fname) > $plen && substr($fname, 0, $plen) eq $c_pk . "_") {
        return $pkg . "::" . substr($fname, $plen, length($fname) - $plen);
    }
    if (index($fname, "::") >= 0) { return $fname; }
    return $pkg . "::" . $fname;
}

# How a diagnostic names such a source.
func sem_src_display(scalar $ctx, scalar $node, str $sigil) str {
    if ($node->{"type"} == NODE_CALL()) {
        my str $dpkg = "" . $node->{"sem_fn_pkg"};
        if (length("" . $node->{"sem_fn_key"}) == 0) {
            my scalar $dfi = sem_call_fn_info($ctx, $node);
            if ($dfi->{"is_registered"} == 1) { $dpkg = "" . $dfi->{"package"}; }
        }
        return "the result of '" . sem_fn_display($dpkg, "" . $node->{"name"}) . "'";
    }
    return "'" . $sigil . sem_var_display_name($node) . "'";
}

# How a diagnostic names the typed container being written: the variable, or
# (ctx `elem_where`, set while a `return` is checked) the function's result.
func sem_elem_dest(scalar $ctx, str $cname, str $csigil, int $etype) str {
    my str $ew = "" . $ctx->{"elem_where"};
    if (length($ew) > 0) { return $ew; }
    return "'" . $csigil . $cname . "' (declared " . sem_elem_type_name($ctx, $csigil, $etype) . ")";
}

func sem_var_display_name(scalar $vnode) str {
    my str $vname = "" . $vnode->{"orig_name"};
    if (length($vname) == 0) { $vname = "" . $vnode->{"name"}; }
    return $vname;
}

func sem_elem_type_name(scalar $ctx, str $sigil, int $etype) str {
    my str $etn = sem_et_class($ctx, $etype);
    if (length($etn) == 0) { $etn = ast_data_type_name($etype); }
    if ($sigil eq "%") { return "hash<" . $etn . ">"; }
    return "array<" . $etn . ">";
}

# One value going into a typed container. A list literal is checked element
# by element; an array variable by its own declared element type.
func sem_check_elem_value(scalar $ctx, int $etype, scalar $val, str $cname, str $csigil, int $line) void {
    if (is_valid_node($val) == 0) { return; }
    my int $vt = $val->{"type"};
    if ($vt == NODE_ANON_ARRAY() && $val->{"is_list"} == 1) {
        my scalar $elems = $val->{"elements"};
        my int $ecount = $val->{"element_count"};
        my int $ei = 0;
        while ($ei < $ecount) {
            sem_check_elem_value($ctx, $etype, $elems->[$ei], $cname, $csigil, $line);
            $ei = $ei + 1;
        }
        return;
    }
    if ($vt == NODE_VARIABLE() && ("" . $val->{"sigil"}) eq "@") {
        my int $src_et = sem_var_elem_type($ctx, $val, "@");
        if ($src_et > 0 && sem_et_compat($ctx, $etype, $src_et) == 0) {
            sem_type_diag($ctx, "putting the elements of '@" . sem_var_display_name($val) . "' ("
                . sem_elem_type_name($ctx, "@", $src_et) . ") into " . sem_elem_dest($ctx, $cname, $csigil, $etype), $line);
        }
        return;
    }
    if ($vt == NODE_CALL()) {
        my int $call_et = sem_src_elem_type($ctx, $val, "@");
        if ($call_et > 0) {
            if (sem_et_compat($ctx, $etype, $call_et) == 0) {
                sem_type_diag($ctx, "putting " . sem_src_display($ctx, $val, "@") . " ("
                    . sem_elem_type_name($ctx, "@", $call_et) . ") into " . sem_elem_dest($ctx, $cname, $csigil, $etype), $line);
            }
            return;
        }
    }
    if ($vt == NODE_VARIABLE() && ("" . $val->{"sigil"}) eq "%") { return; }
    my int $atype = stage0_expr_type($ctx, $val);
    if ($atype == TYPE_ARRAY() || $atype == TYPE_HASH()) { return; }
    my str $dest_cls = sem_et_class($ctx, $etype);
    if (length($dest_cls) > 0) {
        my str $val_cls = sem_value_class($ctx, $val);
        my int $val_exact = $ctx->{"recv_exact"} + 0;
        if (length($val_cls) > 0) {
            my int $fits = 1;
            if ($val_exact == 1) {
                if (sem_classes_static($ctx, $val_cls, $dest_cls) == 1) { $fits = sem_class_isa($ctx, $val_cls, $dest_cls); }
            } else {
                $fits = sem_classes_related($ctx, $val_cls, $dest_cls);
            }
            if ($fits == 0) {
                sem_type_diag($ctx, "storing a '" . $val_cls . "' object in "
                    . sem_elem_dest($ctx, $cname, $csigil, $etype), $line);
            }
            return;
        }
        if ($atype == TYPE_INT() || $atype == TYPE_NUM() || $atype == TYPE_STR()) {
            sem_type_diag($ctx, "storing a " . ast_data_type_name($atype) . " value in "
                . sem_elem_dest($ctx, $cname, $csigil, $etype), $line);
        }
        return;
    }
    if (sem_types_ok($ctx, $etype, $atype) == 0) {
        sem_type_diag($ctx, "storing a " . ast_data_type_name($atype) . " value in "
            . sem_elem_dest($ctx, $cname, $csigil, $etype), $line);
    }
}

# The values of a hash written as a literal list: `(k => v, ...)` (key/value
# pairs flattened into a list, or a hash-literal node).
func sem_check_hash_literal(scalar $ctx, int $etype, scalar $val, str $cname, int $line) void {
    if (is_valid_node($val) == 0) { return; }
    my int $hvt = $val->{"type"};
    if ($hvt == NODE_VARIABLE() || $hvt == NODE_CALL()) {
        # a whole hash: another typed hash, or a call returning one
        my int $hsrc_et = sem_src_elem_type($ctx, $val, "%");
        if ($hsrc_et > 0 && sem_et_compat($ctx, $etype, $hsrc_et) == 0) {
            sem_type_diag($ctx, "putting the values of " . sem_src_display($ctx, $val, "%") . " ("
                . sem_elem_type_name($ctx, "%", $hsrc_et) . ") into " . sem_elem_dest($ctx, $cname, "%", $etype), $line);
        }
        return;
    }
    if ($hvt == NODE_ANON_HASH()) {
        my scalar $hvals = $val->{"values"};
        my int $hpc = $val->{"pair_count"};
        my int $hpi = 0;
        while ($hpi < $hpc) {
            sem_check_elem_value($ctx, $etype, $hvals->[$hpi], $cname, "%", $line);
            $hpi = $hpi + 1;
        }
        return;
    }
    if ($hvt == NODE_ANON_ARRAY()) {
        # a parenthesized pair list arrives as a flat list: k, v, k, v
        my scalar $helems = $val->{"elements"};
        my int $hec = $val->{"element_count"};
        # An element that can stand for several values (`%other`, `@pairs`,
        # a call, a nested list) shifts which positions are values: only a
        # list of plain scalar expressions is checked.
        my int $hsi = 0;
        while ($hsi < $hec) {
            if (sem_node_one_value($ctx, $helems->[$hsi], 1) == 0) { return; }
            $hsi = $hsi + 1;
        }
        my int $hei = 1;
        while ($hei < $hec) {
            my scalar $hel = $helems->[$hei];
            if (is_valid_node($hel) == 1 && $hel->{"type"} != NODE_VARIABLE()) {
                sem_check_elem_value($ctx, $etype, $hel, $cname, "%", $line);
            }
            $hei = $hei + 2;
        }
    }
}

# `$a[i] = v`, `$h{k} = v`, `@a = LIST`, `%h = (k => v)` on a container with a
# declared element type.
func sem_check_elem_assign(scalar $ctx, scalar $expr) void {
    my scalar $tgt = $expr->{"target"};
    if (is_valid_node($tgt) == 0) { return; }
    my int $tt = $tgt->{"type"};
    my scalar $cvar = 0;
    my str $csigil = "@";
    if ($tt == NODE_SUBSCRIPT()) {
        $cvar = $tgt->{"array"};
    } elsif ($tt == NODE_HASH_ACCESS()) {
        $cvar = $tgt->{"hash"};
        $csigil = "%";
    } elsif ($tt == NODE_VARIABLE() && ("" . $tgt->{"sigil"}) eq "@") {
        $cvar = $tgt;
    } elsif ($tt == NODE_VARIABLE() && ("" . $tgt->{"sigil"}) eq "%") {
        my int $whole_et = sem_var_elem_type($ctx, $tgt, "%");
        if ($whole_et > 0) {
            my int $wline = ast_get_line($expr);
            if ($wline == 0) { $wline = ast_get_line($tgt); }
            if ($wline == 0) { $wline = ast_get_line($expr->{"value"}); }
            sem_check_hash_literal($ctx, $whole_et, $expr->{"value"}, sem_var_display_name($tgt), $wline);
        }
        return;
    } else {
        return;
    }
    my int $etype = sem_var_elem_type($ctx, $cvar, $csigil);
    if ($etype <= 0) { return; }
    my int $aline = ast_get_line($expr);
    if ($aline == 0) { $aline = ast_get_line($tgt); }
    if ($aline == 0) { $aline = ast_get_line($expr->{"value"}); }
    sem_check_elem_value($ctx, $etype, $expr->{"value"}, sem_var_display_name($cvar), $csigil, $aline);
}

# push(@a, LIST) / unshift(@a, LIST) on an array with a declared element type.
func sem_check_typed_push(scalar $ctx, scalar $expr, int $line) void {
    my str $cname = "" . $expr->{"name"};
    if ($cname ne "push" && $cname ne "unshift") { return; }
    my scalar $args = $expr->{"args"};
    my int $argc = $expr->{"arg_count"};
    if ($argc < 2) { return; }
    my scalar $first = $args->[0];
    if (is_valid_node($first) == 0) { return; }
    if ($first->{"type"} != NODE_VARIABLE() || ("" . $first->{"sigil"}) ne "@") { return; }
    my int $etype = sem_var_elem_type($ctx, $first, "@");
    if ($etype <= 0) { return; }
    my int $ai = 1;
    while ($ai < $argc) {
        sem_check_elem_value($ctx, $etype, $args->[$ai], sem_var_display_name($first), "@", $line);
        $ai = $ai + 1;
    }
}

# ------------------------------------------------------------------
# Method calls: what the checker knows about the receiver's class.
#
# A receiver has a known class when it is `$self` in a package's function, a
# variable declared `my $v = Pkg::new(...)`, a typed catch variable, or a
# class name (`Pkg->m()`), and (for variables) the function never assigns
# the variable again. The method is then looked up along the class's
# inheritance chain. Everything else is unchecked, like untyped code.
# ------------------------------------------------------------------

# 1 if this function, used as a constructor, always returns an object of its
# own package: the synthesized `has` constructor, or a function whose every
# bless() names its own package literally (or uses the 1-argument form).
# A hand-written `new($class)` that blesses into its argument may return a
# subclass, so devirtualizing on its package would call the wrong method.
# (Codegen uses it for devirtualization, the type checker for receivers.)
func fn_ctor_own_class(scalar $fn) int {
    if (defined($fn->{"ctor_own_class"})) { return $fn->{"ctor_own_class"} + 0; }
    if (($fn->{"is_synthesized"} + 0) == 1) { return 1; }
    my scalar $body = $fn->{"body"};
    if (!$body) { return 0; }
    my str $pkg = "" . $fn->{"package"};
    my hash %st = ();
    $st{"bless"} = 0;
    $st{"bad"} = 0;
    ctor_bless_scan($body, $pkg, \%st, 0);
    if ($st{"bless"} > 0 && $st{"bad"} == 0) { return 1; }
    return 0;
}

func ctor_bless_scan(scalar $n, str $pkg, scalar $st, int $depth) void {
    if ($depth > 300) { $st->{"bad"} = 1; return; }
    my str $rt = reftype($n);
    if ($rt eq "ARRAY") {
        my int $k = 0;
        while ($k < size($n)) {
            ctor_bless_scan($n->[$k], $pkg, $st, $depth + 1);
            $k = $k + 1;
        }
        return;
    }
    if ($rt ne "HASH") { return; }
    if (($n->{"type"} + 0) == NODE_CALL() && ("" . $n->{"name"}) eq "bless") {
        $st->{"bless"} = $st->{"bless"} + 1;
        my scalar $bargs = $n->{"args"};
        my int $bac = $n->{"arg_count"} + 0;
        if ($bac >= 2) {
            my scalar $cls = $bargs->[1];
            if (!$cls || ($cls->{"type"} + 0) != NODE_STR_LITERAL() || ("" . $cls->{"value"}) ne $pkg) {
                $st->{"bad"} = 1;
            }
        }
    }
    foreach my str $key (keys(%{$n})) {
        my scalar $v = $n->{$key};
        my str $vt = reftype($v);
        if ($vt eq "HASH" || $vt eq "ARRAY") {
            ctor_bless_scan($v, $pkg, $st, $depth + 1);
        }
    }
}

# Key in ctx "functions" of PKG's own function MNAME ("" = none).
func sem_pkg_fn_key(scalar $ctx, str $pkg, str $mname) str {
    if (length($pkg) == 0 || $pkg eq "main") { return ""; }
    my scalar $fns = $ctx->{"functions"};
    my str $cpk = sem_sanitize_pkg($pkg);
    my str $k1 = $cpk . "_" . $mname;
    if (exists($fns->{$k1})) { return $k1; }
    my str $k2 = $pkg . "::" . $mname;
    if (exists($fns->{$k2})) { return $k2; }
    my str $k3 = $cpk . "::" . $mname;
    if (exists($fns->{$k3})) { return $k3; }
    return "";
}

func sem_class_mro(scalar $ctx, str $pkg) scalar {
    my scalar $cache = $ctx->{"mro_cache"};
    if (exists($cache->{$pkg})) { return $cache->{$pkg}; }
    my array @chain = ();
    my hash %seen = ();
    my scalar $prog = $ctx->{"prog"};
    collect_mro_dfs($prog->{"inherits"}, $prog->{"inherit_count"} + 0, $pkg, \@chain, \%seen);
    $cache->{$pkg} = \@chain;
    return \@chain;
}

# Every class that inherits from PKG, directly or not.
func sem_class_descendants(scalar $ctx, str $pkg) scalar {
    my scalar $cache = $ctx->{"desc_cache"};
    if (exists($cache->{$pkg})) { return $cache->{$pkg}; }
    my array @found = ();
    my hash %seen = ();
    $seen{$pkg} = 1;
    my array @work = ();
    push(@work, $pkg);
    my scalar $prog = $ctx->{"prog"};
    my scalar $inhs = $prog->{"inherits"};
    my int $inh_n = $prog->{"inherit_count"} + 0;
    my int $wi = 0;
    while ($wi < size(@work)) {
        my str $cur = "" . $work[$wi];
        $wi = $wi + 1;
        my int $ii = 0;
        while ($ii < $inh_n) {
            my scalar $ent = $inhs->[$ii];
            my str $ch = "" . $ent->{"child"};
            if (("" . $ent->{"parent"}) eq $cur && !exists($seen{$ch})) {
                $seen{$ch} = 1;
                push(@work, $ch);
                push(@found, $ch);
            }
            $ii = $ii + 1;
        }
    }
    $cache->{$pkg} = \@found;
    return \@found;
}

# First function named MNAME along CLS's inheritance chain, starting at
# position FROM (1 = skip the class itself, for SUPER::).
func sem_mro_find(scalar $ctx, str $cls, str $mname, int $from) str {
    my scalar $mro = sem_class_mro($ctx, $cls);
    my int $mn = size($mro);
    my int $mi = $from;
    while ($mi < $mn) {
        my str $fk = sem_pkg_fn_key($ctx, "" . $mro->[$mi], $mname);
        if (length($fk) > 0) { return $fk; }
        $mi = $mi + 1;
    }
    return "";
}

# The function a call of MNAME on a CLS object runs, as a key in ctx
# "functions", or "" when that is not certain: no such method is known, an
# `around` modifier may change the arguments, or (EXACT 0: the object may be
# of a subclass) some subclass resolves the name to another function.
func sem_method_target(scalar $ctx, str $cls, int $exact, str $mname, int $from) str {
    if (length($cls) == 0) { return ""; }
    my str $fk = sem_mro_find($ctx, $cls, $mname, $from);
    if (length($fk) == 0) { return ""; }
    my scalar $prog = $ctx->{"prog"};
    my scalar $mods = $prog->{"method_modifiers"};
    my int $mod_n = $prog->{"method_modifier_count"} + 0;
    my int $mdi = 0;
    while ($mdi < $mod_n) {
        my scalar $md = $mods->[$mdi];
        if (("" . $md->{"method_name"}) eq $mname) {
            my str $mkind = lc("" . $md->{"mod_type"});
            if ($mkind ne "before" && $mkind ne "after") { return ""; }
        }
        $mdi = $mdi + 1;
    }
    if ($exact == 0) {
        my scalar $desc = sem_class_descendants($ctx, $cls);
        my int $dn = size($desc);
        my int $di = 0;
        while ($di < $dn) {
            if (sem_mro_find($ctx, "" . $desc->[$di], $mname, 0) ne $fk) { return ""; }
            $di = $di + 1;
        }
    }
    return $fk;
}

# Scalar variables the function writes anywhere after their declaration
# (by name: a nested block's variable of the same name counts too).
func sem_assigned_walk(scalar $n, scalar $seen, scalar $out) void {
    my str $rt = reftype($n);
    if ($rt eq "ARRAY") {
        my int $len = size($n);
        for (my int $i = 0; $i < $len; $i = $i + 1) {
            my scalar $e = $n->[$i];
            if (length(reftype($e)) > 0) { sem_assigned_walk($e, $seen, $out); }
        }
        return;
    }
    if ($rt ne "HASH") { return; }
    my str $id = "" . $n;
    if (exists($seen->{$id})) { return; }
    $seen->{$id} = 1;
    if (exists($n->{"type"})) {
        my int $t = $n->{"type"} + 0;
        my scalar $wr = 0;
        if ($t == NODE_ASSIGN()) { $wr = $n->{"target"}; }
        if ($t == NODE_INCREMENT()) { $wr = $n->{"operand"}; }
        if ($t == NODE_REF()) { $wr = $n->{"target"}; }
        if (is_valid_node($wr) == 1 && $wr->{"type"} == NODE_VARIABLE()) {
            my str $wname = sem_var_display_name($wr);
            $out->{$wname} = 1;
        }
        if ($t == NODE_DESTRUCTURE() && ($n->{"is_decl"} + 0) == 0) {
            my scalar $dvars = $n->{"vars"};
            my int $dvn = $n->{"var_count"} + 0;
            for (my int $dvi = 0; $dvi < $dvn; $dvi = $dvi + 1) {
                my scalar $dv = $dvars->[$dvi];
                if (is_valid_node($dv) == 1 && $dv->{"type"} == NODE_VARIABLE()) {
                    my str $dname = sem_var_display_name($dv);
                    $out->{$dname} = 1;
                } elsif (length(reftype($dv)) == 0) {
                    my str $dstr = "" . $dv;
                    $out->{$dstr} = 1;
                } elsif (reftype($dv) eq "HASH" && exists($dv->{"name"})) {
                    my str $dhn = "" . $dv->{"name"};
                    $out->{$dhn} = 1;
                }
            }
        }
        if ($t == NODE_FOREACH_STMT() && is_valid_node($n->{"var_decl"}) == 0) {
            my str $fvn = "" . $n->{"var_name"};
            $out->{$fvn} = 1;
        }
        if ($t == NODE_C_BLOCK()) { $out->{"\x01all"} = 1; }
    }
    foreach my str $k (keys(%{$n})) {
        my scalar $v = $n->{$k};
        if (length(reftype($v)) > 0) { sem_assigned_walk($v, $seen, $out); }
    }
}

# 1 when the function being analyzed never writes scalar NAME after its
# declaration, so a class recorded for it holds wherever it is read.
func sem_var_stable(scalar $ctx, str $name) int {
    my scalar $root = $ctx->{"asg_root"};
    if (is_valid_node($root) == 0) { return 0; }
    my scalar $aset = $ctx->{"asg_set"};
    if (!$aset) { return 0; }
    if (exists($aset->{"\x01all"}) || exists($aset->{$name})) { return 0; }
    return 1;
}

# Class of the object a `Pkg::new(...)` call returns ("" = not known).
func sem_ctor_class(scalar $ctx, scalar $call) str {
    if (is_valid_node($call) == 0) { return ""; }
    if ($call->{"type"} != NODE_CALL()) { return ""; }
    my str $cname = "" . $call->{"name"};
    my int $lc2 = rindex($cname, "::");
    if ($lc2 <= 0) { return ""; }
    if (substr($cname, $lc2 + 2, length($cname) - $lc2 - 2) ne "new") { return ""; }
    my str $cpkg = substr($cname, 0, $lc2);
    if ($cpkg eq "main") { return ""; }
    my str $fk = sem_pkg_fn_key($ctx, $cpkg, "new");
    if (length($fk) == 0) {
        # no constructor: the call builds a blessed hash of that class
        if ($ctx->{"known_packages"}->{$cpkg} == 1) { return $cpkg; }
        return "";
    }
    my scalar $cnode = $ctx->{"functions"}->{$fk}->{"node"};
    if (is_valid_node($cnode) == 1 && fn_ctor_own_class($cnode) == 1) { return $cpkg; }
    return "";
}

# Class of a method call's receiver ("" = not known). Sets ctx "recv_exact":
# 1 when the object is of exactly that class, 0 when it may be a subclass.
func sem_recv_class(scalar $ctx, scalar $recv) str {
    $ctx->{"recv_exact"} = 0;
    if (is_valid_node($recv) == 0) { return ""; }
    my int $rt = $recv->{"type"};
    if ($rt == NODE_VARIABLE() && ("" . $recv->{"sigil"}) eq "$") {
        my str $vname = sem_var_display_name($recv);
        my scalar $lk = scope_lookup_var_sigil($ctx->{"scope"}, $vname, "$");
        if ($lk->{"found"} != 1) { return ""; }
        my str $ocls = "" . $lk->{"info"}->{"obj_class"};
        if (length($ocls) == 0) { return ""; }
        if (sem_var_stable($ctx, $vname) == 0) { return ""; }
        $ctx->{"recv_exact"} = $lk->{"info"}->{"obj_exact"} + 0;
        return $ocls;
    }
    if ($rt == NODE_SUBSCRIPT()) {
        return sem_et_class($ctx, sem_var_elem_type($ctx, $recv->{"array"}, "@"));
    }
    if ($rt == NODE_HASH_ACCESS()) {
        return sem_et_class($ctx, sem_var_elem_type($ctx, $recv->{"hash"}, "%"));
    }
    if ($rt == NODE_CALL()) {
        my str $rcn = "" . $recv->{"name"};
        if (($rcn eq "shift" || $rcn eq "pop") && $recv->{"arg_count"} == 1) {
            my scalar $rsp = $recv->{"args"}->[0];
            if (is_valid_node($rsp) == 1 && $rsp->{"type"} == NODE_VARIABLE() && ("" . $rsp->{"sigil"}) eq "@") {
                return sem_et_class($ctx, sem_var_elem_type($ctx, $rsp, "@"));
            }
            return "";
        }
        my str $ccls = sem_ctor_class($ctx, $recv);
        if (length($ccls) > 0) { $ctx->{"recv_exact"} = 1; }
        return $ccls;
    }
    if ($rt == NODE_STR_LITERAL()) {
        my str $lcls = "" . $recv->{"value"};
        if ($ctx->{"known_packages"}->{$lcls} == 1) {
            $ctx->{"recv_exact"} = 1;
            return $lcls;
        }
    }
    return "";
}

# Class of the object an expression yields as a value ("" = not known);
# sets ctx "recv_exact" like sem_recv_class. A class-name string is a
# receiver, not an object.
func sem_value_class(scalar $ctx, scalar $val) str {
    $ctx->{"recv_exact"} = 0;
    if (is_valid_node($val) == 0) { return ""; }
    if ($val->{"type"} == NODE_STR_LITERAL()) { return ""; }
    return sem_recv_class($ctx, $val);
}

# Record on a scalar's scope entry that it holds an object of CLS.
func sem_note_obj_class(scalar $ctx, scalar $scope, str $key, str $cls, int $exact) void {
    if (length($cls) == 0) { return; }
    if ($ctx->{"strict_types"} != 1) { return; }
    # only inside a function: a file-level variable can be assigned by any
    # function, which the per-function write scan does not see
    if (is_valid_node($ctx->{"asg_root"}) == 0) { return; }
    my scalar $vinfo = $scope->{"vars"}->{$key};
    if (!$vinfo) { return; }
    $vinfo->{"obj_class"} = $cls;
    $vinfo->{"obj_exact"} = $exact;
}

# 1 when the expression stands for exactly one value. An array, hash, list,
# slice, `@{...}` / `%{...}`, spread or list-returning call can stand for
# several, which shifts the position of everything after it in a list.
# IN_LIST 1: the expression is an element of a list (a method call or `?:`
# there may yield a list); 0: it is a method-call argument.
func sem_node_one_value(scalar $ctx, scalar $pa, int $in_list) int {
    if (is_valid_node($pa) == 0) { return 0; }
    my int $pt = $pa->{"type"};
    if ($pt == NODE_SPREAD() || $pt == NODE_ARRAY_SLICE() || $pt == NODE_HASH_SLICE()) { return 0; }
    if ($pt == NODE_MAP() || $pt == NODE_GREP() || $pt == NODE_SORT() || $pt == NODE_RANGE()) { return 0; }
    if ($pt == NODE_ANON_ARRAY() || $pt == NODE_ANON_HASH()) { return 0; }
    if ($pt == NODE_DEREF_SCALAR() && ("" . $pa->{"sigil"}) ne "$") { return 0; }
    if ($pt == NODE_VARIABLE() && ("" . $pa->{"sigil"}) ne "$") { return 0; }
    if ($in_list == 1 && ($pt == NODE_METHOD_CALL() || $pt == NODE_TERNARY())) { return 0; }
    if ($pt == NODE_CALL()) {
        # a user function with a scalar return type is one value; a
        # builtin (split, keys, ...) may be a list
        if (length(sem_ctor_class($ctx, $pa)) > 0) { return 1; }
        my scalar $pfi = $ctx->{"functions"}->{"" . $pa->{"name"}};
        if ($pfi->{"is_registered"} != 1) { return 0; }
        my int $prt = $pfi->{"return_type"};
        if ($prt == TYPE_ARRAY() || $prt == TYPE_HASH() || $prt == TYPE_DYNAMIC()) { return 0; }
    }
    return 1;
}

func sem_args_positional(scalar $ctx, scalar $args, int $argc) int {
    my int $pi = 0;
    while ($pi < $argc) {
        if (sem_node_one_value($ctx, $args->[$pi], 1) == 0) { return 0; }
        $pi = $pi + 1;
    }
    return 1;
}

# Arguments of `$obj->m(...)` / `SUPER::m(...)` against the parameters of the
# function FK names. Parameter 0 is the invocant.
func sem_check_method_args(scalar $ctx, str $fk, str $mname, scalar $args, int $argc, int $line) void {
    my scalar $fn_info = $ctx->{"functions"}->{$fk};
    # a method-call node may carry no line: use its first argument's
    if ($line <= 0) { $line = ast_get_line($args->[0]); }
    if ($line <= 0) { $line = $ctx->{"cur_stmt_line"} + 0; }
    if ($fn_info->{"is_registered"} != 1) { return; }
    # Method arguments are not flattened: only a spread moves positions.
    my int $spi = 0;
    while ($spi < $argc) {
        if (is_valid_node($args->[$spi]) == 0) { return; }
        if ($args->[$spi]->{"type"} == NODE_SPREAD()) { return; }
        $spi = $spi + 1;
    }
    my scalar $params = $fn_info->{"params"};
    my int $pcount = $fn_info->{"param_count"} + 0;
    my int $ai = 0;
    while ($ai < $argc) {
        my int $pidx = $ai + 1;
        if ($pidx >= $pcount) { return; }
        my scalar $mparam = $params->[$pidx];
        if (($mparam->{"is_variadic"} + 0) == 1) { return; }
        if (("" . $mparam->{"sigil"}) eq "$" && sem_node_one_value($ctx, $args->[$ai], 0) == 1) {
            my int $ptype = $mparam->{"param_type"};
            my int $atype = stage0_expr_type($ctx, $args->[$ai]);
            if (sem_types_ok($ctx, $ptype, $atype) == 0) {
                my int $argno = $ai + 1;
                sem_type_diag($ctx, "argument " . $argno . " to '" . $fn_info->{"package"} . "::" . $mname
                    . "': expected " . ast_data_type_name($ptype)
                    . ", got " . ast_data_type_name($atype), $line);
            }
        }
        $ai = $ai + 1;
    }
}

# `Pkg::new(name => v, ...)` on a class with a generated constructor: each
# value against its attribute's declared type (own and inherited attributes).
func sem_check_ctor_args(scalar $ctx, scalar $call, int $line) void {
    my str $cls = sem_ctor_class($ctx, $call);
    if (length($cls) == 0) { return; }
    my str $fk = sem_pkg_fn_key($ctx, $cls, "new");
    if (length($fk) == 0) { return; }
    my scalar $cnode = $ctx->{"functions"}->{$fk}->{"node"};
    if (is_valid_node($cnode) == 0) { return; }
    if (($cnode->{"is_synthesized"} + 0) != 1) { return; }
    my scalar $args = $call->{"args"};
    my int $argc = $call->{"arg_count"} + 0;
    if (($argc % 2) != 0) { return; }
    if (sem_args_positional($ctx, $args, $argc) == 0) { return; }
    my scalar $prog = $ctx->{"prog"};
    my scalar $attrs = $prog->{"has_attrs"};
    my int $attr_n = $prog->{"has_attr_count"} + 0;
    my scalar $mro = sem_class_mro($ctx, $cls);
    my int $mn = size($mro);
    my int $ki = 0;
    while ($ki < $argc) {
        my scalar $knode = $args->[$ki];
        if ($knode->{"type"} == NODE_STR_LITERAL()) {
            my str $kname = "" . $knode->{"value"};
            my int $want = 0;
            my str $owner = "";
            my int $mi = 0;
            while ($mi < $mn && $want == 0) {
                my str $mpkg = "" . $mro->[$mi];
                my int $ati = 0;
                while ($ati < $attr_n && $want == 0) {
                    my scalar $att = $attrs->[$ati];
                    if (("" . $att->{"name"}) eq $kname && ("" . $att->{"package"}) eq $mpkg) {
                        $want = $att->{"attr_type"} + 0;
                        $owner = $mpkg;
                    }
                    $ati = $ati + 1;
                }
                $mi = $mi + 1;
            }
            if ($want > 0) {
                my int $have = stage0_expr_type($ctx, $args->[$ki + 1]);
                if (sem_types_ok($ctx, $want, $have) == 0) {
                    sem_type_diag($ctx, "attribute '" . $kname . "' of '" . $owner
                        . "': expected " . ast_data_type_name($want)
                        . ", got " . ast_data_type_name($have), $line);
                }
            }
        }
        $ki = $ki + 2;
    }
}

func stage0_is_numeric(int $t) int {
    if ($t == TYPE_INT() || $t == TYPE_NUM() || $t == TYPE_BOOL() || $t == TYPE_ENUM()
        || $t == TYPE_INT8() || $t == TYPE_INT16() || $t == TYPE_INT32() || $t == TYPE_INT64()
        || $t == TYPE_UINT8() || $t == TYPE_UINT16() || $t == TYPE_UINT32() || $t == TYPE_UINT64()
        || $t == TYPE_SIZE_T() || $t == TYPE_CHAR()
        || $t == TYPE_FLOAT32() || $t == TYPE_FLOAT64() || $t == TYPE_LONG_DOUBLE()) {
        return 1;
    }
    return 0;
}

func stage0_types_compatible(int $expected, int $actual) int {
    if ($expected == $actual) { return 1; }
    # A void result is never a usable value — flag even for untyped targets.
    if ($actual == TYPE_VOID()) { return 0; }
    # Bivariant: scalar/dynamic/unknown on either side accepts everything.
    if ($expected == TYPE_SCALAR() || $expected == TYPE_DYNAMIC() || $expected <= 0) { return 1; }
    if ($actual == TYPE_SCALAR() || $actual == TYPE_DYNAMIC() || $actual <= 0) { return 1; }
    # The numeric family interconverts silently (documented coercions).
    if (stage0_is_numeric($expected) == 1 && stage0_is_numeric($actual) == 1) { return 1; }
    return 0;
}

# Best-effort static type of an expression; TYPE_SCALAR when unknown.
func stage0_expr_type(scalar $ctx, scalar $expr) int {
    if (is_valid_node($expr) == 0) { return TYPE_SCALAR(); }
    my int $t = $expr->{"type"};
    # a list-returning call read as one value (sem_scalar_of)
    if ($expr->{"sc_count"}) { return TYPE_SCALAR(); }
    if ($t == NODE_INT_LITERAL()) { return TYPE_INT(); }
    if ($t == NODE_NUM_LITERAL()) { return TYPE_NUM(); }
    if ($t == NODE_STR_LITERAL()) {
        # A one-character single-quoted literal is also its character code
        # where an int is wanted (`my int $c = '/';`): fits either type.
        if (($expr->{"has_char_code"} + 0) == 1) { return TYPE_SCALAR(); }
        return TYPE_STR();
    }
    if ($t == NODE_VARIABLE()) {
        my str $sigil = $expr->{"sigil"};
        if ($sigil eq "@") { return TYPE_ARRAY(); }
        if ($sigil eq "%") { return TYPE_HASH(); }
        my str $vname = $expr->{"orig_name"};
        if (length($vname) == 0) { $vname = "" . $expr->{"name"}; }
        my scalar $lk = scope_lookup_var_sigil($ctx->{"scope"}, $vname, "$");
        if ($lk->{"found"} == 1) {
            return sem_scalar_decl_type($ctx, $lk->{"info"}, $vname, ast_get_line($expr));
        }
        return TYPE_SCALAR();
    }
    if ($t == NODE_METHOD_CALL()) {
        # the declared return type, when the receiver's class is known
        my str $mt_name = "" . $expr->{"method"};
        my str $mt_cls = sem_recv_class($ctx, $expr->{"base_object"});
        if (length($mt_cls) > 0 && $mt_name ne "isa" && $mt_name ne "can") {
            my str $mt_fk = sem_method_target($ctx, $mt_cls, $ctx->{"recv_exact"} + 0, $mt_name, 0);
            if (length($mt_fk) > 0) {
                my int $mt_rt = $ctx->{"functions"}->{$mt_fk}->{"return_type"};
                # a list is read by context (its count or last item where
                # one value is wanted): not a type mismatch
                if ($mt_rt == TYPE_ARRAY() || $mt_rt == TYPE_HASH()) { return TYPE_SCALAR(); }
                if ($mt_rt != TYPE_VOID() && $mt_rt > 0) { return $mt_rt; }
            }
        }
        return TYPE_SCALAR();
    }
    if ($t == NODE_SUBSCRIPT()) {
        my int $sub_et = sem_var_elem_type($ctx, $expr->{"array"}, "@");
        if ($sub_et > 0) { return sem_et_plain($sub_et); }
        return TYPE_SCALAR();
    }
    if ($t == NODE_HASH_ACCESS()) {
        my int $hacc_et = sem_var_elem_type($ctx, $expr->{"hash"}, "%");
        if ($hacc_et > 0) { return sem_et_plain($hacc_et); }
        return TYPE_SCALAR();
    }
    if ($t == NODE_BINARY_OP()) {
        my str $op = $expr->{"op"};
        # an operand that may be an object with that operator overloaded:
        # the result is whatever the overload returns
        if (sem_prog_has_overloads($ctx) == 1 && $op ne "&&" && $op ne "||" && $op ne "//") {
            if (stage0_expr_type($ctx, $expr->{"left"}) == TYPE_SCALAR()) { return TYPE_SCALAR(); }
            if (stage0_expr_type($ctx, $expr->{"right"}) == TYPE_SCALAR()) { return TYPE_SCALAR(); }
        }
        if ($op eq "." || $op eq "x") { return TYPE_STR(); }
        if ($op eq "==" || $op eq "!=" || $op eq "<" || $op eq ">" || $op eq "<=" || $op eq ">="
            || $op eq "eq" || $op eq "ne" || $op eq "lt" || $op eq "gt" || $op eq "le" || $op eq "ge"
            || $op eq "<=>" || $op eq "cmp") { return TYPE_INT(); }
        if ($op eq "&" || $op eq "|" || $op eq "^" || $op eq "<<" || $op eq ">>") { return TYPE_INT(); }
        if ($op eq "/") { return TYPE_NUM(); }
        # `%` is integer modulo whatever its operands are
        if ($op eq "%") { return TYPE_INT(); }
        if ($op eq "+" || $op eq "-" || $op eq "*" || $op eq "**") {
            my int $ltype = stage0_expr_type($ctx, $expr->{"left"});
            my int $rtype_op = stage0_expr_type($ctx, $expr->{"right"});
            if ($ltype == TYPE_INT() && $rtype_op == TYPE_INT()) { return TYPE_INT(); }
            if (stage0_is_numeric($ltype) == 1 && stage0_is_numeric($rtype_op) == 1) { return TYPE_NUM(); }
            # Strings/unknowns in numeric context coerce — stay permissive.
            return TYPE_SCALAR();
        }
        if ($op eq "&&" || $op eq "||" || $op eq "//") {
            # Value-returning logicals: only typed when both sides agree.
            my int $ltype = stage0_expr_type($ctx, $expr->{"left"});
            my int $rtype_op = stage0_expr_type($ctx, $expr->{"right"});
            if ($ltype == $rtype_op) { return $ltype; }
            return TYPE_SCALAR();
        }
        return TYPE_SCALAR();
    }
    if ($t == NODE_UNARY_OP()) {
        my str $op = $expr->{"op"};
        if (sem_prog_has_overloads($ctx) == 1 && stage0_expr_type($ctx, $expr->{"operand"}) == TYPE_SCALAR()) { return TYPE_SCALAR(); }
        if ($op eq "!" || $op eq "not" || $op eq "~") { return TYPE_INT(); }
        if ($op eq "-") {
            my int $ot = stage0_expr_type($ctx, $expr->{"operand"});
            if (stage0_is_numeric($ot) == 1) { return $ot; }
            return TYPE_SCALAR();
        }
        return TYPE_SCALAR();
    }
    if ($t == NODE_TERNARY()) {
        my int $tt = stage0_expr_type($ctx, $expr->{"true_expr"});
        my int $ft = stage0_expr_type($ctx, $expr->{"false_expr"});
        if ($tt == $ft) { return $tt; }
        return TYPE_SCALAR();
    }
    if ($t == NODE_CALL()) {
        my str $name = $expr->{"name"};
        # High-signal builtins; everything else stays unknown.
        if ($name eq "length" || $name eq "size" || $name eq "index" || $name eq "rindex"
            || $name eq "byte_index" || $name eq "sys::byte_index" || $name eq "core::byte_index"
            || $name eq "ord" || $name eq "bytes" || $name eq "int"
            || $name eq "exists" || $name eq "defined") { return TYPE_INT(); }
        if ($name eq "substr" || $name eq "join" || $name eq "uc" || $name eq "lc"
            || $name eq "ucfirst" || $name eq "lcfirst" || $name eq "trim"
            || $name eq "chr" || $name eq "sprintf") { return TYPE_STR(); }
        if (($name eq "shift" || $name eq "pop") && $expr->{"arg_count"} == 1) {
            my scalar $sp_arg = $expr->{"args"}->[0];
            if (is_valid_node($sp_arg) == 1 && $sp_arg->{"type"} == NODE_VARIABLE() && ("" . $sp_arg->{"sigil"}) eq "@") {
                my int $sp_et = sem_var_elem_type($ctx, $sp_arg, "@");
                if ($sp_et > 0) { return sem_et_plain($sp_et); }
            }
            return TYPE_SCALAR();
        }
        my scalar $fn_info = sem_call_fn_info($ctx, $expr);
        if ($fn_info->{"is_registered"} == 1) {
            return $fn_info->{"return_type"};
        }
        return TYPE_SCALAR();
    }
    return TYPE_SCALAR();
}

# Validate interpolated scalar variables ($var and ${var}) inside regex
# patterns and non-/e substitution replacements (matching CodeGen's rules),
# rewriting any shadowed/disambiguated variable references to their C aliases.
func analyze_regex_interp(scalar $ctx, str $pattern, int $line) str {
    return analyze_regex_interp_n($ctx, $pattern, $line, 0);
}

# Element interpolation in a regex pattern / s/// replacement: $name{KEY}
# when %name is declared, $name[INDEX] when @name is declared and INDEX is an
# integer or a $variable (anything else stays a character class, Perl's
# heuristic). Returns the length of the element text after `$name` (0 = not
# an element) and appends the parsed, analyzed node to $node->{"rx_elems"}.
func regex_interp_elem(scalar $ctx, str $pattern, int $i, str $varname, int $line, scalar $node) int {
    if (!$node) { return 0; }
    my int $len = length($pattern);
    if ($i >= $len) { return 0; }
    my str $open = substr($pattern, $i, 1);
    my str $close = "";
    my str $sig = "";
    if ($open eq "{") { $close = "}"; $sig = "%"; }
    elsif ($open eq "[") { $close = "]"; $sig = "@"; }
    else { return 0; }
    my scalar $lk = scope_lookup_var_sigil($ctx->{"scope"}, $varname, $sig);
    if ($lk->{"found"} == 0) { return 0; }
    my int $depth = 0;
    my int $j = $i;
    my int $end = -1;
    while ($j < $len && $end < 0) {
        my str $c = substr($pattern, $j, 1);
        if ($c eq "\\") { $j = $j + 1; }
        elsif ($c eq $open) { $depth = $depth + 1; }
        elsif ($c eq $close) {
            $depth = $depth - 1;
            if ($depth == 0) { $end = $j; }
        }
        $j = $j + 1;
    }
    if ($end < 0) { return 0; }
    my str $inner = substr($pattern, $i + 1, $end - $i - 1);
    if (length($inner) == 0) { return 0; }
    if ($sig eq "@") {
        my int $ok = 1;
        my int $k = 0;
        my str $c0 = substr($inner, 0, 1);
        if ($c0 eq "$") {
            $k = 1;
            if (length($inner) < 2) { $ok = 0; }
            while ($k < length($inner)) {
                my str $c = substr($inner, $k, 1);
                if (!($c eq "_" || ($c ge "a" && $c le "z") || ($c ge "A" && $c le "Z") || ($c ge "0" && $c le "9"))) { $ok = 0; }
                $k = $k + 1;
            }
        } else {
            if ($c0 eq "-") { $k = 1; }
            if ($k >= length($inner)) { $ok = 0; }
            while ($k < length($inner)) {
                my str $c = substr($inner, $k, 1);
                if (!($c ge "0" && $c le "9")) { $ok = 0; }
                $k = $k + 1;
            }
        }
        if ($ok == 0) { return 0; }
    }
    my str $src = chr(36) . $varname . substr($pattern, $i, $end - $i + 1);
    my array @toks_list = lex_tokenize($src);
    my scalar $toks = \@toks_list;
    my scalar $ep = parser_new($toks);
    my scalar $enode = parse_expression($ep);
    if (!parser_check($ep, "EOF")) { return 0; }
    my int $et = $enode->{"type"} + 0;
    if ($et != NODE_HASH_ACCESS() && $et != NODE_SUBSCRIPT()) { return 0; }
    ast_set_line($enode, $line);
    analyze_expression($ctx, $enode);
    if (!$node->{"rx_elems"}) { $node->{"rx_elems"} = []; }
    push($node->{"rx_elems"}, $enode);
    return $end - $i + 1;
}

func analyze_regex_interp_n(scalar $ctx, str $pattern, int $line, scalar $rx_node) str {
    my int $len = length($pattern);
    my int $i = 0;
    my scalar $sb = sb_new();
    while ($i < $len) {
        my str $ch = substr($pattern, $i, 1);
        if ($ch eq "\\" && $i + 1 < $len) {
            sb_append($sb, substr($pattern, $i, 2));
            $i = $i + 2;
        } elsif ($ch eq "$") {
            my int $start_i = $i;
            $i = $i + 1;
            my str $varname = "";
            if ($i < $len && substr($pattern, $i, 1) eq "{") {
                my int $bi = $i + 1;
                while ($bi < $len && substr($pattern, $bi, 1) ne "}") {
                    $bi = $bi + 1;
                }
                if ($bi < $len && $bi > $i + 1) {
                    my str $braced = substr($pattern, $i + 1, $bi - $i - 1);
                    my str $bfirst = substr($braced, 0, 1);
                    my int $b_ok = 0;
                    if ($bfirst eq "_" || ($bfirst ge "a" && $bfirst le "z") || ($bfirst ge "A" && $bfirst le "Z")) {
                        $b_ok = 1;
                        my int $ki = 1;
                        while ($ki < length($braced)) {
                            my str $bch = substr($braced, $ki, 1);
                            if (!($bch eq "_" || ($bch ge "a" && $bch le "z") || ($bch ge "A" && $bch le "Z") || ($bch ge "0" && $bch le "9"))) {
                                $b_ok = 0;
                            }
                            $ki = $ki + 1;
                        }
                    }
                    if ($b_ok == 1) {
                        $varname = $braced;
                        $i = $bi + 1;
                    }
                }
            }
            if (length($varname) == 0 && $i < $len) {
                my str $vch0 = substr($pattern, $i, 1);
                if ($vch0 eq "_" || ($vch0 ge "a" && $vch0 le "z") || ($vch0 ge "A" && $vch0 le "Z")) {
                    while ($i < $len) {
                        my str $vch = substr($pattern, $i, 1);
                        if ($vch eq "_" || ($vch ge "a" && $vch le "z") || ($vch ge "A" && $vch le "Z") || ($vch ge "0" && $vch le "9")) {
                            $varname = $varname . $vch;
                            $i = $i + 1;
                        } else {
                            last;
                        }
                    }
                }
            }
            my int $elem_len = 0;
            if (length($varname) > 0 && substr($pattern, $start_i + 1, 1) ne "{") {
                $elem_len = regex_interp_elem($ctx, $pattern, $i, $varname, $line, $rx_node);
            }
            if ($elem_len > 0) {
                # marker: $ chr(1) <index> chr(2), expanded by codegen
                sb_append($sb, chr(36) . chr(1) . (size($rx_node->{"rx_elems"}) - 1) . chr(2));
                $i = $i + $elem_len;
            } elsif (length($varname) > 0) {
                my scalar $rlk = scope_lookup_var_sigil($ctx->{"scope"}, $varname, "$");
                if ($rlk->{"found"} == 0) {
                    semantic_error($ctx, "undefined variable '$" . $varname . "'", $line);
                    sb_append($sb, substr($pattern, $start_i, $i - $start_i));
                } else {
                    scope_mark_used_sigil($ctx->{"scope"}, $varname, "$");
                    my str $cn = sem_resolve_vinfo_cname($ctx, $rlk->{"info"}, $varname, $line, "$");
                    if ($cn ne $varname) {
                        sb_append($sb, chr(36) . "{" . $cn . "}");
                    } else {
                        sb_append($sb, substr($pattern, $start_i, $i - $start_i));
                    }
                }
            } else {
                sb_append($sb, "$");
            }
        } else {
            sb_append($sb, $ch);
            $i = $i + 1;
        }
    }
    return sb_to_string($sb);
}

func sem_is_builtin_namespace(str $ns) int {
    if ($ns eq "core" || $ns eq "sys" || $ns eq "math" || $ns eq "str" ||
        $ns eq "re" || $ns eq "utf8" || $ns eq "async" || $ns eq "thread" ||
        $ns eq "c" || $ns eq "sb" || $ns eq "UNIVERSAL") {
        return 1;
    }
    return 0;
}

# True for an expression whose value is an array (list) in Strada: @var,
# @{...}, map/grep, or a call to a function declared to return an array.
func sem_is_array_value(scalar $ctx, scalar $n) int {
    if (is_valid_node($n) == 0) { return 0; }
    my int $t = $n->{"type"};
    if (($t == NODE_VARIABLE() || $t == NODE_DEREF_SCALAR()) && $n->{"sigil"} eq "@") { return 1; }
    if ($t == NODE_MAP() || $t == NODE_GREP()) { return 1; }
    if ($t == NODE_CALL()) {
        my scalar $fi = $ctx->{"functions"}->{$n->{"name"}};
        if ($fi && $fi->{"is_registered"} == 1 && $fi->{"return_type"} == TYPE_ARRAY()) { return 1; }
    }
    return 0;
}

# A call to a function declared to return `array`, used where one value is
# wanted (`my $n = f()`, `$v = f()`, `$h{k} = f()`): the element count, as
# for an array variable there (Perl; it stored the array). Functions without
# a declared `array` return type are not affected.
func sem_call_returns_array(scalar $ctx, scalar $n) int {
    if (is_valid_node($n) == 0) { return 0; }
    if ($n->{"type"} != NODE_CALL()) { return 0; }
    my scalar $cra_info = sem_call_fn_info($ctx, $n);
    if ($cra_info && $cra_info->{"is_registered"} == 1 && $cra_info->{"return_type"} == TYPE_ARRAY()) {
        return 1;
    }
    return 0;
}

# An array value (see sem_is_array_value) or a hash variable (%h, %{...}).
func sem_is_container_value(scalar $ctx, scalar $n) int {
    if (sem_is_array_value($ctx, $n) == 1) { return 1; }
    if (is_valid_node($n) == 0) { return 0; }
    my int $t = $n->{"type"};
    if (($t == NODE_VARIABLE() || $t == NODE_DEREF_SCALAR()) && $n->{"sigil"} eq "%") { return 1; }
    return 0;
}

# `my @a = C ? X : Y` / `@a = C ? X : Y`: each branch is a list of its own
# (Perl). The code generator took the whole ?: for one value, so the array
# got one element whichever branch ran: `$t ? @m : ()` was an array holding
# an array. Every branch becomes a list literal (`()` an empty one, a list
# or a bare `[...]` itself, anything else a one-item list, where an array
# item flattens as in any list); the node is flagged `list_tern` and its
# value is then always a new array.
func sem_tern_branch_list(scalar $branch) scalar {
    if (is_valid_node($branch) == 0) { return $branch; }
    my int $bt = $branch->{"type"};
    if ($bt == NODE_TERNARY()) {
        sem_tern_as_lists($branch);
        return $branch;
    }
    if ($bt == NODE_ANON_ARRAY() && ($branch->{"is_list"} || !$branch->{"in_parens"})) {
        return $branch;
    }
    my scalar $lst = ast_new_anon_array();
    $lst->{"is_list"} = 1;
    $lst->{"line"} = $branch->{"line"};
    if ($bt == NODE_ANON_HASH() && $branch->{"is_empty_list"}) {
        return $lst;
    }
    ast_add_array_elem($lst, $branch);
    return $lst;
}

func sem_is_or_empty(scalar $n) int {
    if (is_valid_node($n) == 0) { return 0; }
    if ($n->{"type"} != NODE_BINARY_OP()) { return 0; }
    my str $oe_op = "" . $n->{"op"};
    if ($oe_op ne "//" && $oe_op ne "||") { return 0; }
    my scalar $oe_r = $n->{"right"};
    if (is_valid_node($oe_r) == 1 && $oe_r->{"is_empty_list"}) { return 1; }
    return 0;
}

func sem_tern_empty_undef(scalar $tern) void {
    if (is_valid_node($tern) == 0) { return; }
    if ($tern->{"type"} != NODE_TERNARY()) { return; }
    my scalar $teu_a = $tern->{"true_expr"};
    my scalar $teu_b = $tern->{"false_expr"};
    if (is_valid_node($teu_a) == 1 && $teu_a->{"is_empty_list"}) { $tern->{"true_expr"} = ast_new_undef(); }
    else { sem_tern_empty_undef($teu_a); }
    if (is_valid_node($teu_b) == 1 && $teu_b->{"is_empty_list"}) { $tern->{"false_expr"} = ast_new_undef(); }
    else { sem_tern_empty_undef($teu_b); }
}

func sem_tern_as_lists(scalar $tern) void {
    if (is_valid_node($tern) == 0) { return; }
    # `A // ()` / `A || ()` where a list is wanted: A as one item, or nothing
    # (Perl). The code generator builds the 0- or 1-element array.
    if (sem_is_or_empty($tern) == 1) { $tern->{"list_or_empty"} = 1; return; }
    if ($tern->{"type"} != NODE_TERNARY()) { return; }
    if ($tern->{"list_tern"}) { return; }
    $tern->{"true_expr"} = sem_tern_branch_list($tern->{"true_expr"});
    $tern->{"false_expr"} = sem_tern_branch_list($tern->{"false_expr"});
    $tern->{"list_tern"} = 1;
}

# scalar(EXPR): the element count of an array value.
# `our $n = @a` / file-scope `my $n = keys(%h)`: a list value assigned to a
# scalar declaration is its count (Perl). Function-level `my $n = @a` is
# counted by the code generator; this covers the declaration forms it does
# not see that way.
func sem_scalar_decl_count(scalar $ctx, scalar $decl) void {
    if (is_valid_node($decl) == 0) { return; }
    if (("" . $decl->{"sigil"}) ne "$") { return; }
    my scalar $ini = $decl->{"init"};
    if (is_valid_node($ini) == 0) { return; }
    sem_rev_scalar($ini);
    my int $it = $ini->{"type"};
    my int $hit = sem_is_count_in_scalar_call($ctx, $ini);
    if (($it == NODE_VARIABLE() || $it == NODE_DEREF_SCALAR()) && ("" . $ini->{"sigil"}) eq "@") { $hit = 1; }
    if ($it == NODE_MAP() || $it == NODE_GREP()) { $hit = 1; }
    if (sem_call_returns_array($ctx, $ini) == 1) { $hit = 1; }
    if ($hit == 1) { $decl->{"init"} = sem_scalar_of($ini); }
}

# A reverse(...) call evaluated in scalar context: the list joined and the
# string reversed (Perl). Elsewhere it reverses the list.
func sem_rev_scalar(scalar $n) void {
    if (is_valid_node($n) == 0) { return; }
    if ($n->{"type"} == NODE_CALL() && ("" . $n->{"name"}) eq "reverse") { $n->{"scalar_ctx"} = 1; }
    # a slice in scalar context is its last element (Perl): "" . @a[0]
    if ($n->{"type"} == NODE_ARRAY_SLICE() || $n->{"type"} == NODE_HASH_SLICE()) { $n->{"scalar_ctx"} = 1; }
}

# keys/values/split calls: Perl gives their count in scalar context
func sem_is_count_in_scalar_call(scalar $ctx, scalar $n) int {
    if (is_valid_node($n) == 0) { return 0; }
    if ($n->{"type"} != NODE_CALL()) { return 0; }
    my str $cn = "" . $n->{"name"};
    # (keys/values/split are core operators: a user function of the same
    # name never replaces them, in Perl or Strada)
    if ($cn eq "keys" || $cn eq "values" || $cn eq "split" || $cn eq "sys::split") { return 1; }
    return 0;
}

func sem_scalar_of(scalar $n) scalar {
    # A call is read in scalar context by the code generator itself (the
    # count of the list it returns, or the last item of a comma list):
    # scalar(f()) would always count.
    if (is_valid_node($n) == 1 && $n->{"type"} == NODE_CALL() && length("" . $n->{"sem_fn_key"}) > 0) {
        $n->{"sc_count"} = 1;
        return $n;
    }
    my scalar $c = ast_new_call("scalar");
    ast_add_arg($c, $n);
    ast_set_line($c, ast_get_line($n));
    return $c;
}

func sem_strong_copy_src(scalar $v) int {
    if (is_valid_node($v) == 0) { return 0; }
    my int $t = $v->{"type"};
    if ($t == NODE_VARIABLE() && ("" . $v->{"sigil"}) eq "$") { return 1; }
    if ($t == NODE_HASH_ACCESS() || $t == NODE_SUBSCRIPT() || $t == NODE_DEREF_HASH() || $t == NODE_DEREF_ARRAY()) { return 1; }
    return 0;
}

func sem_strong_copy_wrap(scalar $v) scalar {
    my scalar $c = ast_new_call("__strong_copy");
    ast_add_arg($c, $v);
    ast_set_line($c, ast_get_line($v));
    return $c;
}

func sem_strong_copy_walk(scalar $n, scalar $seen) void {
    my str $rt = reftype($n);
    if ($rt eq "ARRAY") {
        my int $len = size($n);
        for (my int $i = 0; $i < $len; $i = $i + 1) {
            my scalar $e = $n->[$i];
            if (length(reftype($e)) > 0) { sem_strong_copy_walk($e, $seen); }
        }
        return;
    }
    if ($rt ne "HASH") { return; }
    my str $id = "" . $n;
    if (exists($seen->{$id})) { return; }
    $seen->{$id} = 1;
    if (exists($n->{"type"})) {
        my int $t = $n->{"type"} + 0;
        if ($t == NODE_ASSIGN() && ("" . $n->{"op"}) eq "=" && sem_strong_copy_src($n->{"value"}) == 1) {
            my scalar $tg = $n->{"target"};
            if (!(is_valid_node($tg) == 1 && $tg->{"type"} == NODE_VARIABLE() && ("" . $tg->{"sigil"}) ne "$")) {
                $n->{"value"} = sem_strong_copy_wrap($n->{"value"});
            }
        }
        if ($t == NODE_VAR_DECL() && ("" . $n->{"sigil"}) eq "$" && sem_strong_copy_src($n->{"init"}) == 1) {
            $n->{"init"} = sem_strong_copy_wrap($n->{"init"});
        }
        if ($t == NODE_CALL() && (("" . $n->{"name"}) eq "push" || ("" . $n->{"name"}) eq "unshift")) {
            my scalar $pa = $n->{"args"};
            my int $pc = $n->{"arg_count"} + 0;
            for (my int $pi = 1; $pi < $pc; $pi = $pi + 1) {
                if (sem_strong_copy_src($pa->[$pi]) == 1) { $pa->[$pi] = sem_strong_copy_wrap($pa->[$pi]); }
            }
        }
    }
    foreach my str $k (keys(%{$n})) {
        my scalar $v = $n->{$k};
        if (length(reftype($v)) > 0) { sem_strong_copy_walk($v, $seen); }
    }
}

func analyze_expression(scalar $ctx, scalar $expr) void {
    if (is_valid_node($expr) == 0) {
        return;
    }
    my int $node_type = $expr->{"type"};
    my int $line = ast_get_line($expr);

    # Variable reference
    if ($node_type == NODE_VARIABLE()) {
        my str $name = $expr->{"name"};
        my str $sigil = $expr->{"sigil"};
        my scalar $lookup_result = scope_lookup_var_sigil($ctx->{"scope"}, $name, $sigil);
        my int $found = $lookup_result->{"found"};
        if ($found == 0) {
            semantic_error($ctx, "undefined variable '" . $sigil . $name . "'", $line);
        } else {
            scope_mark_used_sigil($ctx->{"scope"}, $name, $sigil);
            $expr->{"orig_name"} = $name;
            $expr->{"name"} = sem_resolve_vinfo_cname($ctx, $lookup_result->{"info"}, $name, $line, $sigil);
            # Pkg::CONST names that package's declaration (same-named consts
            # in several packages are separate C globals)
            my str $cpk = "" . $expr->{"const_pkg"};
            my scalar $cdecls = $lookup_result->{"info"}->{"decls"};
            if (length($cpk) > 0 && defined($cdecls)) {
                my int $cdi = 0;
                while ($cdi < size(@{$cdecls})) {
                    my scalar $cd = $cdecls->[$cdi];
                    if ($cd->{"type"} == NODE_CONST_DECL() && ("" . $cd->{"package"}) eq $cpk) {
                        $expr->{"name"} = "" . $cd->{"name"};
                        last;
                    }
                    $cdi = $cdi + 1;
                }
            }
        }
        return;
    }

    # Anonymous function: set current_func to the closure node (so return-type
    # checks validate against the closure's return type rather than an enclosing
    # void function!) and preserve semantic errors collected inside its body.
    if ($node_type == NODE_ANON_FUNC()) {
        my scalar $af_saved_func = $ctx->{"current_func"};
        my str $af_saved_pkg = "" . $ctx->{"cur_pkg"};
        if (is_valid_node($af_saved_func) == 1) {
            if (length("" . $expr->{"file"}) == 0) {
                $expr->{"file"} = $af_saved_func->{"file"};
            }
            $expr->{"from_use"} = $af_saved_func->{"from_use"};
            if (length("" . $expr->{"package"}) == 0) {
                $expr->{"package"} = $af_saved_func->{"package"};
            }
        }
        if (length("" . $expr->{"package"}) > 0) {
            $ctx->{"cur_pkg"} = "" . $expr->{"package"};
        }
        if (length("" . $expr->{"name"}) == 0) {
            $expr->{"name"} = "<closure>";
        }
        $ctx->{"current_func"} = $expr;
        my scalar $af_outer = $ctx->{"scope"};
        $ctx->{"scope"} = scope_new($af_outer);
        $ctx->{"scope"}->{"is_param_scope"} = 1;
        my scalar $af_params = $expr->{"params"};
        my hash %af_seen = ();
        my hash %af_seen_bare = ();
        my int $af_pi = 0;
        while ($af_pi < $expr->{"param_count"}) {
            my scalar $af_p = $af_params->[$af_pi];
            my str $af_pname = $af_p->{"name"};
            my str $af_key = $af_p->{"sigil"} . $af_pname;
            my int $af_pl = ast_get_line($af_p);
            if ($af_pl <= 0) { $af_pl = $line; }
            if ($af_seen{$af_key} == 1) {
                semantic_error($ctx, "duplicate parameter '" . $af_key . "'", $af_pl);
            } elsif ($af_seen_bare{$af_pname} == 1) {
                semantic_error($ctx, "parameter '" . $af_key . "' conflicts with another parameter named '" . $af_pname . "'", $af_pl);
            } else {
                $af_seen{$af_key} = 1;
                $af_seen_bare{$af_pname} = 1;
            }
            if (($af_p->{"has_default"} + 0) == 1 && is_valid_node($af_p->{"default"}) == 1) {
                analyze_expression($ctx, $af_p->{"default"});
            }
            if ($af_pname eq "_" && ("" . $af_p->{"sigil"}) eq "@") {
                # implicit @_ of `func { ... }`: C name __args_ (as `_` it
                # would hide $_)
                scope_add_var($ctx->{"scope"}, "@:_", "@", $af_p->{"param_type"}, ast_get_line($af_p));
                $ctx->{"scope"}->{"vars"}->{"@:_"}->{"c_name"} = "__args_";
                $af_p->{"orig_name"} = "_";
                $af_p->{"name"} = "__args_";
                $af_pi = $af_pi + 1;
                next;
            }
            my str $af_calias = sem_alloc_local_cname($ctx, $ctx->{"scope"}, $af_pname);
            scope_add_var($ctx->{"scope"}, $af_pname, $af_p->{"sigil"}, $af_p->{"param_type"}, ast_get_line($af_p));
            if (length($af_calias) > 0) {
                $af_p->{"orig_name"} = $af_pname;
                $af_p->{"name"} = $af_calias;
                $ctx->{"scope"}->{"vars"}->{$af_pname}->{"c_name"} = $af_calias;
            }
            $af_pi = $af_pi + 1;
        }
        if (is_valid_node($expr->{"body"}) == 1) {
            analyze_block($ctx, $expr->{"body"});
        }
        $ctx->{"scope"} = $af_outer;
        $ctx->{"current_func"} = $af_saved_func;
        $ctx->{"cur_pkg"} = $af_saved_pkg;
        return;
    }

    # Value-producing do-block: analyze its statements in a nested scope
    if ($node_type == NODE_DO_EXPR()) {
        my scalar $outer_scope = $ctx->{"scope"};
        $ctx->{"scope"} = scope_new($outer_scope);
        analyze_block($ctx, $expr->{"block"});
        scope_check_unused($ctx, $ctx->{"scope"});
        $ctx->{"scope"} = $outer_scope;
        return;
    }

    # Function call
    if ($node_type == NODE_CALL()) {
        # Constant / enum value reference (e.g., Color::RED without parens)
        if ($expr->{"is_constant"} == 1) {
            return;
        }
        my str $name = $expr->{"name"};
        my scalar $args = $expr->{"args"};
        my int $arg_count = $expr->{"arg_count"};
        if ($ctx->{"strict_types"} == 1) {
            sem_check_typed_push($ctx, $expr, ast_get_line($expr));
        }

        # Resolve unqualified calls imported via `use Module qw(names);`
        if (index($name, "::") < 0 && defined($ctx->{"qw_imports"})) {
            my str $imp_pkg = "main";
            my scalar $cur_fn_q = $ctx->{"current_func"};
            if ($cur_fn_q) {
                my str $cfp = "" . $cur_fn_q->{"package"};
                if (length($cfp) > 0) {
                    $imp_pkg = $cfp;
                }
            } elsif (length("" . $ctx->{"cur_pkg"}) > 0) {
                $imp_pkg = "" . $ctx->{"cur_pkg"};
            }
            my str $qw_target = "" . $ctx->{"qw_imports"}->{$imp_pkg . "::" . $name};
            if (length($qw_target) > 0) {
                $name = $qw_target;
                $expr->{"name"} = $qw_target;
            }
        }

        # reverse(...) as the argument of a builtin that takes a string is in
        # scalar context: length(reverse($s)), lc(reverse(...)), scalar(...)
        if ($arg_count >= 1 && ($name eq "length" || $name eq "lc" || $name eq "uc" || $name eq "lcfirst" ||
            $name eq "ucfirst" || $name eq "ord" || $name eq "scalar" || $name eq "quotemeta" ||
            $name eq "substr" || $name eq "index" || $name eq "rindex" || $name eq "core::length")) {
            sem_rev_scalar($args->[0]);
            if ($arg_count >= 2 && ($name eq "index" || $name eq "rindex")) { sem_rev_scalar($args->[1]); }
        }

        # Constant-fold ord("literal"): rewrite the call node in place into
        # an int literal, so character-code comparisons can be WRITTEN as
        # `$code == ord("#")` (readable) yet compile to a plain integer
        # compare with every int-literal optimization (tagged ints, int
        # conditions). ASCII first byte only -- for multi-byte UTF-8 the
        # runtime ord() decodes the codepoint, so leave those to runtime.
        if ($name eq "ord" && $arg_count == 1) {
            my scalar $ord_arg = $args->[0];
            if ($ord_arg->{"type"} == NODE_STR_LITERAL()) {
                my str $ord_sval = $ord_arg->{"value"};
                if (length($ord_sval) > 0) {
                    my int $ord_code = char_at($ord_sval, 0);
                    if ($ord_code > 0 && $ord_code < 128) {
                        $expr->{"type"} = NODE_INT_LITERAL();
                        $expr->{"value"} = $ord_code;
                        return;
                    }
                }
            }
        }

        # refto($var) is \$var: a reference to the variable itself, so a write
        # through it changes $var (it used to reference a copy of the value).
        if ($name eq "refto" && $arg_count == 1) {
            my scalar $rt_arg = $args->[0];
            if (is_valid_node($rt_arg) == 1 && $rt_arg->{"type"} == NODE_VARIABLE()) {
                $expr->{"type"} = NODE_REF();
                $expr->{"target"} = $rt_arg;
                $expr->{"ref_type"} = "" . $rt_arg->{"sigil"};
                analyze_expression($ctx, $expr);
                return;
            }
        }

        # Record tie usage on the context: the codegen's condition-level
        # hash-fetch CSE is only sound when no hash in the program can be
        # tied (a tied FETCH is observable per-mention).
        if ($name eq "tie" || $name eq "core::tie" || $name eq "sys::tie") {
            $ctx->{"uses_tie"} = 1;
        }
        # A program that can start threads (thread::, the async pool) gets
        # interpreter-lock handover checks in its loops (gil_poll_prefix).
        if (index($name, "thread::") == 0 || index($name, "async::") == 0) {
            $ctx->{"uses_threads"} = 1;
        }
        # bare `&f` passes the caller's @_; where there is none (main, a
        # function with a parameter list) it passes nothing (Perl: empty)
        if (($expr->{"amp_call"} + 0) == 1) {
            my scalar $amp_lk = scope_lookup_var_sigil($ctx->{"scope"}, "_", "@");
            if (($amp_lk->{"found"} + 0) != 1) {
                my array @amp_none = ();
                $expr->{"args"} = \@amp_none;
                $expr->{"arg_count"} = 0;
                $args = $expr->{"args"};
                $arg_count = 0;
            }
        }
        # a function that asks for its calling context: callers set it
        # (otherwise only `dynamic` functions get it)
        if ($name eq "core::wantarray" || $name eq "sys::wantarray" || $name eq "wantarray" ||
            $name eq "core::wanthash" || $name eq "sys::wanthash" || $name eq "wanthash") {
            if (is_valid_node($ctx->{"current_func"}) == 1) { $ctx->{"current_func"}->{"uses_wantarray"} = 1; }
        }
        if ($name eq "weaken" || $name eq "core::weaken" || $name eq "sys::weaken") {
            $ctx->{"uses_weaken"} = 1;
        }

        if ($ctx->{"strict_types"} == 1 && $arg_count > 0) {
            sem_check_ctor_args($ctx, $expr, $line);
        }

        # Check if builtin (builtins hash stores 1 for each builtin)
        my int $is_builtin = $ctx->{"builtins"}->{$name};
        if ($is_builtin == 1) {
            # Builtin - analyze arguments
            for (my int $i = 0; $i < $arg_count; $i = $i + 1) {
                analyze_expression($ctx, $args->[$i]);
            }
            return;
        }

        # Convert Package::func (and nested A::B::func) to A_B_func for lookup
        # Module functions are registered as Package::func, so try all forms
        my str $lookup_name = $name;
        my int $colon_idx = index($name, "::");
        my str $all_us_name = $name;
        if ($colon_idx >= 0) {
            my int $rci = index($all_us_name, "::");
            while ($rci >= 0) {
                $all_us_name = substr($all_us_name, 0, $rci) . "_" . substr($all_us_name, $rci + 2, length($all_us_name) - $rci - 2);
                $rci = index($all_us_name, "::");
            }
            my scalar $fn_info_us = $ctx->{"functions"}->{$all_us_name};
            if ($fn_info_us->{"is_registered"} == 1) {
                $lookup_name = $all_us_name;
            } else {
                my int $last_col = rindex($name, "::");
                if ($last_col > 0) {
                    my str $q_pkg = substr($name, 0, $last_col);
                    my str $q_fn = substr($name, $last_col + 2, length($name) - $last_col - 2);
                    # Support modules whose package statement uses underscores
                    # (`package Digest_SHA;` inside `lib/Digest/SHA.strada`,
                    # registered by load_module as `Digest_SHA::hmac_sha256_hex`)
                    my str $c_q_pkg = $q_pkg;
                    my int $qci = index($c_q_pkg, "::");
                    while ($qci >= 0) {
                        $c_q_pkg = substr($c_q_pkg, 0, $qci) . "_" . substr($c_q_pkg, $qci + 2, length($c_q_pkg) - $qci - 2);
                        $qci = index($c_q_pkg, "::");
                    }
                    my str $hybrid_name = $c_q_pkg . "::" . $q_fn;
                    my scalar $fn_info_hyb = $ctx->{"functions"}->{$hybrid_name};
                    if ($fn_info_hyb->{"is_registered"} == 1) {
                        $lookup_name = $hybrid_name;
                    } elsif ($q_pkg eq "main") {
                        # Also support main::func() calling a top-level main function
                        # (rewrite call name to bare $q_fn since top-level main functions
                        # are emitted in C without a `main_` prefix!)
                        my scalar $fn_info_main = $ctx->{"functions"}->{$q_fn};
                        if ($fn_info_main->{"is_registered"} == 1) {
                            $lookup_name = $q_fn;
                            $name = $q_fn;
                            $expr->{"name"} = $q_fn;
                        }
                    }
                }
            }
        } else {
            # Name has no ::, but might be Package_func format from ::func() calls
            # Try to find Package::func format in registry
            # Since package names can contain underscores (e.g., Sysync_Token),
            # try all possible underscore positions as the separator
            my int $found_colon = 0;
            my int $us_idx = index($name, "_");
            while ($us_idx > 0 && $found_colon == 0) {
                my str $pkg_part = substr($name, 0, $us_idx);
                my str $func_part = substr($name, $us_idx + 1, length($name) - $us_idx - 1);
                if (length($pkg_part) > 0 && length($func_part) > 0) {
                    my str $colon_name = $pkg_part . "::" . $func_part;
                    my scalar $fn_info_colon = $ctx->{"functions"}->{$colon_name};
                    if ($fn_info_colon->{"is_registered"} == 1) {
                        $lookup_name = $colon_name;
                        $found_colon = 1;
                    }
                }
                if ($found_colon == 0) {
                    # Try next underscore position
                    my int $next_idx = index(substr($name, $us_idx + 1, length($name) - $us_idx - 1), "_");
                    if ($next_idx >= 0) {
                        $us_idx = $us_idx + 1 + $next_idx;
                    } else {
                        $us_idx = -1;  # No more underscores
                    }
                }
            }
            # `::func()` inside a nested package (`package N::B;`) arrives as
            # `N_B_func`, but a `use`d module registers it as `N::B::func`:
            # no single underscore split above can rebuild two `::`. Strip
            # the current package's C prefix and retry with its real name.
            if ($found_colon == 0 && $ctx->{"functions"}->{$name}->{"is_registered"} != 1) {
                my str $rel_pkg = "" . $ctx->{"eval_package"};
                if (length($rel_pkg) == 0 && $ctx->{"current_func"}) {
                    $rel_pkg = "" . $ctx->{"current_func"}->{"package"};
                }
                if (length($rel_pkg) == 0) { $rel_pkg = "" . $ctx->{"cur_pkg"}; }
                if (index($rel_pkg, "::") > 0) {
                    my str $rel_c = $rel_pkg;
                    my int $rel_ci = index($rel_c, "::");
                    while ($rel_ci >= 0) {
                        $rel_c = substr($rel_c, 0, $rel_ci) . "_" . substr($rel_c, $rel_ci + 2, length($rel_c) - $rel_ci - 2);
                        $rel_ci = index($rel_c, "::");
                    }
                    my int $rel_plen = length($rel_c) + 1;
                    if (length($name) > $rel_plen && substr($name, 0, $rel_plen) eq $rel_c . "_") {
                        my str $rel_name = $rel_pkg . "::" . substr($name, $rel_plen, length($name) - $rel_plen);
                        if ($ctx->{"functions"}->{$rel_name}->{"is_registered"} == 1) {
                            $lookup_name = $rel_name;
                        }
                    }
                }
            }
        }

        # Check if user-defined function
        # Registered functions have is_registered = 1
        my scalar $fn_info = $ctx->{"functions"}->{$lookup_name};
        my int $is_reg = $fn_info->{"is_registered"};
        if ($is_reg == 0) {
            # Not found - try package-prefixed name if we're in a package
            if ($colon_idx < 0) {
                my scalar $cur_fn = $ctx->{"current_func"};
                my str $pkg = "" . $ctx->{"eval_package"};
                if (length($pkg) == 0) {
                    if ($cur_fn) {
                        $pkg = "" . $cur_fn->{"package"};
                    }
                }
                if (length($pkg) == 0) {
                    $pkg = "" . $ctx->{"cur_pkg"};
                }
                if (length($pkg) > 0 && $pkg ne "main") {
                    # Convert :: to _ in package name for underscore format lookup
                    my str $c_pkg = $pkg;
                    my int $ci = index($c_pkg, "::");
                    while ($ci >= 0) {
                        $c_pkg = substr($c_pkg, 0, $ci) . "_" . substr($c_pkg, $ci + 2, length($c_pkg) - $ci - 2);
                        $ci = index($c_pkg, "::");
                    }
                    # Try package-prefixed name with underscore (Package_func format)
                    my str $prefixed_name = $c_pkg . "_" . $name;
                    my scalar $fn_info_pkg = $ctx->{"functions"}->{$prefixed_name};
                    if ($fn_info_pkg->{"is_registered"} == 1) {
                        # Found it! Update for continued validation
                        $lookup_name = $prefixed_name;
                        $fn_info = $fn_info_pkg;
                        $is_reg = 1;
                    }
                    # Also try Package::func format (functions from modules)
                    # Use original $pkg (not $c_pkg) to preserve :: in nested packages
                    # e.g., Strada::Interpreter::func_name, not Strada_Interpreter::func_name
                    if ($is_reg == 0) {
                        my str $colon_name = $pkg . "::" . $name;
                        my scalar $fn_info_colon = $ctx->{"functions"}->{$colon_name};
                        if ($fn_info_colon->{"is_registered"} == 1) {
                            $lookup_name = $colon_name;
                            $fn_info = $fn_info_colon;
                            $is_reg = 1;
                        }
                    }
                }
                if ($is_reg == 0 && $name eq "abs") {
                    # Perl builtin abs() (a user function of that name wins,
                    # e.g. Math::BigInt::abs inside its package)
                    $expr->{"name"} = "math::abs";
                    for (my int $ai = 0; $ai < $arg_count; $ai = $ai + 1) {
                        analyze_expression($ctx, $args->[$ai]);
                    }
                    return;
                }
                if ($is_reg == 0 && ($name eq "wantarray" || $name eq "wanthash")) {
                    # Perl's bare wantarray() (a user function of that name wins)
                    $expr->{"name"} = "core::" . $name;
                    return;
                }
                if ($is_reg == 0 && ($name eq "hex" || $name eq "oct")) {
                    # Perl builtins hex()/oct(): used when no user function of
                    # that name exists (a user-defined hex() takes precedence)
                    $expr->{"name"} = "core::" . $name;
                    for (my int $hi = 0; $hi < $arg_count; $hi = $hi + 1) {
                        analyze_expression($ctx, $args->[$hi]);
                    }
                    return;
                }
                if ($is_reg == 0) {
                    semantic_error($ctx, "undefined function '" . $name . "'", $line);
                }
            } else {
                # Qualified call `Pkg::func()` to a user package (not a builtin
                # namespace, not `-M` separate-compile mode where undeclared
                # cross-module calls emit auto-externs, not an inline `Pkg::new`
                # constructor on a known package, and not defined in a top-level
                # __C__ block): report undefined function!
                my str $first_ns = substr($name, 0, $colon_idx);
                my int $skip_qual_err = 0;
                my int $lcol2 = rindex($name, "::");
                if ($lcol2 > 0) {
                    my str $npkg = substr($name, 0, $lcol2);
                    my str $nfn = substr($name, $lcol2 + 2, length($name) - $lcol2 - 2);
                    my str $c_npkg = $npkg;
                    my int $nci = index($c_npkg, "::");
                    while ($nci >= 0) {
                        $c_npkg = substr($c_npkg, 0, $nci) . "_" . substr($c_npkg, $nci + 2, length($c_npkg) - $nci - 2);
                        $nci = index($c_npkg, "::");
                    }
                    my int $pkg_is_known = 0;
                    if ($ctx->{"known_packages"}->{$npkg} == 1 || $ctx->{"known_packages"}->{$c_npkg} == 1) {
                        $pkg_is_known = 1;
                    }
                    if ($nfn eq "new" && $pkg_is_known == 1) {
                        # A package without a constructor: `Pkg::new(k => v, ...)`
                        # is inlined as a blessed hash, which needs key/value
                        # pairs. Anything else (an odd argument count, like the
                        # inherited-ctor call `Kid::new("x")`) linked against a
                        # missing Pkg_new.
                        my int $nw_spread = 0;
                        for (my int $nwi = 0; $nwi < $arg_count; $nwi = $nwi + 1) {
                            if ($args->[$nwi]->{"type"} == NODE_SPREAD()) { $nw_spread = 1; }
                        }
                        if ($nw_spread == 1 || ($arg_count % 2) == 0) {
                            $skip_qual_err = 1;
                        }
                    }
                    # Library/submodule files without main() (e.g. Build.strada
                    # included by pacco.strada) may call sibling packages resolved
                    # by the host program.
                    if ($ctx->{"has_main"} != 1 && $pkg_is_known == 0) {
                        $skip_qual_err = 1;
                        # resolved by the host at link/load time: codegen must
                        # declare it (`extern StradaValue* Pkg_f();`), or C
                        # assumes `int` and truncates the returned pointer
                        # (crashed --shared plugins calling host functions)
                        my str $hx_blobs = "" . $ctx->{"c_blocks_str"};
                        if (length($hx_blobs) == 0 || index($hx_blobs, $all_us_name) < 0) {
                            $expr->{"host_extern"} = 1;
                        }
                    }
                }
                if (sem_is_builtin_namespace($first_ns) == 0 && $ctx->{"module_only_mode"} != 1 && $skip_qual_err == 0) {
                    my str $c_blobs = $ctx->{"c_blocks_str"};
                    if (length($c_blobs) == 0 || index($c_blobs, $all_us_name) < 0) {
                        semantic_error($ctx, "undefined function '" . $name . "'", $line);
                    }
                }
            }
            if ($is_reg == 0) {
                for (my int $i = 0; $i < $arg_count; $i = $i + 1) {
                    analyze_expression($ctx, $args->[$i]);
                }
                return;
            }
        }

        # the function this call resolved to, for the type checks
        if ($fn_info->{"is_registered"} == 1) {
            $expr->{"sem_fn_key"} = $lookup_name;
            $expr->{"sem_fn_pkg"} = "" . $fn_info->{"package"};
        }

        if ($fn_info->{"is_private"} == 1) {
            my str $callee_pkg = "" . $fn_info->{"package"};
            if (length($callee_pkg) == 0) { $callee_pkg = "main"; }
            my str $caller_pkg = "main";
            my scalar $cur_f = $ctx->{"current_func"};
            if (is_valid_node($cur_f) == 1) {
                my str $cp = "" . $cur_f->{"package"};
                if (length($cp) > 0) { $caller_pkg = $cp; }
            }
            my int $priv_ok = 0;
            if ($caller_pkg eq $callee_pkg) {
                if ($caller_pkg eq "main") {
                    my int $cfu = $ctx->{"cur_from_use"} + 0;
                    if (is_valid_node($cur_f) == 1) { $cfu = $cur_f->{"from_use"} + 0; }
                    if ($cfu == ($fn_info->{"from_use"} + 0)) {
                        my str $cfk_m = "" . $ctx->{"cur_file"};
                        if (is_valid_node($cur_f) == 1 && length("" . $cur_f->{"file"}) > 0) {
                            $cfk_m = "" . $cur_f->{"file"};
                        }
                        if ($cfu == 0 || $cfk_m eq ("" . $fn_info->{"file"})) {
                            $priv_ok = 1;
                        }
                    }
                } else {
                    $priv_ok = 1;
                }
            }
            if ($priv_ok == 0) {
                semantic_error($ctx, "cannot call private function '" . $name . "' from outside package '" . $callee_pkg . "'", $line);
            }
        }

        my int $expected = $fn_info->{"param_count"};
        my int $actual = $expr->{"arg_count"};

        # Check if any argument is a spread operator
        my int $has_spread = 0;
        for (my int $s = 0; $s < $actual; $s = $s + 1) {
            if ($args->[$s]->{"type"} == NODE_SPREAD()) {
                $has_spread = 1;
            }
        }

        # Skip arg count validation when spread is present (count unknown at compile time)
        if ($has_spread == 0) {
            # Count required parameters (those without defaults, excluding variadic params)
            my int $required = 0;
            my scalar $params = $fn_info->{"params"};
            for (my int $i = 0; $i < $expected; $i = $i + 1) {
                my scalar $param = $params->[$i];
                my int $has_def = $param->{"has_default"};
                my int $is_variadic = $param->{"is_variadic"};
                # Variadic params are optional (can have 0 items)
                if ($has_def == 0 && $is_variadic == 0) {
                    $required = $required + 1;
                }
            }

            if ($actual < $required) {
                semantic_error($ctx, "too few arguments to '" . $name . "': expected " . $required . ", got " . $actual, $line);
            }
            if ($actual > $expected) {
                # Check if function is variadic
                my int $is_var = $fn_info->{"is_variadic"};
                if ($is_var == 0) {
                    semantic_error($ctx, "too many arguments to '" . $name . "': expected " . $expected . ", got " . $actual, $line);
                }
            }
        }

        # Analyze arguments (args is already declared above)
        for (my int $i = 0; $i < $actual; $i = $i + 1) {
            analyze_expression($ctx, $args->[$i]);
            # Stage-0 type check: scalar parameters with a declared type.
            # Parameters are exempt from runtime coercion (borrowed values),
            # so a mismatch here is the highest-signal site of the four.
            if ($ctx->{"strict_types"} == 1 && $has_spread == 0 && $i < $expected) {
                my scalar $cparam = $fn_info->{"params"}->[$i];
                if ($cparam->{"is_variadic"} != 1) {
                    my str $psigil = $cparam->{"sigil"};
                    if ($psigil eq "$") {
                        my int $ptype = $cparam->{"param_type"};
                        my int $atype = stage0_expr_type($ctx, $args->[$i]);
                        if (sem_types_ok($ctx, $ptype, $atype) == 0) {
                            my int $argno = $i + 1;
                            sem_type_diag($ctx, "argument " . $argno . " to '" . $name
                                . "': expected " . ast_data_type_name($ptype)
                                . ", got " . ast_data_type_name($atype), $line);
                        }
                    } elsif (($psigil eq "@" || $psigil eq "%") && $cparam->{"elem_type"} + 0 > 0) {
                        my scalar $carg = $args->[$i];
                        if (is_valid_node($carg) == 1 && (($carg->{"type"} == NODE_VARIABLE() && ("" . $carg->{"sigil"}) eq $psigil) || $carg->{"type"} == NODE_CALL())) {
                            my int $want_et = sem_node_et($ctx, $cparam, "elem_type", "elem_class");
                            my int $have_et = sem_src_elem_type($ctx, $carg, $psigil);
                            if ($have_et > 0 && $have_et != $want_et && sem_et_compat($ctx, $want_et, $have_et) == 0) {
                                my int $cargno = $i + 1;
                                sem_type_diag($ctx, "argument " . $cargno . " to '" . $name
                                    . "': expected " . sem_elem_type_name($ctx, $psigil, $want_et)
                                    . ", got " . sem_elem_type_name($ctx, $psigil, $have_et), $line);
                            }
                        }
                    }
                }
            }
        }
        return;
    }

    # Binary operation
    if ($node_type == NODE_BINARY_OP()) {
        my str $bop = $expr->{"op"};
        if ($bop ne ",") { sem_rev_scalar($expr->{"left"}); sem_rev_scalar($expr->{"right"}); }
        # An array in numeric context is its element count (Perl): `@a + 0`,
        # `@a - 1` used to use the array reference's address.
        # Same for comparisons and string operators, and a hash gives its key
        # count (`@a == 3`, `%h + 0`, `"n=" . @a`): an @a/%h variable holds a
        # reference internally, so without this the address was compared.
        if ($bop eq "+" || $bop eq "-" || $bop eq "*" || $bop eq "/" || $bop eq "%" || $bop eq "**"
            || $bop eq "==" || $bop eq "!=" || $bop eq "<" || $bop eq "<=" || $bop eq ">" || $bop eq ">=" || $bop eq "<=>"
            || $bop eq "." || $bop eq "eq" || $bop eq "ne" || $bop eq "lt" || $bop eq "gt" || $bop eq "le" || $bop eq "ge" || $bop eq "cmp") {
            if (sem_is_container_value($ctx, $expr->{"left"}) == 1) { $expr->{"left"} = sem_scalar_of($expr->{"left"}); }
            if (sem_is_container_value($ctx, $expr->{"right"}) == 1) { $expr->{"right"} = sem_scalar_of($expr->{"right"}); }
        }
        if ($bop eq "==" || $bop eq "!=" || $bop eq "<" || $bop eq "<=" || $bop eq ">" || $bop eq ">=" || $bop eq "<=>") {
            my scalar $bleft = $expr->{"left"};
            my scalar $bright = $expr->{"right"};
            if (is_valid_node($bright) == 1 && $bright->{"type"} == NODE_INT_LITERAL() && exists($bright->{"from_sq_str"})) {
                my int $blt = stage0_expr_type($ctx, $bleft);
                if ($blt == TYPE_STR() || $blt == TYPE_NUM() || $blt == TYPE_FLOAT32() || $blt == TYPE_FLOAT64() || $blt == TYPE_LONG_DOUBLE()) {
                    $expr->{"right"} = ast_new_str_literal($bright->{"from_sq_str"});
                }
            }
            if (is_valid_node($bleft) == 1 && $bleft->{"type"} == NODE_INT_LITERAL() && exists($bleft->{"from_sq_str"})) {
                my int $brt = stage0_expr_type($ctx, $bright);
                if ($brt == TYPE_STR() || $brt == TYPE_NUM() || $brt == TYPE_FLOAT32() || $brt == TYPE_FLOAT64() || $brt == TYPE_LONG_DOUBLE()) {
                    $expr->{"left"} = ast_new_str_literal($bleft->{"from_sq_str"});
                }
            }
        }
        analyze_expression($ctx, $expr->{"left"});
        analyze_expression($ctx, $expr->{"right"});
        return;
    }

    # Unary operation
    if ($node_type == NODE_UNARY_OP()) {
        sem_rev_scalar($expr->{"operand"});
        analyze_expression($ctx, $expr->{"operand"});
        return;
    }

    # Assignment
    if ($node_type == NODE_ASSIGN()) {
        {
            my scalar $rvt = $expr->{"target"};
            if (is_valid_node($rvt) == 1) {
                my int $rvtt = $rvt->{"type"};
                if (($rvtt == NODE_VARIABLE() && ("" . $rvt->{"sigil"}) eq "$") || $rvtt == NODE_HASH_ACCESS() ||
                    $rvtt == NODE_SUBSCRIPT() || $rvtt == NODE_DEREF_HASH() || $rvtt == NODE_DEREF_ARRAY()) {
                    sem_rev_scalar($expr->{"value"});
                }
            }
        }
        {
            my scalar $ltt = $expr->{"target"};
            if (is_valid_node($ltt) == 1 && ("" . $expr->{"op"}) eq "=" && ("" . $ltt->{"sigil"}) eq "@" &&
                ($ltt->{"type"} == NODE_VARIABLE() || $ltt->{"type"} == NODE_DEREF_SCALAR())) {
                sem_tern_as_lists($expr->{"value"});
            }
        }
        analyze_expression($ctx, $expr->{"target"});
        analyze_expression($ctx, $expr->{"value"});
        if ($expr->{"op"} eq "=" && is_valid_node($expr->{"target"}) == 1) {
            my int $cat = $expr->{"target"}->{"type"};
            if ((($cat == NODE_VARIABLE() && ("" . $expr->{"target"}->{"sigil"}) eq "$") || $cat == NODE_HASH_ACCESS()
                 || $cat == NODE_SUBSCRIPT() || $cat == NODE_DEREF_HASH() || $cat == NODE_DEREF_ARRAY())
                && sem_call_returns_array($ctx, $expr->{"value"}) == 1) {
                $expr->{"value"} = sem_scalar_of($expr->{"value"});
            }
        }
        # `$h{n} = @a` / `$a[0] = @{$r}`: an array assigned to an element is
        # its count (Perl; it stored the array reference)
        if ($expr->{"op"} eq "=" && is_valid_node($expr->{"target"}) == 1 && is_valid_node($expr->{"value"}) == 1) {
            my int $et = $expr->{"target"}->{"type"};
            my scalar $ev = $expr->{"value"};
            if (($et == NODE_HASH_ACCESS() || $et == NODE_SUBSCRIPT() || $et == NODE_DEREF_HASH() || $et == NODE_DEREF_ARRAY())
                && ($ev->{"type"} == NODE_VARIABLE() || $ev->{"type"} == NODE_DEREF_SCALAR()) && ("" . $ev->{"sigil"}) eq "@") {
                $expr->{"value"} = sem_scalar_of($ev);
            }
        }
        # `$n = keys(%h)` / `$h{n} = split(...)`: keys/values/split in scalar
        # context are counts (Perl)
        if ($expr->{"op"} eq "=" && is_valid_node($expr->{"target"}) == 1 &&
            sem_is_count_in_scalar_call($ctx, $expr->{"value"}) == 1) {
            my scalar $ct = $expr->{"target"};
            my int $ctt = $ct->{"type"};
            if (($ctt == NODE_VARIABLE() && ("" . $ct->{"sigil"}) eq "$") || $ctt == NODE_HASH_ACCESS() ||
                $ctt == NODE_SUBSCRIPT() || $ctt == NODE_DEREF_HASH() || $ctt == NODE_DEREF_ARRAY()) {
                $expr->{"value"} = sem_scalar_of($expr->{"value"});
            }
        }
        # `@a = deref_array($r)` / `%h = deref_hash($r)` copy like
        # `@{$r}` / `%{$r}` (see the declaration form).
        if ($expr->{"op"} eq "=" && is_valid_node($expr->{"target"}) == 1 &&
            $expr->{"target"}->{"type"} == NODE_VARIABLE() &&
            is_valid_node($expr->{"value"}) == 1 && $expr->{"value"}->{"type"} == NODE_CALL()) {
            my str $dts = "" . $expr->{"target"}->{"sigil"};
            my str $dvn = "" . $expr->{"value"}->{"name"};
            my scalar $dva = $expr->{"value"}->{"args"};
            if ((($dts eq "@" && $dvn eq "deref_array") || ($dts eq "%" && $dvn eq "deref_hash"))
                && $dva && size($dva) == 1) {
                $expr->{"value"} = ast_new_deref_scalar($dva->[0], $dts);
            }
        }
        # `$n = @{$r}` / `$n = @$r`: the count, like `$n = @a` (it used to
        # alias the referenced array).
        if ($expr->{"op"} eq "=" && is_valid_node($expr->{"target"}) == 1 &&
            is_valid_node($expr->{"value"}) == 1 &&
            $expr->{"value"}->{"type"} == NODE_DEREF_SCALAR() && ("" . $expr->{"value"}->{"sigil"}) eq "@") {
            my scalar $dt = $expr->{"target"};
            my int $dtt = $dt->{"type"};
            # (element targets keep the array, like `$h{k} = @a`)
            if ($dtt == NODE_VARIABLE() && ("" . $dt->{"sigil"}) eq "$") {
                $expr->{"value"} = sem_scalar_of($expr->{"value"});
            }
        }
        if ($ctx->{"strict_types"} == 1 && $expr->{"op"} eq "=") {
            sem_check_elem_assign($ctx, $expr);
        }
        # Stage-0 type check: plain `=` to a declared scalar variable.
        # Compound ops (+=, .=, ...) keep their own operand semantics.
        if ($ctx->{"strict_types"} == 1 && $expr->{"op"} eq "=") {
            my scalar $tgt = $expr->{"target"};
            if ($tgt->{"type"} == NODE_VARIABLE()) {
                my str $tsigil = $tgt->{"sigil"};
                if ($tsigil eq "$") {
                    my str $t_orig = "" . $tgt->{"orig_name"};
                    if (length($t_orig) == 0) { $t_orig = "" . $tgt->{"name"}; }
                    my scalar $lk = scope_lookup_var_sigil($ctx->{"scope"}, $t_orig, "$");
                    if ($lk->{"found"} == 1) {
                        my int $dtype = sem_scalar_decl_type($ctx, $lk->{"info"}, $t_orig, ast_get_line($tgt));
                        my int $atype = stage0_expr_type($ctx, $expr->{"value"});
                        if (sem_types_ok($ctx, $dtype, $atype) == 0) {
                            # Assign nodes don't always carry a line — fall
                            # back to the target, then the value expression.
                            my int $aline = ast_get_line($expr);
                            if ($aline == 0) { $aline = ast_get_line($tgt); }
                            if ($aline == 0) { $aline = ast_get_line($expr->{"value"}); }
                            sem_type_diag($ctx, "assigning a " . ast_data_type_name($atype)
                                . " value to '$" . $t_orig . "' (declared "
                                . ast_data_type_name($dtype) . ")", $aline);
                        }
                    }
                }
            }
        }
        return;
    }

    # Array subscript ($arr[idx]): parser sets sigil "@" on $arr, which may refer
    # to `@arr` OR to a scalar/array-typed `$arr` (e.g. `my scalar $k = [keys(%h)]; $k[0]`).
    if ($node_type == NODE_SUBSCRIPT()) {
        my scalar $sub_arr = $expr->{"array"};
        if ($sub_arr->{"type"} == NODE_VARIABLE() && $sub_arr->{"sigil"} eq "@") {
            my str $sa_name = $sub_arr->{"name"};
            my int $sa_line = ast_get_line($sub_arr);
            my scalar $sa_lk = scope_lookup_var_sigil($ctx->{"scope"}, $sa_name, "@");
            my str $matched_sigil = "@";
            if ($sa_lk->{"found"} == 1 && $sa_lk->{"info"}->{"is_global"} == 1 && defined($sa_lk->{"info"}->{"decls"})) {
                if (is_valid_node(resolve_global_decl_node($ctx, $sa_lk->{"info"}, $sa_name, $sa_line, "@")) == 0) {
                    $sa_lk->{"found"} = 0;
                }
            }
            if ($sa_lk->{"found"} == 0) {
                my scalar $sa_slk = scope_lookup_var_sigil($ctx->{"scope"}, $sa_name, "$");
                if ($sa_slk->{"found"} == 1) {
                    my int $sa_vt = $sa_slk->{"info"}->{"type"};
                    if ($sa_vt == TYPE_SCALAR() || $sa_vt == TYPE_ARRAY() || $sa_vt == TYPE_DYNAMIC() || $sa_vt <= 0) {
                        $sa_lk = $sa_slk;
                        $matched_sigil = "$";
                    }
                }
            }
            if ($sa_lk->{"found"} == 0) {
                semantic_error($ctx, "undefined variable '@" . $sa_name . "'", $sa_line);
            } else {
                scope_mark_used_sigil($ctx->{"scope"}, $sa_name, $matched_sigil);
                $sub_arr->{"orig_name"} = $sa_name;
                $sub_arr->{"name"} = sem_resolve_vinfo_cname($ctx, $sa_lk->{"info"}, $sa_name, $sa_line, $matched_sigil);
            }
        } else {
            analyze_expression($ctx, $sub_arr);
        }
        analyze_expression($ctx, $expr->{"index"});
        return;
    }

    # Hash access ($h{key}): parser sets sigil "%" on $h, which may refer
    # to `%h` OR to a scalar/hash-typed `$h` (e.g. `my scalar $h = deref_hash($r); $h{"k"}`).
    if ($node_type == NODE_HASH_ACCESS()) {
        my scalar $ha_hash = $expr->{"hash"};
        if ($ha_hash->{"type"} == NODE_VARIABLE() && $ha_hash->{"sigil"} eq "%") {
            my str $hh_name = $ha_hash->{"name"};
            my int $hh_line = ast_get_line($ha_hash);
            my scalar $hh_lk = scope_lookup_var_sigil($ctx->{"scope"}, $hh_name, "%");
            my str $hmatched_sigil = "%";
            if ($hh_lk->{"found"} == 1 && $hh_lk->{"info"}->{"is_global"} == 1 && defined($hh_lk->{"info"}->{"decls"})) {
                if (is_valid_node(resolve_global_decl_node($ctx, $hh_lk->{"info"}, $hh_name, $hh_line, "%")) == 0) {
                    $hh_lk->{"found"} = 0;
                }
            }
            if ($hh_lk->{"found"} == 0) {
                my scalar $hh_slk = scope_lookup_var_sigil($ctx->{"scope"}, $hh_name, "$");
                if ($hh_slk->{"found"} == 1) {
                    my int $hh_vt = $hh_slk->{"info"}->{"type"};
                    if ($hh_vt == TYPE_SCALAR() || $hh_vt == TYPE_HASH() || $hh_vt == TYPE_DYNAMIC() || $hh_vt <= 0) {
                        $hh_lk = $hh_slk;
                        $hmatched_sigil = "$";
                    }
                }
            }
            if ($hh_lk->{"found"} == 0) {
                semantic_error($ctx, "undefined variable '%" . $hh_name . "'", $hh_line);
            } else {
                scope_mark_used_sigil($ctx->{"scope"}, $hh_name, $hmatched_sigil);
                $ha_hash->{"orig_name"} = $hh_name;
                $ha_hash->{"name"} = sem_resolve_vinfo_cname($ctx, $hh_lk->{"info"}, $hh_name, $hh_line, $hmatched_sigil);
            }
        } else {
            analyze_expression($ctx, $ha_hash);
        }
        analyze_expression($ctx, $expr->{"key"});
        return;
    }

    # Array slice (@arr[0, 2])
    if ($node_type == NODE_ARRAY_SLICE()) {
        analyze_expression($ctx, $expr->{"source"});
        my scalar $as_items = $expr->{"items"};
        my int $as_count = $expr->{"item_count"};
        for (my int $asi = 0; $asi < $as_count; $asi = $asi + 1) {
            analyze_expression($ctx, $as_items->[$asi]);
        }
        return;
    }

    # Hash slice (@hash{"a", "b"}) — source AST node carries '@' sigil from `@hash`,
    # while the underlying container variable in scope is `%hash` (sigil '%').
    if ($node_type == NODE_HASH_SLICE()) {
        my scalar $hs_src = $expr->{"source"};
        if ($hs_src->{"type"} == NODE_VARIABLE() && $hs_src->{"sigil"} eq "@") {
            my str $hs_name = $hs_src->{"name"};
            my int $hs_line = ast_get_line($hs_src);
            my scalar $hs_lk = scope_lookup_var_sigil($ctx->{"scope"}, $hs_name, "%");
            if ($hs_lk->{"found"} == 0) {
                semantic_error($ctx, "undefined variable '%" . $hs_name . "'", $hs_line);
            } else {
                scope_mark_used_sigil($ctx->{"scope"}, $hs_name, "%");
                $hs_src->{"orig_name"} = $hs_name;
                $hs_src->{"name"} = sem_resolve_vinfo_cname($ctx, $hs_lk->{"info"}, $hs_name, $hs_line, "%");
            }
        } else {
            analyze_expression($ctx, $hs_src);
        }
        my scalar $hs_items = $expr->{"items"};
        my int $hs_count = $expr->{"item_count"};
        for (my int $hsi = 0; $hsi < $hs_count; $hsi = $hsi + 1) {
            analyze_expression($ctx, $hs_items->[$hsi]);
        }
        return;
    }

    # Reference
    if ($node_type == NODE_REF()) {
        analyze_expression($ctx, $expr->{"target"});
        return;
    }

    # Dereference
    if ($node_type == NODE_DEREF_SCALAR() || $node_type == NODE_DEREF_ARRAY() || $node_type == NODE_DEREF_HASH()) {
        analyze_expression($ctx, $expr->{"ref"});
        if ($node_type == NODE_DEREF_ARRAY()) {
            analyze_expression($ctx, $expr->{"index"});
        }
        if ($node_type == NODE_DEREF_HASH()) {
            analyze_expression($ctx, $expr->{"key"});
        }
        return;
    }

    # Field access
    if ($node_type == NODE_FIELD_ACCESS()) {
        analyze_expression($ctx, $expr->{"object"});
        return;
    }

    # Anonymous array
    if ($node_type == NODE_ANON_ARRAY()) {
        my scalar $elems = $expr->{"elements"};
        my int $count = $expr->{"element_count"};
        for (my int $i = 0; $i < $count; $i = $i + 1) {
            analyze_expression($ctx, $elems->[$i]);
        }
        return;
    }

    # Anonymous hash (including computed key_exprs)
    if ($node_type == NODE_ANON_HASH()) {
        my scalar $key_exprs = $expr->{"key_exprs"};
        my scalar $values = $expr->{"values"};
        my int $count = $expr->{"pair_count"};
        for (my int $i = 0; $i < $count; $i = $i + 1) {
            if (is_valid_node($key_exprs->[$i]) == 1) {
                analyze_expression($ctx, $key_exprs->[$i]);
            }
            analyze_expression($ctx, $values->[$i]);
        }
        return;
    }

    # Method call
    if ($node_type == NODE_METHOD_CALL()) {
        analyze_expression($ctx, $expr->{"object"});
        my scalar $args = $expr->{"args"};
        my int $count = $expr->{"arg_count"};
        for (my int $i = 0; $i < $count; $i = $i + 1) {
            analyze_expression($ctx, $args->[$i]);
        }
        if ($ctx->{"strict_types"} == 1 && $count > 0) {
            my str $mc_name = "" . $expr->{"method"};
            my str $mc_cls = sem_recv_class($ctx, $expr->{"base_object"});
            if (length($mc_cls) > 0 && $mc_name ne "isa" && $mc_name ne "can") {
                my str $mc_fk = sem_method_target($ctx, $mc_cls, $ctx->{"recv_exact"} + 0, $mc_name, 0);
                if (length($mc_fk) > 0) {
                    sem_check_method_args($ctx, $mc_fk, $mc_name, $args, $count, $line);
                }
            }
        }
        return;
    }

    # Dynamic method call ($obj->$method(args))
    if ($node_type == NODE_DYN_METHOD_CALL()) {
        analyze_expression($ctx, $expr->{"base_object"});
        analyze_expression($ctx, $expr->{"method_expr"});
        my scalar $dmc_args = $expr->{"args"};
        my int $dmc_count = $expr->{"arg_count"};
        for (my int $dmc_i = 0; $dmc_i < $dmc_count; $dmc_i = $dmc_i + 1) {
            analyze_expression($ctx, $dmc_args->[$dmc_i]);
        }
        return;
    }

    # SUPER:: call
    if ($node_type == NODE_SUPER_CALL()) {
        my scalar $args = $expr->{"args"};
        my int $count = $expr->{"arg_count"};
        for (my int $i = 0; $i < $count; $i = $i + 1) {
            analyze_expression($ctx, $args->[$i]);
        }
        if ($ctx->{"strict_types"} == 1 && $count > 0 && is_valid_node($ctx->{"asg_root"}) == 1) {
            my str $sc_name = "" . $expr->{"method"};
            my str $sc_fk = sem_method_target($ctx, "" . $ctx->{"asg_root"}->{"package"}, 1, $sc_name, 1);
            if (length($sc_fk) > 0) {
                sem_check_method_args($ctx, $sc_fk, $sc_name, $args, $count, $line);
            }
        }
        return;
    }

    # Closure call ($closure->(args))
    if ($node_type == NODE_CLOSURE_CALL()) {
        analyze_expression($ctx, $expr->{"closure"});
        my scalar $args = $expr->{"args"};
        my int $count = $expr->{"arg_count"};
        for (my int $i = 0; $i < $count; $i = $i + 1) {
            analyze_expression($ctx, $args->[$i]);
        }
        return;
    }

    # Ternary expression ($cond ? $true_expr : $false_expr)
    if ($node_type == NODE_TERNARY()) {
        sem_rev_scalar($expr->{"condition"});
        analyze_expression($ctx, $expr->{"condition"});
        analyze_expression($ctx, $expr->{"true_expr"});
        analyze_expression($ctx, $expr->{"false_expr"});
        return;
    }

    # Increment / decrement (++$x, $x--)
    if ($node_type == NODE_INCREMENT()) {
        analyze_expression($ctx, $expr->{"operand"});
        return;
    }

    # Range expression ($start .. $end)
    if ($node_type == NODE_RANGE()) {
        analyze_expression($ctx, $expr->{"start"});
        analyze_expression($ctx, $expr->{"end"});
        return;
    }

    # map { block } @array and grep { block } @array (with $_ in scope)
    if ($node_type == NODE_MAP() || $node_type == NODE_GREP()) {
        analyze_expression($ctx, $expr->{"array"});
        if (is_valid_node($expr->{"block"}) == 1) {
            my scalar $mg_outer = $ctx->{"scope"};
            $ctx->{"scope"} = scope_new($mg_outer);
            scope_add_var($ctx->{"scope"}, "_", "$", TYPE_SCALAR(), $line);
            scope_mark_used_sigil($ctx->{"scope"}, "_", "$");
            analyze_block($ctx, $expr->{"block"});
            $ctx->{"scope"} = $mg_outer;
        }
        return;
    }

    # sort { $a <=> $b } @array (with $a and $b in scope)
    if ($node_type == NODE_SORT()) {
        analyze_expression($ctx, $expr->{"array"});
        if (is_valid_node($expr->{"block"}) == 1) {
            my scalar $sort_outer = $ctx->{"scope"};
            $ctx->{"scope"} = scope_new($sort_outer);
            scope_add_var($ctx->{"scope"}, "a", "$", TYPE_SCALAR(), $line);
            scope_mark_used_sigil($ctx->{"scope"}, "a", "$");
            scope_add_var($ctx->{"scope"}, "b", "$", TYPE_SCALAR(), $line);
            scope_mark_used_sigil($ctx->{"scope"}, "b", "$");
            analyze_block($ctx, $expr->{"block"});
            $ctx->{"scope"} = $sort_outer;
        }
        return;
    }

    # Regex match ($str =~ /pattern/)
    if ($node_type == NODE_REGEX_MATCH()) {
        analyze_expression($ctx, $expr->{"target"});
        $expr->{"pattern"} = analyze_regex_interp_n($ctx, "" . $expr->{"pattern"}, $line, $expr);
        return;
    }

    # Regex substitution ($str =~ s/pattern/replacement/flags)
    if ($node_type == NODE_REGEX_SUBST()) {
        analyze_expression($ctx, $expr->{"target"});
        $expr->{"pattern"} = analyze_regex_interp_n($ctx, "" . $expr->{"pattern"}, $line, $expr);
        my str $sflags = "" . $expr->{"flags"};
        if (index($sflags, "e") >= 0) {
            if (is_valid_node($expr->{"eval_expr"}) == 1) {
                analyze_expression($ctx, $expr->{"eval_expr"});
            }
        } else {
            $expr->{"replacement"} = analyze_regex_interp_n($ctx, "" . $expr->{"replacement"}, $line, $expr);
        }
        return;
    }

    # Transliteration ($str =~ tr/search/replace/flags)
    if ($node_type == NODE_TR()) {
        analyze_expression($ctx, $expr->{"target"});
        return;
    }

    # await expression
    if ($node_type == NODE_AWAIT()) {
        $ctx->{"uses_threads"} = 1;
        analyze_expression($ctx, $expr->{"expr"});
        return;
    }

    # Diamond readline (<$fh> or <STDIN>)
    if ($node_type == NODE_READLINE()) {
        my str $rl_var = "" . $expr->{"varname"};
        if (length($rl_var) > 0) {
            my scalar $rl_lk = scope_lookup_var_sigil($ctx->{"scope"}, $rl_var, "$");
            if ($rl_lk->{"found"} == 0) {
                semantic_error($ctx, "undefined variable '$" . $rl_var . "'", $line);
            } else {
                scope_mark_used_sigil($ctx->{"scope"}, $rl_var, "$");
                $expr->{"orig_varname"} = $rl_var;
                $expr->{"varname"} = sem_resolve_vinfo_cname($ctx, $rl_lk->{"info"}, $rl_var, $line, "$");
            }
        }
        return;
    }

    # Spread expression (...@arr)
    if ($node_type == NODE_SPREAD()) {
        analyze_expression($ctx, $expr->{"target"});
        return;
    }

    # Literals - no validation needed
    # NODE_INT_LITERAL, NODE_NUM_LITERAL, NODE_STR_LITERAL, NODE_FUNC_REF
}

func scope_check_param_redecl(scalar $ctx, scalar $current_scope, str $name, str $sigil, str $kind, int $line) void {
    my scalar $parent_scope = $current_scope->{"parent"};
    if ($parent_scope && ($parent_scope->{"is_param_scope"} + 0) == 1) {
        my scalar $pvars = $parent_scope->{"vars"};
        if (exists($pvars->{$name})) {
            my scalar $prev_info = $pvars->{$name};
            my int $prev_line = $prev_info->{"line"};
            semantic_error($ctx, $kind . " '" . $sigil . $name . "' redeclares parameter '" . $prev_info->{"sigil"} . $name . "' (declared at line " . $prev_line . ")", $line);
        }
    }
}

func analyze_statement(scalar $ctx, scalar $stmt) void {
    my int $node_type = $stmt->{"type"};
    my int $line = ast_get_line($stmt);
    if ($line > 0) { $ctx->{"cur_stmt_line"} = $line; }

    # Variable declaration
    if ($node_type == NODE_VAR_DECL()) {
        my str $name = $stmt->{"name"};
        my str $sigil = $stmt->{"sigil"};
        my int $var_type = $stmt->{"var_type"};
        # `my $x = ();` - an empty list in scalar context is undef.
        if ($sigil eq "$" && $stmt->{"init"} && $stmt->{"init"}->{"is_empty_list"}) {
            $stmt->{"init"} = ast_new_undef();
        }
        # `my @a = (0) x 10`: in list context a parenthesized left side of
        # `x` is a list, repeated.
        if ($sigil eq "@" && $stmt->{"init"} && $stmt->{"init"}->{"type"} == NODE_BINARY_OP()
            && $stmt->{"init"}->{"op"} eq "x" && $stmt->{"init"}->{"left"}->{"in_parens"}
            && !$stmt->{"init"}->{"left"}->{"is_list"}) {
            my scalar $xl = ast_new_anon_array();
            $xl->{"is_list"} = 1;
            ast_add_array_elem($xl, $stmt->{"init"}->{"left"});
            $stmt->{"init"}->{"left"} = $xl;
        }
        if ($sigil eq "@") { sem_tern_as_lists($stmt->{"init"}); }
        # `my @a = deref_array($r)` / `my %h = deref_hash($r)` copy like
        # `@{$r}` / `%{$r}` (they used to alias the referenced container).
        if (($sigil eq "@" || $sigil eq "%") && $stmt->{"init"} && $stmt->{"init"}->{"type"} == NODE_CALL()) {
            my str $dcn = "" . $stmt->{"init"}->{"name"};
            my scalar $dca = $stmt->{"init"}->{"args"};
            if ((($sigil eq "@" && $dcn eq "deref_array") || ($sigil eq "%" && $dcn eq "deref_hash"))
                && $dca && size($dca) == 1) {
                $stmt->{"init"} = ast_new_deref_scalar($dca->[0], $sigil);
            }
        }
        # `my int $n = arr()` / `my $n = grep {...} @x`: an array value in
        # scalar context is its count (it used to store the array reference,
        # or 0 / the address after int coercion).
        if ($sigil eq "@" && $stmt->{"init"} && $stmt->{"init"}->{"type"} == NODE_REGEX_MATCH()) {
            $stmt->{"init"}->{"list_ctx"} = 1;   # my @m = $s =~ /(\d+)/g
        }
        if ($sigil eq "$" && $stmt->{"init"} && $stmt->{"init"}->{"type"} == NODE_CALL() && $stmt->{"init"}->{"name"} eq "splice") {
            $stmt->{"init"}->{"scalar_ctx"} = 1;
        }
        if ($sigil eq "$") { sem_rev_scalar($stmt->{"init"}); }
        # `my $n = keys %h` / values / split: a count in scalar context (Perl)
        if ($sigil eq "$" && $stmt->{"init"} && sem_is_count_in_scalar_call($ctx, $stmt->{"init"}) == 1) {
            $stmt->{"init"} = sem_scalar_of($stmt->{"init"});
        }
        if ($sigil eq "$" && $stmt->{"init"} && sem_call_returns_array($ctx, $stmt->{"init"}) == 1) {
            $stmt->{"init"} = sem_scalar_of($stmt->{"init"});
        }
        if ($sigil eq "$" && $stmt->{"init"} && sem_is_array_value($ctx, $stmt->{"init"}) == 1) {
            my int $iit = $stmt->{"init"}->{"type"};
            # `my $n = @{$r}` / `@$r`: the count, like `my $n = @a` (it
            # used to alias the referenced array).
            if ($var_type == TYPE_INT() || $var_type == TYPE_NUM() || $iit == NODE_GREP() || $iit == NODE_MAP()
                || $iit == NODE_DEREF_SCALAR()) {
                $stmt->{"init"} = sem_scalar_of($stmt->{"init"});
            }
        }

        # Check for redeclaration in current scope
        my scalar $current_scope = $ctx->{"scope"};
        my scalar $scope_vars = $current_scope->{"vars"};
        # `my %t; my @t;` (Perl): the same name with another sigil is a
        # separate variable. It is kept under the sigil-qualified key, with
        # its own C name (the two would collide in C).
        my int $other_sigil = 0;
        if (exists($scope_vars->{$name}) && !exists($scope_vars->{$sigil . ":" . $name})
            && ("" . $scope_vars->{$name}->{"sigil"}) ne $sigil && $scope_vars->{$name}->{"is_global"} != 1) {
            $other_sigil = 1;
        }
        if ($other_sigil == 0 && (exists($scope_vars->{$name}) || exists($scope_vars->{$sigil . ":" . $name}))) {
            my scalar $prev_info = $scope_vars->{$name};
            if (!defined($prev_info)) {
                $prev_info = $scope_vars->{$sigil . ":" . $name};
            }
            my int $prev_line = $prev_info->{"line"};
            semantic_error($ctx, "variable '" . $sigil . $name . "' already declared in this scope (previous declaration at line " . $prev_line . ")", $line);
        }
        scope_check_param_redecl($ctx, $current_scope, $name, $sigil, "variable", $line);

        my str $c_alias = sem_alloc_local_cname($ctx, $current_scope, $name);
        if (length($c_alias) == 0 && $other_sigil == 0 && sem_local_hides_func($ctx, $name) == 1) {
            # `my $cnt = cnt();`: in C the local would hide the function
            $c_alias = $name . "__fnv";
        }
        if ($other_sigil == 1) {
            my str $sg_tag = "s";
            if ($sigil eq "@") { $sg_tag = "a"; }
            if ($sigil eq "%") { $sg_tag = "h"; }
            $c_alias = $name . "__sg" . $sg_tag;
        }
        my scalar $init_expr = $stmt->{"init"};
        my int $init_before = 0;
        if (length($c_alias) > 0 && is_valid_node($init_expr) == 1 && $init_expr->{"type"} != NODE_ANON_FUNC()) {
            $init_before = 1;
            if (is_valid_node($stmt->{"initial_capacity"}) == 1) {
                analyze_expression($ctx, $stmt->{"initial_capacity"});
            }
            analyze_expression($ctx, $init_expr);
        }

        # Add variable to scope
        my str $add_key = $name;
        if ($other_sigil == 1) { $add_key = $sigil . ":" . $name; }
        scope_add_var($current_scope, $add_key, $sigil, $var_type, $line);
        if ($stmt->{"elem_type"} + 0 > 0) {
            $current_scope->{"vars"}->{$add_key}->{"elem_type"} = sem_node_et($ctx, $stmt, "elem_type", "elem_class");
        }
        if ($sigil eq "$" && $ctx->{"strict_types"} == 1 && is_valid_node($init_expr) == 1) {
            my str $init_cls = sem_value_class($ctx, $init_expr);
            sem_note_obj_class($ctx, $current_scope, $add_key, $init_cls, $ctx->{"recv_exact"} + 0);
        }
        if (length($c_alias) > 0) {
            $stmt->{"orig_name"} = $name;
            $stmt->{"name"} = $c_alias;
            $current_scope->{"vars"}->{$add_key}->{"c_name"} = $c_alias;
        }

        if ($init_before == 0) {
            # Analyze optional initial_capacity expression if present
            if (is_valid_node($stmt->{"initial_capacity"}) == 1) {
                analyze_expression($ctx, $stmt->{"initial_capacity"});
            }
            # Analyze initializer if present
            if (is_valid_node($init_expr) == 1) {
                analyze_expression($ctx, $init_expr);
            }
        }
        if (is_valid_node($init_expr) == 1) {
            # Stage-0 type check (scalar declarations only — array/hash
            # initializers are flattening lists with their own semantics).
            if ($ctx->{"strict_types"} == 1 && $sigil eq "$") {
                my int $atype = stage0_expr_type($ctx, $init_expr);
                if (sem_types_ok($ctx, $var_type, $atype) == 0) {
                    sem_type_diag($ctx, "initializing '" . $sigil . $name . "' (declared "
                        . ast_data_type_name($var_type) . ") with a "
                        . ast_data_type_name($atype) . " value", $line);
                }
            }
            if ($ctx->{"strict_types"} == 1 && $sigil eq "@" && $stmt->{"elem_type"} + 0 > 0) {
                sem_check_elem_value($ctx, sem_node_et($ctx, $stmt, "elem_type", "elem_class"), $init_expr, $name, "@", $line);
            }
            if ($ctx->{"strict_types"} == 1 && $sigil eq "%" && $stmt->{"elem_type"} + 0 > 0) {
                sem_check_hash_literal($ctx, sem_node_et($ctx, $stmt, "elem_type", "elem_class"), $init_expr, $name, $line);
            }
        }
        return;
    }

    # Const declaration - similar to var decl but with $ sigil
    if ($node_type == NODE_CONST_DECL()) {
        my str $name = $stmt->{"name"};
        my int $var_type = $stmt->{"var_type"};

        # Check for redeclaration in current scope
        my scalar $current_scope = $ctx->{"scope"};
        my scalar $scope_vars = $current_scope->{"vars"};
        if (exists($scope_vars->{$name})) {
            my scalar $prev_info = $scope_vars->{$name};
            my int $prev_line = $prev_info->{"line"};
            semantic_error($ctx, "constant '" . $name . "' already declared in this scope (previous declaration at line " . $prev_line . ")", $line);
        }
        scope_check_param_redecl($ctx, $current_scope, $name, "$", "constant", $line);

        my str $const_calias = sem_alloc_local_cname($ctx, $current_scope, $name);
        my scalar $init_expr = $stmt->{"init"};
        my int $c_init_before = 0;
        if (length($const_calias) > 0 && is_valid_node($init_expr) == 1 && $init_expr->{"type"} != NODE_ANON_FUNC()) {
            $c_init_before = 1;
            analyze_expression($ctx, $init_expr);
        }

        # Add const to scope as a scalar
        scope_add_var($current_scope, $name, "$", $var_type, $line);
        if (length($const_calias) > 0) {
            $stmt->{"orig_name"} = $name;
            $stmt->{"name"} = $const_calias;
            $current_scope->{"vars"}->{$name}->{"c_name"} = $const_calias;
        }

        # Analyze initializer (required for const)
        if ($c_init_before == 0 && is_valid_node($init_expr) == 1) {
            analyze_expression($ctx, $init_expr);
        }
        return;
    }

    # Our declaration (package-scoped global via global registry)
    if ($node_type == NODE_OUR_DECL()) {
        my str $name = $stmt->{"name"};
        my str $sigil = $stmt->{"sigil"};
        my int $var_type = $stmt->{"var_type"};
        my str $opkg = "" . $ctx->{"cur_pkg"};
        if (length($opkg) == 0) { $opkg = "main"; }
        my str $our_key = sem_our_key($opkg, $sigil, $name);
        my str $our_cname = sem_our_cname($opkg, $sigil, $name);

        my scalar $current_scope = $ctx->{"scope"};
        my str $our_shadow = sem_alloc_local_cname($ctx, $current_scope, $name);
        if (length($our_shadow) > 0) {
            my int $sid = ($ctx->{"local_shadow_id"} + 0);
            $our_cname = $our_cname . "__lsh" . $sid;
        }
        $stmt->{"orig_name"} = $name;
        $stmt->{"our_key"} = $our_key;
        $stmt->{"name"} = $our_cname;

        # Add variable to scope keyed by sigil:name so `our $x`, `our @x`,
        # `our %x` in the same function/block never clobber one another.
        my str $skey = $sigil . ":" . $name;
        scope_add_var($current_scope, $skey, $sigil, $var_type, $line);
        my scalar $oinfo = $current_scope->{"vars"}->{$skey};
        $oinfo->{"is_our"} = 1;
        $oinfo->{"c_name"} = $our_cname;
        $oinfo->{"our_key"} = $our_key;
        if ($stmt->{"elem_type"} + 0 > 0) {
            $oinfo->{"elem_type"} = sem_node_et($ctx, $stmt, "elem_type", "elem_class");
        }

        # Analyze initializer if present
        sem_scalar_decl_count($ctx, $stmt);
        if ($sigil eq "@") { sem_tern_as_lists($stmt->{"init"}); }
        my scalar $init_expr = $stmt->{"init"};
        if (is_valid_node($init_expr) == 1) {
            analyze_expression($ctx, $init_expr);
            if ($ctx->{"strict_types"} == 1 && $sigil eq "$") {
                my int $our_atype = stage0_expr_type($ctx, $init_expr);
                if (sem_types_ok($ctx, $var_type, $our_atype) == 0) {
                    sem_type_diag($ctx, "initializing '$" . $name . "' (declared "
                        . ast_data_type_name($var_type) . ") with a "
                        . ast_data_type_name($our_atype) . " value", $line);
                }
            }
            if ($ctx->{"strict_types"} == 1 && $sigil eq "@" && $stmt->{"elem_type"} + 0 > 0) {
                sem_check_elem_value($ctx, sem_node_et($ctx, $stmt, "elem_type", "elem_class"), $init_expr, $name, "@", $line);
            }
            if ($ctx->{"strict_types"} == 1 && $sigil eq "%" && $stmt->{"elem_type"} + 0 > 0) {
                sem_check_hash_literal($ctx, sem_node_et($ctx, $stmt, "elem_type", "elem_class"), $init_expr, $name, $line);
            }
        }
        return;
    }

    # Dynamic localization: local $our_var = expr; or local $hash{key} = expr;
    if ($node_type == NODE_LOCAL_DECL()) {
        my str $name = $stmt->{"name"};
        my str $sigil = $stmt->{"sigil"};
        if ($stmt->{"is_hash_elem"} == 1) {
            my scalar $hk = $stmt->{"hash_key"};
            if (is_valid_node($hk) == 1) {
                analyze_expression($ctx, $hk);
            }
            if (index($name, "::") < 0) {
                my scalar $hlk = scope_lookup_var_sigil($ctx->{"scope"}, $name, "%");
                if ($hlk->{"found"} == 0) {
                    semantic_error($ctx, "undefined variable '%" . $name . "'", $line);
                } else {
                    scope_mark_used_sigil($ctx->{"scope"}, $name, "%");
                    my scalar $hvinfo = $hlk->{"info"};
                    if ($hvinfo->{"is_global"} == 1 && defined($hvinfo->{"decls"})) {
                        my scalar $hd = resolve_global_decl_node($ctx, $hvinfo, $name, $line, "%");
                        if (is_valid_node($hd) == 1) {
                            $stmt->{"name"} = $hd->{"name"};
                            if (length("" . $hd->{"our_key"}) > 0) {
                                $stmt->{"our_key"} = $hd->{"our_key"};
                            }
                        } else {
                            semantic_error($ctx, "undefined variable '%" . $name . "'", $line);
                        }
                    } else {
                        if (length("" . $hvinfo->{"c_name"}) > 0) {
                            $stmt->{"name"} = $hvinfo->{"c_name"};
                        }
                        if (length("" . $hvinfo->{"our_key"}) > 0) {
                            $stmt->{"our_key"} = $hvinfo->{"our_key"};
                        }
                    }
                }
            }
        } else {
            if (index($name, "::") < 0 && $name ne "_" && $name ne "/" && $name ne "\\" && $name ne "," && $name ne "\"") {
                my scalar $lk = scope_lookup_var_sigil($ctx->{"scope"}, $name, $sigil);
                if ($lk->{"found"} == 0) {
                    semantic_error($ctx, "undefined variable '" . $sigil . $name . "'", $line);
                } else {
                    my scalar $vinfo = $lk->{"info"};
                    if ($vinfo->{"is_global"} == 1 && defined($vinfo->{"decls"})) {
                        my scalar $ld = resolve_global_decl_node($ctx, $vinfo, $name, $line, $sigil);
                        if (is_valid_node($ld) == 0) {
                            semantic_error($ctx, "undefined variable '" . $sigil . $name . "'", $line);
                        } elsif ($ld->{"type"} != NODE_OUR_DECL()) {
                            semantic_error($ctx, "Can't localize lexical variable " . $sigil . $name, $line);
                        } else {
                            scope_mark_used_sigil($ctx->{"scope"}, $name, $sigil);
                            $stmt->{"name"} = $ld->{"name"};
                            $stmt->{"our_key"} = $ld->{"our_key"};
                        }
                    } else {
                        if ($vinfo->{"is_our"} != 1) {
                            semantic_error($ctx, "Can't localize lexical variable " . $sigil . $name, $line);
                        } else {
                            if (length("" . $vinfo->{"c_name"}) > 0) {
                                $stmt->{"name"} = $vinfo->{"c_name"};
                            }
                            if (length("" . $vinfo->{"our_key"}) > 0) {
                                $stmt->{"our_key"} = $vinfo->{"our_key"};
                            }
                        }
                        scope_mark_used_sigil($ctx->{"scope"}, $name, $sigil);
                    }
                }
            }
        }
        my scalar $init_expr = $stmt->{"init"};
        if (is_valid_node($init_expr) == 1) {
            analyze_expression($ctx, $init_expr);
            if ($ctx->{"strict_types"} == 1 && $stmt->{"is_hash_elem"} != 1 && index($name, "::") < 0 && ($sigil eq "@" || $sigil eq "%")) {
                my int $loc_et = sem_name_elem_type($ctx, $name, $sigil, $line);
                if ($loc_et > 0 && $sigil eq "@") {
                    sem_check_elem_value($ctx, $loc_et, $init_expr, $name, "@", $line);
                }
                if ($loc_et > 0 && $sigil eq "%") {
                    sem_check_hash_literal($ctx, $loc_et, $init_expr, $name, $line);
                }
            }
        }
        return;
    }

    # Destructuring assignment: my ($a, $b, $c) = expr; or ($a, $b) = expr;
    if ($node_type == NODE_DESTRUCTURE()) {
        my scalar $vars = $stmt->{"vars"};
        my int $var_count = $stmt->{"var_count"};
        my int $is_decl = $stmt->{"is_decl"};
        my scalar $current_scope = $ctx->{"scope"};
        my scalar $scope_vars = $current_scope->{"vars"};

        # Analyze initializer before registering new declaration bindings so
        # `my ($a, $b) = ($b, $a);` resolves RHS against outer scope cleanly.
        my scalar $init_expr = $stmt->{"init"};
        if (is_valid_node($init_expr) == 1 && $init_expr->{"type"} == NODE_REGEX_MATCH()) {
            $init_expr->{"list_ctx"} = 1;   # my ($a, $b) = $s =~ /(.)(.)/
        }
        if (is_valid_node($init_expr) == 1) {
            analyze_expression($ctx, $init_expr);
        }

        # Register all variables if this is a declaration; otherwise validate existing targets
        if ($is_decl == 1) {
            my int $i = 0;
            while ($i < $var_count) {
                my scalar $var = $vars->[$i];
                my str $name = $var->{"name"};
                my str $sigil = $var->{"sigil"};
                my int $var_type = $var->{"var_type"};

                # Check for redeclaration in current scope
                if (exists($scope_vars->{$name}) || exists($scope_vars->{$sigil . ":" . $name})) {
                    my scalar $prev_info = $scope_vars->{$name};
                    if (!defined($prev_info)) {
                        $prev_info = $scope_vars->{$sigil . ":" . $name};
                    }
                    my int $prev_line = $prev_info->{"line"};
                    semantic_error($ctx, "variable '" . $sigil . $name . "' already declared in this scope (previous declaration at line " . $prev_line . ")", $line);
                }
                scope_check_param_redecl($ctx, $current_scope, $name, $sigil, "variable", $line);

                my str $d_calias = sem_alloc_local_cname($ctx, $current_scope, $name);
                # Add variable to scope
                scope_add_var($current_scope, $name, $sigil, $var_type, $line);
                if (length($d_calias) > 0) {
                    $var->{"orig_name"} = $name;
                    $var->{"name"} = $d_calias;
                    $current_scope->{"vars"}->{$name}->{"c_name"} = $d_calias;
                }
                $i = $i + 1;
            }
        } else {
            my int $i = 0;
            while ($i < $var_count) {
                my scalar $var = $vars->[$i];
                my str $name = $var->{"name"};
                my str $sigil = $var->{"sigil"};
                my int $vline = ast_get_line($var);
                if ($vline <= 0) { $vline = $line; }
                my scalar $dlk = scope_lookup_var_sigil($current_scope, $name, $sigil);
                if ($dlk->{"found"} == 0) {
                    semantic_error($ctx, "undefined variable '" . $sigil . $name . "'", $line);
                } else {
                    scope_mark_used_sigil($current_scope, $name, $sigil);
                    $var->{"orig_name"} = $name;
                    $var->{"name"} = sem_resolve_vinfo_cname($ctx, $dlk->{"info"}, $name, $vline, $sigil);
                }
                $i = $i + 1;
            }
        }
        return;
    }

    # Nested block statement (`{ ... }`, including `while (my $x = ...)` wrapper blocks)
    if ($node_type == NODE_BLOCK()) {
        analyze_block($ctx, $stmt);
        return;
    }

    # Expression statement
    if ($node_type == NODE_EXPR_STMT()) {
        my str $epkg = "" . $stmt->{"eval_package"};
        if (length($epkg) > 0) {
            my str $saved_pkg = "" . $ctx->{"cur_pkg"};
            my str $saved_eval_pkg = "" . $ctx->{"eval_package"};
            $ctx->{"cur_pkg"} = $epkg;
            $ctx->{"eval_package"} = $epkg;
            analyze_expression($ctx, $stmt->{"expr"});
            $ctx->{"cur_pkg"} = $saved_pkg;
            $ctx->{"eval_package"} = $saved_eval_pkg;
            return;
        }
        analyze_expression($ctx, $stmt->{"expr"});
        return;
    }

    # Return statement
    if ($node_type == NODE_RETURN_STMT()) {
        my scalar $ret_val = $stmt->{"value"};
        # A bare `return;` from a hash function returns an empty hash.
        if (is_valid_node($ret_val) == 0) {
            my scalar $bcur = $ctx->{"current_func"};
            if ($bcur && $bcur->{"return_type"} == TYPE_HASH()) {
                $ret_val = ast_new_anon_hash();
                $stmt->{"value"} = $ret_val;
            }
        }
        # `return ();` - an empty list: an empty hash/array for container
        # returns, nothing for void, undef for scalar returns (it used to
        # return an empty HASH ref).
        if (is_valid_node($ret_val) == 1 && $ret_val->{"is_empty_list"}) {
            my scalar $ecur = $ctx->{"current_func"};
            my int $ert = TYPE_SCALAR();
            if ($ecur) { $ert = $ecur->{"return_type"}; }
            if ($ert == TYPE_HASH()) {
                $ret_val->{"is_empty_list"} = 0;
            } elsif ($ert == TYPE_VOID()) {
                $stmt->{"value"} = 0;
                $ret_val = 0;
            } elsif ($ert != TYPE_ARRAY() && $ert != TYPE_DYNAMIC()) {
                $ret_val = ast_new_undef();
                $stmt->{"value"} = $ret_val;
            }
        }
        if (is_valid_node($ret_val) == 1) {
            # `return @a` from an int/num function returns the count.
            my scalar $rcur = $ctx->{"current_func"};
            # One plain value from an array function is a one-item list
            # (it was returned as the bare value: `my $n = f()` counted 0).
            if ($rcur && $rcur->{"return_type"} == TYPE_ARRAY() && ast_is_plain_value($ret_val) == 1) {
                my scalar $one_lst = ast_new_anon_array();
                $one_lst->{"is_list"} = 1;
                $one_lst->{"line"} = $ret_val->{"line"};
                ast_add_array_elem($one_lst, $ret_val);
                $ret_val = $one_lst;
                $stmt->{"value"} = $ret_val;
            }
            if ($rcur) {
                my int $rrt = $rcur->{"return_type"} + 0;
                if ($rrt != TYPE_ARRAY() && $rrt != TYPE_HASH() && $rrt != TYPE_DYNAMIC() && $rrt != TYPE_VOID()) {
                    sem_rev_scalar($ret_val);
                    # return C ? X : (): the `()` branch is undef, as a bare
                    # `return ()` is here; in an int/num function an array
                    # branch is its count, as a bare `return @a` is.
                    if ($ret_val->{"type"} == NODE_TERNARY()) {
                        if ($rrt == TYPE_INT() || $rrt == TYPE_NUM()) {
                            ast_tern_scalar($ret_val, 1);
                        } else {
                            sem_tern_empty_undef($ret_val);
                        }
                    }
                }
            }
            if ($rcur && ($rcur->{"return_type"} == TYPE_INT() || $rcur->{"return_type"} == TYPE_NUM()) && sem_is_array_value($ctx, $ret_val) == 1) {
                $ret_val = sem_scalar_of($ret_val);
                $stmt->{"value"} = $ret_val;
            }
            analyze_expression($ctx, $ret_val);
            my scalar $cur = $ctx->{"current_func"};
            if ($cur) {
                my int $rtype = $cur->{"return_type"};
                if ($rtype == TYPE_VOID()) {
                    semantic_error($ctx, "cannot return a value from void function '" . $cur->{"name"} . "'", $line);
                } elsif ($ctx->{"strict_types"} == 1 && $rtype != TYPE_DYNAMIC()) {
                    # Stage-0 type check: returned value vs declared return type.
                    my int $atype = stage0_expr_type($ctx, $ret_val);
                    if (sem_types_ok($ctx, $rtype, $atype) == 0) {
                        sem_type_diag($ctx, "returning a " . ast_data_type_name($atype)
                            . " value from '" . sem_fn_display("" . $cur->{"package"}, "" . $cur->{"name"}) . "' (declared to return "
                            . ast_data_type_name($rtype) . ")", $line);
                    }
                    my int $ret_et = sem_node_et($ctx, $cur, "return_elem_type", "return_elem_class");
                    if ($ret_et > 0 && ($rtype == TYPE_ARRAY() || $rtype == TYPE_HASH())) {
                        my str $ret_sig = "@";
                        if ($rtype == TYPE_HASH()) { $ret_sig = "%"; }
                        $ctx->{"elem_where"} = "the result of '" . sem_fn_display("" . $cur->{"package"}, "" . $cur->{"name"}) . "' (declared to return "
                            . sem_elem_type_name($ctx, $ret_sig, $ret_et) . ")";
                        if ($rtype == TYPE_ARRAY()) {
                            sem_check_elem_value($ctx, $ret_et, $ret_val, "", "@", $line);
                        } else {
                            sem_check_hash_literal($ctx, $ret_et, $ret_val, "", $line);
                        }
                        $ctx->{"elem_where"} = "";
                    }
                }
            }
        }
        return;
    }

    # If statement
    if ($node_type == NODE_IF_STMT()) {
        analyze_expression($ctx, $stmt->{"condition"});
        analyze_block($ctx, $stmt->{"then_block"});

        # elsif clauses
        my scalar $elsif_conds = $stmt->{"elsif_conditions"};
        my scalar $elsif_blocks = $stmt->{"elsif_blocks"};
        my int $elsif_count = $stmt->{"elsif_count"};
        for (my int $i = 0; $i < $elsif_count; $i = $i + 1) {
            analyze_expression($ctx, $elsif_conds->[$i]);
            analyze_block($ctx, $elsif_blocks->[$i]);
        }

        # else block
        my scalar $else_blk = $stmt->{"else_block"};
        if (is_valid_node($else_blk) == 1) {
            analyze_block($ctx, $else_blk);
        }
        return;
    }

    # While statement (condition may be an expression or a scoped NODE_VAR_DECL)
    if ($node_type == NODE_WHILE_STMT()) {
        my scalar $wcond = $stmt->{"condition"};
        if (is_valid_node($wcond) == 1 && $wcond->{"type"} == NODE_VAR_DECL()) {
            my scalar $wold_scope = $ctx->{"scope"};
            $ctx->{"scope"} = scope_new($wold_scope);
            analyze_statement($ctx, $wcond);
            analyze_block($ctx, $stmt->{"body"});
            scope_check_unused($ctx, $ctx->{"scope"});
            $ctx->{"scope"} = $wold_scope;
            return;
        }
        analyze_expression($ctx, $wcond);
        analyze_block($ctx, $stmt->{"body"});
        return;
    }

    # Do-while statement: do { body } while (condition);
    if ($node_type == NODE_DO_WHILE_STMT()) {
        analyze_block($ctx, $stmt->{"body"});
        analyze_expression($ctx, $stmt->{"condition"});
        return;
    }

    # Switch statement (scrutinee, per-case exprs and blocks, optional default block)
    if ($node_type == NODE_SWITCH()) {
        analyze_expression($ctx, $stmt->{"expr"});

        my scalar $cases = $stmt->{"cases"};
        my scalar $blocks = $stmt->{"blocks"};
        my int $case_count = $stmt->{"case_count"};
        my int $i = 0;
        while ($i < $case_count) {
            analyze_expression($ctx, $cases->[$i]);
            analyze_block($ctx, $blocks->[$i]);
            $i = $i + 1;
        }

        my int $has_default = $stmt->{"has_default"};
        if ($has_default == 1) {
            analyze_block($ctx, $stmt->{"default_block"});
        }
        return;
    }

    # For statement
    if ($node_type == NODE_FOR_STMT()) {
        # For loop has its own scope for the init variable
        my scalar $old_scope = $ctx->{"scope"};
        $ctx->{"scope"} = scope_new($old_scope);

        my scalar $for_init = $stmt->{"init"};
        if (is_valid_node($for_init) == 1) {
            # Init could be var decl or expression
            if ($for_init->{"type"} == NODE_VAR_DECL()) {
                analyze_statement($ctx, $for_init);
            } else {
                analyze_expression($ctx, $for_init);
            }
        }
        if (is_valid_node($stmt->{"condition"}) == 1) {
            analyze_expression($ctx, $stmt->{"condition"});
        }
        my scalar $for_upd = $stmt->{"update"};
        if (is_valid_node($for_upd) == 1) {
            analyze_expression($ctx, $for_upd);
        }
        analyze_block($ctx, $stmt->{"body"});

        scope_check_unused($ctx, $ctx->{"scope"});
        $ctx->{"scope"} = $old_scope;
        return;
    }

    # Foreach statement: foreach [my type $var | $var] (@array) { body }
    if ($node_type == NODE_FOREACH_STMT()) {
        # foreach (C ? LIST : LIST): the chosen branch's elements; a scalar
        # branch is one item (it iterated zero times).
        sem_tern_as_lists($stmt->{"array"});
        if (is_valid_node($stmt->{"array"}) == 1) {
            analyze_expression($ctx, $stmt->{"array"});
        }
        my scalar $fe_old_scope = $ctx->{"scope"};
        $ctx->{"scope"} = scope_new($fe_old_scope);

        my scalar $fe_decl = $stmt->{"var_decl"};
        # `foreach (LIST)` / `foreach $_ (LIST)`: the loop aliases the global
        # $_ (Perl), so functions called from the body see the element. It
        # goes through the existing-variable path (assign per iteration,
        # write back, restore after the loop) instead of a fresh local.
        if (is_valid_node($fe_decl) == 1 && ("" . $fe_decl->{"name"}) eq "_" && ("" . $fe_decl->{"sigil"}) eq "$") {
            $stmt->{"var_decl"} = 0;
            $stmt->{"var_name"} = "_";
            $fe_decl = 0;
        }
        if (is_valid_node($fe_decl) == 1) {
            my str $fe_vname = $fe_decl->{"name"};
            my str $fe_sigil = $fe_decl->{"sigil"};
            my int $fe_vtype = $fe_decl->{"var_type"};
            my str $fe_calias = sem_alloc_local_cname($ctx, $ctx->{"scope"}, $fe_vname);
            scope_add_var($ctx->{"scope"}, $fe_vname, $fe_sigil, $fe_vtype, $line);
            scope_mark_used_sigil($ctx->{"scope"}, $fe_vname, $fe_sigil);
            if ($ctx->{"strict_types"} == 1) {
                my scalar $fe_src = $stmt->{"array"};
                if (is_valid_node($fe_src) == 1 && (($fe_src->{"type"} == NODE_VARIABLE() && ("" . $fe_src->{"sigil"}) eq "@") || $fe_src->{"type"} == NODE_CALL())) {
                    my int $fe_et = sem_src_elem_type($ctx, $fe_src, "@");
                    if ($fe_sigil eq "$") { sem_note_obj_class($ctx, $ctx->{"scope"}, $fe_vname, sem_et_class($ctx, $fe_et), 0); }
                    if ($fe_et > 0 && sem_et_compat($ctx, $fe_vtype, $fe_et) == 0) {
                        sem_type_diag($ctx, "loop variable '$" . $fe_vname . "' (declared "
                            . ast_data_type_name($fe_vtype) . ") iterates over " . sem_src_display($ctx, $fe_src, "@")
                            . " (declared " . sem_elem_type_name($ctx, "@", $fe_et) . ")", $line);
                    }
                }
            }
            if (length($fe_calias) > 0) {
                $fe_decl->{"orig_name"} = $fe_vname;
                $fe_decl->{"name"} = $fe_calias;
                $stmt->{"orig_var_name"} = $fe_vname;
                $stmt->{"var_name"} = $fe_calias;
                $ctx->{"scope"}->{"vars"}->{$fe_vname}->{"c_name"} = $fe_calias;
            }
        } else {
            my str $fe_existing = "" . $stmt->{"var_name"};
            if (length($fe_existing) > 0) {
                my scalar $fe_lk = scope_lookup_var_sigil($ctx->{"scope"}, $fe_existing, "$");
                if ($fe_lk->{"found"} == 0) {
                    semantic_error($ctx, "undefined variable '$" . $fe_existing . "'", $line);
                } else {
                    scope_mark_used_sigil($ctx->{"scope"}, $fe_existing, "$");
                    $stmt->{"orig_var_name"} = $fe_existing;
                    $stmt->{"var_name"} = sem_resolve_vinfo_cname($ctx, $fe_lk->{"info"}, $fe_existing, $line, "$");
                }
            }
        }

        analyze_block($ctx, $stmt->{"body"});
        scope_check_unused($ctx, $ctx->{"scope"});
        $ctx->{"scope"} = $fe_old_scope;
        return;
    }

    # Try/catch/finally statement
    if ($node_type == NODE_TRY_CATCH()) {
        analyze_block($ctx, $stmt->{"try_block"});

        my scalar $catch_clauses = $stmt->{"catch_clauses"};
        my int $catch_count = $stmt->{"catch_count"} + 0;
        my int $ci = 0;
        while ($ci < $catch_count) {
            my scalar $clause = $catch_clauses->[$ci];
            my scalar $old_scope = $ctx->{"scope"};
            $ctx->{"scope"} = scope_new($old_scope);

            my str $catch_var = "" . $clause->{"catch_var"};
            if (length($catch_var) > 0) {
                my str $c_calias = sem_alloc_local_cname($ctx, $ctx->{"scope"}, $catch_var);
                scope_add_var($ctx->{"scope"}, $catch_var, "$", TYPE_SCALAR(), $line);
                sem_note_obj_class($ctx, $ctx->{"scope"}, $catch_var, "" . $clause->{"catch_type"}, 0);
                scope_mark_used_sigil($ctx->{"scope"}, $catch_var, "$");
                if (length($c_calias) > 0) {
                    $clause->{"orig_catch_var"} = $catch_var;
                    $clause->{"catch_var"} = $c_calias;
                    $ctx->{"scope"}->{"vars"}->{$catch_var}->{"c_name"} = $c_calias;
                }
            }

            if (is_valid_node($clause->{"catch_block"}) == 1) {
                analyze_block($ctx, $clause->{"catch_block"});
            }

            scope_check_unused($ctx, $ctx->{"scope"});
            $ctx->{"scope"} = $old_scope;
            $ci = $ci + 1;
        }

        if (is_valid_node($stmt->{"finally_block"}) == 1) {
            analyze_block($ctx, $stmt->{"finally_block"});
        }
        return;
    }

    # Throw statement
    if ($node_type == NODE_THROW()) {
        analyze_expression($ctx, $stmt->{"expr"});
        return;
    }
}

func analyze_block(scalar $ctx, scalar $block) void {
    # Create new scope for block
    my scalar $old_scope = $ctx->{"scope"};
    $ctx->{"scope"} = scope_new($old_scope);

    my scalar $stmts = $block->{"statements"};
    my int $count = $block->{"statement_count"};

    for (my int $i = 0; $i < $count; $i = $i + 1) {
        analyze_statement($ctx, $stmts->[$i]);
    }

    # Check for unused variables
    scope_check_unused($ctx, $ctx->{"scope"});

    # Restore scope
    $ctx->{"scope"} = $old_scope;
}

func analyze_function(scalar $ctx, scalar $fn) void {
    # Set current function and package context
    $ctx->{"current_func"} = $fn;
    my str $f_pkg = "" . $fn->{"package"};
    if (length($f_pkg) == 0) { $f_pkg = "main"; }
    $ctx->{"cur_pkg"} = $f_pkg;
    $ctx->{"asg_root"} = $fn;
    $ctx->{"asg_set"} = 0;
    if ($ctx->{"strict_types"} == 1) {
        # before the body is analyzed (analysis renames and rewrites nodes)
        my hash %asg_out = ();
        my hash %asg_seen = ();
        sem_assigned_walk($fn, \%asg_seen, \%asg_out);
        $ctx->{"asg_set"} = \%asg_out;
    }

    # Create function scope
    my scalar $old_scope = $ctx->{"scope"};
    $ctx->{"scope"} = scope_new($old_scope);
    $ctx->{"scope"}->{"is_param_scope"} = 1;

    # Add parameters to scope
    my scalar $params = $fn->{"params"};
    my int $param_count = $fn->{"param_count"};
    my hash %seen_params = ();
    my hash %seen_bare_params = ();
    my int $fn_line = ast_get_line($fn);
    for (my int $i = 0; $i < $param_count; $i = $i + 1) {
        my scalar $param = $params->[$i];
        my str $pname = $param->{"name"};
        my str $sigil = $param->{"sigil"};
        my int $ptype = $param->{"param_type"};
        my int $pline = ast_get_line($param);
        my str $pkey = $sigil . $pname;
        my int $err_line = $pline;
        if ($err_line <= 0) { $err_line = $fn_line; }
        if ($seen_params{$pkey} == 1) {
            semantic_error($ctx, "duplicate parameter '" . $pkey . "'", $err_line);
        } elsif ($seen_bare_params{$pname} == 1) {
            semantic_error($ctx, "parameter '" . $pkey . "' conflicts with another parameter named '" . $pname . "'", $err_line);
        } else {
            $seen_params{$pkey} = 1;
            $seen_bare_params{$pname} = 1;
        }
        if (($param->{"has_default"} + 0) == 1 && is_valid_node($param->{"default"}) == 1) {
            analyze_expression($ctx, $param->{"default"});
        }
        if ($pname eq "_" && $sigil eq "@") {
            # The implicit @_ of a no-parens function gets its own C name:
            # as `_` it hid the global $_ (C names ignore the sigil), so `$_`
            # in such a function read the argument array.
            scope_add_var($ctx->{"scope"}, "@:_", "@", $ptype, $pline);
            $ctx->{"scope"}->{"vars"}->{"@:_"}->{"c_name"} = "__args_";
            $param->{"orig_name"} = "_";
            $param->{"name"} = "__args_";
        } else {
            scope_add_var($ctx->{"scope"}, $pname, $sigil, $ptype, $pline);
            if ($param->{"elem_type"} + 0 > 0) {
                $ctx->{"scope"}->{"vars"}->{$pname}->{"elem_type"} = sem_node_et($ctx, $param, "elem_type", "elem_class");
            }
            if ($i == 0 && $pname eq "self" && $sigil eq "$" && $f_pkg ne "main") {
                sem_note_obj_class($ctx, $ctx->{"scope"}, $pname, $f_pkg, 0);
            }
        }
    }

    # Analyze function body (non-extern functions always have a body)
    analyze_block($ctx, $fn->{"body"});

    # Check for unused parameters
    scope_check_unused($ctx, $ctx->{"scope"});

    # Restore scope
    $ctx->{"scope"} = $old_scope;
    $ctx->{"current_func"} = 0;
    $ctx->{"asg_root"} = 0;
    $ctx->{"asg_set"} = 0;
    $ctx->{"cur_pkg"} = "main";
}

# ============================================================
# Main Entry Point
# ============================================================

func semantic_analyze(scalar $ast, int $show_warnings, int $strict_types) void {
    my scalar $ctx = ctx_new();
    $ctx->{"show_warnings"} = $show_warnings;
    # $strict_types: 0 = off, 1 = --strict-types (warnings), 2 = type checks
    # only (strada-interp: report nothing but the errors of strict files)
    $ctx->{"types_only"} = 0;
    $ctx->{"in_type_diag"} = 0;
    if ($strict_types == 2) {
        $ctx->{"types_only"} = 1;
        $strict_types = 0;
    }
    $ctx->{"strict_types"} = $strict_types;
    $ctx->{"cli_strict"} = $strict_types;
    $ctx->{"strict_err"} = 0;
    $ctx->{"qw_imports"} = $ast->{"qw_imports"};
    $ctx->{"module_only_mode"} = $ast->{"module_only_mode"} + 0;

    my int $cb_n = $ast->{"c_block_count"} + 0;
    if ($cb_n > 0) {
        my scalar $cb_sb = sb_new();
        my scalar $cbs = $ast->{"c_blocks"};
        my int $cbi = 0;
        while ($cbi < $cb_n) {
            sb_append($cb_sb, $cbs->[$cbi]);
            sb_append($cb_sb, "\n");
            $cbi = $cbi + 1;
        }
        $ctx->{"c_blocks_str"} = sb_to_string($cb_sb);
    } else {
        $ctx->{"c_blocks_str"} = "";
    }

    $ctx->{"prog"} = $ast;
    # First pass: register all functions and globals
    register_functions($ctx, $ast);
    my int $inh_n = $ast->{"inherit_count"} + 0;
    my scalar $inhs = $ast->{"inherits"};
    for (my int $ii = 0; $ii < $inh_n; $ii = $ii + 1) {
        my str $ich = "" . $inhs->[$ii]->{"child"};
        if (length($ich) > 0) { $ctx->{"known_packages"}->{$ich} = 1; }
        my str $ipar = "" . $inhs->[$ii]->{"parent"};
        if (length($ipar) > 0) { $ctx->{"known_packages"}->{$ipar} = 1; }
    }
    register_globals($ctx, $ast);
    register_import_lib_functions($ctx, $ast);
    register_import_object_functions($ctx, $ast);
    register_import_archive_functions($ctx, $ast);

    # Validate top-level global initializers
    my int $gcount = $ast->{"global_count"} + 0;
    if ($gcount > 0) {
        my scalar $globals = $ast->{"globals"};
        for (my int $gi = 0; $gi < $gcount; $gi = $gi + 1) {
            my scalar $gvar = $globals->[$gi];
            $ctx->{"cur_file"} = "" . $gvar->{"file"};
            sem_set_strict($ctx, $gvar);
            $ctx->{"cur_from_use"} = $gvar->{"from_use"} + 0;
            $ctx->{"current_func"} = 0;
            my str $gpkg = "" . $gvar->{"package"};
            if (length($gpkg) == 0) { $gpkg = "main"; }
            $ctx->{"cur_pkg"} = $gpkg;
            $ctx->{"cur_block_line"} = ast_get_line($gvar);
            if (is_valid_node($gvar->{"initial_capacity"}) == 1) {
                analyze_expression($ctx, $gvar->{"initial_capacity"});
            }
            if (is_valid_node($gvar->{"init"}) == 1) {
                analyze_expression($ctx, $gvar->{"init"});
                if ($ctx->{"strict_types"} == 1 && ($gvar->{"type"} == NODE_VAR_DECL() || $gvar->{"type"} == NODE_OUR_DECL()) && $gvar->{"sigil"} eq "$") {
                    my int $gv_type = $gvar->{"var_type"};
                    my int $ga_type = stage0_expr_type($ctx, $gvar->{"init"});
                    if (sem_types_ok($ctx, $gv_type, $ga_type) == 0) {
                        my str $gv_oname = "" . $gvar->{"orig_name"};
                        if (length($gv_oname) == 0) { $gv_oname = "" . $gvar->{"name"}; }
                        sem_type_diag($ctx, "initializing '$" . $gv_oname . "' (declared "
                            . ast_data_type_name($gv_type) . ") with a "
                            . ast_data_type_name($ga_type) . " value", ast_get_line($gvar));
                    }
                }
                if ($ctx->{"strict_types"} == 1 && ($gvar->{"type"} == NODE_VAR_DECL() || $gvar->{"type"} == NODE_OUR_DECL()) && $gvar->{"elem_type"} + 0 > 0) {
                    my str $ge_oname = "" . $gvar->{"orig_name"};
                    if (length($ge_oname) == 0) { $ge_oname = "" . $gvar->{"name"}; }
                    if ($gvar->{"sigil"} eq "@") {
                        sem_check_elem_value($ctx, sem_node_et($ctx, $gvar, "elem_type", "elem_class"), $gvar->{"init"}, $ge_oname, "@", ast_get_line($gvar));
                    }
                    if ($gvar->{"sigil"} eq "%") {
                        sem_check_hash_literal($ctx, sem_node_et($ctx, $gvar, "elem_type", "elem_class"), $gvar->{"init"}, $ge_oname, ast_get_line($gvar));
                    }
                }
            }
            $ctx->{"cur_block_line"} = 0;
        }
    }

    # Validate BEGIN and END blocks
    my int $bcount = $ast->{"begin_block_count"} + 0;
    if ($bcount > 0) {
        my scalar $bblocks = $ast->{"begin_blocks"};
        for (my int $bi = 0; $bi < $bcount; $bi = $bi + 1) {
            my scalar $bblk = $bblocks->[$bi];
            $ctx->{"cur_file"} = "" . $bblk->{"file"};
            sem_set_strict($ctx, $bblk);
            $ctx->{"cur_from_use"} = $bblk->{"from_use"} + 0;
            $ctx->{"current_func"} = 0;
            my str $bpkg = "" . $bblk->{"source_module"};
            if (length($bpkg) == 0) { $bpkg = "main"; }
            $ctx->{"cur_pkg"} = $bpkg;
            $ctx->{"cur_block_line"} = ast_get_line($bblk);
            analyze_block($ctx, $bblk);
            $ctx->{"cur_block_line"} = 0;
        }
    }
    my int $ecount = $ast->{"end_block_count"} + 0;
    if ($ecount > 0) {
        my scalar $eblocks = $ast->{"end_blocks"};
        for (my int $ei = 0; $ei < $ecount; $ei = $ei + 1) {
            my scalar $eblk = $eblocks->[$ei];
            $ctx->{"cur_file"} = "" . $eblk->{"file"};
            sem_set_strict($ctx, $eblk);
            $ctx->{"cur_from_use"} = $eblk->{"from_use"} + 0;
            $ctx->{"current_func"} = 0;
            my str $epkg = "" . $eblk->{"source_module"};
            if (length($epkg) == 0) { $epkg = "main"; }
            $ctx->{"cur_pkg"} = $epkg;
            $ctx->{"cur_block_line"} = ast_get_line($eblk);
            analyze_block($ctx, $eblk);
            $ctx->{"cur_block_line"} = 0;
        }
    }

    # Second pass: validate each function
    my scalar $funcs = $ast->{"functions"};
    my int $count = $ast->{"function_count"};

    for (my int $i = 0; $i < $count; $i = $i + 1) {
        my scalar $fn = $funcs->[$i];

        if (($fn->{"type"} + 0) == NODE_ASYNC_FUNC()) {
            $ctx->{"uses_threads"} = 1;
        }
        # Skip extern functions (no body to analyze)
        if ($fn->{"is_extern"} == 1) {
            next;
        }
        $ctx->{"cur_file"} = $fn->{"file"};
        $ctx->{"cur_from_use"} = $fn->{"from_use"} + 0;
        sem_set_strict($ctx, $fn);
        analyze_function($ctx, $fn);
    }

    # Publish program-wide facts the codegen reads (mirrors has_overloads,
    # which the parser sets directly). uses_tie gates condition-level CSE.
    if ($ctx->{"uses_tie"} == 1) {
        $ast->{"uses_tie"} = 1;
    }
    if ($ctx->{"uses_threads"} == 1) {
        $ast->{"uses_threads"} = 1;
    }
    # A copy of a weak reference is a strong one (Perl). The weak flag lives
    # on the shared REF value, so in a program that weakens anything, values
    # copied out of variables/elements by `=`, `my` and push go through
    # __strong_copy (a new strong REF for a weak one, else the value itself).
    if ($ctx->{"uses_weaken"} == 1) {
        my hash %sc_seen = ();
        sem_strong_copy_walk($ast, \%sc_seen);
    }

    # Report every accumulated error (capped for readability) and fail the
    # compile with a single die at the end, so one run surfaces them all.
    my scalar $sem_errs = $ctx->{"errors"};
    my int $sem_err_count = size(@{$sem_errs});
    if ($sem_err_count > 0) {
        my int $sem_show = $sem_err_count;
        if ($sem_show > 25) {
            $sem_show = 25;
        }
        my int $sem_i = 0;
        while ($sem_i < $sem_show) {
            warn($sem_errs->[$sem_i]);
            $sem_i = $sem_i + 1;
        }
        if ($sem_err_count > $sem_show) {
            warn("... and " . ($sem_err_count - $sem_show) . " more errors");
        }
        if ($sem_err_count == 1) {
            die("compilation failed: 1 semantic error");
        }
        die("compilation failed: " . $sem_err_count . " semantic errors");
    }
}
