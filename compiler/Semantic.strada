    $b{"tied"} = 1;

    # Type functions
    $b{"defined"} = 1;
    $b{"typeof"} = 1;
    $b{"ref"} = 1;
    $b{"reftype"} = 1;
    $b{"is_ref"} = 1;
    $b{"cast_int"} = 1;
    $b{"cast_num"} = 1;
    $b{"cast_str"} = 1;
    $b{"int"} = 1;

    # Reference functions
    $b{"clone"} = 1;
    $b{"deref"} = 1;
    $b{"deref_array"} = 1;
    $b{"deref_hash"} = 1;
    $b{"deref_set"} = 1;
    $b{"refto"} = 1;
    $b{"is_refto"} = 1;
    $b{"derefto"} = 1;

    # Regex
    $b{"match"} = 1;
    $b{"replace"} = 1;
    $b{"replace_all"} = 1;
    $b{"str_replace"} = 1;       # Plain string replace (all occurrences)
    $b{"str_replace_first"} = 1; # Plain string replace (first only)
    $b{"regex_replace"} = 1;     # Regex replace (first match)
    $b{"regex_replace_all"} = 1; # Regex replace (all matches)
    $b{"capture"} = 1;
    $b{"captures"} = 1;
    $b{"named_captures"} = 1;

    # Control flow
