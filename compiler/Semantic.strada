    $b{"math::remainder"} = 1;
    $b{"math::trunc"} = 1;
    $b{"math::ldexp"} = 1;
    $b{"math::frexp"} = 1;
    $b{"math::modf"} = 1;
    $b{"math::scalbn"} = 1;

    return \%b;
}

# ============================================================
# Context Structure
# ============================================================

func ctx_new() scalar {
    my hash %ctx = ();
    my hash %funcs = ();
    my hash %kpkgs = ();
    $ctx{"functions"} = \%funcs;
    $ctx{"known_packages"} = \%kpkgs;
    $ctx{"builtins"} = get_builtins();
    $ctx{"scope"} = scope_new(0);
    $ctx{"current_func"} = 0;
    $ctx{"cur_file"} = "";
    $ctx{"errors"} = [];

    # Register built-in global variables: ARGV (array) and ARGC (int)
    my scalar $global_scope = $ctx{"scope"};
    scope_add_var($global_scope, "ARGV", "@", TYPE_ARRAY(), 0);
    scope_add_var($global_scope, "ARGC", "$", TYPE_INT(), 0);
    # Standard I/O filehandles
    scope_add_var($global_scope, "STDIN", "$", TYPE_SCALAR(), 0);
    scope_add_var($global_scope, "STDOUT", "$", TYPE_SCALAR(), 0);
    scope_add_var($global_scope, "STDERR", "$", TYPE_SCALAR(), 0);
    # Special variables
    scope_add_var($global_scope, "__child_status", "$", TYPE_INT(), 0);
    scope_add_var($global_scope, "__program_name", "$", TYPE_STR(), 0);
    scope_add_var($global_scope, "_", "$", TYPE_SCALAR(), 0);

    return \%ctx;
}

# ============================================================
# Registration Pass (First Pass)
# ============================================================

func register_functions(scalar $ctx, scalar $ast) void {
    my scalar $funcs = $ast->{"functions"};
    my int $count = $ast->{"function_count"};

    for (my int $i = 0; $i < $count; $i = $i + 1) {
        my scalar $fn = $funcs->[$i];
        my str $name = $fn->{"name"};
        my int $line = ast_get_line($fn);
        $ctx->{"cur_file"} = $fn->{"file"};

        # Check for duplicate function. Body-less extern declarations
        # (`extern func Pkg::name(...) ret;`) follow C semantics: a
        # declaration never conflicts with anything, a definition replaces
        # an earlier declaration, and only two *definitions* collide. This
        # matters for use-cycles broken via externs — several sibling
        # modules each declare the same `extern func Perla::CodeGen::emit`,
        # and `use`-inlining surfaces those duplicate declarations in one
        # compile unit (e.g. perla's CodeGen submodules).
        my int $new_is_decl = 0;
        if ($fn->{"is_extern"} == 1 && $fn->{"has_body"} != 1) { $new_is_decl = 1; }
        my scalar $existing_fn = $ctx->{"functions"}->{$name};
        my int $skip_register = 0;
        if ($existing_fn != 0) {
            if ($new_is_decl == 1) {
                # Duplicate declaration: keep whatever is registered (a
                # definition stays a definition; a prior decl is equivalent).
                $skip_register = 1;
            } elsif ($existing_fn->{"is_decl_only"} == 1) {
                # Definition arriving after a forward declaration: replace
                # the decl's info with the definition's (fall through).
                $skip_register = 0;
            } else {
                semantic_error($ctx, "function '" . $name . "' already defined", $line);
            }
        }

        my str $fn_pkg = "" . $fn->{"package"};
        if ($name eq "main") {
            $ctx->{"has_main"} = 1;
        }
        if (length($fn_pkg) > 0 && $fn_pkg ne "main") {
            $ctx->{"known_packages"}->{$fn_pkg} = 1;
            my str $c_fpkg = $fn_pkg;
            my int $pcol = index($c_fpkg, "::");
            while ($pcol >= 0) {
                $c_fpkg = substr($c_fpkg, 0, $pcol) . "_" . substr($c_fpkg, $pcol + 2, length($c_fpkg) - $pcol - 2);
                $pcol = index($c_fpkg, "::");
            }
            $ctx->{"known_packages"}->{$c_fpkg} = 1;
        }

        if ($skip_register == 0) {
            # Register function
            my hash %info = ();
            $info{"is_registered"} = 1;  # Marker to distinguish from unfound
            $info{"return_type"} = $fn->{"return_type"};
            $info{"param_count"} = $fn->{"param_count"};
            $info{"params"} = $fn->{"params"};
            $info{"is_extern"} = $fn->{"is_extern"};
            $info{"is_variadic"} = $fn->{"is_variadic"};
            $info{"is_decl_only"} = $new_is_decl;
            $info{"is_private"} = $fn->{"is_private"} + 0;
            $info{"package"} = $fn_pkg;
            $info{"from_use"} = $fn->{"from_use"} + 0;
            $info{"file"} = "" . $fn->{"file"};
            $info{"line"} = $line;
            $ctx->{"functions"}->{$name} = \%info;
        }
    }
}

# Register functions from import_lib statements
func register_import_lib_functions(scalar $ctx, scalar $ast) void {
    my int $lib_count = $ast->{"import_lib_count"};
    if ($lib_count == 0) {
        return;
    }

    my scalar $import_libs = $ast->{"import_libs"};

    for (my int $i = 0; $i < $lib_count; $i = $i + 1) {
        my scalar $lib_info = $import_libs->[$i];
        my scalar $lib_funcs = $lib_info->{"functions"};
        my int $fn_count = $lib_info->{"function_count"};

        for (my int $j = 0; $j < $fn_count; $j = $j + 1) {
            my scalar $fn_info = $lib_funcs->[$j];
            my str $name = $fn_info->{"name"};

            # Register function (skip if already exists)
            my scalar $existing_fn = $ctx->{"functions"}->{$name};
            if ($existing_fn != 0) {
                next;  # Function with this name already exists
            }

            my hash %info = ();
            $info{"is_registered"} = 1;
            $info{"return_type"} = $fn_info->{"return_type"};
            $info{"param_count"} = $fn_info->{"param_count"};
            $info{"params"} = $fn_info->{"params"};
            $info{"is_extern"} = 0;
            $info{"is_variadic"} = $fn_info->{"is_variadic"};
            $info{"variadic_param_idx"} = $fn_info->{"variadic_param_idx"};
            $info{"is_import_lib"} = 1;  # Mark as import_lib function
            $info{"line"} = 0;
            $ctx->{"functions"}->{$name} = \%info;
        }
    }
}

# Register functions from import_object statements (static linking)
func register_import_object_functions(scalar $ctx, scalar $ast) void {
    my int $obj_count = $ast->{"import_object_count"};
    if ($obj_count == 0) {
        return;
    }

    my scalar $import_objects = $ast->{"import_objects"};

    for (my int $i = 0; $i < $obj_count; $i = $i + 1) {
        my scalar $obj_info = $import_objects->[$i];
        my scalar $obj_funcs = $obj_info->{"functions"};
        my int $fn_count = $obj_info->{"function_count"};

        for (my int $j = 0; $j < $fn_count; $j = $j + 1) {
            my scalar $fn_info = $obj_funcs->[$j];
            my str $name = $fn_info->{"name"};

            # Register function (skip if already exists)
            my scalar $existing_fn = $ctx->{"functions"}->{$name};
            if ($existing_fn != 0) {
                next;  # Function with this name already exists
            }

            my hash %info = ();
            $info{"is_registered"} = 1;
            $info{"return_type"} = $fn_info->{"return_type"};
            $info{"param_count"} = $fn_info->{"param_count"};
            $info{"params"} = $fn_info->{"params"};
            $info{"is_extern"} = 0;
            $info{"is_variadic"} = $fn_info->{"is_variadic"};
            $info{"variadic_param_idx"} = $fn_info->{"variadic_param_idx"};
            $info{"is_import_object"} = 1;  # Mark as import_object function
            $info{"line"} = 0;
            $ctx->{"functions"}->{$name} = \%info;
        }
    }
}

# Register functions from import_archive statements (static .a archives)
func register_import_archive_functions(scalar $ctx, scalar $ast) void {
    my int $arch_count = $ast->{"import_archive_count"};
    if ($arch_count == 0) {
        return;
    }

    my scalar $import_archives = $ast->{"import_archives"};

    for (my int $i = 0; $i < $arch_count; $i = $i + 1) {
        my scalar $arch_info = $import_archives->[$i];
        my scalar $arch_funcs = $arch_info->{"functions"};
        my int $fn_count = $arch_info->{"function_count"};

        for (my int $j = 0; $j < $fn_count; $j = $j + 1) {
            my scalar $fn_info = $arch_funcs->[$j];
            my str $name = $fn_info->{"name"};

            my scalar $existing_fn = $ctx->{"functions"}->{$name};
            if ($existing_fn != 0) {
                next;
            }

            my hash %info = ();
            $info{"is_registered"} = 1;
            $info{"return_type"} = $fn_info->{"return_type"};
            $info{"param_count"} = $fn_info->{"param_count"};
            $info{"params"} = $fn_info->{"params"};
            $info{"is_extern"} = 0;
            $info{"is_variadic"} = $fn_info->{"is_variadic"};
            $info{"variadic_param_idx"} = $fn_info->{"variadic_param_idx"};
            $info{"is_import_archive"} = 1;
            $info{"line"} = 0;
            $ctx->{"functions"}->{$name} = \%info;
        }
    }
}

# Register global variables in the global scope
func register_globals(scalar $ctx, scalar $ast) void {
    my int $global_count = $ast->{"global_count"};
    if ($global_count == 0) {
        return;
    }

    my scalar $globals = $ast->{"globals"};
    my scalar $scope = $ctx->{"scope"};

    for (my int $i = 0; $i < $global_count; $i = $i + 1) {
        my scalar $gvar = $globals->[$i];
        my str $name = $gvar->{"name"};
        my int $var_type = $gvar->{"var_type"};
        my int $line = ast_get_line($gvar);

        # Handle var decls, our decls, and const decls
        my int $gvar_type = $gvar->{"type"};
        my str $sigil = "$";  # Default for consts
        if ($gvar_type == NODE_VAR_DECL() || $gvar_type == NODE_OUR_DECL()) {
            $sigil = $gvar->{"sigil"};
        }

        # File-level `my`/const variables are lexical, as in Perl: the same
        # name may be declared again later (another package in the same
        # file, or another module). Every declaration must become its own C
        # global, and each reference binds to the nearest declaration before
        # it in the same file. (They used to share one C name, so a second
        # `my $X` was a C "redefinition" error.)
        my scalar $root_vars = $scope->{"vars"};
        my scalar $prev = $root_vars->{$name};
        if (is_valid_node($prev) == 1 && $prev->{"is_global"} == 1) {
            if ($gvar_type == NODE_OUR_DECL()) {
                $prev->{"is_our"} = 1;
                next;
            }
            my scalar $decls = $prev->{"decls"};
            my int $nd = size(@{$decls});
            # later declarations get a distinct C name
            $gvar->{"name"} = $name . "__shadow" . $nd;
            push(@{$decls}, $gvar);
            next;
        }

        scope_add_var($scope, $name, $sigil, $var_type, $line);
        my scalar $ginfo = $root_vars->{$name};
        $ginfo->{"is_global"} = 1;
        if ($gvar_type == NODE_OUR_DECL()) {
            $ginfo->{"is_our"} = 1;
        }
        my array @first = ();
        push(@first, $gvar);
        $ginfo->{"decls"} = \@first;
    }
}

# "" for the main file, else the module file a node came from.
func sem_file_key(scalar $node) str {
    if ($node->{"from_use"} == 1) {
        return "" . $node->{"file"};
    }
    return "";
}

# For a reference to a global with several file-level declarations, the C
# name of the declaration that lexically precedes the reference/function.
func resolve_shadowed_global(scalar $ctx, scalar $info, str $name, int $ref_line, str $sigil) str {
    my scalar $decls = $info->{"decls"};
    my scalar $fn = $ctx->{"current_func"};
    my str $fkey = "";
    my int $fline = $ref_line;
    if (is_valid_node($fn) == 1) {
        $fkey = sem_file_key($fn);
        if ($fline <= 0) { $fline = ast_get_line($fn); }
    } elsif (($ctx->{"cur_from_use"} + 0) == 1) {
        $fkey = "" . $ctx->{"cur_file"};
    }
    if ($fline <= 0) { $fline = $ctx->{"cur_block_line"} + 0; }
    if ($fline <= 0) { return $name; }
    my str $best = $name;
    my int $best_line = -1;
    my int $i = 0;
    while ($i < size(@{$decls})) {
        my scalar $d = $decls->[$i];
        my str $dsig = "$";
        if ($d->{"type"} == NODE_VAR_DECL() || $d->{"type"} == NODE_OUR_DECL()) {
            $dsig = $d->{"sigil"};
        }
        my int $dl = ast_get_line($d);
        if ($dsig eq $sigil && sem_file_key($d) eq $fkey && $dl < $fline && $dl > $best_line) {
            $best_line = $dl;
            $best = $d->{"name"};
        }
        $i = $i + 1;
    }
    return $best;
}

# ============================================================
# Validation Pass (Second Pass)
# ============================================================

# ============================================================
# Stage-0 type checking (gradual, warning-only, --strict-types)
# ============================================================
# Computes a best-effort static type for an expression and compares it
# against declarations at the four sites where both sides are already in
# hand: var-decl initializers, plain assignments, call arguments, and
# returns. `scalar`/`dynamic`/unknown are BIVARIANT — compatible with
# everything in both directions — so untyped code never warns (the
# gradual escape hatch; the runtime's StradaValue checks remain the
# soundness backstop). int/num (and the C-interop numeric kinds)
# interconvert silently by design: flagging `my int $i = $x / 2`
# (/ returns num) would bury the real findings under documented-coercion
# noise. Name-resolution note: call return types use the plain registry
# lookup; an unqualified same-package call in a non-main package may
# miss and degrade to `scalar` — that can only SUPPRESS a warning, never
# fabricate one (unlike needs_temp_cleanup, where divergence leaked).

func stage0_is_numeric(int $t) int {
    if ($t == TYPE_INT() || $t == TYPE_NUM() || $t == TYPE_BOOL() || $t == TYPE_ENUM()
        || $t == TYPE_INT8() || $t == TYPE_INT16() || $t == TYPE_INT32() || $t == TYPE_INT64()
        || $t == TYPE_UINT8() || $t == TYPE_UINT16() || $t == TYPE_UINT32() || $t == TYPE_UINT64()
        || $t == TYPE_SIZE_T() || $t == TYPE_CHAR()
        || $t == TYPE_FLOAT32() || $t == TYPE_FLOAT64() || $t == TYPE_LONG_DOUBLE()) {
        return 1;
    }
    return 0;
}

func stage0_types_compatible(int $expected, int $actual) int {
    if ($expected == $actual) { return 1; }
    # A void result is never a usable value — flag even for untyped targets.
    if ($actual == TYPE_VOID()) { return 0; }
    # Bivariant: scalar/dynamic/unknown on either side accepts everything.
    if ($expected == TYPE_SCALAR() || $expected == TYPE_DYNAMIC() || $expected <= 0) { return 1; }
    if ($actual == TYPE_SCALAR() || $actual == TYPE_DYNAMIC() || $actual <= 0) { return 1; }
    # The numeric family interconverts silently (documented coercions).
    if (stage0_is_numeric($expected) == 1 && stage0_is_numeric($actual) == 1) { return 1; }
    return 0;
}

# Best-effort static type of an expression; TYPE_SCALAR when unknown.
func stage0_expr_type(scalar $ctx, scalar $expr) int {
    if (is_valid_node($expr) == 0) { return TYPE_SCALAR(); }
    my int $t = $expr->{"type"};
    if ($t == NODE_INT_LITERAL()) { return TYPE_INT(); }
    if ($t == NODE_NUM_LITERAL()) { return TYPE_NUM(); }
    if ($t == NODE_STR_LITERAL()) { return TYPE_STR(); }
    if ($t == NODE_VARIABLE()) {
        my str $sigil = $expr->{"sigil"};
        if ($sigil eq "@") { return TYPE_ARRAY(); }
        if ($sigil eq "%") { return TYPE_HASH(); }
        my scalar $lk = scope_lookup_var_sigil($ctx->{"scope"}, $expr->{"name"}, "$");
        if ($lk->{"found"} == 1) {
            my scalar $info = $lk->{"info"};
            return $info->{"type"};
        }
        return TYPE_SCALAR();
    }
    if ($t == NODE_BINARY_OP()) {
        my str $op = $expr->{"op"};
        if ($op eq "." || $op eq "x") { return TYPE_STR(); }
        if ($op eq "==" || $op eq "!=" || $op eq "<" || $op eq ">" || $op eq "<=" || $op eq ">="
            || $op eq "eq" || $op eq "ne" || $op eq "lt" || $op eq "gt" || $op eq "le" || $op eq "ge"
            || $op eq "<=>" || $op eq "cmp") { return TYPE_INT(); }
        if ($op eq "&" || $op eq "|" || $op eq "^" || $op eq "<<" || $op eq ">>") { return TYPE_INT(); }
        if ($op eq "/") { return TYPE_NUM(); }
        if ($op eq "+" || $op eq "-" || $op eq "*" || $op eq "%" || $op eq "**") {
            my int $ltype = stage0_expr_type($ctx, $expr->{"left"});
            my int $rtype_op = stage0_expr_type($ctx, $expr->{"right"});
            if ($ltype == TYPE_INT() && $rtype_op == TYPE_INT()) { return TYPE_INT(); }
            if (stage0_is_numeric($ltype) == 1 && stage0_is_numeric($rtype_op) == 1) { return TYPE_NUM(); }
            # Strings/unknowns in numeric context coerce — stay permissive.
            return TYPE_SCALAR();
        }
        if ($op eq "&&" || $op eq "||" || $op eq "//") {
            # Value-returning logicals: only typed when both sides agree.
            my int $ltype = stage0_expr_type($ctx, $expr->{"left"});
            my int $rtype_op = stage0_expr_type($ctx, $expr->{"right"});
            if ($ltype == $rtype_op) { return $ltype; }
            return TYPE_SCALAR();
        }
        return TYPE_SCALAR();
    }
    if ($t == NODE_UNARY_OP()) {
        my str $op = $expr->{"op"};
        if ($op eq "!" || $op eq "not" || $op eq "~") { return TYPE_INT(); }
        if ($op eq "-") {
            my int $ot = stage0_expr_type($ctx, $expr->{"operand"});
            if (stage0_is_numeric($ot) == 1) { return $ot; }
            return TYPE_SCALAR();
        }
        return TYPE_SCALAR();
    }
    if ($t == NODE_TERNARY()) {
        my int $tt = stage0_expr_type($ctx, $expr->{"true_expr"});
        my int $ft = stage0_expr_type($ctx, $expr->{"false_expr"});
        if ($tt == $ft) { return $tt; }
        return TYPE_SCALAR();
    }
    if ($t == NODE_CALL()) {
        my str $name = $expr->{"name"};
        # High-signal builtins; everything else stays unknown.
        if ($name eq "length" || $name eq "size" || $name eq "index" || $name eq "rindex"
            || $name eq "byte_index" || $name eq "sys::byte_index" || $name eq "core::byte_index"
            || $name eq "ord" || $name eq "bytes" || $name eq "int"
            || $name eq "exists" || $name eq "defined") { return TYPE_INT(); }
        if ($name eq "substr" || $name eq "join" || $name eq "uc" || $name eq "lc"
            || $name eq "ucfirst" || $name eq "lcfirst" || $name eq "trim"
            || $name eq "chr" || $name eq "sprintf") { return TYPE_STR(); }
        my scalar $fn_info = $ctx->{"functions"}->{$name};
        if ($fn_info->{"is_registered"} == 1) {
            return $fn_info->{"return_type"};
        }
        return TYPE_SCALAR();
    }
    return TYPE_SCALAR();
}

# Validate interpolated scalar variables ($var and ${var}) inside regex
# patterns and non-/e substitution replacements (matching CodeGen's rules).
func analyze_regex_interp(scalar $ctx, str $pattern, int $line) void {
    my int $len = length($pattern);
    my int $i = 0;
    while ($i < $len) {
        my str $ch = substr($pattern, $i, 1);
        if ($ch eq "\\" && $i + 1 < $len) {
            $i = $i + 2;
        } elsif ($ch eq "$") {
            $i = $i + 1;
            my str $varname = "";
            if ($i < $len && substr($pattern, $i, 1) eq "{") {
                my int $bi = $i + 1;
                while ($bi < $len && substr($pattern, $bi, 1) ne "}") {
                    $bi = $bi + 1;
                }
                if ($bi < $len && $bi > $i + 1) {
                    my str $braced = substr($pattern, $i + 1, $bi - $i - 1);
                    my str $bfirst = substr($braced, 0, 1);
                    my int $b_ok = 0;
                    if ($bfirst eq "_" || ($bfirst ge "a" && $bfirst le "z") || ($bfirst ge "A" && $bfirst le "Z")) {
                        $b_ok = 1;
                        my int $ki = 1;
                        while ($ki < length($braced)) {
                            my str $bch = substr($braced, $ki, 1);
                            if (!($bch eq "_" || ($bch ge "a" && $bch le "z") || ($bch ge "A" && $bch le "Z") || ($bch ge "0" && $bch le "9"))) {
                                $b_ok = 0;
                            }
                            $ki = $ki + 1;
                        }
                    }
                    if ($b_ok == 1) {
                        $varname = $braced;
                        $i = $bi + 1;
                    }
                }
            }
            if (length($varname) == 0 && $i < $len) {
                my str $vch0 = substr($pattern, $i, 1);
                if ($vch0 eq "_" || ($vch0 ge "a" && $vch0 le "z") || ($vch0 ge "A" && $vch0 le "Z")) {
                    while ($i < $len) {
                        my str $vch = substr($pattern, $i, 1);
                        if ($vch eq "_" || ($vch ge "a" && $vch le "z") || ($vch ge "A" && $vch le "Z") || ($vch ge "0" && $vch le "9")) {
                            $varname = $varname . $vch;
                            $i = $i + 1;
                        } else {
                            last;
                        }
                    }
                }
            }
            if (length($varname) > 0) {
                my scalar $rlk = scope_lookup_var_sigil($ctx->{"scope"}, $varname, "$");
                if ($rlk->{"found"} == 0) {
                    semantic_error($ctx, "undefined variable '$" . $varname . "'", $line);
                } else {
                    scope_mark_used_sigil($ctx->{"scope"}, $varname, "$");
                }
            }
        } else {
            $i = $i + 1;
        }
    }
}

func sem_is_builtin_namespace(str $ns) int {
    if ($ns eq "core" || $ns eq "sys" || $ns eq "math" || $ns eq "str" ||
        $ns eq "re" || $ns eq "utf8" || $ns eq "async" || $ns eq "thread" ||
        $ns eq "c" || $ns eq "sb" || $ns eq "UNIVERSAL") {
        return 1;
    }
    return 0;
}

func analyze_expression(scalar $ctx, scalar $expr) void {
    if (is_valid_node($expr) == 0) {
        return;
    }
    my int $node_type = $expr->{"type"};
    my int $line = ast_get_line($expr);

    # Variable reference
    if ($node_type == NODE_VARIABLE()) {
        my str $name = $expr->{"name"};
        my str $sigil = $expr->{"sigil"};
        my scalar $lookup_result = scope_lookup_var_sigil($ctx->{"scope"}, $name, $sigil);
        my int $found = $lookup_result->{"found"};
        if ($found == 0) {
            semantic_error($ctx, "undefined variable '" . $sigil . $name . "'", $line);
        }
        scope_mark_used_sigil($ctx->{"scope"}, $name, $sigil);
        if ($found == 1) {
            my scalar $vinfo = $lookup_result->{"info"};
            if ($vinfo->{"is_global"} == 1 && size(@{$vinfo->{"decls"}}) > 1) {
                $expr->{"name"} = resolve_shadowed_global($ctx, $vinfo, $name, $line, $sigil);
            }
        }
        return;
    }

    # Anonymous function: set current_func to the closure node (so return-type
    # checks validate against the closure's return type rather than an enclosing
    # void function!) and preserve semantic errors collected inside its body.
    if ($node_type == NODE_ANON_FUNC()) {
        my scalar $af_saved_func = $ctx->{"current_func"};
        if (is_valid_node($af_saved_func) == 1) {
            if (length("" . $expr->{"file"}) == 0) {
                $expr->{"file"} = $af_saved_func->{"file"};
            }
            $expr->{"from_use"} = $af_saved_func->{"from_use"};
            if (length("" . $expr->{"package"}) == 0) {
                $expr->{"package"} = $af_saved_func->{"package"};
            }
        }
        if (length("" . $expr->{"name"}) == 0) {
            $expr->{"name"} = "<closure>";
        }
        $ctx->{"current_func"} = $expr;
        my scalar $af_outer = $ctx->{"scope"};
        $ctx->{"scope"} = scope_new($af_outer);
        $ctx->{"scope"}->{"is_param_scope"} = 1;
        my scalar $af_params = $expr->{"params"};
        my hash %af_seen = ();
        my hash %af_seen_bare = ();
        my int $af_pi = 0;
        while ($af_pi < $expr->{"param_count"}) {
            my scalar $af_p = $af_params->[$af_pi];
            my str $af_pname = $af_p->{"name"};
            my str $af_key = $af_p->{"sigil"} . $af_pname;
            my int $af_pl = ast_get_line($af_p);
            if ($af_pl <= 0) { $af_pl = $line; }
            if ($af_seen{$af_key} == 1) {
                semantic_error($ctx, "duplicate parameter '" . $af_key . "'", $af_pl);
            } elsif ($af_seen_bare{$af_pname} == 1) {
                semantic_error($ctx, "parameter '" . $af_key . "' conflicts with another parameter named '" . $af_pname . "'", $af_pl);
            } else {
                $af_seen{$af_key} = 1;
                $af_seen_bare{$af_pname} = 1;
            }
            if (($af_p->{"has_default"} + 0) == 1 && is_valid_node($af_p->{"default"}) == 1) {
                analyze_expression($ctx, $af_p->{"default"});
            }
            scope_add_var($ctx->{"scope"}, $af_pname, $af_p->{"sigil"}, $af_p->{"param_type"}, ast_get_line($af_p));
            $af_pi = $af_pi + 1;
        }
        if (is_valid_node($expr->{"body"}) == 1) {
            analyze_block($ctx, $expr->{"body"});
        }
        $ctx->{"scope"} = $af_outer;
        $ctx->{"current_func"} = $af_saved_func;
        return;
    }

    # Value-producing do-block: analyze its statements in a nested scope
    if ($node_type == NODE_DO_EXPR()) {
        my scalar $outer_scope = $ctx->{"scope"};
        $ctx->{"scope"} = scope_new($outer_scope);
        analyze_block($ctx, $expr->{"block"});
        scope_check_unused($ctx, $ctx->{"scope"});
        $ctx->{"scope"} = $outer_scope;
        return;
    }

    # Function call
    if ($node_type == NODE_CALL()) {
        # Constant / enum value reference (e.g., Color::RED without parens)
        if ($expr->{"is_constant"} == 1) {
            return;
        }
        my str $name = $expr->{"name"};
        my scalar $args = $expr->{"args"};
        my int $arg_count = $expr->{"arg_count"};

        # Resolve unqualified calls imported via `use Module qw(names);`
        if (index($name, "::") < 0 && defined($ctx->{"qw_imports"})) {
            my str $imp_pkg = "main";
            my scalar $cur_fn_q = $ctx->{"current_func"};
            if ($cur_fn_q) {
                my str $cfp = "" . $cur_fn_q->{"package"};
                if (length($cfp) > 0) {
                    $imp_pkg = $cfp;
                }
            }
            my str $qw_target = "" . $ctx->{"qw_imports"}->{$imp_pkg . "::" . $name};
            if (length($qw_target) > 0) {
                $name = $qw_target;
                $expr->{"name"} = $qw_target;
            }
        }

        # Constant-fold ord("literal"): rewrite the call node in place into
        # an int literal, so character-code comparisons can be WRITTEN as
        # `$code == ord("#")` (readable) yet compile to a plain integer
        # compare with every int-literal optimization (tagged ints, int
        # conditions). ASCII first byte only -- for multi-byte UTF-8 the
        # runtime ord() decodes the codepoint, so leave those to runtime.
        if ($name eq "ord" && $arg_count == 1) {
            my scalar $ord_arg = $args->[0];
            if ($ord_arg->{"type"} == NODE_STR_LITERAL()) {
                my str $ord_sval = $ord_arg->{"value"};
                if (length($ord_sval) > 0) {
                    my int $ord_code = char_at($ord_sval, 0);
                    if ($ord_code > 0 && $ord_code < 128) {
                        $expr->{"type"} = NODE_INT_LITERAL();
                        $expr->{"value"} = $ord_code;
                        return;
                    }
                }
            }
        }

        # Record tie usage on the context: the codegen's condition-level
        # hash-fetch CSE is only sound when no hash in the program can be
        # tied (a tied FETCH is observable per-mention).
        if ($name eq "tie" || $name eq "core::tie" || $name eq "sys::tie") {
            $ctx->{"uses_tie"} = 1;
        }

        # Check if builtin (builtins hash stores 1 for each builtin)
        my int $is_builtin = $ctx->{"builtins"}->{$name};
        if ($is_builtin == 1) {
            # Builtin - analyze arguments
            for (my int $i = 0; $i < $arg_count; $i = $i + 1) {
                analyze_expression($ctx, $args->[$i]);
            }
            return;
        }

        # Convert Package::func (and nested A::B::func) to A_B_func for lookup
        # Module functions are registered as Package::func, so try all forms
        my str $lookup_name = $name;
        my int $colon_idx = index($name, "::");
        my str $all_us_name = $name;
        if ($colon_idx >= 0) {
            my int $rci = index($all_us_name, "::");
            while ($rci >= 0) {
                $all_us_name = substr($all_us_name, 0, $rci) . "_" . substr($all_us_name, $rci + 2, length($all_us_name) - $rci - 2);
                $rci = index($all_us_name, "::");
            }
            my scalar $fn_info_us = $ctx->{"functions"}->{$all_us_name};
            if ($fn_info_us->{"is_registered"} == 1) {
                $lookup_name = $all_us_name;
            } else {
                my int $last_col = rindex($name, "::");
                if ($last_col > 0) {
                    my str $q_pkg = substr($name, 0, $last_col);
                    my str $q_fn = substr($name, $last_col + 2, length($name) - $last_col - 2);
                    # Support modules whose package statement uses underscores
                    # (`package Digest_SHA;` inside `lib/Digest/SHA.strada`,
                    # registered by load_module as `Digest_SHA::hmac_sha256_hex`)
                    my str $c_q_pkg = $q_pkg;
                    my int $qci = index($c_q_pkg, "::");
                    while ($qci >= 0) {
                        $c_q_pkg = substr($c_q_pkg, 0, $qci) . "_" . substr($c_q_pkg, $qci + 2, length($c_q_pkg) - $qci - 2);
                        $qci = index($c_q_pkg, "::");
                    }
                    my str $hybrid_name = $c_q_pkg . "::" . $q_fn;
                    my scalar $fn_info_hyb = $ctx->{"functions"}->{$hybrid_name};
                    if ($fn_info_hyb->{"is_registered"} == 1) {
                        $lookup_name = $hybrid_name;
                    } elsif ($q_pkg eq "main") {
                        # Also support main::func() calling a top-level main function
                        # (rewrite call name to bare $q_fn since top-level main functions
                        # are emitted in C without a `main_` prefix!)
                        my scalar $fn_info_main = $ctx->{"functions"}->{$q_fn};
                        if ($fn_info_main->{"is_registered"} == 1) {
                            $lookup_name = $q_fn;
                            $name = $q_fn;
                            $expr->{"name"} = $q_fn;
                        }
                    }
                }
            }
        } else {
            # Name has no ::, but might be Package_func format from ::func() calls
            # Try to find Package::func format in registry
            # Since package names can contain underscores (e.g., Sysync_Token),
            # try all possible underscore positions as the separator
            my int $found_colon = 0;
            my int $us_idx = index($name, "_");
            while ($us_idx > 0 && $found_colon == 0) {
                my str $pkg_part = substr($name, 0, $us_idx);
                my str $func_part = substr($name, $us_idx + 1, length($name) - $us_idx - 1);
                if (length($pkg_part) > 0 && length($func_part) > 0) {
                    my str $colon_name = $pkg_part . "::" . $func_part;
                    my scalar $fn_info_colon = $ctx->{"functions"}->{$colon_name};
                    if ($fn_info_colon->{"is_registered"} == 1) {
                        $lookup_name = $colon_name;
                        $found_colon = 1;
                    }
                }
                if ($found_colon == 0) {
                    # Try next underscore position
                    my int $next_idx = index(substr($name, $us_idx + 1, length($name) - $us_idx - 1), "_");
                    if ($next_idx >= 0) {
                        $us_idx = $us_idx + 1 + $next_idx;
                    } else {
                        $us_idx = -1;  # No more underscores
                    }
                }
            }
        }

        # Check if user-defined function
        # Registered functions have is_registered = 1
        my scalar $fn_info = $ctx->{"functions"}->{$lookup_name};
        my int $is_reg = $fn_info->{"is_registered"};
        if ($is_reg == 0) {
            # Not found - try package-prefixed name if we're in a package
            if ($colon_idx < 0) {
                my scalar $cur_fn = $ctx->{"current_func"};
                my str $pkg = "";
                my int $has_cur_fn = 0;
                if ($cur_fn) {
                    $has_cur_fn = 1;
                }
                if ($has_cur_fn == 1) {
                    $pkg = $cur_fn->{"package"};
                }
                if (length($pkg) > 0 && $pkg ne "main") {
                    # Convert :: to _ in package name for underscore format lookup
                    my str $c_pkg = $pkg;
                    my int $ci = index($c_pkg, "::");
                    while ($ci >= 0) {
                        $c_pkg = substr($c_pkg, 0, $ci) . "_" . substr($c_pkg, $ci + 2, length($c_pkg) - $ci - 2);
                        $ci = index($c_pkg, "::");
                    }
                    # Try package-prefixed name with underscore (Package_func format)
                    my str $prefixed_name = $c_pkg . "_" . $name;
                    my scalar $fn_info_pkg = $ctx->{"functions"}->{$prefixed_name};
                    if ($fn_info_pkg->{"is_registered"} == 1) {
                        # Found it! Update for continued validation
                        $lookup_name = $prefixed_name;
                        $fn_info = $fn_info_pkg;
                        $is_reg = 1;
                    }
                    # Also try Package::func format (functions from modules)
                    # Use original $pkg (not $c_pkg) to preserve :: in nested packages
                    # e.g., Strada::Interpreter::func_name, not Strada_Interpreter::func_name
                    if ($is_reg == 0) {
                        my str $colon_name = $pkg . "::" . $name;
                        my scalar $fn_info_colon = $ctx->{"functions"}->{$colon_name};
                        if ($fn_info_colon->{"is_registered"} == 1) {
                            $lookup_name = $colon_name;
                            $fn_info = $fn_info_colon;
                            $is_reg = 1;
                        }
                    }
                }
                if ($is_reg == 0) {
                    semantic_error($ctx, "undefined function '" . $name . "'", $line);
                }
            } else {
                # Qualified call `Pkg::func()` to a user package (not a builtin
                # namespace, not `-M` separate-compile mode where undeclared
                # cross-module calls emit auto-externs, not an inline `Pkg::new`
                # constructor on a known package, and not defined in a top-level
                # __C__ block): report undefined function!
                my str $first_ns = substr($name, 0, $colon_idx);
                my int $skip_qual_err = 0;
                my int $lcol2 = rindex($name, "::");
                if ($lcol2 > 0) {
                    my str $npkg = substr($name, 0, $lcol2);
                    my str $nfn = substr($name, $lcol2 + 2, length($name) - $lcol2 - 2);
                    my str $c_npkg = $npkg;
                    my int $nci = index($c_npkg, "::");
                    while ($nci >= 0) {
                        $c_npkg = substr($c_npkg, 0, $nci) . "_" . substr($c_npkg, $nci + 2, length($c_npkg) - $nci - 2);
                        $nci = index($c_npkg, "::");
                    }
                    my int $pkg_is_known = 0;
                    if ($ctx->{"known_packages"}->{$npkg} == 1 || $ctx->{"known_packages"}->{$c_npkg} == 1) {
                        $pkg_is_known = 1;
                    }
                    if ($nfn eq "new" && $pkg_is_known == 1) {
                        $skip_qual_err = 1;
                    }
                    # Library/submodule files without main() (e.g. Build.strada
                    # included by pacco.strada) may call sibling packages resolved
                    # by the host program.
                    if ($ctx->{"has_main"} != 1 && $pkg_is_known == 0) {
                        $skip_qual_err = 1;
                    }
                }
                if (sem_is_builtin_namespace($first_ns) == 0 && $ctx->{"module_only_mode"} != 1 && $skip_qual_err == 0) {
                    my str $c_blobs = $ctx->{"c_blocks_str"};
                    if (length($c_blobs) == 0 || index($c_blobs, $all_us_name) < 0) {
                        semantic_error($ctx, "undefined function '" . $name . "'", $line);
                    }
                }
            }
            if ($is_reg == 0) {
                for (my int $i = 0; $i < $arg_count; $i = $i + 1) {
                    analyze_expression($ctx, $args->[$i]);
                }
                return;
            }
        }

        if ($fn_info->{"is_private"} == 1) {
            my str $callee_pkg = "" . $fn_info->{"package"};
            if (length($callee_pkg) == 0) { $callee_pkg = "main"; }
            my str $caller_pkg = "main";
            my scalar $cur_f = $ctx->{"current_func"};
            if (is_valid_node($cur_f) == 1) {
                my str $cp = "" . $cur_f->{"package"};
                if (length($cp) > 0) { $caller_pkg = $cp; }
            }
            my int $priv_ok = 0;
            if ($caller_pkg eq $callee_pkg) {
                if ($caller_pkg eq "main") {
                    my int $cfu = $ctx->{"cur_from_use"} + 0;
                    if (is_valid_node($cur_f) == 1) { $cfu = $cur_f->{"from_use"} + 0; }
                    if ($cfu == ($fn_info->{"from_use"} + 0)) {
                        my str $cfk_m = "" . $ctx->{"cur_file"};
                        if (is_valid_node($cur_f) == 1 && length("" . $cur_f->{"file"}) > 0) {
                            $cfk_m = "" . $cur_f->{"file"};
                        }
                        if ($cfu == 0 || $cfk_m eq ("" . $fn_info->{"file"})) {
                            $priv_ok = 1;
                        }
                    }
                } else {
                    $priv_ok = 1;
                }
            }
            if ($priv_ok == 0) {
                semantic_error($ctx, "cannot call private function '" . $name . "' from outside package '" . $callee_pkg . "'", $line);
            }
        }

        my int $expected = $fn_info->{"param_count"};
        my int $actual = $expr->{"arg_count"};

        # Check if any argument is a spread operator
        my int $has_spread = 0;
        for (my int $s = 0; $s < $actual; $s = $s + 1) {
            if ($args->[$s]->{"type"} == NODE_SPREAD()) {
                $has_spread = 1;
            }
        }

        # Skip arg count validation when spread is present (count unknown at compile time)
        if ($has_spread == 0) {
            # Count required parameters (those without defaults, excluding variadic params)
            my int $required = 0;
            my scalar $params = $fn_info->{"params"};
            for (my int $i = 0; $i < $expected; $i = $i + 1) {
                my scalar $param = $params->[$i];
                my int $has_def = $param->{"has_default"};
                my int $is_variadic = $param->{"is_variadic"};
                # Variadic params are optional (can have 0 items)
                if ($has_def == 0 && $is_variadic == 0) {
                    $required = $required + 1;
                }
            }

            if ($actual < $required) {
                semantic_error($ctx, "too few arguments to '" . $name . "': expected " . $required . ", got " . $actual, $line);
            }
            if ($actual > $expected) {
                # Check if function is variadic
                my int $is_var = $fn_info->{"is_variadic"};
                if ($is_var == 0) {
                    semantic_error($ctx, "too many arguments to '" . $name . "': expected " . $expected . ", got " . $actual, $line);
                }
            }
        }

        # Analyze arguments (args is already declared above)
        for (my int $i = 0; $i < $actual; $i = $i + 1) {
            analyze_expression($ctx, $args->[$i]);
            # Stage-0 type check: scalar parameters with a declared type.
            # Parameters are exempt from runtime coercion (borrowed values),
            # so a mismatch here is the highest-signal site of the four.
            if ($ctx->{"strict_types"} == 1 && $has_spread == 0 && $i < $expected) {
                my scalar $cparam = $fn_info->{"params"}->[$i];
                if ($cparam->{"is_variadic"} != 1) {
                    my str $psigil = $cparam->{"sigil"};
                    if ($psigil eq "$") {
                        my int $ptype = $cparam->{"param_type"};
                        my int $atype = stage0_expr_type($ctx, $args->[$i]);
                        if (stage0_types_compatible($ptype, $atype) == 0) {
                            my int $argno = $i + 1;
                            semantic_warn($ctx, "argument " . $argno . " to '" . $name
                                . "': expected " . ast_data_type_name($ptype)
                                . ", got " . ast_data_type_name($atype), $line);
                        }
                    }
                }
            }
        }
        return;
    }

    # Binary operation
    if ($node_type == NODE_BINARY_OP()) {
        analyze_expression($ctx, $expr->{"left"});
        analyze_expression($ctx, $expr->{"right"});
        return;
    }

    # Unary operation
    if ($node_type == NODE_UNARY_OP()) {
        analyze_expression($ctx, $expr->{"operand"});
        return;
    }

    # Assignment
    if ($node_type == NODE_ASSIGN()) {
        analyze_expression($ctx, $expr->{"target"});
        analyze_expression($ctx, $expr->{"value"});
        # Stage-0 type check: plain `=` to a declared scalar variable.
        # Compound ops (+=, .=, ...) keep their own operand semantics.
        if ($ctx->{"strict_types"} == 1 && $expr->{"op"} eq "=") {
            my scalar $tgt = $expr->{"target"};
            if ($tgt->{"type"} == NODE_VARIABLE()) {
                my str $tsigil = $tgt->{"sigil"};
                if ($tsigil eq "$") {
                    my scalar $lk = scope_lookup_var_sigil($ctx->{"scope"}, $tgt->{"name"}, "$");
                    if ($lk->{"found"} == 1) {
                        my int $dtype = $lk->{"info"}->{"type"};
                        my int $atype = stage0_expr_type($ctx, $expr->{"value"});
                        if (stage0_types_compatible($dtype, $atype) == 0) {
                            # Assign nodes don't always carry a line — fall
                            # back to the target, then the value expression.
                            my int $aline = ast_get_line($expr);
                            if ($aline == 0) { $aline = ast_get_line($tgt); }
                            if ($aline == 0) { $aline = ast_get_line($expr->{"value"}); }
                            semantic_warn($ctx, "assigning a " . ast_data_type_name($atype)
                                . " value to '$" . $tgt->{"name"} . "' (declared "
                                . ast_data_type_name($dtype) . ")", $aline);
                        }
                    }
                }
            }
        }
        return;
    }

    # Array subscript ($arr[idx]): parser sets sigil "@" on $arr, which may refer
    # to `@arr` OR to a scalar/array-typed `$arr` (e.g. `my scalar $k = keys(%h); $k[0]`).
    if ($node_type == NODE_SUBSCRIPT()) {
        my scalar $sub_arr = $expr->{"array"};
        if ($sub_arr->{"type"} == NODE_VARIABLE() && $sub_arr->{"sigil"} eq "@") {
            my str $sa_name = $sub_arr->{"name"};
            my scalar $sa_lk = scope_lookup_var_sigil($ctx->{"scope"}, $sa_name, "@");
            my str $matched_sigil = "@";
            if ($sa_lk->{"found"} == 0) {
                my scalar $sa_slk = scope_lookup_var_sigil($ctx->{"scope"}, $sa_name, "$");
                if ($sa_slk->{"found"} == 1) {
                    my int $sa_vt = $sa_slk->{"info"}->{"type"};
                    if ($sa_vt == TYPE_SCALAR() || $sa_vt == TYPE_ARRAY() || $sa_vt == TYPE_DYNAMIC() || $sa_vt <= 0) {
                        $sa_lk = $sa_slk;
                        $matched_sigil = "$";
                    }
                }
            }
            if ($sa_lk->{"found"} == 0) {
                semantic_error($ctx, "undefined variable '@" . $sa_name . "'", ast_get_line($sub_arr));
            } else {
                scope_mark_used_sigil($ctx->{"scope"}, $sa_name, $matched_sigil);
                my scalar $sa_vinfo = $sa_lk->{"info"};
                if ($sa_vinfo->{"is_global"} == 1 && size(@{$sa_vinfo->{"decls"}}) > 1) {
                    $sub_arr->{"name"} = resolve_shadowed_global($ctx, $sa_vinfo, $sa_name, ast_get_line($sub_arr), $matched_sigil);
                }
            }
        } else {
            analyze_expression($ctx, $sub_arr);
        }
        analyze_expression($ctx, $expr->{"index"});
        return;
    }

    # Hash access ($h{key}): parser sets sigil "%" on $h, which may refer
    # to `%h` OR to a scalar/hash-typed `$h` (e.g. `my scalar $h = deref_hash($r); $h{"k"}`).
    if ($node_type == NODE_HASH_ACCESS()) {
        my scalar $ha_hash = $expr->{"hash"};
        if ($ha_hash->{"type"} == NODE_VARIABLE() && $ha_hash->{"sigil"} eq "%") {
            my str $hh_name = $ha_hash->{"name"};
            my scalar $hh_lk = scope_lookup_var_sigil($ctx->{"scope"}, $hh_name, "%");
            my str $hmatched_sigil = "%";
            if ($hh_lk->{"found"} == 0) {
                my scalar $hh_slk = scope_lookup_var_sigil($ctx->{"scope"}, $hh_name, "$");
                if ($hh_slk->{"found"} == 1) {
                    my int $hh_vt = $hh_slk->{"info"}->{"type"};
                    if ($hh_vt == TYPE_SCALAR() || $hh_vt == TYPE_HASH() || $hh_vt == TYPE_DYNAMIC() || $hh_vt <= 0) {
                        $hh_lk = $hh_slk;
                        $hmatched_sigil = "$";
                    }
                }
            }
            if ($hh_lk->{"found"} == 0) {
                semantic_error($ctx, "undefined variable '%" . $hh_name . "'", ast_get_line($ha_hash));
            } else {
                scope_mark_used_sigil($ctx->{"scope"}, $hh_name, $hmatched_sigil);
                my scalar $hh_vinfo = $hh_lk->{"info"};
                if ($hh_vinfo->{"is_global"} == 1 && size(@{$hh_vinfo->{"decls"}}) > 1) {
                    $ha_hash->{"name"} = resolve_shadowed_global($ctx, $hh_vinfo, $hh_name, ast_get_line($ha_hash), $hmatched_sigil);
                }
            }
        } else {
            analyze_expression($ctx, $ha_hash);
        }
        analyze_expression($ctx, $expr->{"key"});
        return;
    }

    # Array slice (@arr[0, 2])
    if ($node_type == NODE_ARRAY_SLICE()) {
        analyze_expression($ctx, $expr->{"source"});
        my scalar $as_items = $expr->{"items"};
        my int $as_count = $expr->{"item_count"};
        for (my int $asi = 0; $asi < $as_count; $asi = $asi + 1) {
            analyze_expression($ctx, $as_items->[$asi]);
        }
        return;
    }

    # Hash slice (@hash{"a", "b"}) — source AST node carries '@' sigil from `@hash`,
    # while the underlying container variable in scope is `%hash` (sigil '%').
    if ($node_type == NODE_HASH_SLICE()) {
        my scalar $hs_src = $expr->{"source"};
        if ($hs_src->{"type"} == NODE_VARIABLE() && $hs_src->{"sigil"} eq "@") {
            my str $hs_name = $hs_src->{"name"};
            my scalar $hs_lk = scope_lookup_var_sigil($ctx->{"scope"}, $hs_name, "%");
            if ($hs_lk->{"found"} == 0) {
                semantic_error($ctx, "undefined variable '%" . $hs_name . "'", ast_get_line($hs_src));
            } else {
                scope_mark_used_sigil($ctx->{"scope"}, $hs_name, "%");
                my scalar $hs_vinfo = $hs_lk->{"info"};
                if ($hs_vinfo->{"is_global"} == 1 && size(@{$hs_vinfo->{"decls"}}) > 1) {
                    $hs_src->{"name"} = resolve_shadowed_global($ctx, $hs_vinfo, $hs_name, ast_get_line($hs_src), "%");
                }
            }
        } else {
            analyze_expression($ctx, $hs_src);
        }
        my scalar $hs_items = $expr->{"items"};
        my int $hs_count = $expr->{"item_count"};
        for (my int $hsi = 0; $hsi < $hs_count; $hsi = $hsi + 1) {
            analyze_expression($ctx, $hs_items->[$hsi]);
        }
        return;
    }

    # Reference
    if ($node_type == NODE_REF()) {
        analyze_expression($ctx, $expr->{"target"});
        return;
    }

    # Dereference
    if ($node_type == NODE_DEREF_SCALAR() || $node_type == NODE_DEREF_ARRAY() || $node_type == NODE_DEREF_HASH()) {
        analyze_expression($ctx, $expr->{"ref"});
        if ($node_type == NODE_DEREF_ARRAY()) {
            analyze_expression($ctx, $expr->{"index"});
        }
        if ($node_type == NODE_DEREF_HASH()) {
            analyze_expression($ctx, $expr->{"key"});
        }
        return;
    }

    # Field access
    if ($node_type == NODE_FIELD_ACCESS()) {
        analyze_expression($ctx, $expr->{"object"});
        return;
    }

    # Anonymous array
    if ($node_type == NODE_ANON_ARRAY()) {
        my scalar $elems = $expr->{"elements"};
        my int $count = $expr->{"element_count"};
        for (my int $i = 0; $i < $count; $i = $i + 1) {
            analyze_expression($ctx, $elems->[$i]);
        }
        return;
    }

    # Anonymous hash (including computed key_exprs)
    if ($node_type == NODE_ANON_HASH()) {
        my scalar $key_exprs = $expr->{"key_exprs"};
        my scalar $values = $expr->{"values"};
        my int $count = $expr->{"pair_count"};
        for (my int $i = 0; $i < $count; $i = $i + 1) {
            if (is_valid_node($key_exprs->[$i]) == 1) {
                analyze_expression($ctx, $key_exprs->[$i]);
            }
            analyze_expression($ctx, $values->[$i]);
        }
        return;
    }

    # Method call
    if ($node_type == NODE_METHOD_CALL()) {
        analyze_expression($ctx, $expr->{"object"});
        my scalar $args = $expr->{"args"};
        my int $count = $expr->{"arg_count"};
        for (my int $i = 0; $i < $count; $i = $i + 1) {
            analyze_expression($ctx, $args->[$i]);
        }
        return;
    }

    # Dynamic method call ($obj->$method(args))
    if ($node_type == NODE_DYN_METHOD_CALL()) {
        analyze_expression($ctx, $expr->{"base_object"});
        analyze_expression($ctx, $expr->{"method_expr"});
        my scalar $dmc_args = $expr->{"args"};
        my int $dmc_count = $expr->{"arg_count"};
        for (my int $dmc_i = 0; $dmc_i < $dmc_count; $dmc_i = $dmc_i + 1) {
            analyze_expression($ctx, $dmc_args->[$dmc_i]);
        }
        return;
    }

    # SUPER:: call
    if ($node_type == NODE_SUPER_CALL()) {
        my scalar $args = $expr->{"args"};
        my int $count = $expr->{"arg_count"};
        for (my int $i = 0; $i < $count; $i = $i + 1) {
            analyze_expression($ctx, $args->[$i]);
        }
        return;
    }

    # Closure call ($closure->(args))
    if ($node_type == NODE_CLOSURE_CALL()) {
        analyze_expression($ctx, $expr->{"closure"});
        my scalar $args = $expr->{"args"};
        my int $count = $expr->{"arg_count"};
        for (my int $i = 0; $i < $count; $i = $i + 1) {
            analyze_expression($ctx, $args->[$i]);
        }
        return;
    }

    # Ternary expression ($cond ? $true_expr : $false_expr)
    if ($node_type == NODE_TERNARY()) {
        analyze_expression($ctx, $expr->{"condition"});
        analyze_expression($ctx, $expr->{"true_expr"});
        analyze_expression($ctx, $expr->{"false_expr"});
        return;
    }

    # Increment / decrement (++$x, $x--)
    if ($node_type == NODE_INCREMENT()) {
        analyze_expression($ctx, $expr->{"operand"});
        return;
    }

    # Range expression ($start .. $end)
    if ($node_type == NODE_RANGE()) {
        analyze_expression($ctx, $expr->{"start"});
        analyze_expression($ctx, $expr->{"end"});
        return;
    }

    # map { block } @array and grep { block } @array (with $_ in scope)
    if ($node_type == NODE_MAP() || $node_type == NODE_GREP()) {
        analyze_expression($ctx, $expr->{"array"});
        if (is_valid_node($expr->{"block"}) == 1) {
            my scalar $mg_outer = $ctx->{"scope"};
            $ctx->{"scope"} = scope_new($mg_outer);
            scope_add_var($ctx->{"scope"}, "_", "$", TYPE_SCALAR(), $line);
            scope_mark_used_sigil($ctx->{"scope"}, "_", "$");
            analyze_block($ctx, $expr->{"block"});
            $ctx->{"scope"} = $mg_outer;
        }
        return;
    }

    # sort { $a <=> $b } @array (with $a and $b in scope)
    if ($node_type == NODE_SORT()) {
        analyze_expression($ctx, $expr->{"array"});
        if (is_valid_node($expr->{"block"}) == 1) {
            my scalar $sort_outer = $ctx->{"scope"};
            $ctx->{"scope"} = scope_new($sort_outer);
            scope_add_var($ctx->{"scope"}, "a", "$", TYPE_SCALAR(), $line);
            scope_mark_used_sigil($ctx->{"scope"}, "a", "$");
            scope_add_var($ctx->{"scope"}, "b", "$", TYPE_SCALAR(), $line);
            scope_mark_used_sigil($ctx->{"scope"}, "b", "$");
            analyze_block($ctx, $expr->{"block"});
            $ctx->{"scope"} = $sort_outer;
        }
        return;
    }

    # Regex match ($str =~ /pattern/)
    if ($node_type == NODE_REGEX_MATCH()) {
        analyze_expression($ctx, $expr->{"target"});
        analyze_regex_interp($ctx, "" . $expr->{"pattern"}, $line);
        return;
    }

    # Regex substitution ($str =~ s/pattern/replacement/flags)
    if ($node_type == NODE_REGEX_SUBST()) {
        analyze_expression($ctx, $expr->{"target"});
        analyze_regex_interp($ctx, "" . $expr->{"pattern"}, $line);
        my str $sflags = "" . $expr->{"flags"};
        if (index($sflags, "e") >= 0) {
            if (is_valid_node($expr->{"eval_expr"}) == 1) {
                analyze_expression($ctx, $expr->{"eval_expr"});
            }
        } else {
            analyze_regex_interp($ctx, "" . $expr->{"replacement"}, $line);
        }
        return;
    }

    # Transliteration ($str =~ tr/search/replace/flags)
    if ($node_type == NODE_TR()) {
        analyze_expression($ctx, $expr->{"target"});
        return;
    }

    # await expression
    if ($node_type == NODE_AWAIT()) {
        analyze_expression($ctx, $expr->{"expr"});
        return;
    }

    # Diamond readline (<$fh> or <STDIN>)
    if ($node_type == NODE_READLINE()) {
        my str $rl_var = "" . $expr->{"varname"};
        if (length($rl_var) > 0) {
            my scalar $rl_lk = scope_lookup_var_sigil($ctx->{"scope"}, $rl_var, "$");
            if ($rl_lk->{"found"} == 0) {
                semantic_error($ctx, "undefined variable '$" . $rl_var . "'", $line);
            } else {
                scope_mark_used_sigil($ctx->{"scope"}, $rl_var, "$");
            }
        }
        return;
    }

    # Spread expression (...@arr)
    if ($node_type == NODE_SPREAD()) {
        analyze_expression($ctx, $expr->{"target"});
        return;
    }

    # Literals - no validation needed
    # NODE_INT_LITERAL, NODE_NUM_LITERAL, NODE_STR_LITERAL, NODE_FUNC_REF
}

func scope_check_param_redecl(scalar $ctx, scalar $current_scope, str $name, str $sigil, str $kind, int $line) void {
    my scalar $parent_scope = $current_scope->{"parent"};
    if ($parent_scope && ($parent_scope->{"is_param_scope"} + 0) == 1) {
        my scalar $pvars = $parent_scope->{"vars"};
        if (exists(%{$pvars}, $name)) {
            my scalar $prev_info = $pvars->{$name};
            my int $prev_line = $prev_info->{"line"};
            semantic_error($ctx, $kind . " '" . $sigil . $name . "' redeclares parameter '" . $prev_info->{"sigil"} . $name . "' (declared at line " . $prev_line . ")", $line);
        }
    }
}

func analyze_statement(scalar $ctx, scalar $stmt) void {
    my int $node_type = $stmt->{"type"};
    my int $line = ast_get_line($stmt);

    # Variable declaration
    if ($node_type == NODE_VAR_DECL()) {
        my str $name = $stmt->{"name"};
        my str $sigil = $stmt->{"sigil"};
        my int $var_type = $stmt->{"var_type"};

        # Check for redeclaration in current scope
        my scalar $current_scope = $ctx->{"scope"};
        my scalar $scope_vars = $current_scope->{"vars"};
        if (exists(%{$scope_vars}, $name)) {
            my scalar $prev_info = $scope_vars->{$name};
            my int $prev_line = $prev_info->{"line"};
            semantic_error($ctx, "variable '" . $sigil . $name . "' already declared in this scope (previous declaration at line " . $prev_line . ")", $line);
        }
        scope_check_param_redecl($ctx, $current_scope, $name, $sigil, "variable", $line);

        # Add variable to scope
        scope_add_var($current_scope, $name, $sigil, $var_type, $line);

        # Analyze optional initial_capacity expression if present
        if (is_valid_node($stmt->{"initial_capacity"}) == 1) {
            analyze_expression($ctx, $stmt->{"initial_capacity"});
        }

        # Analyze initializer if present
        my scalar $init_expr = $stmt->{"init"};
        if (is_valid_node($init_expr) == 1) {
            analyze_expression($ctx, $init_expr);
            # Stage-0 type check (scalar declarations only — array/hash
            # initializers are flattening lists with their own semantics).
            if ($ctx->{"strict_types"} == 1 && $sigil eq "$") {
                my int $atype = stage0_expr_type($ctx, $init_expr);
                if (stage0_types_compatible($var_type, $atype) == 0) {
                    semantic_warn($ctx, "initializing '" . $sigil . $name . "' (declared "
                        . ast_data_type_name($var_type) . ") with a "
                        . ast_data_type_name($atype) . " value", $line);
                }
            }
        }
        return;
    }

    # Const declaration - similar to var decl but with $ sigil
    if ($node_type == NODE_CONST_DECL()) {
        my str $name = $stmt->{"name"};
        my int $var_type = $stmt->{"var_type"};

        # Check for redeclaration in current scope
        my scalar $current_scope = $ctx->{"scope"};
        my scalar $scope_vars = $current_scope->{"vars"};
        if (exists(%{$scope_vars}, $name)) {
            my scalar $prev_info = $scope_vars->{$name};
            my int $prev_line = $prev_info->{"line"};
            semantic_error($ctx, "constant '" . $name . "' already declared in this scope (previous declaration at line " . $prev_line . ")", $line);
        }
        scope_check_param_redecl($ctx, $current_scope, $name, "$", "constant", $line);

        # Add const to scope as a scalar
        scope_add_var($current_scope, $name, "$", $var_type, $line);

        # Analyze initializer (required for const)
        my scalar $init_expr = $stmt->{"init"};
        if (is_valid_node($init_expr) == 1) {
            analyze_expression($ctx, $init_expr);
        }
        return;
    }

    # Our declaration (package-scoped global via global registry)
    if ($node_type == NODE_OUR_DECL()) {
        my str $name = $stmt->{"name"};
        my str $sigil = $stmt->{"sigil"};
        my int $var_type = $stmt->{"var_type"};

        # Add variable to scope so subsequent references are valid
        my scalar $current_scope = $ctx->{"scope"};
        scope_add_var($current_scope, $name, $sigil, $var_type, $line);
        $current_scope->{"vars"}->{$name}->{"is_our"} = 1;

        # Analyze initializer if present
        my scalar $init_expr = $stmt->{"init"};
        if (is_valid_node($init_expr) == 1) {
            analyze_expression($ctx, $init_expr);
        }
        return;
    }

    # Dynamic localization: local $our_var = expr; or local $hash{key} = expr;
    if ($node_type == NODE_LOCAL_DECL()) {
        my str $name = $stmt->{"name"};
        my str $sigil = $stmt->{"sigil"};
        if ($stmt->{"is_hash_elem"} == 1) {
            my scalar $hk = $stmt->{"hash_key"};
            if (is_valid_node($hk) == 1) {
                analyze_expression($ctx, $hk);
            }
            if (index($name, "::") < 0) {
                my scalar $hlk = scope_lookup_var_sigil($ctx->{"scope"}, $name, "%");
                if ($hlk->{"found"} == 0) {
                    semantic_error($ctx, "undefined variable '%" . $name . "'", $line);
                } else {
                    scope_mark_used_sigil($ctx->{"scope"}, $name, "%");
                }
            }
        } else {
            if (index($name, "::") < 0 && $name ne "_" && $name ne "/" && $name ne "\\" && $name ne "," && $name ne "\"") {
                my scalar $lk = scope_lookup_var_sigil($ctx->{"scope"}, $name, $sigil);
                if ($lk->{"found"} == 0) {
                    semantic_error($ctx, "undefined variable '" . $sigil . $name . "'", $line);
                } else {
                    my scalar $vinfo = $lk->{"info"};
                    if ($vinfo->{"is_our"} != 1) {
                        semantic_error($ctx, "Can't localize lexical variable " . $sigil . $name, $line);
                    }
                    scope_mark_used_sigil($ctx->{"scope"}, $name, $sigil);
                }
            }
        }
        my scalar $init_expr = $stmt->{"init"};
        if (is_valid_node($init_expr) == 1) {
            analyze_expression($ctx, $init_expr);
        }
        return;
    }

    # Destructuring assignment: my ($a, $b, $c) = expr; or ($a, $b) = expr;
    if ($node_type == NODE_DESTRUCTURE()) {
        my scalar $vars = $stmt->{"vars"};
        my int $var_count = $stmt->{"var_count"};
        my int $is_decl = $stmt->{"is_decl"};
        my scalar $current_scope = $ctx->{"scope"};
        my scalar $scope_vars = $current_scope->{"vars"};

        # Register all variables if this is a declaration; otherwise validate existing targets
        if ($is_decl == 1) {
            my int $i = 0;
            while ($i < $var_count) {
                my scalar $var = $vars->[$i];
                my str $name = $var->{"name"};
                my str $sigil = $var->{"sigil"};
                my int $var_type = $var->{"var_type"};

                # Check for redeclaration in current scope
                if (exists(%{$scope_vars}, $name)) {
                    my scalar $prev_info = $scope_vars->{$name};
                    my int $prev_line = $prev_info->{"line"};
                    semantic_error($ctx, "variable '" . $sigil . $name . "' already declared in this scope (previous declaration at line " . $prev_line . ")", $line);
                }
                scope_check_param_redecl($ctx, $current_scope, $name, $sigil, "variable", $line);

                # Add variable to scope
                scope_add_var($current_scope, $name, $sigil, $var_type, $line);
                $i = $i + 1;
            }
        } else {
            my int $i = 0;
            while ($i < $var_count) {
                my scalar $var = $vars->[$i];
                my str $name = $var->{"name"};
                my str $sigil = $var->{"sigil"};
                my scalar $dlk = scope_lookup_var_sigil($current_scope, $name, $sigil);
                if ($dlk->{"found"} == 0) {
                    semantic_error($ctx, "undefined variable '" . $sigil . $name . "'", $line);
                } else {
                    scope_mark_used_sigil($current_scope, $name, $sigil);
                }
                $i = $i + 1;
            }
        }

        # Analyze initializer
        my scalar $init_expr = $stmt->{"init"};
        if (is_valid_node($init_expr) == 1) {
            analyze_expression($ctx, $init_expr);
        }
        return;
    }

    # Nested block statement (`{ ... }`, including `while (my $x = ...)` wrapper blocks)
    if ($node_type == NODE_BLOCK()) {
        analyze_block($ctx, $stmt);
        return;
    }

    # Expression statement
    if ($node_type == NODE_EXPR_STMT()) {
        analyze_expression($ctx, $stmt->{"expr"});
        return;
    }

    # Return statement
    if ($node_type == NODE_RETURN_STMT()) {
        my scalar $ret_val = $stmt->{"value"};
        if (is_valid_node($ret_val) == 1) {
            analyze_expression($ctx, $ret_val);
            my scalar $cur = $ctx->{"current_func"};
            if ($cur) {
                my int $rtype = $cur->{"return_type"};
                if ($rtype == TYPE_VOID()) {
                    semantic_error($ctx, "cannot return a value from void function '" . $cur->{"name"} . "'", $line);
                } elsif ($ctx->{"strict_types"} == 1 && $rtype != TYPE_DYNAMIC()) {
                    # Stage-0 type check: returned value vs declared return type.
                    my int $atype = stage0_expr_type($ctx, $ret_val);
                    if (stage0_types_compatible($rtype, $atype) == 0) {
                        semantic_warn($ctx, "returning a " . ast_data_type_name($atype)
                            . " value from '" . $cur->{"name"} . "' (declared to return "
                            . ast_data_type_name($rtype) . ")", $line);
                    }
                }
            }
        }
        return;
    }

    # If statement
    if ($node_type == NODE_IF_STMT()) {
        analyze_expression($ctx, $stmt->{"condition"});
        analyze_block($ctx, $stmt->{"then_block"});

        # elsif clauses
        my scalar $elsif_conds = $stmt->{"elsif_conditions"};
        my scalar $elsif_blocks = $stmt->{"elsif_blocks"};
        my int $elsif_count = $stmt->{"elsif_count"};
        for (my int $i = 0; $i < $elsif_count; $i = $i + 1) {
            analyze_expression($ctx, $elsif_conds->[$i]);
            analyze_block($ctx, $elsif_blocks->[$i]);
        }

        # else block
        my scalar $else_blk = $stmt->{"else_block"};
        if (is_valid_node($else_blk) == 1) {
            analyze_block($ctx, $else_blk);
        }
        return;
    }

    # While statement (condition may be an expression or a scoped NODE_VAR_DECL)
    if ($node_type == NODE_WHILE_STMT()) {
        my scalar $wcond = $stmt->{"condition"};
        if (is_valid_node($wcond) == 1 && $wcond->{"type"} == NODE_VAR_DECL()) {
            my scalar $wold_scope = $ctx->{"scope"};
            $ctx->{"scope"} = scope_new($wold_scope);
            analyze_statement($ctx, $wcond);
            analyze_block($ctx, $stmt->{"body"});
            scope_check_unused($ctx, $ctx->{"scope"});
            $ctx->{"scope"} = $wold_scope;
            return;
        }
        analyze_expression($ctx, $wcond);
        analyze_block($ctx, $stmt->{"body"});
        return;
    }

    # Do-while statement: do { body } while (condition);
    if ($node_type == NODE_DO_WHILE_STMT()) {
        analyze_block($ctx, $stmt->{"body"});
        analyze_expression($ctx, $stmt->{"condition"});
        return;
    }

    # Switch statement (scrutinee, per-case exprs and blocks, optional default block)
    if ($node_type == NODE_SWITCH()) {
        analyze_expression($ctx, $stmt->{"expr"});

        my scalar $cases = $stmt->{"cases"};
        my scalar $blocks = $stmt->{"blocks"};
        my int $case_count = $stmt->{"case_count"};
        my int $i = 0;
        while ($i < $case_count) {
            analyze_expression($ctx, $cases->[$i]);
            analyze_block($ctx, $blocks->[$i]);
            $i = $i + 1;
        }

        my int $has_default = $stmt->{"has_default"};
        if ($has_default == 1) {
            analyze_block($ctx, $stmt->{"default_block"});
        }
        return;
    }

    # For statement
    if ($node_type == NODE_FOR_STMT()) {
        # For loop has its own scope for the init variable
        my scalar $old_scope = $ctx->{"scope"};
        $ctx->{"scope"} = scope_new($old_scope);

        my scalar $for_init = $stmt->{"init"};
        if (is_valid_node($for_init) == 1) {
            # Init could be var decl or expression
            if ($for_init->{"type"} == NODE_VAR_DECL()) {
                analyze_statement($ctx, $for_init);
            } else {
                analyze_expression($ctx, $for_init);
            }
        }
        if (is_valid_node($stmt->{"condition"}) == 1) {
            analyze_expression($ctx, $stmt->{"condition"});
        }
        my scalar $for_upd = $stmt->{"update"};
        if (is_valid_node($for_upd) == 1) {
            analyze_expression($ctx, $for_upd);
        }
        analyze_block($ctx, $stmt->{"body"});

        scope_check_unused($ctx, $ctx->{"scope"});
        $ctx->{"scope"} = $old_scope;
        return;
    }

    # Foreach statement: foreach [my type $var | $var] (@array) { body }
    if ($node_type == NODE_FOREACH_STMT()) {
        if (is_valid_node($stmt->{"array"}) == 1) {
            analyze_expression($ctx, $stmt->{"array"});
        }
        my scalar $fe_old_scope = $ctx->{"scope"};
        $ctx->{"scope"} = scope_new($fe_old_scope);

        my scalar $fe_decl = $stmt->{"var_decl"};
        if (is_valid_node($fe_decl) == 1) {
            my str $fe_vname = $fe_decl->{"name"};
            my str $fe_sigil = $fe_decl->{"sigil"};
            my int $fe_vtype = $fe_decl->{"var_type"};
            scope_add_var($ctx->{"scope"}, $fe_vname, $fe_sigil, $fe_vtype, $line);
            scope_mark_used_sigil($ctx->{"scope"}, $fe_vname, $fe_sigil);
        } else {
            my str $fe_existing = "" . $stmt->{"var_name"};
            if (length($fe_existing) > 0) {
                my scalar $fe_lk = scope_lookup_var_sigil($ctx->{"scope"}, $fe_existing, "$");
                if ($fe_lk->{"found"} == 0) {
                    semantic_error($ctx, "undefined variable '$" . $fe_existing . "'", $line);
                } else {
                    scope_mark_used_sigil($ctx->{"scope"}, $fe_existing, "$");
                }
            }
        }

        analyze_block($ctx, $stmt->{"body"});
        scope_check_unused($ctx, $ctx->{"scope"});
        $ctx->{"scope"} = $fe_old_scope;
        return;
    }

    # Try/catch/finally statement
    if ($node_type == NODE_TRY_CATCH()) {
        analyze_block($ctx, $stmt->{"try_block"});

        my scalar $catch_clauses = $stmt->{"catch_clauses"};
        my int $catch_count = $stmt->{"catch_count"} + 0;
        my int $ci = 0;
        while ($ci < $catch_count) {
            my scalar $clause = $catch_clauses->[$ci];
            my scalar $old_scope = $ctx->{"scope"};
            $ctx->{"scope"} = scope_new($old_scope);

            my str $catch_var = "" . $clause->{"catch_var"};
            if (length($catch_var) > 0) {
                scope_add_var($ctx->{"scope"}, $catch_var, "$", TYPE_SCALAR(), $line);
                scope_mark_used_sigil($ctx->{"scope"}, $catch_var, "$");
            }

            if (is_valid_node($clause->{"catch_block"}) == 1) {
                analyze_block($ctx, $clause->{"catch_block"});
            }

            scope_check_unused($ctx, $ctx->{"scope"});
            $ctx->{"scope"} = $old_scope;
            $ci = $ci + 1;
        }

        if (is_valid_node($stmt->{"finally_block"}) == 1) {
            analyze_block($ctx, $stmt->{"finally_block"});
        }
        return;
    }

    # Throw statement
    if ($node_type == NODE_THROW()) {
        analyze_expression($ctx, $stmt->{"expr"});
        return;
    }
}

func analyze_block(scalar $ctx, scalar $block) void {
    # Create new scope for block
    my scalar $old_scope = $ctx->{"scope"};
    $ctx->{"scope"} = scope_new($old_scope);

    my scalar $stmts = $block->{"statements"};
    my int $count = $block->{"statement_count"};

    for (my int $i = 0; $i < $count; $i = $i + 1) {
        analyze_statement($ctx, $stmts->[$i]);
    }

    # Check for unused variables
    scope_check_unused($ctx, $ctx->{"scope"});

    # Restore scope
    $ctx->{"scope"} = $old_scope;
}

func analyze_function(scalar $ctx, scalar $fn) void {
    # Set current function for return type checking
    $ctx->{"current_func"} = $fn;

    # Create function scope
    my scalar $old_scope = $ctx->{"scope"};
    $ctx->{"scope"} = scope_new($old_scope);
    $ctx->{"scope"}->{"is_param_scope"} = 1;

    # Add parameters to scope
    my scalar $params = $fn->{"params"};
    my int $param_count = $fn->{"param_count"};
    my hash %seen_params = ();
    my hash %seen_bare_params = ();
    my int $fn_line = ast_get_line($fn);
    for (my int $i = 0; $i < $param_count; $i = $i + 1) {
        my scalar $param = $params->[$i];
        my str $pname = $param->{"name"};
        my str $sigil = $param->{"sigil"};
        my int $ptype = $param->{"param_type"};
        my int $pline = ast_get_line($param);
        my str $pkey = $sigil . $pname;
        my int $err_line = $pline;
        if ($err_line <= 0) { $err_line = $fn_line; }
        if ($seen_params{$pkey} == 1) {
            semantic_error($ctx, "duplicate parameter '" . $pkey . "'", $err_line);
        } elsif ($seen_bare_params{$pname} == 1) {
            semantic_error($ctx, "parameter '" . $pkey . "' conflicts with another parameter named '" . $pname . "'", $err_line);
        } else {
            $seen_params{$pkey} = 1;
            $seen_bare_params{$pname} = 1;
        }
        if (($param->{"has_default"} + 0) == 1 && is_valid_node($param->{"default"}) == 1) {
            analyze_expression($ctx, $param->{"default"});
        }
        scope_add_var($ctx->{"scope"}, $pname, $sigil, $ptype, $pline);
    }

    # Analyze function body (non-extern functions always have a body)
    analyze_block($ctx, $fn->{"body"});

    # Check for unused parameters
    scope_check_unused($ctx, $ctx->{"scope"});

    # Restore scope
    $ctx->{"scope"} = $old_scope;
    $ctx->{"current_func"} = 0;
}

# ============================================================
# Main Entry Point
# ============================================================

func semantic_analyze(scalar $ast, int $show_warnings, int $strict_types) void {
    my scalar $ctx = ctx_new();
    $ctx->{"show_warnings"} = $show_warnings;
    $ctx->{"strict_types"} = $strict_types;
    $ctx->{"qw_imports"} = $ast->{"qw_imports"};
    $ctx->{"module_only_mode"} = $ast->{"module_only_mode"} + 0;

    my int $cb_n = $ast->{"c_block_count"} + 0;
    if ($cb_n > 0) {
        my scalar $cb_sb = sb_new();
        my scalar $cbs = $ast->{"c_blocks"};
        my int $cbi = 0;
        while ($cbi < $cb_n) {
            sb_append($cb_sb, $cbs->[$cbi]);
            sb_append($cb_sb, "\n");
            $cbi = $cbi + 1;
        }
        $ctx->{"c_blocks_str"} = sb_to_string($cb_sb);
    } else {
        $ctx->{"c_blocks_str"} = "";
    }

    # First pass: register all functions and globals
    register_functions($ctx, $ast);
    my int $inh_n = $ast->{"inherit_count"} + 0;
    my scalar $inhs = $ast->{"inherits"};
    for (my int $ii = 0; $ii < $inh_n; $ii = $ii + 1) {
        my str $ich = "" . $inhs->[$ii]->{"child"};
        if (length($ich) > 0) { $ctx->{"known_packages"}->{$ich} = 1; }
    }
    register_globals($ctx, $ast);
    register_import_lib_functions($ctx, $ast);
    register_import_object_functions($ctx, $ast);
    register_import_archive_functions($ctx, $ast);

    # Validate top-level global initializers
    my int $gcount = $ast->{"global_count"} + 0;
    if ($gcount > 0) {
        my scalar $globals = $ast->{"globals"};
        for (my int $gi = 0; $gi < $gcount; $gi = $gi + 1) {
            my scalar $gvar = $globals->[$gi];
            $ctx->{"cur_file"} = "" . $gvar->{"file"};
            $ctx->{"cur_from_use"} = $gvar->{"from_use"} + 0;
            $ctx->{"current_func"} = 0;
            if (is_valid_node($gvar->{"initial_capacity"}) == 1) {
                analyze_expression($ctx, $gvar->{"initial_capacity"});
            }
            if (is_valid_node($gvar->{"init"}) == 1) {
                analyze_expression($ctx, $gvar->{"init"});
                if ($strict_types == 1 && $gvar->{"type"} == NODE_VAR_DECL() && $gvar->{"sigil"} eq "$") {
                    my int $gv_type = $gvar->{"var_type"};
                    my int $ga_type = stage0_expr_type($ctx, $gvar->{"init"});
                    if (stage0_types_compatible($gv_type, $ga_type) == 0) {
                        semantic_warn($ctx, "initializing '$" . $gvar->{"name"} . "' (declared "
                            . ast_data_type_name($gv_type) . ") with a "
                            . ast_data_type_name($ga_type) . " value", ast_get_line($gvar));
                    }
                }
            }
        }
    }

    # Validate BEGIN and END blocks
    my int $bcount = $ast->{"begin_block_count"} + 0;
    if ($bcount > 0) {
        my scalar $bblocks = $ast->{"begin_blocks"};
        for (my int $bi = 0; $bi < $bcount; $bi = $bi + 1) {
            my scalar $bblk = $bblocks->[$bi];
            $ctx->{"cur_file"} = "" . $bblk->{"file"};
            $ctx->{"cur_from_use"} = $bblk->{"from_use"} + 0;
            $ctx->{"current_func"} = 0;
            $ctx->{"cur_block_line"} = ast_get_line($bblk);
            analyze_block($ctx, $bblk);
            $ctx->{"cur_block_line"} = 0;
        }
    }
    my int $ecount = $ast->{"end_block_count"} + 0;
    if ($ecount > 0) {
        my scalar $eblocks = $ast->{"end_blocks"};
        for (my int $ei = 0; $ei < $ecount; $ei = $ei + 1) {
            my scalar $eblk = $eblocks->[$ei];
            $ctx->{"cur_file"} = "" . $eblk->{"file"};
            $ctx->{"cur_from_use"} = $eblk->{"from_use"} + 0;
            $ctx->{"current_func"} = 0;
            $ctx->{"cur_block_line"} = ast_get_line($eblk);
            analyze_block($ctx, $eblk);
            $ctx->{"cur_block_line"} = 0;
        }
    }

    # Second pass: validate each function
    my scalar $funcs = $ast->{"functions"};
    my int $count = $ast->{"function_count"};

    for (my int $i = 0; $i < $count; $i = $i + 1) {
        my scalar $fn = $funcs->[$i];

        # Skip extern functions (no body to analyze)
        if ($fn->{"is_extern"} == 1) {
            next;
        }
        $ctx->{"cur_file"} = $fn->{"file"};
        $ctx->{"cur_from_use"} = $fn->{"from_use"} + 0;
        analyze_function($ctx, $fn);
    }

    # Publish program-wide facts the codegen reads (mirrors has_overloads,
    # which the parser sets directly). uses_tie gates condition-level CSE.
    if ($ctx->{"uses_tie"} == 1) {
        $ast->{"uses_tie"} = 1;
    }

    # Report every accumulated error (capped for readability) and fail the
    # compile with a single die at the end, so one run surfaces them all.
    my scalar $sem_errs = $ctx->{"errors"};
    my int $sem_err_count = size(@{$sem_errs});
    if ($sem_err_count > 0) {
        my int $sem_show = $sem_err_count;
        if ($sem_show > 25) {
            $sem_show = 25;
        }
        my int $sem_i = 0;
        while ($sem_i < $sem_show) {
            warn($sem_errs->[$sem_i]);
            $sem_i = $sem_i + 1;
        }
        if ($sem_err_count > $sem_show) {
            warn("... and " . ($sem_err_count - $sem_show) . " more errors");
        }
        if ($sem_err_count == 1) {
            die("compilation failed: 1 semantic error");
        }
        die("compilation failed: " . $sem_err_count . " semantic errors");
    }
}
