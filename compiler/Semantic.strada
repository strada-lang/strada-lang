# Semantic.strada - Semantic analysis and validation for Strada compiler
# Performs symbol table building, type checking, and validation

# ============================================================
# Error Reporting
# ============================================================

# Both helpers report "file:line: error: msg" when the enclosing function's
# source file is known (ctx "cur_file", stamped by the parser on function
# nodes), falling back to the old "error: msg at line N" format otherwise.
#
# semantic_error ACCUMULATES into ctx "errors" and returns (analysis
# continues, so one compile reports every error); semantic_analyze prints
# them all and dies once at the end. Every error site must therefore be safe
# to fall through — an error must only suppress behavior, never leave state
# that crashes later analysis.
func semantic_error(scalar $ctx, str $msg, int $line) void {
    my str $fname = $ctx->{"cur_file"};
    my str $full = "";
    if (length($fname) > 0 && $line > 0) {
        # Append the offending source line (no caret — AST nodes carry a
        # line but no column). Errors only; warnings stay single-line.
        $full = $fname . ":" . $line . ": error: " . $msg
            . diag_snippet_from_file($fname, $line, 0);
    } elsif ($line > 0) {
        $full = "error: " . $msg . " at line " . $line;
    } else {
        $full = "error: " . $msg;
    }
    push(@{$ctx->{"errors"}}, $full);
}

func semantic_warn(scalar $ctx, str $msg, int $line) void {
    my str $fname = $ctx->{"cur_file"};
    if (length($fname) > 0 && $line > 0) {
        warn($fname . ":" . $line . ": warning: " . $msg);
        return;
    }
    if ($line > 0) {
        warn("warning: " . $msg . " at line " . $line);
    } else {
        warn("warning: " . $msg);
    }
}

# Check if a node is valid (has a type field)
# This works around the issue where != 0 doesn't work for hash references
func is_valid_node(scalar $node) int {
    my int $node_type = $node->{"type"};
    if ($node_type > 0) {
        return 1;
    }
    return 0;
}

# ============================================================
# Scope Management
# ============================================================

# Create a new scope with optional parent
func scope_new(scalar $parent) scalar {
    my hash %scope = ();
    my hash %vars = ();
    my array @var_names = ();
    $scope{"is_scope"} = 1;  # Marker to identify valid scopes
    $scope{"parent"} = $parent;
    $scope{"vars"} = \%vars;
    $scope{"var_names"} = \@var_names;
    $scope{"var_count"} = 0;
    return \%scope;
}

# Add a variable to the current scope
func scope_add_var(scalar $scope, str $name, str $sigil, int $var_type, int $line) void {
    my scalar $vars = $scope->{"vars"};
    my hash %info = ();
    $info{"sigil"} = $sigil;
    $info{"type"} = $var_type;
    $info{"line"} = $line;
    $info{"used"} = 0;
    $vars->{$name} = \%info;

    # Track variable name for iteration
    my scalar $var_names = $scope->{"var_names"};
    my int $count = $scope->{"var_count"};
    $var_names->[$count] = $name;
    $scope->{"var_count"} = $count + 1;
}

# Check if a scope is valid
func is_valid_scope(scalar $scope) int {
    my int $is_s = $scope->{"is_scope"};
    if ($is_s == 1) {
        return 1;
    }
    return 0;
}

# Look up a variable in scope chain (any sigil)
func scope_lookup_var(scalar $scope, str $name) scalar {
    my hash %result = ();
    my scalar $current = $scope;
    while (is_valid_scope($current) == 1) {
        my scalar $vars = $current->{"vars"};
        my scalar $var_info = $vars->{$name};
        if (is_valid_node($var_info) == 1) {
            $result{"found"} = 1;
            $result{"info"} = $var_info;
            return \%result;
        }
        $current = $current->{"parent"};
    }
    $result{"found"} = 0;
    return \%result;
}

# Look up a variable in scope chain matching both name AND sigil
# (`my int $x; push(@x, 1);` must report undefined `@x`, while `$_` inside a
# variadic function with `@_` skips `@_` and finds `$_` in the outer scope!)
func scope_lookup_var_sigil(scalar $scope, str $name, str $sigil) scalar {
    my hash %result = ();
    my scalar $current = $scope;
    while (is_valid_scope($current) == 1) {
        my scalar $vars = $current->{"vars"};
        my scalar $var_info = $vars->{$name};
        if (is_valid_node($var_info) == 1) {
            if ($var_info->{"sigil"} eq $sigil) {
                $result{"found"} = 1;
                $result{"info"} = $var_info;
                return \%result;
            } elsif ($var_info->{"is_global"} == 1 && $var_info->{"decls"}) {
                my scalar $decls = $var_info->{"decls"};
                my int $di = 0;
                while ($di < size(@{$decls})) {
                    my scalar $d = $decls->[$di];
                    my str $dsig = "$";
                    if ($d->{"type"} == NODE_VAR_DECL() || $d->{"type"} == NODE_OUR_DECL()) {
                        $dsig = $d->{"sigil"};
                    }
                    if ($dsig eq $sigil) {
                        $result{"found"} = 1;
                        $result{"info"} = $var_info;
                        return \%result;
                    }
                    $di = $di + 1;
                }
            }
        }
        $current = $current->{"parent"};
    }
    $result{"found"} = 0;
    return \%result;
}

# Mark a variable as used
func scope_mark_used(scalar $scope, str $name) void {
    my scalar $current = $scope;
    while (is_valid_scope($current) == 1) {
        my scalar $vars = $current->{"vars"};
        my scalar $var_info = $vars->{$name};
        if (is_valid_node($var_info) == 1) {
            $var_info->{"used"} = 1;
            return;
        }
        $current = $current->{"parent"};
    }
}

# Mark a variable with matching sigil as used
func scope_mark_used_sigil(scalar $scope, str $name, str $sigil) void {
    my scalar $current = $scope;
    while (is_valid_scope($current) == 1) {
        my scalar $vars = $current->{"vars"};
        my scalar $var_info = $vars->{$name};
        if (is_valid_node($var_info) == 1) {
            if ($var_info->{"sigil"} eq $sigil) {
                $var_info->{"used"} = 1;
                return;
            } elsif ($var_info->{"is_global"} == 1 && $var_info->{"decls"}) {
                my scalar $decls = $var_info->{"decls"};
                my int $di = 0;
                while ($di < size(@{$decls})) {
                    my scalar $d = $decls->[$di];
                    my str $dsig = "$";
                    if ($d->{"type"} == NODE_VAR_DECL() || $d->{"type"} == NODE_OUR_DECL()) {
                        $dsig = $d->{"sigil"};
                    }
                    if ($dsig eq $sigil) {
                        $var_info->{"used"} = 1;
                        return;
                    }
                    $di = $di + 1;
                }
            }
        }
        $current = $current->{"parent"};
    }
}

# Check for unused variables in scope and warn (if warnings enabled)
func scope_check_unused(scalar $ctx, scalar $scope) void {
    my int $show_warnings = $ctx->{"show_warnings"};
    if ($show_warnings == 0) {
        return;
    }
    my scalar $vars = $scope->{"vars"};
    my scalar $var_names = $scope->{"var_names"};
    my int $count = $scope->{"var_count"};
    for (my int $i = 0; $i < $count; $i = $i + 1) {
        my str $name = $var_names->[$i];
        my scalar $info = $vars->{$name};
        if ($info->{"used"} == 0) {
            semantic_warn($ctx, "unused variable '" . $info->{"sigil"} . $name . "'", $info->{"line"});
        }
    }
}

