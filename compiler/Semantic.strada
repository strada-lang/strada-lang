    $b{"sys::mkstemp"} = 1;
    $b{"sys::mkdtemp"} = 1;

    # sys:: Command execution (popen)
    $b{"sys::popen"} = 1;
    $b{"sys::pclose"} = 1;

    # sys:: Additional file system
