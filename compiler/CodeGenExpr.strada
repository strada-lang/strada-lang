                    emit($cg, "; StradaValue *__new_h = strada_hash_from_flat_array(__hfa_p); StradaValue *__old_h = ");
                    gen_expression($cg, $target);
                    emit($cg, "; ");
                    gen_expression($cg, $target);
                    emit($cg, " = __new_h; strada_decref(__old_h); __new_h; })");
