                    if ($val_type2 == NODE_VARIABLE() && $val->{"sigil"} eq "%") {
                        emit($cg, "({ StradaValue *__hfa_s = ");
                        gen_expression($cg, $val);
                        emit($cg, "; StradaValue *__new_a = strada_hash_to_flat_array(__hfa_s); ");
                        if (needs_temp_cleanup($cg, $val) == 1) {
                            emit($cg, "strada_decref(__hfa_s); ");
                        }
                        emit($cg, "StradaValue *__old_a = ");
                        gen_expression($cg, $target);
                        emit($cg, "; ");
                        gen_expression($cg, $target);
                        emit($cg, " = __new_a; strada_decref(__old_a); __new_a; })");
                    } elsif ($val_type2 == NODE_VARIABLE() || ($val_type2 == NODE_DEREF_SCALAR() && $val->{"sigil"} eq "@")) {
                        emit($cg, "({ StradaValue *__acs = ");
                        gen_expression($cg, $val);
                        emit($cg, "; StradaValue *__new_a = strada_array_copy(__acs); ");
                        if (needs_temp_cleanup($cg, $val) == 1) {
                            emit($cg, "strada_decref(__acs); ");
                        }
                        emit($cg, "StradaValue *__old_a = ");
                        gen_expression($cg, $target);
                        emit($cg, "; ");
                        gen_expression($cg, $target);
                        emit($cg, " = __new_a; strada_decref(__old_a); __new_a; })");
                    } else {
                        emit($cg, "({ StradaValue *__new_a = ");
                        if ($val_type2 == NODE_ANON_HASH()) {
                            emit($cg, "({ StradaValue *__lw = strada_new_array(); strada_array_push_take(__lw->value.av, ");
                            gen_expression($cg, $val);
                            emit($cg, "); __lw; })");
