                        emit($cg, "; strada_hash_from_flat_array(__oh_src); })");
                    } elsif ((($val_type == NODE_VARIABLE() || $val_type == NODE_DEREF_SCALAR()) && $val->{"sigil"} eq "%")
                             || $val_type == NODE_DEREF_HASH()) {
                        emit($cg, "({ StradaValue *__oh_src = ");
                        gen_expression($cg, $val);
                        emit($cg, "; StradaValue *__h = strada_hash_from_ref(__oh_src);");
                        if (needs_temp_cleanup($cg, $val) == 1) { emit($cg, " strada_decref(__oh_src);"); }
                        emit($cg, " __h; })");
