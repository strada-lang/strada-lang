            else { emit($cg, "strada_decref(__idx_tmp); "); }
        }
        if ($arr_needs_cleanup == 1) {
            if ($do_push == 1) { emit($cg, "strada_cleanup_pop_decref(__ast_arr); "); }
            else { emit($cg, "strada_decref(__ast_arr); "); }
        }
        if ($av_chain_cl == 1) { emit($cg, "strada_cleanup_drain_to(__av_mk_" . $av_uid . "); "); }
        if ($is_void == 1) {
            if ($val_needs_cleanup == 1) { emit($cg, "strada_decref(__val_tmp); "); }
            emit($cg, "})");
        } else {
            emit($cg, "__val_tmp; })");
        }
    } else {
        if ($cg->{"uses_tie"} == 1) {
            emit($cg, "strada_av_store_sv(");
            gen_assign_container($cg, $arr_expr, 2);
            emit($cg, ", strada_to_int(");
            gen_expression($cg, $idx_expr);
            emit($cg, "), ");
            gen_expression($cg, $val_expr);
            emit($cg, ")");
        } else {
            emit($cg, "strada_array_set(strada_deref_array(");
            gen_assign_container($cg, $arr_expr, 2);
            emit($cg, "), strada_to_int(");
            gen_expression($cg, $idx_expr);
            emit($cg, "), ");
            gen_expression($cg, $val_expr);
            emit($cg, ")");
        }
    }
    return;
}

func gen_assign_deref_array(scalar $cg, scalar $expr, scalar $target) void {
    my int $is_void = 0;
    if (($expr->{"is_void_stmt"} + 0) == 1) { $is_void = 1; }
    my scalar $idx_expr = $target->{"index"};
    my scalar $val_expr = $expr->{"value"};
    my scalar $ref_expr = $target->{"ref"};
    my int $idx_needs_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $idx_expr) == 1;
    my int $val_needs_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $val_expr) == 1;
    my int $ref_needs_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $ref_expr) == 1;
    if (autoviv_link_type($ref_expr) == 1) {
        $ref_needs_cleanup = 0;
    }
    my int $av_chain_cl = autoviv_chain_needs_cleanup($cg, $ref_expr);
    my int $do_push = cleanup_push_useful($cg);

    if ($is_void == 0 || $idx_needs_cleanup == 1 || $val_needs_cleanup == 1 || $ref_needs_cleanup == 1 || $av_chain_cl == 1) {
        my int $av_uid = 0;
        if ($av_chain_cl == 1) {
            $av_uid = $cg->{"tmp_counter"} + 0;
            $cg->{"tmp_counter"} = $av_uid + 1;
        }
        emit($cg, "({ ");
        if ($av_chain_cl == 1) {
            emit($cg, "int __av_mk_" . $av_uid . " = strada_cleanup_mark(); ");
        }
        emit($cg, "StradaValue *__ast_ref = ");
        gen_assign_container_marked($cg, $ref_expr, 2, $av_chain_cl);
        emit($cg, "; ");
        if ($do_push == 1 && $ref_needs_cleanup == 1) {
            emit($cg, "strada_cleanup_push(__ast_ref); ");
        }
        if ($idx_needs_cleanup == 1) {
            emit($cg, "StradaValue *__idx_tmp = ");
            gen_expression($cg, $idx_expr);
            emit($cg, "; ");
            if ($do_push == 1) { emit($cg, "strada_cleanup_push(__idx_tmp); "); }
        }
        my int $v_owned = 0;
        if ($is_void == 0 || $val_needs_cleanup == 1) {
            $v_owned = 1;
            emit($cg, "StradaValue *__val_tmp = ");
            gen_expression($cg, $val_expr);
            emit($cg, "; ");
            if ($is_void == 0 && $val_needs_cleanup == 0) {
                emit($cg, "__val_tmp = strada_copy_scalar_il(__val_tmp); ");
            }
            if ($do_push == 1) { emit($cg, "strada_cleanup_push(__val_tmp); "); }
        }
        emit($cg, "int64_t __idx_i = strada_to_int(");
        if ($idx_needs_cleanup == 1) { emit($cg, "__idx_tmp"); } else { gen_expression($cg, $idx_expr); }
        emit($cg, "); ");
        if ($cg->{"uses_tie"} == 1) {
            emit($cg, "strada_av_store_sv(__ast_ref, __idx_i, ");
        } else {
            emit($cg, "strada_array_set(strada_deref_array(__ast_ref), __idx_i, ");
        }
        if ($v_owned == 1) { emit($cg, "__val_tmp"); } else { gen_expression($cg, $val_expr); }
        emit($cg, "); ");
        if ($do_push == 1 && $v_owned == 1) { emit($cg, "strada_cleanup_pop(); "); }
        if ($idx_needs_cleanup == 1) {
            if ($do_push == 1) { emit($cg, "strada_cleanup_pop_decref(__idx_tmp); "); }
            else { emit($cg, "strada_decref(__idx_tmp); "); }
        }
        if ($ref_needs_cleanup == 1) {
            if ($do_push == 1) { emit($cg, "strada_cleanup_pop_decref(__ast_ref); "); }
            else { emit($cg, "strada_decref(__ast_ref); "); }
        }
        if ($av_chain_cl == 1) { emit($cg, "strada_cleanup_drain_to(__av_mk_" . $av_uid . "); "); }
        if ($is_void == 1) {
            if ($val_needs_cleanup == 1) { emit($cg, "strada_decref(__val_tmp); "); }
            emit($cg, "})");
        } else {
            emit($cg, "__val_tmp; })");
        }
    } else {
        if ($cg->{"uses_tie"} == 1) {
            emit($cg, "strada_av_store_sv(");
            gen_assign_container($cg, $ref_expr, 2);
            emit($cg, ", strada_to_int(");
            gen_expression($cg, $idx_expr);
            emit($cg, "), ");
            gen_expression($cg, $val_expr);
            emit($cg, ")");
        } else {
            emit($cg, "strada_array_set(strada_deref_array(");
            gen_assign_container($cg, $ref_expr, 2);
            emit($cg, "), strada_to_int(");
            gen_expression($cg, $idx_expr);
            emit($cg, "), ");
            gen_expression($cg, $val_expr);
            emit($cg, ")");
        }
    }
    return;
}

func gen_assign_array_slice(scalar $cg, scalar $expr, scalar $target) void {
    my int $type = $expr->{"type"};
    my int $in_extern = $cg->{"in_extern"};
    my int $target_type = $target->{"type"};
                my scalar $sl_src = $target->{"source"};
                my scalar $sl_items = $target->{"items"};
                my int $sl_ic = $target->{"item_count"};
                my scalar $sl_val = $expr->{"value"};
                # Peel one DEREF_SCALAR so @{$ref}[...] resolves to $ref.
                my scalar $sl_se = $sl_src;
                if ($sl_src->{"type"} == NODE_DEREF_SCALAR()) {
                    $sl_se = $sl_src->{"ref"};
                }
                my int $sl_src_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $sl_se) == 1;
                my int $sl_rhs_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $sl_val) == 1;
                emit($cg, "({ StradaValue *__sas_rhs = ");
                gen_expression($cg, $sl_val);
                emit($cg, "; StradaArray *__sas_rav = strada_deref_array(__sas_rhs); ");
                # A scalar RHS (e.g. `@a[0,1] = $x`, or `(99)` which strada
                # parses as a plain scalar) is a 1-element list in Perl — wrap
                # it so element 0 lands and the rest fill with undef.
                emit($cg, "StradaValue *__sas_rhs1 = NULL; if (!__sas_rav && __sas_rhs) { __sas_rhs1 = strada_new_array(); StradaArray *__sas_one = strada_deref_array(__sas_rhs1); strada_incref(__sas_rhs); strada_array_push_take(__sas_one, __sas_rhs); __sas_rav = __sas_one; } ");
                if ($sl_src_cl == 1) {
                    emit($cg, "StradaValue *__sas_src = ");
                    gen_expression($cg, $sl_se);
                    emit($cg, "; StradaArray *__sas_tav = strada_deref_array(__sas_src); ");
                } else {
                    emit($cg, "StradaArray *__sas_tav = strada_deref_array(");
                    gen_expression($cg, $sl_se);
                    emit($cg, "); ");
                }
                emit($cg, "int64_t __sas_j = 0; ");
                for (my int $si = 0; $si < $sl_ic; $si = $si + 1) {
                    my scalar $sl_item = $sl_items->[$si];
                    if ($sl_item->{"type"} == NODE_RANGE()) {
                        emit($cg, "for (int64_t __sl_i = ");
                        emit_int_operand($cg, $sl_item->{"start"});
                        emit($cg, "; __sl_i <= ");
                        emit_int_operand($cg, $sl_item->{"end"});
                        emit($cg, "; __sl_i++) { strada_array_set(__sas_tav, __sl_i, (__sas_rav && __sas_j < (int64_t)__sas_rav->size) ? strada_array_get(__sas_rav, __sas_j) : strada_undef_static()); __sas_j++; } ");
                    } else {
                        emit($cg, "strada_array_set(__sas_tav, ");
                        emit_int_operand($cg, $sl_item);
                        emit($cg, ", (__sas_rav && __sas_j < (int64_t)__sas_rav->size) ? strada_array_get(__sas_rav, __sas_j) : strada_undef_static()); __sas_j++; ");
                    }
                }
                if ($sl_src_cl == 1) {
                    emit($cg, "strada_decref(__sas_src); ");
                }
                emit($cg, "if (__sas_rhs1) strada_decref(__sas_rhs1); ");
                if ($sl_rhs_cl == 1) {
                    emit($cg, "strada_decref(__sas_rhs); ");
                }
                if (($expr->{"is_void_stmt"} + 0) == 1) {
                    emit($cg, "(StradaValue*)NULL; })");
                } else {
                    emit($cg, "strada_new_int(__sas_j); })");
                }
                return;
}

func gen_assign_hash_slice(scalar $cg, scalar $expr, scalar $target) void {
    my int $type = $expr->{"type"};
    my int $in_extern = $cg->{"in_extern"};
    my int $target_type = $target->{"type"};
                my scalar $hl_src = $target->{"source"};
                my scalar $hl_items = $target->{"items"};
                my int $hl_ic = $target->{"item_count"};
                my scalar $hl_val = $expr->{"value"};
                my scalar $hl_se = $hl_src;
                if ($hl_src->{"type"} == NODE_DEREF_SCALAR()) {
                    $hl_se = $hl_src->{"ref"};
                }
                my int $do_push = cleanup_push_useful($cg);
                my int $hl_src_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $hl_se) == 1;
                my int $hl_rhs_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $hl_val) == 1;
                emit($cg, "({ StradaValue *__shs_rhs = ");
                gen_expression($cg, $hl_val);
                emit($cg, "; ");
                if ($do_push == 1 && $hl_rhs_cl == 1) { emit($cg, "strada_cleanup_push(__shs_rhs); "); }
                emit($cg, "StradaArray *__shs_rav = strada_deref_array(__shs_rhs); ");
                emit($cg, "StradaValue *__shs_rhs1 = NULL; if (!__shs_rav && __shs_rhs) { __shs_rhs1 = strada_new_array(); StradaArray *__shs_one = strada_deref_array(__shs_rhs1); strada_incref(__shs_rhs); strada_array_push_take(__shs_one, __shs_rhs); __shs_rav = __shs_one; } ");
                if ($do_push == 1) { emit($cg, "if (__shs_rhs1) strada_cleanup_push(__shs_rhs1); "); }
                emit($cg, "StradaValue *__shs_src = ");
                gen_expression($cg, $hl_se);
                emit($cg, "; ");
                if ($do_push == 1 && $hl_src_cl == 1) { emit($cg, "strada_cleanup_push(__shs_src); "); }
                emit($cg, "int64_t __shs_j = 0; ");
                for (my int $hi = 0; $hi < $hl_ic; $hi = $hi + 1) {
                    my scalar $hl_item = $hl_items->[$hi];
                    if ($hl_item->{"type"} == NODE_STR_LITERAL() && str_has_nul($hl_item->{"value"}) == 0) {
                        emit($cg, "strada_hv_store(__shs_src, ");
                        gen_str_literal_c($cg, $hl_item->{"value"});
                        emit($cg, ", (__shs_rav && __shs_j < (int64_t)__shs_rav->size) ? strada_array_get(__shs_rav, __shs_j) : strada_undef_static()); __shs_j++; ");
                    } else {
                        my int $hl_k_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $hl_item) == 1;
                        emit($cg, "{ StradaValue *__shs_k = ");
                        gen_expression($cg, $hl_item);
                        emit($cg, "; ");
                        if ($do_push == 1 && $hl_k_cl == 1) { emit($cg, "strada_cleanup_push(__shs_k); "); }
                        emit($cg, "strada_hv_store_sv(__shs_src, __shs_k, (__shs_rav && __shs_j < (int64_t)__shs_rav->size) ? strada_array_get(__shs_rav, __shs_j) : strada_undef_static()); __shs_j++; ");
                        if ($hl_k_cl == 1) {
                            if ($do_push == 1) { emit($cg, "strada_cleanup_pop_decref(__shs_k); "); }
                            else { emit($cg, "strada_decref(__shs_k); "); }
                        }
                        emit($cg, "} ");
                    }
                }
                if ($do_push == 1) {
                    if ($hl_src_cl == 1) { emit($cg, "strada_cleanup_pop_decref(__shs_src); "); }
                    emit($cg, "if (__shs_rhs1) { strada_cleanup_pop(); strada_decref(__shs_rhs1); } ");
                    if ($hl_rhs_cl == 1) { emit($cg, "strada_cleanup_pop_decref(__shs_rhs); "); }
                } else {
                    if ($hl_src_cl == 1) { emit($cg, "strada_decref(__shs_src); "); }
                    emit($cg, "if (__shs_rhs1) strada_decref(__shs_rhs1); ");
                    if ($hl_rhs_cl == 1) { emit($cg, "strada_decref(__shs_rhs); "); }
                }
                if (($expr->{"is_void_stmt"} + 0) == 1) {
                    emit($cg, "(StradaValue*)NULL; })");
                } else {
                    emit($cg, "strada_new_int(__shs_j); })");
                }
                return;
}

# True when an anonymous hash literal has at least one computed key or NUL-byte key.
func anon_hash_has_expr_keys(scalar $node) int {
    my scalar $kx = $node->{"key_exprs"};
    my scalar $ks = $node->{"keys"};
    my int $n = $node->{"pair_count"};
    my int $i = 0;
    while ($i < $n) {
        if ($kx && $kx->[$i]) { return 1; }
        if ($ks && str_has_nul($ks->[$i]) == 1) { return 1; }
        $i = $i + 1;
    }
    return 0;
}

func gen_assign_deref_scalar(scalar $cg, scalar $expr, scalar $target) void {
    my int $is_void = 0;
    if (($expr->{"is_void_stmt"} + 0) == 1) { $is_void = 1; }
    my int $do_push = cleanup_push_useful($cg);
    my str $dsig = "" . $target->{"sigil"};
    if ($dsig eq "%" || $dsig eq "@") {
        my scalar $dc_rhs = $expr->{"value"};
        my int $dc_ref_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $target->{"ref"}) == 1;
        my int $dc_val_cl = 0;
        if ($dc_rhs->{"type"} == NODE_ANON_HASH() && ($dc_rhs->{"pair_count"} + 0) == 0) {
            $dc_val_cl = 1;
        } elsif ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $dc_rhs) == 1) {
            $dc_val_cl = 1;
        }
        emit($cg, "({ StradaValue *__dc_ref = ");
        gen_expression($cg, $target->{"ref"});
        emit($cg, "; ");
        if ($do_push == 1 && $dc_ref_cl == 1) { emit($cg, "strada_cleanup_push(__dc_ref); "); }
        emit($cg, "StradaValue *__dc_val = ");
        if ($dc_rhs->{"type"} == NODE_ANON_HASH() && ($dc_rhs->{"pair_count"} + 0) == 0) {
            if ($dsig eq "@") {
                emit($cg, "strada_new_array()");
            } else {
                emit($cg, "strada_new_hash()");
            }
        } else {
            gen_expression($cg, $dc_rhs);
        }
        emit($cg, "; ");
        if ($do_push == 1 && $dc_val_cl == 1) { emit($cg, "strada_cleanup_push(__dc_val); "); }
        emit($cg, "StradaValue *__dc_res = strada_deref_assign_container(__dc_ref, __dc_val, '" . $dsig . "'); ");
        if ($is_void == 0) {
            emit($cg, "strada_incref(__dc_res); ");
        }
        if ($dc_val_cl == 1) {
            if ($do_push == 1) { emit($cg, "strada_cleanup_pop_decref(__dc_val); "); }
            else { emit($cg, "strada_decref(__dc_val); "); }
        }
        if ($dc_ref_cl == 1) {
            if ($do_push == 1) { emit($cg, "strada_cleanup_pop_decref(__dc_ref); "); }
            else { emit($cg, "strada_decref(__dc_ref); "); }
        }
        emit($cg, "__dc_res; })");
        return;
    }
    my int $ref_needs_cleanup = 0;
    my int $val_needs_cleanup = 0;
    if ($cg->{"cleanup_enabled"} == 1) {
        $ref_needs_cleanup = needs_temp_cleanup($cg, $target->{"ref"});
        $val_needs_cleanup = needs_temp_cleanup($cg, $expr->{"value"});
    }
    if ($is_void == 0 || $ref_needs_cleanup == 1 || $val_needs_cleanup == 1) {
        emit($cg, "({ ");
        if ($ref_needs_cleanup == 1) {
            emit($cg, "StradaValue *__ds_ref = ");
            gen_expression($cg, $target->{"ref"});
            emit($cg, "; ");
            if ($do_push == 1) { emit($cg, "strada_cleanup_push(__ds_ref); "); }
        }
        if ($val_needs_cleanup == 1) {
            emit($cg, "StradaValue *__ds_val = ");
            gen_expression($cg, $expr->{"value"});
            emit($cg, "; ");
            if ($do_push == 1) { emit($cg, "strada_cleanup_push(__ds_val); "); }
        }
        if ($is_void == 0) {
            emit($cg, "StradaValue *__ds_res = ");
        }
        emit($cg, "strada_deref_set(");
        if ($ref_needs_cleanup == 1) { emit($cg, "__ds_ref"); } else { gen_expression($cg, $target->{"ref"}); }
        emit($cg, ", ");
        if ($val_needs_cleanup == 1) { emit($cg, "__ds_val"); } else { gen_expression($cg, $expr->{"value"}); }
        emit($cg, "); ");
        if ($is_void == 0) {
            emit($cg, "strada_incref(__ds_res); ");
        }
        if ($val_needs_cleanup == 1) {
            if ($do_push == 1) { emit($cg, "strada_cleanup_pop_decref(__ds_val); "); }
            else { emit($cg, "strada_decref(__ds_val); "); }
        }
        if ($ref_needs_cleanup == 1) {
            if ($do_push == 1) { emit($cg, "strada_cleanup_pop_decref(__ds_ref); "); }
            else { emit($cg, "strada_decref(__ds_ref); "); }
        }
        if ($is_void == 0) {
            emit($cg, "__ds_res; })");
        } else {
            emit($cg, "})");
        }
    } else {
        emit($cg, "strada_deref_set(");
        gen_expression($cg, $target->{"ref"});
        emit($cg, ", ");
        gen_expression($cg, $expr->{"value"});
        emit($cg, ")");
    }
    return;
}

func gen_assign_node(scalar $cg, scalar $expr) void {
    my int $type = $expr->{"type"};
    my int $in_extern = $cg->{"in_extern"};
    my int $is_void = 0;
    if (($expr->{"is_void_stmt"} + 0) == 1) { $is_void = 1; }
        my str $op = $expr->{"op"};
        my scalar $target = $expr->{"target"};
        my int $target_type = $target->{"type"};

        if ($target_type == NODE_VARIABLE()) {
            my scalar $kt_a = $cg->{"known_types"};
            if ($kt_a) { $kt_a->{escape_c_keyword($target->{"name"})} = ""; }
            if ($op eq "=") {
                my scalar $sv_map = $cg->{"struct_vars"};
                if ($sv_map) {
                    my str $new_st_name = "";
                    if ($expr->{"value"}->{"type"} == NODE_CALL()) {
                        my scalar $st_fi = resolve_callee_func_info($cg, "" . $expr->{"value"}->{"name"});
                        if ($st_fi) { $new_st_name = "" . $st_fi->{"return_struct_name"}; }
                    } elsif ($expr->{"value"}->{"type"} == NODE_VARIABLE()) {
                        $new_st_name = "" . $sv_map->{escape_c_keyword($expr->{"value"}->{"name"})};
                    }
                    if (length($new_st_name) > 0) {
                        $sv_map->{escape_c_keyword($target->{"name"})} = $new_st_name;
                    }
                }
            }
        }

        if ($target_type == NODE_FIELD_ACCESS()) {
            my scalar $sf_info = resolve_struct_field($cg, $target->{"object"}, $target->{"field"});
            if ($sf_info != 0) {
                my int $sf_type = $sf_info->{"type"} + 0;
                my int $sf_off = $sf_info->{"offset"} + 0;
                my int $sf_sz = $sf_info->{"size"} + 0;
                my str $sf_name = $sf_info->{"name"};
                my scalar $sf_obj = $target->{"object"};
                my scalar $sf_rhs = $expr->{"value"};
                my int $sf_obj_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $sf_obj) == 1;
                my int $sf_rhs_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $sf_rhs) == 1;
                emit($cg, "({ StradaValue *__csf_o = ");
                gen_expression($cg, $sf_obj);
                emit($cg, "; ");
                if ($sf_type == TYPE_STR()) {
                    my int $sf_max = $sf_sz - 1;
                    if ($sf_max < 0) { $sf_max = 0; }
                    emit($cg, "StradaValue *__csf_r = ");
                    gen_expression($cg, $sf_rhs);
                    emit($cg, "; void *__csf_p = strada_cstruct_ptr(__csf_o); if (__csf_p) { ");
                    if ($op eq ".=") {
                        emit($cg, "char *__csf_rs = strada_to_str(__csf_r); char *__csf_dst = (char*)__csf_p + " . $sf_off . "; size_t __csf_cur = strnlen(__csf_dst, " . $sf_max . "); size_t __csf_rl = __csf_rs ? strlen(__csf_rs) : 0; size_t __csf_rem = (" . $sf_max . " > __csf_cur) ? (" . $sf_max . " - __csf_cur) : 0; if (__csf_rl > __csf_rem) __csf_rl = __csf_rem; if (__csf_rs && __csf_rl > 0) memcpy(__csf_dst + __csf_cur, __csf_rs, __csf_rl); __csf_dst[__csf_cur + __csf_rl] = '\\0'; free(__csf_rs); ");
                    } else {
                        emit($cg, "char *__csf_rs = strada_to_str(__csf_r); char *__csf_dst = (char*)__csf_p + " . $sf_off . "; size_t __csf_rl = __csf_rs ? strlen(__csf_rs) : 0; if (__csf_rl > " . $sf_max . ") __csf_rl = " . $sf_max . "; if (__csf_rs && __csf_rl > 0) memcpy(__csf_dst, __csf_rs, __csf_rl); __csf_dst[__csf_rl] = '\\0'; free(__csf_rs); ");
                    }
                    emit($cg, "} ");
                    if ($sf_rhs_cl == 1) { emit($cg, "strada_decref(__csf_r); "); }
                    if ($sf_obj_cl == 1) { emit($cg, "strada_decref(__csf_o); "); }
                    emit($cg, "strada_undef_static(); })");
                } elsif ($sf_type == TYPE_NUM()) {
                    emit($cg, "double __csf_d = ");
                    if ($op eq "=") {
                        emit_num_operand($cg, $sf_rhs);
                    } elsif ($op eq "+=") {
