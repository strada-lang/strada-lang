                my str $our_ca_name = escape_c_keyword($target->{"name"});
                my scalar $our_ca_vars = $cg->{"our_vars"};
                my str $our_ca_key = "" . $our_ca_vars->{$our_ca_name};
                if (length($our_ca_key) > 0) {
                    my int $our_rhs_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $expr->{"value"}) == 1;
                    if ($op eq "&&=" || $op eq "||=" || $op eq "//=") {
                        my str $our_sc = "strada_to_bool(__our_old)";
                        if ($op eq "&&=") { $our_sc = "!strada_to_bool(__our_old)"; }
                        elsif ($op eq "//=") { $our_sc = "strada_defined_bool(__our_old)"; }
                        emit($cg, "({ StradaValue *__our_old = strada_global_get_cstr(" . c_str_lit($our_ca_key) . "); ");
                        emit($cg, "StradaValue *__our_new; if (" . $our_sc . ") { __our_new = __our_old; ");
                        if ($is_void == 1) { emit($cg, "strada_decref(__our_new); __our_new = NULL; "); }
