                return;
            }

            # Perl-style scalar context: $n = @arr gives array count
            my scalar $sc_rhs = $expr->{"value"};
            if ($target_type == NODE_VARIABLE() && $target->{"sigil"} ne "@" && $target->{"sigil"} ne "%" &&
                $sc_rhs->{"type"} == NODE_VARIABLE() && $sc_rhs->{"sigil"} eq "@") {
                my int $sc_rhs_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $sc_rhs) == 1;
                my str $sc_our = "" . $cg->{"our_vars"}->{escape_c_keyword($target->{"name"})};
                emit($cg, "({ StradaValue *__sc_a = ");
                gen_expression($cg, $sc_rhs);
                emit($cg, "; int64_t __sc_n = (int64_t)strada_size(__sc_a); ");
                if ($sc_rhs_cl == 1) { emit($cg, "strada_decref(__sc_a); "); }
                if (length($sc_our) > 0) {
                    emit($cg, "StradaValue *__sc_v = strada_new_int_il(__sc_n); ");
                    if ($is_void == 0) { emit($cg, "strada_incref(__sc_v); "); }
                    emit($cg, "strada_global_set_cstr(" . c_str_lit($sc_our) . ", __sc_v); ");
                    if ($is_void == 0) { emit($cg, "__sc_v; })"); } else { emit($cg, "(StradaValue*)NULL; })"); }
                } elsif ($cg->{"cleanup_enabled"} == 1) {
