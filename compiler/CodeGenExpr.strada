                    emit($cg, "; ");
                    gen_expression($cg, $target);
                    emit($cg, " = STRADA_MAKE_TAGGED_INT(__sc_n); strada_decref(__old); ");
                    gen_expression($cg, $target);
                    emit($cg, "; })");
                } else {
                    gen_expression($cg, $target);
                    emit($cg, " = STRADA_MAKE_TAGGED_INT(__sc_n); ");
                    gen_expression($cg, $target);
                    emit($cg, "; })");
