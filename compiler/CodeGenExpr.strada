                    gen_expression($cg, $meth_target);
                    emit($cg, "; StradaValue *__iar = strada_hv_fetch_owned_ph(__iao, " . c_str_lit($method) . ", " . $self_acc_hash . "u); strada_decref(__iao); __iar; })");
                } else {
