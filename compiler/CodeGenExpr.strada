            if ($is_prefix == 1) {
                # Prefix returns our owned ref on __ih_new and releases __ih_old.
                emit($cg, "strada_decref(__ih_old); __ih_new; })");
            } else {
                # Postfix returns __ih_old and releases our ref on __ih_new.
                emit($cg, "strada_decref(__ih_new); __ih_old; })");
            }
        } elsif ($operand_type == NODE_DEREF_SCALAR()) {
            my int $id_ref_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $operand->{"ref"}) == 1;
            my int $id_push = cleanup_push_useful($cg);
            my str $delta = "1";
            if ($op eq "--") { $delta = "-1"; }
            emit($cg, "({ StradaValue *__id_r = ");
            gen_expression($cg, $operand->{"ref"});
            emit($cg, "; ");
            if ($id_push == 1 && $id_ref_cl == 1) { emit($cg, "strada_cleanup_push(__id_r); "); }
            emit($cg, "StradaValue *__id_old = strada_deref(__id_r); ");
            if ($id_push == 1) { emit($cg, "strada_cleanup_push(__id_old); "); }
            emit($cg, "StradaValue *__id_new = strada_inc_value(__id_old, " . $delta . "); ");
            if ($id_push == 1) { emit($cg, "strada_cleanup_push(__id_new); "); }
            emit($cg, "strada_deref_set(__id_r, __id_new); ");
            if ($id_push == 1) { emit($cg, "strada_cleanup_pop(); strada_cleanup_pop(); "); }
            if ($id_ref_cl == 1) {
                if ($id_push == 1) { emit($cg, "strada_cleanup_pop_decref(__id_r); "); }
                else { emit($cg, "strada_decref(__id_r); "); }
            }
            if ($is_prefix == 1) {
                emit($cg, "strada_decref(__id_old); __id_new; })");
            } else {
                emit($cg, "strada_decref(__id_new); __id_old; })");
            }
        } elsif ($operand_type == NODE_FIELD_ACCESS()) {
            my scalar $inc_sf = resolve_struct_field($cg, $operand->{"object"}, $operand->{"field"});
            if ($inc_sf != 0) {
                my int $isf_type = $inc_sf->{"type"} + 0;
                my int $isf_off = $inc_sf->{"offset"} + 0;
                my str $isf_name = $inc_sf->{"name"};
                my scalar $isf_obj = $operand->{"object"};
                my int $isf_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $isf_obj) == 1;
                my str $delta = "1";
                if ($op eq "--") { $delta = "-1"; }
                emit($cg, "({ StradaValue *__isf_o = ");
                gen_expression($cg, $isf_obj);
                if ($isf_type == TYPE_NUM()) {
                    emit($cg, "; double __isf_old = strada_cstruct_get_double(__isf_o, " . c_str_lit($isf_name) . ", " . $isf_off . "); double __isf_new = __isf_old + " . $delta . ".0; strada_cstruct_set_double(__isf_o, " . c_str_lit($isf_name) . ", " . $isf_off . ", __isf_new); ");
                    if ($isf_cl == 1) { emit($cg, "strada_decref(__isf_o); "); }
                    if ($is_prefix == 1) { emit($cg, "strada_new_num(__isf_new); })"); }
                    else { emit($cg, "strada_new_num(__isf_old); })"); }
                } else {
                    emit($cg, "; int64_t __isf_old = strada_cstruct_get_int(__isf_o, " . c_str_lit($isf_name) . ", " . $isf_off . "); int64_t __isf_new = __isf_old + " . $delta . "; strada_cstruct_set_int(__isf_o, " . c_str_lit($isf_name) . ", " . $isf_off . ", __isf_new); ");
                    if ($isf_cl == 1) { emit($cg, "strada_decref(__isf_o); "); }
                    if ($is_prefix == 1) { emit($cg, "strada_new_int_il(__isf_new); })"); }
                    else { emit($cg, "strada_new_int_il(__isf_old); })"); }
                }
            } else {
                emit($cg, "strada_new_undef()");
            }
        } else {
            # For complex expressions, fall back to inline increment
            # This works for statement context but returns wrong value for postfix
            emit($cg, "(");
            gen_expression($cg, $operand);
            emit($cg, " = strada_new_num(strada_to_num(");
            gen_expression($cg, $operand);
            if ($op eq "++") {
                emit($cg, ") + 1))");
            } else {
                emit($cg, ") - 1))");
            }
        }
        return;
    }

    # Function call
    if ($type == NODE_CALL()) {
        my str $name = $expr->{"name"};

        # Warn if user wrote sys:: directly (deprecated, use core:: instead)
        if (length($name) > 5 && substr($name, 0, 5) eq "sys::") {
            my str $core_name = "core::" . substr($name, 5, length($name) - 5);
            warn("Warning: sys:: is deprecated, use " . $core_name . " instead\n");
        }

        # Normalize core:: to sys:: (core:: is a preferred alias)
        if (length($name) > 6 && substr($name, 0, 6) eq "core::") {
            $name = "sys::" . substr($name, 6, length($name) - 6);
            $expr->{"name"} = $name;
        }

        # Handle constant references (e.g., enum values like Color::RED)
        if ($expr->{"is_constant"} == 1) {
            emit($cg, "strada_new_int(" . sanitize_name($name) . ")");
            return;
        }

        # Fallback qw(...) import resolution (e.g., inside Eval/JIT/BEGIN paths)
        if (index($name, "::") < 0 && defined($cg->{"qw_imports"})) {
            my str $qpkg_c = "" . $cg->{"current_fn_package"};
            if (length($qpkg_c) == 0) { $qpkg_c = "main"; }
            my str $qtarget_c = "" . $cg->{"qw_imports"}->{$qpkg_c . "::" . $name};
            if (length($qtarget_c) > 0) {
                $name = $qtarget_c;
                $expr->{"name"} = $qtarget_c;
            }
        }

        # Built-in functions
        if (gen_builtin_g1($cg, $expr, $name) == 1) { return; }
        if (gen_builtin_g2($cg, $expr, $name) == 1) { return; }
        if (gen_builtin_g3($cg, $expr, $name) == 1) { return; }
        if (gen_builtin_g4($cg, $expr, $name) == 1) { return; }
        if (gen_builtin_g5($cg, $expr, $name) == 1) { return; }
        if (gen_builtin_g6($cg, $expr, $name) == 1) { return; }
        if (gen_builtin_g7($cg, $expr, $name) == 1) { return; }
        if (gen_builtin_g8($cg, $expr, $name) == 1) { return; }
        gen_user_call($cg, $expr, $name);
        return;
    }

    # Assignment
    if ($type == NODE_ASSIGN()) { gen_assign_node($cg, $expr); return; }

    # Array subscript - use strada_deref_array to handle both direct arrays and refs
    if ($type == NODE_SUBSCRIPT()) {
        my scalar $arr_expr = $expr->{"array"};

        # Autovivification: intermediate subscript in an assignment-target
        # chain ($aoa[0][1] = v, $a[0]{"k"} = v). Flag values: 1 = the
        # parent accessor needs a HASH in this element, 2 = an ARRAY.
        # strada_autoviv_elem_* return a BORROWED ref (owned by the array).
        if ($cg->{"autoviv"} >= 1) {
            my int $sub_av = $cg->{"autoviv"};
            $cg->{"autoviv"} = 0;
            my str $sub_av_fn = "strada_autoviv_elem_hash";
            if ($sub_av == 2) {
                $sub_av_fn = "strada_autoviv_elem_array";
            }
            my int $sub_prop = 0;
            if (autoviv_link_type($arr_expr) == 1) { $sub_prop = 2; }
            emit_autoviv_step($cg, $sub_av_fn, $arr_expr, $sub_prop, $expr->{"index"}, 2);
            return;
        }

        my int $arr_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $arr_expr) == 1;
        if ($cg->{"uses_tie"} == 1) {
            if ($arr_cleanup == 1) {
                emit($cg, "({ StradaValue *__sub_arr = ");
                gen_expression($cg, $arr_expr);
                emit($cg, "; StradaValue *__sub_el = strada_av_fetch_sv(__sub_arr, ");
                emit_int_operand($cg, $expr->{"index"});
                emit($cg, "); strada_decref(__sub_arr); __sub_el; })");
            } else {
                emit($cg, "strada_av_fetch_sv(");
                gen_expression($cg, $arr_expr);
                emit($cg, ", ");
                emit_int_operand($cg, $expr->{"index"});
                emit($cg, ")");
            }
            return;
        }
        if ($arr_cleanup == 1) {
            emit($cg, "({ StradaValue *__sub_arr = ");
            gen_expression($cg, $arr_expr);
            emit($cg, "; StradaValue *__sub_el = strada_array_get_owned(strada_deref_array(__sub_arr), ");
            emit_int_operand($cg, $expr->{"index"});
            emit($cg, "); strada_decref(__sub_arr); __sub_el; })");
        } else {
            emit($cg, "strada_array_get(strada_deref_array(");
            gen_expression($cg, $arr_expr);
            emit($cg, "), ");
            emit_int_operand($cg, $expr->{"index"});
            emit($cg, ")");
        }
        return;
    }
    
    # Hash access - use strada_hv_fetch_owned to return owned ref (fixes tied hash leak)
    if ($type == NODE_HASH_ACCESS()) {
        # CSE: this fetch was hoisted into a condition-level temp — emit
        # the temp name instead of re-probing (see emit_condition_cse).
        my str $cse_tmp = "" . $expr->{"cse_temp"};
        if (length($cse_tmp) > 0) {
            emit($cg, $cse_tmp);
            return;
        }

        my scalar $key_expr = $expr->{"key"};
        my int $key_is_literal = 0;
        if ($key_expr->{"type"} == NODE_STR_LITERAL() && str_has_nul($key_expr->{"value"}) == 0) {
            $key_is_literal = 1;
        }

        # Autovivification: when this hash access is an intermediate in an
        # assignment target chain ($h{"a"}{"b"} = val), use autoviv to
        # auto-create missing intermediate containers. Flag values:
        # 1 = the parent accessor needs a HASH here, 2 = needs an ARRAY
        # ($h{"a"}[0] = val). Both runtime fns return a BORROWED ref.
        my int $autoviv = $cg->{"autoviv"};
        if ($autoviv >= 1) {
            $cg->{"autoviv"} = 0;
            my str $av_fn = "strada_autoviv_hash";
            if ($autoviv == 2) {
                $av_fn = "strada_autoviv_array";
            }
            my scalar $hash_sub = $expr->{"hash"};
            my int $av_prop = 0;
            if (autoviv_link_type($hash_sub) == 1) { $av_prop = 1; }
            my int $av_kind = 1;
            if ($key_is_literal == 1) { $av_kind = 0; }
            emit_autoviv_step($cg, $av_fn, $hash_sub, $av_prop, $key_expr, $av_kind);
            return;
        }

        # Check if hash sub-expression returns an owned ref (needs cleanup)
        my scalar $hash_expr = $expr->{"hash"};
        my int $hash_needs_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $hash_expr) == 1;

        if ($key_is_literal == 1) {
            # Literal key: pre-hashed fetch (compile-time djb2, ASCII keys) so the
            # constant key isn't re-hashed on every access.
            emit_hash_fetch_literal($cg, $hash_expr, $key_expr->{"value"}, $hash_needs_cleanup);
        } elsif (is_concat_str_literal_left($key_expr) == 1) {
            # Concat key "prefix" . $expr - use stack-buffer concat (zero allocs)
            my scalar $concat_right = $key_expr->{"right"};
            my int $right_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $concat_right) == 1;
            my str $prefix_val = $key_expr->{"left"}->{"value"};
            my int $prefix_len = bytes($prefix_val);
            if ($right_cleanup == 1 || $hash_needs_cleanup == 1) {
                emit($cg, "({ ");
                if ($hash_needs_cleanup == 1) {
                    emit($cg, "StradaValue *__ck_h = ");
                    gen_expression($cg, $expr->{"hash"});
                    emit($cg, "; ");
                }
                if ($right_cleanup == 1) {
                    emit($cg, "StradaValue *__ck_r = ");
                    gen_expression($cg, $concat_right);
                    emit($cg, "; ");
                }
                emit($cg, "StradaValue *__ck_res = strada_hv_fetch_owned_concat(");
                if ($hash_needs_cleanup == 1) {
                    emit($cg, "__ck_h");
                } else {
                    gen_expression($cg, $expr->{"hash"});
                }
                emit($cg, ", ");
                gen_str_literal_c($cg, $prefix_val);
                emit($cg, ", " . $prefix_len . ", ");
                if ($right_cleanup == 1) {
                    emit($cg, "__ck_r");
                } else {
                    gen_expression($cg, $concat_right);
                }
                emit($cg, "); ");
                if ($right_cleanup == 1) { emit($cg, "strada_decref(__ck_r); "); }
                if ($hash_needs_cleanup == 1) { emit($cg, "strada_decref(__ck_h); "); }
                emit($cg, "__ck_res; })");
            } else {
                emit($cg, "strada_hv_fetch_owned_concat(");
                gen_expression($cg, $expr->{"hash"});
                emit($cg, ", ");
                gen_str_literal_c($cg, $prefix_val);
                emit($cg, ", " . $prefix_len . ", ");
                gen_expression($cg, $concat_right);
                emit($cg, ")");
            }
        } else {
            # Expression key - use _sv variant (no strada_to_str needed)
            my int $key_needs_cleanup = needs_temp_cleanup($cg, $key_expr);
            emit($cg, "({ StradaValue *__hget_k = ");
            gen_expression($cg, $key_expr);
            emit($cg, "; ");
            if ($hash_needs_cleanup == 1) {
                emit($cg, "StradaValue *__hget_h = ");
                gen_expression($cg, $expr->{"hash"});
                emit($cg, "; StradaValue *__hget_r = strada_hv_fetch_owned_sv(__hget_h, __hget_k); strada_decref(__hget_h); ");
            } else {
                emit($cg, "StradaValue *__hget_r = strada_hv_fetch_owned_sv(");
                gen_expression($cg, $expr->{"hash"});
                emit($cg, ", __hget_k); ");
            }
            if ($key_needs_cleanup == 1) {
                emit($cg, "strada_decref(__hget_k); ");
            }
            emit($cg, "__hget_r; })");
        }
        return;
    }

    # Array slice: @arr[0, 2, 4] or @{$ref}[0, 1]
    if ($type == NODE_ARRAY_SLICE()) {
        my scalar $source = $expr->{"source"};
        my scalar $items = $expr->{"items"};
        my int $item_count = $expr->{"item_count"};

        # Determine the actual source SV expression (peel one DEREF_SCALAR)
        # and whether it returns an owned ref that needs decref after we
        # finish reading slice elements out of its array.
        my scalar $src_expr = $source;
        if ($source->{"type"} == NODE_DEREF_SCALAR()) {
            $src_expr = $source->{"ref"};
        }
        my int $src_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $src_expr) == 1;

        emit($cg, "({ StradaValue *__slice_res = strada_new_array(); ");
        if ($src_cleanup == 1) {
            emit($cg, "StradaValue *__slice_src_sv = ");
            gen_expression($cg, $src_expr);
            emit($cg, "; StradaArray *__slice_src = strada_deref_array(__slice_src_sv); ");
        } else {
            emit($cg, "StradaArray *__slice_src = strada_deref_array(");
            gen_expression($cg, $src_expr);
            emit($cg, "); ");
        }

        for (my int $i = 0; $i < $item_count; $i = $i + 1) {
            my scalar $item = $items->[$i];
            if ($item->{"type"} == NODE_RANGE()) {
                emit($cg, "for (int64_t __sl_i = ");
                emit_int_operand($cg, $item->{"start"});
                emit($cg, "; __sl_i <= ");
                emit_int_operand($cg, $item->{"end"});
                emit($cg, "; __sl_i++) { ");
                emit($cg, "strada_array_push(__slice_res->value.av, strada_array_get(__slice_src, __sl_i)); ");
                emit($cg, "} ");
            } else {
                emit($cg, "strada_array_push(__slice_res->value.av, strada_array_get(__slice_src, ");
                emit_int_operand($cg, $item);
                emit($cg, ")); ");
            }
        }

        if ($src_cleanup == 1) {
            emit($cg, "strada_decref(__slice_src_sv); ");
        }
        emit($cg, "__slice_res; })");
        return;
    }

    # Hash slice: @hash{"a", "b"} or @{$ref}{"a", "b"}
    if ($type == NODE_HASH_SLICE()) {
        my scalar $source = $expr->{"source"};
        my scalar $items = $expr->{"items"};
        my int $item_count = $expr->{"item_count"};

        my scalar $hsrc_expr = $source;
        if ($source->{"type"} == NODE_DEREF_SCALAR()) {
            $hsrc_expr = $source->{"ref"};
        }
        my int $hsrc_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $hsrc_expr) == 1;

        emit($cg, "({ StradaValue *__slice_res = strada_new_array(); ");
        if ($hsrc_cleanup == 1) {
            emit($cg, "StradaValue *__slice_src_sv = ");
            gen_expression($cg, $hsrc_expr);
            emit($cg, "; StradaHash *__slice_src = strada_deref_hash(__slice_src_sv); ");
        } else {
            emit($cg, "StradaHash *__slice_src = strada_deref_hash(");
            gen_expression($cg, $hsrc_expr);
            emit($cg, "); ");
        }

        for (my int $i = 0; $i < $item_count; $i = $i + 1) {
            my scalar $item = $items->[$i];
            my int $key_is_literal = 0;
            if ($item->{"type"} == NODE_STR_LITERAL() && str_has_nul($item->{"value"}) == 0) {
                $key_is_literal = 1;
            }
            if ($key_is_literal == 1) {
                emit($cg, "strada_array_push(__slice_res->value.av, strada_hash_get(__slice_src, ");
                gen_str_literal_c($cg, $item->{"value"});
                emit($cg, ")); ");
            } else {
                my int $key_needs_cleanup = needs_temp_cleanup($cg, $item);
                emit($cg, "{ StradaValue *__sl_k = ");
                gen_expression($cg, $item);
                emit($cg, "; strada_array_push(__slice_res->value.av, strada_hash_get_sv(__slice_src, __sl_k)); ");
                if ($key_needs_cleanup == 1) {
                    emit($cg, "strada_decref(__sl_k); ");
                }
                emit($cg, "} ");
            }
        }

        if ($hsrc_cleanup == 1) {
            emit($cg, "strada_decref(__slice_src_sv); ");
        }
        emit($cg, "__slice_res; })");
        return;
    }

    # Reference
    if ($type == NODE_REF()) {
        my str $ref_type = $expr->{"ref_type"};
        if ($ref_type eq "&") {
            my scalar $fr_tgt = $expr->{"target"};
            my scalar $fr_info = 0;
            if ($fr_tgt && ($fr_tgt->{"type"} + 0) == NODE_FUNC_REF()) {
                $fr_info = resolve_callee_func_info($cg, "" . $fr_tgt->{"name"});
            }
            if ($fr_info && ($fr_info->{"is_extern"} + 0) != 1 && ($fr_info->{"is_c_extern"} + 0) != 1) {
                my int $fr_pc = $fr_info->{"param_count"} + 0;
                my int $fr_var = $fr_info->{"is_variadic"} + 0;
                my int $fr_void = 0;
                if ($fr_info->{"return_type"} == TYPE_VOID()) { $fr_void = 1; }
                my int $fr_fixed = $fr_pc;
                if ($fr_var == 1 && ($fr_info->{"variadic_param_idx"} + 0) >= 0) {
                    $fr_fixed = $fr_info->{"variadic_param_idx"} + 0;
                }
                my str $fr_cname = "" . $fr_info->{"c_name"};
                if (length($fr_cname) == 0) { $fr_cname = sanitize_name("" . $fr_tgt->{"name"}); }
                emit($cg, "strada_funcref_new((void*)&" . $fr_cname . ", " . $fr_pc . ", " . $fr_var . ", " . $fr_void . ", " . $fr_fixed . ")");
            } else {
                emit($cg, "strada_cpointer_new((void*)");
                gen_expression($cg, $fr_tgt);
                emit($cg, ")");
            }
        } elsif ($ref_type eq "$" && $expr->{"target"}->{"type"} == NODE_VARIABLE() && $expr->{"target"}->{"sigil"} eq "$"
            && length("" . $cg->{"our_vars"}->{escape_c_keyword($expr->{"target"}->{"name"})}) == 0
            && $expr->{"target"}->{"name"} ne "__program_name"
            && index($expr->{"target"}->{"name"}, "::") < 0) {
            my str $ref_vname = $expr->{"target"}->{"name"};
            my str $ref_vcname = escape_c_keyword($ref_vname);
            $cg->{"known_types"}->{$ref_vcname} = "";
            if ($cg->{"in_anon_func"} == 1
                && !str_contains_name($cg->{"anon_param_str"}, $ref_vname)
                && !str_contains_name($cg->{"anon_local_str"}, $ref_vname)) {
                my str $ensure_cap = scalar_var_c_ref($cg, $ref_vname, $ref_vcname);
                my int $cidx = get_capture_index($cg->{"anon_capture_str"}, $ref_vname);
                if (($cg->{"file_globals"}->{$ref_vcname} + 0) == 1 && ($cg->{"func_locals_seen"}->{$ref_vcname} + 0) == 0) {
                    emit($cg, "strada_slot_ref_create(__captures[" . $cidx . "])");
                } else {
                    emit($cg, "strada_cell_ref_create(__captures[" . $cidx . "])");
                }
            } elsif (($cg->{"active_boxed_vars"}->{$ref_vcname} + 0) == 1) {
                emit($cg, "strada_cell_ref_create(__cell_" . $ref_vcname . ")");
            } else {
                # Unboxed local scalar variable reference \$var
                emit($cg, "strada_slot_ref_create((StradaValue**)&");
                gen_expression($cg, $expr->{"target"});
                emit($cg, ")");
            }
        } else {
            # \"lit", \(f()), \[...]: the target is an owned temporary, so the
            # new reference takes it over. strada_new_ref() increfs, which
            # leaked the temporary (e.g. 32 bytes per `\"str"`).
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $expr->{"target"}) == 1) {
                emit($cg, "strada_new_ref_take(");
            } else {
                emit($cg, "strada_new_ref(");
            }
            gen_expression($cg, $expr->{"target"});
            emit($cg, ", '");
            emit($cg, $ref_type);
            emit($cg, "')");
        }
        return;
    }
    
    # Hash dereference - use strada_hv_fetch_owned for owned ref (fixes tied hash leak)
    if ($type == NODE_DEREF_HASH()) {
        my scalar $key_expr = $expr->{"key"};
        my int $key_is_literal = 0;
        if ($key_expr->{"type"} == NODE_STR_LITERAL() && str_has_nul($key_expr->{"value"}) == 0) {
            $key_is_literal = 1;
        }

        # Autovivification: when this deref access is an intermediate in an
        # assignment-target chain ($r->{"a"}{"b"} = v, $r->{"a"}{"b"} += v),
        # create the missing intermediate hash instead of fetching undef.
        # Mirrors the NODE_HASH_ACCESS consumer above; strada_autoviv_hash
        # derefs REF/HASH parents itself and returns a BORROWED ref (owned
        # by the parent hash), so no cleanup of the result. Previously this
        # branch ignored the flag, so ref-rooted nested assignment targets
        # silently fetched undef and the store was lost.
        if ($cg->{"autoviv"} >= 1) {
            my int $dh_av = $cg->{"autoviv"};
            $cg->{"autoviv"} = 0;
            my str $dh_av_fn = "strada_autoviv_hash";
            if ($dh_av == 2) {
                $dh_av_fn = "strada_autoviv_array";
            }
            my scalar $ref_sub = $expr->{"ref"};
            my int $dh_prop = 0;
            if (autoviv_link_type($ref_sub) == 1) { $dh_prop = 1; }
            my int $dh_kind = 1;
            if ($key_is_literal == 1) { $dh_kind = 0; }
            emit_autoviv_step($cg, $dh_av_fn, $ref_sub, $dh_prop, $key_expr, $dh_kind);
            return;
        }

        my int $key_is_concat = is_concat_str_literal_left($key_expr);
        my int $ref_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $expr->{"ref"}) == 1;
        if ($key_is_literal == 1) {
            # Literal key: pre-hashed fetch (compile-time djb2, ASCII keys) so the
            # constant key isn't re-hashed on every access.
            emit_hash_fetch_literal($cg, $expr->{"ref"}, $key_expr->{"value"}, $ref_cleanup);
        } elsif ($key_is_concat == 1) {
            # Concat key "prefix" . $expr - zero-alloc stack buffer
            my scalar $concat_right = $key_expr->{"right"};
            my int $right_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $concat_right) == 1;
            my str $prefix_val = $key_expr->{"left"}->{"value"};
            my int $prefix_len = bytes($prefix_val);
            emit($cg, "({ ");
            if ($ref_cleanup == 1) {
                emit($cg, "StradaValue *__hd_ref = ");
                gen_expression($cg, $expr->{"ref"});
                emit($cg, "; ");
            }
            if ($right_cleanup == 1) {
                emit($cg, "StradaValue *__ck_r = ");
                gen_expression($cg, $concat_right);
                emit($cg, "; ");
            }
            emit($cg, "StradaValue *__ck_res = strada_hv_fetch_owned_concat(");
            if ($ref_cleanup == 1) {
                emit($cg, "__hd_ref");
            } else {
                gen_expression($cg, $expr->{"ref"});
            }
            emit($cg, ", ");
            gen_str_literal_c($cg, $prefix_val);
            emit($cg, ", " . $prefix_len . ", ");
            if ($right_cleanup == 1) {
                emit($cg, "__ck_r); strada_decref(__ck_r); ");
            } else {
                gen_expression($cg, $concat_right);
                emit($cg, "); ");
            }
            if ($ref_cleanup == 1) {
                emit($cg, "strada_decref(__hd_ref); ");
            }
            emit($cg, "__ck_res; })");
        } else {
            # Expression key - use _sv variant (no strada_to_str needed)
            my int $key_needs_cleanup = needs_temp_cleanup($cg, $key_expr);
            emit($cg, "({ ");
            if ($ref_cleanup == 1) {
                emit($cg, "StradaValue *__hd_ref = ");
                gen_expression($cg, $expr->{"ref"});
                emit($cg, "; ");
            }
            emit($cg, "StradaValue *__hget_k = ");
            gen_expression($cg, $key_expr);
            emit($cg, "; StradaValue *__hget_r = strada_hv_fetch_owned_sv(");
            if ($ref_cleanup == 1) {
                emit($cg, "__hd_ref");
            } else {
                gen_expression($cg, $expr->{"ref"});
            }
            emit($cg, ", __hget_k); ");
            if ($key_needs_cleanup == 1) {
                emit($cg, "strada_decref(__hget_k); ");
            }
            if ($ref_cleanup == 1) {
                emit($cg, "strada_decref(__hd_ref); ");
            }
            emit($cg, "__hget_r; })");
        }
        return;
    }

    # Array dereference
    if ($type == NODE_DEREF_ARRAY()) {
        my scalar $ref_expr = $expr->{"ref"};

        # Autovivification: intermediate deref-subscript in an assignment-
        # target chain ($r->[0]{"k"} = v). Mirrors NODE_SUBSCRIPT above.
        if ($cg->{"autoviv"} >= 1) {
            my int $da_av = $cg->{"autoviv"};
            $cg->{"autoviv"} = 0;
            my str $da_av_fn = "strada_autoviv_elem_hash";
            if ($da_av == 2) {
                $da_av_fn = "strada_autoviv_elem_array";
            }
            my int $da_prop = 0;
            if (autoviv_link_type($ref_expr) == 1) { $da_prop = 2; }
            emit_autoviv_step($cg, $da_av_fn, $ref_expr, $da_prop, $expr->{"index"}, 2);
            return;
        }

        my int $ref_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $ref_expr) == 1;
        if ($cg->{"uses_tie"} == 1) {
            if ($ref_cleanup == 1) {
                emit($cg, "({ StradaValue *__da_r = ");
                gen_expression($cg, $ref_expr);
                emit($cg, "; StradaValue *__da_el = strada_av_fetch_sv(__da_r, ");
                emit_int_operand($cg, $expr->{"index"});
                emit($cg, "); strada_decref(__da_r); __da_el; })");
            } else {
                emit($cg, "strada_av_fetch_sv(");
                gen_expression($cg, $ref_expr);
                emit($cg, ", ");
                emit_int_operand($cg, $expr->{"index"});
                emit($cg, ")");
            }
            return;
        }
        if ($ref_cleanup == 1) {
            emit($cg, "({ StradaValue *__da_r = ");
            gen_expression($cg, $ref_expr);
            emit($cg, "; StradaValue *__da_el = strada_array_get_owned(strada_deref_array(__da_r), ");
            emit_int_operand($cg, $expr->{"index"});
            emit($cg, "); strada_decref(__da_r); __da_el; })");
            return;
        }
        emit($cg, "strada_array_get(strada_deref_array(");
        gen_expression($cg, $ref_expr);
        emit($cg, "), ");
        emit_int_operand($cg, $expr->{"index"});
        emit($cg, ")");
        return;
    }
    
    # Scalar/Array/Hash dereference (@{}, %{}, $$)
    if ($type == NODE_DEREF_SCALAR()) {
        my str $sigil = $expr->{"sigil"};
        my int $inner_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $expr->{"ref"}) == 1;
        if ($inner_cleanup == 1) {
            # Inner expression returns owned ref - capture and decref after deref
            emit($cg, "({ StradaValue *__dtmp = ");
            gen_expression($cg, $expr->{"ref"});
            # @{f()} / %{f()}: the container lives inside the temporary ref,
            # so take a reference to it BEFORE the temp is released (the
            # borrowed form freed it: `foreach (@{f()})` read freed memory).
            # The result is owned - see needs_temp_cleanup.
            if ($sigil eq "@") {
                emit($cg, "; StradaValue *__dres = strada_deref_array_value_owned(__dtmp); ");
            } elsif ($sigil eq "%") {
                emit($cg, "; StradaValue *__dres = strada_deref_hash_value_owned(__dtmp); ");
            } else {
                emit($cg, "; StradaValue *__dres = strada_deref(__dtmp); ");
            }
            emit($cg, "strada_decref(__dtmp); __dres; })");
        } else {
            if ($sigil eq "@") {
                emit($cg, "strada_deref_array_value(");
            } elsif ($sigil eq "%") {
                emit($cg, "strada_deref_hash_value(");
            } else {
                emit($cg, "strada_deref(");
            }
            gen_expression($cg, $expr->{"ref"});
            emit($cg, ")");
        }
        return;
    }
    
    # Field access (obj->field)
    if ($type == NODE_FIELD_ACCESS()) {
        my scalar $fa_info = resolve_struct_field($cg, $expr->{"object"}, $expr->{"field"});
        if ($fa_info != 0) {
            my int $fa_type = $fa_info->{"type"} + 0;
            my int $fa_off = $fa_info->{"offset"} + 0;
            my str $fa_name = $fa_info->{"name"};
            my scalar $fa_obj = $expr->{"object"};
            my int $fa_obj_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $fa_obj) == 1;
            if ($fa_obj_cl == 1) {
                emit($cg, "({ StradaValue *__cfa_o = ");
                gen_expression($cg, $fa_obj);
                if ($fa_type == TYPE_STR()) {
                    emit($cg, "; const char *__cfa_s = strada_cstruct_get_string(__cfa_o, \"" . $fa_name . "\", " . $fa_off . "); StradaValue *__cfa_r = strada_new_str(__cfa_s ? __cfa_s : \"\"); strada_decref(__cfa_o); __cfa_r; })");
                } elsif ($fa_type == TYPE_NUM()) {
                    emit($cg, "; StradaValue *__cfa_r = strada_new_num(strada_cstruct_get_double(__cfa_o, \"" . $fa_name . "\", " . $fa_off . ")); strada_decref(__cfa_o); __cfa_r; })");
                } else {
                    emit($cg, "; StradaValue *__cfa_r = strada_new_int(strada_cstruct_get_int(__cfa_o, \"" . $fa_name . "\", " . $fa_off . ")); strada_decref(__cfa_o); __cfa_r; })");
                }
            } else {
                if ($fa_type == TYPE_STR()) {
                    emit($cg, "({ const char *__cfa_s = strada_cstruct_get_string(");
                    gen_expression($cg, $fa_obj);
                    emit($cg, ", \"" . $fa_name . "\", " . $fa_off . "); strada_new_str(__cfa_s ? __cfa_s : \"\"); })");
                } elsif ($fa_type == TYPE_NUM()) {
                    emit($cg, "strada_new_num(strada_cstruct_get_double(");
                    gen_expression($cg, $fa_obj);
                    emit($cg, ", \"" . $fa_name . "\", " . $fa_off . "))");
                } else {
                    emit($cg, "strada_new_int(strada_cstruct_get_int(");
                    gen_expression($cg, $fa_obj);
                    emit($cg, ", \"" . $fa_name . "\", " . $fa_off . "))");
                }
            }
            return;
        }
        gen_expression($cg, $expr->{"object"});
        emit($cg, "->" . $expr->{"field"});
        return;
    }
    
    # Function reference (&func_name)
    if ($type == NODE_FUNC_REF()) {
        my str $fref_name = $expr->{"name"};
        my scalar $fref_info = resolve_callee_func_info($cg, $fref_name);
        my str $fref_c = $fref_name;
        if ($fref_info && length("" . $fref_info->{"c_name"}) > 0) {
            $fref_c = "" . $fref_info->{"c_name"};
        }
        emit($cg, "&" . $fref_c);
        return;
    }
    
    # Method call ($obj->method(args)) - Perl-style blessed reference method dispatch
    if ($type == NODE_METHOD_CALL()) { gen_method_call_node($cg, $expr); return; }

    # Dynamic method call: $obj->$method(args)
    if ($type == NODE_DYN_METHOD_CALL()) {
        my int $dm_arg_count = $expr->{"arg_count"};
        my scalar $dm_base = $expr->{"base_object"};
        my scalar $dm_meth_expr = $expr->{"method_expr"};
        my scalar $dm_args = $expr->{"args"};

        # Does the receiver expression produce an owned ref that must be
        # decref'd after the call? (E.g. $h{"obj"}->$method() — the hash
        # access returns an owned ref.)
        my int $dm_base_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $dm_base) == 1;

        # Check if any argument has spread operator
        my int $dm_has_spread = 0;
        for (my int $dm_sa = 0; $dm_sa < $dm_arg_count; $dm_sa = $dm_sa + 1) {
            if ($dm_args->[$dm_sa]->{"type"} == NODE_SPREAD()) {
                $dm_has_spread = 1;
            }
        }

        my int $dm_mval_cl = 0;
        if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $dm_meth_expr) == 1) {
            $dm_mval_cl = 1;
        }
        my int $dm_clean = $cg->{"cleanup_enabled"} + 0;
        my int $dm_push = cleanup_push_useful($cg);
        emit($cg, "({ StradaValue *__dm_obj = ");
        gen_expression($cg, $dm_base);
        emit($cg, "; ");
        if ($dm_clean == 1 && $dm_base_cleanup == 0) {
            emit($cg, "strada_incref(__dm_obj); ");
        }
        if ($dm_push == 1 && $dm_clean == 1) {
            emit($cg, "strada_cleanup_push(__dm_obj); ");
        }
        emit($cg, "StradaValue *__dm_mval = ");
        gen_expression($cg, $dm_meth_expr);
        emit($cg, "; ");
        if ($dm_clean == 1 && $dm_mval_cl == 0) {
            emit($cg, "strada_incref(__dm_mval); ");
        }
        if ($dm_push == 1 && $dm_clean == 1) {
            emit($cg, "strada_cleanup_push(__dm_mval); ");
        }
        emit($cg, "char __dm_mbuf[256]; const char *__dm_mname = strada_to_str_buf(__dm_mval, __dm_mbuf, sizeof(__dm_mbuf)); ");
        if ($dm_has_spread == 1) {
            # Build args array dynamically with spread support
            emit($cg, "StradaValue *__dm_pa = strada_new_array(); ");
            if ($dm_push == 1 && $dm_clean == 1) { emit($cg, "strada_cleanup_push(__dm_pa); "); }

            my int $dm_a = 0;
            while ($dm_a < $dm_arg_count) {
                my scalar $dm_arg = $dm_args->[$dm_a];
                if ($dm_arg->{"type"} == NODE_SPREAD()) {
                    my int $dm_sp_cl = $dm_clean == 1 && needs_temp_cleanup($cg, $dm_arg->{"target"}) == 1;
                    emit($cg, "{ StradaValue *__dm_spread = ");
                    gen_expression($cg, $dm_arg->{"target"});
                    emit($cg, "; StradaArray *__dm_sa = strada_deref_array(__dm_spread); ");
                    emit($cg, "if (__dm_sa) { for (size_t __dm_si = 0; __dm_si < __dm_sa->size; __dm_si++) { ");
                    emit($cg, "StradaValue *__dm_se = __dm_sa->elements[__dm_sa->head + __dm_si]; strada_incref(__dm_se); ");
                    emit($cg, "strada_array_push_take(strada_deref_array(__dm_pa), __dm_se); } } ");
                    if ($dm_sp_cl == 1) { emit($cg, "strada_decref(__dm_spread); "); }
                    emit($cg, "} ");
                } else {
                    if ($dm_clean == 1 && needs_temp_cleanup($cg, $dm_arg) == 1) {
                        emit($cg, "strada_array_push_take(strada_deref_array(__dm_pa), ");
                    } else {
                        emit($cg, "strada_array_push(strada_deref_array(__dm_pa), ");
                    }
                    gen_expression($cg, $dm_arg);
                    emit($cg, "); ");
                }
                $dm_a = $dm_a + 1;
            }

            if ($dm_push == 1 && $dm_clean == 1) { emit($cg, "strada_cleanup_pop(); "); }
            emit($cg, "StradaValue *__dm_res = strada_method_call(__dm_obj, __dm_mname, __dm_pa); ");
            if ($dm_clean == 1) {
                if ($dm_push == 1) {
                    emit($cg, "strada_cleanup_pop_decref(__dm_mval); ");
                    emit($cg, "strada_cleanup_pop_decref(__dm_obj); ");
                } else {
                    emit($cg, "strada_decref(__dm_mval); ");
                    emit($cg, "strada_decref(__dm_obj); ");
                }
            }
            emit($cg, "__dm_res; })");
        } else {
            # No spread - evaluate arguments strictly LTR after receiver & method expr
            my int $dm_needs_arg_cleanup = 0;
            if ($dm_clean == 1) {
                my int $dm_c = 0;
                while ($dm_c < $dm_arg_count) {
                    if (needs_temp_cleanup($cg, $dm_args->[$dm_c]) == 1) {
                        $dm_needs_arg_cleanup = 1;
                    }
                    $dm_c = $dm_c + 1;
                }
            }

            if ($dm_arg_count > 1 || $dm_needs_arg_cleanup == 1) {
                my int $dm_a2 = 0;
                while ($dm_a2 < $dm_arg_count) {
                    emit($cg, "StradaValue *__dm_arg_" . $dm_a2 . " = ");
                    gen_expression($cg, $dm_args->[$dm_a2]);
                    emit($cg, "; ");
                    if ($dm_clean == 1) {
                        if (needs_temp_cleanup($cg, $dm_args->[$dm_a2]) == 0) {
                            emit($cg, "strada_incref(__dm_arg_" . $dm_a2 . "); ");
                        }
                        if ($dm_push == 1) {
                            emit($cg, "strada_cleanup_push(__dm_arg_" . $dm_a2 . "); ");
                        }
                    }
                    $dm_a2 = $dm_a2 + 1;
                }
                emit($cg, "StradaValue *__dm_pa = strada_pack_args(" . $dm_arg_count);
                my int $dm_i = 0;
                while ($dm_i < $dm_arg_count) {
                    emit($cg, ", __dm_arg_" . $dm_i);
                    $dm_i = $dm_i + 1;
                }
                emit($cg, "); StradaValue *__dm_res = strada_method_call(__dm_obj, __dm_mname, __dm_pa); ");
                if ($dm_clean == 1) {
                    my int $dm_d = $dm_arg_count - 1;
                    while ($dm_d >= 0) {
                        if ($dm_push == 1) { emit($cg, "strada_cleanup_pop_decref(__dm_arg_" . $dm_d . "); "); }
                        else { emit($cg, "strada_decref(__dm_arg_" . $dm_d . "); "); }
                        $dm_d = $dm_d - 1;
                    }
                    if ($dm_push == 1) {
                        emit($cg, "strada_cleanup_pop_decref(__dm_mval); ");
                        emit($cg, "strada_cleanup_pop_decref(__dm_obj); ");
                    } else {
                        emit($cg, "strada_decref(__dm_mval); ");
                        emit($cg, "strada_decref(__dm_obj); ");
                    }
                }
                emit($cg, "__dm_res; })");
            } else {
                # 0 or 1 pure non-temp arg
                emit($cg, "StradaValue *__dm_pa = strada_pack_args(" . $dm_arg_count);
                my int $dm_i2 = 0;
                while ($dm_i2 < $dm_arg_count) {
                    emit($cg, ", ");
                    gen_expression($cg, $dm_args->[$dm_i2]);
                    $dm_i2 = $dm_i2 + 1;
                }
                emit($cg, "); StradaValue *__dm_res = strada_method_call(__dm_obj, __dm_mname, __dm_pa); ");
                if ($dm_clean == 1) {
                    if ($dm_push == 1) {
                        emit($cg, "strada_cleanup_pop_decref(__dm_mval); ");
                        emit($cg, "strada_cleanup_pop_decref(__dm_obj); ");
                    } else {
                        emit($cg, "strada_decref(__dm_mval); ");
                        emit($cg, "strada_decref(__dm_obj); ");
                    }
                }
                emit($cg, "__dm_res; })");
            }
        }
        return;
    }

    # SUPER::method($self, args...) - calls parent method
    if ($type == NODE_SUPER_CALL()) {
        my int $arg_count = $expr->{"arg_count"};
        my str $method = $expr->{"method"};
        my scalar $args = $expr->{"args"};

        if ($arg_count < 1) {
            emit($cg, "strada_new_undef() /* SUPER call requires self argument */");
            return;
        }

        my str $fn_pkg = $cg->{"current_fn_package"};
        my int $self_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[0]) == 1;
        my int $sp_push = cleanup_push_useful($cg);
        emit($cg, "({ StradaValue *__super_self = ");
        gen_expression($cg, $args->[0]);
        emit($cg, "; ");
        if ($sp_push == 1 && $self_cl == 1) { emit($cg, "strada_cleanup_push(__super_self); "); }
        emit($cg, "StradaValue *__super_pa = strada_new_array(); ");
        if ($sp_push == 1) { emit($cg, "strada_cleanup_push(__super_pa); "); }
        my int $si = 1;
        while ($si < $arg_count) {
            my scalar $sarg = $args->[$si];
            if ($sarg->{"type"} == NODE_SPREAD()) {
                my int $sp_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $sarg->{"target"}) == 1;
                emit($cg, "{ StradaValue *__sp_v = ");
                gen_expression($cg, $sarg->{"target"});
                emit($cg, "; StradaArray *__sp_av = strada_deref_array(__sp_v); if (__sp_av) { for (size_t __sp_i = 0; __sp_i < __sp_av->size; __sp_i++) { StradaValue *__sp_e = __sp_av->elements[__sp_av->head + __sp_i]; strada_incref(__sp_e); strada_array_push_take(__super_pa->value.av, __sp_e); } } ");
                if ($sp_cl == 1) { emit($cg, "strada_decref(__sp_v); "); }
                emit($cg, "} ");
            } else {
                if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $sarg) == 1) {
                    emit($cg, "strada_array_push_take(__super_pa->value.av, ");
                } else {
                    emit($cg, "strada_array_push(__super_pa->value.av, ");
                }
                gen_expression($cg, $sarg);
                emit($cg, "); ");
            }
            $si = $si + 1;
        }
        if ($sp_push == 1) { emit($cg, "strada_cleanup_pop(); "); }
        emit($cg, "StradaValue *__super_res = strada_super_call(__super_self, " . c_str_lit($fn_pkg) . ", " . c_str_lit($method) . ", __super_pa); ");
        if ($self_cl == 1) {
            if ($sp_push == 1) { emit($cg, "strada_cleanup_pop_decref(__super_self); "); }
            else { emit($cg, "strada_decref(__super_self); "); }
        }
        emit($cg, "__super_res; })");
        return;
    }

    # $1-$9 capture variables
    if ($type == NODE_CAPTURE_VAR()) {
        emit($cg, "strada_capture_var(");
        emit($cg, "" . $expr->{"number"});
        emit($cg, ")");
        return;
    }

    # __PACKAGE__ - returns current package name
    if ($type == NODE_DUNDER_PACKAGE()) {
        my str $dp_name = "" . $expr->{"package"};
        if (length($dp_name) > 0) {
            emit($cg, "strada_new_str(");
            gen_str_literal_c($cg, $dp_name);
            emit($cg, ")");
            return;
        }
        emit($cg, "strada_new_str(strada_current_package() ? strada_current_package() : \"\")");
        return;
    }

    # __FILE__ - returns current file name
    if ($type == NODE_DUNDER_FILE()) {
        my str $filename = $cg->{"filename"};
        # Escape the filename — a source path may contain `"`/`\`/newline,
        # which raw-concatenated would break out of the C literal (CWE-94).
        emit($cg, "strada_new_str(");
        gen_str_literal_c($cg, $filename);
        emit($cg, ")");
        return;
    }

    # __LINE__ - returns current line number
    if ($type == NODE_DUNDER_LINE()) {
        my int $line = $expr->{"line_value"};
        emit($cg, "strada_new_int(" . $line . ")");
        return;
    }

    # Anonymous hash
    if ($type == NODE_ANON_HASH()) {
        my scalar $keys = $expr->{"keys"};
        my scalar $values = $expr->{"values"};
        my scalar $key_exprs = $expr->{"key_exprs"};
        my int $pair_count = $expr->{"pair_count"};

        # Check if any keys are expressions (dynamic keys) or contain embedded NULs
        my int $has_expr_keys = 0;
        my int $check_k = 0;
        while ($check_k < $pair_count) {
            if (($key_exprs && $key_exprs->[$check_k]) || ($keys && str_has_nul($keys->[$check_k]) == 1)) {
                $has_expr_keys = 1;
            }
            $check_k = $check_k + 1;
        }

        # Check if any values need temp cleanup (newly created values)
        my int $needs_val_cleanup = 0;
        my int $check_i = 0;
        while ($check_i < $pair_count) {
            if (needs_temp_cleanup($cg, $values->[$check_i]) == 1) {
                $needs_val_cleanup = 1;
            }
            $check_i = $check_i + 1;
        }

        # Fast record path: literal ASCII keys, no nested anon containers.
        # Emits strada_anon_hash_take_ph with compile-time djb2 key hashes
        # and OWNERSHIP TRANSFER: owned values pass straight through (no
        # incref-then-decref round trip); borrowed values get one explicit
        # incref. Values are cleanup-pushed between evaluations so a
        # throwing later value cannot leak earlier ones.
        my int $take_ok = 0;
        my int $all_ascii_keys = 0;
        if ($has_expr_keys == 0 && $pair_count > 0) {
            $take_ok = 1;
            $all_ascii_keys = 1;
            my int $tk = 0;
            while ($tk < $pair_count) {
                if (key_is_hashable_ascii($keys->[$tk]) == 0) {
                    $take_ok = 0;
                    $all_ascii_keys = 0;
                }
                my int $vt = $values->[$tk]->{"type"};
                if ($vt == NODE_ANON_ARRAY() || $vt == NODE_ANON_HASH()) {
                    $take_ok = 0;
                }
                $tk = $tk + 1;
            }
        }
        # Zero-temp fast path: non-throwing values (incl. nested anon arrays/hashes)
        if ($all_ascii_keys == 1 && $pair_count <= 30 && ($cg->{"cleanup_enabled"} == 0 || cleanup_push_useful($cg) == 0 || expr_cannot_throw($cg, $expr) == 1)) {
            my int $hmask = 0;
            if ($cg->{"cleanup_enabled"} == 1) {
                my int $hbit = 1;
                my int $hm = 0;
                while ($hm < $pair_count) {
                    if (needs_temp_cleanup($cg, $values->[$hm]) == 1) {
                        $hmask = $hmask + $hbit;
                    }
                    $hbit = $hbit * 2;
                    $hm = $hm + 1;
                }
            }
            emit($cg, "strada_anon_hash_mask_ph(" . $pair_count . ", " . $hmask . "u");
            my int $ha = 0;
            while ($ha < $pair_count) {
                emit($cg, ", ");
                gen_str_literal_c($cg, $keys->[$ha]);
                emit($cg, ", " . djb2_hash_32($keys->[$ha]) . "u, ");
                gen_expression($cg, $values->[$ha]);
                $ha = $ha + 1;
            }
            emit($cg, ")");
            return;
        }
        if ($take_ok == 1) {
            my int $push_cleanup = $cg->{"cleanup_enabled"};
            emit($cg, "({ ");
            my int $t = 0;
            while ($t < $pair_count) {
                emit($cg, "StradaValue *__ahx_v" . $t . " = ");
                gen_expression($cg, $values->[$t]);
                emit($cg, "; ");
                if (needs_temp_cleanup($cg, $values->[$t]) == 0) {
                    # borrowed -> make it owned for the take constructor
                    emit($cg, "strada_incref(__ahx_v" . $t . "); ");
                }
                if ($push_cleanup == 1) {
                    emit($cg, "strada_cleanup_push(__ahx_v" . $t . "); ");
                }
                $t = $t + 1;
            }
            if ($push_cleanup == 1) {
                my int $u = 0;
                while ($u < $pair_count) {
                    emit($cg, "strada_cleanup_pop(); ");
                    $u = $u + 1;
                }
            }
            emit($cg, "strada_anon_hash_take_ph(" . $pair_count);
            my int $a = 0;
            while ($a < $pair_count) {
                emit($cg, ", ");
                gen_str_literal_c($cg, $keys->[$a]);
                emit($cg, ", " . djb2_hash_32($keys->[$a]) . "u, __ahx_v" . $a);
                $a = $a + 1;
            }
            emit($cg, "); })");
            return;
        }

        if ($has_expr_keys == 1) {
            # Computed keys ({$k => $v}, {"p_" . $x => 1}): build the hash
            # pair by pair. Borrowed values are increfed by strada_hash_set;
            # owned temporaries are handed over with _take. Owned key temps
            # are released after stringification. The result is a hash
            # REFERENCE, exactly like the constant-key constructors.
            my int $ah_cl = $cg->{"cleanup_enabled"};
            emit($cg, "({ StradaValue *__ah_hash = strada_new_hash(); ");
            if ($ah_cl == 1) { emit($cg, "strada_cleanup_push(__ah_hash); "); }
            my int $e = 0;
            while ($e < $pair_count) {
                emit($cg, "{ ");
                my int $k_owned = 1;
                my int $k_is_lit = 1;
                if ($key_exprs && $key_exprs->[$e]) {
                    my scalar $kx = $key_exprs->[$e];
                    $k_is_lit = 0;
                    $k_owned = needs_temp_cleanup($cg, $kx);
                    emit($cg, "StradaValue *__ah_k" . $e . " = ");
                    gen_expression($cg, $kx);
                    emit($cg, "; ");
                } else {
                    # constant key (STRADA_NEW_STR_LIT preserves embedded NULs)
                    emit($cg, "StradaValue *__ah_k" . $e . " = STRADA_NEW_STR_LIT(\"");
                    emit_escaped_string($cg, $keys->[$e]);
                    emit($cg, "\"); ");
                }
                if ($ah_cl == 1 && $k_owned == 1) {
                    emit($cg, "strada_cleanup_push(__ah_k" . $e . "); ");
                }
                emit($cg, "StradaValue *__ah_v" . $e . " = ");
                gen_expression($cg, $values->[$e]);
                emit($cg, "; ");
                emit($cg, "strada_hash_set_sv(__ah_hash->value.hv, __ah_k" . $e . ", __ah_v" . $e . "); ");
                if (needs_temp_cleanup($cg, $values->[$e]) == 1) {
                    emit($cg, "strada_decref(__ah_v" . $e . "); ");
                }
                if ($k_owned == 1 && ($ah_cl == 1 || $k_is_lit == 1)) {
                    if ($ah_cl == 1) { emit($cg, "strada_cleanup_pop(); "); }
                    emit($cg, "strada_decref(__ah_k" . $e . "); ");
                }
                emit($cg, "} ");
                $e = $e + 1;
            }
            if ($ah_cl == 1) { emit($cg, "strada_cleanup_pop(); "); }
            emit($cg, "strada_ref_create_take(__ah_hash); })");
        } elsif ($needs_val_cleanup == 1 && $cg->{"cleanup_enabled"} == 1) {
            # Generate block with temps for values that need cleanup
            my int $ah_push = cleanup_push_useful($cg);
            emit($cg, "({ ");

            # Create temps for values that need cleanup
            # For anonymous arrays/hashes, use explicit new + new_ref pattern to avoid heap corruption
            my int $t = 0;
            while ($t < $pair_count) {
                if (needs_temp_cleanup($cg, $values->[$t]) == 1) {
                    my scalar $val = $values->[$t];
                    if ($val->{"type"} == NODE_ANON_ARRAY()) {
                        # Anonymous array: create explicit array + ref pattern
                        # This avoids the strada_ref_create_take issue that can cause heap corruption
                        my scalar $elems = $val->{"elements"};
                        my int $elem_count = $val->{"element_count"};
                        emit($cg, "StradaValue *__ah_arr" . $t . " = strada_new_array(); ");
                        if ($ah_push == 1) { emit($cg, "strada_cleanup_push(__ah_arr" . $t . "); "); }
                        # Add elements with proper refcount management
                        my int $e = 0;
                        while ($e < $elem_count) {
                            emit($cg, "StradaValue *__ah_ael" . $t . "_" . $e . " = ");
                            gen_expression($cg, $elems->[$e]);
                            emit($cg, "; strada_array_push(__ah_arr" . $t . "->value.av, __ah_ael" . $t . "_" . $e . "); ");
                            # push increfs: release only an owned temporary,
                            # never a borrowed variable (that freed it)
                            if (needs_temp_cleanup($cg, $elems->[$e]) == 1) {
                                emit($cg, "strada_decref(__ah_ael" . $t . "_" . $e . "); ");
                            }
                            $e = $e + 1;
                        }
                        emit($cg, "StradaValue *__ah_val" . $t . " = strada_new_ref(__ah_arr" . $t . ", '@'); ");
                        if ($ah_push == 1) { emit($cg, "strada_cleanup_pop_decref(__ah_arr" . $t . "); "); }
                        else { emit($cg, "strada_decref(__ah_arr" . $t . "); "); }
                    } elsif ($val->{"type"} == NODE_ANON_HASH() && anon_hash_has_expr_keys($val) == 0) {
                        # Anonymous hash: create explicit hash + ref pattern
                        # This avoids the strada_ref_create_take issue that can cause heap corruption
                        my scalar $inner_keys = $val->{"keys"};
                        my scalar $inner_values = $val->{"values"};
                        my int $inner_pair_count = $val->{"pair_count"};
                        emit($cg, "StradaValue *__ah_hsh" . $t . " = strada_new_hash(); ");
                        if ($ah_push == 1) { emit($cg, "strada_cleanup_push(__ah_hsh" . $t . "); "); }
                        # Add key-value pairs with proper refcount management
                        my int $p = 0;
                        while ($p < $inner_pair_count) {
                            emit($cg, "StradaValue *__ah_hel" . $t . "_" . $p . " = ");
                            gen_expression($cg, $inner_values->[$p]);
                            emit($cg, "; strada_hash_set(__ah_hsh" . $t . "->value.hv, \"");
                            emit_escaped_string($cg, $inner_keys->[$p]);
                            emit($cg, "\", __ah_hel" . $t . "_" . $p . "); ");
                            if (needs_temp_cleanup($cg, $inner_values->[$p]) == 1) {
                                emit($cg, "strada_decref(__ah_hel" . $t . "_" . $p . "); ");
                            }
                            $p = $p + 1;
                        }
                        emit($cg, "StradaValue *__ah_val" . $t . " = strada_new_ref(__ah_hsh" . $t . ", '%'); ");
                        if ($ah_push == 1) { emit($cg, "strada_cleanup_pop_decref(__ah_hsh" . $t . "); "); }
                        else { emit($cg, "strada_decref(__ah_hsh" . $t . "); "); }
                    } else {
                        emit($cg, "StradaValue *__ah_val" . $t . " = ");
                        gen_expression($cg, $val);
                        emit($cg, "; ");
                    }
                    # Push the just-allocated value so a later throwing
                    # value doesn't leak earlier ones.
                    emit($cg, "strada_cleanup_push(__ah_val" . $t . "); ");
                }
                $t = $t + 1;
            }

            # Create the hash
            emit($cg, "StradaValue *__ah_hash = strada_anon_hash(" . $pair_count);
            my int $a = 0;
            while ($a < $pair_count) {
                emit($cg, ", \"");
                emit_escaped_string($cg, $keys->[$a]);
                emit($cg, "\", ");
                if (needs_temp_cleanup($cg, $values->[$a]) == 1) {
                    emit($cg, "__ah_val" . $a);
                } else {
                    gen_expression($cg, $values->[$a]);
                }
                $a = $a + 1;
            }
            emit($cg, "); ");

            # Pop cleanup-stack entries (reverse order) for each pushed value.
            my int $d = $pair_count - 1;
            while ($d >= 0) {
                if (needs_temp_cleanup($cg, $values->[$d]) == 1) {
                    emit($cg, "strada_cleanup_pop(); ");
                }
                $d = $d - 1;
            }
            # Decref temps to balance the incref from strada_hash_set
            $d = 0;
            while ($d < $pair_count) {
                if (needs_temp_cleanup($cg, $values->[$d]) == 1) {
                    emit($cg, "strada_decref(__ah_val" . $d . "); ");
                }
                $d = $d + 1;
            }

            # Return the hash
            emit($cg, "__ah_hash; })");
        } else {
            # Simple generation - no cleanup needed
            emit($cg, "strada_anon_hash(" . $pair_count);
            my int $i = 0;
            while ($i < $pair_count) {
                emit($cg, ", \"");
                emit_escaped_string($cg, $keys->[$i]);
                emit($cg, "\", ");
                gen_expression($cg, $values->[$i]);
                $i = $i + 1;
            }
            emit($cg, ")");
        }
        return;
    }
    
    # Anonymous array
    if ($type == NODE_ANON_ARRAY()) {
        my scalar $elems = $expr->{"elements"};
        my int $elem_count = $expr->{"element_count"};

        # Check if any elements need temp cleanup (newly created values)
        my int $needs_elem_cleanup = 0;
        my int $has_array_flatten = 0;
        my int $check_i = 0;
        while ($check_i < $elem_count) {
            if (needs_temp_cleanup($cg, $elems->[$check_i]) == 1) {
                $needs_elem_cleanup = 1;
            }
            # Perl-style list flattening: array-typed elements splice their
            # elements into the result; scalars/refs stay single. See
            # array_flatten_kind.
            if (array_flatten_kind($cg, $elems->[$check_i]) > 0) {
                $has_array_flatten = 1;
            }
            $check_i = $check_i + 1;
        }

        # If any element flattens, build the result dynamically.
        if ($has_array_flatten == 1) {
            emit($cg, "({ StradaValue *__fl_arr = strada_new_array(); ");
            my int $fi = 0;
            while ($fi < $elem_count) {
                my scalar $fl_elem = $elems->[$fi];
                my int $fkind = array_flatten_kind($cg, $fl_elem);
                if ($fkind == 1) {
                    # @array: borrowed elements (unless our/temp owned SV), push each (push increfs).
                    my int $fl_src_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $fl_elem) == 1;
                    if ($fl_src_cl == 1) {
                        emit($cg, "{ StradaValue *__fl_sv = ");
                        gen_expression($cg, $fl_elem);
                        emit($cg, "; StradaArray *__fl_sa = strada_deref_array(__fl_sv); ");
                        emit($cg, "if (__fl_sa) { for (size_t __fl_i = 0; __fl_i < __fl_sa->size; __fl_i++) { ");
                        emit($cg, "strada_array_push(__fl_arr->value.av, __fl_sa->elements[__fl_sa->head + __fl_i]); } } ");
                        emit($cg, "strada_decref(__fl_sv); } ");
                    } else {
                        emit($cg, "{ StradaArray *__fl_sa = strada_deref_array(");
                        gen_expression($cg, $fl_elem);
                        emit($cg, "); if (__fl_sa) { for (size_t __fl_i = 0; __fl_i < __fl_sa->size; __fl_i++) { ");
                        emit($cg, "strada_array_push(__fl_arr->value.av, __fl_sa->elements[__fl_sa->head + __fl_i]); } } } ");
                    }
                } elsif ($fkind == 2) {
                    # Owned array temp (paren-list / map / grep / sort / array-
                    # returning call). deref_array unwraps the REF-boxing; if it
                    # somehow isn't an array, fall back to a single push.
                    emit($cg, "{ StradaValue *__fl_tmp = ");
                    gen_expression($cg, $fl_elem);
                    emit($cg, "; StradaArray *__fl_da = strada_deref_array(__fl_tmp); ");
                    emit($cg, "if (__fl_da) { for (size_t __fl_k = 0; __fl_k < __fl_da->size; __fl_k++) { ");
                    emit($cg, "strada_array_push(__fl_arr->value.av, __fl_da->elements[__fl_da->head + __fl_k]); } } ");
                    emit($cg, "else { strada_array_push(__fl_arr->value.av, __fl_tmp); } ");
                    emit($cg, "strada_decref(__fl_tmp); } ");
                } else {
                    # Regular element: push directly.
                    if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $fl_elem) == 1) {
                        emit($cg, "{ StradaValue *__fl_tmp = ");
                        gen_expression($cg, $fl_elem);
                        emit($cg, "; strada_array_push(__fl_arr->value.av, __fl_tmp); strada_decref(__fl_tmp); } ");
                    } else {
                        emit($cg, "strada_array_push(__fl_arr->value.av, ");
                        gen_expression($cg, $fl_elem);
                        emit($cg, "); ");
                    }
                }
                $fi = $fi + 1;
            }
            emit($cg, "__fl_arr; })");
            return;
        }

        if ($needs_elem_cleanup == 1 && $cg->{"cleanup_enabled"} == 1) {
            my int $aa_in_try = cleanup_push_useful($cg);
            # Zero-temp fast path when elements cannot throw:
            # - <= 30 elements: strada_anon_array_take(count, mask, ...)
            # - > 30 elements, all owned: strada_anon_array_owned(count, ...)
            if ($elem_count > 0 && ($aa_in_try == 0 || expr_cannot_throw($cg, $expr) == 1)) {
                if ($elem_count <= 30) {
                    my int $amask = 0;
                    my int $abit = 1;
                    my int $am = 0;
                    while ($am < $elem_count) {
                        if (needs_temp_cleanup($cg, $elems->[$am]) == 1) {
                            $amask = $amask + $abit;
                        }
                        $abit = $abit * 2;
                        $am = $am + 1;
                    }
                    emit($cg, "strada_anon_array_take(" . $elem_count . ", " . $amask . "u");
                    my int $ai = 0;
                    while ($ai < $elem_count) {
                        emit($cg, ", ");
                        gen_expression($cg, $elems->[$ai]);
                        $ai = $ai + 1;
                    }
                    emit($cg, ")");
                    return;
                } else {
                    my int $all_owned = 1;
                    my int $ao = 0;
                    while ($ao < $elem_count) {
                        if (needs_temp_cleanup($cg, $elems->[$ao]) == 0) {
                            $all_owned = 0;
                            last;
                        }
                        $ao = $ao + 1;
                    }
                    if ($all_owned == 1) {
                        emit($cg, "strada_anon_array_owned(" . $elem_count);
                        my int $ai = 0;
                        while ($ai < $elem_count) {
                            emit($cg, ", ");
                            gen_expression($cg, $elems->[$ai]);
                            $ai = $ai + 1;
                        }
                        emit($cg, ")");
                        return;
                    }
                }
            }
            # Generate block with temps for elements that need cleanup
            emit($cg, "({ ");

            # Create temps for elements that need cleanup
            # For anonymous arrays/hashes, use explicit new + new_ref pattern to avoid heap corruption
            my int $t = 0;
            while ($t < $elem_count) {
                if (needs_temp_cleanup($cg, $elems->[$t]) == 1) {
                    my scalar $elem = $elems->[$t];
                    if ($elem->{"type"} == NODE_ANON_ARRAY()) {
                        # Anonymous array: create explicit array + ref pattern
                        my scalar $inner_elems = $elem->{"elements"};
                        my int $inner_elem_count = $elem->{"element_count"};
                        emit($cg, "StradaValue *__aa_arr" . $t . " = strada_new_array(); ");
                        # Push inner array so a throwing inner element
                        # doesn't leak it (e.g. hash list-init pair
                        # like ("a" => boom())).
                        if ($aa_in_try == 1) { emit($cg, "strada_cleanup_push(__aa_arr" . $t . "); "); }
                        # Create temps for inner elements, push, then decref
                        my int $e = 0;
                        while ($e < $inner_elem_count) {
                            emit($cg, "StradaValue *__aa_inner" . $t . "_" . $e . " = ");
                            gen_expression($cg, $inner_elems->[$e]);
                            emit($cg, "; strada_array_push(__aa_arr" . $t . "->value.av, __aa_inner" . $t . "_" . $e . "); ");
                            # push increfs: release only an owned temporary.
                            # Unconditional decref freed borrowed variables:
                            # my hash %h = ("a" => f(), "b" => $var) clobbered $var.
                            if (needs_temp_cleanup($cg, $inner_elems->[$e]) == 1) {
                                emit($cg, "strada_decref(__aa_inner" . $t . "_" . $e . "); ");
                            }
                            $e = $e + 1;
                        }
                        if ($aa_in_try == 1) { emit($cg, "strada_cleanup_pop(); "); }
                        emit($cg, "StradaValue *__aa_el" . $t . " = strada_new_ref_take(__aa_arr" . $t . ", '@'); ");
                    } elsif ($elem->{"type"} == NODE_ANON_HASH() && anon_hash_has_expr_keys($elem) == 0) {
                        # Anonymous hash: create explicit hash + ref pattern
                        # (computed-key hashes take the generic path below)
                        my scalar $inner_keys = $elem->{"keys"};
                        my scalar $inner_values = $elem->{"values"};
                        my int $inner_pair_count = $elem->{"pair_count"};
                        emit($cg, "StradaValue *__aa_hsh" . $t . " = strada_new_hash(); ");
                        if ($aa_in_try == 1) { emit($cg, "strada_cleanup_push(__aa_hsh" . $t . "); "); }
                        # Create temps for inner values, set, then decref
                        my int $p = 0;
                        while ($p < $inner_pair_count) {
                            emit($cg, "StradaValue *__aa_hval" . $t . "_" . $p . " = ");
                            gen_expression($cg, $inner_values->[$p]);
                            emit($cg, "; strada_hash_set(__aa_hsh" . $t . "->value.hv, \"");
                            emit_escaped_string($cg, $inner_keys->[$p]);
                            emit($cg, "\", __aa_hval" . $t . "_" . $p . "); ");
                            if (needs_temp_cleanup($cg, $inner_values->[$p]) == 1) {
                                emit($cg, "strada_decref(__aa_hval" . $t . "_" . $p . "); ");
                            }
                            $p = $p + 1;
                        }
                        if ($aa_in_try == 1) { emit($cg, "strada_cleanup_pop(); "); }
                        emit($cg, "StradaValue *__aa_el" . $t . " = strada_new_ref_take(__aa_hsh" . $t . ", '%'); ");
                    } else {
                        emit($cg, "StradaValue *__aa_el" . $t . " = ");
                        gen_expression($cg, $elem);
                        emit($cg, "; ");
                    }
                    # Push the just-allocated element so a throw from a
                    # later element doesn't leak the prior ones. Popped
                    # in reverse order before the result is yielded.
                    if ($aa_in_try == 1) { emit($cg, "strada_cleanup_push(__aa_el" . $t . ");\n"); }
                }
                $t = $t + 1;
            }

            # Create the array
            emit($cg, "StradaValue *__aa_arr = strada_anon_array(" . $elem_count);
            my int $a = 0;
            while ($a < $elem_count) {
                emit($cg, ", ");
                if (needs_temp_cleanup($cg, $elems->[$a]) == 1) {
                    emit($cg, "__aa_el" . $a);
                } else {
                    gen_expression($cg, $elems->[$a]);
                }
                $a = $a + 1;
            }
            emit($cg, "); ");

            # Pop cleanup-stack entries (reverse) and decref temps.
            if ($aa_in_try == 1) {
                my int $d = $elem_count - 1;
                while ($d >= 0) {
                    if (needs_temp_cleanup($cg, $elems->[$d]) == 1) {
                        emit($cg, "strada_cleanup_pop(); ");
                    }
                    $d = $d - 1;
                }
            }
            my int $d = 0;
            while ($d < $elem_count) {
                if (needs_temp_cleanup($cg, $elems->[$d]) == 1) {
                    # __aa_el<d> owns __aa_arr<d>/__aa_hsh<d> via
                    # strada_new_ref_take, so we no longer separately
                    # decref the inner container — that would double-
                    # decref and free it underneath the ref.
                    emit($cg, "strada_decref(__aa_el" . $d . "); ");
                }
                $d = $d + 1;
            }

            # Return the array
            emit($cg, "__aa_arr; })");
        } else {
            # Simple generation - no cleanup needed
            emit($cg, "strada_anon_array(" . $elem_count);
            my int $i = 0;
            while ($i < $elem_count) {
                emit($cg, ", ");
                gen_expression($cg, $elems->[$i]);
                $i = $i + 1;
            }
            emit($cg, ")");
        }
        return;
    }

    # Map expression: map { block } @array
    if ($type == NODE_MAP()) {
        my scalar $block = $expr->{"block"};
        my scalar $array_expr = $expr->{"array"};
        my int $map_id = $cg->{"map_counter"};
        $cg->{"map_counter"} = $map_id + 1;

        my int $map_arr_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $array_expr) == 1;
        # Lazy-range fast path: map over an int-typed range iterates a
        # native C loop — no strada_range array materialization (mirrors
        # the foreach range path; `map {...} (1..1e6)` no longer builds a
        # million-element input). $_ is a tagged int per iteration.
        my int $map_is_range = 0;
        if ($array_expr->{"type"} == NODE_RANGE()
            && expr_is_int_typed($cg, $array_expr->{"start"}) == 1
            && expr_is_int_typed($cg, $array_expr->{"end"}) == 1) {
            $map_is_range = 1;
            $map_arr_cleanup = 0;
        }
        my int $saved_map_depth = $cg->{"scope_depth"};
        my int $saved_map_brk = $cg->{"loop_break_depth"};
        my int $saved_map_redo = $cg->{"loop_redo_depth"};
        my int $saved_map_try = $cg->{"loop_try_depth"};
        my str $saved_map_lvar = "" . $cg->{"loop_local_var"};
        my int $saved_map_fmark = $cg->{"loop_finally_mark"};
        my str $saved_map_rlbl = "" . $cg->{"current_redo_label"};
        emit($cg, "({ ");
        if ($map_is_range == 1) {
            emit($cg, "int64_t __map_rs_" . $map_id . " = ");
            emit_int_operand($cg, $array_expr->{"start"});
            emit($cg, "; int64_t __map_re_" . $map_id . " = ");
            emit_int_operand($cg, $array_expr->{"end"});
            emit($cg, "; ");
        } elsif ($map_arr_cleanup == 1) {
            emit($cg, "StradaValue *__map_sv_" . $map_id . " = ");
            gen_expression($cg, $array_expr);
            # Push so a throwing block body lets the catch's drain
            # decref the source on the longjmp path.
            emit($cg, "; strada_cleanup_push(__map_sv_" . $map_id . "); ");
            foreach_cleanup_enter($cg, $saved_map_depth, "__map_sv_" . $map_id);
            emit($cg, "StradaArray *__map_input_" . $map_id . " = strada_deref_array(__map_sv_" . $map_id . "); ");
        } else {
            emit($cg, "StradaArray *__map_input_" . $map_id . " = strada_deref_array(");
            gen_expression($cg, $array_expr);
            emit($cg, "); ");
        }
        emit($cg, "StradaValue *__map_result_" . $map_id . " = strada_new_array(); ");
        if ($cg->{"cleanup_enabled"} == 1) {
            emit($cg, "strada_cleanup_push(__map_result_" . $map_id . "); ");
            foreach_cleanup_enter($cg, $saved_map_depth, "__map_result_" . $map_id);
        }
        my str $map_el_var = "__map_e_" . $map_id;
        if ($map_is_range == 1) {
            emit($cg, "for (int64_t __map_i_" . $map_id . " = __map_rs_" . $map_id . "; __map_i_" . $map_id . " <= __map_re_" . $map_id . "; __map_i_" . $map_id . "++) { ");
            emit($cg, "StradaValue *" . $map_el_var . " = strada_new_int_il(__map_i_" . $map_id . "); ");
        } else {
            emit($cg, "int __map_len_" . $map_id . " = strada_array_length(__map_input_" . $map_id . "); ");
            emit($cg, "for (int __map_i_" . $map_id . " = 0; __map_i_" . $map_id . " < __map_len_" . $map_id . "; __map_i_" . $map_id . "++) { ");
            emit($cg, "StradaValue *" . $map_el_var . " = strada_array_get(__map_input_" . $map_id . ", __map_i_" . $map_id . "); ");
        }

        my int $saved_in_map = $cg->{"in_map_block"} + 0;
        my str $saved_map_elem = "" . $cg->{"current_elem_var"};
        $cg->{"in_map_block"} = 1;
        $cg->{"current_elem_var"} = $map_el_var;
        my int $map_has_local = stmt_has_local($block);
        my int $map_local_id = 0;
        my str $m_lmark = "";
        scope_push($cg);
        $cg->{"loop_break_depth"} = $cg->{"scope_depth"};
        $cg->{"loop_redo_depth"} = $cg->{"scope_depth"};
        $cg->{"loop_try_depth"} = $cg->{"try_depth"};
        $cg->{"loop_local_var"} = "";
        $cg->{"loop_finally_mark"} = $cg->{"finally_count"};
        if ($map_has_local == 1) {
            $map_local_id = $cg->{"tmp_counter"} + 0;
            $cg->{"tmp_counter"} = $map_local_id + 1;
            $m_lmark = "__local_map_mark_" . $map_local_id;
            emit($cg, "int " . $m_lmark . " = strada_local_depth_get(); ");
            local_mark_push($cg, $cg->{"scope_depth"}, $m_lmark);
            $cg->{"loop_local_var"} = $m_lmark;
        }
        my str $map_redo_lbl = "__map_redo_" . $map_id;
        $cg->{"current_redo_label"} = $map_redo_lbl;
        emit($cg, $map_redo_lbl . ": __attribute__((unused)); ");
        scope_push($cg);

        my scalar $stmts = $block->{"statements"};
        my int $stmt_count = $block->{"statement_count"};
        if ($stmt_count > 0) {
            my int $i = 0;
            while ($i < $stmt_count - 1) {
                gen_statement($cg, $stmts->[$i]);
                $i = $i + 1;
            }
            my scalar $last_stmt = $stmts->[$stmt_count - 1];
            if ($last_stmt->{"type"} == NODE_EXPR_STMT()) {
                my int $map_el_owned = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $last_stmt->{"expr"}) == 1;
                emit($cg, "{ StradaValue *__map_elem_" . $map_id . " = ");
                gen_expression($cg, $last_stmt->{"expr"});
                emit($cg, "; ");
                emit($cg, "StradaValue *__flat_val_" . $map_id . " = __map_elem_" . $map_id . "; ");
                emit($cg, "if (__flat_val_" . $map_id . " && !STRADA_IS_TAGGED_INT(__flat_val_" . $map_id . ") && __flat_val_" . $map_id . "->type == STRADA_REF) { ");
                emit($cg, "__flat_val_" . $map_id . " = __flat_val_" . $map_id . "->value.rv; } ");
                emit($cg, "if (__flat_val_" . $map_id . " && !STRADA_IS_TAGGED_INT(__flat_val_" . $map_id . ") && __flat_val_" . $map_id . "->type == STRADA_ARRAY) { ");
                emit($cg, "StradaArray *__flat_arr_" . $map_id . " = __flat_val_" . $map_id . "->value.av; ");
                emit($cg, "for (size_t __flat_j_" . $map_id . " = 0; __flat_j_" . $map_id . " < __flat_arr_" . $map_id . "->size; __flat_j_" . $map_id . "++) { ");
                emit($cg, "strada_array_push(__map_result_" . $map_id . "->value.av, __flat_arr_" . $map_id . "->elements[__flat_arr_" . $map_id . "->head + __flat_j_" . $map_id . "]); } ");
                if ($map_el_owned == 1) {
                    emit($cg, "strada_decref(__map_elem_" . $map_id . "); ");
                }
                emit($cg, "} else { ");
                if ($map_el_owned == 1) {
                    emit($cg, "strada_array_push_take(__map_result_" . $map_id . "->value.av, __map_elem_" . $map_id . "); } } ");
                } else {
                    emit($cg, "strada_array_push(__map_result_" . $map_id . "->value.av, __map_elem_" . $map_id . "); } } ");
                }
            } else {
                gen_statement($cg, $last_stmt);
            }
        }
        scope_pop($cg);
        if ($map_has_local == 1) {
            local_mark_pop($cg);
            emit($cg, "strada_local_restore_to(" . $m_lmark . "); ");
        }
        scope_pop($cg);

        $cg->{"in_map_block"} = $saved_in_map;
        $cg->{"current_elem_var"} = $saved_map_elem;
        $cg->{"loop_break_depth"} = $saved_map_brk;
        $cg->{"loop_redo_depth"} = $saved_map_redo;
        $cg->{"loop_try_depth"} = $saved_map_try;
        $cg->{"loop_local_var"} = $saved_map_lvar;
        $cg->{"loop_finally_mark"} = $saved_map_fmark;
        $cg->{"current_redo_label"} = $saved_map_rlbl;

        emit($cg, "} ");
        # Pop the cleanup-stack entries we pushed (result, then optionally source).
        if ($cg->{"cleanup_enabled"} == 1) {
            foreach_cleanup_leave($cg);
            emit($cg, "strada_cleanup_pop(); ");
        }
        if ($map_arr_cleanup == 1) {
            foreach_cleanup_leave($cg);
            emit($cg, "strada_cleanup_pop_decref(__map_sv_" . $map_id . "); ");
        }
        emit($cg, "__map_result_" . $map_id . "; })");
        return;
    }

    # Sort expression: sort { $a <=> $b } @array
    if ($type == NODE_SORT()) {
        my scalar $block = $expr->{"block"};
        my scalar $array_expr = $expr->{"array"};

        # Default sort (no block)
        if (!$block) {
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $array_expr) == 1) {
                emit($cg, "({ StradaValue *__sort_a = ");
                gen_expression($cg, $array_expr);
                emit($cg, "; StradaValue *__sort_r = strada_sort(__sort_a); strada_decref(__sort_a); __sort_r; })");
            } else {
                emit($cg, "strada_sort(");
                gen_expression($cg, $array_expr);
                emit($cg, ")");
            }
            return;
        }

        # Custom sort with comparator block
        my int $sort_id = $cg->{"sort_counter"};
        $cg->{"sort_counter"} = $sort_id + 1;

        my int $sort_blk_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $array_expr) == 1;
        emit($cg, "({ ");
        if ($sort_blk_cleanup == 1) {
            emit($cg, "StradaValue *__sort_sv_" . $sort_id . " = ");
            gen_expression($cg, $array_expr);
            emit($cg, "; strada_cleanup_push(__sort_sv_" . $sort_id . "); StradaValue *__sort_result_" . $sort_id . " = strada_sort_copy_input(__sort_sv_" . $sort_id . "); strada_cleanup_push(__sort_result_" . $sort_id . "); ");
        } else {
            emit($cg, "StradaValue *__sort_result_" . $sort_id . " = strada_sort_copy_input(");
            gen_expression($cg, $array_expr);
            emit($cg, "); strada_cleanup_push(__sort_result_" . $sort_id . "); ");
        }
        emit($cg, "int __sort_len_" . $sort_id . " = strada_array_length(strada_deref_array(__sort_result_" . $sort_id . ")); ");
        # Bottom-up merge sort with the inlined comparator — O(n log n), stable.
        # Permutes the result array's element pointers in place via a scratch
        # buffer (pure pointer moves: refcount-neutral, no incref/decref of the
        # elements). The single comparison site below evaluates the user block
        # with $a/$b bound to __sort_a_/__sort_b_. (Replaced the original
        # O(n^2) bubble sort.)
        emit($cg, "StradaArray *__res_" . $sort_id . " = strada_deref_array(__sort_result_" . $sort_id . "); ");
        emit($cg, "StradaValue **__src_" . $sort_id . " = __res_" . $sort_id . "->elements + __res_" . $sort_id . "->head; ");
        # The merge scratch buffer is wrapped in a cleanup-tracked CSTRUCT value
        # so a comparator that throws (longjmp past the free below) still has it
        # reclaimed by the catch handler's cleanup-stack drain. See
        # strada_sortbuf_new() in the runtime.
        emit($cg, "StradaValue *__bufsv_" . $sort_id . " = strada_sortbuf_new(__sort_len_" . $sort_id . "); strada_cleanup_push(__bufsv_" . $sort_id . "); ");
        emit($cg, "StradaValue **__buf_" . $sort_id . " = (StradaValue**)__bufsv_" . $sort_id . "->value.ptr; ");
        emit($cg, "for (int __w_" . $sort_id . " = 1; __w_" . $sort_id . " < __sort_len_" . $sort_id . "; __w_" . $sort_id . " *= 2) { ");
        emit($cg, "for (int __lo_" . $sort_id . " = 0; __lo_" . $sort_id . " < __sort_len_" . $sort_id . "; __lo_" . $sort_id . " += __w_" . $sort_id . " + __w_" . $sort_id . ") { ");
        emit($cg, "int __mid_" . $sort_id . " = __lo_" . $sort_id . " + __w_" . $sort_id . "; if (__mid_" . $sort_id . " > __sort_len_" . $sort_id . ") __mid_" . $sort_id . " = __sort_len_" . $sort_id . "; ");
        emit($cg, "int __hi_" . $sort_id . " = __lo_" . $sort_id . " + __w_" . $sort_id . " + __w_" . $sort_id . "; if (__hi_" . $sort_id . " > __sort_len_" . $sort_id . ") __hi_" . $sort_id . " = __sort_len_" . $sort_id . "; ");
        emit($cg, "int __i_" . $sort_id . " = __lo_" . $sort_id . "; int __j_" . $sort_id . " = __mid_" . $sort_id . "; int __k_" . $sort_id . " = __lo_" . $sort_id . "; ");
        my str $sort_a_var = "__sort_a_" . $sort_id;
        my str $sort_b_var = "__sort_b_" . $sort_id;
        emit($cg, "while (__i_" . $sort_id . " < __mid_" . $sort_id . " && __j_" . $sort_id . " < __hi_" . $sort_id . ") { ");
        emit($cg, "StradaValue *" . $sort_a_var . " = __src_" . $sort_id . "[__i_" . $sort_id . "]; ");
        emit($cg, "StradaValue *" . $sort_b_var . " = __src_" . $sort_id . "[__j_" . $sort_id . "]; ");
        emit($cg, "StradaValue *__cmp_sv_" . $sort_id . " = ");

        my int $saved_in_sort = $cg->{"in_sort_block"} + 0;
        my str $saved_sort_a = "" . $cg->{"current_sort_a"};
        my str $saved_sort_b = "" . $cg->{"current_sort_b"};
        $cg->{"in_sort_block"} = 1;
        $cg->{"current_sort_a"} = $sort_a_var;
        $cg->{"current_sort_b"} = $sort_b_var;

        my scalar $stmts = $block->{"statements"};
        my int $stmt_count = $block->{"statement_count"};
        my str $sort_err = "error: sort comparator block must be a single comparison expression";
        if ($stmt_count != 1) {
            die($sort_err);
        }
        my scalar $last_stmt = $stmts->[0];
        my int $cmp_owned = 1;
        if ($last_stmt->{"type"} == NODE_EXPR_STMT()) {
            $cmp_owned = needs_temp_cleanup($cg, $last_stmt->{"expr"});
            gen_expression($cg, $last_stmt->{"expr"});
        } elsif ($last_stmt->{"type"} == NODE_RETURN_STMT() && defined($last_stmt->{"value"})) {
            $cmp_owned = needs_temp_cleanup($cg, $last_stmt->{"value"});
            gen_expression($cg, $last_stmt->{"value"});
        } else {
            die($sort_err);
        }

        $cg->{"in_sort_block"} = $saved_in_sort;
        $cg->{"current_sort_a"} = $saved_sort_a;
        $cg->{"current_sort_b"} = $saved_sort_b;

        emit($cg, "; int __cmp_" . $sort_id . " = strada_to_int(__cmp_sv_" . $sort_id . "); ");
        if ($cmp_owned == 1) {
            emit($cg, "strada_decref(__cmp_sv_" . $sort_id . "); ");
        }
        # __cmp <= 0 keeps the left run's element first → stable sort.
        emit($cg, "if (__cmp_" . $sort_id . " <= 0) { __buf_" . $sort_id . "[__k_" . $sort_id . "++] = __src_" . $sort_id . "[__i_" . $sort_id . "++]; } ");
        emit($cg, "else { __buf_" . $sort_id . "[__k_" . $sort_id . "++] = __src_" . $sort_id . "[__j_" . $sort_id . "++]; } } ");
        emit($cg, "while (__i_" . $sort_id . " < __mid_" . $sort_id . ") { __buf_" . $sort_id . "[__k_" . $sort_id . "++] = __src_" . $sort_id . "[__i_" . $sort_id . "++]; } ");
        emit($cg, "while (__j_" . $sort_id . " < __hi_" . $sort_id . ") { __buf_" . $sort_id . "[__k_" . $sort_id . "++] = __src_" . $sort_id . "[__j_" . $sort_id . "++]; } ");
        emit($cg, "for (int __m_" . $sort_id . " = __lo_" . $sort_id . "; __m_" . $sort_id . " < __hi_" . $sort_id . "; __m_" . $sort_id . "++) { __src_" . $sort_id . "[__m_" . $sort_id . "] = __buf_" . $sort_id . "[__m_" . $sort_id . "]; } ");
        emit($cg, "} } ");
        emit($cg, "strada_cleanup_pop_decref(__bufsv_" . $sort_id . "); ");
        emit($cg, "strada_cleanup_pop(); ");
        if ($sort_blk_cleanup == 1) {
            emit($cg, "strada_cleanup_pop_decref(__sort_sv_" . $sort_id . "); ");
        }
        emit($cg, "__sort_result_" . $sort_id . "; })");
        return;
    }

    # Grep expression: grep { block } @array
    if ($type == NODE_GREP()) {
        my scalar $block = $expr->{"block"};
        my scalar $array_expr = $expr->{"array"};
        my int $grep_id = $cg->{"grep_counter"};
        $cg->{"grep_counter"} = $grep_id + 1;

        my int $grep_arr_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $array_expr) == 1;
        # Lazy-range fast path (mirrors map): grep over an int-typed range
        # iterates natively — no input array materialization.
        my int $grep_is_range = 0;
        if ($array_expr->{"type"} == NODE_RANGE()
            && expr_is_int_typed($cg, $array_expr->{"start"}) == 1
            && expr_is_int_typed($cg, $array_expr->{"end"}) == 1) {
            $grep_is_range = 1;
            $grep_arr_cleanup = 0;
        }
        my int $saved_grep_depth = $cg->{"scope_depth"};
        my int $saved_grep_brk = $cg->{"loop_break_depth"};
        my int $saved_grep_redo = $cg->{"loop_redo_depth"};
        my int $saved_grep_try = $cg->{"loop_try_depth"};
        my str $saved_grep_lvar = "" . $cg->{"loop_local_var"};
        my int $saved_grep_fmark = $cg->{"loop_finally_mark"};
        my str $saved_grep_rlbl = "" . $cg->{"current_redo_label"};
        emit($cg, "({ ");
        if ($grep_is_range == 1) {
            emit($cg, "int64_t __grep_rs_" . $grep_id . " = ");
            emit_int_operand($cg, $array_expr->{"start"});
            emit($cg, "; int64_t __grep_re_" . $grep_id . " = ");
            emit_int_operand($cg, $array_expr->{"end"});
            emit($cg, "; ");
        } elsif ($grep_arr_cleanup == 1) {
            emit($cg, "StradaValue *__grep_sv_" . $grep_id . " = ");
            gen_expression($cg, $array_expr);
            emit($cg, "; strada_cleanup_push(__grep_sv_" . $grep_id . "); ");
            foreach_cleanup_enter($cg, $saved_grep_depth, "__grep_sv_" . $grep_id);
            emit($cg, "StradaArray *__grep_input_" . $grep_id . " = strada_deref_array(__grep_sv_" . $grep_id . "); ");
        } else {
            emit($cg, "StradaArray *__grep_input_" . $grep_id . " = strada_deref_array(");
            gen_expression($cg, $array_expr);
            emit($cg, "); ");
        }
        emit($cg, "StradaValue *__grep_result_" . $grep_id . " = strada_new_array(); ");
        if ($cg->{"cleanup_enabled"} == 1) {
            emit($cg, "strada_cleanup_push(__grep_result_" . $grep_id . "); ");
            foreach_cleanup_enter($cg, $saved_grep_depth, "__grep_result_" . $grep_id);
        }
        my str $grep_el_var = "__grep_e_" . $grep_id;
        if ($grep_is_range == 1) {
            emit($cg, "for (int64_t __grep_i_" . $grep_id . " = __grep_rs_" . $grep_id . "; __grep_i_" . $grep_id . " <= __grep_re_" . $grep_id . "; __grep_i_" . $grep_id . "++) { ");
            emit($cg, "StradaValue *" . $grep_el_var . " = strada_new_int_il(__grep_i_" . $grep_id . "); ");
        } else {
            emit($cg, "int __grep_len_" . $grep_id . " = strada_array_length(__grep_input_" . $grep_id . "); ");
            emit($cg, "for (int __grep_i_" . $grep_id . " = 0; __grep_i_" . $grep_id . " < __grep_len_" . $grep_id . "; __grep_i_" . $grep_id . "++) { ");
            emit($cg, "StradaValue *" . $grep_el_var . " = strada_array_get(__grep_input_" . $grep_id . ", __grep_i_" . $grep_id . "); ");
        }

        my int $saved_in_grep = $cg->{"in_grep_block"} + 0;
        my str $saved_grep_elem = "" . $cg->{"current_elem_var"};
        $cg->{"in_grep_block"} = 1;
        $cg->{"current_elem_var"} = $grep_el_var;
        my int $grep_has_local = stmt_has_local($block);
        my int $grep_local_id = 0;
        my str $g_lmark = "";
        scope_push($cg);
        $cg->{"loop_break_depth"} = $cg->{"scope_depth"};
        $cg->{"loop_redo_depth"} = $cg->{"scope_depth"};
        $cg->{"loop_try_depth"} = $cg->{"try_depth"};
        $cg->{"loop_local_var"} = "";
        $cg->{"loop_finally_mark"} = $cg->{"finally_count"};
        if ($grep_has_local == 1) {
            $grep_local_id = $cg->{"tmp_counter"} + 0;
            $cg->{"tmp_counter"} = $grep_local_id + 1;
            $g_lmark = "__local_grep_mark_" . $grep_local_id;
            emit($cg, "int " . $g_lmark . " = strada_local_depth_get(); ");
            local_mark_push($cg, $cg->{"scope_depth"}, $g_lmark);
            $cg->{"loop_local_var"} = $g_lmark;
        }
        my str $grep_redo_lbl = "__grep_redo_" . $grep_id;
        $cg->{"current_redo_label"} = $grep_redo_lbl;
        emit($cg, $grep_redo_lbl . ": __attribute__((unused)); ");
        scope_push($cg);

        my scalar $stmts = $block->{"statements"};
        my int $stmt_count = $block->{"statement_count"};
        if ($stmt_count > 0) {
            my int $gi = 0;
            while ($gi < $stmt_count - 1) {
                gen_statement($cg, $stmts->[$gi]);
                $gi = $gi + 1;
            }
            my scalar $last_stmt = $stmts->[$stmt_count - 1];
            if ($last_stmt->{"type"} == NODE_EXPR_STMT()) {
                if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $last_stmt->{"expr"}) == 1) {
                    emit($cg, "if (({ StradaValue *__grep_cond = ");
                    gen_expression($cg, $last_stmt->{"expr"});
                    emit($cg, "; int __grep_bool = strada_to_bool(__grep_cond); strada_decref(__grep_cond); __grep_bool; })) { strada_array_push(strada_deref_array(__grep_result_" . $grep_id . "), " . $grep_el_var . "); } ");
                } else {
                    emit($cg, "if (strada_to_bool(");
                    gen_expression($cg, $last_stmt->{"expr"});
                    emit($cg, ")) { strada_array_push(strada_deref_array(__grep_result_" . $grep_id . "), " . $grep_el_var . "); } ");
                }
            } else {
                gen_statement($cg, $last_stmt);
            }
        }
        scope_pop($cg);
        if ($grep_has_local == 1) {
            local_mark_pop($cg);
            emit($cg, "strada_local_restore_to(" . $g_lmark . "); ");
        }
        scope_pop($cg);

        $cg->{"in_grep_block"} = $saved_in_grep;
        $cg->{"current_elem_var"} = $saved_grep_elem;
        $cg->{"loop_break_depth"} = $saved_grep_brk;
        $cg->{"loop_redo_depth"} = $saved_grep_redo;
        $cg->{"loop_try_depth"} = $saved_grep_try;
        $cg->{"loop_local_var"} = $saved_grep_lvar;
        $cg->{"loop_finally_mark"} = $saved_grep_fmark;
        $cg->{"current_redo_label"} = $saved_grep_rlbl;
        emit($cg, "} ");
        if ($cg->{"cleanup_enabled"} == 1) {
            foreach_cleanup_leave($cg);
            emit($cg, "strada_cleanup_pop(); ");
        }
        if ($grep_arr_cleanup == 1) {
            foreach_cleanup_leave($cg);
            emit($cg, "strada_cleanup_pop_decref(__grep_sv_" . $grep_id . "); ");
        }
        emit($cg, "__grep_result_" . $grep_id . "; })");
        return;
    }

    # Anonymous function
    if ($type == NODE_ANON_FUNC()) {
        my int $id = $cg->{"anon_func_counter"};
        $cg->{"anon_func_counter"} = $id + 1;
        my str $func_name = "__anon_func_" . $id;

        my scalar $params = $expr->{"params"};
        my int $param_count = $expr->{"param_count"};

        # Save current capture state (for nested closures)
        my int $saved_in_anon = $cg->{"in_anon_func"};
        my str $saved_param_str = $cg->{"anon_param_str"};
        my str $saved_local_str = $cg->{"anon_local_str"};
        my str $saved_capture_str = $cg->{"anon_capture_str"};
        my int $saved_capture_count = $cg->{"anon_capture_count"};
        my int $saved_ret_is_int = $cg->{"ret_is_int"};
        my int $saved_ret_is_num = $cg->{"ret_is_num"};

        # Set up capture context for this closure
        $cg->{"in_anon_func"} = 1;
        $cg->{"anon_local_str"} = "";
        $cg->{"anon_capture_str"} = "";
        $cg->{"anon_capture_count"} = 0;
        # The closure body's returns coerce by ITS return type, not the
        # enclosing function's (see gen_return_value)
        $cg->{"ret_is_int"} = 0;
        if ($expr->{"return_type"} == TYPE_INT()) {
            $cg->{"ret_is_int"} = 1;
        }
        $cg->{"ret_is_num"} = 0;
        if ($expr->{"return_type"} == TYPE_NUM()) {
            $cg->{"ret_is_num"} = 1;
        }

        my scalar $anon_body = $expr->{"body"};
        my int $anon_has_try = func_body_has_try($anon_body);
        my hash %anon_cand_boxed = ();
        if (stmt_has_c_block($anon_body) == 0) {
            ast_collect_anon_var_refs($anon_body, \%anon_cand_boxed, 0);
        }

        # Build param string from parameters
        my str $param_str = "";
        my int $i = 0;
        while ($i < $param_count) {
            my scalar $p = $params->[$i];
            if ($param_str eq "") {
                $param_str = $p->{"name"};
            } else {
                $param_str = $param_str . "," . $p->{"name"};
            }
            $i = $i + 1;
        }
        $cg->{"anon_param_str"} = $param_str;

        # Generate forward declaration (triple pointer for capture-by-reference)
        # static: a closure is only referenced in its own C file, and an exported
        # name would be interposed by a same-named one in the host binary when
        # this is a shared library (the .so then ran the host's closure)
        my str $anon_vis = "static ";
        if (length("" . $cg->{"split_dir"}) > 0) {
            $anon_vis = "STRADA_SHARD_HIDDEN ";
        }
        my str $decl = $anon_vis . "StradaValue* " . $func_name . "(StradaValue ***__captures";
        $i = 0;
        while ($i < $param_count) {
            my scalar $p = $params->[$i];
            my str $ap_cname = escape_c_keyword($p->{"name"});
            my str $ap_sig = "" . $p->{"sigil"};
            my str $ap_emit = $ap_cname;
            if (($anon_cand_boxed{$ap_cname} + 0) == 1 && length("" . $p->{"struct_name"}) == 0 && $ap_sig ne "@" && $ap_sig ne "%") {
                $ap_emit = "__rawp_" . $ap_cname;
            }
            if ($anon_has_try == 1) {
                $decl = $decl . ", StradaValue * volatile " . $ap_emit;
            } else {
                $decl = $decl . ", StradaValue *" . $ap_emit;
            }
            $i = $i + 1;
        }
        $decl = $decl . ")";
        $cg->{"anon_func_decls"} = $cg->{"anon_func_decls"} . $decl . ";\n";
        if (length("" . $cg->{"split_dir"}) > 0) {
            $cg->{"split_anon_proto_map"}->{$func_name} = $decl . ";\n";
        }

        my str $def = $decl . " {\n";

        # Save current output (using StringBuilder)
        my str $saved_output = sb_to_string($cg->{"output_sb"});
        my int $saved_indent = $cg->{"indent"};
        my int $saved_in_main = $cg->{"in_main"};

        # Save scope and per-function state (closures are separate C functions)
        my scalar $saved_scope_vars = $cg->{"scope_vars"};
        my scalar $saved_scope_counts = $cg->{"scope_counts"};
        my scalar $saved_scope_no_push = $cg->{"scope_no_push_vars"};
        my str $saved_cur_no_push = "" . $cg->{"current_no_push_str"};
        my int $saved_scope_depth = $cg->{"scope_depth"};

        my scalar $saved_func_params = $cg->{"func_params"};
        my scalar $saved_func_param_names = $cg->{"func_param_names"};
        my int $saved_func_param_count = $cg->{"func_param_count"};
        my scalar $saved_func_param_is_int = $cg->{"func_param_is_int"};
        my scalar $saved_func_param_skip_wrap = $cg->{"func_param_skip_wrap"};
        my scalar $saved_fe_cl_names = $cg->{"fe_cl_names"};
        my scalar $saved_fe_cl_depths = $cg->{"fe_cl_depths"};
        my int $saved_fe_cl_count = $cg->{"fe_cl_count"} + 0;
        foreach_cleanup_reset($cg);
        my scalar $saved_known_types = $cg->{"known_types"};
        $cg->{"known_types"} = {};

        my int $saved_try_depth = $cg->{"try_depth"} + 0;
        my int $saved_catch_cleanup = $cg->{"catch_cleanup_count"} + 0;
        my scalar $saved_finally_blocks = $cg->{"finally_blocks"};
        my int $saved_finally_count = $cg->{"finally_count"} + 0;
        my scalar $saved_try_finally_blocks = $cg->{"try_finally_blocks"};
        my int $saved_has_local = $cg->{"has_local"} + 0;
        my scalar $saved_int_vars = $cg->{"int_vars"};
        my scalar $saved_num_vars = $cg->{"num_vars"};
        my int $saved_loop_break_depth = $cg->{"loop_break_depth"} + 0;
        my int $saved_loop_redo_depth = $cg->{"loop_redo_depth"} + 0;
        my str $saved_loop_local_var = "" . $cg->{"loop_local_var"};
        my int $saved_loop_try_depth = $cg->{"loop_try_depth"} + 0;
        my int $saved_loop_finally_mark = $cg->{"loop_finally_mark"} + 0;
        my str $saved_cur_redo_lbl = "" . $cg->{"current_redo_label"};

        # Start fresh for function body (closures are NOT main)
        sb_clear($cg->{"output_sb"});
        $cg->{"indent"} = 1;
        $cg->{"in_main"} = 0;

        my array @new_scope_vars = ();
        my array @new_scope_counts = ();
        my array @new_scope_no_push = ();
        my array @new_finally_blocks = ();
        my array @new_try_finally_blocks = ();
        $cg->{"scope_vars"} = \@new_scope_vars;
        $cg->{"scope_counts"} = \@new_scope_counts;
        $cg->{"scope_no_push_vars"} = \@new_scope_no_push;
        $cg->{"current_no_push_str"} = "";
        $cg->{"scope_depth"} = 0;

        $cg->{"func_params"} = {};
        $cg->{"func_param_names"} = [];
        $cg->{"func_param_count"} = 0;
        $cg->{"func_param_is_int"} = [];
        $cg->{"func_param_skip_wrap"} = [];
        $cg->{"try_depth"} = 0;
        $cg->{"catch_cleanup_count"} = 0;
        $cg->{"finally_blocks"} = \@new_finally_blocks;
        $cg->{"finally_count"} = 0;
        $cg->{"try_finally_blocks"} = \@new_try_finally_blocks;
        $cg->{"has_local"} = 0;
        $cg->{"int_vars"} = {};
        $cg->{"num_vars"} = {};
        $cg->{"loop_break_depth"} = 0;
        $cg->{"loop_redo_depth"} = 0;
        $cg->{"loop_local_var"} = "";
        $cg->{"loop_try_depth"} = 0;
        $cg->{"loop_finally_mark"} = 0;
        $cg->{"current_redo_label"} = "";

        my int $saved_func_has_try = $cg->{"func_has_try"};
        my int $saved_func_tracks_depth = $cg->{"func_tracks_depth"} + 0;
        my scalar $saved_struct_vars = $cg->{"struct_vars"};
        my scalar $saved_cand_boxed = $cg->{"cand_boxed_vars"};
        my scalar $saved_active_boxed = $cg->{"active_boxed_vars"};
        my scalar $saved_locals_seen = $cg->{"func_locals_seen"};
        my scalar $saved_label_depths = $cg->{"label_depths"};
        my scalar $saved_label_try_depths = $cg->{"label_try_depths"};
        my scalar $saved_goto_label_depths = $cg->{"goto_label_depths"};
        my scalar $saved_goto_label_try_depths = $cg->{"goto_label_try_depths"};
        my scalar $saved_local_marks = $cg->{"local_marks"};
        my int $saved_c_ret_is_sv = $cg->{"c_ret_is_sv"} + 0;
        $cg->{"struct_vars"} = {};
        $cg->{"cand_boxed_vars"} = \%anon_cand_boxed;
        $cg->{"active_boxed_vars"} = {};
        $cg->{"func_locals_seen"} = copy_type_map($saved_locals_seen);
        $cg->{"label_depths"} = {};
        $cg->{"label_try_depths"} = {};
        $cg->{"goto_label_depths"} = {};
        $cg->{"goto_label_try_depths"} = {};
        $cg->{"local_marks"} = [];
        $cg->{"c_ret_is_sv"} = 1;
        if ($anon_has_try == 1) {
            $cg->{"func_has_try"} = 1;
        } else {
            $cg->{"func_has_try"} = 0;
        }
        if ($cg->{"enable_stack_trace"} == 1) {
            $cg->{"func_tracks_depth"} = 1;
        } elsif ($cg->{"enable_stack_trace"} == 2 && stmt_has_call($anon_body) == 1) {
            $cg->{"func_tracks_depth"} = 2;
        } else {
            $cg->{"func_tracks_depth"} = 0;
        }

        scope_push($cg);
        prescan_goto_labels($cg, $expr->{"body"}->{"statements"}, 1, 0);

        if (func_body_has_local($anon_body) == 1) {
            emit_indent($cg);
            emit($cg, "int __local_saved_depth = strada_local_depth_get();\n");
            $cg->{"has_local"} = 1;
        }

        # Track param types, box closure-captured params into PerlaCells, and wrap mutated unboxed params
        my int $api = 0;
        while ($api < $param_count) {
            my scalar $ap = $params->[$api];
            my str $ap_c = escape_c_keyword($ap->{"name"});
            my str $ap_sig = "" . $ap->{"sigil"};
            $cg->{"func_locals_seen"}->{$ap_c} = 1;
            if ($ap->{"param_type"} == TYPE_INT()) {
                $cg->{"int_vars"}->{$ap_c} = 1;
            } elsif ($ap->{"param_type"} == TYPE_NUM()) {
                $cg->{"num_vars"}->{$ap_c} = 1;
            }
            if (length("" . $ap->{"struct_name"}) > 0) {
                $cg->{"struct_vars"}->{$ap_c} = "" . $ap->{"struct_name"};
            }
            if (($anon_cand_boxed{$ap_c} + 0) == 1 && length("" . $ap->{"struct_name"}) == 0 && $ap_sig ne "@" && $ap_sig ne "%") {
                $cg->{"active_boxed_vars"}->{$ap_c} = 1;
                emit_indent($cg);
                if ($cg->{"func_has_try"} == 1) {
                    emit($cg, "StradaValue ** volatile __cell_" . $ap_c . " = strada_cell_alloc();\n");
                } else {
                    emit($cg, "StradaValue **__cell_" . $ap_c . " = strada_cell_alloc();\n");
                }
                emit_indent($cg);
                emit($cg, "(*__cell_" . $ap_c . ") = strada_copy_scalar_il(__rawp_" . $ap_c . ");\n");
                my str $apc_track = "@cell:" . $ap_c;
                scope_track_var($cg, $apc_track);
                if (cleanup_push_useful($cg) == 1) {
                    emit_indent($cg);
                    emit($cg, "strada_cleanup_push_cell(__cell_" . $ap_c . ");\n");
                } else {
                    scope_mark_no_push($cg, $apc_track);
                }
            } else {
                $cg->{"active_boxed_vars"}->{$ap_c} = 0;
                if ($cg->{"cleanup_enabled"} == 1 && (node_writes_var($anon_body, $ap->{"name"}) == 1 || node_is_leaf_safe($cg, $anon_body) == 0)) {
                    emit_indent($cg);
                    emit($cg, "strada_incref(" . $ap_c . ");\n");
                    scope_track_var($cg, $ap_c);
                    if (cleanup_push_useful($cg) == 1) {
                        emit_indent($cg);
                        emit($cg, "strada_cleanup_push_slot((StradaValue **)&" . $ap_c . ");\n");
                    } else {
                        scope_mark_no_push($cg, $ap_c);
                    }
                }
            }
            $api = $api + 1;
        }

        my scalar $body = $expr->{"body"};
        my scalar $stmts = $body->{"statements"};
        my int $stmt_count = $body->{"statement_count"};
        $i = 0;
        while ($i < $stmt_count) {
            gen_statement($cg, $stmts->[$i]);
            $i = $i + 1;
        }
        scope_pop($cg);
        if ($cg->{"has_local"} == 1) {
            emit_indent($cg);
            emit($cg, "strada_local_restore_to(__local_saved_depth);\n");
        }

        my str $body_content = sb_to_string($cg->{"output_sb"});
        $def = $def . "    (void)__captures;\n";
        if ($cg->{"func_tracks_depth"} == 1) {
            $def = $def . "    strada_stack_push_il(\"<anon>\", " . c_str_lit($cg->{"filename"}) . ");\n";
        } elsif ($cg->{"func_tracks_depth"} == 2) {
            $def = $def . "    strada_depth_push_il(\"<anon>\", " . c_str_lit($cg->{"filename"}) . ");\n";
        }
        $def = $def . $body_content;

        if ($cg->{"func_tracks_depth"} == 1) {
            $def = $def . "    strada_stack_pop_il();\n";
        } elsif ($cg->{"func_tracks_depth"} == 2) {
            $def = $def . "    strada_depth_pop_il();\n";
        }
        $def = $def . "    return strada_undef_static();\n";

        $def = $def . "}\n\n";

        my str $capture_str = $cg->{"anon_capture_str"};
        my int $capture_count = $cg->{"anon_capture_count"};

        sb_clear($cg->{"output_sb"});
        sb_append($cg->{"output_sb"}, $saved_output);
        $cg->{"indent"} = $saved_indent;
        $cg->{"in_main"} = $saved_in_main;

        $cg->{"scope_vars"} = $saved_scope_vars;
        $cg->{"scope_counts"} = $saved_scope_counts;
        $cg->{"scope_no_push_vars"} = $saved_scope_no_push;
        $cg->{"current_no_push_str"} = $saved_cur_no_push;
        $cg->{"scope_depth"} = $saved_scope_depth;

        $cg->{"func_params"} = $saved_func_params;
        $cg->{"func_param_names"} = $saved_func_param_names;
        $cg->{"func_param_count"} = $saved_func_param_count;
        $cg->{"func_param_is_int"} = $saved_func_param_is_int;
        $cg->{"func_param_skip_wrap"} = $saved_func_param_skip_wrap;
        $cg->{"fe_cl_names"} = $saved_fe_cl_names;
        $cg->{"fe_cl_depths"} = $saved_fe_cl_depths;
        $cg->{"fe_cl_count"} = $saved_fe_cl_count;
        $cg->{"known_types"} = $saved_known_types;
        invalidate_written_known_types($cg, $expr->{"body"});
        $cg->{"try_depth"} = $saved_try_depth;
        $cg->{"catch_cleanup_count"} = $saved_catch_cleanup;
        $cg->{"finally_blocks"} = $saved_finally_blocks;
        $cg->{"finally_count"} = $saved_finally_count;
        $cg->{"try_finally_blocks"} = $saved_try_finally_blocks;
        $cg->{"has_local"} = $saved_has_local;
        $cg->{"int_vars"} = $saved_int_vars;
        $cg->{"num_vars"} = $saved_num_vars;
        $cg->{"loop_break_depth"} = $saved_loop_break_depth;
        $cg->{"loop_redo_depth"} = $saved_loop_redo_depth;
        $cg->{"loop_local_var"} = $saved_loop_local_var;
        $cg->{"loop_try_depth"} = $saved_loop_try_depth;
        $cg->{"loop_finally_mark"} = $saved_loop_finally_mark;
        $cg->{"current_redo_label"} = $saved_cur_redo_lbl;

        $cg->{"in_anon_func"} = $saved_in_anon;
        $cg->{"anon_param_str"} = $saved_param_str;
        $cg->{"anon_local_str"} = $saved_local_str;
        $cg->{"anon_capture_str"} = $saved_capture_str;
        $cg->{"anon_capture_count"} = $saved_capture_count;
        $cg->{"ret_is_int"} = $saved_ret_is_int;
        $cg->{"ret_is_num"} = $saved_ret_is_num;

        $cg->{"func_has_try"} = $saved_func_has_try;
        $cg->{"func_tracks_depth"} = $saved_func_tracks_depth;
        $cg->{"struct_vars"} = $saved_struct_vars;
        $cg->{"cand_boxed_vars"} = $saved_cand_boxed;
        $cg->{"active_boxed_vars"} = $saved_active_boxed;
        $cg->{"func_locals_seen"} = $saved_locals_seen;
        $cg->{"label_depths"} = $saved_label_depths;
        $cg->{"label_try_depths"} = $saved_label_try_depths;
        $cg->{"goto_label_depths"} = $saved_goto_label_depths;
        $cg->{"goto_label_try_depths"} = $saved_goto_label_try_depths;
        $cg->{"local_marks"} = $saved_local_marks;
        $cg->{"c_ret_is_sv"} = $saved_c_ret_is_sv;

        $cg->{"anon_func_defs"} = $cg->{"anon_func_defs"} . $def;

        # Emit closure creation with captures (using PerlaCell mode 0 / static global mode 1 / boxed local mode 2)
        if ($capture_count == 0) {
            emit($cg, "strada_closure_new((void*)&" . $func_name . ", " . $param_count . ", 0, NULL)");
        } else {
            my str $ptrs_str = "";
            my str $modes_str = "";
            my int $cap_idx = 0;
            my int $start = 0;
            my int $len = length($capture_str);
            $i = 0;
            while ($i <= $len) {
                my str $ch = "";
                if ($i < $len) { $ch = substr($capture_str, $i, 1); }
                if ($ch eq "," || $i == $len) {
                    if ($cap_idx > 0) {
                        $ptrs_str = $ptrs_str . ", ";
                        $modes_str = $modes_str . ", ";
                    }
                    my str $cap_name = substr($capture_str, $start, $i - $start);
                    my str $c_cap = escape_c_keyword($cap_name);
                    my int $pass_idx = 0 - 1;
                    if ($cg->{"in_anon_func"} == 1) {
                        if (get_capture_index($cg->{"anon_param_str"}, $cap_name) < 0 &&
                            get_capture_index($cg->{"anon_local_str"}, $cap_name) < 0) {
                            $pass_idx = get_capture_index($cg->{"anon_capture_str"}, $cap_name);
                            if ($pass_idx < 0) {
                                if ($cg->{"anon_capture_str"} eq "") {
                                    $cg->{"anon_capture_str"} = $cap_name;
                                } else {
                                    $cg->{"anon_capture_str"} = $cg->{"anon_capture_str"} . "," . $cap_name;
                                }
                                $pass_idx = $cg->{"anon_capture_count"};
                                $cg->{"anon_capture_count"} = $pass_idx + 1;
                            }
                        }
                    }
                    if ($pass_idx >= 0) {
                        $ptrs_str = $ptrs_str . "__captures[" . $pass_idx . "]";
                        if (($cg->{"file_globals"}->{$c_cap} + 0) == 1 && ($cg->{"func_locals_seen"}->{$c_cap} + 0) == 0) {
                            $modes_str = $modes_str . "1";
                        } else {
                            $modes_str = $modes_str . "0";
                        }
                    } else {
                        if (($cg->{"active_boxed_vars"}->{$c_cap} + 0) == 1 || ("" . $cg->{"declaring_boxed_var"}) eq $c_cap) {
                            $ptrs_str = $ptrs_str . "__cell_" . $c_cap;
                            $modes_str = $modes_str . "0";
                        } elsif (($cg->{"file_globals"}->{$c_cap} + 0) == 1 && ($cg->{"func_locals_seen"}->{$c_cap} + 0) == 0) {
                            $ptrs_str = $ptrs_str . "(StradaValue**)&" . $c_cap;
                            $modes_str = $modes_str . "1";
                        } else {
                            $ptrs_str = $ptrs_str . "(StradaValue**)&" . $c_cap;
                            $modes_str = $modes_str . "2";
                        }
                    }
                    $cap_idx = $cap_idx + 1;
                    $start = $i + 1;
                }
                $i = $i + 1;
            }
            emit($cg, "strada_closure_new_shared((void*)&" . $func_name . ", " . $param_count . ", " . $capture_count . ", (StradaValue**[]){" . $ptrs_str . "}, (unsigned char[]){" . $modes_str . "})");
        }
        return;
    }

    # Closure call
    if ($type == NODE_CLOSURE_CALL()) {
        my scalar $args = $expr->{"args"};
        my int $arg_count = $expr->{"arg_count"};

        # Check if callee expression needs cleanup (e.g. hash access returning owned ref)
        my int $callee_cleanup = 0;
        if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $expr->{"closure"}) == 1) {
            $callee_cleanup = 1;
        }

        # Check if any argument needs cleanup
        my int $needs_arg_cleanup = 0;
        if ($cg->{"cleanup_enabled"} == 1 && $arg_count > 0) {
            my int $ca = 0;
            while ($ca < $arg_count) {
                if (needs_temp_cleanup($cg, $args->[$ca]) == 1) {
                    $needs_arg_cleanup = 1;
                }
                $ca = $ca + 1;
            }
        }

        my int $use_cl_stack = cleanup_push_useful($cg);
        if ($expr->{"has_spread"} == 1 || $arg_count > 16) {
            emit($cg, "({ StradaValue *__cl_fn2 = ");
            gen_expression($cg, $expr->{"closure"});
            emit($cg, "; ");
            if ($callee_cleanup == 1 && $use_cl_stack == 1) {
                emit($cg, "strada_cleanup_push(__cl_fn2); ");
            }
            emit($cg, "StradaValue *__cl_arr = strada_new_array(); ");
            if ($use_cl_stack == 1) {
                emit($cg, "strada_cleanup_push(__cl_arr); ");
            }
            my int $si = 0;
            while ($si < $arg_count) {
                my scalar $sarg = $args->[$si];
                if ($sarg->{"type"} == NODE_SPREAD()) {
                    my int $sp_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $sarg->{"target"}) == 1;
                    emit($cg, "{ StradaValue *__sp_sv = ");
                    gen_expression($cg, $sarg->{"target"});
                    emit($cg, "; StradaArray *__sp_av = strada_deref_array(__sp_sv); if (__sp_av) { for (size_t __sp_i = 0; __sp_i < __sp_av->size; __sp_i++) strada_array_push(strada_deref_array(__cl_arr), __sp_av->elements[__sp_av->head + __sp_i]); } ");
                    if ($sp_cl == 1) { emit($cg, "strada_decref(__sp_sv); "); }
                    emit($cg, "} ");
                } else {
                    if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $sarg) == 1) {
                        emit($cg, "strada_array_push_take(strada_deref_array(__cl_arr), ");
                    } else {
                        emit($cg, "strada_array_push(strada_deref_array(__cl_arr), ");
                    }
                    gen_expression($cg, $sarg);
                    emit($cg, "); ");
                }
                $si = $si + 1;
            }
            emit($cg, "StradaValue *__cl_res2 = strada_closure_call_array(__cl_fn2, __cl_arr); ");
            if ($use_cl_stack == 1) {
                emit($cg, "strada_cleanup_pop_decref(__cl_arr); ");
            } else {
                emit($cg, "strada_decref(__cl_arr); ");
            }
            if ($callee_cleanup == 1) {
                if ($use_cl_stack == 1) {
                    emit($cg, "strada_cleanup_pop_decref(__cl_fn2); ");
                } else {
                    emit($cg, "strada_decref(__cl_fn2); ");
                }
            }
            emit($cg, "__cl_res2; })");
        } elsif ($needs_arg_cleanup == 1 || $callee_cleanup == 1) {
            emit($cg, "({ ");
            if ($callee_cleanup == 1) {
                emit($cg, "StradaValue *__cl_fn = ");
                gen_expression($cg, $expr->{"closure"});
                emit($cg, "; ");
                if ($use_cl_stack == 1) {
                    emit($cg, "strada_cleanup_push(__cl_fn); ");
                }
            }
            my int $ca = 0;
            while ($ca < $arg_count) {
                emit($cg, "StradaValue *__cla" . $ca . " = ");
                gen_expression($cg, $args->[$ca]);
                emit($cg, "; ");
                if ($use_cl_stack == 1 && needs_temp_cleanup($cg, $args->[$ca]) == 1) {
                    emit($cg, "strada_cleanup_push(__cla" . $ca . "); ");
                }
                $ca = $ca + 1;
            }
            emit($cg, "StradaValue *__clres = strada_closure_call(");
            if ($callee_cleanup == 1) {
                emit($cg, "__cl_fn");
            } else {
                gen_expression($cg, $expr->{"closure"});
            }
            emit($cg, ", " . $arg_count);
            $ca = 0;
            while ($ca < $arg_count) {
                emit($cg, ", __cla" . $ca);
                $ca = $ca + 1;
            }
            emit($cg, "); ");
            $ca = $arg_count - 1;
            while ($ca >= 0) {
                if (needs_temp_cleanup($cg, $args->[$ca]) == 1) {
                    if ($use_cl_stack == 1) {
                        emit($cg, "strada_cleanup_pop_decref(__cla" . $ca . "); ");
                    } else {
                        emit($cg, "strada_decref(__cla" . $ca . "); ");
                    }
                }
                $ca = $ca - 1;
            }
            if ($callee_cleanup == 1) {
                if ($use_cl_stack == 1) {
                    emit($cg, "strada_cleanup_pop_decref(__cl_fn); ");
                } else {
                    emit($cg, "strada_decref(__cl_fn); ");
                }
            }
            emit($cg, "__clres; })");
        } else {
            emit($cg, "strada_closure_call(");
            gen_expression($cg, $expr->{"closure"});
            emit($cg, ", " . $arg_count);
            my int $i = 0;
            while ($i < $arg_count) {
                emit($cg, ", ");
                gen_expression($cg, $args->[$i]);
                $i = $i + 1;
            }
            emit($cg, ")");
        }
        return;
    }

    # Ternary expression: cond ? true_expr : false_expr
    # FIX: When branches return borrowed references (hash/array access), we need
    # to incref the result so it becomes an owned reference. This prevents the
    # "double hash access in ternary" bug where:
    #   defined($h->{"key"}) ? $h->{"key"} : ""
    # would cause memory corruption because the ternary result is a borrowed
    # reference that might be incorrectly decref'd by callers.
    if ($type == NODE_TERNARY()) {
        my int $true_owned = needs_temp_cleanup($cg, $expr->{"true_expr"});
        my int $false_owned = needs_temp_cleanup($cg, $expr->{"false_expr"});

        if (($true_owned == 0 || $false_owned == 0) && $cg->{"cleanup_enabled"} == 1) {
            if ($true_owned == 0 && $false_owned == 0) {
                emit($cg, "({ StradaValue *__tern_tmp = (");
                emit_condition($cg, $expr->{"condition"});
                emit($cg, " ? ");
                gen_expression($cg, $expr->{"true_expr"});
                emit($cg, " : ");
                gen_expression($cg, $expr->{"false_expr"});
                emit($cg, "); __tern_tmp = strada_copy_scalar_il(__tern_tmp); __tern_tmp; })");
            } else {
                emit($cg, "({ StradaValue *__tern_tmp; if (");
                emit_condition($cg, $expr->{"condition"});
                emit($cg, ") { __tern_tmp = ");
                gen_expression($cg, $expr->{"true_expr"});
                emit($cg, ";");
                if ($true_owned == 0) {
                    emit($cg, " __tern_tmp = strada_copy_scalar_il(__tern_tmp);");
                }
                emit($cg, " } else { __tern_tmp = ");
                gen_expression($cg, $expr->{"false_expr"});
                emit($cg, ";");
                if ($false_owned == 0) {
                    emit($cg, " __tern_tmp = strada_copy_scalar_il(__tern_tmp);");
                }
                emit($cg, " } __tern_tmp; })");
            }
        } else {
            emit($cg, "(");
            emit_condition($cg, $expr->{"condition"});
            emit($cg, " ? ");
            gen_expression($cg, $expr->{"true_expr"});
            emit($cg, " : ");
            gen_expression($cg, $expr->{"false_expr"});
            emit($cg, ")");
        }
        return;
    }

    # Range expression: start..end
    if ($type == NODE_RANGE()) {
        my int $start_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $expr->{"start"}) == 1;
        my int $end_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $expr->{"end"}) == 1;
        if ($start_cleanup == 1 || $end_cleanup == 1) {
            emit($cg, "({ ");
            if ($start_cleanup == 1) {
                emit($cg, "StradaValue *__range_s = ");
                gen_expression($cg, $expr->{"start"});
                emit($cg, "; ");
            }
            if ($end_cleanup == 1) {
                emit($cg, "StradaValue *__range_e = ");
                gen_expression($cg, $expr->{"end"});
                emit($cg, "; ");
            }
            emit($cg, "StradaValue *__range_r = strada_range(");
            if ($start_cleanup == 1) {
                emit($cg, "__range_s");
            } else {
                gen_expression($cg, $expr->{"start"});
            }
            emit($cg, ", ");
            if ($end_cleanup == 1) {
                emit($cg, "__range_e");
            } else {
                gen_expression($cg, $expr->{"end"});
            }
            emit($cg, "); ");
            if ($start_cleanup == 1) {
                emit($cg, "strada_decref(__range_s); ");
            }
            if ($end_cleanup == 1) {
                emit($cg, "strada_decref(__range_e); ");
            }
            emit($cg, "__range_r; })");
        } else {
            emit($cg, "strada_range(");
            gen_expression($cg, $expr->{"start"});
            emit($cg, ", ");
            gen_expression($cg, $expr->{"end"});
            emit($cg, ")");
        }
        return;
    }

    # Await expression: await $future
    if ($type == NODE_AWAIT()) {
        if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $expr->{"expr"}) == 1) {
            emit($cg, "({ StradaValue *__aw_f = ");
            gen_expression($cg, $expr->{"expr"});
            emit($cg, "; StradaValue *__aw_r = strada_future_await(__aw_f); strada_decref(__aw_f); __aw_r; })");
        } else {
            emit($cg, "strada_future_await(");
            gen_expression($cg, $expr->{"expr"});
            emit($cg, ")");
        }
        return;
    }

    # Readline expression (diamond operator): <$fh>
    if ($type == NODE_READLINE()) {
        my str $varname = $expr->{"varname"};
        if (length($varname) == 0) {
            emit($cg, "strada_readline()");
            return;
        }
        my str $rl_cname = escape_c_keyword($varname);
        my str $rl_our = "" . $cg->{"our_vars"}->{$rl_cname};
        if (length($rl_our) > 0) {
            emit($cg, "({ StradaValue *__rl_fh = strada_global_get_cstr(" . c_str_lit($rl_our) . "); StradaValue *__rl_r = strada_read_line(__rl_fh); strada_decref(__rl_fh); __rl_r; })");
        } else {
            emit($cg, "strada_read_line(" . scalar_var_c_ref($cg, $varname, $rl_cname) . ")");
        }
        return;
    }

    # Spread operator - only valid inside function call arguments
    # If we reach here, the spread is being used incorrectly
    if ($type == NODE_SPREAD()) {
        die("error: spread operator (...) is only valid in function call arguments");
        return;
    }
}

