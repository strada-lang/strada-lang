# ===== Multi-part concat flattening =====
# String interpolation desugars (in the parser) to left-deep `.` chains:
# "a $x b $y" => ((("a " . $x) . " b ") . $y). The pairwise emitter costs
# one concat call per part plus growth reallocs on the accumulator. For
# chains of >= 3 leaf parts, flatten the tree and emit ONE
# strada_concat_multi(...) call: the runtime sizes every part, allocates
# the result StradaString exactly once, and memcpys the parts in.

# Count the leaf parts of a `.` chain.
func concat_chain_count(scalar $node) int {
    if ($node->{"type"} == NODE_BINARY_OP() && $node->{"op"} eq ".") {
        return concat_chain_count($node->{"left"}) + concat_chain_count($node->{"right"});
    }
    return 1;
}

# Collect leaf parts left-to-right into $st->{"nodes"} / $st->{"n"}.
func concat_chain_collect(scalar $node, scalar $st) void {
    if ($node->{"type"} == NODE_BINARY_OP() && $node->{"op"} eq ".") {
        concat_chain_collect($node->{"left"}, $st);
        concat_chain_collect($node->{"right"}, $st);
        return;
    }
    my int $n = $st->{"n"};
    $st->{"nodes"}->[$n] = $node;
    $st->{"n"} = $n + 1;
}

# Emit a flattened multi-part concat. Returns 1 if emitted, 0 to fall back
# to the pairwise paths (overload concern or oversized chain).
#
# Owned parts (calls, hash accesses, nested temps) are captured into temps
# IN PART ORDER with cleanup_push between captures, so a later part's
# throwing evaluation can't leak an earlier one — same discipline as the
# pairwise emitter. Borrowed parts (plain variables, array subscripts) are
# passed inline in the varargs call; their relative C evaluation order is
# unspecified, which is only observable for tied containers with
# order-dependent FETCH side effects (accepted, matches the risk profile
# of the rest of the codegen's inline-arg emission).
func gen_concat_multi(scalar $cg, scalar $expr) int {
    my hash %st = ();
    $st{"n"} = 0;
    my array @nodes = ();
    $st{"nodes"} = \@nodes;
    concat_chain_collect($expr, \%st);
    my int $n = $st{"n"};
    if ($n < 3 || $n > 64) {
        return 0;
    }

    # Mirror the pairwise emitter's overload gate: when a `.` or '""'
    # overload is registered anywhere, any possibly-blessed part must take
    # the overload-dispatching pairwise path.
    if ($cg->{"has_overloads"} == 1) {
        my scalar $ol_ops = $cg->{"overloaded_ops"};
        my int $ol_concern = 0;
        if (length("" . $ol_ops->{"."}) > 0) { $ol_concern = 1; }
        if (length("" . $ol_ops->{"\"\""}) > 0) { $ol_concern = 1; }
        if ($ol_concern == 1) {
            my int $oi = 0;
            while ($oi < $n) {
                my scalar $opart = $nodes[$oi];
                if ($opart->{"type"} != NODE_STR_LITERAL() && could_be_blessed($opart) == 1) {
                    return 0;
                }
                $oi = $oi + 1;
            }
        }
    }

    my int $cm_id = $cg->{"tmp_counter"};
    $cg->{"tmp_counter"} = $cm_id + 1;
    my int $cleanup_on = $cg->{"cleanup_enabled"};
    my int $cm_in_try = cleanup_push_useful($cg);

    emit($cg, "(({ ");
    # Capture owned parts into temps, push each for throw safety when useful.
    my int $i = 0;
    my int $owned_count = 0;
    my str $last_cm = "";
    my int $cm_simple = 1;
    if ($cleanup_on == 1) {
        while ($i < $n) {
            my scalar $part = $nodes[$i];
            if ($part->{"type"} != NODE_STR_LITERAL()) {
                $st{"owned_" . $i} = 1;
                emit($cg, "StradaValue *__cm" . $cm_id . "_" . $i . " = ");
                gen_expression($cg, $part);
                if (needs_temp_cleanup($cg, $part) == 0 && expr_is_always_tagged_int($cg, $part) == 0) {
                    emit($cg, "; strada_incref(__cm" . $cm_id . "_" . $i . ")");
                }
                if ($cm_in_try == 1 && expr_is_always_tagged_int($cg, $part) == 0) {
                    emit($cg, "; strada_cleanup_push(__cm" . $cm_id . "_" . $i . "); ");
                    $last_cm = "__cm" . $cm_id . "_" . $i;
                    $owned_count = $owned_count + 1;
                } else {
                    emit($cg, "; ");
                }
            }
            $i = $i + 1;
        }
    }
    emit($cg, "StradaValue *__cmr" . $cm_id . " = strada_concat_multi(" . $n);
    $i = 0;
    while ($i < $n) {
        my scalar $part = $nodes[$i];
        if ($part->{"type"} == NODE_STR_LITERAL()) {
            my str $lit = $part->{"value"};
            my int $litlen = bytes($lit);
            # ASCII-ness known at compile time: kind 0 = ASCII, 2 = non-ASCII.
            my int $kind = 0;
            my int $bi = 0;
            while ($bi < $litlen) {
                if (ord(substr_bytes($lit, $bi, 1)) >= 128) { $kind = 2; last; }
                $bi = $bi + 1;
            }
            emit($cg, ", " . $kind . ", ");
            gen_str_literal_c($cg, $lit);
            emit($cg, ", (size_t)" . $litlen);
        } elsif (length("" . $st{"owned_" . $i}) > 0) {
            emit($cg, ", 1, __cm" . $cm_id . "_" . $i);
        } else {
            emit($cg, ", 1, ");
            gen_expression($cg, $part);
        }
        $i = $i + 1;
    }
    emit($cg, "); ");
    if ($cleanup_on == 1) {
        if ($cm_in_try == 1) {
            if ($owned_count == 1) {
                emit($cg, "strada_cleanup_pop_decref(" . $last_cm . "); ");
            } elsif ($owned_count > 1) {
                emit($cg, "strada_cleanup_pop_decref_n(" . $owned_count . "); ");
            }
        } else {
            $i = $n - 1;
            while ($i >= 0) {
                if (length("" . $st{"owned_" . $i}) > 0 && expr_is_always_tagged_int($cg, $nodes[$i]) == 0) {
                    emit($cg, "strada_decref(__cm" . $cm_id . "_" . $i . "); ");
                }
                $i = $i - 1;
            }
        }
    }
    emit($cg, "__cmr" . $cm_id . "; }))");
    return 1;
}

# True when an assignment-target sub-expression is itself an element access
# (hash or array, direct or deref) — i.e. an intermediate chain link that
# must be autovivified rather than rvalue-fetched. Callers set
# $cg->{"autoviv"} (1 = viv as hash, 2 = viv as array) immediately before
# generating that sub-expression, never earlier, so accesses inside key,
# index, or value expressions can't consume the flag by mistake.
func autoviv_link_type(scalar $node) int {
    my int $t = $node->{"type"};
    if ($t == NODE_HASH_ACCESS() || $t == NODE_DEREF_HASH()
        || $t == NODE_SUBSCRIPT() || $t == NODE_DEREF_ARRAY()) {
        return 1;
    }
    return 0;
}

func autoviv_chain_needs_cleanup(scalar $cg, scalar $node) int {
    if ($cg->{"cleanup_enabled"} != 1 || autoviv_link_type($node) == 0) { return 0; }
    my scalar $cur = $node;
    while (autoviv_link_type($cur) == 1) {
        my int $ct = $cur->{"type"};
        if ($ct == NODE_HASH_ACCESS()) { $cur = $cur->{"hash"}; }
        elsif ($ct == NODE_SUBSCRIPT()) { $cur = $cur->{"array"}; }
        else { $cur = $cur->{"ref"}; }
    }
    return needs_temp_cleanup($cg, $cur);
}

func emit_autoviv_step(scalar $cg, str $fn, scalar $cont_expr, int $propagate_flag, scalar $key_expr, int $kind) void {
    my int $root_cl = 0;
    if ($propagate_flag == 0 && $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $cont_expr) == 1) { $root_cl = 1; }
    my int $mark_on = 0;
    if (($cg->{"autoviv_mark_active"} + 0) == 1) { $mark_on = 1; }
    my int $imm_decref = 0;
    if ($root_cl == 1 && $mark_on == 0 && $cont_expr->{"type"} == NODE_VARIABLE()) { $imm_decref = 1; }
    my int $wrap_root = 0;
    if ($root_cl == 1 && ($mark_on == 1 || $imm_decref == 1)) { $wrap_root = 1; }

    if ($wrap_root == 1) {
        my int $uid = $cg->{"tmp_counter"} + 0;
        $cg->{"tmp_counter"} = $uid + 1;
        my str $rt_var = "__av_rt_" . $uid;
        my str $r_var = "__av_rs_" . $uid;
        emit($cg, "({ ");
        if ($kind == 1) {
            emit($cg, "StradaValue *__av_k_" . $uid . " = ");
            gen_expression($cg, $key_expr);
            emit($cg, "; ");
        }
        emit($cg, "StradaValue *" . $rt_var . " = ");
        gen_expression($cg, $cont_expr);
        emit($cg, "; ");
        if ($mark_on == 1) {
            emit($cg, "strada_cleanup_push(" . $rt_var . "); ");
        }
        if ($kind == 1) {
            emit($cg, "StradaValue *" . $r_var . " = " . $fn . "_sv(" . $rt_var . ", __av_k_" . $uid . "); ");
            if (needs_temp_cleanup($cg, $key_expr) == 1) {
                emit($cg, "strada_decref(__av_k_" . $uid . "); ");
            }
        } elsif ($kind == 0) {
            emit($cg, "StradaValue *" . $r_var . " = " . $fn . "(" . $rt_var . ", ");
            gen_str_literal_c($cg, $key_expr->{"value"});
            emit($cg, "); ");
        } else {
            emit($cg, "StradaValue *" . $r_var . " = " . $fn . "(" . $rt_var . ", ");
            emit_int_operand($cg, $key_expr);
            emit($cg, "); ");
        }
        if ($imm_decref == 1) {
            emit($cg, "strada_decref(" . $rt_var . "); ");
        }
        emit($cg, $r_var . "; })");
        return;
    }

    if ($kind == 1) {
        emit($cg, "({ StradaValue *__av_k = ");
        gen_expression($cg, $key_expr);
        emit($cg, "; StradaValue *__av_r = " . $fn . "_sv(");
        if ($propagate_flag > 0) { $cg->{"autoviv"} = $propagate_flag; }
        gen_expression($cg, $cont_expr);
        emit($cg, ", __av_k); ");
        if (needs_temp_cleanup($cg, $key_expr) == 1) {
            emit($cg, "strada_decref(__av_k); ");
        }
        emit($cg, "__av_r; })");
    } elsif ($kind == 0) {
        emit($cg, $fn . "(");
        if ($propagate_flag > 0) { $cg->{"autoviv"} = $propagate_flag; }
        gen_expression($cg, $cont_expr);
        emit($cg, ", ");
        gen_str_literal_c($cg, $key_expr->{"value"});
        emit($cg, ")");
    } else {
        emit($cg, $fn . "(");
        if ($propagate_flag > 0) { $cg->{"autoviv"} = $propagate_flag; }
        gen_expression($cg, $cont_expr);
        emit($cg, ", ");
        emit_int_operand($cg, $key_expr);
        emit($cg, ")");
    }
}

# Generate the container sub-expression of an assignment target,
# autovivifying intermediate access links. $want: 1 = this level must
# hold a hash, 2 = an array. The flag is set immediately before the
# generation (the access-node consumers in gen_expression clear it).
func emit_subst_target_begin_mode(scalar $cg, scalar $tgt, int $own_var) void {
    my int $tt = $tgt->{"type"} + 0;
    if ($tt == NODE_VARIABLE()) {
        my str $vc = escape_c_keyword($tgt->{"name"});
        my str $our_k = "" . $cg->{"our_vars"}->{$vc};
        if (length($our_k) > 0) {
            emit($cg, "({ StradaValue *__subst_tv = strada_global_get_cstr(" . c_str_lit($our_k) . "); int64_t __subst_cnt = 0; ");
            return;
        }
        my str $vref = scalar_var_c_ref($cg, $tgt->{"name"}, $vc);
        if ($cg->{"uses_tie"} == 1) {
            if ($own_var == 1) {
                emit($cg, "({ int __subst_tied = strada_scalar_is_tied(" . $vref . "); StradaValue *__subst_tv = __subst_tied ? strada_tied_scalar_fetch(" . $vref . ") : ({ StradaValue *__st_in = " . $vref . "; strada_incref(__st_in); __st_in; }); int64_t __subst_cnt = 0; ");
            } else {
                emit($cg, "({ int __subst_tied = strada_scalar_is_tied(" . $vref . "); StradaValue *__subst_tv = __subst_tied ? strada_tied_scalar_fetch(" . $vref . ") : " . $vref . "; int64_t __subst_cnt = 0; ");
            }
        } else {
            if ($own_var == 1) {
                emit($cg, "({ StradaValue *__subst_tv = " . $vref . "; strada_incref(__subst_tv); int64_t __subst_cnt = 0; ");
            } else {
                emit($cg, "({ StradaValue *__subst_tv = " . $vref . "; int64_t __subst_cnt = 0; ");
            }
        }
        return;
    }
    if ($tt == NODE_HASH_ACCESS() || $tt == NODE_DEREF_HASH()) {
        my scalar $he = $tgt->{"hash"};
        if ($tt == NODE_DEREF_HASH()) { $he = $tgt->{"ref"}; }
        my int $sp = cleanup_push_useful($cg);
        my int $h_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $he) == 1 && autoviv_link_type($he) == 0;
        my int $k_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $tgt->{"key"}) == 1;
        emit($cg, "({ StradaValue *__subst_h = ");
        gen_assign_container($cg, $he, 1);
        emit($cg, "; ");
        if ($sp == 1 && $h_cl == 1) { emit($cg, "strada_cleanup_push(__subst_h); "); }
        emit($cg, "StradaValue *__subst_k = ");
        gen_expression($cg, $tgt->{"key"});
        emit($cg, "; ");
        if ($sp == 1 && $k_cl == 1) { emit($cg, "strada_cleanup_push(__subst_k); "); }
        emit($cg, "StradaValue *__subst_tv = strada_hv_fetch_owned_sv(__subst_h, __subst_k); int64_t __subst_cnt = 0; ");
        return;
    }
    if ($tt == NODE_SUBSCRIPT() || $tt == NODE_DEREF_ARRAY()) {
        my scalar $ae = $tgt->{"array"};
        if ($tt == NODE_DEREF_ARRAY()) { $ae = $tgt->{"ref"}; }
        my int $sp = cleanup_push_useful($cg);
        my int $a_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $ae) == 1 && autoviv_link_type($ae) == 0;
        emit($cg, "({ StradaValue *__subst_a = ");
        gen_assign_container($cg, $ae, 2);
        emit($cg, "; ");
        if ($sp == 1 && $a_cl == 1) { emit($cg, "strada_cleanup_push(__subst_a); "); }
        emit($cg, "int64_t __subst_idx = ");
        emit_int_operand($cg, $tgt->{"index"});
        emit($cg, "; StradaValue *__subst_tv = strada_av_fetch_sv(__subst_a, __subst_idx); int64_t __subst_cnt = 0; ");
        return;
    }
    if ($tt == NODE_DEREF_SCALAR()) {
        my int $sp = cleanup_push_useful($cg);
        my int $r_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $tgt->{"ref"}) == 1;
        emit($cg, "({ StradaValue *__subst_r = ");
        gen_expression($cg, $tgt->{"ref"});
        emit($cg, "; ");
        if ($sp == 1 && $r_cl == 1) { emit($cg, "strada_cleanup_push(__subst_r); "); }
        emit($cg, "StradaValue *__subst_tv = strada_deref(__subst_r); int64_t __subst_cnt = 0; ");
        return;
    }
    emit($cg, "({ StradaValue *__subst_tv = ");
    gen_expression($cg, $tgt);
    if (needs_temp_cleanup($cg, $tgt) == 0) {
        emit($cg, "; strada_incref(__subst_tv)");
    }
    emit($cg, "; int64_t __subst_cnt = 0; ");
}

func emit_subst_target_begin(scalar $cg, scalar $tgt) void {
    emit_subst_target_begin_mode($cg, $tgt, 0);
}

func emit_subst_target_end_mode(scalar $cg, scalar $tgt, int $own_var) void {
    my int $tt = $tgt->{"type"} + 0;
    my int $sp = cleanup_push_useful($cg);
    if ($tt == NODE_VARIABLE()) {
        my str $vc = escape_c_keyword($tgt->{"name"});
        my str $our_k = "" . $cg->{"our_vars"}->{$vc};
        if (length($our_k) > 0) {
            if ($sp == 1) {
                emit($cg, "if (__subst_cnt > 0) { strada_cleanup_push(__subst_tv); strada_global_set_cstr(" . c_str_lit($our_k) . ", __subst_tv); strada_cleanup_pop(); } else { strada_decref(__subst_tv); } strada_new_int(__subst_cnt); })");
            } else {
                emit($cg, "if (__subst_cnt > 0) { strada_global_set_cstr(" . c_str_lit($our_k) . ", __subst_tv); } else { strada_decref(__subst_tv); } strada_new_int(__subst_cnt); })");
            }
            return;
        }
        my str $vref = scalar_var_c_ref($cg, $tgt->{"name"}, $vc);
        if ($cg->{"uses_tie"} == 1) {
            if ($sp == 1) {
                if ($own_var == 1) {
                    emit($cg, "if (__subst_tied) { if (__subst_cnt > 0) { strada_cleanup_push(__subst_tv); strada_tied_scalar_store(" . $vref . ", __subst_tv); strada_cleanup_pop(); } strada_decref(__subst_tv); } else { if (__subst_cnt > 0) { StradaValue *__st_old = " . $vref . "; " . $vref . " = __subst_tv; strada_decref(__st_old); } else { strada_decref(__subst_tv); } } strada_new_int(__subst_cnt); })");
                } else {
                    emit($cg, "if (__subst_tied) { if (__subst_cnt > 0) { strada_cleanup_push(__subst_tv); strada_tied_scalar_store(" . $vref . ", __subst_tv); strada_cleanup_pop(); } strada_decref(__subst_tv); } else { " . $vref . " = __subst_tv; } strada_new_int(__subst_cnt); })");
                }
            } else {
                if ($own_var == 1) {
                    emit($cg, "if (__subst_tied) { if (__subst_cnt > 0) strada_tied_scalar_store(" . $vref . ", __subst_tv); strada_decref(__subst_tv); } else { if (__subst_cnt > 0) { StradaValue *__st_old = " . $vref . "; " . $vref . " = __subst_tv; strada_decref(__st_old); } else { strada_decref(__subst_tv); } } strada_new_int(__subst_cnt); })");
                } else {
                    emit($cg, "if (__subst_tied) { if (__subst_cnt > 0) strada_tied_scalar_store(" . $vref . ", __subst_tv); strada_decref(__subst_tv); } else { " . $vref . " = __subst_tv; } strada_new_int(__subst_cnt); })");
                }
            }
        } else {
            if ($own_var == 1) {
                emit($cg, "if (__subst_cnt > 0) { StradaValue *__st_old = " . $vref . "; " . $vref . " = __subst_tv; strada_decref(__st_old); } else { strada_decref(__subst_tv); } strada_new_int(__subst_cnt); })");
            } else {
                emit($cg, $vref . " = __subst_tv; strada_new_int(__subst_cnt); })");
            }
        }
        return;
    }
    if ($tt == NODE_HASH_ACCESS() || $tt == NODE_DEREF_HASH()) {
        my scalar $he = $tgt->{"hash"};
        if ($tt == NODE_DEREF_HASH()) { $he = $tgt->{"ref"}; }
        my int $h_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $he) == 1 && autoviv_link_type($he) == 0;
        my int $k_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $tgt->{"key"}) == 1;
        if ($sp == 1) {
            emit($cg, "if (__subst_cnt > 0) { strada_cleanup_push(__subst_tv); strada_hv_store_sv(__subst_h, __subst_k, __subst_tv); strada_cleanup_pop(); } strada_decref(__subst_tv); ");
            if ($k_cl == 1) { emit($cg, "strada_cleanup_pop_decref(__subst_k); "); }
            if ($h_cl == 1) { emit($cg, "strada_cleanup_pop_decref(__subst_h); "); }
        } else {
            emit($cg, "if (__subst_cnt > 0) { strada_hv_store_sv(__subst_h, __subst_k, __subst_tv); } strada_decref(__subst_tv); ");
            if ($k_cl == 1) { emit($cg, "strada_decref(__subst_k); "); }
            if ($h_cl == 1) { emit($cg, "strada_decref(__subst_h); "); }
        }
        emit($cg, "strada_new_int(__subst_cnt); })");
        return;
    }
    if ($tt == NODE_SUBSCRIPT() || $tt == NODE_DEREF_ARRAY()) {
        my scalar $ae = $tgt->{"array"};
        if ($tt == NODE_DEREF_ARRAY()) { $ae = $tgt->{"ref"}; }
        my int $a_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $ae) == 1 && autoviv_link_type($ae) == 0;
        if ($cg->{"uses_tie"} == 1) {
            if ($sp == 1) {
                emit($cg, "if (__subst_cnt > 0) { strada_cleanup_push(__subst_tv); strada_av_store_sv(__subst_a, __subst_idx, __subst_tv); strada_cleanup_pop(); } strada_decref(__subst_tv); ");
            } else {
                emit($cg, "if (__subst_cnt > 0) { strada_av_store_sv(__subst_a, __subst_idx, __subst_tv); } strada_decref(__subst_tv); ");
            }
        } else {
            emit($cg, "if (__subst_cnt > 0) { strada_array_set(strada_deref_array(__subst_a), __subst_idx, __subst_tv); } strada_decref(__subst_tv); ");
        }
        if ($a_cl == 1) {
            if ($sp == 1) { emit($cg, "strada_cleanup_pop_decref(__subst_a); "); }
            else { emit($cg, "strada_decref(__subst_a); "); }
        }
        emit($cg, "strada_new_int(__subst_cnt); })");
        return;
    }
    if ($tt == NODE_DEREF_SCALAR()) {
        my int $r_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $tgt->{"ref"}) == 1;
        if ($sp == 1) {
            emit($cg, "if (__subst_cnt > 0) { strada_cleanup_push(__subst_tv); strada_deref_set(__subst_r, __subst_tv); strada_cleanup_pop(); } strada_decref(__subst_tv); ");
            if ($r_cl == 1) { emit($cg, "strada_cleanup_pop_decref(__subst_r); "); }
        } else {
            emit($cg, "if (__subst_cnt > 0) { strada_deref_set(__subst_r, __subst_tv); } strada_decref(__subst_tv); ");
            if ($r_cl == 1) { emit($cg, "strada_decref(__subst_r); "); }
        }
        emit($cg, "strada_new_int(__subst_cnt); })");
        return;
    }
    emit($cg, "strada_decref(__subst_tv); strada_new_int(__subst_cnt); })");
}

func emit_subst_r_begin(scalar $cg, scalar $tgt) void {
    if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $tgt) == 1) {
        emit($cg, "({ StradaValue *__subst_tv = ");
        gen_expression($cg, $tgt);
        emit($cg, "; ");
    } else {
        emit($cg, "({ StradaValue *__subst_tv = strada_copy_scalar(");
        gen_expression($cg, $tgt);
        emit($cg, "); ");
    }
    emit($cg, "if (!__subst_tv || STRADA_IS_TAGGED_INT(__subst_tv) || __subst_tv->type != STRADA_STR || !__subst_tv->value.pv) { ");
    emit($cg, "char *__re_c0 = strada_to_str(__subst_tv); StradaValue *__re_s0 = strada_new_str(__re_c0 ? __re_c0 : \"\"); free(__re_c0); strada_decref(__subst_tv); __subst_tv = __re_s0; } int64_t __subst_cnt = 0; ");
}

func emit_subst_r_end(scalar $cg) void {
