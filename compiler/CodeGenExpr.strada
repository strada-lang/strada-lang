                        my str $last_ma = "";
                        my array @ma_owned = ();
                        my int $a = 0;
                        while ($a < $arg_count) {
                            my scalar $ma_arg = $args->[$a];
                            my int $ma_own = 0;
                            emit($cg, "StradaValue *__meth_arg_" . $a . " = ");
                            gen_expression($cg, $ma_arg);
                            if (expr_is_always_tagged_int($cg, $ma_arg) == 0) {
                                if (needs_temp_cleanup($cg, $ma_arg) == 0) {
                                    emit($cg, "; strada_incref(__meth_arg_" . $a . ")");
                                }
                                $ma_own = 1;
                            }
                            emit($cg, "; ");
                            if ($meth_in_try == 1 && $ma_own == 1) {
                                emit($cg, "strada_cleanup_push(__meth_arg_" . $a . "); ");
                                $pushed_ma = $pushed_ma + 1;
                                $last_ma = "__meth_arg_" . $a;
                            }
                            push(@ma_owned, $ma_own);
                            $a = $a + 1;
                        }
                        emit($cg, "StradaValue *__meth_pa = strada_pack_args(" . $arg_count);
                        my int $i = 0;
                        while ($i < $arg_count) {
                            emit($cg, ", __meth_arg_" . $i);
                            $i = $i + 1;
                        }
                        emit($cg, "); ");
                        emit($cg, $mc_decl . "StradaValue *__meth_res = " . $mc_fn);
                        if ($mo_snap >= 1) {
                            emit($cg, "__meth_obj");
                        } else {
                            gen_expression($cg, $meth_target);
                        }
                        emit($cg, ", " . c_str_lit($method) . ", __meth_pa" . $mc_extra . "); ");
                        if ($meth_in_try == 1) {
                            if ($pushed_ma == 1) {
                                emit($cg, "strada_cleanup_pop_decref(" . $last_ma . "); ");
                            } elsif ($pushed_ma > 1) {
                                emit($cg, "strada_cleanup_pop_decref_n(" . $pushed_ma . "); ");
                            }
                        } else {
                            my int $d = $arg_count - 1;
                            while ($d >= 0) {
                                if ($ma_owned[$d] == 1) {
                                    emit($cg, "strada_decref(__meth_arg_" . $d . "); ");
                                }
                                $d = $d - 1;
                            }
                        }
                        if ($mo_snap >= 1) {
                            if ($meth_in_try == 1) { emit($cg, "strada_cleanup_pop_decref(__meth_obj); "); }
                            else { emit($cg, "strada_decref(__meth_obj); "); }
                        }
                        emit($cg, "__meth_res; })");
                    }
                } elsif ($arg_count == 0) {
                    # Zero args - pass NULL instead of allocating empty pack_args
                    if ($meth_obj_cleanup == 1) {
                        emit($cg, "({ StradaValue *__meth_obj = ");
                        gen_expression($cg, $meth_target);
                        emit($cg, "; ");
                        my int $m0_push = cleanup_push_useful($cg);
                        if ($m0_push == 1) { emit($cg, "strada_cleanup_push(__meth_obj); "); }
                        emit($cg, $mc_decl . "StradaValue *__meth_res = " . $mc_fn . "__meth_obj, " . c_str_lit($method) . ", NULL" . $mc_extra . "); ");
                        if ($m0_push == 1) { emit($cg, "strada_cleanup_pop_decref(__meth_obj); "); }
                        else { emit($cg, "strada_decref(__meth_obj); "); }
                        emit($cg, "__meth_res; })");
                    } elsif (length($mc_decl) > 0) {
                        emit($cg, "({ " . $mc_decl . $mc_fn);
                        gen_expression($cg, $meth_target);
                        emit($cg, ", " . c_str_lit($method) . ", NULL" . $mc_extra . "); })");
                    } else {
                        emit($cg, $mc_fn);
                        gen_expression($cg, $meth_target);
                        emit($cg, ", " . c_str_lit($method) . ", NULL" . $mc_extra . ")");
                    }
                } else {
                    # Has args, none need temp cleanup
                    my int $no_tmp_pure = 1;
                    my int $nt_i = 0;
                    while ($nt_i < $arg_count) {
                        my int $nt_t = $args->[$nt_i]->{"type"} + 0;
                        if ($nt_t != NODE_INT_LITERAL() && $nt_t != NODE_NUM_LITERAL() && $nt_t != NODE_STR_LITERAL() && $nt_t != NODE_UNDEF() && !($nt_t == NODE_VARIABLE() && $cg->{"uses_tie"} == 0)) {
                            $no_tmp_pure = 0;
                            last;
                        }
                        $nt_i = $nt_i + 1;
                    }
                    if ($meth_obj_cleanup == 0 && expr_cannot_throw($cg, $meth_target) == 1 && ($arg_count <= 1 || $no_tmp_pure == 1)) {
                        if (length($mc_decl) > 0) {
                            emit($cg, "({ " . $mc_decl . $mc_fn);
                            gen_expression($cg, $meth_target);
                            emit($cg, ", \"" . $method . "\", strada_pack_args(" . $arg_count);
                            my int $i = 0;
                            while ($i < $arg_count) {
                                emit($cg, ", ");
                                gen_expression($cg, $args->[$i]);
                                $i = $i + 1;
                            }
                            emit($cg, ")" . $mc_extra . "); })");
                        } else {
                            emit($cg, $mc_fn);
                            gen_expression($cg, $meth_target);
                            emit($cg, ", \"" . $method . "\", strada_pack_args(" . $arg_count);
                            my int $i = 0;
                            while ($i < $arg_count) {
                                emit($cg, ", ");
                                gen_expression($cg, $args->[$i]);
                                $i = $i + 1;
                            }
                            emit($cg, ")" . $mc_extra . ")");
                        }
                    } else {
                        emit($cg, "({ ");
                        if ($meth_obj_cleanup == 1) {
                            emit($cg, "StradaValue *__meth_obj = ");
                            gen_expression($cg, $meth_target);
                            emit($cg, "; strada_cleanup_push(__meth_obj); ");
                        }
                        emit($cg, "StradaValue *__meth_pa = strada_pack_args(" . $arg_count);
                        my int $i = 0;
                        while ($i < $arg_count) {
                            emit($cg, ", ");
                            gen_expression($cg, $args->[$i]);
                            $i = $i + 1;
                        }
                        emit($cg, "); " . $mc_decl . "StradaValue *__meth_res = " . $mc_fn);
                        if ($meth_obj_cleanup == 1) {
                            emit($cg, "__meth_obj");
                        } else {
                            gen_expression($cg, $meth_target);
                        }
                        emit($cg, ", \"" . $method . "\", __meth_pa" . $mc_extra . "); ");
                        if ($meth_obj_cleanup == 1) {
                            emit($cg, "strada_cleanup_pop_decref(__meth_obj); ");
                        }
                        emit($cg, "__meth_res; })");
                    }
                }
            }
        }
        return;
}

# Declared/static return type of a call by name, or -1 if unknown. Mirrors
# gen_user_call's resolver (plain name, then package-prefixed fallback for
# unqualified calls inside a non-main package) so the two never diverge.
func resolve_call_return_type(scalar $cg, str $name) int {
    my str $c_name = sanitize_name($name);
    my scalar $fi = $cg->{"functions"}->{$c_name};
    if ($fi) {
        my int $rt = $fi->{"return_type"};
        if ($rt > 0 || $fi->{"is_extern"} == 1) { return $rt; }
    }
    my str $fn_pkg = "" . $cg->{"current_fn_package"};
    if (length($fn_pkg) > 0 && $fn_pkg ne "main" && index($name, "::") < 0) {
        my str $c_pkg = $fn_pkg;
        my int $ci = index($c_pkg, "::");
        while ($ci >= 0) {
            $c_pkg = substr($c_pkg, 0, $ci) . "_" . substr($c_pkg, $ci + 2, length($c_pkg) - $ci - 2);
            $ci = index($c_pkg, "::");
        }
        my scalar $fi2 = $cg->{"functions"}->{$c_pkg . "_" . $c_name};
        if ($fi2) { return $fi2->{"return_type"}; }
    }
    if (index($name, "::") < 0 && defined($cg->{"qw_imports"})) {
        my str $qpkg = $fn_pkg;
        if (length($qpkg) == 0) { $qpkg = "main"; }
        my str $qtarget = "" . $cg->{"qw_imports"}->{$qpkg . "::" . $name};
        if (length($qtarget) > 0) {
            my scalar $fi3 = $cg->{"functions"}->{sanitize_name($qtarget)};
            if ($fi3) { return $fi3->{"return_type"}; }
        }
    }
    return -1;
}

# How a list element flattens in list context (Perl semantics):
#   0 = scalar/ref/unknown — push as ONE element (refs stay refs)
#   1 = array value, BORROWED (an @array variable — its live elements)
#   2 = array value, OWNED temp (paren-list, map/grep/sort, or a call whose
#       declared return type is array, incl. the common array builtins)
# Kinds 1 and 2 are spliced via strada_deref_array downstream, which unwraps
# the REF-boxing that array-returning functions/builtins use — so a
# `func f() array` flattens exactly like a bare @a (the user-visible goal:
# arrays flatten like Perl). Explicit `[..]`/`\@a` (is_list==0, or a ref-typed
# scalar) are kind 0 and never flatten — also Perl.
func array_flatten_kind(scalar $cg, scalar $elem) int {
    my int $t = $elem->{"type"};
    if ($t == NODE_VARIABLE() && $elem->{"sigil"} eq "@") { return 1; }
    if ($t == NODE_ANON_ARRAY() && $elem->{"is_list"} == 1) { return 2; }
    if ($t == NODE_MAP() || $t == NODE_GREP() || $t == NODE_SORT()) { return 2; }
    if ($t == NODE_CALL()) {
        my str $nm = "" . $elem->{"name"};
        if (length($nm) > 6 && substr($nm, 0, 6) eq "core::") {
            $nm = "sys::" . substr($nm, 6, length($nm) - 6);
        }
        if ($nm eq "split" || $nm eq "keys" || $nm eq "values" || $nm eq "reverse"
            || $nm eq "sys::split" || $nm eq "sys::keys" || $nm eq "sys::values" || $nm eq "sys::reverse") {
            return 2;
        }
        if (resolve_call_return_type($cg, $elem->{"name"}) == TYPE_ARRAY()) { return 2; }
    }
    return 0;
}

func gen_expression(scalar $cg, scalar $expr) void {
    my int $type = $expr->{"type"};
    my int $in_extern = $cg->{"in_extern"};

    # Integer literal
    if ($type == NODE_INT_LITERAL()) {
        my str $iv = "" . $expr->{"value"};
        if ($in_extern) {
            emit($cg, $iv);
        } elsif (bytes($iv) < 15) {
            emit($cg, "STRADA_MAKE_TAGGED_INT(" . c_int64_lit($iv) . ")");
        } else {
            emit($cg, "strada_new_int_il(" . c_int64_lit($iv) . ")");
        }
        return;
    }

    # Number literal
    if ($type == NODE_NUM_LITERAL()) {
        if ($in_extern) {
            emit($cg, $expr->{"value"});
        } else {
            emit($cg, "strada_new_num(" . $expr->{"value"} . ")");
        }
        return;
    }
    
    # String literal - use byte-level operations for proper UTF-8 handling
    if ($type == NODE_STR_LITERAL()) {
        # In extern mode, emit raw C string literal; otherwise wrap in
        # STRADA_NEW_STR_LIT so embedded NUL bytes survive the constructor
        # (strada_new_str's strlen would truncate at the first NUL).
        if ($in_extern) {
            emit($cg, "\"");
        } else {
            emit($cg, "STRADA_NEW_STR_LIT(\"");
        }
        my str $val = $expr->{"value"};
        my int $i = 0;
        my int $len = bytes($val);
        while ($i < $len) {
            my int $code = char_at($val, $i);
            if ($code == '\n') {
                emit($cg, "\\n");
            } elsif ($code == '\t') {
                emit($cg, "\\t");
            } elsif ($code == '\r') {
                emit($cg, "\\r");
            } elsif ($code == '\0') {
                # 3-digit octal so a following digit isn't merged into the escape
                emit($cg, "\\000");
            } elsif ($code == '\a') {
                emit($cg, "\\a");
            } elsif ($code == '\b') {
                emit($cg, "\\b");
            } elsif ($code == '\f') {
                emit($cg, "\\f");
            } elsif ($code == '\v') {
                emit($cg, "\\v");
            } elsif ($code == '\e') {
                emit($cg, "\\033");
            } elsif ($code == '"') {
                emit($cg, "\\\"");
            } elsif ($code == '\\') {
                emit($cg, "\\\\");
            } elsif ($code >= ' ' && $code <= '~') {
                # Printable ASCII - output as-is
                emit($cg, chr($code));
            } else {
                # Non-printable/high bytes - output raw byte directly
                # The C source file is UTF-8, so raw UTF-8 bytes are valid
                emit($cg, substr_bytes($val, $i, 1));
            }
            $i = $i + 1;
        }
        if ($in_extern) {
            emit($cg, "\"");
        } else {
            emit($cg, "\")");
        }
        return;
    }

    # Undef literal
    if ($type == NODE_UNDEF()) {
        emit($cg, "strada_new_undef()");
        return;
    }

    # Value-producing do { } block: GNU statement expression. The last
    # EXPRESSION statement's value is the result (owned: incref'd when
    # borrowed, before the block's scope cleanup runs); a block ending in
    # a non-expression yields undef. Control-flow exits (return/next/
    # last) inside a value-do are unsupported (gcc forbids jumping out
    # of statement expressions) — documented.
    if ($type == NODE_DO_EXPR()) {
        my int $do_id = $cg->{"tmp_counter"};
        $cg->{"tmp_counter"} = $do_id + 1;
        my scalar $do_block = $expr->{"block"};
        my scalar $do_stmts = $do_block->{"statements"};
        my int $do_n = $do_block->{"statement_count"};
        my int $do_has_local = stmt_has_local($do_block);
        emit($cg, "({ StradaValue *__do_res_" . $do_id . " = NULL; {\n");
        indent($cg);
        scope_push($cg);
        if ($do_has_local == 1) {
            emit_indent($cg);
            emit($cg, "int __local_do_mark_" . $do_id . " = strada_local_depth_get();\n");
            local_mark_push($cg, $cg->{"scope_depth"}, "__local_do_mark_" . $do_id);
        }
        my int $di = 0;
        while ($di < $do_n) {
            my scalar $dstmt = $do_stmts->[$di];
            if ($di == $do_n - 1 && $dstmt->{"type"} == NODE_EXPR_STMT()) {
                # Last expression statement: capture as the result.
                my scalar $dval = $dstmt->{"expr"};
                emit_indent($cg);
                emit($cg, "__do_res_" . $do_id . " = ");
                if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $dval) == 0) {
                    emit($cg, "({ StradaValue *__do_b = ");
                    gen_expression($cg, $dval);
                    emit($cg, "; strada_incref(__do_b); __do_b; })");
                } else {
                    gen_expression($cg, $dval);
                }
                emit($cg, ";\n");
            } else {
                gen_statement($cg, $dstmt);
            }
            $di = $di + 1;
        }
        # Scope cleanup (local decrefs) BEFORE yielding — the result is
        # already owned/incref'd so it survives.
        if ($do_has_local == 1) {
            local_mark_pop($cg);
            emit_indent($cg);
            emit($cg, "strada_local_restore_to(__local_do_mark_" . $do_id . ");\n");
        }
        scope_pop($cg);
        dedent($cg);
        emit_indent($cg);
        emit($cg, "} __do_res_" . $do_id . " ? __do_res_" . $do_id . " : strada_new_undef(); })");
        return;
    }

    # Variable
    if ($type == NODE_VARIABLE()) {
        my str $var_name = $expr->{"name"};
        # $0 (__program_name) — always read fresh from getprocname
        if ($var_name eq "__program_name") {
            emit($cg, "strada_getprocname()");
            return;
        }
        # Escape C keywords in variable names
        my str $c_var_name = escape_c_keyword($var_name);
        # Check if this is an 'our' variable - emit strada_global_get() instead
        my scalar $our_vars = $cg->{"our_vars"};
        my str $our_key = "" . $our_vars->{$c_var_name};
        if (length($our_key) > 0) {
            emit($cg, "strada_global_get_cstr(" . c_str_lit($our_key) . ")");
            return;
        }
        # Handle magic variables for map/sort/grep blocks (only when in those contexts)
        if ($var_name eq "_" && ($cg->{"in_map_block"} || $cg->{"in_grep_block"})) {
            emit($cg, $cg->{"current_elem_var"});
        } elsif ($var_name eq "a" && $cg->{"in_sort_block"}) {
            emit($cg, $cg->{"current_sort_a"});
        } elsif ($var_name eq "b" && $cg->{"in_sort_block"}) {
            emit($cg, $cg->{"current_sort_b"});
        } else {
            # Resolves normal locals, boxed PerlaCell locals (*__cell_x), and
            # anonymous-function params/locals/capture slots uniformly.
            emit($cg, scalar_var_c_ref($cg, $var_name, $c_var_name));
        }
        return;
    }
    
    # Binary operation
    if ($type == NODE_BINARY_OP()) { gen_binop_node($cg, $expr); return; }

    # Regex match: $str =~ /pattern/flags or $str !~ /pattern/flags
    if ($type == NODE_REGEX_MATCH()) {
        my str $op = $expr->{"op"};
        my str $pattern = $expr->{"pattern"};
        my str $flags = $expr->{"flags"};

        # Check if pattern contains variable interpolation ($varname)
        # Only consider it interpolation if $ is followed by a word character
        # (not $ at end of pattern which is regex end-of-line anchor)
        my int $has_interp = 0;
        my int $check_i = 0;
        my int $pat_len = length($pattern);
        $has_interp = regex_pattern_has_interp($pattern);

        # Wrap in statement expression to free strada_to_str_ss() temp
        # Also cleanup target if it's a temp (e.g., string literal in "abc" =~ /pattern/)
        my int $tgt_needs_cleanup = 0;
        if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $expr->{"target"}) == 1) {
            $tgt_needs_cleanup = 1;
        }
        if ($tgt_needs_cleanup == 1) {
            emit($cg, "({ StradaValue *__re_tgt = ");
            gen_expression($cg, $expr->{"target"});
            emit($cg, "; char *__re_str = strada_to_str_ss(__re_tgt); ");
        } else {
            emit($cg, "({ char *__re_str = strada_to_str_ss(");
            gen_expression($cg, $expr->{"target"});
            emit($cg, "); ");
        }

        # Also free interpolated pattern temp if needed
        if ($has_interp == 1) {
            emit($cg, "StradaValue *__re_psv = ");
            gen_regex_interpolated_pattern($cg, $pattern);
            emit($cg, "; char *__re_pat = strada_to_str_ss(__re_psv); strada_decref(__re_psv); ");
        }

        if ($op eq "=~") {
            emit($cg, "int __re_res = strada_regex_match_with_capture(__re_str, ");
        } else {
            emit($cg, "int __re_res = !strada_regex_match_with_capture(__re_str, ");
        }

        if ($has_interp == 1) {
            emit($cg, "__re_pat");
        } else {
            # Static pattern - emit as literal string
            emit($cg, "\"");
            my int $i = 0;
            my int $len = length($pattern);
            while ($i < $len) {
                my str $ch = substr($pattern, $i, 1);
                if ($ch eq "\\") {
                    emit($cg, "\\\\");
                } elsif ($ch eq "\"") {
                    emit($cg, "\\\"");
                } elsif ($ch eq "\n") {
                    emit($cg, "\\n");
                } elsif ($ch eq "\t") {
                    emit($cg, "\\t");
                } else {
                    emit($cg, c_ctrl_escape($ch));
                }
                $i = $i + 1;
            }
            emit($cg, "\"");
        }
        emit($cg, ", ");
        # Pass flags (or NULL if empty)
        if (length($flags) > 0) {
            emit($cg, "\"" . $flags . "\"");
        } else {
            emit($cg, "NULL");
        }
        emit($cg, "); strada_cstr_free(__re_str); ");
        if ($has_interp == 1) {
            emit($cg, "strada_cstr_free(__re_pat); ");
        }
        if ($tgt_needs_cleanup == 1) {
            emit($cg, "strada_decref(__re_tgt); ");
        }
        emit($cg, "strada_new_int(__re_res); })");
        return;
    }

    # Regex substitution: $str =~ s/pattern/replacement/flags
    if ($type == NODE_REGEX_SUBST()) {
        my str $pattern = $expr->{"pattern"};
        my str $replacement = $expr->{"replacement"};
        my str $flags = $expr->{"flags"};

        # Check for flags
        my int $global = 0;
        if (index($flags, "g") >= 0) {
            $global = 1;
        }
        my int $eval_mode = 0;
        if (index($flags, "e") >= 0) {
            $eval_mode = 1;
        }
        my int $ret_mode = 0;
        if (index($flags, "r") >= 0) {
            $ret_mode = 1;
        }

        if ($eval_mode == 1) {
            # /e modifier: evaluate replacement as expression for each match, return count SV (or modified copy for /r)
            my int $se_push = cleanup_push_useful($cg);
            if ($ret_mode == 1) {
                emit_subst_r_begin($cg, $expr->{"target"});
            } else {
                emit_subst_target_begin_mode($cg, $expr->{"target"}, 1);
                emit($cg, "if (!__subst_tv || STRADA_IS_TAGGED_INT(__subst_tv) || __subst_tv->type != STRADA_STR || !__subst_tv->value.pv) { ");
                emit($cg, "char *__re_c0 = strada_to_str(__subst_tv); StradaValue *__re_s0 = strada_new_str(__re_c0 ? __re_c0 : \"\"); free(__re_c0); strada_decref(__subst_tv); __subst_tv = __re_s0; } ");
            }
            if ($se_push == 1) { emit($cg, "strada_cleanup_push(__subst_tv); "); }
            emit($cg, "const char *__re_src = __subst_tv->value.pv ? __subst_tv->value.pv : \"\"; ");
            my int $subst_e_interp = regex_pattern_has_interp($pattern);
            if ($subst_e_interp == 1) {
                gen_subst_pattern_prelude($cg, $pattern);
                emit($cg, " ");
            }
            if ($subst_e_interp == 1) {
                emit($cg, "StradaValue *__re_matches = strada_regex_find_all(__re_src, __subst_pat, ");
            } else {
                emit($cg, "StradaValue *__re_matches = strada_regex_find_all(__re_src, " . c_str_lit($pattern) . ", ");
            }
            if (length($flags) > 0) {
                emit($cg, c_str_lit($flags));
            } else {
                emit($cg, "NULL");
            }
            emit($cg, ", " . $global . "); ");
            if ($subst_e_interp == 1) {
                emit($cg, "strada_cstr_free(__subst_pat); ");
            }
            if ($se_push == 1) { emit($cg, "strada_cleanup_push(__re_matches); "); }
            emit($cg, "__subst_cnt = (int64_t)__re_matches->value.av->size; ");
            emit($cg, "if (__subst_cnt > 0) { StradaValue *__re_repls = strada_new_array(); ");
            if ($se_push == 1) { emit($cg, "strada_cleanup_push(__re_repls); "); }
            emit($cg, "for (size_t __re_i = 0; __re_i < __re_matches->value.av->size; __re_i++) { ");
            emit($cg, "strada_set_captures_sv(__re_matches->value.av->elements[__re_matches->value.av->head + __re_i]); ");
            emit($cg, "StradaValue *__re_repl = ");
            my scalar $eval_expr = $expr->{"eval_expr"};
            gen_expression($cg, $eval_expr);
            emit($cg, "; strada_array_push(__re_repls->value.av, __re_repl); ");
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $eval_expr) == 1) {
                emit($cg, "strada_decref(__re_repl); ");
            }
            emit($cg, "} StradaValue *__re_built = strada_regex_build_result(__re_src, __re_matches, __re_repls); ");
            if ($se_push == 1) {
                emit($cg, "strada_cleanup_pop_decref(__re_repls); ");
                emit($cg, "strada_cleanup_pop_decref(__re_matches); ");
                emit($cg, "strada_cleanup_pop(); ");
                emit($cg, "strada_decref(__subst_tv); __subst_tv = __re_built; } else { ");
