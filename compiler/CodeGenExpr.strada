                            emit($cg, "({ StradaValue *__meth_obj = ");
                            gen_expression($cg, $meth_target);
                            emit($cg, "; ");
                            if ($meth_in_try == 1) { emit($cg, "strada_cleanup_push(__meth_obj); "); }
                            emit($cg, $mc_decl . "StradaValue *__meth_res = " . $mc_fn . "__meth_obj, " . c_str_lit($method) . ", strada_pack_args_take(" . $arg_count . ", " . $take_mask . "u");
                            my int $pi = 0;
                            while ($pi < $arg_count) {
