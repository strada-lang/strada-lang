                                    gen_expression($cg, $meth_target);
                                    emit($cg, "; strada_cleanup_push(__dv_obj); StradaValue *__dv_res = " . $resolved_fn . "(__dv_obj); strada_cleanup_pop_decref(__dv_obj); __dv_res; })");
                                }
