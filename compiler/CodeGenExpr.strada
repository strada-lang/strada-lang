                        gen_expression($cg, $our_rhs);
                        emit($cg, "; __gs_v = strada_copy_scalar_il(__gs_v); strada_global_set_cstr(" . c_str_lit($our_key2) . ", __gs_v); (StradaValue*)NULL; })");
                    } else {
