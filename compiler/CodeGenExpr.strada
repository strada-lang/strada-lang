                                gen_expression($cg, $args->[$pi]);
                                $pi = $pi + 1;
                            }
                            emit($cg, ")" . $mc_extra . "); })");
                        } else {
                            emit($cg, $mc_fn);
                            gen_expression($cg, $meth_target);
                            emit($cg, ", " . c_str_lit($method) . ", strada_pack_args_take(" . $arg_count . ", " . $take_mask . "u");
                            my int $pi = 0;
                            while ($pi < $arg_count) {
