                    if ($fparam->{"has_default"} == 1) {
                        emit($cg, "if (!__sp_p" . $fp . ") { __sp_p" . $fp . " = ");
                        gen_expression($cg, $fparam->{"default"});
                        if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $fparam->{"default"}) == 1 && expr_is_always_tagged_int($cg, $fparam->{"default"}) == 0) {
