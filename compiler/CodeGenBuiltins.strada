                            gen_expression($cg, $dnode);
                            emit($cg, "); ");
                        } elsif ($d_owned == 1) {
                            emit($cg, "strada_hash_set_take(__ct_h->value.hv, " . c_str_lit($attr_name) . ", ");
                            gen_expression($cg, $dnode);
                            emit($cg, "); ");
