                            $cg->{"tmp_counter"} = $fbn + 1;
                            emit($cg, "({ static char *__fpkg" . $fbn . " = NULL; if (__builtin_expect(!__fpkg" . $fbn . ", 0)) __fpkg" . $fbn . " = strada_intern_pkg_name(" . c_str_lit(strada_pkg_for_c($cg, $pkg_name)) . "); ");
