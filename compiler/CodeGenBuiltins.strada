            gen_expression($cg, $field_arg);
            emit($cg, "; char *__cgs_s = strada_to_str_ss(__cgs_v); const char *__cgs_r = strada_cstruct_get_string(");
            gen_expression($cg, $args->[0]);
            emit($cg, ", __cgs_s, strada_to_int(");
            gen_expression($cg, $args->[2]);
            emit($cg, ")); strada_cstr_free(__cgs_s); ");
            if (needs_temp_cleanup($cg, $field_arg) == 1) {
                emit($cg, "strada_decref(__cgs_v); ");
            }
            emit($cg, "strada_new_str(__cgs_r); })");
            return 1;
        }

        # cstruct_get_double - get double field from C struct
        if ($name eq "sys::cstruct_get_double") {
            my scalar $args = $expr->{"args"};
            my scalar $field_arg = $args->[1];
            emit($cg, "({ StradaValue *__cgd_v = ");
            gen_expression($cg, $field_arg);
            emit($cg, "; char *__cgd_s = strada_to_str_ss(__cgd_v); double __cgd_r = strada_cstruct_get_double(");
            gen_expression($cg, $args->[0]);
            emit($cg, ", __cgd_s, strada_to_int(");
            gen_expression($cg, $args->[2]);
            emit($cg, ")); strada_cstr_free(__cgd_s); ");
            if (needs_temp_cleanup($cg, $field_arg) == 1) {
                emit($cg, "strada_decref(__cgd_v); ");
            }
            emit($cg, "strada_new_num(__cgd_r); })");
            return 1;
        }
        
        # cstruct_ptr - get raw pointer from C struct
        if ($name eq "sys::cstruct_ptr") {
            my scalar $args = $expr->{"args"};
            emit($cg, "strada_cstruct_ptr(");
            gen_expression($cg, $args->[0]);
            emit($cg, ")");
            return 1;
        }

        # OOP - bless($ref, "Package") - bless a reference into a package
        if ($name eq "bless") {
            my scalar $args = $expr->{"args"};
            my scalar $pkg_arg = $args->[1];
            if ($pkg_arg->{"type"} == NODE_STR_LITERAL()) {
                # String literal - emit directly (no allocation)
                emit($cg, "strada_bless(");
                gen_expression($cg, $args->[0]);
                emit($cg, ", ");
                gen_str_literal_c($cg, $pkg_arg->{"value"});
                emit($cg, ")");
            } else {
                # Expression - need to convert and free after bless
                emit($cg, "({ StradaValue *__bless_tmp = ");
                gen_expression($cg, $pkg_arg);
                emit($cg, "; char *__bless_ps = strada_to_str_ss(__bless_tmp); ");
                if (needs_temp_cleanup($cg, $pkg_arg) == 1) {
                    emit($cg, "strada_decref(__bless_tmp); ");
                }
                emit($cg, "StradaValue *__bless_r = strada_bless(");
                gen_expression($cg, $args->[0]);
                emit($cg, ", __bless_ps); strada_cstr_free(__bless_ps); __bless_r; })");
            }
            return 1;
        }

        # OOP - blessed($ref) - get package name or undef
        if ($name eq "blessed") {
            my scalar $args = $expr->{"args"};
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[0]) == 1) {
                emit($cg, "({ StradaValue *__bld_v = ");
                gen_expression($cg, $args->[0]);
                emit($cg, "; StradaValue *__bld_r = strada_blessed(__bld_v); strada_decref(__bld_v); __bld_r; })");
            } else {
                emit($cg, "strada_blessed(");
                gen_expression($cg, $args->[0]);
                emit($cg, ")");
            }
            return 1;
        }

        # OOP - set_package("Name") - set current package context
        if ($name eq "set_package") {
            my scalar $args = $expr->{"args"};
            my scalar $pkg_arg = $args->[0];
            if ($pkg_arg->{"type"} == NODE_STR_LITERAL()) {
                emit($cg, "(strada_set_package(");
                gen_str_literal_c($cg, $pkg_arg->{"value"});
                emit($cg, "), strada_undef_static())");
            } else {
                emit($cg, "({ StradaValue *__setpkg_t = ");
                gen_expression($cg, $pkg_arg);
                emit($cg, "; char *__setpkg_s = strada_to_str_ss(__setpkg_t); ");
                if (needs_temp_cleanup($cg, $pkg_arg) == 1) {
                    emit($cg, "strada_decref(__setpkg_t); ");
                }
                emit($cg, "strada_set_package(__setpkg_s); strada_cstr_free(__setpkg_s); strada_undef_static(); })");
            }
            return 1;
        }

        # OOP - inherit("Parent") or inherit("Child", "Parent") - set up inheritance
        if ($name eq "inherit") {
            my scalar $args = $expr->{"args"};
            my int $arg_count = $expr->{"arg_count"};
            if ($arg_count == 1) {
                # Single arg: inherit from parent using current package
                my scalar $parent_arg = $args->[0];
                if ($parent_arg->{"type"} == NODE_STR_LITERAL()) {
                    # String literal - emit directly
                    emit($cg, "(strada_inherit_from(");
                    gen_str_literal_c($cg, $parent_arg->{"value"});
                    emit($cg, "), strada_undef_static())");
                } else {
                    # Expression - need to free temp
                    emit($cg, "({ StradaValue *__inh_p = ");
                    gen_expression($cg, $parent_arg);
                    emit($cg, "; char *__inh_ps = strada_to_str_ss(__inh_p); ");
                    emit($cg, "strada_inherit_from(__inh_ps); ");
                    emit($cg, "strada_cstr_free(__inh_ps); ");
                    if (needs_temp_cleanup($cg, $parent_arg) == 1) {
                        emit($cg, "strada_decref(__inh_p); ");
                    }
                    emit($cg, "strada_undef_static(); })");
                }
            } else {
                # Two args: inherit(child, parent)
                my scalar $child_arg = $args->[0];
                my scalar $parent_arg = $args->[1];
                my int $child_is_lit = $child_arg->{"type"} == NODE_STR_LITERAL();
                my int $parent_is_lit = $parent_arg->{"type"} == NODE_STR_LITERAL();

                if ($child_is_lit == 1 && $parent_is_lit == 1) {
                    # Both literals - emit directly
                    emit($cg, "(strada_inherit(");
                    gen_str_literal_c($cg, $child_arg->{"value"});
                    emit($cg, ", ");
                    gen_str_literal_c($cg, $parent_arg->{"value"});
                    emit($cg, "), strada_undef_static())");
                } else {
                    # At least one expression - wrap for cleanup
                    emit($cg, "({ StradaValue *__inh_c = ");
                    gen_expression($cg, $child_arg);
                    emit($cg, "; StradaValue *__inh_p = ");
                    gen_expression($cg, $parent_arg);
                    emit($cg, "; char *__inh_cs = strada_to_str_ss(__inh_c); ");
                    emit($cg, "char *__inh_ps = strada_to_str_ss(__inh_p); ");
                    emit($cg, "strada_inherit(__inh_cs, __inh_ps); ");
                    emit($cg, "strada_cstr_free(__inh_cs); strada_cstr_free(__inh_ps); ");
                    if (needs_temp_cleanup($cg, $child_arg) == 1) {
                        emit($cg, "strada_decref(__inh_c); ");
                    }
                    if (needs_temp_cleanup($cg, $parent_arg) == 1) {
                        emit($cg, "strada_decref(__inh_p); ");
                    }
                    emit($cg, "strada_undef_static(); })");
                }
            }
            return 1;
        }

        # OOP - isa($obj, "Package") / UNIVERSAL::isa($obj, "Package")
        if ($name eq "isa" || $name eq "UNIVERSAL::isa") {
            my scalar $args = $expr->{"args"};
            my scalar $obj_arg = $args->[0];
            my scalar $pkg_arg = $args->[1];
            my int $obj_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $obj_arg) == 1;
            if ($pkg_arg->{"type"} == NODE_STR_LITERAL()) {
                if ($obj_cl == 1) {
                    emit($cg, "({ StradaValue *__isa_o = ");
                    gen_expression($cg, $obj_arg);
                    emit($cg, "; int __isa_r = strada_isa(__isa_o, ");
                    gen_str_literal_c($cg, $pkg_arg->{"value"});
                    emit($cg, "); strada_decref(__isa_o); strada_new_int(__isa_r); })");
                } else {
                    emit($cg, "strada_new_int(strada_isa(");
                    gen_expression($cg, $obj_arg);
                    emit($cg, ", ");
                    gen_str_literal_c($cg, $pkg_arg->{"value"});
                    emit($cg, "))");
                }
            } else {
                emit($cg, "({ ");
                if ($obj_cl == 1) {
                    emit($cg, "StradaValue *__isa_o = ");
                    gen_expression($cg, $obj_arg);
                    emit($cg, "; ");
                }
                emit($cg, "StradaValue *__isa_t = ");
                gen_expression($cg, $pkg_arg);
                emit($cg, "; char *__isa_s = strada_to_str_ss(__isa_t); ");
                if (needs_temp_cleanup($cg, $pkg_arg) == 1) {
                    emit($cg, "strada_decref(__isa_t); ");
                }
                emit($cg, "int __isa_r = strada_isa(");
                if ($obj_cl == 1) { emit($cg, "__isa_o"); } else { gen_expression($cg, $obj_arg); }
                emit($cg, ", __isa_s); strada_cstr_free(__isa_s); ");
                if ($obj_cl == 1) { emit($cg, "strada_decref(__isa_o); "); }
                emit($cg, "strada_new_int(__isa_r); })");
            }
            return 1;
        }

        # OOP - can($obj, "method") / UNIVERSAL::can($obj, "method")
        if ($name eq "can" || $name eq "UNIVERSAL::can") {
            my scalar $args = $expr->{"args"};
            my scalar $obj_arg = $args->[0];
            my scalar $meth_arg = $args->[1];
            my int $obj_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $obj_arg) == 1;
            if ($meth_arg->{"type"} == NODE_STR_LITERAL()) {
                if ($obj_cl == 1) {
                    emit($cg, "({ StradaValue *__can_o = ");
                    gen_expression($cg, $obj_arg);
                    emit($cg, "; int __can_r = strada_can(__can_o, ");
                    gen_str_literal_c($cg, $meth_arg->{"value"});
                    emit($cg, "); strada_decref(__can_o); strada_new_int(__can_r); })");
                } else {
                    emit($cg, "strada_new_int(strada_can(");
                    gen_expression($cg, $obj_arg);
                    emit($cg, ", ");
                    gen_str_literal_c($cg, $meth_arg->{"value"});
                    emit($cg, "))");
                }
            } else {
                emit($cg, "({ ");
                if ($obj_cl == 1) {
                    emit($cg, "StradaValue *__can_o = ");
                    gen_expression($cg, $obj_arg);
                    emit($cg, "; ");
                }
                emit($cg, "StradaValue *__can_t = ");
                gen_expression($cg, $meth_arg);
                emit($cg, "; char *__can_s = strada_to_str_ss(__can_t); ");
                if (needs_temp_cleanup($cg, $meth_arg) == 1) {
                    emit($cg, "strada_decref(__can_t); ");
                }
                emit($cg, "int __can_r = strada_can(");
                if ($obj_cl == 1) { emit($cg, "__can_o"); } else { gen_expression($cg, $obj_arg); }
                emit($cg, ", __can_s); strada_cstr_free(__can_s); ");
                if ($obj_cl == 1) { emit($cg, "strada_decref(__can_o); "); }
                emit($cg, "strada_new_int(__can_r); })");
            }
            return 1;
        }

        # ============================================================
        # NEW LIBC FUNCTIONS
        # ============================================================

        # Additional File I/O
        if ($name eq "sys::fgetc") {
            gen_call_with_arg_cleanup($cg, "strada_fgetc", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "sys::fputc") {
            gen_call_with_arg_cleanup($cg, "strada_fputc", $expr->{"args"}, 2);
            return 1;
        }

        if ($name eq "sys::fgets") {
            gen_call_with_arg_cleanup($cg, "strada_fgets", $expr->{"args"}, 2);
            return 1;
        }

        if ($name eq "sys::fputs") {
            gen_call_with_arg_cleanup($cg, "strada_fputs", $expr->{"args"}, 2);
            return 1;
        }

        if ($name eq "sys::ferror") {
            gen_call_with_arg_cleanup($cg, "strada_ferror", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "sys::fileno") {
            gen_call_with_arg_cleanup($cg, "strada_fileno", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "sys::clearerr") {
            gen_call_with_arg_cleanup($cg, "strada_clearerr", $expr->{"args"}, 1);
            return 1;
        }

        # Temporary files
        if ($name eq "sys::tmpfile") {
            emit($cg, "strada_tmpfile()");
            return 1;
        }

        if ($name eq "sys::mkstemp") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_mkstemp", $args, 1);
            return 1;
        }

        if ($name eq "sys::mkdtemp") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_mkdtemp", $args, 1);
            return 1;
        }

        # Command execution (popen)
        if ($name eq "sys::popen") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_popen", $args, 2);
            return 1;
        }

        if ($name eq "sys::pclose") {
            gen_call_with_arg_cleanup($cg, "strada_pclose", $expr->{"args"}, 1);
            return 1;
        }

        # Command execution with output capture (backticks/qx)
        if ($name eq "sys::qx") {
            my scalar $args = $expr->{"args"};
            emit($cg, "({ StradaValue *__qx_v = ");
            gen_expression($cg, $args->[0]);
            emit($cg, "; StradaValue *__qx_r = strada_qx(__qx_v); ");
            if (needs_temp_cleanup($cg, $args->[0]) == 1) {
                emit($cg, "strada_decref(__qx_v); ");
            }
            emit($cg, "__qx_r; })");
            return 1;
        }

        # Additional file system
        # Event loop support (Async::Loop): epoll, eventfd, non-blocking
        # socket ops, IO-wait futures, coroutines. Uniform StradaValue*
        # signatures (the VM generic-builtin harvest picks these up).
        if ($name eq "sys::epoll_create") {
            emit($cg, "strada_epoll_create()");
            return 1;
        }

        if ($name eq "sys::epoll_add") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_epoll_add", $args, 3);
            return 1;
        }

        if ($name eq "sys::epoll_mod") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_epoll_mod", $args, 3);
            return 1;
        }

        if ($name eq "sys::epoll_del") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_epoll_del", $args, 2);
            return 1;
        }

        if ($name eq "sys::epoll_wait") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_epoll_wait", $args, 2);
            return 1;
        }

        if ($name eq "sys::eventfd") {
            emit($cg, "strada_eventfd_new()");
            return 1;
        }

        if ($name eq "sys::eventfd_signal") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_eventfd_signal", $args, 1);
            return 1;
        }

        if ($name eq "sys::eventfd_drain") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_eventfd_drain", $args, 1);
            return 1;
        }

        if ($name eq "sys::socket_try_recv") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_socket_try_recv", $args, 2);
            return 1;
        }

        if ($name eq "sys::socket_try_send") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_socket_try_send", $args, 2);
            return 1;
        }

        if ($name eq "sys::socket_try_accept") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_socket_try_accept", $args, 1);
            return 1;
        }

        if ($name eq "async::io_wait") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_io_wait_async", $args, 3);
            return 1;
        }

        if ($name eq "sys::coro_create") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_coro_create", $args, 1);
            return 1;
        }

        if ($name eq "sys::coro_resume") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_coro_resume", $args, 1);
            return 1;
        }

        if ($name eq "sys::coro_yield_io") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_coro_yield_io", $args, 3);
            return 1;
        }

        if ($name eq "sys::coro_state") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_coro_state", $args, 1);
            return 1;
        }

        if ($name eq "sys::coro_wait_fd") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_coro_wait_fd", $args, 1);
            return 1;
        }

        if ($name eq "sys::coro_wait_mask") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_coro_wait_mask", $args, 1);
            return 1;
        }

        if ($name eq "sys::coro_wait_timeout") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_coro_wait_timeout", $args, 1);
            return 1;
        }

        if ($name eq "sys::coro_result") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_coro_result", $args, 1);
            return 1;
        }

        if ($name eq "sys::coro_free") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_coro_free", $args, 1);
            return 1;
        }

        if ($name eq "sys::mono_ms") {
            emit($cg, "strada_mono_ms()");
            return 1;
        }

        if ($name eq "async::resolve") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_resolve_async", $args, 1);
            return 1;
        }

        if ($name eq "sys::coro_error") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_coro_error", $args, 1);
            return 1;
        }

        if ($name eq "sys::socket_try_connect") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_socket_try_connect", $args, 2);
            return 1;
        }

        if ($name eq "sys::socket_connect_check") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_socket_connect_check", $args, 1);
            return 1;
        }

        if ($name eq "sys::socket_try_readline") {
            my scalar $args = $expr->{"args"};
            if ($expr->{"arg_count"} >= 2) {
                gen_call_with_arg_cleanup($cg, "strada_socket_try_readline_max", $args, 2);
            } else {
                gen_call_with_arg_cleanup($cg, "strada_socket_try_readline", $args, 1);
            }
            return 1;
        }

        if ($name eq "sys::truncate") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_truncate", $args, 2);
            return 1;
        }

        if ($name eq "sys::ftruncate") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_ftruncate", $args, 2);
            return 1;
        }

        if ($name eq "sys::chown") {
            gen_call_with_arg_cleanup($cg, "strada_chown", $expr->{"args"}, 3);
            return 1;
        }

        if ($name eq "sys::lchown") {
            gen_call_with_arg_cleanup($cg, "strada_lchown", $expr->{"args"}, 3);
            return 1;
        }

        if ($name eq "sys::fchmod") {
            gen_call_with_arg_cleanup($cg, "strada_fchmod", $expr->{"args"}, 2);
            return 1;
        }

        if ($name eq "sys::fchown") {
            gen_call_with_arg_cleanup($cg, "strada_fchown", $expr->{"args"}, 3);
            return 1;
        }

        if ($name eq "sys::utime") {
            gen_call_with_arg_cleanup($cg, "strada_utime", $expr->{"args"}, 3);
            return 1;
        }
    return 0;
}

func gen_builtin_g8(scalar $cg, scalar $expr, str $name) int {

        if ($name eq "sys::utimes") {
            gen_call_with_arg_cleanup($cg, "strada_utimes", $expr->{"args"}, 3);
            return 1;
        }

        # Session/process group control
        if ($name eq "sys::setsid") {
            emit($cg, "strada_setsid()");
            return 1;
        }

        if ($name eq "sys::getsid") {
            gen_call_with_arg_cleanup($cg, "strada_getsid", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "sys::setpgid") {
            gen_call_with_arg_cleanup($cg, "strada_setpgid", $expr->{"args"}, 2);
            return 1;
        }

        if ($name eq "sys::getpgid") {
            gen_call_with_arg_cleanup($cg, "strada_getpgid", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "sys::getpgrp") {
            emit($cg, "strada_getpgrp()");
            return 1;
        }

        if ($name eq "sys::setpgrp") {
            emit($cg, "strada_setpgrp()");
            return 1;
        }

        # User/group ID control
        if ($name eq "sys::setuid") {
            gen_call_with_arg_cleanup($cg, "strada_setuid", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "sys::setgid") {
            gen_call_with_arg_cleanup($cg, "strada_setgid", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "sys::seteuid") {
            gen_call_with_arg_cleanup($cg, "strada_seteuid", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "sys::setegid") {
            gen_call_with_arg_cleanup($cg, "strada_setegid", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "sys::setreuid") {
            gen_call_with_arg_cleanup($cg, "strada_setreuid", $expr->{"args"}, 2);
            return 1;
        }

        if ($name eq "sys::setregid") {
            gen_call_with_arg_cleanup($cg, "strada_setregid", $expr->{"args"}, 2);
            return 1;
        }

        # Additional socket operations
        if ($name eq "sys::setsockopt") {
            gen_call_with_arg_cleanup($cg, "strada_setsockopt", $expr->{"args"}, 4);
            return 1;
        }

        if ($name eq "sys::getsockopt") {
            gen_call_with_arg_cleanup($cg, "strada_getsockopt", $expr->{"args"}, 3);
            return 1;
        }

        if ($name eq "sys::shutdown") {
            gen_call_with_arg_cleanup($cg, "strada_shutdown", $expr->{"args"}, 2);
            return 1;
        }

        if ($name eq "sys::getpeername") {
            gen_call_with_arg_cleanup($cg, "strada_getpeername", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "sys::getsockname") {
            gen_call_with_arg_cleanup($cg, "strada_getsockname", $expr->{"args"}, 1);
            return 1;
