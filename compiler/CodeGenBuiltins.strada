                emit($cg, "strada_channel_new(0)");
            }
            return 1;
        }

        if ($name eq "async::send") {
            # strada_channel_send increfs the value when queuing.
            my scalar $args = $expr->{"args"};
            my int $send_c_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[0]) == 1;
            my int $send_v_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[1]) == 1;
            if ($send_c_cleanup == 1 || $send_v_cleanup == 1) {
                emit($cg, "({ ");
                if ($send_c_cleanup == 1) {
                    emit($cg, "StradaValue *__send_c = ");
                    gen_expression($cg, $args->[0]);
                    emit($cg, "; strada_cleanup_push(__send_c); ");
                }
                if ($send_v_cleanup == 1) {
                    emit($cg, "StradaValue *__send_v = ");
                    gen_expression($cg, $args->[1]);
                    emit($cg, "; strada_cleanup_push(__send_v); ");
                }
                emit($cg, "strada_channel_send(");
                if ($send_c_cleanup == 1) { emit($cg, "__send_c"); } else { gen_expression($cg, $args->[0]); }
                emit($cg, ", ");
                if ($send_v_cleanup == 1) { emit($cg, "__send_v"); } else { gen_expression($cg, $args->[1]); }
                emit($cg, "); ");
                if ($send_v_cleanup == 1) { emit($cg, "strada_cleanup_pop_decref(__send_v); "); }
                if ($send_c_cleanup == 1) { emit($cg, "strada_cleanup_pop_decref(__send_c); "); }
                emit($cg, "strada_undef_static(); })");
            } else {
                emit($cg, "(strada_channel_send(");
                gen_expression($cg, $args->[0]);
                emit($cg, ", ");
                gen_expression($cg, $args->[1]);
                emit($cg, "), strada_undef_static())");
            }
            return 1;
        }

        if ($name eq "async::recv") {
            my scalar $args = $expr->{"args"};
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[0]) == 1) {
