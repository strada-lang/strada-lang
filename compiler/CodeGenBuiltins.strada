                    gen_expression($cg, $dl_arr_e);
                    emit($cg, "; int64_t __del_idx = ");
                    emit_int_operand($cg, $arg0->{"index"});
                    emit($cg, "; StradaValue *__del_r = strada_array_delete_idx(strada_deref_array(__del_a), __del_idx); strada_decref(__del_a); __del_r; })");
                } else {
