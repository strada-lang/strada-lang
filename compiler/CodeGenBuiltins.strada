        if ($name eq "async::atomic_dec") {
            my scalar $args = $expr->{"args"};
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[0]) == 1) {
                emit($cg, "({ StradaValue *__at_a = ");
                gen_expression($cg, $args->[0]);
                emit($cg, "; int64_t __at_r = strada_atomic_dec(__at_a); strada_decref(__at_a); strada_new_int(__at_r); })");
            } else {
                emit($cg, "strada_new_int(strada_atomic_dec(");
                gen_expression($cg, $args->[0]);
                emit($cg, "))");
            }
            return 1;
        }

        if ($name eq "async::atomic_cas") {
            my scalar $args = $expr->{"args"};
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[0]) == 1) {
                emit($cg, "({ StradaValue *__at_a = ");
                gen_expression($cg, $args->[0]);
                emit($cg, "; int64_t __at_r = strada_atomic_cas(__at_a, ");
                emit_int_operand($cg, $args->[1]);
                emit($cg, ", ");
                emit_int_operand($cg, $args->[2]);
                emit($cg, "); strada_decref(__at_a); strada_new_int(__at_r); })");
            } else {
                emit($cg, "strada_new_int(strada_atomic_cas(");
                gen_expression($cg, $args->[0]);
                emit($cg, ", ");
                emit_int_operand($cg, $args->[1]);
                emit($cg, ", ");
                emit_int_operand($cg, $args->[2]);
                emit($cg, "))");
            }
            return 1;
        }

        # Directory functions
        if ($name eq "sys::readdir") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_readdir", $args, 1);
            return 1;
        }

        if ($name eq "sys::readdir_full") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_readdir_full", $args, 1);
            return 1;
        }

        if ($name eq "sys::is_dir") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_is_dir", $args, 1);
            return 1;
        }

        if ($name eq "sys::is_file") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_is_file", $args, 1);
            return 1;
        }

        if ($name eq "sys::is_readable") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_is_readable", $args, 1);
            return 1;
        }

        if ($name eq "sys::is_writable") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_is_writable", $args, 1);
            return 1;
        }

        if ($name eq "sys::is_executable") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_is_executable", $args, 1);
            return 1;
        }

        if ($name eq "sys::is_zero_size") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_is_zero_size", $args, 1);
            return 1;
        }

        if ($name eq "sys::is_symlink") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_is_symlink", $args, 1);
            return 1;
        }

        if ($name eq "sys::file_exists") {
            my scalar $args = $expr->{"args"};
            my scalar $arg = $args->[0];
            emit($cg, "({ StradaValue *__fe_v = ");
            gen_expression($cg, $arg);
            emit($cg, "; char *__fe_s = strada_to_str_ss(__fe_v); int __fe_i = strada_file_exists(__fe_s); strada_cstr_free(__fe_s); ");
            if (needs_temp_cleanup($cg, $arg) == 1) {
                emit($cg, "strada_decref(__fe_v); ");
            }
            emit($cg, "strada_new_int(__fe_i); })");
            return 1;
        }

        if ($name eq "sys::file_mtime") {
            # core::file_mtime(path) -> int (seconds since epoch, -1 on stat
            # failure). Cheap stat() wrapper used by the parser to decide
            # whether a pre-compiled .o/.so artifact is fresher than its
            # .strada source.
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_file_mtime", $args, 1);
            return 1;
        }
    return 0;
}

func gen_builtin_g4(scalar $cg, scalar $expr, str $name) int {

        if ($name eq "sys::dir_exists") {
            # dir_exists is the same as is_dir
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_is_dir", $args, 1);
            return 1;
        }

        if ($name eq "sys::file_size") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_file_size", $args, 1);
            return 1;
        }

        # Math functions - with argument cleanup
        if ($name eq "math::sin" || $name eq "math::cos" || $name eq "math::tan" ||
            $name eq "math::asin" || $name eq "math::acos" || $name eq "math::atan" ||
            $name eq "math::sqrt" || $name eq "math::log" || $name eq "math::log10" ||
            $name eq "math::exp" || $name eq "math::floor" || $name eq "math::ceil" ||
            $name eq "math::abs" || $name eq "math::round" ||
            $name eq "math::sinh" || $name eq "math::cosh" || $name eq "math::tanh") {
            my scalar $args = $expr->{"args"};
            my scalar $arg0 = $args->[0];
            my int $needs_cleanup = needs_temp_cleanup($cg, $arg0);

            # Determine the C function name
            my str $c_func = "strada_sin";
            if ($name eq "math::cos") { $c_func = "strada_cos"; }
            if ($name eq "math::tan") { $c_func = "strada_tan"; }
            if ($name eq "math::asin") { $c_func = "strada_asin"; }
            if ($name eq "math::acos") { $c_func = "strada_acos"; }
            if ($name eq "math::atan") { $c_func = "strada_atan"; }
            if ($name eq "math::sqrt") { $c_func = "strada_sqrt"; }
            if ($name eq "math::log") { $c_func = "strada_log"; }
            if ($name eq "math::log10") { $c_func = "strada_log10"; }
            if ($name eq "math::exp") { $c_func = "strada_exp"; }
            if ($name eq "math::floor") { $c_func = "strada_floor"; }
            if ($name eq "math::ceil") { $c_func = "strada_ceil"; }
            if ($name eq "math::abs") { $c_func = "strada_abs"; }
            if ($name eq "math::round") { $c_func = "strada_round"; }
            if ($name eq "math::sinh") { $c_func = "strada_sinh"; }
            if ($name eq "math::cosh") { $c_func = "strada_cosh"; }
            if ($name eq "math::tanh") { $c_func = "strada_tanh"; }

            if ($needs_cleanup == 1) {
                emit($cg, "(({ StradaValue *__math_arg = ");
                gen_expression($cg, $arg0);
                emit($cg, "; StradaValue *__math_res = " . $c_func . "(__math_arg); ");
                emit($cg, "strada_decref(__math_arg); __math_res; }))");
            } else {
                emit($cg, $c_func . "(");
                gen_expression($cg, $arg0);
                emit($cg, ")");
            }
            return 1;
        }

        if ($name eq "math::atan2") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_atan2", $args, 2);
            return 1;
        }

        if ($name eq "math::log") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_log", $args, 1);
            return 1;
        }

        if ($name eq "math::log10") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_log10", $args, 1);
            return 1;
        }

        if ($name eq "math::exp") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_exp", $args, 1);
            return 1;
        }

        if ($name eq "math::pow") {
            my scalar $args = $expr->{"args"};
            my scalar $arg0 = $args->[0];
            my scalar $arg1 = $args->[1];
            my int $arg0_needs_cleanup = needs_temp_cleanup($cg, $arg0);
            my int $arg1_needs_cleanup = needs_temp_cleanup($cg, $arg1);

            if ($arg0_needs_cleanup == 1 || $arg1_needs_cleanup == 1) {
                emit($cg, "(({ StradaValue *__pow_arg0 = ");
                gen_expression($cg, $arg0);
                emit($cg, "; StradaValue *__pow_arg1 = ");
                gen_expression($cg, $arg1);
                emit($cg, "; StradaValue *__pow_res = strada_pow(__pow_arg0, __pow_arg1); ");
                if ($arg0_needs_cleanup == 1) {
                    emit($cg, "strada_decref(__pow_arg0); ");
                }
                if ($arg1_needs_cleanup == 1) {
                    emit($cg, "strada_decref(__pow_arg1); ");
                }
                emit($cg, "__pow_res; }))");
            } else {
                emit($cg, "strada_pow(");
                gen_expression($cg, $arg0);
                emit($cg, ", ");
                gen_expression($cg, $arg1);
                emit($cg, ")");
            }
            return 1;
        }

        if ($name eq "math::floor") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_floor", $args, 1);
            return 1;
        }

        if ($name eq "math::ceil") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_ceil", $args, 1);
            return 1;
        }

        if ($name eq "math::round") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_round", $args, 1);
            return 1;
        }

        if ($name eq "math::fabs") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_fabs", $args, 1);
            return 1;
        }

        if ($name eq "math::fmod") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_fmod", $args, 2);
            return 1;
        }

        if ($name eq "math::sinh") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_sinh", $args, 1);
            return 1;
        }

        if ($name eq "math::cosh") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_cosh", $args, 1);
            return 1;
        }

        if ($name eq "math::tanh") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_tanh", $args, 1);
            return 1;
        }

        # File seek functions
        if ($name eq "sys::seek") {
            my scalar $args = $expr->{"args"};
            if ($expr->{"arg_count"} > 2) {
                gen_call_with_arg_cleanup($cg, "strada_seek", $args, 3);
            } else {
                emit($cg, "({ StradaValue *__sk_fh = ");
                gen_expression($cg, $args->[0]);
                emit($cg, "; StradaValue *__sk_off = ");
                gen_expression($cg, $args->[1]);
                emit($cg, "; StradaValue *__sk_r = strada_seek(__sk_fh, __sk_off, STRADA_MAKE_TAGGED_INT(0)); ");
                if (needs_temp_cleanup($cg, $args->[0]) == 1) {
                    emit($cg, "strada_decref(__sk_fh); ");
                }
                if (needs_temp_cleanup($cg, $args->[1]) == 1) {
                    emit($cg, "strada_decref(__sk_off); ");
                }
                emit($cg, "__sk_r; })");
            }
            return 1;
        }

        if ($name eq "sys::tell") {
            gen_call_with_arg_cleanup($cg, "strada_tell", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "sys::rewind") {
            gen_call_with_arg_cleanup($cg, "strada_rewind", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "sys::eof") {
            gen_call_with_arg_cleanup($cg, "strada_eof", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "sys::flush") {
            gen_call_with_arg_cleanup($cg, "strada_flush", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "sys::autoflush") {
            my scalar $args = $expr->{"args"};
            if (scalar(@{$args}) >= 2) {
                gen_call_with_arg_cleanup($cg, "strada_autoflush", $args, 2);
            } else {
                my scalar $arg0 = $args->[0];
                if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $arg0) == 1) {
                    emit($cg, "({ StradaValue *__af_fh = ");
                    gen_expression($cg, $arg0);
                    emit($cg, "; StradaValue *__af_r = strada_autoflush(__af_fh, STRADA_MAKE_TAGGED_INT(1)); strada_decref(__af_fh); __af_r; })");
                } else {
                    emit($cg, "strada_autoflush(");
                    gen_expression($cg, $arg0);
                    emit($cg, ", STRADA_MAKE_TAGGED_INT(1))");
                }
            }
            return 1;
        }

        if ($name eq "sys::readline") {
            # core::readline($fh [, $max_bytes]) - optional per-call byte limit
            if ($expr->{"arg_count"} >= 2) {
                gen_call_with_arg_cleanup($cg, "strada_read_line_max", $expr->{"args"}, 2);
            } else {
                gen_call_with_arg_cleanup($cg, "strada_read_line", $expr->{"args"}, 1);
            }
            return 1;
        }

        # DNS/Hostname functions
        if ($name eq "sys::gethostbyname") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_gethostbyname", $args, 1);
            return 1;
        }

        if ($name eq "sys::gethostbyname_all") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_gethostbyname_all", $args, 1);
            return 1;
        }

        if ($name eq "sys::gethostname") {
            emit($cg, "strada_gethostname()");
            return 1;
        }

        if ($name eq "sys::getaddrinfo") {
            my scalar $args = $expr->{"args"};
            if ($expr->{"arg_count"} > 1) {
                gen_call_with_arg_cleanup($cg, "strada_getaddrinfo_first", $args, 2);
            } else {
                my scalar $arg0 = $args->[0];
                if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $arg0) == 1) {
                    emit($cg, "({ StradaValue *__ga_h = ");
                    gen_expression($cg, $arg0);
                    emit($cg, "; StradaValue *__ga_r = strada_getaddrinfo_first(__ga_h, NULL); strada_decref(__ga_h); __ga_r; })");
                } else {
                    emit($cg, "strada_getaddrinfo_first(");
                    gen_expression($cg, $arg0);
                    emit($cg, ", NULL)");
                }
            }
            return 1;
        }

        # Path functions
        if ($name eq "sys::realpath") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_realpath", $args, 1);
            return 1;
        }

        if ($name eq "sys::dirname") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_dirname", $args, 1);
            return 1;
        }

        if ($name eq "sys::basename") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_basename", $args, 1);
            return 1;
        }

        if ($name eq "sys::glob") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_glob", $args, 1);
            return 1;
        }

        if ($name eq "sys::fnmatch") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_fnmatch", $args, 2);
            return 1;
        }

        if ($name eq "sys::file_ext") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_file_ext", $args, 1);
            return 1;
        }

        if ($name eq "sys::path_join") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_path_join", $args, 1);
            return 1;
        }

        if ($name eq "int") {
            my scalar $args = $expr->{"args"};
            my scalar $int_arg = $args->[0];
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $int_arg) == 1) {
                emit($cg, "({ StradaValue *__int_tmp = ");
                gen_expression($cg, $int_arg);
                emit($cg, "; StradaValue *__int_res = strada_new_int_il(strada_to_int(__int_tmp)); strada_decref(__int_tmp); __int_res; })");
            } else {
                emit($cg, "strada_new_int_il(strada_to_int(");
                gen_expression($cg, $int_arg);
                emit($cg, "))");
            }
            return 1;
        }
        
        if ($name eq "chr") {
            # Use strada_chr_sv for binary-safe chr that handles NUL bytes
            # Use emit_int_operand to avoid leaking memoria for integer literals
            emit($cg, "strada_chr_sv(");
            my scalar $args = $expr->{"args"};
            emit_int_operand($cg, $args->[0]);
            emit($cg, ")");
            return 1;
        }

        # core::byte(n) — single raw byte (n & 0xFF), never UTF-8 encoded.
        # The byte-oriented counterpart to chr() for building binary data
        # that must round-trip through base64/pack/sockets/files.
        if ($name eq "sys::byte") {
            emit($cg, "strada_byte_chr(");
            my scalar $args = $expr->{"args"};
            emit_int_operand($cg, $args->[0]);
            emit($cg, ")");
            return 1;
        }
        
        if ($name eq "ord") {
            my scalar $args = $expr->{"args"};
            my scalar $arg0 = $args->[0];
            my int $needs_cleanup = needs_temp_cleanup($cg, $arg0);
            emit($cg, "(({ StradaValue *__ord_tmp = ");
            gen_expression($cg, $arg0);
            emit($cg, "; char *__ord_str = strada_to_str_ss(__ord_tmp); ");
            emit($cg, "StradaValue *__ord_res = strada_new_int(strada_ord(__ord_str)); ");
            emit($cg, "strada_cstr_free(__ord_str); ");
            if ($needs_cleanup == 1) {
                emit($cg, "strada_decref(__ord_tmp); ");
            }
            emit($cg, "__ord_res; }))");
            return 1;
        }

        # hex - convert hex string to integer: hex("ff") -> 255
        if ($name eq "sys::hex") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_hex", $args, 1);
            return 1;
        }

        # ord_byte - binary-safe ord that returns raw byte value 0-255
        # sys::vec_get(SV, OFFSET, BITS) — perl's vec() rvalue form.
        # Reads a BITS-wide field at OFFSET (counted in BITS-wide units)
        # from SV's underlying string. BITS must be a power of 2 in
        # {1,2,4,8,16,32,64}. Returns int.
        if ($name eq "sys::vec_get") {
            my scalar $args = $expr->{"args"};
            # Capture-and-decref pattern (same as vec_set) so owned-temp
            # args don't leak per call.
            my int $a0_cln = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[0]) == 1;
            my int $a1_cln = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[1]) == 1;
            my int $a2_cln = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[2]) == 1;
            emit($cg, "({ StradaValue *__vg_sv = ");
            gen_expression($cg, $args->[0]);
            emit($cg, "; StradaValue *__vg_off = ");
            gen_expression($cg, $args->[1]);
            emit($cg, "; StradaValue *__vg_bits = ");
            gen_expression($cg, $args->[2]);
            emit($cg, "; StradaValue *__vg_r = strada_new_int(strada_vec_get(__vg_sv, strada_to_int(__vg_off), (int)strada_to_int(__vg_bits))); ");
            if ($a0_cln == 1) { emit($cg, "strada_decref(__vg_sv); "); }
            if ($a1_cln == 1) { emit($cg, "strada_decref(__vg_off); "); }
            if ($a2_cln == 1) { emit($cg, "strada_decref(__vg_bits); "); }
            emit($cg, "__vg_r; })");
            return 1;
        }
        # sys::vec_set(SV, OFFSET, BITS, VALUE) — perl's vec() lvalue form.
        # Writes VALUE as a BITS-wide field at OFFSET. Extends SV with
        # zero-fill if needed. SV must be a mutable scalar (caller is
        # responsible — passing a refcounted shared string would mutate
        # other holders).
        if ($name eq "sys::vec_set") {
            my scalar $args = $expr->{"args"};
            # Capture each owned-temp arg and decref after the call —
            # vec_set's gen previously leaked the slot-ref/BITS-wrapper/
            # VALUE temps every iteration. The SV arg (\$buf) is almost
            # always strada_slot_ref_create which IS an owned temp;
            # check_temp_cleanup catches it. Same for the int literal
            # BITS (8/16/etc) which gen_expression wraps in strada_new_int.
            my int $a0_cln = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[0]) == 1;
            my int $a1_cln = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[1]) == 1;
            my int $a2_cln = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[2]) == 1;
            my int $a3_cln = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[3]) == 1;
            emit($cg, "({ StradaValue *__vs_sv = ");
            gen_expression($cg, $args->[0]);
            emit($cg, "; StradaValue *__vs_off = ");
            gen_expression($cg, $args->[1]);
            emit($cg, "; StradaValue *__vs_bits = ");
            gen_expression($cg, $args->[2]);
            emit($cg, "; StradaValue *__vs_val = ");
            gen_expression($cg, $args->[3]);
            emit($cg, "; strada_vec_set(__vs_sv, strada_to_int(__vs_off), (int)strada_to_int(__vs_bits), strada_to_int(__vs_val)); ");
            if ($a0_cln == 1) { emit($cg, "strada_decref(__vs_sv); "); }
            if ($a1_cln == 1) { emit($cg, "strada_decref(__vs_off); "); }
            if ($a2_cln == 1) { emit($cg, "strada_decref(__vs_bits); "); }
            if ($a3_cln == 1) { emit($cg, "strada_decref(__vs_val); "); }
            emit($cg, "strada_new_undef(); })");
            return 1;
        }
        if ($name eq "sys::ord_byte") {
            my scalar $args = $expr->{"args"};
            my scalar $a0 = $args->[0];
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $a0) == 1) {
                emit($cg, "({ StradaValue *__bb_v = ");
                gen_expression($cg, $a0);
                emit($cg, "; int __bb_r = strada_ord_byte(__bb_v); strada_decref(__bb_v); strada_new_int(__bb_r); })");
            } else {
                emit($cg, "strada_new_int(strada_ord_byte(");
                gen_expression($cg, $a0);
                emit($cg, "))");
            }
            return 1;
        }

        # get_byte - get byte at position (0-indexed), returns 0-255 or -1
        if ($name eq "sys::get_byte") {
            my scalar $args = $expr->{"args"};
            my scalar $a0 = $args->[0];
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $a0) == 1) {
                emit($cg, "({ StradaValue *__bb_v = ");
                gen_expression($cg, $a0);
                emit($cg, "; int __bb_r = strada_get_byte(__bb_v, ");
                emit_int_operand($cg, $args->[1]);
                emit($cg, "); strada_decref(__bb_v); strada_new_int(__bb_r); })");
            } else {
