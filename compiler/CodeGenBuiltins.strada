                    }
                    if ($ctor_is_user_defined == 1) {
                        my scalar $inh2 = $cg->{"inherits"};
                        my int $ic2 = $cg->{"inherit_count"} + 0;
                        my int $ii2 = 0;
                        while ($ii2 < $ic2 && $ctor_is_user_defined == 1) {
                            if (pkg_c_safe("" . $inh2->[$ii2]->{"child"}) eq $check_pkg2) {
                                $ctor_is_user_defined = 0;
