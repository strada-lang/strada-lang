                                $cg->{"tmp_counter"} = $fsi + 1;
                                push(@fss_ids, $fsi);
                                emit($cg, "static StradaString *__fss" . $fsi . " = NULL; if (__builtin_expect(!__fss" . $fsi . ", 0)) __fss" . $fsi . " = strada_intern_attr_ss(" . c_str_lit($fkey) . ", " . $fkhash . "u); ");
