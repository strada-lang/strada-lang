func gen_builtin_g1(scalar $cg, scalar $expr, str $name) int {
        if ($name eq "say") {
            my int $argc = $expr->{"arg_count"};
            my scalar $args = $expr->{"args"};
            if ($argc == 2) {
                # say($fh, $text) - say to filehandle
                my scalar $fh_arg = $args->[0];
                my scalar $text_arg = $args->[1];
                my int $fh_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $fh_arg) == 1;
                my int $tx_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $text_arg) == 1;
                if ($fh_cl == 1 || $tx_cl == 1) {
                    emit($cg, "({ ");
                    if ($tx_cl == 1) {
                        emit($cg, "StradaValue *__say_tmp = ");
                        gen_expression($cg, $text_arg);
                        emit($cg, "; ");
                    }
                    if ($fh_cl == 1) {
                        emit($cg, "StradaValue *__say_fh = ");
                        gen_expression($cg, $fh_arg);
                        emit($cg, "; ");
                    }
                    emit($cg, "strada_say_fh(");
                    if ($tx_cl == 1) { emit($cg, "__say_tmp"); } else { gen_expression($cg, $text_arg); }
                    emit($cg, ", ");
                    if ($fh_cl == 1) { emit($cg, "__say_fh"); } else { gen_expression($cg, $fh_arg); }
                    emit($cg, "); ");
                    if ($tx_cl == 1) { emit($cg, "strada_decref(__say_tmp); "); }
                    if ($fh_cl == 1) { emit($cg, "strada_decref(__say_fh); "); }
                    emit($cg, "STRADA_MAKE_TAGGED_INT(1); })");
                } else {
                    emit($cg, "({ strada_say_fh(");
                    gen_expression($cg, $text_arg);
                    emit($cg, ", ");
                    gen_expression($cg, $fh_arg);
                    emit($cg, "); STRADA_MAKE_TAGGED_INT(1); })");
                }
            } elsif ($argc > 2) {
                # Multi-arg say: print each arg in sequence then a newline.
                # Previously only args[0] was emitted, so `say("a","b","c")`
                # silently dropped "b" and "c".
                emit($cg, "({ ");
                my int $say_i = 0;
                while ($say_i < $argc) {
                    my scalar $sa = $args->[$say_i];
                    if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $sa) == 1) {
                        emit($cg, "{ StradaValue *__say_v = ");
                        gen_expression($cg, $sa);
                        emit($cg, "; strada_print(__say_v); strada_decref(__say_v); } ");
                    } else {
                        emit($cg, "strada_print(");
                        gen_expression($cg, $sa);
                        emit($cg, "); ");
                    }
                    $say_i = $say_i + 1;
                }
                emit($cg, "strada_say(NULL); STRADA_MAKE_TAGGED_INT(1); })");
            } elsif ($argc > 0) {
                my scalar $arg = $args->[0];
                # If cleanup enabled and arg is a temporary, wrap to decref after
                if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $arg) == 1) {
                    emit($cg, "({ StradaValue *__say_tmp = ");
                    gen_expression($cg, $arg);
                    emit($cg, "; strada_say(__say_tmp); strada_decref(__say_tmp); STRADA_MAKE_TAGGED_INT(1); })");
                } else {
                    emit($cg, "({ strada_say(");
                    gen_expression($cg, $arg);
                    emit($cg, "); STRADA_MAKE_TAGGED_INT(1); })");
                }
            } else {
                emit($cg, "({ strada_say(NULL); STRADA_MAKE_TAGGED_INT(1); })");
            }
            return 1;
        }

        if ($name eq "print") {
            my int $argc = $expr->{"arg_count"};
            my scalar $args = $expr->{"args"};
            if ($argc == 2) {
                # print($fh, $text) - print to filehandle
                my scalar $fh_arg = $args->[0];
                my scalar $text_arg = $args->[1];
                my int $fh_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $fh_arg) == 1;
                my int $tx_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $text_arg) == 1;
                if ($fh_cl == 1 || $tx_cl == 1) {
                    emit($cg, "({ ");
                    if ($tx_cl == 1) {
                        emit($cg, "StradaValue *__print_tmp = ");
                        gen_expression($cg, $text_arg);
                        emit($cg, "; ");
                    }
                    if ($fh_cl == 1) {
                        emit($cg, "StradaValue *__print_fh = ");
                        gen_expression($cg, $fh_arg);
                        emit($cg, "; ");
                    }
                    emit($cg, "strada_print_fh(");
                    if ($tx_cl == 1) { emit($cg, "__print_tmp"); } else { gen_expression($cg, $text_arg); }
                    emit($cg, ", ");
                    if ($fh_cl == 1) { emit($cg, "__print_fh"); } else { gen_expression($cg, $fh_arg); }
                    emit($cg, "); ");
                    if ($tx_cl == 1) { emit($cg, "strada_decref(__print_tmp); "); }
                    if ($fh_cl == 1) { emit($cg, "strada_decref(__print_fh); "); }
                    emit($cg, "STRADA_MAKE_TAGGED_INT(1); })");
                } else {
                    emit($cg, "({ strada_print_fh(");
                    gen_expression($cg, $text_arg);
                    emit($cg, ", ");
                    gen_expression($cg, $fh_arg);
                    emit($cg, "); STRADA_MAKE_TAGGED_INT(1); })");
                }
            } elsif ($argc > 2) {
                # Multi-arg print: emit each arg in sequence. Previously
                # only args[0] was emitted, silently dropping later args.
                emit($cg, "({ ");
                my int $print_i = 0;
                while ($print_i < $argc) {
                    my scalar $pa = $args->[$print_i];
                    if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $pa) == 1) {
                        emit($cg, "{ StradaValue *__print_v = ");
                        gen_expression($cg, $pa);
                        emit($cg, "; strada_print(__print_v); strada_decref(__print_v); } ");
                    } else {
                        emit($cg, "strada_print(");
                        gen_expression($cg, $pa);
                        emit($cg, "); ");
                    }
                    $print_i = $print_i + 1;
                }
                emit($cg, "STRADA_MAKE_TAGGED_INT(1); })");
            } elsif ($argc > 0) {
                my scalar $arg = $args->[0];
                # If cleanup enabled and arg is a temporary, wrap to decref after
                if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $arg) == 1) {
                    emit($cg, "({ StradaValue *__print_tmp = ");
                    gen_expression($cg, $arg);
                    emit($cg, "; strada_print(__print_tmp); strada_decref(__print_tmp); STRADA_MAKE_TAGGED_INT(1); })");
                } else {
                    emit($cg, "({ strada_print(");
                    gen_expression($cg, $arg);
                    emit($cg, "); STRADA_MAKE_TAGGED_INT(1); })");
                }
            } else {
                emit($cg, "({ strada_print(NULL); STRADA_MAKE_TAGGED_INT(1); })");
            }
            return 1;
        }
        
        if ($name eq "length") {
            # Binary-safe UTF-8 character count — walks the full byte length
            # so embedded NUL bytes are counted as chars rather than ending
            # the string (which strlen-based path did).
            my scalar $args = $expr->{"args"};
            my scalar $arg = $args->[0];
            emit($cg, "({ StradaValue *__len_tmp = ");
            gen_expression($cg, $arg);
            emit($cg, "; int64_t __len_res = strada_length_chars_sv(__len_tmp); ");
            if (needs_temp_cleanup($cg, $arg) == 1) {
                emit($cg, "strada_decref(__len_tmp); ");
            }
            emit($cg, "strada_new_int(__len_res); })");
            return 1;
        }

        if ($name eq "bytes") {
            # Binary-safe byte count using struct_size
            my scalar $args = $expr->{"args"};
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[0]) == 1) {
                emit($cg, "({ StradaValue *__bytes_v = ");
                gen_expression($cg, $args->[0]);
                emit($cg, "; StradaValue *__bytes_r = strada_new_int(strada_length_sv(__bytes_v)); strada_decref(__bytes_v); __bytes_r; })");
            } else {
                emit($cg, "strada_new_int(strada_length_sv(");
                gen_expression($cg, $args->[0]);
                emit($cg, "))");
            }
            return 1;
        }

        if ($name eq "char_at") {
            my scalar $args = $expr->{"args"};
            my scalar $ca_arg0 = $args->[0];
            my scalar $ca_arg1 = $args->[1];
            my int $ca_cleanup0 = needs_temp_cleanup($cg, $ca_arg0);
            my int $ca_cleanup1 = needs_temp_cleanup($cg, $ca_arg1);
            if ($ca_cleanup0 == 1 || $ca_cleanup1 == 1) {
                emit($cg, "({ ");
                if ($ca_cleanup0 == 1) {
                    emit($cg, "StradaValue *__ca_a0 = ");
                    gen_expression($cg, $ca_arg0);
                    emit($cg, "; ");
                }
                if ($ca_cleanup1 == 1) {
                    emit($cg, "StradaValue *__ca_a1 = ");
                    gen_expression($cg, $ca_arg1);
                    emit($cg, "; ");
                }
                emit($cg, "StradaValue *__ca_res = strada_char_at(");
                if ($ca_cleanup0 == 1) {
                    emit($cg, "__ca_a0");
                } else {
                    gen_expression($cg, $ca_arg0);
                }
                emit($cg, ", ");
                if ($ca_cleanup1 == 1) {
                    emit($cg, "__ca_a1");
                } else {
                    gen_expression($cg, $ca_arg1);
                }
                emit($cg, "); ");
                if ($ca_cleanup0 == 1) {
                    emit($cg, "strada_decref(__ca_a0); ");
                }
                if ($ca_cleanup1 == 1) {
                    emit($cg, "strada_decref(__ca_a1); ");
                }
                emit($cg, "__ca_res; })");
            } else {
                emit($cg, "strada_char_at(");
                gen_expression($cg, $ca_arg0);
                emit($cg, ", ");
                gen_expression($cg, $ca_arg1);
                emit($cg, ")");
            }
            return 1;
        }

        if ($name eq "byte_at") {
            my scalar $args = $expr->{"args"};
            my scalar $ba_arg0 = $args->[0];
            my scalar $ba_arg1 = $args->[1];
            my int $ba_cleanup0 = needs_temp_cleanup($cg, $ba_arg0);
            my int $ba_cleanup1 = needs_temp_cleanup($cg, $ba_arg1);
            if ($ba_cleanup0 == 1 || $ba_cleanup1 == 1) {
                emit($cg, "({ ");
                if ($ba_cleanup0 == 1) {
                    emit($cg, "StradaValue *__ba_a0 = ");
                    gen_expression($cg, $ba_arg0);
                    emit($cg, "; ");
                }
                if ($ba_cleanup1 == 1) {
                    emit($cg, "StradaValue *__ba_a1 = ");
                    gen_expression($cg, $ba_arg1);
                    emit($cg, "; ");
                }
                emit($cg, "StradaValue *__ba_res = strada_byte_at(");
                if ($ba_cleanup0 == 1) {
                    emit($cg, "__ba_a0");
                } else {
                    gen_expression($cg, $ba_arg0);
                }
                emit($cg, ", ");
                if ($ba_cleanup1 == 1) {
                    emit($cg, "__ba_a1");
                } else {
                    gen_expression($cg, $ba_arg1);
                }
                emit($cg, "); ");
                if ($ba_cleanup0 == 1) {
                    emit($cg, "strada_decref(__ba_a0); ");
                }
                if ($ba_cleanup1 == 1) {
                    emit($cg, "strada_decref(__ba_a1); ");
                }
                emit($cg, "__ba_res; })");
            } else {
                emit($cg, "strada_byte_at(");
                gen_expression($cg, $ba_arg0);
                emit($cg, ", ");
                gen_expression($cg, $ba_arg1);
                emit($cg, ")");
            }
            return 1;
        }

        if ($name eq "substr_bytes") {
            my scalar $args = $expr->{"args"};
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[0]) == 1) {
                emit($cg, "({ StradaValue *__subb_v = ");
                gen_expression($cg, $args->[0]);
                emit($cg, "; StradaValue *__subb_r = strada_substr_bytes(__subb_v, ");
                emit_int_operand($cg, $args->[1]);
                emit($cg, ", ");
                if ($expr->{"arg_count"} > 2) {
                    emit_int_operand($cg, $args->[2]);
                } else {
                    emit($cg, "-1");
                }
                emit($cg, "); strada_decref(__subb_v); __subb_r; })");
            } else {
                emit($cg, "strada_substr_bytes(");
                gen_expression($cg, $args->[0]);
                emit($cg, ", ");
                emit_int_operand($cg, $args->[1]);
                emit($cg, ", ");
                if ($expr->{"arg_count"} > 2) {
                    emit_int_operand($cg, $args->[2]);
                } else {
                    emit($cg, "-1");
                }
                emit($cg, ")");
            }
            return 1;
        }

        if ($name eq "substr") {
            my scalar $args = $expr->{"args"};
            my int $argc_sub = $expr->{"arg_count"};
            # 4-arg substr($s, $off, $len, $repl): replace [off, off+len)
            # with $repl in $s and return the removed slice. Routes to
            # strada_substr_replace and writes the new string back to the
            # lvalue ($s scalar var / $arr[N] / $h{k}). Without this branch
            # the 4th arg was silently ignored — substr(\$x, 0, 5, "Y") on
            # "Hello World" was a no-op.
            if ($argc_sub >= 4) {
                my scalar $tgt = $args->[0];
                my int $tt = $tgt->{"type"};
                my int $rp_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[3]) == 1;
                if ($tt == NODE_VARIABLE()) {
                    my str $vcname = escape_c_keyword($tgt->{"name"});
                    my str $sr_our_key = "" . $cg->{"our_vars"}->{$vcname};
                    if (length($sr_our_key) > 0) {
                        emit($cg, "({ StradaValue *__sr_cur = strada_global_get_cstr(" . c_str_lit($sr_our_key) . "); ");
                        emit($cg, "StradaValue *__sr_rp = ");
                        gen_expression($cg, $args->[3]);
                        emit($cg, "; StradaValue *__sr_old = NULL; StradaValue *__sr_new = strada_substr_replace(__sr_cur, ");
                        emit_int_operand($cg, $args->[1]);
                        emit($cg, ", ");
                        emit_int_operand($cg, $args->[2]);
                        emit($cg, ", __sr_rp, &__sr_old); strada_decref(__sr_cur); ");
                        if ($rp_cl == 1) { emit($cg, "strada_decref(__sr_rp); "); }
                        emit($cg, "strada_global_set_cstr(" . c_str_lit($sr_our_key) . ", __sr_new); __sr_old; })");
                        return 1;
                    }
                    my str $vref = scalar_var_c_ref($cg, $tgt->{"name"}, $vcname);
                    emit($cg, "({ StradaValue *__sr_rp = ");
                    gen_expression($cg, $args->[3]);
                    emit($cg, "; StradaValue *__sr_old = NULL; StradaValue *__sr_new = strada_substr_replace(" . $vref . ", ");
                    emit_int_operand($cg, $args->[1]);
                    emit($cg, ", ");
                    emit_int_operand($cg, $args->[2]);
                    emit($cg, ", __sr_rp, &__sr_old); ");
                    if ($rp_cl == 1) { emit($cg, "strada_decref(__sr_rp); "); }
                    if ($cg->{"uses_tie"} == 1) {
                        emit($cg, "if (strada_scalar_is_tied(" . $vref . ")) { strada_tied_scalar_store(" . $vref . ", __sr_new); strada_decref(__sr_new); } else { strada_decref(" . $vref . "); " . $vref . " = __sr_new; } ");
                    } else {
                        emit($cg, "strada_decref(" . $vref . "); " . $vref . " = __sr_new; ");
                    }
                    emit($cg, "__sr_old; })");
                    return 1;
                }
                if ($tt == NODE_SUBSCRIPT() || $tt == NODE_DEREF_ARRAY()) {
                    my scalar $sr_arr_e = $tgt->{"array"};
                    if ($tt == NODE_DEREF_ARRAY()) { $sr_arr_e = $tgt->{"ref"}; }
                    my int $sr_arr_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $sr_arr_e) == 1;
                    emit($cg, "({ StradaValue *__sr_a = ");
                    gen_expression($cg, $sr_arr_e);
                    emit($cg, "; int64_t __sr_idx = ");
                    emit_int_operand($cg, $tgt->{"index"});
                    emit($cg, "; StradaValue *__sr_rp = ");
                    gen_expression($cg, $args->[3]);
                    emit($cg, "; StradaValue *__sr_oldv = strada_av_fetch_sv(__sr_a, __sr_idx); StradaValue *__sr_old = NULL; ");
                    emit($cg, "StradaValue *__sr_new = strada_substr_replace(__sr_oldv, ");
                    emit_int_operand($cg, $args->[1]);
                    emit($cg, ", ");
                    emit_int_operand($cg, $args->[2]);
                    emit($cg, ", __sr_rp, &__sr_old); strada_decref(__sr_oldv); ");
                    if ($rp_cl == 1) { emit($cg, "strada_decref(__sr_rp); "); }
                    if ($cg->{"uses_tie"} == 1) {
                        emit($cg, "strada_av_store_sv(__sr_a, __sr_idx, __sr_new); ");
                    } else {
                        emit($cg, "strada_array_set(strada_deref_array(__sr_a), __sr_idx, __sr_new); ");
                    }
                    emit($cg, "strada_decref(__sr_new); ");
                    if ($sr_arr_cl == 1) { emit($cg, "strada_decref(__sr_a); "); }
                    emit($cg, "__sr_old; })");
                    return 1;
                }
                if ($tt == NODE_HASH_ACCESS() || $tt == NODE_DEREF_HASH()) {
                    my scalar $sr_h_e = $tgt->{"hash"};
                    if ($tt == NODE_DEREF_HASH()) { $sr_h_e = $tgt->{"ref"}; }
                    my int $sr_h_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $sr_h_e) == 1;
                    my int $sr_k_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $tgt->{"key"}) == 1;
                    emit($cg, "({ StradaValue *__sr_h = ");
                    gen_expression($cg, $sr_h_e);
                    emit($cg, "; StradaValue *__sr_kv = ");
                    gen_expression($cg, $tgt->{"key"});
                    emit($cg, "; StradaValue *__sr_rp = ");
                    gen_expression($cg, $args->[3]);
                    emit($cg, "; StradaValue *__sr_oldv = strada_hv_fetch_owned_sv(__sr_h, __sr_kv); StradaValue *__sr_old = NULL; ");
                    emit($cg, "StradaValue *__sr_new = strada_substr_replace(__sr_oldv, ");
                    emit_int_operand($cg, $args->[1]);
                    emit($cg, ", ");
                    emit_int_operand($cg, $args->[2]);
                    emit($cg, ", __sr_rp, &__sr_old); ");
                    emit($cg, "strada_hv_store_sv(__sr_h, __sr_kv, __sr_new); strada_decref(__sr_new); strada_decref(__sr_oldv); ");
                    if ($rp_cl == 1) { emit($cg, "strada_decref(__sr_rp); "); }
                    if ($sr_k_cl == 1) { emit($cg, "strada_decref(__sr_kv); "); }
                    if ($sr_h_cl == 1) { emit($cg, "strada_decref(__sr_h); "); }
                    emit($cg, "__sr_old; })");
                    return 1;
                }
                /* Other lvalue shapes fall through to non-mutating form */
            }
            # 2-arg substr($s, $offset) means "to end of string". Passing
            # -1 here would be re-interpreted by strada_substr() as Perl's
            # negative-length "leave N chars at end" semantics, dropping
            # one char. Use INT64_MAX so the runtime clamps to (slen-offset).
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[0]) == 1) {
                emit($cg, "({ StradaValue *__sub_v = ");
                gen_expression($cg, $args->[0]);
                emit($cg, "; StradaValue *__sub_r = strada_substr(__sub_v, ");
                emit_int_operand($cg, $args->[1]);
                emit($cg, ", ");
                if ($argc_sub > 2) {
                    emit_int_operand($cg, $args->[2]);
                } else {
                    emit($cg, "INT64_MAX");
                }
                emit($cg, "); strada_decref(__sub_v); __sub_r; })");
            } else {
                emit($cg, "strada_substr(");
                gen_expression($cg, $args->[0]);
                emit($cg, ", ");
                emit_int_operand($cg, $args->[1]);
                emit($cg, ", ");
                if ($argc_sub > 2) {
                    emit_int_operand($cg, $args->[2]);
                } else {
                    emit($cg, "INT64_MAX");
                }
                emit($cg, ")");
            }
            return 1;
        }
        
        if ($name eq "push") {
            my scalar $args = $expr->{"args"};
            my int $argc = $expr->{"arg_count"};
            my int $arr_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[0]) == 1;
            if ($cg->{"uses_tie"} == 1) {
                emit($cg, "({ StradaValue *__push_a = ");
                gen_expression($cg, $args->[0]);
                emit($cg, "; ");
                my int $tpi = 1;
                while ($tpi < $argc) {
                    my scalar $tval = $args->[$tpi];
                    if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $tval) == 1) {
                        emit($cg, "strada_av_push_take_sv(__push_a, ");
                        gen_expression($cg, $tval);
                        emit($cg, "); ");
                    } else {
                        emit($cg, "strada_av_push_sv(__push_a, ");
                        gen_expression($cg, $tval);
                        emit($cg, "); ");
                    }
                    $tpi = $tpi + 1;
                }
                if ($arr_cleanup == 1) {
                    emit($cg, "strada_decref(__push_a); ");
                }
                emit($cg, "strada_undef_static(); })");
                return 1;
            }
            emit($cg, "({ ");
            if ($arr_cleanup == 1) {
                emit($cg, "StradaValue *__push_a = ");
                gen_expression($cg, $args->[0]);
                emit($cg, "; StradaArray *__push_av = strada_deref_array(__push_a); ");
            } else {
                emit($cg, "StradaArray *__push_av = strada_deref_array(");
                gen_expression($cg, $args->[0]);
                emit($cg, "); ");
            }
            my int $pi = 1;
            while ($pi < $argc) {
                my scalar $val_arg = $args->[$pi];
                if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $val_arg) == 1) {
                    emit($cg, "{ StradaValue *__push_v = ");
                    gen_expression($cg, $val_arg);
                    emit($cg, "; strada_array_push(__push_av, __push_v); strada_decref(__push_v); } ");
                } else {
                    emit($cg, "strada_array_push(__push_av, ");
                    gen_expression($cg, $val_arg);
                    emit($cg, "); ");
                }
                $pi = $pi + 1;
            }
            if ($arr_cleanup == 1) {
                emit($cg, "strada_decref(__push_a); ");
            }
            emit($cg, "strada_undef_static(); })");
            return 1;
        }

        # reserve - pre-allocate array capacity
        if ($name eq "reserve") {
            my scalar $args = $expr->{"args"};
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[0]) == 1) {
                emit($cg, "({ StradaValue *__rsv_v = ");
                gen_expression($cg, $args->[0]);
                emit($cg, "; strada_reserve_sv(__rsv_v, ");
                emit_int_operand($cg, $args->[1]);
                emit($cg, "); strada_decref(__rsv_v); strada_undef_static(); })");
            } else {
                emit($cg, "(strada_reserve_sv(");
                gen_expression($cg, $args->[0]);
                emit($cg, ", ");
                emit_int_operand($cg, $args->[1]);
                emit($cg, "), strada_undef_static())");
            }
            return 1;
        }

        if ($name eq "size") {
            my scalar $args = $expr->{"args"};
            my scalar $arg = $args->[0];
            if (needs_temp_cleanup($cg, $arg) == 1) {
                emit($cg, "({ StradaValue *__sz_v = ");
                gen_expression($cg, $arg);
                emit($cg, "; StradaValue *__sz_r = strada_new_int(strada_size(__sz_v)); strada_decref(__sz_v); __sz_r; })");
            } else {
                emit($cg, "strada_new_int(strada_size(");
                gen_expression($cg, $arg);
                emit($cg, "))");
            }
            return 1;
