                # and verify every ancestor is locally declared (not external)
                # and does not supply a custom non-synthesized new() when the child lacks one.
                my array @pkg_chain = ();
                my int $pc_len = 0;
                if ($all_lit_keys == 1) {
                    push(@pkg_chain, $pkg_name);
                    $pc_len = 1;
                    my hash %chain_seen = ();
                    $chain_seen{$pkg_name} = 1;
                    my scalar $inh_list2 = $cg->{"inherits"};
                    my int $inh_ct2 = $cg->{"inherit_count"} + 0;
                    my scalar $pl_p = $cg->{"pkg_list"};
                    my int $pc_p = $cg->{"pkg_count"} + 0;
                    my scalar $ha_p = $cg->{"has_attrs"};
                    my int $hac_p = $cg->{"has_attr_count"} + 0;
                    my int $pci = 0;
                    while ($pci < $pc_len && $all_lit_keys == 1) {
                        my str $check_pkg = $pkg_chain[$pci];
                        my int $pi = 0;
                        while ($pi < $inh_ct2) {
                            if (pkg_c_safe("" . $inh_list2->[$pi]->{"child"}) eq $check_pkg) {
                                my str $iparent = pkg_c_safe("" . $inh_list2->[$pi]->{"parent"});
                                if (($chain_seen{$iparent} + 0) == 0) {
                                    $chain_seen{$iparent} = 1;
                                    my int $parent_local = 0;
                                    my int $pk_i = 0;
                                    while ($pk_i < $pc_p) {
                                        if (pkg_c_safe("" . $pl_p->[$pk_i]) eq $iparent) {
                                            $parent_local = 1;
                                            last;
                                        }
                                        $pk_i = $pk_i + 1;
                                    }
                                    if ($parent_local == 0) {
                                        my int $ha_i = 0;
                                        while ($ha_i < $hac_p) {
                                            if (pkg_c_safe("" . $ha_p->[$ha_i]->{"package"}) eq $iparent) {
