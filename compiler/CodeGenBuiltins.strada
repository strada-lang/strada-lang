            if ($ds_v_cl == 1) { emit($cg, "strada_decref(__ds_val); "); }
            if ($ds_r_cl == 1) { emit($cg, "strada_decref(__ds_ref); "); }
            emit($cg, "__ds_res; })");
            return 1;
        }

        # clone - deep copy a value
        if ($name eq "clone") {
            my scalar $args = $expr->{"args"};
