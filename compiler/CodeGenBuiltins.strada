            }
            if ($argc >= 2 && $args->[1]->{"type"} == NODE_STR_LITERAL()) {
                gen_str_literal_c($cg, $args->[1]->{"value"});
            } elsif ($argc >= 2) {
                emit($cg, "\"HASH\"");
            } else {
                emit($cg, "\"HASH\"");
            }
            emit($cg, ", " . $extra);
            my int $ai = 2;
            while ($ai < $argc) {
                emit($cg, ", ");
                gen_expression($cg, $args->[$ai]);
                $ai = $ai + 1;
            }
            emit($cg, ")");
            return 1;
        }

        # untie(%hash / @arr / $var / $our_var)
        if ($name eq "untie") {
            my scalar $args = $expr->{"args"};
            my scalar $uarg = $args->[0];
            if ($uarg->{"type"} == NODE_VARIABLE() && $uarg->{"sigil"} eq "$") {
                my str $ut_our = "" . $cg->{"our_vars"}->{escape_c_keyword($uarg->{"name"})};
                if (length($ut_our) == 0 && index($uarg->{"name"}, "::") >= 0) {
                    $ut_our = $uarg->{"name"};
                }
                if (length($ut_our) > 0) {
                    emit($cg, "(strada_untie_global_scalar(" . c_str_lit($ut_our) . "), strada_undef_static())");
                    return 1;
                }
            }
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $uarg) == 1) {
                emit($cg, "({ StradaValue *__ut_v = ");
                gen_expression($cg, $uarg);
                emit($cg, "; strada_untie(__ut_v); strada_decref(__ut_v); strada_undef_static(); })");
            } else {
                emit($cg, "(strada_untie(");
                gen_expression($cg, $uarg);
                emit($cg, "), strada_undef_static())");
            }
            return 1;
        }

        # tied(%hash / @arr / $var / $our_var) - returns tied object or undef
        if ($name eq "tied") {
            my scalar $args = $expr->{"args"};
            my scalar $targ = $args->[0];
            if ($targ->{"type"} == NODE_VARIABLE() && $targ->{"sigil"} eq "$") {
                my str $td_our = "" . $cg->{"our_vars"}->{escape_c_keyword($targ->{"name"})};
                if (length($td_our) == 0 && index($targ->{"name"}, "::") >= 0) {
                    $td_our = $targ->{"name"};
                }
                if (length($td_our) > 0) {
                    emit($cg, "strada_tied_global_scalar(" . c_str_lit($td_our) . ")");
                    return 1;
                }
            }
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $targ) == 1) {
                emit($cg, "({ StradaValue *__td_v = ");
                gen_expression($cg, $targ);
                emit($cg, "; StradaValue *__td_r = strada_tied(__td_v); strada_decref(__td_v); __td_r; })");
            } else {
                emit($cg, "strada_tied(");
                gen_expression($cg, $targ);
                emit($cg, ")");
            }
            return 1;
        }

        if ($name eq "sort") {
            my scalar $args = $expr->{"args"};
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[0]) == 1) {
                emit($cg, "({ StradaValue *__sort_a = ");
                gen_expression($cg, $args->[0]);
                emit($cg, "; StradaValue *__sort_r = strada_sort(__sort_a); strada_decref(__sort_a); __sort_r; })");
            } else {
                emit($cg, "strada_sort(");
                gen_expression($cg, $args->[0]);
                emit($cg, ")");
            }
            return 1;
        }

        if ($name eq "nsort") {
            my scalar $args = $expr->{"args"};
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[0]) == 1) {
                emit($cg, "({ StradaValue *__nsort_a = ");
                gen_expression($cg, $args->[0]);
                emit($cg, "; StradaValue *__nsort_r = strada_nsort(__nsort_a); strada_decref(__nsort_a); __nsort_r; })");
            } else {
                emit($cg, "strada_nsort(");
                gen_expression($cg, $args->[0]);
                emit($cg, ")");
            }
            return 1;
        }

        if ($name eq "split") {
            # split(pattern, string[, limit]) - like Perl
            my scalar $args = $expr->{"args"};
            my scalar $pattern_arg = $args->[0];
            my scalar $string_arg = $args->[1];
            my int $pattern_needs_cleanup = needs_temp_cleanup($cg, $pattern_arg);
            my int $string_needs_cleanup = needs_temp_cleanup($cg, $string_arg);
            my int $argc_sp = 0;
            if (defined($args)) { $argc_sp = size(@{$args}); }
            my int $has_limit = 0;
            my scalar $limit_arg = $args->[0];
            if ($argc_sp >= 3) {
                $has_limit = 1;
                $limit_arg = $args->[2];
            }

            # A /regex/ pattern: its flags become an inline (?flags) prefix
            # (they were dropped), `/ /` is a plain single-space separator
            # (only the string " " is awk mode), and `/^/` means /^/m (Perl).
            if ($pattern_arg->{"type"} == NODE_STR_LITERAL() && $pattern_arg->{"is_regex"}) {
                my str $sp_pv = "" . $pattern_arg->{"value"};
                my str $sp_fl = "" . $pattern_arg->{"regex_flags"};
                my str $sp_inl = "";
                for (my int $sfi = 0; $sfi < length($sp_fl); $sfi = $sfi + 1) {
                    my str $sfc = substr($sp_fl, $sfi, 1);
                    if ($sfc eq "i" || $sfc eq "x" || $sfc eq "s" || $sfc eq "m") { $sp_inl = $sp_inl . $sfc; }
                }
                if ($sp_pv eq "^" && index($sp_inl, "m") < 0) { $sp_inl = $sp_inl . "m"; }
                my str $sp_new = $sp_pv;
                if (length($sp_inl) > 0) { $sp_new = "(?" . $sp_inl . ")" . $sp_pv; }
                elsif ($sp_pv eq " ") { $sp_new = "[ ]"; }
                if ($sp_new ne $sp_pv) {
                    my scalar $sp_node = ast_new_str_literal($sp_new);
                    $sp_node->{"is_regex"} = 1;
                    $pattern_arg = $sp_node;
                    $pattern_needs_cleanup = needs_temp_cleanup($cg, $pattern_arg);
                }
            }

            # Fast path: literal pattern with no regex metacharacters uses plain string split
            # (only when no LIMIT — the limit path goes through regex_split_limit).
            my int $is_literal_pat = 0;
            if ($has_limit == 0 && $pattern_arg->{"type"} == NODE_STR_LITERAL()) {
                my str $pat_val = $pattern_arg->{"value"};
                # Check for regex metacharacters — if none, safe for plain string split
                my int $has_meta = 0;
                my int $pi2 = 0;
                my int $plen = length($pat_val);
                while ($pi2 < $plen) {
                    my str $pc = substr($pat_val, $pi2, 1);
                    if ($pc eq "." || $pc eq "*" || $pc eq "+" || $pc eq "?" ||
                        $pc eq "[" || $pc eq "]" || $pc eq "(" || $pc eq ")" ||
                        $pc eq "{" || $pc eq "}" || $pc eq "^" || $pc eq "$" ||
                        $pc eq "|" || $pc eq "\\") {
                        $has_meta = 1;
                    }
                    $pi2 = $pi2 + 1;
                }
                if ($has_meta == 0) {
                    $is_literal_pat = 1;
                }
            }

            my int $spl_sp = cleanup_push_useful($cg);
            my int $spl_p_cl = $cg->{"cleanup_enabled"} == 1 && $pattern_needs_cleanup == 1;
            my int $spl_s_cl = $cg->{"cleanup_enabled"} == 1 && $string_needs_cleanup == 1;
            emit($cg, "(({ ");
            if ($is_literal_pat == 1) {
                # Plain string split — avoid regex overhead
                emit($cg, "StradaValue *__split_str = ");
                gen_expression($cg, $string_arg);
                emit($cg, "; ");
                if ($spl_sp == 1 && $spl_s_cl == 1) { emit($cg, "strada_cleanup_push(__split_str); "); }
                emit($cg, "StradaValue *__split_ssv = strada_to_str_sv(__split_str); ");
                if ($spl_sp == 1) { emit($cg, "strada_cleanup_push(__split_ssv); "); }
                emit($cg, "const char *__str_cstr = (__split_ssv && !STRADA_IS_TAGGED_INT(__split_ssv) && __split_ssv->value.pv) ? __split_ssv->value.pv : \"\"; ");
                emit($cg, "strada_regex_set_subject_for_sv(__split_ssv); ");
                emit($cg, "StradaValue *__sv = strada_new_array_from_av(strada_string_split_n(__str_cstr, ");
                gen_str_literal_c($cg, $pattern_arg->{"value"});
                emit($cg, ", (size_t)" . bytes($pattern_arg->{"value"}) . ")); strada_regex_clear_subject_len(); ");
                if ($spl_sp == 1) { emit($cg, "strada_cleanup_pop_decref(__split_ssv); "); }
                else { emit($cg, "strada_decref(__split_ssv); "); }
            } else {
                # Dynamic pattern — use regex split (with optional LIMIT)
                emit($cg, "StradaValue *__split_pat = ");
                gen_expression($cg, $pattern_arg);
                emit($cg, "; ");
                if ($spl_sp == 1 && $spl_p_cl == 1) { emit($cg, "strada_cleanup_push(__split_pat); "); }
                emit($cg, "StradaValue *__split_str = ");
                gen_expression($cg, $string_arg);
                emit($cg, "; ");
                if ($spl_sp == 1 && $spl_s_cl == 1) { emit($cg, "strada_cleanup_push(__split_str); "); }
                emit($cg, "StradaValue *__split_psv = strada_to_str_sv(__split_pat); ");
                if ($spl_sp == 1) { emit($cg, "strada_cleanup_push(__split_psv); "); }
                emit($cg, "const char *__pat_cstr = (__split_psv && !STRADA_IS_TAGGED_INT(__split_psv) && __split_psv->value.pv) ? __split_psv->value.pv : \"\"; ");
                emit($cg, "StradaValue *__split_ssv = strada_to_str_sv(__split_str); ");
                if ($spl_sp == 1) { emit($cg, "strada_cleanup_push(__split_ssv); "); }
                emit($cg, "const char *__str_cstr = (__split_ssv && !STRADA_IS_TAGGED_INT(__split_ssv) && __split_ssv->value.pv) ? __split_ssv->value.pv : \"\"; ");
                emit($cg, "strada_regex_set_subject_for_sv(__split_ssv); ");
                if ($has_limit == 1) {
                    my int $lim_owned = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $limit_arg) == 1;
                    if ($lim_owned == 1) {
                        emit($cg, "StradaValue *__split_lim_sv = ");
                        gen_expression($cg, $limit_arg);
                        emit($cg, "; ");
                        if ($spl_sp == 1) { emit($cg, "strada_cleanup_push(__split_lim_sv); "); }
                        emit($cg, "int __split_lim = (int)strada_to_int(__split_lim_sv); ");
                        if ($spl_sp == 1) { emit($cg, "strada_cleanup_pop_decref(__split_lim_sv); "); }
                        else { emit($cg, "strada_decref(__split_lim_sv); "); }
                    } else {
                        emit($cg, "int __split_lim = (int)strada_to_int(");
                        gen_expression($cg, $limit_arg);
                        emit($cg, "); ");
                    }
                    emit($cg, "StradaValue *__sv = strada_new_array_from_av(strada_regex_split_limit(__str_cstr, __pat_cstr, __split_lim)); ");
                } else {
                    emit($cg, "StradaValue *__sv = strada_new_array_from_av(strada_regex_split(__str_cstr, __pat_cstr)); ");
                }
                emit($cg, "strada_regex_clear_subject_len(); ");
                if ($spl_sp == 1) { emit($cg, "strada_cleanup_pop_decref(__split_ssv); strada_cleanup_pop_decref(__split_psv); "); }
                else { emit($cg, "strada_decref(__split_ssv); strada_decref(__split_psv); "); }
            }
            if ($spl_s_cl == 1) {
                if ($spl_sp == 1) { emit($cg, "strada_cleanup_pop_decref(__split_str); "); }
                else { emit($cg, "strada_decref(__split_str); "); }
            }
            if ($is_literal_pat == 0 && $spl_p_cl == 1) {
                if ($spl_sp == 1) { emit($cg, "strada_cleanup_pop_decref(__split_pat); "); }
                else { emit($cg, "strada_decref(__split_pat); "); }
            }
            emit($cg, "__sv; }))");
            return 1;
        }
        
        if ($name eq "join") {
            # join(separator, LIST). Two shapes: `join(",", @arr)` (the
            # 2-arg array case) and `join("|", "a", "b", "c")` (list of
            # scalars). Previously only the 2-arg case worked because
            # only args[1] was passed to strada_join, so the scalar form
            # produced an empty string.
            my scalar $args = $expr->{"args"};
            my int $argc = $expr->{"arg_count"};
            if ($argc < 1) {
                emit($cg, "strada_new_str(\"\")");
                return 1;
            }
            my scalar $sep_arg = $args->[0];
            my int $sep_needs_cleanup = needs_temp_cleanup($cg, $sep_arg);
            my int $join_has_spread = 0;
            my int $jsi = 1;
            while ($jsi < $argc) {
                if ($args->[$jsi]->{"type"} == NODE_SPREAD()) {
                    $join_has_spread = 1;
                }
                $jsi = $jsi + 1;
            }

            # Call strada_join_sv directly: it borrows plain-STR elements
            # (no per-element copy), builds straight into the result
            # StradaString, and takes the separator as an SV (no
            # stringify/copy of the separator). The old path went through
            # the char* strada_join + strada_new_str, copying the joined
            # result twice and every element once.
            my int $jn_sp = cleanup_push_useful($cg);
            my int $jn_s_cl = $cg->{"cleanup_enabled"} == 1 && $sep_needs_cleanup == 1;
            emit($cg, "(({ StradaValue *__join_sep = ");
            gen_expression($cg, $sep_arg);
            emit($cg, "; ");
            if ($jn_sp == 1 && $jn_s_cl == 1) { emit($cg, "strada_cleanup_push(__join_sep); "); }
            if ($argc == 2 && $join_has_spread == 0 && array_flatten_kind($cg, $args->[1]) > 0) {
                my int $arr_needs_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[1]) == 1;
                if ($arr_needs_cleanup == 1) {
                    emit($cg, "StradaValue *__join_arr = ");
                    gen_expression($cg, $args->[1]);
                    emit($cg, "; ");
                    if ($jn_sp == 1) { emit($cg, "strada_cleanup_push(__join_arr); "); }
                    emit($cg, "StradaValue *__join_res = strada_join_sv(__join_sep, strada_deref_array(__join_arr)); ");
                    if ($jn_sp == 1) { emit($cg, "strada_cleanup_pop_decref(__join_arr); "); }
                    else { emit($cg, "strada_decref(__join_arr); "); }
                } else {
                    emit($cg, "StradaValue *__join_res = strada_join_sv(__join_sep, strada_deref_array(");
                    gen_expression($cg, $args->[1]);
                    emit($cg, ")); ");
                }
            } else {
                # Build a temporary array of all the list/spread elements.
                emit($cg, "StradaValue *__join_arr = strada_new_array(); ");
                if ($jn_sp == 1) { emit($cg, "strada_cleanup_push(__join_arr); "); }
                emit($cg, "StradaArray *__join_av = strada_deref_array(__join_arr); ");
                my int $ji = 1;
                while ($ji < $argc) {
                    emit_list_elem_append($cg, "__join_av", $args->[$ji], $jn_sp);
                    $ji = $ji + 1;
                }
                emit($cg, "StradaValue *__join_res = strada_join_sv(__join_sep, __join_av); ");
                if ($jn_sp == 1) { emit($cg, "strada_cleanup_pop_decref(__join_arr); "); }
                else { emit($cg, "strada_decref(__join_arr); "); }
            }
            if ($jn_s_cl == 1) {
                if ($jn_sp == 1) { emit($cg, "strada_cleanup_pop_decref(__join_sep); "); }
                else { emit($cg, "strada_decref(__join_sep); "); }
            }
            emit($cg, "__join_res; }))");
            return 1;
        }
        
        if ($name eq "keys") {
            my scalar $args = $expr->{"args"};
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[0]) == 1) {
                emit($cg, "({ StradaValue *__keys_v = ");
                gen_expression($cg, $args->[0]);
                emit($cg, "; StradaValue *__keys_r = strada_new_array_from_av(strada_hash_keys(strada_hash_iter_reset(strada_deref_hash(__keys_v)))); strada_decref(__keys_v); __keys_r; })");
            } else {
                emit($cg, "strada_new_array_from_av(strada_hash_keys(strada_hash_iter_reset(strada_deref_hash(");
                gen_expression($cg, $args->[0]);
                emit($cg, "))))");
            }
            return 1;
        }
        
        if ($name eq "values") {
            my scalar $args = $expr->{"args"};
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[0]) == 1) {
                emit($cg, "({ StradaValue *__vals_v = ");
                gen_expression($cg, $args->[0]);
                emit($cg, "; StradaValue *__vals_r = strada_new_array_from_av(strada_hash_values(strada_hash_iter_reset(strada_deref_hash(__vals_v)))); strada_decref(__vals_v); __vals_r; })");
            } else {
                emit($cg, "strada_new_array_from_av(strada_hash_values(strada_hash_iter_reset(strada_deref_hash(");
                gen_expression($cg, $args->[0]);
                emit($cg, "))))");
            }
            return 1;
        }
        
        if ($name eq "exists") {
            my scalar $args = $expr->{"args"};
            my scalar $arg0 = $args->[0];
            my int $ex_sp = cleanup_push_useful($cg);

            # `exists $arr[N]` — true iff the slot is in bounds AND has not
            # been removed by a prior `delete $arr[N]` (which sets the slot
            # to NULL as a tombstone).
            if ($expr->{"arg_count"} == 1 && ($arg0->{"type"} == NODE_SUBSCRIPT() || $arg0->{"type"} == NODE_DEREF_ARRAY())) {
                my scalar $ex_arr_e = $arg0->{"array"};
                if ($arg0->{"type"} == NODE_DEREF_ARRAY()) { $ex_arr_e = $arg0->{"ref"}; }
                my int $ex_arr_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $ex_arr_e) == 1;
                my int $ex_retain = 0;
                if ($ex_arr_cl == 0) { $ex_retain = 1; }
                emit($cg, "({ StradaValue *__ex_a = ");
                gen_expression($cg, $ex_arr_e);
                emit($cg, "; ");
                if ($ex_retain == 1) { emit($cg, "strada_incref(__ex_a); "); }
                if ($ex_sp == 1) { emit($cg, "strada_cleanup_push(__ex_a); "); }
                emit($cg, "int64_t __ex_idx = ");
                emit_int_operand($cg, $arg0->{"index"});
                if ($cg->{"uses_tie"} == 1) {
                    emit($cg, "; int __ex_r = strada_av_exists_sv(__ex_a, __ex_idx); ");
                } else {
                    emit($cg, "; int __ex_r = strada_array_exists_idx(strada_deref_array(__ex_a), __ex_idx); ");
                }
                if ($ex_sp == 1) { emit($cg, "strada_cleanup_pop_decref(__ex_a); "); }
                else { emit($cg, "strada_decref(__ex_a); "); }
                emit($cg, "strada_new_int(__ex_r); })");
                return 1;
            }

            # Check if single arg is a hash access node
            my scalar $ex_key_e = $args->[1];
            my scalar $ex_hash_e = $args->[0];
            if ($expr->{"arg_count"} == 1 && ($arg0->{"type"} == NODE_HASH_ACCESS() || $arg0->{"type"} == NODE_DEREF_HASH())) {
                $ex_key_e = $arg0->{"key"};
                $ex_hash_e = $arg0->{"hash"};
                if ($arg0->{"type"} == NODE_DEREF_HASH()) {
                    $ex_hash_e = $arg0->{"ref"};
                }
            }
            my int $ex_hash_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $ex_hash_e) == 1;
            if ($ex_key_e->{"type"} == NODE_STR_LITERAL() && key_is_hashable_ascii($ex_key_e->{"value"}) == 1) {
                my str $ex_kval = $ex_key_e->{"value"};
                if ($ex_hash_cl == 1) {
                    emit($cg, "({ StradaValue *__ex_h = ");
                    gen_expression($cg, $ex_hash_e);
                    emit($cg, "; ");
                    if ($ex_sp == 1) { emit($cg, "strada_cleanup_push(__ex_h); "); }
                    emit($cg, "int __ex_res = strada_hv_exists_ph_len(__ex_h, ");
                    gen_str_literal_c($cg, $ex_kval);
                    emit($cg, ", " . bytes($ex_kval) . "u, " . djb2_hash_32($ex_kval) . "u); ");
                    if ($ex_sp == 1) { emit($cg, "strada_cleanup_pop_decref(__ex_h); "); }
                    else { emit($cg, "strada_decref(__ex_h); "); }
                    emit($cg, "strada_new_int_il(__ex_res); })");
                } else {
                    emit($cg, "strada_new_int_il(strada_hv_exists_ph_len(");
                    gen_expression($cg, $ex_hash_e);
                    emit($cg, ", ");
                    gen_str_literal_c($cg, $ex_kval);
                    emit($cg, ", " . bytes($ex_kval) . "u, " . djb2_hash_32($ex_kval) . "u))");
                }
            } else {
                my int $key_needs_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $ex_key_e) == 1;
                emit($cg, "({ StradaValue *__ex_key = ");
                gen_expression($cg, $ex_key_e);
                emit($cg, "; ");
                if ($ex_sp == 1 && $key_needs_cleanup == 1) { emit($cg, "strada_cleanup_push(__ex_key); "); }
                if ($ex_hash_cl == 1) {
                    emit($cg, "StradaValue *__ex_h = ");
                    gen_expression($cg, $ex_hash_e);
                    emit($cg, "; ");
                    if ($ex_sp == 1) { emit($cg, "strada_cleanup_push(__ex_h); "); }
                    emit($cg, "int __ex_res = strada_hv_exists_sv(__ex_h, __ex_key); ");
                    if ($ex_sp == 1) { emit($cg, "strada_cleanup_pop_decref(__ex_h); "); }
                    else { emit($cg, "strada_decref(__ex_h); "); }
                } else {
                    emit($cg, "int __ex_res = strada_hv_exists_sv(");
                    gen_expression($cg, $ex_hash_e);
                    emit($cg, ", __ex_key); ");
                }
                if ($key_needs_cleanup == 1) {
                    if ($ex_sp == 1) { emit($cg, "strada_cleanup_pop_decref(__ex_key); "); }
                    else { emit($cg, "strada_decref(__ex_key); "); }
                }
                emit($cg, "strada_new_int_il(__ex_res); })");
            }
            return 1;
        }
    return 0;
}

func gen_builtin_g2(scalar $cg, scalar $expr, str $name) int {
        
        if ($name eq "delete") {
            my scalar $args = $expr->{"args"};
            my scalar $arg0 = $args->[0];
            my int $del_sp = cleanup_push_useful($cg);

            # delete(@h{K1, K2, ...}) / delete(@{$r}{...}): delete every key,
            # returning the deleted values as a list (invalid C before).
            if ($expr->{"arg_count"} == 1 && $arg0->{"type"} == NODE_HASH_SLICE()) {
                my scalar $ds_src = $arg0->{"source"};
                if ($ds_src->{"type"} == NODE_DEREF_SCALAR()) { $ds_src = $ds_src->{"ref"}; }
                my int $ds_src_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $ds_src) == 1;
                emit($cg, "({ StradaValue *__ds_h = ");
                gen_expression($cg, $ds_src);
                emit($cg, "; ");
                if ($ds_src_cl == 0) { emit($cg, "strada_incref(__ds_h); "); }
                if ($del_sp == 1) { emit($cg, "strada_cleanup_push(__ds_h); "); }
                emit($cg, "StradaValue *__ds_keys = strada_new_array(); ");
                if ($del_sp == 1) { emit($cg, "strada_cleanup_push(__ds_keys); "); }
                foreach my scalar $ds_item (@{$arg0->{"items"}}) {
                    emit_list_elem_append($cg, "__ds_keys->value.av", $ds_item, $del_sp);
                }
