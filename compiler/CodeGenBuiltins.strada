            }
            my scalar $arg0 = $args->[0];
            my int $throw_arg_cleanup = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $arg0) == 1;
            if ($throw_arg_cleanup == 1) {
                # Owned ref — strada_throw_value adopts directly, no extra incref needed.
                emit($cg, "({ strada_throw_value(");
                gen_expression($cg, $arg0);
                emit($cg, "); (StradaValue*)NULL; })");
            } else {
                # Borrowed ref (e.g. a variable) — incref before transfer.
                emit($cg, "({ StradaValue *__throw_arg = ");
                gen_expression($cg, $arg0);
                emit($cg, "; strada_incref(__throw_arg); strada_throw_value(__throw_arg); (StradaValue*)NULL; })");
            }
            return 1;
