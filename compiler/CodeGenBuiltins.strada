                gen_expression($cg, $spargs->[0]);
                emit($cg, ")");
            } else {
                emit($cg, "({ StradaValue *__sp_cl = ");
                gen_expression($cg, $spargs->[0]);
                emit($cg, "; strada_incref(__sp_cl); strada_future_new(__sp_cl); })");
            }
            return 1;
        }

        # async::select(\@channels [, $timeout_ms]) → [index, value]
        if ($name eq "async::select") {
            my scalar $selargs = $expr->{"args"};
            my int $sel_argc = $expr->{"arg_count"};
            my int $sel_c_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $selargs->[0]) == 1;
            my int $sel_t_cl = 0;
            if ($sel_argc > 1 && $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $selargs->[1]) == 1) {
                $sel_t_cl = 1;
            }
            if ($sel_c_cl == 1 || $sel_t_cl == 1 || $sel_argc > 1) {
                my int $sel_push = cleanup_push_useful($cg);
                emit($cg, "({ StradaValue *__sel_c = ");
                gen_expression($cg, $selargs->[0]);
                emit($cg, "; ");
                if ($sel_push == 1 && $sel_c_cl == 1) { emit($cg, "strada_cleanup_push(__sel_c); "); }
                if ($sel_argc > 1) {
                    emit($cg, "StradaValue *__sel_t = ");
                    gen_expression($cg, $selargs->[1]);
                    emit($cg, "; ");
                    if ($sel_push == 1 && $sel_t_cl == 1) { emit($cg, "strada_cleanup_push(__sel_t); "); }
                    emit($cg, "StradaValue *__sel_r = strada_channel_select(__sel_c, __sel_t); ");
                    if ($sel_t_cl == 1) {
                        if ($sel_push == 1) { emit($cg, "strada_cleanup_pop_decref(__sel_t); "); }
                        else { emit($cg, "strada_decref(__sel_t); "); }
                    }
                } else {
                    emit($cg, "StradaValue *__sel_r = strada_channel_select(__sel_c, NULL); ");
                }
                if ($sel_c_cl == 1) {
                    if ($sel_push == 1) { emit($cg, "strada_cleanup_pop_decref(__sel_c); "); }
                    else { emit($cg, "strada_decref(__sel_c); "); }
                }
                emit($cg, "__sel_r; })");
            } else {
                emit($cg, "strada_channel_select(");
                gen_expression($cg, $selargs->[0]);
                emit($cg, ", NULL)");
            }
            return 1;
        }

        # async::sleep($ms) — cancellation-aware sleep (1 = full sleep,
        # 0 = woken early by async::cancel on this task's future)
        if ($name eq "async::sleep") {
            gen_call_with_arg_cleanup($cg, "strada_async_sleep", $expr->{"args"}, 1);
            return 1;
        }

