            return 1;
        }

        # gettimeofday - high-res time
        if ($name eq "sys::gettimeofday") {
            emit($cg, "strada_gettimeofday()");
            return 1;
        }

        # hires_time - floating point seconds
        if ($name eq "sys::hires_time") {
            emit($cg, "strada_hires_time()");
            return 1;
        }

        # Memory profiler functions
        if ($name eq "sys::memprof_enable") {
            emit($cg, "(strada_memprof_enable(), strada_undef_static())");
            return 1;
        }
        if ($name eq "sys::memprof_disable") {
            emit($cg, "(strada_memprof_disable(), strada_undef_static())");
            return 1;
        }
        if ($name eq "sys::memprof_report") {
            emit($cg, "(strada_memprof_report(), strada_undef_static())");
            return 1;
        }
        if ($name eq "sys::memprof_reset") {
            emit($cg, "(strada_memprof_reset(), strada_undef_static())");
            return 1;
        }

        # tv_interval - time interval
        if ($name eq "sys::tv_interval") {
            my scalar $args = $expr->{"args"};
            my int $arg_count = $expr->{"arg_count"};
            if ($arg_count > 1) {
                gen_call_with_arg_cleanup($cg, "strada_tv_interval", $args, 2);
            } else {
                my scalar $arg0 = $args->[0];
                my int $a0_cleanup = needs_temp_cleanup($cg, $arg0);
                if ($a0_cleanup == 1) {
                    emit($cg, "({ StradaValue *__call_arg0 = ");
                    gen_expression($cg, $arg0);
                    emit($cg, "; StradaValue *__call_result = strada_tv_interval(__call_arg0, NULL); strada_decref(__call_arg0); __call_result; })");
                } else {
                    emit($cg, "strada_tv_interval(");
                    gen_expression($cg, $arg0);
                    emit($cg, ", NULL)");
                }
            }
            return 1;
        }

        # nanosleep - sleep nanoseconds
        if ($name eq "sys::nanosleep") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_nanosleep_ns", $args, 1);
            return 1;
        }

        # clock_gettime - get clock time
        if ($name eq "sys::clock_gettime") {
            my int $arg_count = $expr->{"arg_count"};
            if ($arg_count > 0) {
                gen_call_with_arg_cleanup($cg, "strada_clock_gettime", $expr->{"args"}, 1);
            } else {
                emit($cg, "strada_clock_gettime(NULL)");
            }
            return 1;
        }

        # clock_getres - get clock resolution
        if ($name eq "sys::clock_getres") {
            my int $arg_count = $expr->{"arg_count"};
            if ($arg_count > 0) {
                gen_call_with_arg_cleanup($cg, "strada_clock_getres", $expr->{"args"}, 1);
            } else {
                emit($cg, "strada_clock_getres(NULL)");
            }
            return 1;
        }

        # dl_open - open shared library
        if ($name eq "sys::dl_open") {
            gen_call_with_arg_cleanup($cg, "strada_dl_open", $expr->{"args"}, 1);
            return 1;
        }

        # strada_read_meta_section - read .strada_meta ELF section (no dlopen)
        if ($name eq "strada_read_meta_section") {
            gen_call_with_arg_cleanup($cg, "strada_read_meta_section", $expr->{"args"}, 1);
            return 1;
        }

        # strada_call_named_guarded - dlsym self + call under try frame
        if ($name eq "strada_call_named_guarded") {
            gen_call_with_arg_cleanup($cg, "strada_call_named_guarded", $expr->{"args"}, 2);
            return 1;
        }

        # strada_dl_open_raw - internal raw library open
        if ($name eq "strada_dl_open_raw") {
            gen_call_with_arg_cleanup($cg, "strada_dl_open_raw", $expr->{"args"}, 1);
            return 1;
        }

        # strada_dl_sym_raw - internal raw symbol lookup
        if ($name eq "strada_dl_sym_raw") {
            gen_call_with_arg_cleanup($cg, "strada_dl_sym_raw", $expr->{"args"}, 2);
            return 1;
        }

        # strada_dl_close_raw - internal raw library close
        if ($name eq "strada_dl_close_raw") {
            gen_call_with_arg_cleanup($cg, "strada_dl_close_raw", $expr->{"args"}, 1);
            return 1;
        }

        # dl_sym - get symbol from library
        if ($name eq "sys::dl_sym") {
            gen_call_with_arg_cleanup($cg, "strada_dl_sym", $expr->{"args"}, 2);
            return 1;
        }

        # dl_close - close library
        if ($name eq "sys::dl_close") {
            gen_call_with_arg_cleanup($cg, "strada_dl_close", $expr->{"args"}, 1);
            return 1;
        }

        # dl_error - get last error
        if ($name eq "sys::dl_error") {
            emit($cg, "strada_dl_error()");
            return 1;
        }

        # dl_call_int - call function returning int
        if ($name eq "sys::dl_call_int") {
            gen_call_with_arg_cleanup($cg, "strada_dl_call_int", $expr->{"args"}, 2);
            return 1;
        }

        # dl_call_num - call function returning num
        if ($name eq "sys::dl_call_num") {
            gen_call_with_arg_cleanup($cg, "strada_dl_call_num", $expr->{"args"}, 2);
            return 1;
        }

        # dl_call_str - call function returning string
        if ($name eq "sys::dl_call_str") {
            gen_call_with_arg_cleanup($cg, "strada_dl_call_str", $expr->{"args"}, 2);
            return 1;
        }

        # dl_call_void - call function with no return
        if ($name eq "sys::dl_call_void") {
            gen_call_with_arg_cleanup($cg, "strada_dl_call_void", $expr->{"args"}, 2);
            return 1;
        }

        # dl_call_int_sv - call function passing StradaValue* directly, returns int
        if ($name eq "sys::dl_call_int_sv") {
            gen_call_with_arg_cleanup($cg, "strada_dl_call_int_sv", $expr->{"args"}, 2);
            return 1;
        }

        # dl_call_str_sv - call function passing StradaValue* directly, returns string
        if ($name eq "sys::dl_call_str_sv") {
            gen_call_with_arg_cleanup($cg, "strada_dl_call_str_sv", $expr->{"args"}, 2);
            return 1;
        }

        # dl_call_void_sv - call function passing StradaValue* directly, no return
        if ($name eq "sys::dl_call_void_sv") {
            gen_call_with_arg_cleanup($cg, "strada_dl_call_void_sv", $expr->{"args"}, 2);
            return 1;
        }

        if ($name eq "sys::dl_call_sv") {
            gen_call_with_arg_cleanup($cg, "strada_dl_call_sv", $expr->{"args"}, 2);
            return 1;
        }

        if ($name eq "sys::dl_call_export_info") {
            gen_call_with_arg_cleanup($cg, "strada_dl_call_export_info", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "sys::dl_call_version") {
            gen_call_with_arg_cleanup($cg, "strada_dl_call_version", $expr->{"args"}, 1);
            return 1;
        }

        # Pointer access for FFI
        if ($name eq "sys::int_ptr") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_int_ptr", $args, 1);
            return 1;
        }

        if ($name eq "sys::num_ptr") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_num_ptr", $args, 1);
            return 1;
        }

        if ($name eq "sys::str_ptr") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_str_ptr", $args, 1);
            return 1;
        }

        if ($name eq "sys::ptr_deref_int") {
            gen_call_with_arg_cleanup($cg, "strada_ptr_deref_int", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "sys::ptr_deref_num") {
            gen_call_with_arg_cleanup($cg, "strada_ptr_deref_num", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "sys::ptr_deref_str") {
            gen_call_with_arg_cleanup($cg, "strada_ptr_deref_str", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "sys::ptr_set_int") {
            gen_call_with_arg_cleanup($cg, "strada_ptr_set_int", $expr->{"args"}, 2);
            return 1;
        }

        if ($name eq "sys::ptr_set_num") {
            gen_call_with_arg_cleanup($cg, "strada_ptr_set_num", $expr->{"args"}, 2);
            return 1;
        }

        # ============================================
        # c:: namespace - C interop helper functions
        # ============================================

        # c::str_to_ptr - Convert Strada string to C char* (allocates)
        if ($name eq "c::str_to_ptr") {
            gen_call_with_arg_cleanup($cg, "strada_c_str_to_ptr", $expr->{"args"}, 1);
            return 1;
        }

        # c::ptr_to_str - Convert C char* to Strada string (copies)
        if ($name eq "c::ptr_to_str") {
            gen_call_with_arg_cleanup($cg, "strada_c_ptr_to_str", $expr->{"args"}, 1);
            return 1;
        }

        # c::ptr_to_str_n - Convert C char* to Strada string with length
        if ($name eq "c::ptr_to_str_n") {
            gen_call_with_arg_cleanup($cg, "strada_c_ptr_to_str_n", $expr->{"args"}, 2);
            return 1;
        }

        # c::callback - mint a C function pointer (libffi trampoline) that
        # invokes a Strada closure: c::callback($fn, "ret", "arg,arg").
        # The closure argument is typically an owned temp (anon fn) — the
        # runtime increfs it internally, so the temp decref here is safe.
        if ($name eq "c::callback") {
            gen_call_with_arg_cleanup($cg, "strada_ffi_callback_new", $expr->{"args"}, 3);
            return 1;
        }

        # c::callback_free - release a c::callback trampoline
        if ($name eq "c::callback_free") {
            gen_call_with_arg_cleanup($cg, "strada_ffi_callback_free", $expr->{"args"}, 1);
            return 1;
        }

        # c::free - Free C-allocated memory
        if ($name eq "c::free") {
            gen_call_with_arg_cleanup($cg, "strada_c_free", $expr->{"args"}, 1);
            return 1;
        }

        # c::alloc - Allocate memory (malloc wrapper)
        if ($name eq "c::alloc") {
            gen_call_with_arg_cleanup($cg, "strada_c_alloc", $expr->{"args"}, 1);
            return 1;
        }

        # c::realloc - Reallocate memory
        if ($name eq "c::realloc") {
            gen_call_with_arg_cleanup($cg, "strada_c_realloc", $expr->{"args"}, 2);
            return 1;
        }

        # c::null - Return NULL pointer
        if ($name eq "c::null") {
            emit($cg, "strada_c_null()");
            return 1;
        }

        # c::is_null - Check if pointer is NULL
        if ($name eq "c::is_null") {
            gen_call_with_arg_cleanup($cg, "strada_c_is_null", $expr->{"args"}, 1);
            return 1;
        }

        # c::ptr_add - Pointer arithmetic
        if ($name eq "c::ptr_add") {
            gen_call_with_arg_cleanup($cg, "strada_c_ptr_add", $expr->{"args"}, 2);
            return 1;
        }

        # c:: memory read functions
        if ($name eq "c::read_int8") {
            gen_call_with_arg_cleanup($cg, "strada_c_read_int8", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "c::read_int16") {
            gen_call_with_arg_cleanup($cg, "strada_c_read_int16", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "c::read_int32") {
            gen_call_with_arg_cleanup($cg, "strada_c_read_int32", $expr->{"args"}, 1);
            return 1;
        }
    return 0;
}

func gen_builtin_g6(scalar $cg, scalar $expr, str $name) int {

        if ($name eq "c::read_int64") {
            gen_call_with_arg_cleanup($cg, "strada_c_read_int64", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "c::read_ptr") {
            gen_call_with_arg_cleanup($cg, "strada_c_read_ptr", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "c::read_float") {
            gen_call_with_arg_cleanup($cg, "strada_c_read_float", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "c::read_double") {
            gen_call_with_arg_cleanup($cg, "strada_c_read_double", $expr->{"args"}, 1);
            return 1;
        }

        # c:: memory write functions
        if ($name eq "c::write_int8") {
            gen_call_with_arg_cleanup($cg, "strada_c_write_int8", $expr->{"args"}, 2);
            return 1;
        }

        if ($name eq "c::write_int16") {
            gen_call_with_arg_cleanup($cg, "strada_c_write_int16", $expr->{"args"}, 2);
            return 1;
        }

        if ($name eq "c::write_int32") {
            gen_call_with_arg_cleanup($cg, "strada_c_write_int32", $expr->{"args"}, 2);
            return 1;
        }

        if ($name eq "c::write_int64") {
            gen_call_with_arg_cleanup($cg, "strada_c_write_int64", $expr->{"args"}, 2);
            return 1;
        }

        if ($name eq "c::write_ptr") {
            gen_call_with_arg_cleanup($cg, "strada_c_write_ptr", $expr->{"args"}, 2);
            return 1;
        }

        if ($name eq "c::write_float") {
            gen_call_with_arg_cleanup($cg, "strada_c_write_float", $expr->{"args"}, 2);
            return 1;
        }

        if ($name eq "c::write_double") {
            gen_call_with_arg_cleanup($cg, "strada_c_write_double", $expr->{"args"}, 2);
            return 1;
        }

        # c:: size introspection
        if ($name eq "c::sizeof_int") {
            emit($cg, "strada_c_sizeof_int()");
            return 1;
        }

        if ($name eq "c::sizeof_long") {
            emit($cg, "strada_c_sizeof_long()");
            return 1;
        }

        if ($name eq "c::sizeof_ptr") {
            emit($cg, "strada_c_sizeof_ptr()");
            return 1;
        }

        if ($name eq "c::sizeof_size_t") {
            emit($cg, "strada_c_sizeof_size_t()");
            return 1;
        }

        # c:: memory operations
        if ($name eq "c::memcpy") {
            gen_call_with_arg_cleanup($cg, "strada_c_memcpy", $expr->{"args"}, 3);
            return 1;
        }

        if ($name eq "c::memset") {
            gen_call_with_arg_cleanup($cg, "strada_c_memset", $expr->{"args"}, 3);
            return 1;
        }

        # readline - read line from stdin or file handle
        if ($name eq "readline") {
            my int $arg_count = $expr->{"arg_count"};
            if ($arg_count >= 2) {
                # readline($fh, $max_bytes) - optional per-call byte limit
                gen_call_with_arg_cleanup($cg, "strada_read_line_max", $expr->{"args"}, 2);
            } elsif ($arg_count > 0) {
                gen_call_with_arg_cleanup($cg, "strada_read_line", $expr->{"args"}, 1);
            } else {
                emit($cg, "strada_readline()");
            }
            return 1;
        }
        
        # refcount - get reference count
        if ($name eq "refcount") {
            my scalar $args = $expr->{"args"};
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[0]) == 1) {
                emit($cg, "({ StradaValue *__rc_v = ");
                gen_expression($cg, $args->[0]);
                emit($cg, "; int64_t __rc_n = strada_refcount(__rc_v); strada_decref(__rc_v); strada_new_int(__rc_n); })");
            } else {
                emit($cg, "strada_new_int(strada_refcount(");
                gen_expression($cg, $args->[0]);
                emit($cg, "))");
            }
            return 1;
        }

        # core::weaken / sys::weaken - make a reference weak
        # Passes a pointer to the variable so the runtime can replace it with a weak wrapper
        if ($name eq "sys::weaken") {
            my scalar $args = $expr->{"args"};
            my scalar $arg = $args->[0];
            my int $wt = $arg->{"type"};
            # For variable references, pass address of variable
            if ($wt == NODE_VARIABLE()) {
                my str $wk_cname = escape_c_keyword($arg->{"name"});
                my str $wk_our = "" . $cg->{"our_vars"}->{$wk_cname};
                if (length($wk_our) > 0) {
                    emit($cg, "(strada_global_weaken_cstr(" . c_str_lit($wk_our) . "), strada_undef_static())");
                } else {
                    my str $wk_ref = scalar_var_c_ref($cg, $arg->{"name"}, $wk_cname);
                    emit($cg, "(strada_weaken((StradaValue **)&(" . $wk_ref . ")), strada_undef_static())");
                }
            } elsif ($wt == NODE_HASH_ACCESS() || $wt == NODE_DEREF_HASH()) {
                # NODE_HASH_ACCESS uses `hash`; NODE_DEREF_HASH uses `ref`.
                my scalar $wk_hv_e = $arg->{"hash"};
                if ($wt == NODE_DEREF_HASH()) { $wk_hv_e = $arg->{"ref"}; }
                emit($cg, "({ StradaValue *__wk_hsv = ");
                gen_expression($cg, $wk_hv_e);
                emit($cg, "; StradaHash *__wk_hv = strada_deref_hash(__wk_hsv); StradaValue *__wk_kv = ");
                gen_expression($cg, $arg->{"key"});
                emit($cg, "; char *__wk_key = strada_to_str_ss(__wk_kv); strada_weaken_hv_entry(__wk_hv, __wk_key); strada_cstr_free(__wk_key); ");
                if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $arg->{"key"}) == 1) {
                    emit($cg, "strada_decref(__wk_kv); ");
                }
                if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $wk_hv_e) == 1) {
                    emit($cg, "strada_decref(__wk_hsv); ");
                }
                emit($cg, "strada_undef_static(); })");
            } elsif ($wt == NODE_SUBSCRIPT() || $wt == NODE_DEREF_ARRAY()) {
                my scalar $wk_arr_e = $arg->{"array"};
                if ($wt == NODE_DEREF_ARRAY()) { $wk_arr_e = $arg->{"ref"}; }
                emit($cg, "({ StradaValue *__wk_asv = ");
                gen_expression($cg, $wk_arr_e);
                emit($cg, "; StradaValue *__wk_iv = ");
                gen_expression($cg, $arg->{"index"});
                emit($cg, "; strada_array_weaken_elem(__wk_asv, strada_to_int(__wk_iv)); ");
                if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $arg->{"index"}) == 1) {
                    emit($cg, "strada_decref(__wk_iv); ");
                }
                if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $wk_arr_e) == 1) {
                    emit($cg, "strada_decref(__wk_asv); ");
                }
                emit($cg, "strada_undef_static(); })");
            } else {
                # Fallback for other expression types - weaken in a temp variable
                emit($cg, "({ StradaValue *__wk_tmp = ");
                gen_expression($cg, $arg);
                emit($cg, "; strada_weaken(&__wk_tmp); ");
                if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $arg) == 1) {
                    emit($cg, "strada_decref(__wk_tmp); ");
                }
                emit($cg, "strada_undef_static(); })");
            }
            return 1;
        }

        # core::isweak / sys::isweak - check if a reference is weak
        if ($name eq "sys::isweak") {
            my scalar $args = $expr->{"args"};
            if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[0]) == 1) {
                emit($cg, "({ StradaValue *__iw_tmp = ");
                gen_expression($cg, $args->[0]);
                emit($cg, "; StradaValue *__iw_r = strada_new_int(strada_isweak(__iw_tmp)); strada_decref(__iw_tmp); __iw_r; })");
            } else {
                emit($cg, "strada_new_int(strada_isweak(");
                gen_expression($cg, $args->[0]);
                emit($cg, "))");
            }
            return 1;
        }

        # free - explicitly decrement refcount, free if zero, and set variable to undef
        # free(\$var) -> frees $var's value and sets $var = undef (same as release)
        if ($name eq "free" || $name eq "sys::free" || $name eq "sys::release") {
            my scalar $args = $expr->{"args"};
            my scalar $ref_arg = $args->[0];

            # Check if argument is a reference expression like \$var
            if ($ref_arg->{"type"} == NODE_REF() && $ref_arg->{"target"}->{"type"} == NODE_VARIABLE()) {
                my str $fr_cname = escape_c_keyword($ref_arg->{"target"}->{"name"});
                my str $fr_our = "" . $cg->{"our_vars"}->{$fr_cname};
                if (length($fr_our) > 0) {
                    emit($cg, "({ StradaValue *__fr_v = strada_global_get_cstr(" . c_str_lit($fr_our) . "); strada_free(__fr_v); strada_decref(__fr_v); strada_global_set_cstr(" . c_str_lit($fr_our) . ", strada_new_undef()); strada_undef_static(); })");
                } else {
                    my str $fr_ref = scalar_var_c_ref($cg, $ref_arg->{"target"}->{"name"}, $fr_cname);
                    # Generate: (strada_free(ref), ref = strada_new_undef())
                    emit($cg, "(strada_free(" . $fr_ref . "), " . $fr_ref . " = strada_new_undef(), strada_undef_static())");
                }
            } else {
                # Fallback: just call the runtime function with arg cleanup
                gen_call_with_arg_cleanup($cg, "strada_release", $args, 1);
            }
            return 1;
        }

        # ucfirst - uppercase first letter
        if ($name eq "ucfirst") {
            my scalar $args = $expr->{"args"};
            my scalar $arg0 = $args->[0];
            my int $needs_cleanup = needs_temp_cleanup($cg, $arg0);
            emit($cg, "(({ StradaValue *__ucf_tmp = ");
            gen_expression($cg, $arg0);
            emit($cg, "; char *__ucf_in = strada_to_str_ss(__ucf_tmp); ");
            emit($cg, "char *__ucf_out = strada_ucfirst(__ucf_in); ");
            emit($cg, "StradaValue *__ucf_res = strada_new_str(__ucf_out); ");
            emit($cg, "strada_cstr_free(__ucf_in); free(__ucf_out); ");
            if ($needs_cleanup == 1) {
                emit($cg, "strada_decref(__ucf_tmp); ");
            }
            emit($cg, "__ucf_res; }))");
            return 1;
        }

        # lcfirst - lowercase first letter
        if ($name eq "lcfirst") {
            my scalar $args = $expr->{"args"};
            my scalar $arg0 = $args->[0];
            my int $needs_cleanup = needs_temp_cleanup($cg, $arg0);
            emit($cg, "(({ StradaValue *__lcf_tmp = ");
            gen_expression($cg, $arg0);
            emit($cg, "; char *__lcf_in = strada_to_str_ss(__lcf_tmp); ");
            emit($cg, "char *__lcf_out = strada_lcfirst(__lcf_in); ");
            emit($cg, "StradaValue *__lcf_res = strada_new_str(__lcf_out); ");
            emit($cg, "strada_cstr_free(__lcf_in); free(__lcf_out); ");
            if ($needs_cleanup == 1) {
                emit($cg, "strada_decref(__lcf_tmp); ");
            }
            emit($cg, "__lcf_res; }))");
            return 1;
        }
        
        # match - regex match (with capture support so captures() works after match())
        if ($name eq "match") {
            my scalar $args = $expr->{"args"};
            my int $a0_temp = 0;
            my int $a1_temp = 0;
            if ($cg->{"cleanup_enabled"} == 1) {
                $a0_temp = needs_temp_cleanup($cg, $args->[0]);
                $a1_temp = needs_temp_cleanup($cg, $args->[1]);
            }
            emit($cg, "({ ");
            if ($a0_temp == 1) {
                emit($cg, "StradaValue *__m_a0 = ");
                gen_expression($cg, $args->[0]);
                emit($cg, "; char *__m_s = strada_to_str_ss(__m_a0); ");
            } else {
                emit($cg, "char *__m_s = strada_to_str_ss(");
                gen_expression($cg, $args->[0]);
                emit($cg, "); ");
