                if (hash_list_arg($arg)) {
                    # f(%h) / f(...%h): the hash's key/value pairs
                    emit_hash_pairs_append($cg, "strada_deref_array(__va_arr)", hash_list_arg($arg));
                } elsif ($arg->{"type"} == NODE_SPREAD()) {
                    my int $sp_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $arg->{"target"}) == 1 && expr_is_always_tagged_int($cg, $arg->{"target"}) == 0;
                    if ($sp_cl == 1) {
                        emit($cg, "{ StradaValue *__spread = strada_mortal(");
                        gen_expression($cg, $arg->{"target"});
                        emit($cg, "); strada_av_append_all(strada_deref_array(__va_arr), __spread); } ");
                    } else {
                        emit($cg, "{ StradaValue *__spread = ");
                        gen_expression($cg, $arg->{"target"});
                        emit($cg, "; strada_av_append_all(strada_deref_array(__va_arr), __spread); } ");
                    }
                } elsif (array_flatten_kind($cg, $arg) >= 1) {
                    my int $fl_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $arg) == 1 && expr_is_always_tagged_int($cg, $arg) == 0;
                    if ($fl_cl == 1) {
                        emit($cg, "{ StradaValue *__flat = strada_mortal(");
                        gen_expression($cg, $arg);
                        emit($cg, "); if (strada_sv_is_array_or_aref(__flat)) { strada_av_append_all(strada_deref_array(__va_arr), __flat); } else { strada_array_push(strada_deref_array(__va_arr), __flat); } } ");
                    } else {
                        emit($cg, "{ StradaValue *__flat = ");
                        gen_expression($cg, $arg);
                        emit($cg, "; if (strada_sv_is_array_or_aref(__flat)) { strada_av_append_all(strada_deref_array(__va_arr), __flat); } else { strada_array_push(strada_deref_array(__va_arr), __flat); } } ");
                    }
                } else {
                    if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $arg) == 1) {
                        emit($cg, "strada_array_push_take(strada_deref_array(__va_arr), ");
                    } else {
                        emit($cg, "strada_array_push(strada_deref_array(__va_arr), ");
                    }
                    gen_expression($cg, $arg);
                    emit($cg, "); ");
                }
                $a = $a + 1;
            }

            if ($is_variadic_call == 0 && $func_info) {
                # Spread call to a fixed-arity function: unpack __va_arr into positional params
                my int $fpc = $func_info->{"param_count"} + 0;
                my scalar $fparams = $func_info->{"params"};
                emit($cg, "StradaArray *__va_av = strada_deref_array(__va_arr); ");
                for (my int $fp = 0; $fp < $fpc; $fp = $fp + 1) {
                    my scalar $fparam = $fparams->[$fp];
                    emit($cg, "StradaValue *__sp_p" . $fp . " = (__va_av && (size_t)" . $fp . " < __va_av->size) ? strada_array_get(__va_av, " . $fp . ") : NULL; ");
                    if ($fparam->{"has_default"} == 1) {
                        my scalar $sp_saved = enter_callee_pkg($cg, $func_info);
                        my int $sp_def_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $fparam->{"default"}) == 1 && expr_is_always_tagged_int($cg, $fparam->{"default"}) == 0;
                        if ($sp_def_cl == 1) {
                            emit($cg, "if (!__sp_p" . $fp . ") { __sp_p" . $fp . " = strada_mortal(");
                            gen_expression($cg, $fparam->{"default"});
                            emit($cg, "); } ");
                        } else {
                            emit($cg, "if (!__sp_p" . $fp . ") { __sp_p" . $fp . " = ");
                            gen_expression($cg, $fparam->{"default"});
                            emit($cg, "; } ");
                        }
                        leave_callee_pkg($cg, $sp_saved);
                    } else {
                        emit($cg, "if (!__sp_p" . $fp . ") { __sp_p" . $fp . " = strada_undef_static(); } ");
                    }
                }
                if ($is_dynamic_call == 1) {
                    emit($cg, "int __prev_ctx = strada_wantarray() ? 1 : (strada_wanthash() ? 2 : 0); strada_set_call_context(" . $dyn_ctx . "); ");
                }
                if ($cg->{"enable_stack_trace"} == 1) {
                    my int $__cl_linesp = $expr->{"line"} + 0;
                    if ($__cl_linesp > 0) {
                        emit($cg, "strada_stack_line_il(" . $__cl_linesp . "); ");
                    }
                }
                if ($returns_void == 0) {
                    emit($cg, "StradaValue *__va_result = ");
                }
                emit($cg, $c_name . "(");
                for (my int $fp2 = 0; $fp2 < $fpc; $fp2 = $fp2 + 1) {
                    if ($fp2 > 0) { emit($cg, ", "); }
                    emit($cg, "__sp_p" . $fp2);
                }
                emit($cg, "); ");
                emit($cg, "strada_tmps_free(" . $va_tm . "); ");
                if ($is_dynamic_call == 1) {
                    emit($cg, "strada_set_call_context(__prev_ctx); ");
                }
                if ($returns_void == 0) {
                    emit($cg, "__va_result; })");
                } else {
                    emit($cg, "strada_undef_static(); })");
                }
                return;
            }

            if ($is_dynamic_call == 1) {
                emit($cg, "int __prev_ctx = strada_wantarray() ? 1 : (strada_wanthash() ? 2 : 0); strada_set_call_context(" . $dyn_ctx . "); ");
            }
            if ($cg->{"enable_stack_trace"} == 1) {
                my int $__cl_line = $expr->{"line"} + 0;
                if ($__cl_line > 0) {
                    emit($cg, "strada_stack_line_il(" . $__cl_line . "); ");
                }
            }
            if ($returns_void == 0) {
                emit($cg, "StradaValue *__va_result = ");
            }
            emit($cg, $c_name . "(");

            for (my int $f = 0; $f < $va_fixed_count; $f = $f + 1) {
                if ($f > 0) {
                    emit($cg, ", ");
                }
                emit($cg, "__farg" . $f);
            }

            if ($va_fixed_count > 0) {
                emit($cg, ", ");
            }
            emit($cg, "__va_arr); ");

            emit($cg, "strada_tmps_free(" . $va_tm . "); ");

            if ($is_dynamic_call == 1) {
                emit($cg, "strada_set_call_context(__prev_ctx); ");
            }

            if ($returns_void == 0) {
                emit($cg, "__va_result; })");
            } else {
                emit($cg, "strada_undef_static(); })");
            }
            return;
        }

        # Check if any arguments need temp cleanup or LTR evaluation order
        # (hoist only up to $last_impure_idx when impure args exist)
        my int $needs_temps = 0;
        my int $last_impure_idx = -1;
        my int $check_i = 0;
        while ($check_i < $arg_count) {
            if (needs_temp_cleanup($cg, $args->[$check_i]) == 1 && expr_is_always_tagged_int($cg, $args->[$check_i]) == 0) {
                $needs_temps = 1;
            }
            if (arg_is_trivially_pure($cg, $args->[$check_i]) == 0) {
                $last_impure_idx = $check_i;
            }
            $check_i = $check_i + 1;
        }

        # Also need temps when default parameter values will be emitted
        if ($func_info && $arg_count < $func_info->{"param_count"}) {
            $needs_temps = 1;
            my scalar $cd_saved = enter_callee_pkg($cg, $func_info);
            my scalar $cparams = $func_info->{"params"};
            my int $cd_i = $arg_count;
            while ($cd_i < $func_info->{"param_count"}) {
                my scalar $cdp = $cparams->[$cd_i];
                if ($cdp->{"has_default"} == 1 && arg_is_trivially_pure($cg, $cdp->{"default"}) == 0) {
                    $last_impure_idx = $cd_i;
                }
                $cd_i = $cd_i + 1;
            }
            leave_callee_pkg($cg, $cd_saved);
        }

        my int $returns_void = 0;
        if ($func_info) {
            my int $ret_type = $func_info->{"return_type"};
            if ($ret_type == TYPE_VOID()) {
                $returns_void = 1;
            }
        }
        if ($needs_temps == 1 || ($arg_count > 1 && $last_impure_idx >= 0)) {

            # Precompute hoist + mortalization plan so pure hoisted calls skip tmps mark/free
            my array @arg_hoisted = ();
            my array @arg_mortal = ();
            my int $any_mortal = 0;
            my int $total_hoisted = 0;
            my int $t = 0;
            while ($t < $arg_count) {
                my int $t_owned = needs_temp_cleanup($cg, $args->[$t]);
                my int $t_tagged = expr_is_always_tagged_int($cg, $args->[$t]);
                my int $do_hoist = 0;
                if ($t_owned == 1 || $t <= $last_impure_idx) {
                    $do_hoist = 1;
                }
                my int $t_mo = 0;
                if ($do_hoist == 1 && $cg->{"cleanup_enabled"} == 1 && $t_tagged == 0) {
                    if ($t_owned == 1) {
                        $t_mo = 1;
                        $any_mortal = 1;
                    } elsif ($t < $last_impure_idx) {
                        $t_mo = 2;
                        $any_mortal = 1;
                    }
                }
                push(@arg_hoisted, $do_hoist);
                push(@arg_mortal, $t_mo);
                $total_hoisted = $total_hoisted + 1;
                $t = $t + 1;
            }
            my array @def_nodes = ();
            my array @def_has = ();
            if ($func_info) {
                my int $param_count = $func_info->{"param_count"};
                my scalar $params = $func_info->{"params"};
                my scalar $dt_saved = enter_callee_pkg($cg, $func_info);
                my int $dt = $arg_count;
                while ($dt < $param_count) {
                    my scalar $dparam = $params->[$dt];
                    my int $d_owned = 1;
                    my int $d_tagged = 0;
                    if ($dparam->{"has_default"} == 1) {
                        $d_owned = needs_temp_cleanup($cg, $dparam->{"default"});
                        $d_tagged = expr_is_always_tagged_int($cg, $dparam->{"default"});
                        push(@def_nodes, $dparam->{"default"});
                        push(@def_has, 1);
                    } else {
                        push(@def_nodes, 0);
                        push(@def_has, 0);
                    }
                    my int $d_mo = 0;
                    if ($cg->{"cleanup_enabled"} == 1 && $d_tagged == 0) {
                        if ($d_owned == 1) {
                            $d_mo = 1;
                            $any_mortal = 1;
                        } elsif ($dt < $last_impure_idx) {
                            $d_mo = 2;
                            $any_mortal = 1;
                        }
                    }
                    push(@arg_hoisted, 1);
                    push(@arg_mortal, $d_mo);
                    $total_hoisted = $total_hoisted + 1;
                    $dt = $dt + 1;
                }
                leave_callee_pkg($cg, $dt_saved);
            }

            # Generate block with LTR hoisted temps and mortal cleanup
            emit($cg, "({ ");
            my str $uc_tm = "";
            if ($any_mortal == 1) {
                $uc_tm = next_tmps_var($cg);
                emit($cg, "size_t " . $uc_tm . " = strada_tmps_mark(); ");
            }
            my int $hi = 0;
            while ($hi < $total_hoisted) {
                if ($arg_hoisted[$hi] == 1) {
                    my int $hm = $arg_mortal[$hi];
                    emit($cg, "StradaValue *__arg" . $hi . " = ");
                    if ($hm == 1) {
                        emit($cg, "strada_mortal(");
                    } elsif ($hm == 2) {
                        emit($cg, "strada_mortal_copy(");
                    }
                    if ($hi < $arg_count) {
                        gen_expression($cg, $args->[$hi]);
                    } else {
                        my int $def_idx = $hi - $arg_count;
                        if ($def_has[$def_idx] == 1) {
                            my scalar $hi_saved = enter_callee_pkg($cg, $func_info);
                            gen_expression($cg, $def_nodes[$def_idx]);
                            leave_callee_pkg($cg, $hi_saved);
                        } else {
                            emit($cg, "strada_new_undef()");
                        }
                    }
                    if ($hm > 0) {
                        emit($cg, ")");
                    }
                    emit($cg, "; ");
                }
                $hi = $hi + 1;
            }
            # Emit the function call, storing result if not void
            if ($is_dynamic_call == 1) {
                emit($cg, "int __prev_ctx = strada_wantarray() ? 1 : (strada_wanthash() ? 2 : 0); strada_set_call_context(" . $dyn_ctx . "); ");
            }
            # Stash call-site line for caller() — see comment above.
            if ($cg->{"enable_stack_trace"} == 1) {
                my int $__cl_line2 = $expr->{"line"} + 0;
                if ($__cl_line2 > 0) {
                    emit($cg, "strada_stack_line_il(" . $__cl_line2 . "); ");
                }
            }
            if ($returns_void == 0) {
                emit($cg, "StradaValue *__call_result = ");
            }
            emit($cg, $c_name . "(");
            for (my int $i = 0; $i < $total_hoisted; $i = $i + 1) {
                if ($i > 0) {
                    emit($cg, ", ");
                }
                if ($arg_hoisted[$i] == 1) {
                    emit($cg, "__arg" . $i);
                } else {
                    gen_expression($cg, $args->[$i]);
                }
            }
            emit($cg, "); ");
            if ($any_mortal == 1) {
                emit($cg, "strada_tmps_free(" . $uc_tm . "); ");
            }
            if ($is_dynamic_call == 1) {
                emit($cg, "strada_set_call_context(__prev_ctx); ");
            }
            # Return result if not void
            if ($returns_void == 0) {
                emit($cg, "__call_result; })");
            } else {
                emit($cg, "strada_undef_static(); })");
            }
        } else {
            # No temps needed, simple call
            if ($is_dynamic_call == 1) {
                if ($returns_void == 0) {
                    emit($cg, "({ int __prev_ctx = strada_wantarray() ? 1 : (strada_wanthash() ? 2 : 0); strada_set_call_context(" . $dyn_ctx . "); StradaValue *__dyn_r = ");
                } else {
                    emit($cg, "({ int __prev_ctx = strada_wantarray() ? 1 : (strada_wanthash() ? 2 : 0); strada_set_call_context(" . $dyn_ctx . "); ");
                }
            } elsif ($returns_void == 1) {
                emit($cg, "(");
            }
            # Stash call-site line for caller() — see comment above.
            # Wrap the call in a comma expression so this stays an
            # expression at any nesting level (statement, my-init,
            # sort key, etc.). strada_stack_set_line returns void so
            # use comma operator with sequenced cast to (void).
            if ($cg->{"enable_stack_trace"} == 1) {
                my int $__cl_line3 = $expr->{"line"} + 0;
                if ($__cl_line3 > 0) {
                    emit($cg, "(strada_stack_line_il(" . $__cl_line3 . "), ");
                }
            }
            emit($cg, $c_name . "(");
            if ($func_info) {
                my int $param_count = $func_info->{"param_count"};
                my scalar $params = $func_info->{"params"};
                my int $i = 0;
                while ($i < $param_count) {
                    if ($i > 0) {
                        emit($cg, ", ");
                    }
                    if ($i < $arg_count) {
                        gen_expression($cg, $args->[$i]);
                    } else {
                        my scalar $param = $params->[$i];
                        if ($param->{"has_default"} == 1) {
                            my scalar $sc_saved = enter_callee_pkg($cg, $func_info);
                            gen_expression($cg, $param->{"default"});
                            leave_callee_pkg($cg, $sc_saved);
                        } else {
                            emit($cg, "strada_new_undef()");
                        }
                    }
                    $i = $i + 1;
                }
            } else {
                my int $i = 0;
                while ($i < $arg_count) {
                    if ($i > 0) {
                        emit($cg, ", ");
                    }
                    gen_expression($cg, $args->[$i]);
                    $i = $i + 1;
                }
            }
            emit($cg, ")");
            # Close the comma-expression wrapper from the call-line set. It
            # wraps just the call, so it must close BEFORE the dynamic-call
            # epilogue: closing it after left `(line, f(); ...` unbalanced, and
            # a `dynamic` call in any program with stack traces on (one that
            # mentions try/throw/caller/stack_trace) did not compile.
            if ($cg->{"enable_stack_trace"} == 1) {
                my int $__cl_line3c = $expr->{"line"} + 0;
                if ($__cl_line3c > 0) {
                    emit($cg, ")");
                }
            }
            if ($is_dynamic_call == 1) {
                if ($returns_void == 0) {
                    emit($cg, "; strada_set_call_context(__prev_ctx); __dyn_r; })");
                } else {
                    emit($cg, "; strada_set_call_context(__prev_ctx); strada_undef_static(); })");
                }
            } elsif ($returns_void == 1) {
                emit($cg, ", strada_undef_static())");
            }
        }
        return;
}

