            if (needs_temp_cleanup($cg, $fr_args->[0]) == 1) {
                emit($cg, "strada_decref(__fr_fh); ");
            }
            if (needs_temp_cleanup($cg, $fr_args->[1]) == 1) {
                emit($cg, "strada_decref(__fr_n); ");
            }
            emit($cg, "__fr_r; })");
            return 1;
        }
        if ($name eq "sys::fread") {
            gen_call_with_arg_cleanup($cg, "strada_read_file", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "die") {
            my scalar $args = $expr->{"args"};
            my int $argc = $expr->{"arg_count"};
            if ($argc == 0) {
                emit($cg, "({ strada_die(\"Died\"); (StradaValue*)NULL; })");
                return 1;
            }
            my scalar $arg0 = $args->[0];
            if ($argc > 1) {
                # Multi-arg die: stringify and concat all args (Perl
                # semantics). Previously only args[0] was raised, so
                # `die "error", " in ", "context"` reached the catcher as
                # "error" with the rest dropped.
                emit($cg, "({ StradaValue *__die_msg = strada_new_str(\"\"); ");
                my int $di = 0;
                while ($di < $argc) {
                    emit($cg, "{ StradaValue *__die_p = ");
                    gen_expression($cg, $args->[$di]);
                    emit($cg, "; StradaValue *__die_new = strada_concat_sv(__die_msg, __die_p); strada_decref(__die_msg); __die_msg = __die_new; ");
                    if (needs_temp_cleanup($cg, $args->[$di]) == 1) {
                        emit($cg, "strada_decref(__die_p); ");
                    }
                    emit($cg, "} ");
                    $di = $di + 1;
                }
                emit($cg, "strada_cleanup_push(__die_msg); strada_die_sv(__die_msg); (StradaValue*)NULL; })");
            } elsif (needs_temp_cleanup($cg, $arg0) == 1) {
                emit($cg, "({ StradaValue *__die_arg = ");
                gen_expression($cg, $arg0);
                emit($cg, "; strada_cleanup_push(__die_arg); strada_die_sv(__die_arg); (StradaValue*)NULL; })");
            } else {
                emit($cg, "({ strada_die_sv(");
                gen_expression($cg, $arg0);
                emit($cg, "); (StradaValue*)NULL; })");
            }
            return 1;
        }

        if ($name eq "throw") {
            # strada_throw_value adopts the SV. Use the same incref-protect
            # pattern as die() above so a borrowed-ref arg (variable, hash
            # access, etc.) doesn't end up shared between the exception
            # state and a still-tracked owning slot.
            my scalar $args = $expr->{"args"};
            my int $targc = $expr->{"arg_count"};
            if ($targc == 0) {
                emit($cg, "({ strada_throw(\"Died\"); (StradaValue*)NULL; })");
