        }

        # unlink(path) - delete file
        if ($name eq "unlink" || $name eq "sys::unlink") {
            my scalar $args = $expr->{"args"};
            gen_call_with_arg_cleanup($cg, "strada_unlink", $args, 1);
            return 1;
        }

        # fwrite(fh, content[, n]) - write to file handle and return byte count
        if ($name eq "sys::fwrite") {
            my scalar $args = $expr->{"args"};
            my scalar $fh_arg = $args->[0];
            my scalar $data_arg = $args->[1];
            emit($cg, "({ StradaValue *__fw_fh = ");
            gen_expression($cg, $fh_arg);
            emit($cg, "; StradaValue *__fw_v = ");
            gen_expression($cg, $data_arg);
            if ($expr->{"arg_count"} >= 3) {
                emit($cg, "; StradaValue *__fw_n = ");
                gen_expression($cg, $args->[2]);
                emit($cg, "; int64_t __fw_c = strada_fwrite_sv_n(__fw_fh, __fw_v, strada_to_int(__fw_n)); ");
                if (needs_temp_cleanup($cg, $args->[2]) == 1) {
                    emit($cg, "strada_decref(__fw_n); ");
                }
            } else {
                emit($cg, "; int64_t __fw_c = strada_fwrite_sv(__fw_fh, __fw_v); ");
            }
            if (needs_temp_cleanup($cg, $fh_arg) == 1) {
                emit($cg, "strada_decref(__fw_fh); ");
            }
            if (needs_temp_cleanup($cg, $data_arg) == 1) {
                emit($cg, "strada_decref(__fw_v); ");
            }
            emit($cg, "strada_new_int(__fw_c); })");
            return 1;
        }


        # fread(fh) - read entire file from handle
        if ($name eq "sys::fread" && $expr->{"arg_count"} >= 2) {
            # fread(fh, n): up to n bytes from the current position.
            my scalar $fr_args = $expr->{"args"};
            emit($cg, "({ StradaValue *__fr_fh = ");
