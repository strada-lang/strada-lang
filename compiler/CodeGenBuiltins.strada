                            gen_expression($cg, $vexpr);
                            emit($cg, "; strada_incref(__ct_v" . $cs_uid . "); strada_hash_set_ss_take(__ct_h->value.hv, __attr_ss" . $cs_uid . ", __ct_v" . $cs_uid . "); ");
                        }
                        emit($cg, "}\n");
                        $ci = $ci + 2;
