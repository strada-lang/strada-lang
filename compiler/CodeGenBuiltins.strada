func emit_slot_retain_push(scalar $cg, str $var, int $retain, int $cl, int $sp) void {
    if ($retain == 1) { emit($cg, "strada_incref(" . $var . "); "); }
    if ($sp == 1 && $cl == 1) { emit($cg, "strada_cleanup_push(" . $var . "); "); }
}

# Array operand of a builtin that MODIFIES it (push/unshift/splice).
# `@{$h{k}}` / `@{$a[i]}` / `@{$r->{k}}` autovivify the element (as in Perl);
# `@$v` / `@{$v}` with $v undef stores a new array ref in $v. Before this,
# the non-array case handed back a shared static empty array and the pushed
# values leaked into every other failed dereference. Returns 1 when the
# target is emitted this way (a BORROWED array value), 0 when the caller
# should use the ordinary expression.
# Append one LIST element to the StradaArray* named $av: array values
# (@arr, (..), ranges, slices, @$r, array calls, map/grep/sort, ...spread)
# contribute their elements, anything else is one element. Owned temps are
# released (cleanup-pushed while live when $use_push).
# print/say with 2+ arguments, or with an array-valued argument. The first
# argument is the destination when it is a filehandle at run time
# (strada_print2 / strada_print_list); array values are flattened.
func gen_print_list(scalar $cg, scalar $args, int $argc, int $nl) void {
    my int $any_flat = 0;
    my int $k = 0;
    while ($k < $argc) {
        if (list_arg_flattens($cg, $args->[$k]) == 1) { $any_flat = 1; }
        $k = $k + 1;
    }
    my int $sp = cleanup_push_useful($cg);
    if ($argc == 2 && $any_flat == 0) {
        my scalar $a0 = $args->[0];
        my scalar $a1 = $args->[1];
        my int $c0 = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $a0) == 1 && expr_is_always_tagged_int($cg, $a0) == 0;
        my int $c1 = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $a1) == 1 && expr_is_always_tagged_int($cg, $a1) == 0;
        emit($cg, "({ StradaValue *__p2a = ");
        gen_expression($cg, $a0);
        emit($cg, "; ");
        if ($c0 == 1 && $sp == 1) { emit($cg, "strada_cleanup_push(__p2a); "); }
        emit($cg, "StradaValue *__p2b = ");
        gen_expression($cg, $a1);
        emit($cg, "; ");
        if ($c1 == 1 && $sp == 1) { emit($cg, "strada_cleanup_push(__p2b); "); }
        emit($cg, "strada_print2(__p2a, __p2b, " . $nl . "); ");
        if ($c1 == 1) {
            if ($sp == 1) { emit($cg, "strada_cleanup_pop_decref(__p2b); "); } else { emit($cg, "strada_decref(__p2b); "); }
        }
        if ($c0 == 1) {
            if ($sp == 1) { emit($cg, "strada_cleanup_pop_decref(__p2a); "); } else { emit($cg, "strada_decref(__p2a); "); }
        }
        emit($cg, "STRADA_MAKE_TAGGED_INT(1); })");
        return;
    }
    my scalar $f0 = $args->[0];
    my int $first_is_item = 1;
    if (list_arg_flattens($cg, $f0) == 1) { $first_is_item = 0; }
    my int $fc = 0;
    if ($first_is_item == 1 && $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $f0) == 1 && expr_is_always_tagged_int($cg, $f0) == 0) { $fc = 1; }
    emit($cg, "({ StradaValue *__pl_first = ");
    if ($first_is_item == 1) { gen_expression($cg, $f0); } else { emit($cg, "NULL"); }
    emit($cg, "; ");
    if ($fc == 1 && $sp == 1) { emit($cg, "strada_cleanup_push(__pl_first); "); }
    emit($cg, "StradaValue *__pl_rest = strada_new_array(); ");
    if ($sp == 1) { emit($cg, "strada_cleanup_push(__pl_rest); "); }
    my int $start = 1;
    if ($first_is_item == 0) { $start = 0; }
    $k = $start;
    while ($k < $argc) {
        emit_list_elem_append($cg, "__pl_rest->value.av", $args->[$k], $sp);
        $k = $k + 1;
    }
    emit($cg, "strada_print_list(__pl_first, __pl_rest, " . $nl . "); ");
    if ($sp == 1) { emit($cg, "strada_cleanup_pop_decref(__pl_rest); "); } else { emit($cg, "strada_decref(__pl_rest); "); }
    if ($fc == 1) {
        if ($sp == 1) { emit($cg, "strada_cleanup_pop_decref(__pl_first); "); } else { emit($cg, "strada_decref(__pl_first); "); }
    }
    emit($cg, "STRADA_MAKE_TAGGED_INT(1); })");
}

# Hold an evaluated builtin operand in C local VAR. An owned temp is put on
# the cleanup stack (when that is useful here) so a throw from a later
# operand, or from the operation itself, does not leak it. Release with
# emit_arg_release using the same $owned/$push.
# "strada_decref(VAR); " or, when VAR was put on the cleanup stack, its pop.
func cleanup_pd_str(int $pushed, str $var) str {
    if ($pushed == 1) { return "strada_cleanup_pop_decref(" . $var . "); "; }
    return "strada_decref(" . $var . "); ";
}

func emit_arg_hold(scalar $cg, str $var, scalar $e, int $owned, int $push) void {
    emit($cg, "StradaValue *" . $var . " = ");
    gen_expression($cg, $e);
    emit($cg, "; ");
    if ($owned == 1 && $push == 1) { emit($cg, "strada_cleanup_push(" . $var . "); "); }
}

func emit_arg_release(scalar $cg, str $var, int $owned, int $push) void {
    if ($owned != 1) { return; }
    if ($push == 1) { emit($cg, "strada_cleanup_pop_decref(" . $var . "); "); }
    else { emit($cg, "strada_decref(" . $var . "); "); }
}

func list_arg_flattens(scalar $cg, scalar $e) int {
    if ($e->{"type"} == NODE_SPREAD()) { return 1; }
    if (array_flatten_kind($cg, $e) > 0) { return 1; }
    if (hash_list_arg($e)) { return 1; }
    return 0;
}

# A whole hash in list context (`%h`, `%$r`, `%{...}`, or a spread of one):
# its key/value pairs flatten into the list (Perl). Returns the hash node.
func hash_list_arg(scalar $e) scalar {
    if (!defined($e)) { return 0; }
    my scalar $t = $e;
    if ($t->{"type"} == NODE_SPREAD()) { $t = $t->{"target"}; }
    if (!defined($t)) { return 0; }
    if (($t->{"type"} == NODE_VARIABLE() || $t->{"type"} == NODE_DEREF_SCALAR()) && ("" . $t->{"sigil"}) eq "%") { return $t; }
    return 0;
}

# Append the key/value pairs of the hash node $h to the StradaArray* $av.
func emit_hash_pairs_append(scalar $cg, str $av, scalar $h) void {
    my int $own = 0;
    if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $h) == 1) { $own = 1; }
    emit($cg, "{ StradaValue *__lh_h = ");
    gen_expression($cg, $h);
    emit($cg, "; StradaValue *__lh_f = strada_hash_to_flat_array(__lh_h); ");
    if ($own == 1) { emit($cg, "strada_decref(__lh_h); "); }
    emit($cg, "strada_av_append_all(" . $av . ", __lh_f); strada_decref(__lh_f); } ");
}

func emit_list_elem_append(scalar $cg, str $av, scalar $el, int $use_push) void {
    my scalar $hl = hash_list_arg($el);
    if ($hl) {
        emit_hash_pairs_append($cg, $av, $hl);
        return;
    }
    my scalar $src = $el;
    my int $flat = array_flatten_kind($cg, $el);
    if ($el->{"type"} == NODE_SPREAD()) { $src = $el->{"target"}; $flat = 1; }
    my int $own = 0;
    if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $src) == 1 && expr_is_always_tagged_int($cg, $src) == 0) { $own = 1; }
    if ($flat > 0) {
        emit($cg, "{ StradaValue *__le_v = ");
        gen_expression($cg, $src);
        emit($cg, "; ");
        if ($own == 1 && $use_push == 1) { emit($cg, "strada_cleanup_push(__le_v); "); }
        emit($cg, "if (strada_sv_is_array_or_aref(__le_v)) { strada_av_append_all(" . $av . ", __le_v); } else { strada_array_push(" . $av . ", __le_v); } ");
        if ($own == 1) {
            if ($use_push == 1) { emit($cg, "strada_cleanup_pop_decref(__le_v); "); }
            else { emit($cg, "strada_decref(__le_v); "); }
        }
        emit($cg, "} ");
        return;
    }
    if ($own == 1) {
        emit($cg, "strada_array_push_take(" . $av . ", ");
        gen_expression($cg, $src);
        emit($cg, "); ");
        return;
    }
    emit($cg, "strada_array_push(" . $av . ", ");
    gen_expression($cg, $src);
    emit($cg, "); ");
}

func mutable_array_target_kind(scalar $cg, scalar $arg) int {
    if (!defined($arg) || $arg->{"type"} != NODE_DEREF_SCALAR() || $arg->{"sigil"} ne "@") { return 0; }
    my scalar $inner = $arg->{"ref"};
    if (!defined($inner)) { return 0; }
    if (autoviv_link_type($inner) == 1) { return 1; }
    if ($inner->{"type"} == NODE_VARIABLE() && $inner->{"sigil"} eq "$") {
        my str $vn = "" . $inner->{"name"};
        if ($vn eq "_" || $vn eq "__program_name" || index($vn, "::") >= 0) { return 0; }
        if ($cg->{"in_sort_block"} != 0 && ($vn eq "a" || $vn eq "b")) { return 0; }
        my str $cn = escape_c_keyword($vn);
        if (length("" . $cg->{"our_vars"}->{$cn}) > 0) { return 0; }
        if (is_unboxed_var_node($cg, $inner) == 1) { return 0; }
        return 2;
    }
    return 0;
}

func gen_array_target(scalar $cg, scalar $arg) void {
    my int $k = mutable_array_target_kind($cg, $arg);
    my scalar $inner = $arg->{"ref"};
    if ($k == 1) {
        emit($cg, "strada_deref_array_value(");
        gen_assign_container($cg, $inner, 2);
        emit($cg, ")");
        return;
    }
    if ($k == 2) {
        my str $cn = escape_c_keyword($inner->{"name"});
        emit($cg, "strada_autoviv_slot_array((StradaValue **)&" . scalar_var_c_ref($cg, $inner->{"name"}, $cn) . ")");
        return;
    }
    gen_expression($cg, $arg);
}

func emit_slot_pop_decref(scalar $cg, str $var, int $cl, int $sp) void {
    if ($cl == 1) {
        if ($sp == 1) { emit($cg, "strada_cleanup_pop_decref(" . $var . "); "); }
        else { emit($cg, "strada_decref(" . $var . "); "); }
    }
}

func gen_utf8_slot_op(scalar $cg, str $slot_fn, str $rt_fn, scalar $arg0, int $has_fail_ok, scalar $fail_ok_expr) void {
    my int $sp = cleanup_push_useful($cg);
    my int $tt = $arg0->{"type"} + 0;
    if ($tt == NODE_VARIABLE() && $arg0->{"sigil"} eq "$" && $arg0->{"name"} ne "__program_name") {
        my str $vc = escape_c_keyword($arg0->{"name"});
        my str $u8_our = "" . $cg->{"our_vars"}->{$vc};
        if (length($u8_our) > 0) {
            emit($cg, "({ StradaValue *__u8_tv = strada_global_get_cstr(" . c_str_lit($u8_our) . "); ");
            if ($sp == 1) { emit($cg, "strada_cleanup_push(__u8_tv); "); }
            if ($has_fail_ok == 1) {
                emit($cg, "int __u8_fo = (int)");
                emit_int_operand($cg, $fail_ok_expr);
                emit($cg, "; ");
            }
            emit($cg, "StradaValue *__u8_res = " . $slot_fn . "(&__u8_tv");
            if ($has_fail_ok == 1) { emit($cg, ", __u8_fo"); }
            emit($cg, "); ");
            if ($sp == 1) { emit($cg, "strada_cleanup_pop(); strada_cleanup_push(__u8_res); "); }
            emit($cg, "strada_global_set_cstr(" . c_str_lit($u8_our) . ", __u8_tv); ");
            if ($sp == 1) { emit($cg, "strada_cleanup_pop(); "); }
            emit($cg, "__u8_res; })");
            return;
        }
        my str $vref = scalar_var_c_ref($cg, $arg0->{"name"}, $vc);
        if ($cg->{"uses_tie"} == 1) {
            emit($cg, "({ int __u8_tied = strada_scalar_is_tied(" . $vref . "); ");
            if ($has_fail_ok == 1) {
                emit($cg, "int __u8_fo = (int)");
                emit_int_operand($cg, $fail_ok_expr);
                emit($cg, "; ");
            }
            emit($cg, "StradaValue *__u8_res; if (__u8_tied) { StradaValue *__u8_tv = strada_tied_scalar_fetch(" . $vref . "); ");
            if ($sp == 1) { emit($cg, "strada_cleanup_push(__u8_tv); "); }
            emit($cg, "__u8_res = " . $slot_fn . "(&__u8_tv");
            if ($has_fail_ok == 1) { emit($cg, ", __u8_fo"); }
            emit($cg, "); ");
            if ($sp == 1) { emit($cg, "strada_cleanup_pop(); strada_cleanup_push(__u8_res); strada_cleanup_push(__u8_tv); "); }
            emit($cg, "strada_tied_scalar_store(" . $vref . ", __u8_tv); ");
            if ($sp == 1) { emit($cg, "strada_cleanup_pop_decref(__u8_tv); strada_cleanup_pop(); "); }
            else { emit($cg, "strada_decref(__u8_tv); "); }
            emit($cg, "} else { __u8_res = " . $slot_fn . "((StradaValue **)&(" . $vref . ")");
            if ($has_fail_ok == 1) { emit($cg, ", __u8_fo"); }
            emit($cg, "); } __u8_res; })");
            return;
        }
        emit($cg, $slot_fn . "((StradaValue **)&(");
        gen_expression($cg, $arg0);
        emit($cg, ")");
        if ($has_fail_ok == 1) {
            emit($cg, ", (int)");
            emit_int_operand($cg, $fail_ok_expr);
        }
        emit($cg, ")");
        return;
    }
    if ($tt == NODE_HASH_ACCESS() || $tt == NODE_DEREF_HASH()) {
        my scalar $he = $arg0->{"hash"};
        if ($tt == NODE_DEREF_HASH()) { $he = $arg0->{"ref"}; }
        my int $h_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $he) == 1 && autoviv_link_type($he) == 0;
        my int $h_retain = 0;
        if ($cg->{"cleanup_enabled"} == 1 && $h_cl == 0 && autoviv_link_type($he) == 0) {
            $h_retain = 1;
            $h_cl = 1;
        }
        my int $av_cl = autoviv_chain_needs_cleanup($cg, $he);
        my int $k_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $arg0->{"key"}) == 1;
        emit($cg, "({ ");
        if ($av_cl == 1) { emit($cg, "int __u8_av_mk = strada_cleanup_mark(); "); }
        emit($cg, "StradaValue *__u8_h = ");
        gen_assign_container_marked($cg, $he, 1, $av_cl);
        emit($cg, "; ");
        emit_slot_retain_push($cg, "__u8_h", $h_retain, $h_cl, $sp);
        emit($cg, "StradaValue *__u8_k = ");
        gen_expression($cg, $arg0->{"key"});
        emit($cg, "; ");
        if ($sp == 1 && $k_cl == 1) { emit($cg, "strada_cleanup_push(__u8_k); "); }
        emit($cg, "StradaValue *__u8_tv = strada_hv_fetch_owned_sv(__u8_h, __u8_k); ");
        if ($sp == 1) { emit($cg, "strada_cleanup_push(__u8_tv); "); }
        if ($has_fail_ok == 1) {
            emit($cg, "int __u8_fo = (int)");
            emit_int_operand($cg, $fail_ok_expr);
            emit($cg, "; ");
        }
        emit($cg, "StradaValue *__u8_res = " . $slot_fn . "(&__u8_tv");
        if ($has_fail_ok == 1) { emit($cg, ", __u8_fo"); }
        emit($cg, "); ");
        if ($sp == 1) { emit($cg, "strada_cleanup_pop(); strada_cleanup_push(__u8_res); strada_cleanup_push(__u8_tv); "); }
        emit($cg, "strada_hv_store_sv(__u8_h, __u8_k, __u8_tv); ");
        if ($sp == 1) { emit($cg, "strada_cleanup_pop_decref(__u8_tv); strada_cleanup_pop(); "); }
        else { emit($cg, "strada_decref(__u8_tv); "); }
        emit_slot_pop_decref($cg, "__u8_k", $k_cl, $sp);
        emit_slot_pop_decref($cg, "__u8_h", $h_cl, $sp);
        if ($av_cl == 1) { emit($cg, "strada_cleanup_drain_to(__u8_av_mk); "); }
        emit($cg, "__u8_res; })");
        return;
    }
    if ($tt == NODE_SUBSCRIPT() || $tt == NODE_DEREF_ARRAY()) {
        my scalar $ae = $arg0->{"array"};
        if ($tt == NODE_DEREF_ARRAY()) { $ae = $arg0->{"ref"}; }
        my int $a_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $ae) == 1 && autoviv_link_type($ae) == 0;
        my int $a_retain = 0;
        if ($cg->{"cleanup_enabled"} == 1 && $a_cl == 0 && autoviv_link_type($ae) == 0) {
            $a_retain = 1;
            $a_cl = 1;
        }
        my int $av_cl = autoviv_chain_needs_cleanup($cg, $ae);
        emit($cg, "({ ");
        if ($av_cl == 1) { emit($cg, "int __u8_av_mk = strada_cleanup_mark(); "); }
        emit($cg, "StradaValue *__u8_a = ");
        gen_assign_container_marked($cg, $ae, 2, $av_cl);
        emit($cg, "; ");
        emit_slot_retain_push($cg, "__u8_a", $a_retain, $a_cl, $sp);
        emit($cg, "int64_t __u8_idx = ");
        emit_int_operand($cg, $arg0->{"index"});
        emit($cg, "; StradaValue *__u8_tv = strada_av_fetch_sv(__u8_a, __u8_idx); ");
        if ($sp == 1) { emit($cg, "strada_cleanup_push(__u8_tv); "); }
        if ($has_fail_ok == 1) {
            emit($cg, "int __u8_fo = (int)");
            emit_int_operand($cg, $fail_ok_expr);
            emit($cg, "; ");
        }
        emit($cg, "StradaValue *__u8_res = " . $slot_fn . "(&__u8_tv");
        if ($has_fail_ok == 1) { emit($cg, ", __u8_fo"); }
        emit($cg, "); ");
        if ($cg->{"uses_tie"} == 1) {
            if ($sp == 1) { emit($cg, "strada_cleanup_pop(); strada_cleanup_push(__u8_res); strada_cleanup_push(__u8_tv); "); }
            emit($cg, "strada_av_store_sv(__u8_a, __u8_idx, __u8_tv); ");
            if ($sp == 1) { emit($cg, "strada_cleanup_pop_decref(__u8_tv); strada_cleanup_pop(); "); }
            else { emit($cg, "strada_decref(__u8_tv); "); }
        } else {
            if ($sp == 1) { emit($cg, "strada_cleanup_pop(); "); }
            emit($cg, "strada_array_set(strada_deref_array(__u8_a), __u8_idx, __u8_tv); strada_decref(__u8_tv); ");
        }
        emit_slot_pop_decref($cg, "__u8_a", $a_cl, $sp);
        if ($av_cl == 1) { emit($cg, "strada_cleanup_drain_to(__u8_av_mk); "); }
        emit($cg, "__u8_res; })");
        return;
    }
    if ($tt == NODE_DEREF_SCALAR()) {
        my int $r_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $arg0->{"ref"}) == 1;
        my int $r_retain = 0;
        if ($cg->{"cleanup_enabled"} == 1 && $r_cl == 0) {
            $r_retain = 1;
            $r_cl = 1;
        }
        emit($cg, "({ StradaValue *__u8_ref = ");
        gen_expression($cg, $arg0->{"ref"});
        emit($cg, "; ");
        emit_slot_retain_push($cg, "__u8_ref", $r_retain, $r_cl, $sp);
        emit($cg, "StradaValue *__u8_tv = strada_deref(__u8_ref); ");
        if ($sp == 1) { emit($cg, "strada_cleanup_push(__u8_tv); "); }
        if ($has_fail_ok == 1) {
            emit($cg, "int __u8_fo = (int)");
            emit_int_operand($cg, $fail_ok_expr);
            emit($cg, "; ");
        }
        emit($cg, "StradaValue *__u8_res = " . $slot_fn . "(&__u8_tv");
        if ($has_fail_ok == 1) { emit($cg, ", __u8_fo"); }
        emit($cg, "); ");
        if ($sp == 1) { emit($cg, "strada_cleanup_pop(); strada_cleanup_push(__u8_res); strada_cleanup_push(__u8_tv); "); }
        emit($cg, "strada_deref_set(__u8_ref, __u8_tv); ");
        if ($sp == 1) { emit($cg, "strada_cleanup_pop_decref(__u8_tv); strada_cleanup_pop(); "); }
        else { emit($cg, "strada_decref(__u8_tv); "); }
        emit_slot_pop_decref($cg, "__u8_ref", $r_cl, $sp);
        emit($cg, "__u8_res; })");
        return;
    }
    if ($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $arg0) == 1) {
        emit($cg, "({ StradaValue *__arg_tmp = ");
        gen_expression($cg, $arg0);
        emit($cg, "; ");
        if ($sp == 1) { emit($cg, "strada_cleanup_push(__arg_tmp); "); }
        if ($has_fail_ok == 1) {
            emit($cg, "int __fo_val = (int)");
            emit_int_operand($cg, $fail_ok_expr);
            emit($cg, "; ");
        }
        emit($cg, "StradaValue *__res = " . $rt_fn . "(__arg_tmp");
        if ($has_fail_ok == 1) { emit($cg, ", __fo_val"); }
        emit($cg, "); ");
        if ($sp == 1) { emit($cg, "strada_cleanup_pop_decref(__arg_tmp); "); }
        else { emit($cg, "strada_decref(__arg_tmp); "); }
        emit($cg, "__res; })");
    } else {
        emit($cg, $rt_fn . "(");
        gen_expression($cg, $arg0);
        if ($has_fail_ok == 1) {
            emit($cg, ", (int)");
            emit_int_operand($cg, $fail_ok_expr);
        }
        emit($cg, ")");
    }
}

func gen_chomp_chop(scalar $cg, scalar $arg0, str $rt_fn) void {
    my int $sp = cleanup_push_useful($cg);
    my int $tt = $arg0->{"type"} + 0;
    # chomp(@array) / chop(@array): every element (it was a no-op).
    if (($tt == NODE_VARIABLE() || $tt == NODE_DEREF_SCALAR()) && $arg0->{"sigil"} eq "@") {
        my int $cha_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $arg0) == 1;
        emit($cg, "({ StradaValue *__cha = ");
        gen_expression($cg, $arg0);
        emit($cg, "; StradaArray *__chav = strada_deref_array(__cha); if (__chav) { for (size_t __chi = 0; __chi < __chav->size; __chi++) { StradaValue **__chs = &__chav->elements[__chav->head + __chi]; StradaValue *__che = strada_to_str_sv(*__chs); StradaValue *__chn = " . $rt_fn . "_sv(__che); strada_decref(__che); StradaValue *__cho = *__chs; *__chs = __chn; strada_decref(__cho); } } ");
        if ($cha_cl == 1) { emit($cg, "strada_decref(__cha); "); }
        emit($cg, "STRADA_MAKE_TAGGED_INT(0); })");
        return;
    }
    if ($tt == NODE_VARIABLE() && $arg0->{"sigil"} eq "$" && $arg0->{"name"} ne "__program_name") {
