                        }
                    } else {
                        emit($cg, "if (!__sp_p" . $fp . ") { __sp_p" . $fp . " = strada_undef_static(); } ");
                    }
                }
                if ($is_dynamic_call == 1) {
                    emit($cg, "int __prev_ctx = strada_wantarray() ? 1 : (strada_wanthash() ? 2 : 0); strada_set_call_context(" . $dyn_ctx . "); ");
                }
                if ($cg->{"enable_stack_trace"} == 1) {
                    my int $__cl_linesp = $expr->{"line"} + 0;
                    if ($__cl_linesp > 0) {
                        emit($cg, "strada_stack_line_il(" . $__cl_linesp . "); ");
                    }
                }
                if ($returns_void == 0) {
                    emit($cg, "StradaValue *__va_result = ");
                }
                emit($cg, $c_name . "(");
                for (my int $fp2 = 0; $fp2 < $fpc; $fp2 = $fp2 + 1) {
