            }

            if ($is_dynamic_call == 1) {
                emit($cg, "int __prev_ctx = strada_wantarray() ? 1 : (strada_wanthash() ? 2 : 0); strada_set_call_context(" . $dyn_ctx . "); ");
            }
            if ($cg->{"enable_stack_trace"} == 1) {
                my int $__cl_line = $expr->{"line"} + 0;
                if ($__cl_line > 0) {
                    emit($cg, "strada_stack_line_il(" . $__cl_line . "); ");
                }
            }
            if ($returns_void == 0) {
                emit($cg, "StradaValue *__va_result = ");
            }
            emit($cg, $c_name . "(");

            for (my int $f = 0; $f < $va_fixed_count; $f = $f + 1) {
                if ($f > 0) {
                    emit($cg, ", ");
                }
                emit($cg, "__farg" . $f);
            }

            if ($va_fixed_count > 0) {
                emit($cg, ", ");
            }
            emit($cg, "__va_arr); ");

            if ($va_push == 1) {
                emit($cg, "strada_cleanup_pop_decref(__va_arr); ");
            } else {
                emit($cg, "strada_decref(__va_arr); ");
            }
            for (my int $f = $va_fixed_count - 1; $f >= 0; $f = $f - 1) {
                if ($farg_decref[$f] == 1) {
                    if ($va_push == 1) {
                        emit($cg, "strada_cleanup_pop_decref(__farg" . $f . "); ");
                    } else {
                        emit($cg, "strada_decref(__farg" . $f . "); ");
                    }
                }
            }

            if ($is_dynamic_call == 1) {
                emit($cg, "strada_set_call_context(__prev_ctx); ");
            }

            if ($returns_void == 0) {
                emit($cg, "__va_result; })");
            } else {
                emit($cg, "strada_undef_static(); })");
            }
            return;
        }

        # Check if any arguments need temp cleanup or LTR evaluation order
        # (hoist only up to $last_impure_idx when impure args exist)
        my int $needs_temps = 0;
        my int $last_impure_idx = -1;
        my int $check_i = 0;
        while ($check_i < $arg_count) {
            if (needs_temp_cleanup($cg, $args->[$check_i]) == 1 && expr_is_always_tagged_int($cg, $args->[$check_i]) == 0) {
                $needs_temps = 1;
            }
            if (arg_is_trivially_pure($cg, $args->[$check_i]) == 0) {
                $last_impure_idx = $check_i;
            }
            $check_i = $check_i + 1;
        }

        # Also need temps when default parameter values will be emitted
        if ($func_info && $arg_count < $func_info->{"param_count"}) {
            $needs_temps = 1;
            my scalar $cparams = $func_info->{"params"};
            my int $cd_i = $arg_count;
            while ($cd_i < $func_info->{"param_count"}) {
                my scalar $cdp = $cparams->[$cd_i];
                if ($cdp->{"has_default"} == 1 && arg_is_trivially_pure($cg, $cdp->{"default"}) == 0) {
                    $last_impure_idx = $cd_i;
                }
                $cd_i = $cd_i + 1;
            }
        }

        my int $returns_void = 0;
        if ($func_info) {
            my int $ret_type = $func_info->{"return_type"};
            if ($ret_type == TYPE_VOID()) {
                $returns_void = 1;
            }
        }
        if ($needs_temps == 1 || ($arg_count > 1 && $last_impure_idx >= 0)) {

            # Generate block with LTR hoisted temps and cleanup
            emit($cg, "({ ");
            my int $in_try = cleanup_push_useful($cg);
            my int $pushed_count = 0;
            my str $last_pushed = "";
            my array @arg_hoisted = ();
            my array @arg_cleanup = ();
            my int $total_hoisted = 0;
            my int $t = 0;
            while ($t < $arg_count) {
                my int $t_owned = needs_temp_cleanup($cg, $args->[$t]);
                my int $t_tagged = expr_is_always_tagged_int($cg, $args->[$t]);
                my int $do_hoist = 0;
                if ($t_owned == 1 || $t <= $last_impure_idx) {
                    $do_hoist = 1;
                }
                my int $t_cl = 0;
                if ($do_hoist == 1) {
                    emit($cg, "StradaValue *__arg" . $t . " = ");
                    gen_expression($cg, $args->[$t]);
                    emit($cg, "; ");
                    if ($cg->{"cleanup_enabled"} == 1 && $t_tagged == 0) {
                        if ($t_owned == 1) {
                            $t_cl = 1;
                        } elsif ($t < $last_impure_idx) {
                            emit($cg, "strada_incref(__arg" . $t . "); ");
                            $t_cl = 1;
                        }
                        if ($t_cl == 1 && $in_try > 0) {
                            emit($cg, "strada_cleanup_push(__arg" . $t . "); ");
                            $pushed_count = $pushed_count + 1;
                            $last_pushed = "__arg" . $t;
                        }
                    }
                }
                push(@arg_hoisted, $do_hoist);
                push(@arg_cleanup, $t_cl);
                $total_hoisted = $total_hoisted + 1;
                $t = $t + 1;
            }
            # Declare temps for default parameter values (positions beyond provided args)
            if ($func_info) {
                my int $param_count = $func_info->{"param_count"};
                my scalar $params = $func_info->{"params"};
                my int $dt = $arg_count;
                while ($dt < $param_count) {
                    my scalar $dparam = $params->[$dt];
                    my int $d_owned = 1;
                    my int $d_tagged = 0;
                    emit($cg, "StradaValue *__arg" . $dt . " = ");
                    if ($dparam->{"has_default"} == 1) {
                        $d_owned = needs_temp_cleanup($cg, $dparam->{"default"});
                        $d_tagged = expr_is_always_tagged_int($cg, $dparam->{"default"});
                        gen_expression($cg, $dparam->{"default"});
                    } else {
                        emit($cg, "strada_new_undef()");
                    }
                    emit($cg, "; ");
                    my int $d_cl = 0;
                    if ($cg->{"cleanup_enabled"} == 1 && $d_tagged == 0) {
                        if ($d_owned == 1) {
                            $d_cl = 1;
                        } elsif ($dt < $last_impure_idx) {
                            emit($cg, "strada_incref(__arg" . $dt . "); ");
                            $d_cl = 1;
                        }
                        if ($d_cl == 1 && $in_try > 0) {
                            emit($cg, "strada_cleanup_push(__arg" . $dt . "); ");
                            $pushed_count = $pushed_count + 1;
                            $last_pushed = "__arg" . $dt;
                        }
                    }
                    push(@arg_hoisted, 1);
                    push(@arg_cleanup, $d_cl);
                    $total_hoisted = $total_hoisted + 1;
                    $dt = $dt + 1;
                }
            }
            # Emit the function call, storing result if not void
            if ($is_dynamic_call == 1) {
                emit($cg, "int __prev_ctx = strada_wantarray() ? 1 : (strada_wanthash() ? 2 : 0); strada_set_call_context(" . $dyn_ctx . "); ");
            }
            # Stash call-site line for caller() — see comment above.
            if ($cg->{"enable_stack_trace"} == 1) {
                my int $__cl_line2 = $expr->{"line"} + 0;
                if ($__cl_line2 > 0) {
                    emit($cg, "strada_stack_line_il(" . $__cl_line2 . "); ");
                }
            }
            if ($returns_void == 0) {
                emit($cg, "StradaValue *__call_result = ");
            }
            emit($cg, $c_name . "(");
            for (my int $i = 0; $i < $total_hoisted; $i = $i + 1) {
                if ($i > 0) {
                    emit($cg, ", ");
                }
                if ($arg_hoisted[$i] == 1) {
                    emit($cg, "__arg" . $i);
                } else {
                    gen_expression($cg, $args->[$i]);
                }
            }
            emit($cg, "); ");
            if ($in_try > 0) {
                if ($pushed_count == 1) {
                    emit($cg, "strada_cleanup_pop_decref(" . $last_pushed . "); ");
                } elsif ($pushed_count > 1) {
                    emit($cg, "strada_cleanup_pop_decref_n(" . $pushed_count . "); ");
                }
            } else {
                my int $d = $total_hoisted - 1;
                while ($d >= 0) {
                    if ($arg_cleanup[$d] == 1) {
                        emit($cg, "strada_decref(__arg" . $d . "); ");
                    }
                    $d = $d - 1;
                }
            }
            if ($is_dynamic_call == 1) {
                emit($cg, "strada_set_call_context(__prev_ctx); ");
            }
            # Return result if not void
            if ($returns_void == 0) {
                emit($cg, "__call_result; })");
            } else {
                emit($cg, "strada_undef_static(); })");
            }
        } else {
            # No temps needed, simple call
            if ($is_dynamic_call == 1) {
                if ($returns_void == 0) {
                    emit($cg, "({ int __prev_ctx = strada_wantarray() ? 1 : (strada_wanthash() ? 2 : 0); strada_set_call_context(" . $dyn_ctx . "); StradaValue *__dyn_r = ");
                } else {
                    emit($cg, "({ int __prev_ctx = strada_wantarray() ? 1 : (strada_wanthash() ? 2 : 0); strada_set_call_context(" . $dyn_ctx . "); ");
                }
            } elsif ($returns_void == 1) {
                emit($cg, "(");
            }
            # Stash call-site line for caller() — see comment above.
            # Wrap the call in a comma expression so this stays an
            # expression at any nesting level (statement, my-init,
            # sort key, etc.). strada_stack_set_line returns void so
            # use comma operator with sequenced cast to (void).
            if ($cg->{"enable_stack_trace"} == 1) {
                my int $__cl_line3 = $expr->{"line"} + 0;
                if ($__cl_line3 > 0) {
                    emit($cg, "(strada_stack_line_il(" . $__cl_line3 . "), ");
                }
            }
            emit($cg, $c_name . "(");
            if ($func_info) {
                my int $param_count = $func_info->{"param_count"};
                my scalar $params = $func_info->{"params"};
                my int $i = 0;
                while ($i < $param_count) {
                    if ($i > 0) {
                        emit($cg, ", ");
                    }
                    if ($i < $arg_count) {
                        gen_expression($cg, $args->[$i]);
                    } else {
                        my scalar $param = $params->[$i];
                        if ($param->{"has_default"} == 1) {
                            gen_expression($cg, $param->{"default"});
                        } else {
                            emit($cg, "strada_new_undef()");
                        }
                    }
                    $i = $i + 1;
                }
            } else {
                my int $i = 0;
                while ($i < $arg_count) {
                    if ($i > 0) {
                        emit($cg, ", ");
                    }
                    gen_expression($cg, $args->[$i]);
                    $i = $i + 1;
                }
            }
            emit($cg, ")");
            # Close the comma-expression wrapper from the call-line set. It
            # wraps just the call, so it must close BEFORE the dynamic-call
            # epilogue: closing it after left `(line, f(); ...` unbalanced, and
            # a `dynamic` call in any program with stack traces on (one that
            # mentions try/throw/caller/stack_trace) did not compile.
            if ($cg->{"enable_stack_trace"} == 1) {
                my int $__cl_line3c = $expr->{"line"} + 0;
                if ($__cl_line3c > 0) {
                    emit($cg, ")");
                }
            }
            if ($is_dynamic_call == 1) {
                if ($returns_void == 0) {
                    emit($cg, "; strada_set_call_context(__prev_ctx); __dyn_r; })");
                } else {
                    emit($cg, "; strada_set_call_context(__prev_ctx); strada_undef_static(); })");
                }
            } elsif ($returns_void == 1) {
                emit($cg, ", strada_undef_static())");
            }
        }
        return;
}

