            return 1;
        }
        
        if ($name eq "index") {
            my scalar $args = $expr->{"args"};
            my int $arg_count = $expr->{"arg_count"};
            my scalar $arg0 = $args->[0];
            my scalar $arg1 = $args->[1];
            my int $arg0_needs_cleanup = needs_temp_cleanup($cg, $arg0);
            my int $arg1_needs_cleanup = needs_temp_cleanup($cg, $arg1);
            # Owned operands are held on the cleanup stack while the next one
            # is evaluated (a throwing needle/offset leaked the haystack).
            my int $ix_push = cleanup_push_useful($cg);
            if ($cg->{"cleanup_enabled"} != 1) { $ix_push = 0; }

            if ($arg_count == 3) {
                # 3-argument form: index(string, substring, offset). The
                # StradaValues go straight to strada_index_sv2 (binary-safe,
                # UTF-8-flag-aware: offsets in the unit substr uses).
                emit($cg, "(({ ");
                emit_arg_hold($cg, "__idx_str", $arg0, $arg0_needs_cleanup, $ix_push);
                emit_arg_hold($cg, "__idx_sub", $arg1, $arg1_needs_cleanup, $ix_push);
                emit($cg, "int64_t __idx_off = ");
                emit_int_operand($cg, $args->[2]);
                emit($cg, "; StradaValue *__idx_res = strada_new_int(strada_index_sv2(__idx_str, __idx_sub, __idx_off)); ");
                emit_arg_release($cg, "__idx_sub", $arg1_needs_cleanup, $ix_push);
                emit_arg_release($cg, "__idx_str", $arg0_needs_cleanup, $ix_push);
                emit($cg, "__idx_res; }))");
            } elsif ($arg1->{"type"} == NODE_STR_LITERAL() && str_has_nul($arg1->{"value"}) == 0) {
                # Fast path: literal needle without embedded NUL
                my str $needle_lit = $arg1->{"value"};
                if ($arg0_needs_cleanup == 1) {
                    my int $ix1_push = 0;
                    if ($ix_push == 1 && $cg->{"has_overloads"} != 0) { $ix1_push = 1; }
                    emit($cg, "(({ ");
                    emit_arg_hold($cg, "__idx_str", $arg0, 1, $ix1_push);
                    emit($cg, "StradaValue *__idx_res = strada_new_int(strada_index_sv(__idx_str, ");
                    gen_str_literal_c($cg, $needle_lit);
                    emit($cg, ")); ");
                    emit_arg_release($cg, "__idx_str", 1, $ix1_push);
                    emit($cg, "__idx_res; }))");
                } else {
                    emit($cg, "strada_new_int(strada_index_sv(");
                    gen_expression($cg, $arg0);
                    emit($cg, ", ");
                    gen_str_literal_c($cg, $needle_lit);
                    emit($cg, "))");
                }
            } else {
                emit($cg, "(({ ");
                emit_arg_hold($cg, "__idx_str", $arg0, $arg0_needs_cleanup, $ix_push);
                emit_arg_hold($cg, "__idx_sub", $arg1, $arg1_needs_cleanup, $ix_push);
                emit($cg, "StradaValue *__idx_res = strada_new_int(strada_index_sv2(__idx_str, __idx_sub, 0)); ");
                emit_arg_release($cg, "__idx_sub", $arg1_needs_cleanup, $ix_push);
                emit_arg_release($cg, "__idx_str", $arg0_needs_cleanup, $ix_push);
                emit($cg, "__idx_res; }))");
            }
            return 1;
        }

        if ($name eq "byte_index" || $name eq "sys::byte_index") {
            my scalar $args = $expr->{"args"};
            my int $arg_count = $expr->{"arg_count"};
            my scalar $arg0 = $args->[0];
            my scalar $arg1 = $args->[1];
            my int $arg0_needs_cleanup = needs_temp_cleanup($cg, $arg0);
            my int $arg1_needs_cleanup = needs_temp_cleanup($cg, $arg1);

            emit($cg, "(({ StradaValue *__bidx_str = ");
            gen_expression($cg, $arg0);
            my int $pdbidxstr = 0;
            if (($arg0_needs_cleanup) == 1 && cleanup_push_useful($cg) == 1) { $pdbidxstr = 1; emit($cg, "; strada_cleanup_push(__bidx_str)"); }
            emit($cg, "; StradaValue *__bidx_sub = ");
            gen_expression($cg, $arg1);
            my int $pdbidxsub = 0;
            if (($arg1_needs_cleanup) == 1 && cleanup_push_useful($cg) == 1) { $pdbidxsub = 1; emit($cg, "; strada_cleanup_push(__bidx_sub)"); }
            emit($cg, "; StradaValue *__bidx_res = strada_new_int(strada_byte_index(__bidx_str, __bidx_sub, ");
            if ($arg_count >= 3) {
                emit_int_operand($cg, $args->[2]);
            } else {
                emit($cg, "0");
            }
            emit($cg, ")); ");
            if ($arg0_needs_cleanup == 1) {
                emit($cg, "" . cleanup_pd_str($pdbidxstr, "__bidx_str") . "");
            }
            if ($arg1_needs_cleanup == 1) {
                emit($cg, "" . cleanup_pd_str($pdbidxsub, "__bidx_sub") . "");
            }
            emit($cg, "__bidx_res; }))");
            return 1;
        }

        if ($name eq "rindex") {
            my scalar $args = $expr->{"args"};
            my int $arg_count = $expr->{"arg_count"};
            my scalar $arg0 = $args->[0];
            my scalar $arg1 = $args->[1];
            my int $r_push = cleanup_push_useful($cg);
            my int $arg0_needs_cleanup = 0;
            my int $arg1_needs_cleanup = 0;
            if ($cg->{"cleanup_enabled"} == 1) {
                $arg0_needs_cleanup = needs_temp_cleanup($cg, $arg0);
                $arg1_needs_cleanup = needs_temp_cleanup($cg, $arg1);
            }

            emit($cg, "(({ StradaValue *__ridx_str = ");
            gen_expression($cg, $arg0);
            emit($cg, "; ");
            if ($r_push == 1 && $arg0_needs_cleanup == 1) { emit($cg, "strada_cleanup_push(__ridx_str); "); }
            emit($cg, "StradaValue *__ridx_sub = ");
            gen_expression($cg, $arg1);
            emit($cg, "; ");
            if ($r_push == 1 && $arg1_needs_cleanup == 1) { emit($cg, "strada_cleanup_push(__ridx_sub); "); }
            if ($arg_count >= 3) {
                emit($cg, "int64_t __ridx_pos = (int64_t)(");
                emit_int_operand($cg, $args->[2]);
                emit($cg, "); StradaValue *__ridx_res = strada_new_int(strada_rindex_sv(__ridx_str, __ridx_sub, __ridx_pos, 1)); ");
            } else {
                emit($cg, "StradaValue *__ridx_res = strada_new_int(strada_rindex_sv(__ridx_str, __ridx_sub, 0, 0)); ");
            }
            if ($arg1_needs_cleanup == 1) {
                if ($r_push == 1) { emit($cg, "strada_cleanup_pop_decref(__ridx_sub); "); }
                else { emit($cg, "strada_decref(__ridx_sub); "); }
            }
            if ($arg0_needs_cleanup == 1) {
                if ($r_push == 1) { emit($cg, "strada_cleanup_pop_decref(__ridx_str); "); }
                else { emit($cg, "strada_decref(__ridx_str); "); }
            }
            emit($cg, "__ridx_res; }))");
            return 1;
        }

        if ($name eq "sprintf" || $name eq "sys::sprintf") {
            # sprintf needs to capture and cleanup all argument temps.
            # Accept both bare "sprintf" and namespaced "sys::sprintf"
            # (the latter is what core::sprintf normalizes to).
            my scalar $args = $expr->{"args"};
            my int $arg_count = $expr->{"arg_count"};
            if ($arg_count == 0) {
                emit($cg, "strada_new_str(\"\")");
                return 1;
            }

            my int $spf_flat = 0;
            my int $spfi = 1;
            while ($spfi < $arg_count) {
                if (list_arg_flattens($cg, $args->[$spfi]) == 1) { $spf_flat = 1; }
                $spfi = $spfi + 1;
            }
            if ($spf_flat == 1) {
                # sprintf(FMT, @list): array values flatten into the argument
                # list (an @array variable is a reference at run time, so this
                # has to be decided here).
                my int $sfp = cleanup_push_useful($cg);
                my int $sf_fmt_cl = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $args->[0]) == 1;
                emit($cg, "({ StradaValue *__spf_fmt = ");
                gen_expression($cg, $args->[0]);
                emit($cg, "; ");
                if ($sf_fmt_cl == 1 && $sfp == 1) { emit($cg, "strada_cleanup_push(__spf_fmt); "); }
                emit($cg, "StradaValue *__spf_args = strada_new_array(); ");
                if ($sfp == 1) { emit($cg, "strada_cleanup_push(__spf_args); "); }
                $spfi = 1;
                while ($spfi < $arg_count) {
                    emit_list_elem_append($cg, "__spf_args->value.av", $args->[$spfi], $sfp);
                    $spfi = $spfi + 1;
                }
                emit($cg, "StradaValue *__spf_res = strada_sprintf_sv_arr(__spf_fmt, __spf_args); ");
                if ($sfp == 1) { emit($cg, "strada_cleanup_pop_decref(__spf_args); "); }
                else { emit($cg, "strada_decref(__spf_args); "); }
                if ($sf_fmt_cl == 1) {
                    if ($sfp == 1) { emit($cg, "strada_cleanup_pop_decref(__spf_fmt); "); }
                    else { emit($cg, "strada_decref(__spf_fmt); "); }
                }
                emit($cg, "__spf_res; })");
                return 1;
            }

            emit($cg, "(({ ");

            # Generate temp vars for each argument and push owned-temps
            # to the cleanup stack so a throwing stringify overload
            # (dispatched inside strada_sprintf_sv) doesn't leak the
            # prior args.
            my int $i = 0;
            while ($i < $arg_count) {
                emit($cg, "StradaValue *__sprintf_arg" . $i . " = ");
                gen_expression($cg, $args->[$i]);
                emit($cg, "; ");
                if (needs_temp_cleanup($cg, $args->[$i]) == 1) {
                    emit($cg, "strada_cleanup_push(__sprintf_arg" . $i . "); ");
                }
                $i = $i + 1;
            }

            # Call sprintf_sv with the temp vars
            emit($cg, "StradaValue *__sprintf_res = strada_sprintf_sv(__sprintf_arg0, " . ($arg_count - 1));
            $i = 1;
            while ($i < $arg_count) {
                emit($cg, ", __sprintf_arg" . $i);
                $i = $i + 1;
            }
            emit($cg, "); ");

            # Pop pushed args (reverse order) then decref.
            $i = $arg_count - 1;
            while ($i >= 0) {
                if (needs_temp_cleanup($cg, $args->[$i]) == 1) {
                    emit($cg, "strada_cleanup_pop(); ");
                }
                $i = $i - 1;
            }
            $i = 0;
            while ($i < $arg_count) {
                if (needs_temp_cleanup($cg, $args->[$i]) == 1) {
                    emit($cg, "strada_decref(__sprintf_arg" . $i . "); ");
                }
                $i = $i + 1;
            }

            emit($cg, "__sprintf_res; }))");
            return 1;
        }
        
        if ($name eq "printf") {
            # printf([FH,] FORMAT, LIST): flatten every argument (array values
            # contribute their elements) and let the runtime decide whether
            # the first one is a filehandle (it used to be printed to stdout
            # as FILEHANDLE(0x...)).
            my scalar $args = $expr->{"args"};
            my int $argc = $expr->{"arg_count"};
            if ($argc == 0) {
                emit($cg, "((StradaValue*)NULL)");
                return 1;
            }
            my int $pf_push = cleanup_push_useful($cg);
            emit($cg, "({ StradaValue *__pf_all = strada_new_array(); ");
            if ($pf_push == 1) { emit($cg, "strada_cleanup_push(__pf_all); "); }
            my int $i = 0;
            while ($i < $argc) {
                emit_list_elem_append($cg, "__pf_all->value.av", $args->[$i], $pf_push);
                $i = $i + 1;
            }
            emit($cg, "strada_printf_list(__pf_all); ");
            if ($pf_push == 1) { emit($cg, "strada_cleanup_pop_decref(__pf_all); "); }
            else { emit($cg, "strada_decref(__pf_all); "); }
            emit($cg, "(StradaValue*)NULL; })");
            return 1;
        }
        
        if ($name eq "warn") {
            my scalar $args = $expr->{"args"};
            my int $argc = $expr->{"arg_count"};
            my scalar $arg = $args->[0];
            my int $wn_push = cleanup_push_useful($cg);
            if ($argc > 1) {
                # Multi-arg warn: concatenate all args before emitting,
                # matching Perl. Previously only args[0] reached the
                # warning output.
                emit($cg, "({ StradaValue *__wn_msg = strada_new_str(\"\"); ");
                if ($wn_push == 1) { emit($cg, "strada_cleanup_push_slot(&__wn_msg); "); }
                my int $wi = 0;
                while ($wi < $argc) {
                    my int $wn_cl = needs_temp_cleanup($cg, $args->[$wi]) == 1;
                    emit($cg, "{ StradaValue *__wn_p = ");
                    gen_expression($cg, $args->[$wi]);
                    emit($cg, "; ");
                    if ($wn_push == 1 && $wn_cl == 1) { emit($cg, "strada_cleanup_push(__wn_p); "); }
                    emit($cg, "StradaValue *__wn_new = strada_concat_sv(__wn_msg, __wn_p); ");
                    if ($wn_push == 1 && $wn_cl == 1) { emit($cg, "strada_cleanup_pop_decref(__wn_p); "); }
                    elsif ($wn_cl == 1) { emit($cg, "strada_decref(__wn_p); "); }
                    emit($cg, "strada_decref(__wn_msg); __wn_msg = __wn_new; } ");
                    $wi = $wi + 1;
                }
                emit($cg, "strada_warn(\"%s\", (__wn_msg && __wn_msg->value.pv) ? __wn_msg->value.pv : \"\"); ");
                if ($wn_push == 1) { emit($cg, "strada_cleanup_pop_decref(__wn_msg); "); }
                else { emit($cg, "strada_decref(__wn_msg); "); }
                emit($cg, "(StradaValue*)NULL; })");
            } else {
                my int $wn_cl = needs_temp_cleanup($cg, $arg) == 1;
                emit($cg, "({ StradaValue *__wn_v = ");
                gen_expression($cg, $arg);
                emit($cg, "; ");
                if ($wn_push == 1 && $wn_cl == 1) { emit($cg, "strada_cleanup_push(__wn_v); "); }
                emit($cg, "StradaValue *__wn_sv = strada_to_str_sv(__wn_v); ");
                if ($wn_push == 1) { emit($cg, "strada_cleanup_push(__wn_sv); "); }
                emit($cg, "strada_warn(\"%s\", (__wn_sv && __wn_sv->value.pv) ? __wn_sv->value.pv : \"\"); ");
                if ($wn_push == 1) { emit($cg, "strada_cleanup_pop_decref(__wn_sv); "); }
                else { emit($cg, "strada_decref(__wn_sv); "); }
                if ($wn_cl == 1) {
                    if ($wn_push == 1) { emit($cg, "strada_cleanup_pop_decref(__wn_v); "); }
                    else { emit($cg, "strada_decref(__wn_v); "); }
                }
                emit($cg, "(StradaValue*)NULL; })");
            }
            return 1;
        }
        
        if ($name eq "sys::slurp" || $name eq "slurp") {
            my scalar $args = $expr->{"args"};
            my scalar $arg = $args->[0];
            my int $sl_push = cleanup_push_useful($cg);
            my int $sl_cl = needs_temp_cleanup($cg, $arg) == 1;
            emit($cg, "({ StradaValue *__sl_v = ");
            gen_expression($cg, $arg);
            emit($cg, "; ");
            if ($sl_push == 1 && $sl_cl == 1) { emit($cg, "strada_cleanup_push(__sl_v); "); }
            emit($cg, "StradaValue *__sl_sv = strada_to_str_sv(__sl_v); ");
            if ($sl_push == 1) { emit($cg, "strada_cleanup_push(__sl_sv); "); }
            emit($cg, "StradaValue *__sl_r = strada_slurp(strada_path_pv(__sl_sv)); ");
            if ($sl_push == 1) { emit($cg, "strada_cleanup_pop_decref(__sl_sv); "); }
            else { emit($cg, "strada_decref(__sl_sv); "); }
            if ($sl_cl == 1) {
                if ($sl_push == 1) { emit($cg, "strada_cleanup_pop_decref(__sl_v); "); }
                else { emit($cg, "strada_decref(__sl_v); "); }
            }
            emit($cg, "__sl_r; })");
            return 1;
        }

        if ($name eq "sys::slurp_fh") {
            gen_call_with_arg_cleanup($cg, "strada_slurp_fh", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "sys::slurp_fd") {
            gen_call_with_arg_cleanup($cg, "strada_slurp_fd", $expr->{"args"}, 1);
            return 1;
        }

        if ($name eq "sys::spew" || $name eq "spew") {
            my scalar $args = $expr->{"args"};
            my scalar $arg0 = $args->[0];
            my scalar $arg1 = $args->[1];
            my int $sp_push = cleanup_push_useful($cg);
            my int $sp_cl0 = needs_temp_cleanup($cg, $arg0) == 1;
            my int $sp_cl1 = needs_temp_cleanup($cg, $arg1) == 1;
            # Use binary-safe strada_spew_sv for content to handle embedded NULs
            emit($cg, "({ StradaValue *__sp_v0 = ");
            gen_expression($cg, $arg0);
            emit($cg, "; ");
            if ($sp_push == 1 && $sp_cl0 == 1) { emit($cg, "strada_cleanup_push(__sp_v0); "); }
            emit($cg, "StradaValue *__sp_v1 = ");
            gen_expression($cg, $arg1);
            emit($cg, "; ");
            if ($sp_push == 1 && $sp_cl1 == 1) { emit($cg, "strada_cleanup_push(__sp_v1); "); }
            emit($cg, "StradaValue *__sp_s0 = strada_to_str_sv(__sp_v0); ");
            if ($sp_push == 1) { emit($cg, "strada_cleanup_push(__sp_s0); "); }
            emit($cg, "int __sp_rc = strada_spew_sv(strada_path_pv(__sp_s0), __sp_v1); ");
            if ($sp_push == 1) { emit($cg, "strada_cleanup_pop_decref(__sp_s0); "); }
            else { emit($cg, "strada_decref(__sp_s0); "); }
            if ($sp_cl1 == 1) {
                if ($sp_push == 1) { emit($cg, "strada_cleanup_pop_decref(__sp_v1); "); }
                else { emit($cg, "strada_decref(__sp_v1); "); }
            }
            if ($sp_cl0 == 1) {
                if ($sp_push == 1) { emit($cg, "strada_cleanup_pop_decref(__sp_v0); "); }
                else { emit($cg, "strada_decref(__sp_v0); "); }
            }
            emit($cg, "strada_new_int(__sp_rc); })");
            return 1;
        }

        if ($name eq "sys::spew_fh") {
            my scalar $args = $expr->{"args"};
            my scalar $arg0 = $args->[0];
            my scalar $arg1 = $args->[1];
            my int $sp_push = cleanup_push_useful($cg);
            my int $sp_cl0 = needs_temp_cleanup($cg, $arg0) == 1;
            my int $sp_cl1 = needs_temp_cleanup($cg, $arg1) == 1;
            emit($cg, "({ StradaValue *__sp_v0 = ");
            gen_expression($cg, $arg0);
            emit($cg, "; ");
            if ($sp_push == 1 && $sp_cl0 == 1) { emit($cg, "strada_cleanup_push(__sp_v0); "); }
            emit($cg, "StradaValue *__sp_v1 = ");
            gen_expression($cg, $arg1);
            emit($cg, "; ");
            if ($sp_push == 1 && $sp_cl1 == 1) { emit($cg, "strada_cleanup_push(__sp_v1); "); }
            emit($cg, "strada_spew_fh(__sp_v0, __sp_v1); ");
            if ($sp_cl1 == 1) {
                if ($sp_push == 1) { emit($cg, "strada_cleanup_pop_decref(__sp_v1); "); }
                else { emit($cg, "strada_decref(__sp_v1); "); }
            }
            if ($sp_cl0 == 1) {
                if ($sp_push == 1) { emit($cg, "strada_cleanup_pop_decref(__sp_v0); "); }
                else { emit($cg, "strada_decref(__sp_v0); "); }
            }
            emit($cg, "strada_undef_static(); })");
            return 1;
        }

        if ($name eq "sys::spew_fd") {
            my scalar $args = $expr->{"args"};
            my scalar $arg0 = $args->[0];
            my scalar $arg1 = $args->[1];
            my int $sp_push = cleanup_push_useful($cg);
            my int $sp_cl0 = needs_temp_cleanup($cg, $arg0) == 1;
            my int $sp_cl1 = needs_temp_cleanup($cg, $arg1) == 1;
            emit($cg, "({ StradaValue *__sp_v0 = ");
            gen_expression($cg, $arg0);
            emit($cg, "; ");
            if ($sp_push == 1 && $sp_cl0 == 1) { emit($cg, "strada_cleanup_push(__sp_v0); "); }
            emit($cg, "StradaValue *__sp_v1 = ");
            gen_expression($cg, $arg1);
            emit($cg, "; ");
            if ($sp_push == 1 && $sp_cl1 == 1) { emit($cg, "strada_cleanup_push(__sp_v1); "); }
            emit($cg, "strada_spew_fd(__sp_v0, __sp_v1); ");
            if ($sp_cl1 == 1) {
                if ($sp_push == 1) { emit($cg, "strada_cleanup_pop_decref(__sp_v1); "); }
                else { emit($cg, "strada_decref(__sp_v1); "); }
            }
            if ($sp_cl0 == 1) {
                if ($sp_push == 1) { emit($cg, "strada_cleanup_pop_decref(__sp_v0); "); }
                else { emit($cg, "strada_decref(__sp_v0); "); }
            }
            emit($cg, "strada_undef_static(); })");
            return 1;
        }

        # StringBuilder functions for O(1) amortized append
        if ($name eq "sb_new") {
            my scalar $args = $expr->{"args"};
            my int $arg_count = $expr->{"arg_count"};
            if ($arg_count > 0) {
                gen_call_with_arg_cleanup($cg, "strada_sb_new_cap", $args, 1);
            } else {
                emit($cg, "strada_sb_new()");
            }
            return 1;
        }

        if ($name eq "sb_append") {
            my scalar $args = $expr->{"args"};
            my int $sb0_cleanup = needs_temp_cleanup($cg, $args->[0]);
            my int $sba_cleanup = needs_temp_cleanup($cg, $args->[1]);
            if ($sb0_cleanup == 1 || $sba_cleanup == 1) {
                # Both operands are held (the builder on the cleanup stack
                # while the appended value is evaluated, which may throw).
                my int $sba_push = cleanup_push_useful($cg);
                if ($cg->{"cleanup_enabled"} != 1) { $sba_push = 0; }
                emit($cg, "({ ");
                emit_arg_hold($cg, "__sba_sb", $args->[0], $sb0_cleanup, $sba_push);
                emit_arg_hold($cg, "__sba_tmp", $args->[1], $sba_cleanup, $sba_push);
                emit($cg, "strada_sb_append(__sba_sb, __sba_tmp); ");
                emit_arg_release($cg, "__sba_tmp", $sba_cleanup, $sba_push);
                emit_arg_release($cg, "__sba_sb", $sb0_cleanup, $sba_push);
                emit($cg, "strada_undef_static(); })");
            } else {
                emit($cg, "(strada_sb_append(");
                gen_expression($cg, $args->[0]);
                emit($cg, ", ");
                gen_expression($cg, $args->[1]);
                emit($cg, "), strada_undef_static())");
            }
            return 1;
        }
    return 0;
}

func gen_builtin_g5(scalar $cg, scalar $expr, str $name) int {

        if ($name eq "__strong_copy") {
            # Inserted by Semantic in programs that weaken (see
            # sem_strong_copy_walk): an owned strong copy of the value.
            my scalar $sca = $expr->{"args"}->[0];
            emit($cg, "({ StradaValue *__scv = ");
            gen_expression($cg, $sca);
            emit($cg, "; ");
            if (!($cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $sca) == 1)) { emit($cg, "strada_incref(__scv); "); }
            emit($cg, "strada_strong_copy_take(__scv); })");
            return 1;
        }

        if ($name eq "sb_to_string") {
            my scalar $args = $expr->{"args"};
            if (needs_temp_cleanup($cg, $args->[0]) == 1) {
