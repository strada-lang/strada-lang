        # Can rethrow a worker error: owned args ride the cleanup stack
        # so the catch drain reclaims them on throw.
        if ($name eq "async::map") {
            my scalar $mpargs = $expr->{"args"};
            my int $mp_argc = $expr->{"arg_count"};
            my int $mp_fn_owned = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $mpargs->[0]) == 1;
            my int $mp_it_owned = $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $mpargs->[1]) == 1;
            my int $mp_w_owned = 0;
            if ($mp_argc > 2 && $cg->{"cleanup_enabled"} == 1 && needs_temp_cleanup($cg, $mpargs->[2]) == 1) {
                $mp_w_owned = 1;
            }
            my int $mp_push = cleanup_push_useful($cg);
            emit($cg, "({ StradaValue *__mp_fn = ");
            gen_expression($cg, $mpargs->[0]);
            emit($cg, "; ");
            if ($mp_push == 1 && $mp_fn_owned == 1) { emit($cg, "strada_cleanup_push(__mp_fn); "); }
            emit($cg, "StradaValue *__mp_it = ");
            gen_expression($cg, $mpargs->[1]);
            emit($cg, "; ");
            if ($mp_push == 1 && $mp_it_owned == 1) { emit($cg, "strada_cleanup_push(__mp_it); "); }
            if ($mp_argc > 2) {
                emit($cg, "StradaValue *__mp_w = ");
                gen_expression($cg, $mpargs->[2]);
                emit($cg, "; ");
                if ($mp_push == 1 && $mp_w_owned == 1) { emit($cg, "strada_cleanup_push(__mp_w); "); }
                emit($cg, "StradaValue *__mp_r = strada_async_map(__mp_fn, __mp_it, __mp_w); ");
                if ($mp_w_owned == 1) {
                    if ($mp_push == 1) { emit($cg, "strada_cleanup_pop_decref(__mp_w); "); }
                    else { emit($cg, "strada_decref(__mp_w); "); }
                }
            } else {
                emit($cg, "StradaValue *__mp_r = strada_async_map(__mp_fn, __mp_it, NULL); ");
            }
            if ($mp_it_owned == 1) {
                if ($mp_push == 1) { emit($cg, "strada_cleanup_pop_decref(__mp_it); "); }
                else { emit($cg, "strada_decref(__mp_it); "); }
            }
            if ($mp_fn_owned == 1) {
                if ($mp_push == 1) { emit($cg, "strada_cleanup_pop_decref(__mp_fn); "); }
                else { emit($cg, "strada_decref(__mp_fn); "); }
            }
            emit($cg, "__mp_r; })");
            return 1;
        }

        # ===== CHANNEL NAMESPACE FUNCTIONS =====
        if ($name eq "async::channel") {
