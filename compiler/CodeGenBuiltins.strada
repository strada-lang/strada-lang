                    my str $saved_def_pkg = "" . $cg->{"package"};
                    my str $saved_def_fnpkg = "" . $cg->{"current_fn_package"};
                    my int $di = 0;
                    my int $ndf = size(@ctor_def_names);
                    while ($di < $ndf) {
