# Main.strada - Entry point for self-hosting Strada compiler
# This is the main compiler executable

# Deduce the lib root from a source file's `package X::Y;` directive and
# the path it lives at. Returns "" if no package declaration is found or
# the file path doesn't match the package's expected layout.
#
# Example: source declares `package Perla::CodeGen::Eval;` and lives at
# `perla/lib/Perla/CodeGen/Eval.strada` -> lib root `perla/lib`.
# Used in -M mode so submodules don't need explicit -L to resolve their
# `use` statements.
func _deduce_lib_root_from_source(str $source, str $filename) str {
    # Locate the first start-of-line `package ` via index() — char-by-char
    # scanning was O(N) per character and timed out on large concatenated
    # .strada files (e.g. lib/Eval.strada is 15K lines, package is at line
    # 9K — would scan ~470K chars × per-char substr() allocations).
    my int $slen = length($source);
    # Special-case: file starts with `package ` (no leading newline).
    my int $pkg_decl_start = -1;
    if ($slen >= 8 && substr($source, 0, 8) eq "package ") {
        $pkg_decl_start = 0;
    } else {
        my int $nl_idx = index($source, "\npackage ");
        if ($nl_idx >= 0) { $pkg_decl_start = $nl_idx + 1; }
    }
    if ($pkg_decl_start < 0) { return ""; }
    # Skip past "package " and any extra whitespace.
    my int $j = $pkg_decl_start + 8;
    while ($j < $slen && (substr($source, $j, 1) eq " " || substr($source, $j, 1) eq "\t")) {
        $j = $j + 1;
    }
    my int $pstart = $j;
    while ($j < $slen) {
        my str $ch = substr($source, $j, 1);
        if (($ch ge "a" && $ch le "z") || ($ch ge "A" && $ch le "Z")
            || ($ch ge "0" && $ch le "9") || $ch eq "_" || $ch eq ":") {
            $j = $j + 1;
        } else { last; }
    }
    my str $pkg_name = "";
    if ($j > $pstart) {
        $pkg_name = substr($source, $pstart, $j - $pstart);
    }
    if (length($pkg_name) == 0) { return ""; }
    # Convert `X::Y::Z` to relative path `X/Y/Z.strada`.
    my str $rel = "";
    my int $pi = 0;
    my int $plen = length($pkg_name);
    while ($pi < $plen) {
        my str $pc = substr($pkg_name, $pi, 1);
        if ($pc eq ":" && $pi + 1 < $plen && substr($pkg_name, $pi + 1, 1) eq ":") {
            $rel = $rel . "/";
            $pi = $pi + 2;
        } else {
            $rel = $rel . $pc;
            $pi = $pi + 1;
        }
    }
    $rel = $rel . ".strada";
    # Does $filename end with $rel (preceded by `/` so we don't match
    # a path that just happens to share a tail)?
    my int $fnlen = length($filename);
    my int $rellen = length($rel);
    if ($fnlen < $rellen) { return ""; }
    my int $suffix_start = $fnlen - $rellen;
    if (substr($filename, $suffix_start, $rellen) ne $rel) { return ""; }
    # filename is exactly $rel — lib_root is cwd
    if ($suffix_start == 0) { return "."; }
    # Boundary: require a `/` right before $rel so we don't match a path
    # whose tail just happens to coincide.
    if (substr($filename, $suffix_start - 1, 1) ne "/") { return ""; }
    # Lib root is the prefix WITHOUT the trailing slash.
    return substr($filename, 0, $suffix_start - 1);
}

# Scan parsed AST (including inlined `use` modules, BEGIN/END blocks, closures,
# and synthesized constructors) to determine whether full stack-trace / line
# tracking (mode 1) is needed vs lightweight recursion-depth guard (mode 2).
func ast_call_needs_stack_trace(str $cname) int {
    if ($cname eq "caller" || $cname eq "core::caller" || $cname eq "sys::caller") { return 1; }
    if ($cname eq "stack_trace" || $cname eq "core::stack_trace" || $cname eq "sys::stack_trace") { return 1; }
    if ($cname eq "stacktrace" || $cname eq "core::stacktrace" || $cname eq "sys::stacktrace") { return 1; }
    if ($cname eq "stacktrace_str" || $cname eq "core::stacktrace_str" || $cname eq "sys::stacktrace_str") { return 1; }
    if ($cname eq "exception_trace" || $cname eq "core::exception_trace" || $cname eq "sys::exception_trace") { return 1; }
    if ($cname eq "throw" || $cname eq "core::throw" || $cname eq "sys::throw") { return 1; }
    if ($cname eq "coro_create" || $cname eq "core::coro_create" || $cname eq "sys::coro_create") { return 1; }
    return 0;
}

func ast_expr_needs_stack_trace(scalar $expr) int {
    if (is_valid_node($expr) == 0) { return 0; }
    my int $t = $expr->{"type"};
    if ($t == NODE_CALL()) {
        if ($expr->{"is_constant"} != 1 && ast_call_needs_stack_trace("" . $expr->{"name"}) == 1) {
            return 1;
        }
        my scalar $args = $expr->{"args"};
        my int $ac = $expr->{"arg_count"} + 0;
        my int $i = 0;
        while ($i < $ac) {
            if (ast_expr_needs_stack_trace($args->[$i]) == 1) { return 1; }
            $i = $i + 1;
        }
        return 0;
    }
    if ($t == NODE_BINARY_OP()) {
        if (ast_expr_needs_stack_trace($expr->{"left"}) == 1) { return 1; }
        return ast_expr_needs_stack_trace($expr->{"right"});
    }
    if ($t == NODE_UNARY_OP() || $t == NODE_INCREMENT()) {
        return ast_expr_needs_stack_trace($expr->{"operand"});
    }
    if ($t == NODE_TERNARY()) {
        if (ast_expr_needs_stack_trace($expr->{"condition"}) == 1) { return 1; }
        if (ast_expr_needs_stack_trace($expr->{"true_expr"}) == 1) { return 1; }
        return ast_expr_needs_stack_trace($expr->{"false_expr"});
    }
    if ($t == NODE_ASSIGN()) {
        if (ast_expr_needs_stack_trace($expr->{"target"}) == 1) { return 1; }
        return ast_expr_needs_stack_trace($expr->{"value"});
    }
    if ($t == NODE_METHOD_CALL()) {
        if (ast_expr_needs_stack_trace($expr->{"object"}) == 1) { return 1; }
        my scalar $args = $expr->{"args"};
        my int $ac = $expr->{"arg_count"} + 0;
        my int $i = 0;
        while ($i < $ac) {
            if (ast_expr_needs_stack_trace($args->[$i]) == 1) { return 1; }
            $i = $i + 1;
        }
        return 0;
    }
    if ($t == NODE_DYN_METHOD_CALL()) {
        if (ast_expr_needs_stack_trace($expr->{"base_object"}) == 1) { return 1; }
        if (ast_expr_needs_stack_trace($expr->{"method_expr"}) == 1) { return 1; }
        my scalar $args = $expr->{"args"};
        my int $ac = $expr->{"arg_count"} + 0;
        my int $i = 0;
        while ($i < $ac) {
            if (ast_expr_needs_stack_trace($args->[$i]) == 1) { return 1; }
            $i = $i + 1;
        }
        return 0;
    }
    if ($t == NODE_SUPER_CALL()) {
        my scalar $args = $expr->{"args"};
        my int $ac = $expr->{"arg_count"} + 0;
        my int $i = 0;
        while ($i < $ac) {
            if (ast_expr_needs_stack_trace($args->[$i]) == 1) { return 1; }
            $i = $i + 1;
        }
        return 0;
    }
    if ($t == NODE_CLOSURE_CALL()) {
        if (ast_expr_needs_stack_trace($expr->{"closure"}) == 1) { return 1; }
        my scalar $args = $expr->{"args"};
        my int $ac = $expr->{"arg_count"} + 0;
        my int $i = 0;
        while ($i < $ac) {
            if (ast_expr_needs_stack_trace($args->[$i]) == 1) { return 1; }
            $i = $i + 1;
        }
        return 0;
    }
    if ($t == NODE_ANON_FUNC()) {
        return ast_stmt_needs_stack_trace($expr->{"body"});
    }
    if ($t == NODE_DO_EXPR()) {
        return ast_stmt_needs_stack_trace($expr->{"block"});
    }
    if ($t == NODE_MAP() || $t == NODE_GREP() || $t == NODE_SORT()) {
        if (ast_expr_needs_stack_trace($expr->{"array"}) == 1) { return 1; }
        return ast_stmt_needs_stack_trace($expr->{"block"});
    }
    if ($t == NODE_ANON_ARRAY()) {
        my scalar $elems = $expr->{"elements"};
        my int $ec = $expr->{"element_count"} + 0;
        my int $i = 0;
        while ($i < $ec) {
            if (ast_expr_needs_stack_trace($elems->[$i]) == 1) { return 1; }
            $i = $i + 1;
        }
        return 0;
    }
    if ($t == NODE_ANON_HASH()) {
        my scalar $kexprs = $expr->{"key_exprs"};
        my scalar $vals = $expr->{"values"};
        my int $pc = $expr->{"pair_count"} + 0;
        my int $i = 0;
        while ($i < $pc) {
            if (ast_expr_needs_stack_trace($kexprs->[$i]) == 1) { return 1; }
            if (ast_expr_needs_stack_trace($vals->[$i]) == 1) { return 1; }
            $i = $i + 1;
        }
        return 0;
    }
    if ($t == NODE_SUBSCRIPT()) {
        if (ast_expr_needs_stack_trace($expr->{"array"}) == 1) { return 1; }
        return ast_expr_needs_stack_trace($expr->{"index"});
    }
    if ($t == NODE_HASH_ACCESS()) {
        if (ast_expr_needs_stack_trace($expr->{"hash"}) == 1) { return 1; }
        return ast_expr_needs_stack_trace($expr->{"key"});
    }
    if ($t == NODE_ARRAY_SLICE() || $t == NODE_HASH_SLICE()) {
        if (ast_expr_needs_stack_trace($expr->{"source"}) == 1) { return 1; }
        my scalar $items = $expr->{"items"};
        my int $ic = $expr->{"item_count"} + 0;
        my int $i = 0;
        while ($i < $ic) {
            if (ast_expr_needs_stack_trace($items->[$i]) == 1) { return 1; }
            $i = $i + 1;
        }
        return 0;
    }
    if ($t == NODE_DEREF_SCALAR() || $t == NODE_DEREF_ARRAY() || $t == NODE_DEREF_HASH()) {
        if (ast_expr_needs_stack_trace($expr->{"ref"}) == 1) { return 1; }
        if ($t == NODE_DEREF_ARRAY()) { return ast_expr_needs_stack_trace($expr->{"index"}); }
        if ($t == NODE_DEREF_HASH()) { return ast_expr_needs_stack_trace($expr->{"key"}); }
        return 0;
    }
    if ($t == NODE_FIELD_ACCESS()) {
        return ast_expr_needs_stack_trace($expr->{"object"});
    }
    if ($t == NODE_REF() || $t == NODE_SPREAD()) {
        return ast_expr_needs_stack_trace($expr->{"target"});
    }
    if ($t == NODE_RANGE()) {
        if (ast_expr_needs_stack_trace($expr->{"start"}) == 1) { return 1; }
        return ast_expr_needs_stack_trace($expr->{"end"});
    }
    if ($t == NODE_AWAIT()) {
        return ast_expr_needs_stack_trace($expr->{"expr"});
    }
    if ($t == NODE_REGEX_MATCH() || $t == NODE_TR()) {
        return ast_expr_needs_stack_trace($expr->{"target"});
    }
    if ($t == NODE_REGEX_SUBST()) {
        if (ast_expr_needs_stack_trace($expr->{"target"}) == 1) { return 1; }
        return ast_expr_needs_stack_trace($expr->{"eval_expr"});
    }
    return 0;
}

func ast_stmt_needs_stack_trace(scalar $stmt) int {
    if (is_valid_node($stmt) == 0) { return 0; }
    my int $t = $stmt->{"type"};
    if ($t == NODE_TRY_CATCH() || $t == NODE_THROW()) { return 1; }
    if ($t == NODE_BLOCK()) {
        my scalar $stmts = $stmt->{"statements"};
        my int $sc = $stmt->{"statement_count"} + 0;
        my int $i = 0;
        while ($i < $sc) {
            if (ast_stmt_needs_stack_trace($stmts->[$i]) == 1) { return 1; }
            $i = $i + 1;
        }
        return 0;
    }
    if ($t == NODE_IF_STMT()) {
        if (ast_expr_needs_stack_trace($stmt->{"condition"}) == 1) { return 1; }
        if (ast_stmt_needs_stack_trace($stmt->{"then_block"}) == 1) { return 1; }
        my scalar $ec = $stmt->{"elsif_conditions"};
        my scalar $eb = $stmt->{"elsif_blocks"};
        my int $en = $stmt->{"elsif_count"} + 0;
        my int $i = 0;
        while ($i < $en) {
            if (ast_expr_needs_stack_trace($ec->[$i]) == 1) { return 1; }
            if (ast_stmt_needs_stack_trace($eb->[$i]) == 1) { return 1; }
            $i = $i + 1;
        }
        return ast_stmt_needs_stack_trace($stmt->{"else_block"});
    }
    if ($t == NODE_WHILE_STMT()) {
        my scalar $wc = $stmt->{"condition"};
        if (is_valid_node($wc) == 1 && $wc->{"type"} == NODE_VAR_DECL()) {
            if (ast_stmt_needs_stack_trace($wc) == 1) { return 1; }
        } else {
            if (ast_expr_needs_stack_trace($wc) == 1) { return 1; }
        }
        return ast_stmt_needs_stack_trace($stmt->{"body"});
    }
    if ($t == NODE_DO_WHILE_STMT()) {
        if (ast_stmt_needs_stack_trace($stmt->{"body"}) == 1) { return 1; }
        return ast_expr_needs_stack_trace($stmt->{"condition"});
    }
    if ($t == NODE_FOR_STMT()) {
        my scalar $fi = $stmt->{"init"};
        if (is_valid_node($fi) == 1) {
            if ($fi->{"type"} == NODE_VAR_DECL()) {
                if (ast_stmt_needs_stack_trace($fi) == 1) { return 1; }
            } else {
                if (ast_expr_needs_stack_trace($fi) == 1) { return 1; }
            }
        }
        if (ast_expr_needs_stack_trace($stmt->{"condition"}) == 1) { return 1; }
        if (ast_expr_needs_stack_trace($stmt->{"update"}) == 1) { return 1; }
        return ast_stmt_needs_stack_trace($stmt->{"body"});
    }
    if ($t == NODE_FOREACH_STMT()) {
        if (ast_expr_needs_stack_trace($stmt->{"array"}) == 1) { return 1; }
        return ast_stmt_needs_stack_trace($stmt->{"body"});
    }
    if ($t == NODE_SWITCH()) {
        if (ast_expr_needs_stack_trace($stmt->{"expr"}) == 1) { return 1; }
        my scalar $cases = $stmt->{"cases"};
        my scalar $blocks = $stmt->{"blocks"};
        my int $cc = $stmt->{"case_count"} + 0;
        my int $i = 0;
        while ($i < $cc) {
            if (ast_expr_needs_stack_trace($cases->[$i]) == 1) { return 1; }
            if (ast_stmt_needs_stack_trace($blocks->[$i]) == 1) { return 1; }
            $i = $i + 1;
        }
        if ($stmt->{"has_default"} == 1) {
            return ast_stmt_needs_stack_trace($stmt->{"default_block"});
        }
        return 0;
    }
    if ($t == NODE_RETURN_STMT()) {
        return ast_expr_needs_stack_trace($stmt->{"value"});
    }
    if ($t == NODE_EXPR_STMT()) {
        return ast_expr_needs_stack_trace($stmt->{"expr"});
    }
    if ($t == NODE_VAR_DECL() || $t == NODE_CONST_DECL() || $t == NODE_OUR_DECL() ||
        $t == NODE_LOCAL_DECL() || $t == NODE_DESTRUCTURE()) {
        if (ast_expr_needs_stack_trace($stmt->{"initial_capacity"}) == 1) { return 1; }
        if (ast_expr_needs_stack_trace($stmt->{"hash_key"}) == 1) { return 1; }
        return ast_expr_needs_stack_trace($stmt->{"init"});
    }
    return 0;
}

func ast_needs_stack_trace(scalar $ast) int {
    my scalar $funcs = $ast->{"functions"};
    my int $fc = $ast->{"function_count"} + 0;
    my int $i = 0;
    while ($i < $fc) {
        my scalar $fn = $funcs->[$i];
        my scalar $params = $fn->{"params"};
        my int $pc = $fn->{"param_count"} + 0;
        my int $pi = 0;
        while ($pi < $pc) {
            my scalar $prm = $params->[$pi];
            if ($prm->{"has_default"} == 1) {
                if (ast_expr_needs_stack_trace($prm->{"default"}) == 1) { return 1; }
            }
            $pi = $pi + 1;
        }
        if (ast_stmt_needs_stack_trace($fn->{"body"}) == 1) { return 1; }
        $i = $i + 1;
    }
    my scalar $globals = $ast->{"globals"};
    my int $gc = $ast->{"global_count"} + 0;
    $i = 0;
    while ($i < $gc) {
        if (ast_stmt_needs_stack_trace($globals->[$i]) == 1) { return 1; }
        $i = $i + 1;
    }
    my scalar $begins = $ast->{"begin_blocks"};
    my int $bc = $ast->{"begin_block_count"} + 0;
    $i = 0;
    while ($i < $bc) {
        if (ast_stmt_needs_stack_trace($begins->[$i]) == 1) { return 1; }
        $i = $i + 1;
    }
    my scalar $ends = $ast->{"end_blocks"};
    my int $ec = $ast->{"end_block_count"} + 0;
    $i = 0;
    while ($i < $ec) {
        if (ast_stmt_needs_stack_trace($ends->[$i]) == 1) { return 1; }
        $i = $i + 1;
    }
    my scalar $mms = $ast->{"method_modifiers"};
    my int $mc = $ast->{"method_modifier_count"} + 0;
    $i = 0;
    while ($i < $mc) {
        if (ast_stmt_needs_stack_trace($mms->[$i]->{"body"}) == 1) { return 1; }
        $i = $i + 1;
    }
    return 0;
}

func compile(str $source, str $filename, int $debug_info, int $show_timing, int $show_warnings, int $strict_types, int $enable_profiling, int $enable_stack_trace, int $full_profile, scalar $lib_paths, scalar $lib_paths_low, scalar $implicit_objs, scalar $implicit_archs, scalar $implicit_libs, int $module_only_mode, str $module_target, int $check_only, scalar $pp_defines, str $output_file, int $verbose, str $split_dir) str {
    my num $t0 = 0.0;
    my num $t1 = 0.0;

    # In `-M` mode (precompiling a single .strada module), auto-deduce a
    # default lib path so cross-package `use Foo::Bar;` resolves to
    # `<lib_root>/Foo/Bar.strada` without the caller having to pass -L
    # explicitly. The deduction: if the source declares `package X::Y;`
    # and the file lives at `.../X/Y.strada` (or `.../X/Y.strada`), then
    # the lib root is the prefix BEFORE that nested directory. Without
    # this, sub-modules built via `strada -M` see empty lib paths and
    # can't resolve their `use` statements — silently falling through to
    # implicit C function declarations whose default `int func()` ABI
    # mismatches the actual `StradaValue *func(StradaValue *)`, causing
    # SIGSEGV at runtime when the implicit-decl call hits a real
    # cross-module function.
    if ($module_only_mode == 1) {
        my str $deduced = _deduce_lib_root_from_source($source, $filename);
        if (length($deduced) > 0) {
            # Append only if not already present (avoid duplicates).
            my int $li = 0;
            my int $lcount = scalar(@{$lib_paths});
            my int $found = 0;
            while ($li < $lcount) {
                if ($lib_paths->[$li] eq $deduced) { $found = 1; last; }
                $li = $li + 1;
            }
            if ($found == 0) {
                push(@{$lib_paths}, $deduced);
            }
        }
    }

    # Tokenize
    $t0 = core::hires_time();
    # -D NAME[=VAL] -> #ifdef/#ifndef defines for this file and its modules
    my scalar $cli_defs = 0;
    if (defined($pp_defines) && size(@{$pp_defines}) > 0) {
        my hash %dh = ();
        my int $pdi = 0;
        while ($pdi < size(@{$pp_defines})) {
            my str $dn = $pp_defines->[$pdi];
            my str $dv = "1";
            my int $deq = index($dn, "=");
            if ($deq > 0) {
                $dv = substr($dn, $deq + 1, length($dn) - $deq - 1);
                $dn = substr($dn, 0, $deq);
            }
            if (length($dn) > 0) { $dh{$dn} = $dv; }
            $pdi = $pdi + 1;
        }
        $cli_defs = \%dh;
    }
    my scalar $tokens = lex_tokenize_file_defs($source, $filename, $cli_defs);
    $t1 = core::hires_time();
    if ($show_timing == 1) {
        say("  Lexer:    " . ($t1 - $t0) . " seconds");
    }

    # Parse (with optional library paths from -L and -LL flags, plus any
    # implicit imports from CLI-passed .o/.a files)
    $t0 = core::hires_time();
    my scalar $ast = parse_with_implicit_imports($tokens, $filename, $lib_paths, $lib_paths_low, $implicit_objs, $implicit_archs, $implicit_libs);
    $ast->{"module_only_mode"} = $module_only_mode;
    $ast->{"module_target"} = $module_target;
    $ast->{"split_dir"} = $split_dir;
    $t1 = core::hires_time();
    if ($show_timing == 1) {
        say("  Parser:   " . ($t1 - $t0) . " seconds");
    }

    # Semantic analysis (validates symbols, types, etc.)
    $t0 = core::hires_time();
    semantic_analyze($ast, $show_warnings, $strict_types);
    $t1 = core::hires_time();
    if ($show_timing == 1) {
        say("  Semantic: " . ($t1 - $t0) . " seconds");
    }

    # Auto-detect stack trace mode from the parsed AST (including `use`d modules!)
    # when not explicitly overridden via --stack-trace / --no-stack-trace:
    # Mode 1 = full stack trace + line numbers; Mode 2 = lightweight recursion-depth
    # guard on non-leaf functions (zero overhead on leaf functions and statements).
    if ($enable_stack_trace == -1) {
        if (ast_needs_stack_trace($ast) == 1) {
            $enable_stack_trace = 1;
        } else {
            $enable_stack_trace = 2;
        }
    }

    # --check: validation only. Clear split_dir so --check never emits shard
    # files, run full codegen validation for semantic/codegen-time errors, and
    # stop before writing C output.
    if ($check_only == 1) {
        $ast->{"split_dir"} = "";
        generate($ast, $filename, 0, 0, $enable_stack_trace, 0);
        if (length(core::getenv("STRADA_CLEAN_EXIT")) == 0) {
            exit(0);
        }
        return "";
    }

    # Generate code (pass debug flag for #line directives, profiling flag, stack trace flag)
    $t0 = core::hires_time();
    my str $code = generate($ast, $filename, $debug_info, $enable_profiling, $enable_stack_trace, $full_profile);
    $t1 = core::hires_time();
    if ($show_timing == 1) {
        say("  CodeGen:  " . ($t1 - $t0) . " seconds");
    }

    if (length($output_file) > 0) {
        spew($output_file, $code);
        if ($verbose == 1) {
            say("Success! Generated " . $output_file);
        }
        if (length(core::getenv("STRADA_CLEAN_EXIT")) == 0) {
            exit(0);
        }
    }

    return $code;
}

func print_usage() void {
    say("Strada Compiler v1.0 (Self-Hosting)");
    say("Usage: stradac [options] <input.strada> <output.c>");
    say("");
    say("Options:");
    say("  -L <path>       Add library search path (high priority, searched first)");
    say("  -LL <path>      Add library search path (low priority, searched last)");
    say("  --import-object <path>   Treat <path> as implicit import_object (full path)");
    say("  --import-archive <path>  Treat <path> as implicit import_archive (full path)");
    say("  --import-lib <path>      Treat <path> as implicit import_lib (.so, dlopen'd at runtime)");
    say("  -M [TARGET]    Module-only codegen: only emit bodies/globals/blocks");
    say("                 for TARGET (default: derived from input filename).");
    say("                 Use after compiling Foo.strada to produce Foo.o.");
    say("  -g, --debug     Emit #line directives for source-level debugging");
    say("  -p, --profile   Enable function profiling (timing and call counts)");
    say("  --full-profile  Enable line-level profiling (writes strada-prof.out)");
    say("  -t, --timing    Show compilation phase timing");
    say("  -w, --warnings  Show warnings (unused variables, etc.)");
    say("  --check         Syntax/semantic check only: no C output is written.");
    say("                  <output.c> may be omitted. Exit 0 if clean.");
    say("  --stack-trace     Force enable stack trace support");
    say("  --no-stack-trace  Force disable stack trace support");
    say("                    (default: auto-detect from try/throw/caller usage)");
    say("  -v, --verbose   Show compilation progress");
    say("  -h, --help      Show this help message");
    say("");
    say("The self-hosting Strada compiler, written in Strada.");
}

func main() int {
    # NOTE: the strada wrapper invokes stradac with STRADA_GC=off — the
    # compiler is a one-shot batch process (everything freed by refcount +
    # exit), so cycle-collector candidate buffering was ~6% of compile
    # time. The switch lives in the runtime's strada_init_proctitle (env
    # check) because the frozen bootstrap can't compile new builtins like
    # core::gc_disable() into stage 1.
    my int $arg_count = size(@ARGV);

    # Parse command-line arguments
    my int $debug_info = 0;
    my int $show_timing = 0;
    my int $show_warnings = 0;
    my int $strict_types = 0;
    my int $enable_profiling = 0;
    my int $full_profile = 0;
    my int $enable_stack_trace = -1;  # Auto-detect by default
    my int $verbose = 0;
    my int $check_only = 0;
    my str $input_file = "";
    my str $source_name = "";
    my str $output_file = "";
    my array @lib_paths = ();
    my array @lib_paths_low = ();
    my array @pp_defines = ();
    my array @implicit_objs = ();
    my array @implicit_archs = ();
    my array @implicit_libs = ();
    my int $module_only_mode = 0;
    my str $module_target = "";
    my str $split_dir = "";
    # Start from 0 — @ARGV excludes program name (Perl-style)
    # For bootstrap compatibility, also skip if ARGV[0] looks like program name
    my int $i = 0;
    if ($arg_count > 0 && index($ARGV[0], "stradac") >= 0) {
        $i = 1;
    }

    while ($i < $arg_count) {
        my str $arg = $ARGV[$i];

        if ($arg eq "-g" || $arg eq "--debug") {
            $debug_info = 1;
        } elsif ($arg eq "-p" || $arg eq "--profile") {
            $enable_profiling = 1;
        } elsif ($arg eq "-t" || $arg eq "--timing") {
            $show_timing = 1;
        } elsif ($arg eq "-w" || $arg eq "--warnings") {
            $show_warnings = 1;
        } elsif ($arg eq "--strict-types") {
            $strict_types = 1;
        } elsif ($arg eq "--check") {
            $check_only = 1;
        } elsif ($arg eq "--full-profile") {
            $full_profile = 1;
            $debug_info = 1;  # Full profiling implies debug (needs line info)
        } elsif ($arg eq "-v" || $arg eq "--verbose") {
            $verbose = 1;
        } elsif ($arg eq "--no-stack-trace") {
            $enable_stack_trace = 0;
        } elsif ($arg eq "--stack-trace") {
            $enable_stack_trace = 1;
        } elsif ($arg eq "-D") {
            # -D NAME[=VAL] - define a name for #ifdef/#ifndef (all files,
            # including modules); exported to the lexer via STRADA_DEFINES
            $i = $i + 1;
            if ($i < $arg_count) {
                push(@pp_defines, $ARGV[$i]);
            } else {
                say("Error: -D requires a name");
                return 1;
            }
        } elsif (substr($arg, 0, 2) eq "-D" && length($arg) > 2) {
            push(@pp_defines, substr($arg, 2, length($arg) - 2));
        } elsif ($arg eq "-LL") {
            # -LL <path> - add low-priority library search path
            $i = $i + 1;
            if ($i < $arg_count) {
                push(@lib_paths_low, $ARGV[$i]);
            } else {
                say("Error: -LL requires a path argument");
                return 1;
            }
        } elsif (substr($arg, 0, 3) eq "-LL") {
            # -LL<path> (no space) - add low-priority library search path
            my str $path = substr($arg, 3, length($arg) - 3);
            push(@lib_paths_low, $path);
        } elsif ($arg eq "-L") {
            # -L <path> - add library search path
            $i = $i + 1;
            if ($i < $arg_count) {
                push(@lib_paths, $ARGV[$i]);
            } else {
                say("Error: -L requires a path argument");
                return 1;
            }
        } elsif (substr($arg, 0, 2) eq "-L") {
            # -L<path> (no space) - add library search path
            my str $path = substr($arg, 2, length($arg) - 2);
            push(@lib_paths, $path);
        } elsif ($arg eq "--import-object") {
            # --import-object <path> - treat path as implicit import_object
            $i = $i + 1;
            if ($i < $arg_count) {
                push(@implicit_objs, $ARGV[$i]);
            } else {
                say("Error: --import-object requires a path argument");
                return 1;
            }
        } elsif ($arg eq "-M") {
            # -M [TARGET] - module-only codegen. TARGET is optional; if the
            # next arg starts with '-' or is missing, derive from input file.
            $module_only_mode = 1;
            if ($i + 1 < $arg_count) {
                my str $next_arg = $ARGV[$i + 1];
                if (length($next_arg) > 0 && substr($next_arg, 0, 1) ne "-") {
                    # Next arg looks like a target name (NOT a flag). Consume
                    # it only if it doesn't look like a filename — namely, if
                    # it has no extension and no '/' in it.
                    if (index($next_arg, "/") < 0 && index($next_arg, ".") < 0) {
                        $module_target = $next_arg;
                        $i = $i + 1;
                    }
                }
            }
        } elsif ($arg eq "--import-archive") {
            # --import-archive <path> - treat path as implicit import_archive
            $i = $i + 1;
            if ($i < $arg_count) {
                push(@implicit_archs, $ARGV[$i]);
            } else {
                say("Error: --import-archive requires a path argument");
                return 1;
            }
        } elsif ($arg eq "--import-lib") {
            # --import-lib <path> - treat path as implicit import_lib (a .so
            # dlopen'd at runtime, like a source-level `import_lib "foo.so";`)
            $i = $i + 1;
            if ($i < $arg_count) {
                push(@implicit_libs, $ARGV[$i]);
            } else {
                say("Error: --import-lib requires a path argument");
                return 1;
            }
        } elsif ($arg eq "--source-name") {
            # the file the source really came from (the driver compiles a
            # preprocessed copy): used in diagnostics and to find `use`d files
            $i = $i + 1;
            if ($i < $arg_count) { $source_name = $ARGV[$i]; }
        } elsif ($arg eq "--split-dir") {
            $i = $i + 1;
            if ($i < $arg_count) { $split_dir = $ARGV[$i]; }
        } elsif ($arg eq "-h" || $arg eq "--help") {
            print_usage();
            return 0;
        } elsif (substr($arg, 0, 1) eq "-") {
            say("Unknown option: " . $arg);
            print_usage();
            return 1;
        } elsif (length($input_file) == 0) {
            $input_file = $arg;
        } elsif (length($output_file) == 0) {
            $output_file = $arg;
        }

        $i = $i + 1;
    }

    # Check required arguments (--check needs no output file)
    if (length($input_file) == 0 || (length($output_file) == 0 && $check_only == 0)) {
        print_usage();
        return 1;
    }

    if ($verbose == 1) {
        say("Strada Compiler (Self-Hosting)");
        if ($debug_info == 1) {
            say("Debug mode: emitting #line directives");
        }
        if ($enable_profiling == 1) {
            say("Profiling mode: instrumenting functions for timing");
        }
        if ($full_profile == 1) {
            say("Full profiling mode: line-level instrumentation enabled");
        }
        say("Compiling: " . $input_file . " -> " . $output_file);
    }

    # Read source file
    my str $source = slurp($input_file);

    # Derive module target from input filename when -M was given without
    # an explicit target: "path/Foo.strada" -> "Foo".
    if ($module_only_mode == 1 && length($module_target) == 0) {
        my str $base = $input_file;
        my int $slash = -1;
        my int $idx = length($base) - 1;
        while ($idx >= 0) {
            my str $ch = substr($base, $idx, 1);
            if ($ch eq "/" || $ch eq "\\") { $slash = $idx; last; }
            $idx = $idx - 1;
        }
        if ($slash >= 0) {
            $base = substr($base, $slash + 1, length($base) - $slash - 1);
        }
        # Strip .strada extension
        my int $blen = length($base);
        if ($blen > 7 && substr($base, $blen - 7, 7) eq ".strada") {
            $base = substr($base, 0, $blen - 7);
        }
        $module_target = $base;
    }

    if ($verbose == 1 && $module_only_mode == 1) {
        say("Module-only mode: target = " . $module_target);
    }

    # Compile (pass lib paths, CLI-implicit imports, and module-only settings)
    my str $diag_name = $input_file;
    if (length($source_name) > 0) { $diag_name = $source_name; }
    my str $code = compile($source, $diag_name, $debug_info, $show_timing, $show_warnings, $strict_types, $enable_profiling, $enable_stack_trace, $full_profile, \@lib_paths, \@lib_paths_low, \@implicit_objs, \@implicit_archs, \@implicit_libs, $module_only_mode, $module_target, $check_only, \@pp_defines, $output_file, $verbose, $split_dir);

    if ($check_only == 1) {
        return 0;
    }

    spew($output_file, $code);
    if ($verbose == 1) {
        say("Success! Generated " . $output_file);
    }
    return 0;
}
