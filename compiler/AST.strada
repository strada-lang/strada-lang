# 1 when $n is certainly one plain value: a literal, or arithmetic /
# concatenation. `return "a";` or `return ("a");` from an `array` function
# returns a one-item list (the parentheses are gone by the time a return
# statement sees its value). Both backends use the same rule.
func ast_is_plain_value(scalar $n) int {
    # (no is_valid_node here: lib/Eval links this file without Semantic)
    if (!$n) { return 0; }
    my int $pv_kind = $n->{"type"};
    if ($pv_kind == NODE_INT_LITERAL() || $pv_kind == NODE_NUM_LITERAL()) { return 1; }
    if ($pv_kind == NODE_STR_LITERAL()) {
        if ($n->{"is_regex"}) { return 0; }
        return 1;
    }
    if ($pv_kind == NODE_BINARY_OP()) {
        my str $pv_op = "" . $n->{"op"};
        if ($pv_op eq "." || $pv_op eq "+" || $pv_op eq "-" || $pv_op eq "*" || $pv_op eq "/" || $pv_op eq "%" || $pv_op eq "**") { return 1; }
    }
    return 0;
}
