# Strada/Lexer.strada - Strada Lexer written in Strada
# This file will be compiled by the bootstrap compiler to create a self-hosting compiler

func lex_new(str $source) scalar {
    my hash %lexer = ();
    $lexer{"source"} = $source;
    $lexer{"file"} = "";
    $lexer{"pos"} = 0;
    $lexer{"line"} = 1;
    $lexer{"column"} = 1;
    # Use bytes() not length() since char_at() works on byte positions
    $lexer{"length"} = bytes($source);
    $lexer{"expect_regex"} = 0;
    $lexer{"expect_subst"} = 0;
    $lexer{"heredoc_pending_semi"} = 0;
    $lexer{"heredoc_resume_pos"} = 0;
    $lexer{"heredoc_resume_line"} = 0;
    $lexer{"pp_depth"} = 0;
    $lexer{"after_sigil"} = 0;
    $lexer{"after_arrow"} = 0;
    $lexer{"after_member_arrow"} = 0;
    $lexer{"after_value"} = 0;
    $lexer{"tok_col"} = 1;
    return \%lexer;
}

# ---- Diagnostic snippet rendering (shared by lexer/parser/semantic) ----
# Byte-walk to line N (1-based) of a source string; "" when out of range.
# char_at is O(1) by byte index (10 = '\n'), so this is one linear scan on
# the error path only.
func diag_line_from_source(str $source, int $want_line) str {
    my int $src_len = bytes($source);
    my int $pos = 0;
    my int $cur = 1;
    while ($cur < $want_line && $pos < $src_len) {
        if (char_at($source, $pos) == '\n') {
            $cur = $cur + 1;
        }
        $pos = $pos + 1;
    }
    if ($cur < $want_line) {
        return "";
    }
    my int $line_start = $pos;
    while ($pos < $src_len && char_at($source, $pos) != '\n') {
        $pos = $pos + 1;
    }
    return substr_bytes($source, $line_start, $pos - $line_start);
}

# Whitespace pad for a caret under column N: mirrors tabs ('\t') from the
# source line so the caret stays aligned under tab indentation.
func diag_caret_pad(str $line_text, int $want_col) str {
    my str $pad = "";
    my int $line_len = bytes($line_text);
    my int $ci = 0;
    while ($ci < $want_col - 1 && $ci < $line_len) {
        if (char_at($line_text, $ci) == '\t') {
            $pad = $pad . "\t";
        } else {
            $pad = $pad . " ";
        }
        $ci = $ci + 1;
    }
    return $pad;
}

# "\n<source line>\n<pad>^" — the gcc-style snippet appended to an error
# message. Column 0 renders the line without a caret; "" when the line is
# unavailable (synthetic sources, blank lines, out-of-range).
func diag_snippet(str $source, int $want_line, int $want_col) str {
    if ($want_line <= 0) {
        return "";
    }
    my str $line_text = diag_line_from_source($source, $want_line);
    if (length($line_text) == 0) {
        return "";
    }
    if ($want_col > 0) {
        return "\n" . $line_text . "\n" . diag_caret_pad($line_text, $want_col) . "^";
    }
    return "\n" . $line_text;
}

# Same, for callers that only hold a filename (parser/semantic). Slurps on
# the error path only; "" when the file can't be read.
func diag_snippet_from_file(str $fname, int $want_line, int $want_col) str {
    if (length($fname) == 0) {
        return "";
    }
    my str $src = slurp($fname);
    if (length($src) == 0) {
        return "";
    }
    return diag_snippet($src, $want_line, $want_col);
}

# Die with a source location. Format matches parser_error: "file:line: msg"
# (plus ":col" when a column is known), falling back to "line N: msg" when
# the lexer has no filename (synthetic sources, e.g. s///e replacements).
func lex_error(scalar $lexer, str $msg, int $err_line, int $err_col) void {
    my str $fname = $lexer->{"file"};
    my str $loc = "";
    if (length($fname) > 0) {
        $loc = $fname . ":" . $err_line;
    } else {
        $loc = "line " . $err_line;
    }
    if ($err_col > 0) {
        $loc = $loc . ":" . $err_col;
    }
    die($loc . ": " . $msg . diag_snippet($lexer->{"source"}, $err_line, $err_col));
}

# Fast char code access - no string allocation
func lex_current_code(scalar $lexer) int {
    my int $pos = $lexer->{"pos"};
    my int $len = $lexer->{"length"};
    if ($pos >= $len) {
        return 0;
    }
    return char_at($lexer->{"source"}, $pos);
}

# Peek at a future char's code without advancing.
func lex_peek_code(scalar $lexer, int $offset) int {
    my int $pos = $lexer->{"pos"} + $offset;
    my int $len = $lexer->{"length"};
    if ($pos >= $len) {
        return 0;
    }
    return char_at($lexer->{"source"}, $pos);
}

# Returns current byte as string (preserves raw UTF-8 bytes without double-encoding)
func lex_current_char(scalar $lexer) str {
    my int $pos = $lexer->{"pos"};
    if ($pos >= $lexer->{"length"}) {
        return "";
    }
    return substr_bytes($lexer->{"source"}, $pos, 1);
}

func lex_advance(scalar $lexer) void {
    my int $code = lex_current_code($lexer);

    if ($code == '\n') {
        if ($lexer->{"heredoc_resume_pos"} > 0) {
            $lexer->{"pos"} = $lexer->{"heredoc_resume_pos"};
            $lexer->{"line"} = $lexer->{"heredoc_resume_line"};
            $lexer->{"column"} = 1;
            $lexer->{"heredoc_resume_pos"} = 0;
            $lexer->{"heredoc_resume_line"} = 0;
            return;
        }
        $lexer->{"line"} = $lexer->{"line"} + 1;
        $lexer->{"column"} = 1;
    } else {
        $lexer->{"column"} = $lexer->{"column"} + 1;
    }

    $lexer->{"pos"} = $lexer->{"pos"} + 1;
}

# Hot path: scan with locals (source/pos cached once) instead of going
# through lex_current_code/lex_advance, which re-probe the lexer hash
# several times per character.
func lex_skip_whitespace(scalar $lexer) void {
    my scalar $ws_source = $lexer->{"source"};
    my int $ws_pos = $lexer->{"pos"};
    my int $ws_len = $lexer->{"length"};
    my int $ws_start = $ws_pos;
    my int $ws_line = $lexer->{"line"};
    my int $ws_column = $lexer->{"column"};
    my int $hd_resume_pos = $lexer->{"heredoc_resume_pos"};

    while ($ws_pos < $ws_len) {
        my int $code = char_at($ws_source, $ws_pos);

        if ($code == '\n') {
            if ($hd_resume_pos > 0) {
                $ws_pos = $hd_resume_pos;
                $ws_line = $lexer->{"heredoc_resume_line"};
                $ws_column = 1;
                $hd_resume_pos = 0;
                $lexer->{"heredoc_resume_pos"} = 0;
                $lexer->{"heredoc_resume_line"} = 0;
            } else {
                $ws_line = $ws_line + 1;
                $ws_column = 1;
                $ws_pos = $ws_pos + 1;
            }
        } elsif ($code == ' ' || $code == '\t' || $code == '\r') {
            $ws_column = $ws_column + 1;
            $ws_pos = $ws_pos + 1;
        } else {
            last;
        }
    }

    if ($ws_pos != $ws_start) {
        $lexer->{"pos"} = $ws_pos;
        $lexer->{"line"} = $ws_line;
        $lexer->{"column"} = $ws_column;
    }
}

# ---- Conditional compilation -------------------------------------------
# #ifdef NAME / #ifndef NAME / #else / #endif / #define NAME / #undef NAME
# at the start of a line, in every file the compiler reads - including
# modules pulled in by `use`. (Previously only the driver's stradapp pass
# handled them, and only for the main file and only when -D was given;
# everywhere else the lines were comments and BOTH branches compiled.)
# Defines come from STRADA_DEFINES ("NAME NAME=VAL ...", set by stradac -D)
# plus #define in the file. __C__ blocks are lexed as one token, so C
# preprocessor lines inside them are never seen here.
func lex_pp_init(scalar $lexer) void {
    my hash %defs = ();
    my str $env = core::getenv("STRADA_DEFINES");
    if (length($env) > 0) {
        my array @parts = split(" ", $env);
        my int $i = 0;
        while ($i < size(@parts)) {
            my str $d = $parts[$i];
            my int $eqp = index($d, "=");
            if ($eqp > 0) {
                my str $k = substr($d, 0, $eqp);
                my str $v = substr($d, $eqp + 1, length($d) - $eqp - 1);
                if (length($k) > 0) { $defs{$k} = $v; }
            } else {
                if (length($d) > 0) { $defs{$d} = "1"; }
            }
            $i = $i + 1;
        }
    }
    $lexer->{"pp_defines"} = \%defs;
    $lexer->{"pp_depth"} = 0;
}

func lex_pp_is_word_char(int $c) int {
    if (($c >= 'a' && $c <= 'z') || ($c >= 'A' && $c <= 'Z') || ($c >= '0' && $c <= '9') || $c == '_') { return 1; }
    return 0;
}

# Directive word at pos (just after '#'), or "".
func lex_pp_word_at(scalar $source, int $pos, int $len) str {
    my int $end = $pos;
    while ($end < $len && lex_pp_is_word_char(char_at($source, $end)) == 1) { $end = $end + 1; }
    if ($end == $pos) { return ""; }
    return substr_bytes($source, $pos, $end - $pos);
}

func lex_pp_is_directive(str $w) int {
    if ($w eq "ifdef" || $w eq "ifndef" || $w eq "if" || $w eq "elif" || $w eq "else" || $w eq "endif" || $w eq "define" || $w eq "undef") { return 1; }
    return 0;
}

func lex_pp_strip_comment(str $s) str {
    my int $len = length($s);
    my int $i = 0;
    my int $in_dq = 0;
    my int $in_sq = 0;
    my scalar $sb = sb_new();
    while ($i < $len) {
        my str $ch = substr($s, $i, 1);
        if ($in_dq == 1) {
            if ($ch eq "\\" && $i + 1 < $len) {
                sb_append($sb, substr($s, $i, 2));
                $i = $i + 2;
                next;
            }
            sb_append($sb, $ch);
            if ($ch eq "\"") { $in_dq = 0; }
        } elsif ($in_sq == 1) {
            if ($ch eq "\\" && $i + 1 < $len) {
                sb_append($sb, substr($s, $i, 2));
                $i = $i + 2;
                next;
            }
            sb_append($sb, $ch);
            if ($ch eq "'") { $in_sq = 0; }
        } else {
            if ($ch eq "\"") {
                $in_dq = 1;
                sb_append($sb, $ch);
            } elsif ($ch eq "'") {
                $in_sq = 1;
                sb_append($sb, $ch);
            } elsif ($ch eq "#") {
                last;
            } elsif ($ch eq "/" && $i + 1 < $len && substr($s, $i + 1, 1) eq "/") {
                last;
            } elsif ($ch eq "/" && $i + 1 < $len && substr($s, $i + 1, 1) eq "*") {
                my int $j = $i + 2;
                my int $closed = 0;
                while ($j + 1 < $len) {
                    if (substr($s, $j, 2) eq "*/") {
                        $j = $j + 2;
                        $closed = 1;
                        last;
                    }
                    $j = $j + 1;
                }
                if ($closed == 0) { last; }
                sb_append($sb, " ");
                $i = $j;
                next;
            } else {
                sb_append($sb, $ch);
            }
        }
        $i = $i + 1;
    }
    my str $res = sb_to_string($sb);
    my int $rlen = length($res);
    while ($rlen > 0) {
        my str $tail = substr($res, $rlen - 1, 1);
        if ($tail eq " " || $tail eq "\t" || $tail eq "\r") {
            $rlen = $rlen - 1;
        } else {
            last;
        }
    }
    return substr($res, 0, $rlen);
}

func lex_pp_parse_int_lit(str $s) int {
    my int $len = length($s);
    if ($len == 0) { return 0; }
    my int $i = 0;
    my int $neg = 0;
    my str $c0 = substr($s, 0, 1);
    if ($c0 eq "-") { $neg = 1; $i = 1; }
    elsif ($c0 eq "+") { $i = 1; }
    if ($i >= $len) { return 0; }
    my int $val = 0;
    if ($i + 2 <= $len) {
        my str $pfx = substr($s, $i, 2);
        if ($pfx eq "0x" || $pfx eq "0X") {
            $i = $i + 2;
            while ($i < $len) {
                my int $c = ord(substr($s, $i, 1));
                my int $d = -1;
                if ($c >= '0' && $c <= '9') { $d = $c - ord("0"); }
                elsif ($c >= 'a' && $c <= 'f') { $d = $c - ord("a") + 10; }
                elsif ($c >= 'A' && $c <= 'F') { $d = $c - ord("A") + 10; }
                else { last; }
                $val = $val * 16 + $d;
                $i = $i + 1;
            }
            if ($neg == 1) { return 0 - $val; }
            return $val;
        }
        if ($pfx eq "0b" || $pfx eq "0B") {
            $i = $i + 2;
            while ($i < $len) {
                my int $c = ord(substr($s, $i, 1));
                if ($c == '0') { $val = $val * 2; }
                elsif ($c == '1') { $val = $val * 2 + 1; }
                else { last; }
                $i = $i + 1;
            }
            if ($neg == 1) { return 0 - $val; }
            return $val;
        }
        if ($pfx eq "0o" || $pfx eq "0O") {
            $i = $i + 2;
            while ($i < $len) {
                my int $c = ord(substr($s, $i, 1));
                if ($c >= '0' && $c <= '7') { $val = $val * 8 + ($c - ord("0")); }
                else { last; }
                $i = $i + 1;
            }
            if ($neg == 1) { return 0 - $val; }
            return $val;
        }
    }
    if (substr($s, $i, 1) eq "0" && $len - $i > 1) {
        $i = $i + 1;
        while ($i < $len) {
            my int $c = ord(substr($s, $i, 1));
            if ($c >= '0' && $c <= '7') { $val = $val * 8 + ($c - ord("0")); }
            else { last; }
            $i = $i + 1;
        }
        if ($neg == 1) { return 0 - $val; }
        return $val;
    }
    while ($i < $len) {
        my int $c = ord(substr($s, $i, 1));
        if ($c >= '0' && $c <= '9') { $val = $val * 10 + ($c - ord("0")); }
        else { last; }
        $i = $i + 1;
    }
    if ($neg == 1) { return 0 - $val; }
    return $val;
}

func lex_pp_skip_ws(str $s, int $pos, int $len) int {
    while ($pos < $len) {
        my int $c = ord(substr($s, $pos, 1));
        if ($c == ' ' || $c == '\t' || $c == '\r') { $pos = $pos + 1; }
        else { last; }
    }
    return $pos;
}

func lex_pp_eval_expr_depth(scalar $defs, str $expr, int $depth) int {
    if ($depth > 8) { return 0; }
    my hash %st = ();
    $st{"pos"} = 0;
    return lex_pp_eval_or_str($defs, $expr, \%st, length($expr));
}

func lex_pp_has_def(scalar $defs, str $name) int {
    if (!$defs || !defined($defs->{$name})) { return 0; }
    my str $v = "" . $defs->{$name};
    if ($v eq "__STRADA_PP_UNDEF__") { return 0; }
    return 1;
}

func lex_pp_resolve_macro(scalar $defs, str $name, int $depth) int {
    if ($depth > 8) { return 0; }
    if (lex_pp_has_def($defs, $name) == 0) { return 0; }
    my str $raw = "" . $defs->{$name};
    # Trim spaces/tabs
    my int $rl = length($raw);
    my int $s = 0;
    while ($s < $rl && (ord(substr($raw, $s, 1)) == ' ' || ord(substr($raw, $s, 1)) == '\t')) { $s = $s + 1; }
    while ($rl > $s && (ord(substr($raw, $rl - 1, 1)) == ' ' || ord(substr($raw, $rl - 1, 1)) == '\t')) { $rl = $rl - 1; }
    $raw = substr($raw, $s, $rl - $s);
    if (length($raw) == 0) { return 0; }
    my int $c0 = ord(substr($raw, 0, 1));
    if (($c0 >= '0' && $c0 <= '9') || $c0 == '-' || $c0 == '+') {
        return lex_pp_parse_int_lit($raw);
    }
    if (lex_pp_has_def($defs, $raw) == 1) {
        return lex_pp_resolve_macro($defs, $raw, $depth + 1);
    }
    return lex_pp_eval_expr_depth($defs, $raw, $depth + 1);
}

func lex_pp_eval_primary(scalar $defs, str $s, scalar $st, int $len) int {
    my int $p = lex_pp_skip_ws($s, $st->{"pos"}, $len);
    $st->{"pos"} = $p;
    if ($p >= $len) { return 0; }
    my str $ch = substr($s, $p, 1);
    if ($ch eq "(") {
        $st->{"pos"} = $p + 1;
        my int $v = lex_pp_eval_or_str($defs, $s, $st, $len);
        $p = lex_pp_skip_ws($s, $st->{"pos"}, $len);
        if ($p < $len && substr($s, $p, 1) eq ")") { $p = $p + 1; }
        $st->{"pos"} = $p;
        return $v;
    }
    my int $c = ord($ch);
    if ($c >= '0' && $c <= '9') {
        my int $st_i = $p;
        while ($p < $len) {
            my int $dc = ord(substr($s, $p, 1));
            if (($dc >= '0' && $dc <= '9') || ($dc >= 'a' && $dc <= 'z') || ($dc >= 'A' && $dc <= 'Z')) {
                $p = $p + 1;
            } else { last; }
        }
        $st->{"pos"} = $p;
        return lex_pp_parse_int_lit(substr($s, $st_i, $p - $st_i));
    }
    if (lex_pp_is_word_char($c) == 1) {
        my int $st_i = $p;
        while ($p < $len && lex_pp_is_word_char(ord(substr($s, $p, 1))) == 1) { $p = $p + 1; }
        my str $ident = substr($s, $st_i, $p - $st_i);
        $st->{"pos"} = $p;
        if ($ident eq "defined") {
            $p = lex_pp_skip_ws($s, $p, $len);
            my int $hp = 0;
            if ($p < $len && substr($s, $p, 1) eq "(") {
                $hp = 1;
                $p = lex_pp_skip_ws($s, $p + 1, $len);
            }
            my int $ns = $p;
            while ($p < $len && lex_pp_is_word_char(ord(substr($s, $p, 1))) == 1) { $p = $p + 1; }
            my str $mname = substr($s, $ns, $p - $ns);
            if ($hp == 1) {
                $p = lex_pp_skip_ws($s, $p, $len);
                if ($p < $len && substr($s, $p, 1) eq ")") { $p = $p + 1; }
            }
            $st->{"pos"} = $p;
            if (length($mname) > 0 && lex_pp_has_def($defs, $mname) == 1) { return 1; }
            return 0;
        }
        return lex_pp_resolve_macro($defs, $ident, 0);
    }
    $st->{"pos"} = $p + 1;
    return 0;
}

func lex_pp_eval_unary(scalar $defs, str $s, scalar $st, int $len) int {
    my int $p = lex_pp_skip_ws($s, $st->{"pos"}, $len);
    $st->{"pos"} = $p;
    if ($p >= $len) { return 0; }
    my str $ch = substr($s, $p, 1);
    if ($ch eq "!" && ($p + 1 >= $len || substr($s, $p + 1, 1) ne "=")) {
        $st->{"pos"} = $p + 1;
        if (lex_pp_eval_unary($defs, $s, $st, $len) == 0) { return 1; }
        return 0;
    }
    if ($ch eq "~") { $st->{"pos"} = $p + 1; return (0 - 1) - lex_pp_eval_unary($defs, $s, $st, $len); }
    if ($ch eq "-") { $st->{"pos"} = $p + 1; return 0 - lex_pp_eval_unary($defs, $s, $st, $len); }
    if ($ch eq "+") { $st->{"pos"} = $p + 1; return lex_pp_eval_unary($defs, $s, $st, $len); }
    return lex_pp_eval_primary($defs, $s, $st, $len);
}

func lex_pp_eval_mul(scalar $defs, str $s, scalar $st, int $len) int {
    my int $left = lex_pp_eval_unary($defs, $s, $st, $len);
    while (1) {
        my int $p = lex_pp_skip_ws($s, $st->{"pos"}, $len);
        $st->{"pos"} = $p;
        if ($p >= $len) { last; }
        my str $ch = substr($s, $p, 1);
        if ($ch eq "*") { $st->{"pos"} = $p + 1; $left = $left * lex_pp_eval_unary($defs, $s, $st, $len); }
        elsif ($ch eq "/") {
            $st->{"pos"} = $p + 1;
            my int $r = lex_pp_eval_unary($defs, $s, $st, $len);
            if ($r != 0) { $left = $left / $r; } else { $left = 0; }
        } elsif ($ch eq "%") {
            $st->{"pos"} = $p + 1;
            my int $r = lex_pp_eval_unary($defs, $s, $st, $len);
            if ($r != 0) { $left = $left % $r; } else { $left = 0; }
        } else { last; }
    }
    return $left;
}

func lex_pp_eval_add(scalar $defs, str $s, scalar $st, int $len) int {
    my int $left = lex_pp_eval_mul($defs, $s, $st, $len);
    while (1) {
        my int $p = lex_pp_skip_ws($s, $st->{"pos"}, $len);
        $st->{"pos"} = $p;
        if ($p >= $len) { last; }
        my str $ch = substr($s, $p, 1);
        if ($ch eq "+") { $st->{"pos"} = $p + 1; $left = $left + lex_pp_eval_mul($defs, $s, $st, $len); }
        elsif ($ch eq "-") { $st->{"pos"} = $p + 1; $left = $left - lex_pp_eval_mul($defs, $s, $st, $len); }
        else { last; }
    }
    return $left;
}

func lex_pp_bit_shl(int $a, int $b) int {
    if ($b <= 0) { return $a + 0; }
    if ($b >= 64) { return 0; }
    my int $r = $a + 0;
    my int $i = 0;
    while ($i < $b) {
        $r = $r * 2;
        $i = $i + 1;
    }
    return $r;
}

func lex_pp_bit_shr(int $a, int $b) int {
    if ($b <= 0) { return $a + 0; }
    if ($b >= 63) {
        if ($a < 0) { return 0 - 1; }
        return 0;
    }
    my int $r = $a;
    my int $i = 0;
    while ($i < $b) {
        if ($r < 0 && ($r % 2) != 0) {
            $r = ($r / 2) - 1;
        } else {
            $r = $r / 2;
        }
        $i = $i + 1;
    }
    return $r;
}

# op: 0 = and, 1 = xor, 2 = or
func lex_pp_bit_op(int $a, int $b, int $op) int {
    my int $sa = 0;
    my int $sb = 0;
    my int $half63 = 4611686018427387904;
    if ($a < 0) {
        $sa = 1;
        $a = ($a + $half63) + $half63;
    }
    if ($b < 0) {
        $sb = 1;
        $b = ($b + $half63) + $half63;
    }
    my int $res = 0;
    my int $pow = 1;
    my int $i = 0;
    while ($i < 63) {
        my int $ba = $a % 2;
        my int $bb = $b % 2;
        $a = $a / 2;
        $b = $b / 2;
        my int $br = 0;
        if ($op == 0) {
            if ($ba != 0 && $bb != 0) { $br = 1; }
        } elsif ($op == 1) {
            if ($ba != $bb) { $br = 1; }
        } else {
            if ($ba != 0 || $bb != 0) { $br = 1; }
        }
        if ($br != 0) { $res = $res + $pow; }
        if ($i < 62) { $pow = $pow * 2; }
        $i = $i + 1;
    }
    my int $sr = 0;
    if ($op == 0) {
        if ($sa != 0 && $sb != 0) { $sr = 1; }
    } elsif ($op == 1) {
        if ($sa != $sb) { $sr = 1; }
    } else {
        if ($sa != 0 || $sb != 0) { $sr = 1; }
    }
    if ($sr != 0) {
        $res = ($res - $half63) - $half63;
    }
    return $res;
}

func lex_pp_eval_shift(scalar $defs, str $s, scalar $st, int $len) int {
    my int $left = lex_pp_eval_add($defs, $s, $st, $len);
    while (1) {
        my int $p = lex_pp_skip_ws($s, $st->{"pos"}, $len);
        $st->{"pos"} = $p;
        if ($p + 1 >= $len) { last; }
        my str $op = substr($s, $p, 2);
        if ($op eq "<<") { $st->{"pos"} = $p + 2; $left = lex_pp_bit_shl($left, lex_pp_eval_add($defs, $s, $st, $len)); }
        elsif ($op eq ">>") { $st->{"pos"} = $p + 2; $left = lex_pp_bit_shr($left, lex_pp_eval_add($defs, $s, $st, $len)); }
        else { last; }
    }
    return $left;
}

func lex_pp_eval_rel(scalar $defs, str $s, scalar $st, int $len) int {
    my int $left = lex_pp_eval_shift($defs, $s, $st, $len);
    while (1) {
        my int $p = lex_pp_skip_ws($s, $st->{"pos"}, $len);
        $st->{"pos"} = $p;
        if ($p >= $len) { last; }
        if ($p + 1 < $len) {
            my str $op2 = substr($s, $p, 2);
            if ($op2 eq "<=") {
                $st->{"pos"} = $p + 2;
                if ($left <= lex_pp_eval_shift($defs, $s, $st, $len)) { $left = 1; } else { $left = 0; }
                next;
            }
            if ($op2 eq ">=") {
                $st->{"pos"} = $p + 2;
                if ($left >= lex_pp_eval_shift($defs, $s, $st, $len)) { $left = 1; } else { $left = 0; }
                next;
            }
            if ($op2 eq "<<" || $op2 eq ">>") { last; }
        }
        my str $ch = substr($s, $p, 1);
        if ($ch eq "<") {
            $st->{"pos"} = $p + 1;
            if ($left < lex_pp_eval_shift($defs, $s, $st, $len)) { $left = 1; } else { $left = 0; }
            next;
        }
        if ($ch eq ">") {
            $st->{"pos"} = $p + 1;
            if ($left > lex_pp_eval_shift($defs, $s, $st, $len)) { $left = 1; } else { $left = 0; }
            next;
        }
        last;
    }
    return $left;
}

func lex_pp_eval_eq(scalar $defs, str $s, scalar $st, int $len) int {
    my int $left = lex_pp_eval_rel($defs, $s, $st, $len);
    while (1) {
        my int $p = lex_pp_skip_ws($s, $st->{"pos"}, $len);
        $st->{"pos"} = $p;
        if ($p + 1 >= $len) { last; }
        my str $op = substr($s, $p, 2);
        if ($op eq "==") {
            $st->{"pos"} = $p + 2;
            if ($left == lex_pp_eval_rel($defs, $s, $st, $len)) { $left = 1; } else { $left = 0; }
            next;
        }
        if ($op eq "!=") {
            $st->{"pos"} = $p + 2;
            if ($left != lex_pp_eval_rel($defs, $s, $st, $len)) { $left = 1; } else { $left = 0; }
            next;
        }
        last;
    }
    return $left;
}

func lex_pp_eval_bitand(scalar $defs, str $s, scalar $st, int $len) int {
    my int $left = lex_pp_eval_eq($defs, $s, $st, $len);
    while (1) {
        my int $p = lex_pp_skip_ws($s, $st->{"pos"}, $len);
        $st->{"pos"} = $p;
        if ($p >= $len) { last; }
        if (substr($s, $p, 1) eq "&" && ($p + 1 >= $len || substr($s, $p + 1, 1) ne "&")) {
            $st->{"pos"} = $p + 1;
            $left = lex_pp_bit_op($left, lex_pp_eval_eq($defs, $s, $st, $len), 0);
            next;
        }
        last;
    }
    return $left;
}

func lex_pp_eval_bitxor(scalar $defs, str $s, scalar $st, int $len) int {
    my int $left = lex_pp_eval_bitand($defs, $s, $st, $len);
    while (1) {
        my int $p = lex_pp_skip_ws($s, $st->{"pos"}, $len);
        $st->{"pos"} = $p;
        if ($p >= $len) { last; }
        if (substr($s, $p, 1) eq "^") {
            $st->{"pos"} = $p + 1;
            $left = lex_pp_bit_op($left, lex_pp_eval_bitand($defs, $s, $st, $len), 1);
            next;
        }
        last;
    }
    return $left;
}

func lex_pp_eval_bitor(scalar $defs, str $s, scalar $st, int $len) int {
    my int $left = lex_pp_eval_bitxor($defs, $s, $st, $len);
    while (1) {
        my int $p = lex_pp_skip_ws($s, $st->{"pos"}, $len);
        $st->{"pos"} = $p;
        if ($p >= $len) { last; }
        if (substr($s, $p, 1) eq "|" && ($p + 1 >= $len || substr($s, $p + 1, 1) ne "|")) {
            $st->{"pos"} = $p + 1;
            $left = lex_pp_bit_op($left, lex_pp_eval_bitxor($defs, $s, $st, $len), 2);
            next;
        }
        last;
    }
    return $left;
}

func lex_pp_eval_and(scalar $defs, str $s, scalar $st, int $len) int {
    my int $left = lex_pp_eval_bitor($defs, $s, $st, $len);
    while (1) {
        my int $p = lex_pp_skip_ws($s, $st->{"pos"}, $len);
        $st->{"pos"} = $p;
        if ($p + 1 >= $len) { last; }
        if (substr($s, $p, 2) eq "&&") {
            $st->{"pos"} = $p + 2;
            my int $right = lex_pp_eval_bitor($defs, $s, $st, $len);
            if ($left != 0 && $right != 0) { $left = 1; } else { $left = 0; }
            next;
        }
        last;
    }
    return $left;
}

func lex_pp_eval_or_str(scalar $defs, str $s, scalar $st, int $len) int {
    my int $left = lex_pp_eval_and($defs, $s, $st, $len);
    while (1) {
        my int $p = lex_pp_skip_ws($s, $st->{"pos"}, $len);
        $st->{"pos"} = $p;
        if ($p + 1 >= $len) { last; }
        if (substr($s, $p, 2) eq "||") {
            $st->{"pos"} = $p + 2;
            my int $right = lex_pp_eval_and($defs, $s, $st, $len);
            if ($left != 0 || $right != 0) { $left = 1; } else { $left = 0; }
            next;
        }
        last;
    }
    return $left;
}

func lex_pp_eval_expr(scalar $lexer, str $expr) int {
    return lex_pp_eval_expr_depth($lexer->{"pp_defines"}, $expr, 0);
}

# Skip lines of a false branch. Starts with pos on the newline that ends the
# directive line. Returns "else", "elif:<expr>", or "endif"; leaves pos on
# the newline ending that line.
func lex_pp_skip(scalar $lexer, int $stop_else, int $start_line) str {
    my scalar $src = $lexer->{"source"};
    my int $len = $lexer->{"length"};
    my int $pos = $lexer->{"pos"};
    my int $line = $lexer->{"line"};
    my int $nest = 0;
    while (1) {
        # move past the current line's newline
        while ($pos < $len && char_at($src, $pos) != '\n') { $pos = $pos + 1; }
        if ($pos >= $len) {
            $lexer->{"pos"} = $pos;
            lex_error($lexer, "unterminated #if/#ifdef/#ifndef (missing #endif)", $start_line, 1);
        }
        $pos = $pos + 1;
        $line = $line + 1;
        my int $q = $pos;
        while ($q < $len && (char_at($src, $q) == ' ' || char_at($src, $q) == '\t')) { $q = $q + 1; }
        if ($q < $len && char_at($src, $q) == '#') {
            my str $w = lex_pp_word_at($src, $q + 1, $len);
            if ($w eq "ifdef" || $w eq "ifndef" || $w eq "if") {
                $nest = $nest + 1;
            } elsif ($w eq "endif") {
                if ($nest == 0) {
                    while ($q < $len && char_at($src, $q) != '\n') { $q = $q + 1; }
                    $lexer->{"pos"} = $q;
                    $lexer->{"line"} = $line;
                    $lexer->{"column"} = 1;
                    return "endif";
                }
                $nest = $nest - 1;
            } elsif ($w eq "else" && $nest == 0 && $stop_else == 1) {
                while ($q < $len && char_at($src, $q) != '\n') { $q = $q + 1; }
                $lexer->{"pos"} = $q;
                $lexer->{"line"} = $line;
                $lexer->{"column"} = 1;
                return "else";
            } elsif ($w eq "elif" && $nest == 0 && $stop_else == 1) {
                my int $es = $q + 5;
                while ($es < $len && (char_at($src, $es) == ' ' || char_at($src, $es) == '\t')) { $es = $es + 1; }
                my int $ee = $es;
                while ($ee < $len && char_at($src, $ee) != '\n') { $ee = $ee + 1; }
                my str $eexpr = lex_pp_strip_comment(substr_bytes($src, $es, $ee - $es));
                $lexer->{"pos"} = $ee;
                $lexer->{"line"} = $line;
                $lexer->{"column"} = 1;
                return "elif:" . $eexpr;
            }
        } elsif ($q == $pos && $q + 1 < $len && char_at($src, $q) == '=') {
            my int $pod_c2 = char_at($src, $q + 1);
            if (($pod_c2 >= 'A' && $pod_c2 <= 'Z') || ($pod_c2 >= 'a' && $pod_c2 <= 'z')) {
                my str $pod_w = lex_pp_word_at($src, $q + 1, $len);
                if ($pod_w ne "cut") {
                    # Skip POD section (=head1, =pod, etc. at col 0) through =cut
                    while ($pos < $len && char_at($src, $pos) != '\n') { $pos = $pos + 1; }
                    while ($pos < $len) {
                        $pos = $pos + 1;
                        $line = $line + 1;
                        if ($pos < $len && char_at($src, $pos) == '=') {
                            my str $cw = lex_pp_word_at($src, $pos + 1, $len);
                            if ($cw eq "cut") {
                                my int $after_cut = $pos + 4;
                                if ($after_cut >= $len || char_at($src, $after_cut) == ' ' || char_at($src, $after_cut) == '\t' || char_at($src, $after_cut) == '\n' || char_at($src, $after_cut) == '\r') {
                                    while ($pos < $len && char_at($src, $pos) != '\n') { $pos = $pos + 1; }
                                    last;
                                }
                            }
                        }
                        while ($pos < $len && char_at($src, $pos) != '\n') { $pos = $pos + 1; }
                    }
                    next;
                }
            }
            $pos = $q;
        } else {
            # Scan skipped Strada line for __C__ { ... } blocks (and skip
            # comments, strings, POD, and regexes) so C #if/#ifdef/#else/#endif
            # inside __C__ { ... } or apostrophes inside /don't/ or POD never
            # confuse outer #ifdef/#endif nesting.
            my int $sc = $q;
            my int $can_regex = 1;
            while ($sc < $len && char_at($src, $sc) != '\n') {
                my int $cc = char_at($src, $sc);
                if ($cc == ' ' || $cc == '\t' || $cc == '\r') {
                    $sc = $sc + 1;
                } elsif ($cc == '#') {
                    # '#' Strada comment to end of line
                    while ($sc < $len && char_at($src, $sc) != '\n') { $sc = $sc + 1; }
                } elsif ($cc == '/' && $sc + 1 < $len && char_at($src, $sc + 1) == '/') {
                    if ($can_regex == 1) {
                        # '//' comment in dead code (or empty regex //)
                        while ($sc < $len && char_at($src, $sc) != '\n') { $sc = $sc + 1; }
                    } else {
                        # Binary '//' defined-or operator
                        $sc = $sc + 2;
                        $can_regex = 1;
                    }
                } elsif ($cc == '/' && $sc + 1 < $len && char_at($src, $sc + 1) == '*') {
                    # /* ... */ block comment
                    $sc = $sc + 2;
                    while ($sc < $len) {
                        my int $b1 = char_at($src, $sc);
                        if ($b1 == '\n') { $line = $line + 1; }
                        if ($b1 == '*' && $sc + 1 < $len && char_at($src, $sc + 1) == '/') {
                            $sc = $sc + 2;
                            last;
                        }
                        $sc = $sc + 1;
                    }
                } elsif ($cc == '/' && $can_regex == 1) {
                    # Regex literal /.../ on this line (avoid false apostrophe/quote inside /don't/)
                    my int $rj = $sc + 1;
                    my int $rclosed = 0;
                    while ($rj < $len && char_at($src, $rj) != '\n') {
                        my int $rc = char_at($src, $rj);
                        if ($rc == '\\' && $rj + 1 < $len && char_at($src, $rj + 1) != '\n') {
                            $rj = $rj + 2;
                        } elsif ($rc == '/') {
                            $rj = $rj + 1;
                            $rclosed = 1;
                            last;
                        } else {
                            $rj = $rj + 1;
                        }
                    }
                    if ($rclosed == 1) {
                        $sc = $rj;
                        $can_regex = 0;
                    } else {
                        $sc = $sc + 1;
                        $can_regex = 1;
                    }
                } elsif ($cc == '"' || $cc == '\'') {
                    # String literal ("..." or '...')
                    my int $qch = $cc;
                    $sc = $sc + 1;
                    while ($sc < $len) {
                        my int $sch = char_at($src, $sc);
                        if ($sch == '\n') { $line = $line + 1; }
                        $sc = $sc + 1;
                        if ($sch == $qch) { last; }
                        if ($sch == '\\' && $sc < $len) {
                            if (char_at($src, $sc) == '\n') { $line = $line + 1; }
                            $sc = $sc + 1;
                        }
                    }
                    $can_regex = 0;
                } elsif (lex_pp_is_word_char($cc) == 1) {
                    my int $ws = $sc;
                    while ($sc < $len && lex_pp_is_word_char(char_at($src, $sc)) == 1) {
                        $sc = $sc + 1;
                    }
                    my str $kw = substr_bytes($src, $ws, $sc - $ws);
                    if ($kw eq "__C__") {
                        while ($sc < $len) {
                            my int $wc = char_at($src, $sc);
                            if ($wc == '\n') { $line = $line + 1; $sc = $sc + 1; }
                            elsif ($wc == ' ' || $wc == '\t' || $wc == '\r') { $sc = $sc + 1; }
                            else { last; }
                        }
                        if ($sc < $len && char_at($src, $sc) == '{') {
                            # Skip entire __C__ { ... } block (tracking braces, C strings, C comments, and C #if/#ifdef/#ifndef...#endif)
                            my int $c_line = $line;
                            $sc = $sc + 1;
                            my int $c_depth = 1;
                            my int $c_pp_nest = 0;
                            while ($sc < $len && ($c_depth > 0 || $c_pp_nest > 0)) {
                                my int $k = char_at($src, $sc);
                                if ($k == '\n') {
                                    $line = $line + 1;
                                    $sc = $sc + 1;
                                    # Check for C preprocessor directive at start of line inside __C__
                                    my int $cp = $sc;
                                    while ($cp < $len && (char_at($src, $cp) == ' ' || char_at($src, $cp) == '\t')) { $cp = $cp + 1; }
                                    if ($cp < $len && char_at($src, $cp) == '#') {
                                        $cp = $cp + 1;
                                        while ($cp < $len && (char_at($src, $cp) == ' ' || char_at($src, $cp) == '\t')) { $cp = $cp + 1; }
                                        my str $cw = lex_pp_word_at($src, $cp, $len);
                                        if ($cw eq "if" || $cw eq "ifdef" || $cw eq "ifndef") {
                                            $c_pp_nest = $c_pp_nest + 1;
                                        } elsif ($cw eq "endif" && $c_pp_nest > 0) {
                                            $c_pp_nest = $c_pp_nest - 1;
                                        }
                                    }
                                } elsif ($k == '"' || $k == '\'') {
                                    my int $cq = $k;
                                    $sc = $sc + 1;
                                    while ($sc < $len) {
                                        my int $cs = char_at($src, $sc);
                                        if ($cs == '\n') { $line = $line + 1; }
                                        $sc = $sc + 1;
                                        if ($cs == $cq) { last; }
                                        if ($cs == '\\' && $sc < $len) {
                                            if (char_at($src, $sc) == '\n') { $line = $line + 1; }
                                            $sc = $sc + 1;
                                        }
                                    }
                                } elsif ($k == '/' && $sc + 1 < $len && char_at($src, $sc + 1) == '*') {
                                    $sc = $sc + 2;
                                    while ($sc < $len) {
                                        my int $cb1 = char_at($src, $sc);
                                        if ($cb1 == '\n') { $line = $line + 1; }
                                        if ($cb1 == '*' && $sc + 1 < $len && char_at($src, $sc + 1) == '/') {
                                            $sc = $sc + 2;
                                            last;
                                        }
                                        $sc = $sc + 1;
                                    }
                                } elsif ($k == '/' && $sc + 1 < $len && char_at($src, $sc + 1) == '/') {
                                    $sc = $sc + 2;
                                    while ($sc < $len && char_at($src, $sc) != '\n') { $sc = $sc + 1; }
                                } elsif ($k == '{') {
                                    $c_depth = $c_depth + 1;
                                    $sc = $sc + 1;
                                } elsif ($k == '}') {
                                    if ($c_depth > 0) { $c_depth = $c_depth - 1; }
                                    $sc = $sc + 1;
                                } else {
                                    $sc = $sc + 1;
                                }
                            }
                            if ($c_depth > 0) {
                                $lexer->{"pos"} = $sc;
                                lex_error($lexer, "Unterminated __C__ block", $c_line, 1);
                            }
                        }
                        $can_regex = 0;
                    } elsif ($kw eq "split" || $kw eq "return" || $kw eq "if" || $kw eq "elsif" || $kw eq "unless" || $kw eq "while" || $kw eq "until" || $kw eq "for" || $kw eq "die" || $kw eq "warn" || $kw eq "say" || $kw eq "print" || $kw eq "and" || $kw eq "or" || $kw eq "not" || $kw eq "eq" || $kw eq "ne" || $kw eq "cmp" || $kw eq "m" || $kw eq "qr" || $kw eq "s") {
                        $can_regex = 1;
                    } else {
                        $can_regex = 0;
                    }
                } else {
                    $sc = $sc + 1;
                    if ($cc == ')' || $cc == ']' || $cc == '}' || $cc == '$' || $cc == '@' || $cc == '%') {
                        $can_regex = 0;
                    } else {
                        $can_regex = 1;
                    }
                }
            }
            $pos = $sc;
        }
    }
    return "endif";
}

# Handle a directive at the current '#'. Returns 1 if it was one (and has
# been processed), 0 if this '#' is an ordinary comment.
func lex_pp_directive(scalar $lexer) int {
    my scalar $src = $lexer->{"source"};
    my int $pos = $lexer->{"pos"};
    my int $len = $lexer->{"length"};
    # must be the first non-blank thing on its line
    my int $bk = $pos - 1;
    while ($bk >= 0 && (char_at($src, $bk) == ' ' || char_at($src, $bk) == '\t')) { $bk = $bk - 1; }
    if ($bk >= 0 && char_at($src, $bk) != '\n') { return 0; }
    my str $word = lex_pp_word_at($src, $pos + 1, $len);
    if (lex_pp_is_directive($word) == 0) { return 0; }
    if (!defined($lexer->{"pp_defines"})) { lex_pp_init($lexer); }
    my int $dline = $lexer->{"line"};
    # argument start after directive word
    my int $q = $pos + 1 + length($word);
    while ($q < $len && (char_at($src, $q) == ' ' || char_at($src, $q) == '\t')) { $q = $q + 1; }
    my str $name = lex_pp_word_at($src, $q, $len);
    my int $eol = $q;
    while ($eol < $len && char_at($src, $eol) != '\n') { $eol = $eol + 1; }
    my str $rest = lex_pp_strip_comment(substr_bytes($src, $q, $eol - $q));
    $lexer->{"pos"} = $eol;
    $lexer->{"column"} = 1;
    my scalar $defs = $lexer->{"pp_defines"};
    if ($word eq "define") {
        if (length($name) > 0) {
            my int $vq = $q + length($name);
            while ($vq < $eol && (char_at($src, $vq) == ' ' || char_at($src, $vq) == '\t')) { $vq = $vq + 1; }
            my str $val = "1";
            if ($vq < $eol) {
                my str $rv = lex_pp_strip_comment(substr_bytes($src, $vq, $eol - $vq));
                if (length($rv) > 0) { $val = $rv; }
            }
            $defs->{$name} = $val;
        }
    } elsif ($word eq "undef") {
        if (length($name) > 0) { $defs->{$name} = "__STRADA_PP_UNDEF__"; }
    } elsif ($word eq "ifdef" || $word eq "ifndef" || $word eq "if") {
        my int $take = 0;
        if ($word eq "if") {
            if (lex_pp_eval_expr($lexer, $rest) != 0) { $take = 1; }
        } else {
            if (length($name) == 0) { lex_error($lexer, "#" . $word . " needs a name", $dline, 1); }
            my int $is_def = lex_pp_has_def($defs, $name);
            $take = $is_def;
            if ($word eq "ifndef") { $take = 1 - $is_def; }
        }
        if ($take == 1) {
            $lexer->{"pp_depth"} = $lexer->{"pp_depth"} + 1;
        } else {
            while (1) {
                my str $stop = lex_pp_skip($lexer, 1, $dline);
                if ($stop eq "else") {
                    $lexer->{"pp_depth"} = $lexer->{"pp_depth"} + 1;
                    last;
                } elsif (length($stop) >= 5 && substr($stop, 0, 5) eq "elif:") {
                    my str $eexpr = substr($stop, 5, length($stop) - 5);
                    if (lex_pp_eval_expr($lexer, $eexpr) != 0) {
                        $lexer->{"pp_depth"} = $lexer->{"pp_depth"} + 1;
                        last;
                    }
                } else {
                    last;
                }
            }
        }
    } elsif ($word eq "elif") {
        if ($lexer->{"pp_depth"} <= 0) { lex_error($lexer, "#elif without #if/#ifdef/#ifndef", $dline, 1); }
        lex_pp_skip($lexer, 0, $dline);
        $lexer->{"pp_depth"} = $lexer->{"pp_depth"} - 1;
    } elsif ($word eq "else") {
        if ($lexer->{"pp_depth"} <= 0) { lex_error($lexer, "#else without #if/#ifdef/#ifndef", $dline, 1); }
        lex_pp_skip($lexer, 0, $dline);
        $lexer->{"pp_depth"} = $lexer->{"pp_depth"} - 1;
    } elsif ($word eq "endif") {
        if ($lexer->{"pp_depth"} <= 0) { lex_error($lexer, "#endif without #if/#ifdef/#ifndef", $dline, 1); }
        $lexer->{"pp_depth"} = $lexer->{"pp_depth"} - 1;
    }
    return 1;
}

func lex_skip_comment(scalar $lexer) void {
    if (lex_current_code($lexer) != '#') {
        return;
    }

    # Skip until end of line (locals-cached scan; stops AT the newline,
    # matching the old per-char loop). Comments contain no newlines, so
    # line stays put and column just moves by the consumed count.
    my scalar $cm_source = $lexer->{"source"};
    my int $cm_pos = $lexer->{"pos"} + 1;
    my int $cm_len = $lexer->{"length"};
    while ($cm_pos < $cm_len && char_at($cm_source, $cm_pos) != '\n') {
        $cm_pos = $cm_pos + 1;
    }
    $lexer->{"column"} = $lexer->{"column"} + ($cm_pos - $lexer->{"pos"});
    $lexer->{"pos"} = $cm_pos;
}

func lex_skip_block_comment(scalar $lexer) void {
    my int $start_line = $lexer->{"line"};
    my int $start_col = $lexer->{"column"};
    # Suspend heredoc newline redirection inside /* ... */ so a multi-line
    # block comment following `<<EOT` on the same line isn't redirected mid-comment.
    my int $saved_hd_pos = $lexer->{"heredoc_resume_pos"};
    my int $saved_hd_line = $lexer->{"heredoc_resume_line"};
    $lexer->{"heredoc_resume_pos"} = 0;
    $lexer->{"heredoc_resume_line"} = 0;
    # Skip the opening /*
    lex_advance($lexer);
    lex_advance($lexer);

    # Skip until we find */
    while (1) {
        if (lex_at_end($lexer) == 1) {
            $lexer->{"heredoc_resume_pos"} = $saved_hd_pos;
            $lexer->{"heredoc_resume_line"} = $saved_hd_line;
            lex_error($lexer, "Unterminated block comment", $start_line, $start_col);
        }
        my int $code = lex_current_code($lexer);

        # Check for */
        if ($code == '*') {
            if ($lexer->{"pos"} + 1 < $lexer->{"length"}) {
                my int $next_code = char_at($lexer->{"source"}, $lexer->{"pos"} + 1);
                if ($next_code == '/') {
                    lex_advance($lexer);
                    lex_advance($lexer);
                    $lexer->{"heredoc_resume_pos"} = $saved_hd_pos;
                    $lexer->{"heredoc_resume_line"} = $saved_hd_line;
                    return;
                }
            }
        }

        lex_advance($lexer);
    }
}

# Check if current position starts a POD directive
# POD directives: =head1, =head2, =head3, =head4, =over, =item, =back, =pod, =cut, =begin, =end, =for
func lex_is_pod_start(scalar $lexer) int {
    my str $source = $lexer->{"source"};
    my int $pos = $lexer->{"pos"};
    my int $len = $lexer->{"length"};

    # Must start with '='
    if (char_at($source, $pos) != '=') {
        return 0;
    }

    # Check for POD keywords after '='
    # We need at least 4 chars for shortest: =pod, =for, =cut
    if ($pos + 4 > $len) {
        return 0;
    }

    my int $take = 5;
    if ($pos + 1 + $take > $len) { $take = $len - $pos - 1; }
    my str $word = substr_bytes($source, $pos + 1, $take);

    # Check prefixes using substr_bytes comparison
    if ($take >= 4 && substr_bytes($word, 0, 4) eq "head") { return 1; }
    if ($take >= 4 && substr_bytes($word, 0, 4) eq "over") { return 1; }
    if ($take >= 4 && substr_bytes($word, 0, 4) eq "item") { return 1; }
    if ($take >= 4 && substr_bytes($word, 0, 4) eq "back") { return 1; }
    if ($take >= 3 && substr_bytes($word, 0, 3) eq "pod") { return 1; }
    if ($take >= 3 && substr_bytes($word, 0, 3) eq "cut") { return 1; }
    if ($take >= 5 && substr_bytes($word, 0, 5) eq "begin") { return 1; }
    if ($take >= 3 && substr_bytes($word, 0, 3) eq "end") { return 1; }
    if ($take >= 3 && substr_bytes($word, 0, 3) eq "for") { return 1; }

    return 0;
}

# Skip POD block (from =pod/=head/etc to =cut)
func lex_skip_pod(scalar $lexer) void {
    my str $source = $lexer->{"source"};
    my int $len = $lexer->{"length"};

    # Skip until we find =cut at start of line
    while (1) {
        if (lex_at_end($lexer) == 1) {
            # EOF - POD extends to end of file (valid in Perl)
            return;
        }
        my int $code = lex_current_code($lexer);

        # Check for =cut at start of line
        if ($code == '=') {
            my int $pos = $lexer->{"pos"};
            if ($pos + 4 <= $len) {
                my str $word = substr_bytes($source, $pos + 1, 3);
                if ($word eq "cut") {
                    # Skip "=cut" and rest of line
                    lex_advance($lexer);  # =
                    lex_advance($lexer);  # c
                    lex_advance($lexer);  # u
                    lex_advance($lexer);  # t
                    # Skip to end of line
                    while (1) {
                        if (lex_at_end($lexer) == 1) {
                            return;
                        }
                        $code = lex_current_code($lexer);
                        if ($code == '\n') {
                            lex_advance($lexer);
                            return;
                        }
                        lex_advance($lexer);
                    }
                }
            }
        }

        # Skip to next line
        while (1) {
            if (lex_at_end($lexer) == 1) {
                return;
            }
            $code = lex_current_code($lexer);
            lex_advance($lexer);
            if ($code == '\n') {
                last;
            }
        }
    }
}

# Helper to check if char code is alphanumeric or underscore
func lex_is_ident_char(int $code) int {
    if ($code >= 'a' && $code <= 'z') { return 1; }
    if ($code >= 'A' && $code <= 'Z') { return 1; }
    if ($code >= '0' && $code <= '9') { return 1; }
    if ($code == '_') { return 1; }
    return 0;
}

# Hot path: scan to the end of the identifier with locals, then take ONE
# byte-substring — the old loop allocated a string per character (chr +
# sb_append) and re-probed the lexer hash per character. Identifiers
# contain no newlines, so line is unchanged and column moves by the
# consumed count.
func lex_read_identifier(scalar $lexer) str {
    my scalar $id_source = $lexer->{"source"};
    my int $id_pos = $lexer->{"pos"};
    my int $id_len = $lexer->{"length"};
    my int $id_start = $id_pos;

    while ($id_pos < $id_len) {
        if (lex_is_ident_char(char_at($id_source, $id_pos)) == 1) {
            $id_pos = $id_pos + 1;
        } else {
            last;
        }
    }

    $lexer->{"column"} = $lexer->{"column"} + ($id_pos - $id_start);
    $lexer->{"pos"} = $id_pos;
    return substr_bytes($id_source, $id_start, $id_pos - $id_start);
}

func lex_is_hex_digit_code(int $code) int {
    if ($code >= '0' && $code <= '9') { return 1; }
    if ($code >= 'a' && $code <= 'f') { return 1; }
    if ($code >= 'A' && $code <= 'F') { return 1; }
    return 0;
}

func lex_bin_digits_to_hex(str $bits) str {
    my int $blen = length($bits);
    if ($blen == 0) { return "0x0"; }
    my int $rem = $blen % 4;
    if ($rem != 0) {
        my int $pad = 4 - $rem;
        while ($pad > 0) {
            $bits = "0" . $bits;
            $pad = $pad - 1;
        }
    }
    my str $hex_chars = "0123456789abcdef";
    my scalar $hsb = sb_new();
    my int $pos = 0;
    my int $tlen = length($bits);
    my int $seen_nz = 0;
    while ($pos + 4 <= $tlen) {
        my int $v = 0;
        if (substr($bits, $pos, 1) eq "1") { $v = $v + 8; }
        if (substr($bits, $pos + 1, 1) eq "1") { $v = $v + 4; }
        if (substr($bits, $pos + 2, 1) eq "1") { $v = $v + 2; }
        if (substr($bits, $pos + 3, 1) eq "1") { $v = $v + 1; }
        if ($v != 0 || $seen_nz == 1) {
            sb_append($hsb, substr($hex_chars, $v, 1));
            $seen_nz = 1;
        }
        $pos = $pos + 4;
    }
    if ($seen_nz == 0) { return "0x0"; }
    return "0x" . sb_to_string($hsb);
}

func lex_oct_digits_to_hex(str $oct) str {
    my scalar $bsb = sb_new();
    my int $i = 0;
    my int $olen = length($oct);
    while ($i < $olen) {
        my int $d = ord(substr($oct, $i, 1)) - ord("0");
        if ($d == 0) { sb_append($bsb, "000"); }
        elsif ($d == 1) { sb_append($bsb, "001"); }
        elsif ($d == 2) { sb_append($bsb, "010"); }
        elsif ($d == 3) { sb_append($bsb, "011"); }
        elsif ($d == 4) { sb_append($bsb, "100"); }
        elsif ($d == 5) { sb_append($bsb, "101"); }
        elsif ($d == 6) { sb_append($bsb, "110"); }
        elsif ($d == 7) { sb_append($bsb, "111"); }
        $i = $i + 1;
    }
    return lex_bin_digits_to_hex(sb_to_string($bsb));
}

func lex_read_number(scalar $lexer) scalar {
    my scalar $sb = sb_new();
    my int $is_float = 0;
    my int $is_hex = 0;
    my int $is_bin = 0;
    my int $is_oct = 0;
    my int $token_line = $lexer->{"line"};

    # Check for 0x, 0b, 0o prefixes
    my int $first_code = lex_current_code($lexer);
    if ($first_code == '0') {
        lex_advance($lexer);
        my int $second_code = lex_current_code($lexer);
        if (!lex_at_end($lexer) && ($second_code == 'x' || $second_code == 'X')) {
            $is_hex = 1;
            sb_append($sb, "0x");
            lex_advance($lexer);
            if (lex_at_end($lexer) || !lex_is_hex_digit_code(lex_current_code($lexer))) {
                lex_error($lexer, "Invalid hexadecimal literal (missing hex digits after 0x)", $token_line, $lexer->{"tok_col"});
            }
        } elsif (!lex_at_end($lexer) && ($second_code == 'b' || $second_code == 'B')) {
            $is_bin = 1;
            lex_advance($lexer);
            my int $b0 = lex_current_code($lexer);
            if (lex_at_end($lexer) || ($b0 != '0' && $b0 != '1')) {
                lex_error($lexer, "Invalid binary literal (missing binary digits after 0b)", $token_line, $lexer->{"tok_col"});
            }
        } elsif (!lex_at_end($lexer) && ($second_code == 'o' || $second_code == 'O')) {
            $is_oct = 1;
            lex_advance($lexer);
            my int $o0 = lex_current_code($lexer);
            if (lex_at_end($lexer) || $o0 < '0' || $o0 > '7') {
                lex_error($lexer, "Invalid octal literal (missing octal digits after 0o)", $token_line, $lexer->{"tok_col"});
            }
        } else {
            sb_append($sb, "0");
        }
    }

    while (1) {
        if (lex_at_end($lexer) == 1) {
            my hash %token = ();
            if ($is_bin == 1) {
                $token{"type"} = "INT_LITERAL";
                $token{"value"} = lex_bin_digits_to_hex(sb_to_string($sb));
            } elsif ($is_oct == 1) {
                $token{"type"} = "INT_LITERAL";
                $token{"value"} = lex_oct_digits_to_hex(sb_to_string($sb));
            } elsif ($is_float) {
                $token{"type"} = "NUM_LITERAL";
                $token{"value"} = sb_to_string($sb);
            } else {
                $token{"type"} = "INT_LITERAL";
                $token{"value"} = sb_to_string($sb);
            }
            return \%token;
        }
        my int $code = lex_current_code($lexer);

        if ($is_hex) {
            if (lex_is_hex_digit_code($code)) {
                sb_append($sb, chr($code));
                lex_advance($lexer);
            } elsif ($code == '_' && lex_is_hex_digit_code(lex_peek_code($lexer, 1))) {
                lex_advance($lexer);
            } else {
                my hash %token = ();
                $token{"type"} = "INT_LITERAL";
                $token{"value"} = sb_to_string($sb);
                return \%token;
            }
        } elsif ($is_bin) {
            if ($code == '0' || $code == '1') {
                sb_append($sb, chr($code));
                lex_advance($lexer);
            } elsif ($code == '_') {
                my int $nb = lex_peek_code($lexer, 1);
                if ($nb == '0' || $nb == '1') {
                    lex_advance($lexer);
                } else {
                    my hash %token = ();
                    $token{"type"} = "INT_LITERAL";
                    $token{"value"} = lex_bin_digits_to_hex(sb_to_string($sb));
                    return \%token;
                }
            } else {
                my hash %token = ();
                $token{"type"} = "INT_LITERAL";
                $token{"value"} = lex_bin_digits_to_hex(sb_to_string($sb));
                return \%token;
            }
        } elsif ($is_oct) {
            if ($code >= '0' && $code <= '7') {
                sb_append($sb, chr($code));
                lex_advance($lexer);
            } elsif ($code == '_') {
                my int $no = lex_peek_code($lexer, 1);
                if ($no >= '0' && $no <= '7') {
                    lex_advance($lexer);
                } else {
                    my hash %token = ();
                    $token{"type"} = "INT_LITERAL";
                    $token{"value"} = lex_oct_digits_to_hex(sb_to_string($sb));
                    return \%token;
                }
            } else {
                my hash %token = ();
                $token{"type"} = "INT_LITERAL";
                $token{"value"} = lex_oct_digits_to_hex(sb_to_string($sb));
                return \%token;
            }
        } else {
            if ($code >= '0' && $code <= '9') {
                sb_append($sb, chr($code));
                lex_advance($lexer);
            } elsif ($code == '_') {
                my int $nd = lex_peek_code($lexer, 1);
                if ($nd >= '0' && $nd <= '9') {
                    lex_advance($lexer);
                } else {
                    my hash %token = ();
                    if ($is_float) {
                        $token{"type"} = "NUM_LITERAL";
                    } else {
                        $token{"type"} = "INT_LITERAL";
                    }
                    $token{"value"} = sb_to_string($sb);
                    return \%token;
                }
            } elsif ($code == '.' && $is_float == 0) {
                # Check for range operator before consuming dot
                my int $next_code = lex_peek_code($lexer, 1);
                if ($next_code == '.') {
                    my hash %token = ();
                    $token{"type"} = "INT_LITERAL";
                    $token{"value"} = sb_to_string($sb);
                    $token{"line"} = $token_line;
                    return \%token;
                }
                $is_float = 1;
                sb_append($sb, chr($code));
                lex_advance($lexer);
            } elsif (($code == 'e' || $code == 'E') && $is_hex == 0 && $is_bin == 0 && $is_oct == 0) {
                my int $e1 = lex_peek_code($lexer, 1);
                my int $has_exp = 0;
                my int $has_sign = 0;
                if ($e1 >= '0' && $e1 <= '9') {
                    $has_exp = 1;
                } elsif ($e1 == '+' || $e1 == '-') {
                    my int $e2 = lex_peek_code($lexer, 2);
                    if ($e2 >= '0' && $e2 <= '9') {
                        $has_exp = 1;
                        $has_sign = 1;
                    }
                }
                if ($has_exp == 1) {
                    sb_append($sb, chr($code));
                    lex_advance($lexer);
                    if ($has_sign == 1) {
                        sb_append($sb, chr($e1));
                        lex_advance($lexer);
                    }
                    while (!lex_at_end($lexer)) {
                        my int $ec = lex_current_code($lexer);
                        if ($ec >= '0' && $ec <= '9') {
                            sb_append($sb, chr($ec));
                            lex_advance($lexer);
                        } elsif ($ec == '_' && lex_peek_code($lexer, 1) >= '0' && lex_peek_code($lexer, 1) <= '9') {
                            lex_advance($lexer);
                        } else {
                            last;
                        }
                    }
                    my hash %etok = ();
                    $etok{"type"} = "NUM_LITERAL";
                    $etok{"value"} = sb_to_string($sb);
                    return \%etok;
                }
                my hash %token = ();
                if ($is_float) {
                    $token{"type"} = "NUM_LITERAL";
                } else {
                    $token{"type"} = "INT_LITERAL";
                }
                $token{"value"} = sb_to_string($sb);
                return \%token;
            } else {
                my hash %token = ();
                if ($is_float) {
                    $token{"type"} = "NUM_LITERAL";
                } else {
                    $token{"type"} = "INT_LITERAL";
                }
                $token{"value"} = sb_to_string($sb);
                return \%token;
            }
        }
    }
}

func lex_sq_hex_val(int $c) int {
    if ($c >= '0' && $c <= '9') { return $c - ord("0"); }
    if ($c >= 'a' && $c <= 'f') { return $c - ord("a") + 10; }
    if ($c >= 'A' && $c <= 'F') { return $c - ord("A") + 10; }
    return 0 - 1;
}

func lex_parse_sq_char_code(str $source, int $raw_start, int $raw_len) int {
    if ($raw_len == 1) {
        my int $c0 = char_at($source, $raw_start);
        if ($c0 >= 0 && $c0 <= 255) {
            return $c0;
        }
        return 0 - 1;
    }
    if ($raw_len >= 2 && char_at($source, $raw_start) == '\\') {
        my int $c1 = char_at($source, $raw_start + 1);
        if ($raw_len == 2) {
            if ($c1 == 'n') { return 10; }
            if ($c1 == 't') { return 9; }
            if ($c1 == 'r') { return 13; }
            if ($c1 == 'a') { return 7; }
            if ($c1 == 'b') { return 8; }
            if ($c1 == 'f') { return 12; }
            if ($c1 == 'v') { return 11; }
            if ($c1 == 'e') { return 27; }
            if ($c1 == '\\') { return 92; }
            if ($c1 == '\'') { return 39; }
            if ($c1 == '"') { return 34; }
        }
        if ($raw_len == 4 && ($c1 == 'x' || $c1 == 'X')) {
            my int $hi = lex_sq_hex_val(char_at($source, $raw_start + 2));
            my int $lo = lex_sq_hex_val(char_at($source, $raw_start + 3));
            if ($hi >= 0 && $lo >= 0) {
                return ($hi * 16) + $lo;
            }
            return 0 - 1;
        }
        if ($raw_len >= 2 && $raw_len <= 4) {
            my int $ov = 0;
            my int $i = 1;
            while ($i < $raw_len) {
                my int $oc = char_at($source, $raw_start + $i);
                if ($oc < '0' || $oc > '7') {
                    return 0 - 1;
                }
                $ov = ($ov * 8) + ($oc - ord("0"));
                $i = $i + 1;
            }
            if ($ov <= 255) {
                return $ov;
            }
            return 0 - 1;
        }
    }
    return 0 - 1;
}

# Read a single-quoted string (no interpolation) - optimized with char codes
func lex_read_sq_string(scalar $lexer) str {
    my int $start_line = $lexer->{"line"};
    my int $start_col = $lexer->{"column"};
    lex_advance($lexer); # Skip opening quote
    my scalar $sb = sb_new();
    my str $source = $lexer->{"source"};

    while (1) {
        if (lex_at_end($lexer) == 1) {
            lex_error($lexer, "Unterminated string", $start_line, $start_col);
        }
        my int $code = lex_current_code($lexer);
        my int $pos = $lexer->{"pos"};

        if ($code == '\'') {
            lex_advance($lexer); # Skip closing quote
            return sb_to_string($sb);
        }

        if ($code == '\\') {
            lex_advance($lexer);
            if (lex_at_end($lexer) == 1) {
                lex_error($lexer, "Unterminated string", $start_line, $start_col);
            }
            my int $next_code = lex_current_code($lexer);
            my int $next_pos = $lexer->{"pos"};
            if ($next_code == '\'' || $next_code == '\\') {
                sb_append($sb, substr_bytes($source, $next_pos, 1));
            } else {
                # In single quotes, backslash is literal except for \' and \\
                sb_append($sb, "\\");
                sb_append($sb, substr_bytes($source, $next_pos, 1));
            }
            lex_advance($lexer);
        } else {
            # Use substr_bytes for byte-level extraction
            sb_append($sb, substr_bytes($source, $pos, 1));
            lex_advance($lexer);
        }
    }
}

# Helper: consume \uXXXX or \u{HEX} after seeing 'u'; combines surrogate pairs.
func lex_read_u_escape(scalar $lexer) str {
    lex_advance($lexer);  # consume 'u'
    my int $pk_code = lex_current_code($lexer);
    if (!lex_at_end($lexer) && $pk_code == '{') {
        lex_advance($lexer);  # consume '{'
        my int $hv = 0;
        while (!lex_at_end($lexer)) {
            my int $hcc = lex_current_code($lexer);
            if ($hcc == '}') { last; }
            my int $hd = -1;
            if ($hcc >= '0' && $hcc <= '9') { $hd = $hcc - ord("0"); }
            elsif ($hcc >= 'a' && $hcc <= 'f') { $hd = $hcc - ord("a") + 10; }
            elsif ($hcc >= 'A' && $hcc <= 'F') { $hd = $hcc - ord("A") + 10; }
            else { last; }
            $hv = $hv * 16 + $hd;
            lex_advance($lexer);
        }
        if (!lex_at_end($lexer) && lex_current_code($lexer) == '}') { lex_advance($lexer); }
        return chr($hv);
    }
    my int $hv = 0;
    my int $hi = 0;
    while ($hi < 4 && !lex_at_end($lexer)) {
        my int $hcc = lex_current_code($lexer);
        my int $hd = -1;
        if ($hcc >= '0' && $hcc <= '9') { $hd = $hcc - ord("0"); }
        elsif ($hcc >= 'a' && $hcc <= 'f') { $hd = $hcc - ord("a") + 10; }
        elsif ($hcc >= 'A' && $hcc <= 'F') { $hd = $hcc - ord("A") + 10; }
        else { last; }
        $hv = $hv * 16 + $hd;
        lex_advance($lexer);
        $hi = $hi + 1;
    }
    # UTF-16 surrogate pair combining: \uD800..\uDBFF followed immediately by \uDC00..\uDFFF
    if ($hv >= 55296 && $hv <= 56319 && $hi == 4) {
        if (lex_peek_code($lexer, 0) == '\\' && lex_peek_code($lexer, 1) == 'u') {
            my int $save_pos = $lexer->{"pos"};
            my int $save_line = $lexer->{"line"};
            my int $save_col = $lexer->{"column"};
            lex_advance($lexer);  # '\'
            lex_advance($lexer);  # 'u'
            my int $lv = 0;
            my int $li = 0;
            while ($li < 4 && !lex_at_end($lexer)) {
                my int $lcc = lex_current_code($lexer);
                my int $ld = -1;
                if ($lcc >= '0' && $lcc <= '9') { $ld = $lcc - ord("0"); }
                elsif ($lcc >= 'a' && $lcc <= 'f') { $ld = $lcc - ord("a") + 10; }
                elsif ($lcc >= 'A' && $lcc <= 'F') { $ld = $lcc - ord("A") + 10; }
                else { last; }
                $lv = $lv * 16 + $ld;
                lex_advance($lexer);
                $li = $li + 1;
            }
            if ($li == 4 && $lv >= 56320 && $lv <= 57343) {
                my int $cp = 65536 + (($hv - 55296) * 1024) + ($lv - 56320);
                return chr($cp);
            }
            $lexer->{"pos"} = $save_pos;
            $lexer->{"line"} = $save_line;
            $lexer->{"column"} = $save_col;
        }
    }
    return chr($hv);
}

# Read ${...} interpolation body with balanced brace and quote tracking so nested
# hash/code braces and strings (e.g. "${$h{"k"}}") do not truncate at the first '}'.
func lex_read_braced_interp(scalar $lexer, int $token_line, str $err_msg) str {
    lex_advance($lexer); # Skip opening {
    my scalar $ivar_sb = sb_new();
    my str $source = $lexer->{"source"};
    my int $depth = 1;
    my int $in_sq = 0;
    my int $in_dq = 0;
    my int $esc = 0;

    while (1) {
        if (lex_at_end($lexer) == 1) {
            lex_error($lexer, $err_msg, $token_line, $lexer->{"tok_col"});
        }
        my int $vc = lex_current_code($lexer);
        my int $vpos = $lexer->{"pos"};
        if ($esc == 1) {
            $esc = 0;
            sb_append($ivar_sb, substr_bytes($source, $vpos, 1));
            lex_advance($lexer);
            next;
        }
        if ($in_sq == 1) {
            if ($vc == '\\') { $esc = 1; }
            elsif ($vc == '\'') { $in_sq = 0; }
            sb_append($ivar_sb, substr_bytes($source, $vpos, 1));
            lex_advance($lexer);
            next;
        }
        if ($in_dq == 1) {
            if ($vc == '\\') { $esc = 1; }
            elsif ($vc == '"') { $in_dq = 0; }
            sb_append($ivar_sb, substr_bytes($source, $vpos, 1));
            lex_advance($lexer);
            next;
        }
        if ($vc == '\'') {
            $in_sq = 1;
        } elsif ($vc == '"') {
            $in_dq = 1;
        } elsif ($vc == '{') {
            $depth = $depth + 1;
        } elsif ($vc == '}') {
            $depth = $depth - 1;
            if ($depth == 0) {
                lex_advance($lexer); # Skip closing }
                my str $ivar = sb_to_string($ivar_sb);
                if (length($ivar) == 0) {
                    lex_error($lexer, "Empty variable name in interpolation", $lexer->{"line"}, $lexer->{"column"});
                }
                return $ivar;
            }
        }
        sb_append($ivar_sb, substr_bytes($source, $vpos, 1));
        lex_advance($lexer);
    }
}

# Read a double-quoted string (with interpolation support) - optimized with char codes
func lex_read_dq_string(scalar $lexer, int $token_line) scalar {
    lex_advance($lexer); # Skip opening quote
    return lex_dq_content($lexer, 34, $token_line);
}

# Scan double-quoted-string content from the lexer stream — processing escapes
# (\n \t \r \xHH \x{..} \\ \" \$ ...) and ${...} interpolation — until the
# terminator code: 34 for a "..." literal, or 0 (EOF) for a heredoc body scanned
# through a sub-lexer (lex_new over the body). Returns an INTERP_STRING token
# (parts/vars) when interpolation occurred, else a STR_LITERAL. Reused so bare
# <<EOT and <<"EOT" heredocs interpolate/escape exactly like "..." / qq().
func lex_dq_content(scalar $lexer, int $term_code, int $token_line) scalar {
    my scalar $sb = sb_new();  # StringBuilder for current part
    my str $source = $lexer->{"source"};
    my array @parts = ();
    my array @vars = ();
    my int $has_interp = 0;
    my int $var_count = 0;

    while (1) {
        my int $at_end = lex_at_end($lexer);
        my int $code = lex_current_code($lexer);
        my int $pos = $lexer->{"pos"};

        if ($term_code == 0) {
            if ($at_end == 1) {
                if ($has_interp) {
                    push(\@parts, sb_to_string($sb));
                    my hash %token = ();
                    $token{"type"} = "INTERP_STRING";
                    $token{"parts"} = \@parts;
                    $token{"vars"} = \@vars;
                    $token{"var_count"} = $var_count;
                    $token{"line"} = $token_line;
                    return \%token;
                } else {
                    my hash %token = ();
                    $token{"type"} = "STR_LITERAL";
                    $token{"value"} = sb_to_string($sb);
                    $token{"line"} = $token_line;
                    return \%token;
                }
            }
        } elsif ($at_end == 1) {
            lex_error($lexer, "Unterminated string", $token_line, $lexer->{"tok_col"});
        } elsif ($code == $term_code) {
            lex_advance($lexer); # Skip closing quote (string case)
            if ($has_interp) {
                # Return interpolated string token
                push(\@parts, sb_to_string($sb));
                my hash %token = ();
                $token{"type"} = "INTERP_STRING";
                $token{"parts"} = \@parts;
                $token{"vars"} = \@vars;
                $token{"var_count"} = $var_count;
                $token{"line"} = $token_line;
                return \%token;
            } else {
                # Return regular string token
                my hash %token = ();
                $token{"type"} = "STR_LITERAL";
                $token{"value"} = sb_to_string($sb);
                $token{"line"} = $token_line;
                return \%token;
            }
        }

        if ($code == '\\') {
            lex_advance($lexer);
            if (lex_at_end($lexer) == 1) {
                if ($term_code == 0) {
                    sb_append($sb, "\\");
                    next;
                }
                lex_error($lexer, "Unterminated string", $token_line, $lexer->{"tok_col"});
            }
            my int $next_code = lex_current_code($lexer);
            my int $next_pos = $lexer->{"pos"};

            if ($next_code == 'n') {
                sb_append($sb, "\n");
            } elsif ($next_code == 't') {
                sb_append($sb, "\t");
            } elsif ($next_code == 'r') {
                sb_append($sb, "\r");
            } elsif ($next_code >= '0' && $next_code <= '7') {
                # 1-3 octal digits (\0 .. \377, clamped to <= 255)
                my int $ov = 0;
                my int $oi = 0;
                while ($oi < 3 && !lex_at_end($lexer)) {
                    my int $oc = lex_current_code($lexer);
                    if ($oc < '0' || $oc > '7') { last; }
                    my int $nov = $ov * 8 + ($oc - ord("0"));
                    if ($nov > 255) { last; }
                    $ov = $nov;
                    lex_advance($lexer);
                    $oi = $oi + 1;
                }
                sb_append($sb, chr($ov));
                next;
            } elsif ($next_code == 'a') {
                sb_append($sb, chr(7));
            } elsif ($next_code == 'b') {
                sb_append($sb, chr(8));
            } elsif ($next_code == 'f') {
                sb_append($sb, chr(12));
            } elsif ($next_code == 'v') {
                sb_append($sb, chr(11));
            } elsif ($next_code == 'e') {
                sb_append($sb, chr(27));
            } elsif ($next_code == 'u') {
                sb_append($sb, lex_read_u_escape($lexer));
                next;
            } elsif ($next_code == 'x') {
                # \xHH or \x{HEX} hex byte escape — Perl-compatible
                lex_advance($lexer);  # consume the 'x'
                my int $pk_code = lex_current_code($lexer);
                if (!lex_at_end($lexer) && $pk_code == '{') {
                    # \x{HEX} — multi-digit hex codepoint
                    lex_advance($lexer);  # consume '{'
                    my int $hv = 0;
                    while (!lex_at_end($lexer)) {
                        my int $hcc = lex_current_code($lexer);
                        if ($hcc == '}') { last; }
                        my int $hd = -1;
                        if ($hcc >= '0' && $hcc <= '9') { $hd = $hcc - ord("0"); }
                        elsif ($hcc >= 'a' && $hcc <= 'f') { $hd = $hcc - ord("a") + 10; }
                        elsif ($hcc >= 'A' && $hcc <= 'F') { $hd = $hcc - ord("A") + 10; }
                        else { last; }
                        $hv = $hv * 16 + $hd;
                        lex_advance($lexer);
                    }
                    if (!lex_at_end($lexer) && lex_current_code($lexer) == '}') { lex_advance($lexer); }
                    sb_append($sb, chr($hv));
                    next;
                } else {
                    # \xHH — up to 2 hex digits, single byte
                    my int $hv = 0;
                    my int $hi = 0;
                    while ($hi < 2 && !lex_at_end($lexer)) {
                        my int $hcc = lex_current_code($lexer);
                        my int $hd = -1;
                        if ($hcc >= '0' && $hcc <= '9') { $hd = $hcc - ord("0"); }
                        elsif ($hcc >= 'a' && $hcc <= 'f') { $hd = $hcc - ord("a") + 10; }
                        elsif ($hcc >= 'A' && $hcc <= 'F') { $hd = $hcc - ord("A") + 10; }
                        else { last; }
                        $hv = $hv * 16 + $hd;
                        lex_advance($lexer);
                        $hi = $hi + 1;
                    }
                    sb_append($sb, chr($hv));
                    next;
                }
            } elsif ($next_code == '\\') {
                sb_append($sb, "\\");
            } elsif ($next_code == '"') {
                sb_append($sb, "\"");
            } elsif ($next_code == '$') {
                # Escaped dollar sign - literal $
                sb_append($sb, "$");
            } else {
                # Use substr_bytes for byte-level extraction
                sb_append($sb, substr_bytes($source, $next_pos, 1));
            }
            lex_advance($lexer);
        } elsif ($code == '$') {
            # Check for interpolation ${varname}
            lex_advance($lexer);
            my int $peek_code = lex_current_code($lexer);

            if (!lex_at_end($lexer) && $peek_code == '{') {
                my str $ivar = lex_read_braced_interp($lexer, $token_line, "Unterminated interpolation in string");
                push(\@parts, sb_to_string($sb));
                push(\@vars, $ivar);
                $var_count = $var_count + 1;
                $sb = sb_new();  # Reset StringBuilder
                $has_interp = 1;
            } else {
                # Just a literal $ not followed by {
                sb_append($sb, "$");
            }
        } else {
            # Use substr_bytes for byte-level extraction
            sb_append($sb, substr_bytes($source, $pos, 1));
            lex_advance($lexer);
        }
    }
}

# Legacy function for compatibility
func lex_read_string(scalar $lexer) str {
    my int $start_line = $lexer->{"line"};
    my int $start_col = $lexer->{"column"};
    my str $quote = lex_current_char($lexer);
    lex_advance($lexer); # Skip opening quote

    my str $result = "";

    while (1) {
        if (lex_at_end($lexer) == 1) {
            lex_error($lexer, "Unterminated string", $start_line, $start_col);
        }
        my str $ch = lex_current_char($lexer);

        if ($ch eq $quote) {
            lex_advance($lexer); # Skip closing quote
            return $result;
        }

        if ($ch eq "\\") {
            lex_advance($lexer);
            if (lex_at_end($lexer) == 1) {
                lex_error($lexer, "Unterminated string", $start_line, $start_col);
            }
            my int $ncode = lex_current_code($lexer);
            my str $nextch = lex_current_char($lexer);

            if ($nextch eq "n") {
                $result = $result . "\n";
            } elsif ($nextch eq "t") {
                $result = $result . "\t";
            } elsif ($nextch eq "r") {
                $result = $result . "\r";
            } elsif ($ncode >= '0' && $ncode <= '7') {
                my int $ov = 0;
                my int $oi = 0;
                while ($oi < 3 && !lex_at_end($lexer)) {
                    my int $oc = lex_current_code($lexer);
                    if ($oc < '0' || $oc > '7') { last; }
                    my int $nov = $ov * 8 + ($oc - ord("0"));
                    if ($nov > 255) { last; }
                    $ov = $nov;
                    lex_advance($lexer);
                    $oi = $oi + 1;
                }
                $result = $result . chr($ov);
                next;
            } elsif ($nextch eq "a") {
                # Bell/alert
                $result = $result . chr(7);
            } elsif ($nextch eq "b") {
                # Backspace
                $result = $result . chr(8);
            } elsif ($nextch eq "f") {
                # Form feed
                $result = $result . chr(12);
            } elsif ($nextch eq "v") {
                # Vertical tab
                $result = $result . chr(11);
            } elsif ($nextch eq "e") {
                # Escape character
                $result = $result . chr(27);
            } elsif ($nextch eq "u") {
                $result = $result . lex_read_u_escape($lexer);
                next;
            } elsif ($nextch eq "x") {
                # \xHH or \x{HEX} hex byte escape — Perl-compatible
                lex_advance($lexer);  # consume the 'x'
                my str $pk = lex_current_char($lexer);
                if ($pk eq "{") {
                    lex_advance($lexer);  # consume '{'
                    my int $hv = 0;
                    while (!lex_at_end($lexer)) {
                        my str $hc = lex_current_char($lexer);
                        if ($hc eq "}") { last; }
                        my int $hd = -1;
                        if ($hc ge "0" && $hc le "9") { $hd = char_at($hc, 0) - ord("0"); }
                        elsif ($hc ge "a" && $hc le "f") { $hd = char_at($hc, 0) - ord("a") + 10; }
                        elsif ($hc ge "A" && $hc le "F") { $hd = char_at($hc, 0) - ord("A") + 10; }
                        else { last; }
                        $hv = $hv * 16 + $hd;
                        lex_advance($lexer);
                    }
                    if (!lex_at_end($lexer) && lex_current_char($lexer) eq "}") { lex_advance($lexer); }
                    $result = $result . chr($hv);
                    next;
                } else {
                    # Up to 2 hex digits — single byte
                    my int $hv = 0;
                    my int $hi = 0;
                    while ($hi < 2 && !lex_at_end($lexer)) {
                        my str $hc = lex_current_char($lexer);
                        my int $hd = -1;
                        if ($hc ge "0" && $hc le "9") { $hd = char_at($hc, 0) - ord("0"); }
                        elsif ($hc ge "a" && $hc le "f") { $hd = char_at($hc, 0) - ord("a") + 10; }
                        elsif ($hc ge "A" && $hc le "F") { $hd = char_at($hc, 0) - ord("A") + 10; }
                        else { last; }
                        $hv = $hv * 16 + $hd;
                        lex_advance($lexer);
                        $hi = $hi + 1;
                    }
                    $result = $result . chr($hv);
                    next;
                }
            } elsif ($nextch eq "\\") {
                $result = $result . "\\";
            } elsif ($nextch eq $quote) {
                $result = $result . $quote;
            } else {
                # Unknown escape - just include the character as-is
                $result = $result . $nextch;
            }

            lex_advance($lexer);
        } else {
            $result = $result . $ch;
            lex_advance($lexer);
        }
    }
}

func lex_at_end(scalar $lexer) int {
    if ($lexer->{"pos"} >= $lexer->{"length"}) {
        return 1;
    }
    return 0;
}

func lex_current(scalar $lexer) str {
    return lex_current_char($lexer);
}

func lex_peek_char(scalar $lexer, int $offset) str {
    my int $pos = $lexer->{"pos"} + $offset;
    if ($pos >= $lexer->{"length"}) {
        return "";
    }
    return substr_bytes($lexer->{"source"}, $pos, 1);
}

func lex_read_regex_literal(scalar $lexer, int $token_line) scalar {
    lex_advance($lexer);  # Skip opening /
    my scalar $sb = sb_new();
    my str $source = $lexer->{"source"};

    while (!lex_at_end($lexer)) {
        my int $code = lex_current_code($lexer);
        if ($code == '/') {
            lex_advance($lexer);
            # Read optional flags
            my scalar $flags_sb = sb_new();
            while (!lex_at_end($lexer)) {
                my int $f = lex_current_code($lexer);
                if ($f == 'g' || $f == 'i' || $f == 'm' || $f == 's' || $f == 'x') {
                    sb_append($flags_sb, chr($f));
                    lex_advance($lexer);
                } else {
                    last;
                }
            }
            my hash %token = ();
            $token{"type"} = "REGEX_LITERAL";
            $token{"pattern"} = sb_to_string($sb);
            $token{"flags"} = sb_to_string($flags_sb);
            $token{"line"} = $token_line;
            return \%token;
        }
        if ($code == '\\') {
            lex_advance($lexer);
            if (lex_at_end($lexer)) {
                last;
            }
            my int $escaped = lex_current_code($lexer);
            if ($escaped == '/') {
                # Escaped slash - just add the slash
                sb_append($sb, "/");
            } else {
                # Keep backslash for regex escapes (including \n, \t, \r so /x ignores literal whitespace only)
                sb_append($sb, "\\");
                sb_append($sb, substr_bytes($source, $lexer->{"pos"}, 1));
            }
            lex_advance($lexer);
        } else {
            sb_append($sb, substr_bytes($source, $lexer->{"pos"}, 1));
            lex_advance($lexer);
        }
    }
    lex_error($lexer, "Unterminated regex literal", $token_line, $lexer->{"tok_col"});
}

func lex_unescape_subst_repl(str $raw) str {
    my scalar $out = sb_new();
    my int $len = bytes($raw);
    my int $i = 0;
    while ($i < $len) {
        my int $c = char_at($raw, $i);
        if ($c == '\\' && $i + 1 < $len) {
            my int $esc = char_at($raw, $i + 1);
            if ($esc == 'n') {
                sb_append($out, "\n");
            } elsif ($esc == 't') {
                sb_append($out, "\t");
            } elsif ($esc == 'r') {
                sb_append($out, "\r");
            } else {
                sb_append($out, "\\");
                sb_append($out, substr_bytes($raw, $i + 1, 1));
            }
            $i = $i + 2;
        } else {
            sb_append($out, substr_bytes($raw, $i, 1));
            $i = $i + 1;
        }
    }
    return sb_to_string($out);
}

func lex_read_subst_literal(scalar $lexer, int $token_line) scalar {
    lex_advance($lexer);  # Skip 's'
    lex_advance($lexer);  # Skip opening /
    my str $source = $lexer->{"source"};

    # Read pattern
    my scalar $pattern_sb = sb_new();
    my int $found_pat_end = 0;
    while (!lex_at_end($lexer)) {
        my int $code = lex_current_code($lexer);
        if ($code == '/') {
            lex_advance($lexer);
            $found_pat_end = 1;
            last;
        }
        if ($code == '\\') {
            lex_advance($lexer);
            if (lex_at_end($lexer)) {
                last;
            }
            my int $escaped = lex_current_code($lexer);
            if ($escaped == '/') {
                sb_append($pattern_sb, "/");
            } else {
                # Keep backslash for regex escapes (including \n, \t, \r so /x ignores literal whitespace only)
                sb_append($pattern_sb, "\\");
                sb_append($pattern_sb, substr_bytes($source, $lexer->{"pos"}, 1));
            }
            lex_advance($lexer);
        } else {
            sb_append($pattern_sb, substr_bytes($source, $lexer->{"pos"}, 1));
            lex_advance($lexer);
        }
    }

    if ($found_pat_end == 0) {
        lex_error($lexer, "Unterminated substitution literal", $token_line, $lexer->{"tok_col"});
    }

    # Read raw replacement (unescaping only \/ delimiter; other escapes are
    # interpreted after flags are known so /e code keeps its string escapes!)
    my scalar $repl_sb = sb_new();
    my int $found_repl_end = 0;
    while (!lex_at_end($lexer)) {
        my int $code = lex_current_code($lexer);
        if ($code == '/') {
            lex_advance($lexer);
            $found_repl_end = 1;
            last;
        }
        if ($code == '\\') {
            lex_advance($lexer);
            if (lex_at_end($lexer)) {
                last;
            }
            my int $escaped = lex_current_code($lexer);
            if ($escaped == '/') {
                sb_append($repl_sb, "/");
            } else {
                sb_append($repl_sb, "\\");
                sb_append($repl_sb, substr_bytes($source, $lexer->{"pos"}, 1));
            }
            lex_advance($lexer);
        } else {
            sb_append($repl_sb, substr_bytes($source, $lexer->{"pos"}, 1));
            lex_advance($lexer);
        }
    }

    if ($found_repl_end == 0) {
        lex_error($lexer, "Unterminated substitution literal", $token_line, $lexer->{"tok_col"});
    }

    # Read flags
    my scalar $flags_sb = sb_new();
    while (!lex_at_end($lexer)) {
        my int $f = lex_current_code($lexer);
        if ($f == 'g' || $f == 'i' || $f == 'm' || $f == 's' || $f == 'x' || $f == 'e' || $f == 'r') {
            sb_append($flags_sb, chr($f));
            lex_advance($lexer);
        } else {
            last;
        }
    }

    my str $flags_str = sb_to_string($flags_sb);
    my str $repl_str = sb_to_string($repl_sb);
    if (index($flags_str, "e") < 0) {
        $repl_str = lex_unescape_subst_repl($repl_str);
    }

    my hash %token = ();
    $token{"type"} = "SUBST_LITERAL";
    $token{"pattern"} = sb_to_string($pattern_sb);
    $token{"replacement"} = $repl_str;
    $token{"flags"} = $flags_str;
    $token{"line"} = $token_line;
    return \%token;
}

func lex_read_tr_literal(scalar $lexer, int $token_line, int $skip_count) scalar {
    # Skip 'tr' or 'y' (skip_count chars) then the opening /
    my int $sc = 0;
    while ($sc < $skip_count) {
        lex_advance($lexer);
        $sc = $sc + 1;
    }
    lex_advance($lexer);  # Skip opening /
    my str $source = $lexer->{"source"};

    # Read search list
    my scalar $search_sb = sb_new();
    my int $found_search_end = 0;
    while (!lex_at_end($lexer)) {
        my int $code = lex_current_code($lexer);
        if ($code == '/') {
            lex_advance($lexer);
            $found_search_end = 1;
            last;
        }
        if ($code == '\\') {
            lex_advance($lexer);
            if (lex_at_end($lexer)) {
                last;
            }
            my int $escaped = lex_current_code($lexer);
            if ($escaped == '/') {
                sb_append($search_sb, "/");
            } else {
                sb_append($search_sb, "\\");
                sb_append($search_sb, substr_bytes($source, $lexer->{"pos"}, 1));
            }
            lex_advance($lexer);
        } else {
            sb_append($search_sb, substr_bytes($source, $lexer->{"pos"}, 1));
            lex_advance($lexer);
        }
    }

    if ($found_search_end == 0) {
        lex_error($lexer, "Unterminated transliteration literal", $token_line, $lexer->{"tok_col"});
    }

    # Read replacement list
    my scalar $repl_sb = sb_new();
    my int $found_repl_end = 0;
    while (!lex_at_end($lexer)) {
        my int $code = lex_current_code($lexer);
        if ($code == '/') {
            lex_advance($lexer);
            $found_repl_end = 1;
            last;
        }
        if ($code == '\\') {
            lex_advance($lexer);
            if (lex_at_end($lexer)) {
                last;
            }
            my int $escaped = lex_current_code($lexer);
            if ($escaped == '/') {
                sb_append($repl_sb, "/");
            } else {
                sb_append($repl_sb, "\\");
                sb_append($repl_sb, substr_bytes($source, $lexer->{"pos"}, 1));
            }
            lex_advance($lexer);
        } else {
            sb_append($repl_sb, substr_bytes($source, $lexer->{"pos"}, 1));
            lex_advance($lexer);
        }
    }

    if ($found_repl_end == 0) {
        lex_error($lexer, "Unterminated transliteration literal", $token_line, $lexer->{"tok_col"});
    }

    # Read flags
    my scalar $flags_sb = sb_new();
    while (!lex_at_end($lexer)) {
        my int $f = lex_current_code($lexer);
        if ($f == 'c' || $f == 'd' || $f == 's' || $f == 'r') {
            sb_append($flags_sb, chr($f));
            lex_advance($lexer);
        } else {
            last;
        }
    }

    my hash %token = ();
    $token{"type"} = "TR_LITERAL";
    $token{"search"} = sb_to_string($search_sb);
    $token{"replace"} = sb_to_string($repl_sb);
    $token{"flags"} = sb_to_string($flags_sb);
    $token{"line"} = $token_line;
    return \%token;
}

# Get matching close delimiter for open delimiter
func lex_get_close_delim(str $open) str {
    if ($open eq "(") { return ")"; }
    if ($open eq "[") { return "]"; }
    if ($open eq "{") { return "}"; }
    if ($open eq "<") { return ">"; }
    # For other delimiters, close is same as open
    return $open;
}

# Read qw() - quote words, returns array of words
func lex_read_qw(scalar $lexer, int $token_line) scalar {
    # Current position should be at the delimiter after 'qw'
    my str $open = lex_current_char($lexer);
    my str $close = lex_get_close_delim($open);
    lex_advance($lexer);  # Skip open delimiter

    my array @words = ();
    my scalar $word_sb = sb_new();
    my int $word_len = 0;
    my int $count = 0;

    while (!lex_at_end($lexer)) {
        my str $ch = lex_current_char($lexer);

        if ($ch eq $close) {
            # End of qw - save last word if any
            if ($word_len > 0) {
                push(@words, sb_to_string($word_sb));
                $count = $count + 1;
            }
            lex_advance($lexer);  # Skip close delimiter

            my hash %token = ();
            $token{"type"} = "QW_LITERAL";
            $token{"words"} = \@words;
            $token{"word_count"} = $count;
            $token{"line"} = $token_line;
            return \%token;
        }

        if ($ch eq " " || $ch eq "\t" || $ch eq "\n" || $ch eq "\r") {
            # Whitespace - save current word if any
            if ($word_len > 0) {
                push(@words, sb_to_string($word_sb));
                $count = $count + 1;
                $word_sb = sb_new();
                $word_len = 0;
            }
            lex_advance($lexer);
        } else {
            # Regular character - add to current word
            sb_append($word_sb, $ch);
            $word_len = $word_len + 1;
            lex_advance($lexer);
        }
    }

    lex_error($lexer, "Unterminated qw()", $token_line, $lexer->{"tok_col"});
}

# Read q() or qq() - single/double quoted string with custom delimiters
# is_qq: 1 for qq() (supports escape sequences like \n, \t), 0 for q() (literal)
func lex_read_q_string(scalar $lexer, int $token_line, int $is_qq) scalar {
    my str $open = lex_current_char($lexer);
    my str $close = lex_get_close_delim($open);
    lex_advance($lexer);  # Skip open delimiter

    my scalar $sb = sb_new();
    my int $depth = 1;  # For nested delimiters like q(a(b)c)
    my int $handled = 0;

    # Interpolation tracking for qq()
    my array @parts = ();
    my array @vars = ();
    my int $has_interp = 0;
    my int $var_count = 0;

    while (!lex_at_end($lexer)) {
        my str $ch = lex_current_char($lexer);
        $handled = 0;

        # Check for closing delimiter
        if ($ch eq $close) {
            $depth = $depth - 1;
            if ($depth == 0) {
                lex_advance($lexer);
                if ($is_qq && $has_interp) {
                    push(\@parts, sb_to_string($sb));
                    my hash %token = ();
                    $token{"type"} = "INTERP_STRING";
                    $token{"parts"} = \@parts;
                    $token{"vars"} = \@vars;
                    $token{"var_count"} = $var_count;
                    $token{"line"} = $token_line;
                    return \%token;
                } else {
                    my hash %token = ();
                    $token{"type"} = "STR_LITERAL";
                    $token{"value"} = sb_to_string($sb);
                    $token{"line"} = $token_line;
                    return \%token;
                }
            }
            sb_append($sb, $ch);
            lex_advance($lexer);
            $handled = 1;
        }

        # Check for nested opening delimiter (paired delimiters only)
        if ($handled == 0 && $open ne $close && $ch eq $open) {
            $depth = $depth + 1;
            sb_append($sb, $ch);
            lex_advance($lexer);
            $handled = 1;
        }

        # Check for escape sequence
        if ($handled == 0 && $ch eq "\\") {
            lex_advance($lexer);
            if (lex_at_end($lexer)) {
                last;
            }
            my str $esc = lex_current_char($lexer);
            my int $skip_adv = 0;

            if ($is_qq) {
                # qq() supports full escape sequences like double-quoted strings
                if ($esc eq "n") {
                    sb_append($sb, "\n");
                } elsif ($esc eq "t") {
                    sb_append($sb, "\t");
                } elsif ($esc eq "r") {
                    sb_append($sb, "\r");
                } elsif ($esc ge "0" && $esc le "7") {
                    # 1-3 octal digits (\0 .. \377, clamped to <= 255)
                    my int $ov = 0;
                    my int $oi = 0;
                    while ($oi < 3 && !lex_at_end($lexer)) {
                        my int $oc = lex_current_code($lexer);
                        if ($oc < '0' || $oc > '7') { last; }
                        my int $nov = $ov * 8 + ($oc - ord("0"));
                        if ($nov > 255) { last; }
                        $ov = $nov;
                        lex_advance($lexer);
                        $oi = $oi + 1;
                    }
                    sb_append($sb, chr($ov));
                    $skip_adv = 1;
                } elsif ($esc eq "a") {
                    sb_append($sb, chr(7));
                } elsif ($esc eq "b") {
                    sb_append($sb, chr(8));
                } elsif ($esc eq "f") {
                    sb_append($sb, chr(12));
                } elsif ($esc eq "v") {
                    sb_append($sb, chr(11));
                } elsif ($esc eq "e") {
                    sb_append($sb, chr(27));
                } elsif ($esc eq "u") {
                    sb_append($sb, lex_read_u_escape($lexer));
                    $skip_adv = 1;
                } elsif ($esc eq "x") {
                    # \xHH or \x{HEX} hex escape — Perl-compatible
                    lex_advance($lexer);  # consume 'x'
                    my int $pk_code = lex_current_code($lexer);
                    if ($pk_code == '{') {
                        lex_advance($lexer);  # consume '{'
                        my int $hv = 0;
                        while (!lex_at_end($lexer)) {
                            my int $hcc = lex_current_code($lexer);
                            if ($hcc == '}') { last; }
                            my int $hd = -1;
                            if ($hcc >= '0' && $hcc <= '9') { $hd = $hcc - ord("0"); }
                            elsif ($hcc >= 'a' && $hcc <= 'f') { $hd = $hcc - ord("a") + 10; }
                            elsif ($hcc >= 'A' && $hcc <= 'F') { $hd = $hcc - ord("A") + 10; }
                            else { last; }
                            $hv = $hv * 16 + $hd;
                            lex_advance($lexer);
                        }
                        if (lex_current_code($lexer) == '}') { lex_advance($lexer); }
                        sb_append($sb, chr($hv));
                    } else {
                        my int $hv = 0;
                        my int $hi = 0;
                        while ($hi < 2 && !lex_at_end($lexer)) {
                            my int $hcc = lex_current_code($lexer);
                            my int $hd = -1;
                            if ($hcc >= '0' && $hcc <= '9') { $hd = $hcc - ord("0"); }
                            elsif ($hcc >= 'a' && $hcc <= 'f') { $hd = $hcc - ord("a") + 10; }
                            elsif ($hcc >= 'A' && $hcc <= 'F') { $hd = $hcc - ord("A") + 10; }
                            else { last; }
                            $hv = $hv * 16 + $hd;
                            lex_advance($lexer);
                            $hi = $hi + 1;
                        }
                        sb_append($sb, chr($hv));
                    }
                    $skip_adv = 1;
                } elsif ($esc eq "$") {
                    # Escaped dollar sign - literal $
                    sb_append($sb, "$");
                } elsif ($esc eq "\"") {
                    sb_append($sb, "\"");
                } elsif ($esc eq "\\" || $esc eq $close || $esc eq $open) {
                    sb_append($sb, $esc);
                } else {
                    # Unknown escape - include as-is
                    sb_append($sb, $esc);
                }
            } else {
                # q() only escapes \\ and the delimiters (both open and close)
                if ($esc eq $close || $esc eq $open || $esc eq "\\") {
                    sb_append($sb, $esc);
                } else {
                    sb_append($sb, "\\");
                    sb_append($sb, $esc);
                }
            }
            if ($skip_adv == 0) {
                lex_advance($lexer);
            }
            $handled = 1;
        }

        # Check for interpolation in qq()
        if ($handled == 0 && $is_qq && $ch eq "$") {
            lex_advance($lexer);
            my int $peek_code = lex_current_code($lexer);

            if ($peek_code == '{') {
                my str $ivar = lex_read_braced_interp($lexer, $token_line, "Unterminated interpolation in qq string");
                push(\@parts, sb_to_string($sb));
                push(\@vars, $ivar);
                $var_count = $var_count + 1;
                $sb = sb_new();  # Reset StringBuilder
                $has_interp = 1;
                $handled = 1;
            } else {
                # Just a literal $ not followed by {
                sb_append($sb, "$");
                $handled = 1;
            }
        }

        # Regular character
        if ($handled == 0) {
            sb_append($sb, $ch);
            lex_advance($lexer);
        }
    }

    lex_error($lexer, "Unterminated q/qq string", $token_line, $lexer->{"tok_col"});
}

# Read a raw C code block __C__ { ... }
# Handles nested braces, C strings, and C comments properly
func lex_read_c_block(scalar $lexer, int $token_line) scalar {
    lex_skip_whitespace($lexer);

    # Expect opening brace
    my int $code = lex_current_code($lexer);
    if ($code != '{') {
        lex_error($lexer, "Expected '{' after __C__", $token_line, $lexer->{"tok_col"});
    }
    lex_advance($lexer);  # Skip opening {

    my scalar $sb = sb_new();
    my int $depth = 1;

    while (!lex_at_end($lexer) && $depth > 0) {
        my int $ch = lex_current_code($lexer);

        # Handle C-style strings - don't count braces inside strings
        if ($ch == '"') {
            sb_append($sb, lex_current_char($lexer));
            lex_advance($lexer);
            while (!lex_at_end($lexer)) {
                my int $sch = lex_current_code($lexer);
                sb_append($sb, lex_current_char($lexer));
                lex_advance($lexer);
                if ($sch == '"') {
                    last;
                }
                if ($sch == '\\') {
                    if (!lex_at_end($lexer)) {
                        sb_append($sb, lex_current_char($lexer));
                        lex_advance($lexer);
                    }
                }
            }
        # Handle C-style char literals - don't count braces inside
        } elsif ($ch == '\'') {
            sb_append($sb, lex_current_char($lexer));
            lex_advance($lexer);
            while (!lex_at_end($lexer)) {
                my int $sch = lex_current_code($lexer);
                sb_append($sb, lex_current_char($lexer));
                lex_advance($lexer);
                if ($sch == '\'') {
                    last;
                }
                if ($sch == '\\') {
                    if (!lex_at_end($lexer)) {
                        sb_append($sb, lex_current_char($lexer));
                        lex_advance($lexer);
                    }
                }
            }
        # Handle C block comments /* */
        } elsif ($ch == '/') {
            my int $nxt = char_at($lexer->{"source"}, $lexer->{"pos"} + 1);
            # Block comment
            if ($nxt == '*') {
                sb_append($sb, "/*");
                lex_advance($lexer);
                lex_advance($lexer);
                while (!lex_at_end($lexer)) {
                    my int $c1 = lex_current_code($lexer);
                    if ($c1 == '*') {
                        my int $c2 = char_at($lexer->{"source"}, $lexer->{"pos"} + 1);
                        if ($c2 == '/') {
                            sb_append($sb, "*/");
                            lex_advance($lexer);
                            lex_advance($lexer);
                            last;
                        }
                    }
                    sb_append($sb, lex_current_char($lexer));
                    lex_advance($lexer);
                }
            # Line comment //
            } elsif ($nxt == '/') {
                sb_append($sb, "//");
                lex_advance($lexer);
                lex_advance($lexer);
                while (!lex_at_end($lexer)) {
                    my int $lc = lex_current_code($lexer);
                    if ($lc == '\n') {
                        sb_append($sb, "\n");
                        lex_advance($lexer);
                        last;
                    }
                    sb_append($sb, lex_current_char($lexer));
                    lex_advance($lexer);
                }
            } else {
                # Just a /
                sb_append($sb, "/");
                lex_advance($lexer);
            }
        } elsif ($ch == '{') {
            $depth = $depth + 1;
            sb_append($sb, "{");
            lex_advance($lexer);
        } elsif ($ch == '}') {
            $depth = $depth - 1;
            if ($depth > 0) {
                sb_append($sb, "}");
            }
            lex_advance($lexer);
        } else {
            # Regular character
            sb_append($sb, lex_current_char($lexer));
            lex_advance($lexer);
        }
    }

    if ($depth > 0) {
        lex_error($lexer, "Unterminated __C__ block", $token_line, $lexer->{"tok_col"});
    }

    my hash %token = ();
    $token{"type"} = "C_BLOCK";
    $token{"value"} = sb_to_string($sb);
    $token{"line"} = $token_line;
    return \%token;
}

func lex_keyword_or_ident(str $text) str {
    if ($text eq "func") { return "FUNC"; }
    if ($text eq "my") { return "MY"; }
    if ($text eq "const") { return "CONST"; }
    if ($text eq "our") { return "OUR"; }
    if ($text eq "if") { return "IF"; }
    if ($text eq "elsif") { return "ELSIF"; }
    if ($text eq "else") { return "ELSE"; }
    if ($text eq "while") { return "WHILE"; }
    if ($text eq "do") { return "DO"; }
    if ($text eq "for") { return "FOR"; }
    if ($text eq "foreach") { return "FOREACH"; }
    if ($text eq "return") { return "RETURN"; }
    if ($text eq "last") { return "LAST"; }
    if ($text eq "break") { return "LAST"; }
    if ($text eq "next") { return "NEXT"; }
    if ($text eq "unless") { return "UNLESS"; }
    if ($text eq "until") { return "UNTIL"; }
    if ($text eq "redo") { return "REDO"; }
    if ($text eq "extern") { return "EXTERN"; }
    if ($text eq "private") { return "PRIVATE"; }
    if ($text eq "async") { return "ASYNC"; }
    if ($text eq "await") { return "AWAIT"; }
    if ($text eq "enum") { return "ENUM"; }
    if ($text eq "package") { return "PACKAGE"; }
    if ($text eq "version") { return "VERSION"; }
    if ($text eq "use") { return "USE"; }
    if ($text eq "import_lib") { return "IMPORT_LIB"; }
    if ($text eq "import_object") { return "IMPORT_OBJECT"; }
    if ($text eq "import_archive") { return "IMPORT_ARCHIVE"; }
    if ($text eq "link_lib") { return "LINK_LIB"; }
    if ($text eq "inherit") { return "INHERIT"; }
    if ($text eq "try") { return "TRY"; }
    if ($text eq "catch") { return "CATCH"; }
    if ($text eq "throw") { return "THROW"; }
    if ($text eq "goto") { return "GOTO"; }
    if ($text eq "switch") { return "SWITCH"; }
    if ($text eq "case") { return "CASE"; }
    if ($text eq "default") { return "DEFAULT"; }
    if ($text eq "__PACKAGE__") { return "DUNDER_PACKAGE"; }
    if ($text eq "__FILE__") { return "DUNDER_FILE"; }
    if ($text eq "__LINE__") { return "DUNDER_LINE"; }
    if ($text eq "__C__") { return "C_BLOCK"; }
    if ($text eq "BEGIN") { return "BEGIN_BLOCK"; }
    if ($text eq "END") { return "END_BLOCK"; }

    # Moose-style OOP keywords
    if ($text eq "has") { return "HAS"; }
    if ($text eq "extends") { return "EXTENDS"; }
    if ($text eq "with") { return "WITH"; }
    if ($text eq "before") { return "BEFORE"; }
    if ($text eq "after") { return "AFTER"; }
    if ($text eq "around") { return "AROUND"; }

    # String comparison operators
    if ($text eq "eq") { return "STR_EQ"; }
    if ($text eq "ne") { return "STR_NE"; }
    if ($text eq "lt") { return "STR_LT"; }
    if ($text eq "gt") { return "STR_GT"; }
    if ($text eq "le") { return "STR_LE"; }
    if ($text eq "ge") { return "STR_GE"; }
    if ($text eq "cmp") { return "STR_CMP"; }
    
    # Types
    if ($text eq "int") { return "TYPE_INT"; }
    if ($text eq "num") { return "TYPE_NUM"; }
    if ($text eq "str") { return "TYPE_STR"; }
    if ($text eq "bool") { return "TYPE_BOOL"; }
    if ($text eq "array") { return "TYPE_ARRAY"; }
    if ($text eq "hash") { return "TYPE_HASH"; }
    if ($text eq "scalar") { return "TYPE_SCALAR"; }
    if ($text eq "void") { return "TYPE_VOID"; }
    if ($text eq "dynamic") { return "TYPE_DYNAMIC"; }
    # Explicit sized types for extern functions (C interop)
    if ($text eq "int32") { return "TYPE_INT32"; }
    if ($text eq "int64") { return "TYPE_INT64"; }
    if ($text eq "float32") { return "TYPE_FLOAT32"; }
    if ($text eq "float64") { return "TYPE_FLOAT64"; }
    if ($text eq "int8") { return "TYPE_INT8"; }
    if ($text eq "int16") { return "TYPE_INT16"; }
    if ($text eq "uint8") { return "TYPE_UINT8"; }
    if ($text eq "byte") { return "TYPE_UINT8"; }
    if ($text eq "uint16") { return "TYPE_UINT16"; }
    if ($text eq "uint32") { return "TYPE_UINT32"; }
    if ($text eq "uint64") { return "TYPE_UINT64"; }
    if ($text eq "size_t") { return "TYPE_SIZE_T"; }
    if ($text eq "char") { return "TYPE_CHAR"; }
    if ($text eq "float") { return "TYPE_FLOAT32"; }
    if ($text eq "double") { return "TYPE_FLOAT64"; }
    if ($text eq "long_double") { return "TYPE_LONG_DOUBLE"; }

    # Built-ins that need special token types
    # undef is a keyword, not a function call
    if ($text eq "undef") { return "UNDEF"; }
    if ($text eq "map") { return "MAP"; }
    if ($text eq "sort") { return "SORT"; }
    if ($text eq "grep") { return "GREP"; }
    # if ($text eq "defined") { return "DEFINED"; }
    # if ($text eq "ref") { return "REF"; }
    # if ($text eq "dump") { return "DUMP"; }
    # if ($text eq "dumper") { return "DUMPER"; }
    # if ($text eq "say") { return "SAY"; }
    # if ($text eq "print") { return "PRINT"; }
    # if ($text eq "die") { return "DIE"; }
    # if ($text eq "push") { return "PUSH"; }
    # if ($text eq "pop") { return "POP"; }
    # if ($text eq "shift") { return "SHIFT"; }
    # if ($text eq "unshift") { return "UNSHIFT"; }
    # if ($text eq "scalar") { return "SCALAR"; }
    # if ($text eq "length") { return "LENGTH"; }
    # if ($text eq "substr") { return "SUBSTR"; }
    
    return "IDENT";
}

# Validate whether code after qw/q/qq is an actual delimiter (avoid mistaking
# `q / 2`, `q != 1`, `q <= 5`, `q << 2`, `q || 1` for a quoted string).
func lex_is_q_delim(scalar $lexer, int $had_ws, int $delim) int {
    if ($delim == '(' || $delim == '[' || $delim == '{') {
        return 1;
    }
    if ($had_ws == 1) {
        return 0;
    }
    if ($delim == '/') {
        return 1;
    }
    my int $nxt = lex_peek_code($lexer, 1);
    if ($delim == '!') {
        if ($nxt == '=' || $nxt == '~') { return 0; }
        return 1;
    }
    if ($delim == '<') {
        if ($nxt == '=' || $nxt == '<') { return 0; }
        return 1;
    }
    if ($delim == '|') {
        if ($nxt == '|') { return 0; }
        return 1;
    }
    return 0;
}

func lex_next_token(scalar $lexer) scalar {
    # Clear after_sigil and after_arrow flags unless we just set them
    # (re-set below if the current token is a sigil or -> / ::)
    my int $saved_after_sigil = $lexer->{"after_sigil"};
    my int $saved_after_arrow = $lexer->{"after_arrow"};
    my int $saved_after_member_arrow = $lexer->{"after_member_arrow"};
    my int $saved_expect_subst = $lexer->{"expect_subst"};
    $lexer->{"after_sigil"} = 0;
    $lexer->{"after_arrow"} = 0;
    $lexer->{"after_member_arrow"} = 0;

    lex_skip_whitespace($lexer);

    my int $code = lex_current_code($lexer);

    # Capture line/column at token start (after whitespace). tok_col is
    # exposed on the lexer so lex_tokenize_file can stamp the returned
    # token's "column" centrally (one site instead of ~55 creation sites).
    my int $token_line = $lexer->{"line"};
    my int $token_col = $lexer->{"column"};
    $lexer->{"tok_col"} = $token_col;

    # Check for EOF
    if (lex_at_end($lexer) == 1) {
        if ($lexer->{"pp_depth"} > 0) {
            lex_error($lexer, "unterminated #ifdef/#ifndef (missing #endif)", $token_line, 1);
        }
        my hash %token = ();
        $token{"type"} = "EOF";
        $token{"value"} = "";
        $token{"line"} = $token_line;
        return \%token;
    }

    # Skip line comments
    if ($code == '#') {
        if (lex_pp_directive($lexer) == 0) {
            lex_skip_comment($lexer);
        }
        return lex_next_token($lexer);
    }

    # Skip block comments (/* ... */)
    if ($code == '/') {
        my int $next_code = char_at($lexer->{"source"}, $lexer->{"pos"} + 1);
        if ($next_code == '*') {
            lex_skip_block_comment($lexer);
            return lex_next_token($lexer);
        }
    }

    # Skip POD blocks (=head1, =pod, etc. at start of line)
    if ($code == '=') {
        # Check if we're at start of line (pos 0 or prev char was newline)
        my int $pos = $lexer->{"pos"};
        my int $at_line_start = 0;
        if ($pos == 0) {
            $at_line_start = 1;
        } else {
            my int $prev = char_at($lexer->{"source"}, $pos - 1);
            if ($prev == '\n') {
                $at_line_start = 1;
            }
        }
        if ($at_line_start == 1 && lex_is_pod_start($lexer) == 1) {
            lex_skip_pod($lexer);
            return lex_next_token($lexer);
        }
    }

    # Check for regex/substitution after =~ or !~ or operand position BEFORE identifier check
    if ($lexer->{"expect_regex"} == 1 && $saved_after_arrow == 0 && $saved_after_sigil == 0 && $lexer->{"after_value"} == 0) {
        if ($code == '/') {
            $lexer->{"expect_regex"} = 0;
            $lexer->{"expect_subst"} = 0;
            return lex_read_regex_literal($lexer, $token_line);
        }
        # m/pattern/flags: the explicit spelling of a match. Skip the `m`
        # and read an ordinary /regex/ literal (no whitespace before `/`).
        if ($code == 'm') {
            my int $m_peek = char_at($lexer->{"source"}, $lexer->{"pos"} + 1);
            if ($m_peek == '/') {
                $lexer->{"expect_regex"} = 0;
                $lexer->{"expect_subst"} = 0;
                lex_advance($lexer);
                return lex_read_regex_literal($lexer, $token_line);
            }
        }
        # s/// and tr/// and y/// are only valid immediately after =~ (expect_subst == 1),
        # so bare `s/2` or `tr/2` in expression position lexes as division.
        if ($saved_expect_subst == 1) {
            if ($code == 's') {
                my int $peek_code = char_at($lexer->{"source"}, $lexer->{"pos"} + 1);
                if ($peek_code == '/') {
                    $lexer->{"expect_regex"} = 0;
                    $lexer->{"expect_subst"} = 0;
                    return lex_read_subst_literal($lexer, $token_line);
                }
            }
            # tr/// or y///
            if ($code == 't') {
                my int $peek1 = char_at($lexer->{"source"}, $lexer->{"pos"} + 1);
                if ($peek1 == 'r') {
                    my int $peek2 = char_at($lexer->{"source"}, $lexer->{"pos"} + 2);
                    if ($peek2 == '/') {
                        $lexer->{"expect_regex"} = 0;
                        $lexer->{"expect_subst"} = 0;
                        return lex_read_tr_literal($lexer, $token_line, 2);
                    }
                }
            }
            if ($code == 'y') {
                my int $peek1 = char_at($lexer->{"source"}, $lexer->{"pos"} + 1);
                if ($peek1 == '/') {
                    $lexer->{"expect_regex"} = 0;
                    $lexer->{"expect_subst"} = 0;
                    return lex_read_tr_literal($lexer, $token_line, 1);
                }
            }
        }
        # Not a regex/subst/tr - reset flags and continue with normal parsing
        $lexer->{"expect_regex"} = 0;
        $lexer->{"expect_subst"} = 0;
    } else {
        $lexer->{"expect_regex"} = 0;
        $lexer->{"expect_subst"} = 0;
    }

    # Identifiers and keywords
    if (($code >= 'a' && $code <= 'z') || ($code >= 'A' && $code <= 'Z') || $code == '_') {
        my str $text = lex_read_identifier($lexer);

        # Check for quote-like operators: qw(), q(), qq()
        # Skip after sigils ($q, @q, %q), arrows/namespaces ($obj->q(), Pkg::q()),
        # or value-ending tokens (binary expression position).
        if ($saved_after_sigil == 0 && $saved_after_arrow == 0 && $lexer->{"after_value"} == 0) {
        if ($text eq "qw" || $text eq "q" || $text eq "qq") {
            my int $ws_pos = $lexer->{"pos"};
            my int $ws_line = $lexer->{"line"};
            my int $ws_col = $lexer->{"column"};
            lex_skip_whitespace($lexer);
            my int $had_ws = 0;
            if ($lexer->{"pos"} > $ws_pos) {
                $had_ws = 1;
            }
            my int $delim = lex_current_code($lexer);
            if (lex_is_q_delim($lexer, $had_ws, $delim) == 1) {
                if ($text eq "qw") {
                    return lex_read_qw($lexer, $token_line);
                } elsif ($text eq "q") {
                    return lex_read_q_string($lexer, $token_line, 0);
                } else {
                    return lex_read_q_string($lexer, $token_line, 1);
                }
            }
            $lexer->{"pos"} = $ws_pos;
            $lexer->{"line"} = $ws_line;
            $lexer->{"column"} = $ws_col;
        }
        }

        # __C__ { ... } - raw C code block
        if ($text eq "__C__" && $saved_after_sigil == 0 && $saved_after_arrow == 0) {
            return lex_read_c_block($lexer, $token_line);
        }

        my str $type = "IDENT";
        if ($saved_after_member_arrow == 0) {
            $type = lex_keyword_or_ident($text);
        }

        # A word immediately followed by '::' is a namespace qualifier
        # (e.g. str::replace), never a keyword — demote to IDENT so type
        # keywords like 'str' can name builtin namespaces.
        # ...except __PACKAGE__: `__PACKAGE__::func()` is resolved against the
        # current package by the parser, which needs the DUNDER_PACKAGE token
        # (demoted, it became a call to a function literally named
        # __PACKAGE___func: a link error).
        if (lex_current_code($lexer) == ':' && lex_peek_code($lexer, 1) == ':' && $type ne "DUNDER_PACKAGE") {
            $type = "IDENT";
        }

        # A statement-modifier or condition keyword is followed by an operand,
        # so a `/` there starts a regex: `say("m") if /b/;`.
        if ($saved_after_member_arrow == 0 && $saved_after_arrow == 0 && $saved_after_sigil == 0 &&
            ($type eq "IF" || $type eq "ELSIF" || $type eq "UNLESS" || $type eq "WHILE" || $type eq "UNTIL" || $type eq "RETURN")) {
            $lexer->{"expect_regex"} = 1;
        }

        my hash %token = ();
        $token{"type"} = $type;
        $token{"value"} = $text;
        $token{"line"} = $token_line;
        $token{"is_word"} = 1;
        return \%token;
    }

    # Numbers
    if ($code >= '0' && $code <= '9') {
        my scalar $tok = lex_read_number($lexer);
        $tok->{"line"} = $token_line;
        return $tok;
    }

    # Strings
    if ($code == '"') {
        # Double-quoted string with interpolation support
        return lex_read_dq_string($lexer, $token_line);
    }

    if ($code == '\'') {
        # Single-quoted string (literal, no interpolation)
        my int $raw_start = $lexer->{"pos"} + 1;
        my str $str_val = lex_read_sq_string($lexer);
        my int $raw_len = ($lexer->{"pos"} - 1) - $raw_start;
        my hash %token = ();
        $token{"type"} = "STR_LITERAL";
        $token{"value"} = $str_val;
        $token{"line"} = $token_line;
        if ($raw_len >= 1 && $raw_len <= 4) {
            my int $sq_cc = lex_parse_sq_char_code($lexer->{"source"}, $raw_start, $raw_len);
            if ($sq_cc >= 0) {
                $token{"has_char_code"} = 1;
                $token{"char_code"} = $sq_cc;
            }
        }
        return \%token;
    }

    # Two-character operators - use char codes for fast comparison
    # Get second character code for two-char operator detection
    my str $source = $lexer->{"source"};
    my int $pos = $lexer->{"pos"};
    my int $code2 = char_at($source, $pos + 1);

    # ==
    if ($code == '=' && $code2 == '=') {
        lex_advance($lexer);
        lex_advance($lexer);
        $lexer->{"expect_regex"} = 1;
        my hash %token = ();
        $token{"type"} = "EQ";
        $token{"value"} = "==";
        $token{"line"} = $token_line;
        return \%token;
    }

    # !=
    if ($code == '!' && $code2 == '=') {
        lex_advance($lexer);
        lex_advance($lexer);
        $lexer->{"expect_regex"} = 1;
        my hash %token = ();
        $token{"type"} = "NE";
        $token{"value"} = "!=";
        $token{"line"} = $token_line;
        return \%token;
    }

    # Diamond operator <STDIN> — bareword filehandle (only when NOT after a value)
    if ($code == '<' && $lexer->{"after_value"} == 0 && (($code2 >= 'A' && $code2 <= 'Z') || ($code2 >= 'a' && $code2 <= 'z'))) {
        # Check if it's a bareword followed by > (e.g., <STDIN>)
        my int $save_pos = $lexer->{"pos"};
        my int $save_line = $lexer->{"line"};
        my int $save_col = $lexer->{"column"};
        lex_advance($lexer);  # Skip <
        my str $bw_name = lex_read_identifier($lexer);
        my int $close_code = lex_current_code($lexer);
        if ($close_code == '>' && length($bw_name) > 0) {
            # It's <BAREWORD> — treat as diamond on that variable
            lex_advance($lexer);  # Skip >
            my hash %token = ();
            $token{"type"} = "DIAMOND";
            $token{"value"} = $bw_name;
            $token{"line"} = $token_line;
            $lexer->{"after_value"} = 1;
            return \%token;
        }
        # Not a diamond — restore position
        $lexer->{"pos"} = $save_pos;
        $lexer->{"line"} = $save_line;
        $lexer->{"column"} = $save_col;
    }

    # Diamond operator <$fh> for reading from filehandle (only when NOT after a value)
    if ($code == '<' && $code2 == '$' && $lexer->{"after_value"} == 0) {
        my int $save_pos = $lexer->{"pos"};
        my int $save_line = $lexer->{"line"};
        my int $save_col = $lexer->{"column"};
        lex_advance($lexer);  # Skip <
        lex_advance($lexer);  # Skip $
        my str $varname = lex_read_identifier($lexer);
        my int $close = lex_current_code($lexer);
        if (length($varname) > 0 && $close == '>') {
            lex_advance($lexer);  # Skip >
            my hash %token = ();
            $token{"type"} = "DIAMOND";
            $token{"value"} = $varname;  # Just the variable name without $
            $token{"line"} = $token_line;
            $lexer->{"after_value"} = 1;
            return \%token;
        }
        # Not <$fh> — restore position and fall through to '<' operator
        $lexer->{"pos"} = $save_pos;
        $lexer->{"line"} = $save_line;
        $lexer->{"column"} = $save_col;
    }

    # Check for <=> (spaceship) before <=
    if ($code == '<' && $code2 == '=') {
        my int $code3 = char_at($source, $pos + 2);
        if ($code3 == '>') {
            lex_advance($lexer);
            lex_advance($lexer);
            lex_advance($lexer);
            my hash %token = ();
            $token{"type"} = "SPACESHIP";
            $token{"value"} = "<=>";
            $token{"line"} = $token_line;
            return \%token;
        }
        # Just <=
        lex_advance($lexer);
        lex_advance($lexer);
        my hash %token = ();
        $token{"type"} = "LE";
        $token{"value"} = "<=";
        $token{"line"} = $token_line;
        return \%token;
    }

    # >=
    if ($code == '>' && $code2 == '=') {
        lex_advance($lexer);
        lex_advance($lexer);
        my hash %token = ();
        $token{"type"} = "GE";
        $token{"value"} = ">=";
        $token{"line"} = $token_line;
        return \%token;
    }

    # &&=
    if ($code == '&' && $code2 == '&' && char_at($lexer->{"source"}, $lexer->{"pos"} + 2) == '=') {
        lex_advance($lexer);
        lex_advance($lexer);
        lex_advance($lexer);
        $lexer->{"expect_regex"} = 1;
        my hash %token = ();
        $token{"type"} = "AND_ASSIGN";
        $token{"value"} = "&&=";
        $token{"line"} = $token_line;
        return \%token;
    }

    # &&
    if ($code == '&' && $code2 == '&') {
        lex_advance($lexer);
        lex_advance($lexer);
        my hash %token = ();
        $token{"type"} = "AND";
        $token{"value"} = "&&";
        $token{"line"} = $token_line;
        $lexer->{"expect_regex"} = 1;   # an operand follows: `&& /re/`
        return \%token;
    }

    # ||=
    if ($code == '|' && $code2 == '|' && char_at($lexer->{"source"}, $lexer->{"pos"} + 2) == '=') {
        lex_advance($lexer);
        lex_advance($lexer);
        lex_advance($lexer);
        $lexer->{"expect_regex"} = 1;
        my hash %token = ();
        $token{"type"} = "OR_ASSIGN";
        $token{"value"} = "||=";
        $token{"line"} = $token_line;
        return \%token;
    }

    # ||
    if ($code == '|' && $code2 == '|') {
        lex_advance($lexer);
        lex_advance($lexer);
        my hash %token = ();
        $token{"type"} = "OR";
        $token{"value"} = "||";
        $token{"line"} = $token_line;
        $lexer->{"expect_regex"} = 1;   # an operand follows: `|| /re/`
        return \%token;
    }

    # //= - defined-or-assign (checked before //)
    if ($code == '/' && $code2 == '/' && char_at($lexer->{"source"}, $lexer->{"pos"} + 2) == '=') {
        lex_advance($lexer);
        lex_advance($lexer);
        lex_advance($lexer);
        $lexer->{"expect_regex"} = 1;
        my hash %token = ();
        $token{"type"} = "DOR_ASSIGN";
        $token{"value"} = "//=";
        $token{"line"} = $token_line;
        return \%token;
    }

    # // - defined-or operator
    if ($code == '/' && $code2 == '/') {
        lex_advance($lexer);
        lex_advance($lexer);
        $lexer->{"expect_regex"} = 1;
        my hash %token = ();
        $token{"type"} = "DEFINED_OR";
        $token{"value"} = "//";
        $token{"line"} = $token_line;
        return \%token;
    }

    # << — left shift or heredoc
    if ($code == '<' && $code2 == '<') {
        # Check for heredoc: <<IDENT, <<'IDENT', <<"IDENT"
        # Only valid when previous token does not end a value expression (`$x<<SHIFT` is LSHIFT).
        my int $pos_save = $lexer->{"pos"};
        lex_advance($lexer);
        lex_advance($lexer);
        my int $hd_code = lex_current_code($lexer);
        # Check if followed by alpha/underscore or quote — indicates heredoc
        my int $is_heredoc = 0;
        my int $hd_quoted = 0;
        if ($lexer->{"after_value"} == 0) {
            if (($hd_code >= 'A' && $hd_code <= 'Z') || ($hd_code >= 'a' && $hd_code <= 'z') || $hd_code == '_') {
                $is_heredoc = 1;
            } elsif ($hd_code == '\'' || $hd_code == '"') {
                $is_heredoc = 1;
                $hd_quoted = $hd_code;
                lex_advance($lexer);
            }
        }

        if ($is_heredoc == 1) {
            # Read delimiter identifier
            my str $delim = "";
            my int $dc = lex_current_code($lexer);
            while (($dc >= 'A' && $dc <= 'Z') || ($dc >= 'a' && $dc <= 'z') || ($dc >= '0' && $dc <= '9') || $dc == '_') {
                $delim = $delim . chr($dc);
                lex_advance($lexer);
                $dc = lex_current_code($lexer);
            }
            # Skip closing quote if quoted
            if ($hd_quoted != 0) {
                if (lex_current_code($lexer) != $hd_quoted) {
                    lex_error($lexer, "Unterminated heredoc delimiter quote", $token_line, $token_col);
                }
                lex_advance($lexer);
            }
            # Keep lexing the remainder of the opening line (e.g. `<<EOT . " world";`
            # or `say(<<EOT);` or multiple heredocs on one line): scan forward from
            # the newline at the end of the opening line (or from heredoc_resume_pos
            # if an earlier heredoc on this same line already scanned its body) and
            # record heredoc_resume_pos/heredoc_resume_line so when the lexer hits
            # the opening line's '\n' it jumps past the heredoc terminator.
            my int $src_len = $lexer->{"length"};
            my int $scan_pos = $lexer->{"heredoc_resume_pos"};
            my int $scan_line = $lexer->{"heredoc_resume_line"};
            if ($scan_pos == 0) {
                $scan_pos = $lexer->{"pos"};
                my int $extra_lines = 0;
                my int $hd_dq = 0;
                my int $hd_sq = 0;
                my int $hd_in_cmt = 0;
                while ($scan_pos < $src_len) {
                    my int $sc = char_at($source, $scan_pos);
                    if ($hd_in_cmt == 1) {
                        if ($sc == '\n') {
                            $extra_lines = $extra_lines + 1;
                        } elsif ($sc == '*' && $scan_pos + 1 < $src_len && char_at($source, $scan_pos + 1) == '/') {
                            $hd_in_cmt = 0;
                            $scan_pos = $scan_pos + 2;
                            next;
                        }
                        $scan_pos = $scan_pos + 1;
                        next;
                    }
                    if ($sc == '\n') { last; }
                    if ($hd_dq == 1) {
                        if ($sc == '\\' && $scan_pos + 1 < $src_len) {
                            if (char_at($source, $scan_pos + 1) == '\n') { $extra_lines = $extra_lines + 1; }
                            $scan_pos = $scan_pos + 2;
                            next;
                        }
                        if ($sc == '"') { $hd_dq = 0; }
                    } elsif ($hd_sq == 1) {
                        if ($sc == '\\' && $scan_pos + 1 < $src_len) {
                            if (char_at($source, $scan_pos + 1) == '\n') { $extra_lines = $extra_lines + 1; }
                            $scan_pos = $scan_pos + 2;
                            next;
                        }
                        if ($sc == '\'') { $hd_sq = 0; }
                    } else {
                        if ($sc == '"') {
                            $hd_dq = 1;
                        } elsif ($sc == '\'') {
                            $hd_sq = 1;
                        } elsif ($sc == '#') {
                            while ($scan_pos < $src_len && char_at($source, $scan_pos) != '\n') {
                                $scan_pos = $scan_pos + 1;
                            }
                            last;
                        } elsif ($sc == '/' && $scan_pos + 1 < $src_len) {
                            my int $sc2 = char_at($source, $scan_pos + 1);
                            if ($sc2 == '/') {
                                while ($scan_pos < $src_len && char_at($source, $scan_pos) != '\n') {
                                    $scan_pos = $scan_pos + 1;
                                }
                                last;
                            } elsif ($sc2 == '*') {
                                $hd_in_cmt = 1;
                                $scan_pos = $scan_pos + 2;
                                next;
                            }
                        }
                    }
                    $scan_pos = $scan_pos + 1;
                }
                if ($scan_pos >= $src_len) {
                    lex_error($lexer, "Unterminated heredoc (missing '" . $delim . "')", $token_line, $token_col);
                }
                $scan_pos = $scan_pos + 1;
                $scan_line = $lexer->{"line"} + 1 + $extra_lines;
            }
            # Read lines until we find the delimiter on its own line
            my scalar $body_sb = sb_new();
            my int $found = 0;
            while ($scan_pos < $src_len) {
                my int $lstart = $scan_pos;
                while ($scan_pos < $src_len && char_at($source, $scan_pos) != '\n') {
                    $scan_pos = $scan_pos + 1;
                }
                my int $lend = $scan_pos;
                my str $hd_line = substr_bytes($source, $lstart, $lend - $lstart);
                if ($scan_pos < $src_len && char_at($source, $scan_pos) == '\n') {
                    $scan_pos = $scan_pos + 1;
                    $scan_line = $scan_line + 1;
                }
                if ($hd_line eq $delim) {
                    $found = 1;
                    last;
                }
                sb_append($body_sb, $hd_line);
                sb_append($body_sb, "\n");
            }
            if ($found == 0) {
                lex_error($lexer, "Unterminated heredoc (missing '" . $delim . "')", $token_line, $token_col);
            }
            $lexer->{"heredoc_resume_pos"} = $scan_pos;
            $lexer->{"heredoc_resume_line"} = $scan_line;

            # Remove trailing newline using byte length (NOT character length!)
            my str $body = sb_to_string($body_sb);
            my int $blen = bytes($body);
            if ($blen > 0 && char_at($body, $blen - 1) == '\n') {
                $body = substr_bytes($body, 0, $blen - 1);
            }
            # Single-quoted heredoc (<<'EOT', $hd_quoted == '\'') stays literal.
            # Bare <<EOT and double-quoted <<"EOT" are "double-quoted": run the
            # body through the same escape + ${...} interpolation machinery as a
            # "..." string, by scanning a sub-lexer over the collected body.
            if ($hd_quoted != '\'') {
                my scalar $hd_sub = lex_new($body);
                $hd_sub->{"file"} = $lexer->{"file"};
                return lex_dq_content($hd_sub, 0, $token_line);
            }
            my hash %token = ();
            $token{"type"} = "STR_LITERAL";
            $token{"value"} = $body;
            $token{"line"} = $token_line;
            return \%token;
        }

        # Not a heredoc — check <<= before <<
        if (lex_current_code($lexer) == '=') {
            lex_advance($lexer);
            my hash %token = ();
            $token{"type"} = "LSHIFT_ASSIGN";
            $token{"value"} = "<<=";
            $token{"line"} = $token_line;
            return \%token;
        }
        my hash %token = ();
        $token{"type"} = "LSHIFT";
        $token{"value"} = "<<";
        $token{"line"} = $token_line;
        return \%token;
    }

    # >>=
    if ($code == '>' && $code2 == '>' && char_at($lexer->{"source"}, $lexer->{"pos"} + 2) == '=') {
        lex_advance($lexer);
        lex_advance($lexer);
        lex_advance($lexer);
        my hash %token = ();
        $token{"type"} = "RSHIFT_ASSIGN";
        $token{"value"} = ">>=";
        $token{"line"} = $token_line;
        return \%token;
    }

    # >>
    if ($code == '>' && $code2 == '>') {
        lex_advance($lexer);
        lex_advance($lexer);
        my hash %token = ();
        $token{"type"} = "RSHIFT";
        $token{"value"} = ">>";
        $token{"line"} = $token_line;
        return \%token;
    }

    # ::
    if ($code == ':' && $code2 == ':') {
        lex_advance($lexer);
        lex_advance($lexer);
        $lexer->{"after_arrow"} = 1;
        my hash %token = ();
        $token{"type"} = "DOUBLE_COLON";
        $token{"value"} = "::";
        $token{"line"} = $token_line;
        return \%token;
    }

    # ->
    if ($code == '-' && $code2 == '>') {
        lex_advance($lexer);
        lex_advance($lexer);
        $lexer->{"after_arrow"} = 1;
        $lexer->{"after_member_arrow"} = 1;
        my hash %token = ();
        $token{"type"} = "ARROW";
        $token{"value"} = "->";
        $token{"line"} = $token_line;
        return \%token;
    }

    # =>
    if ($code == '=' && $code2 == '>') {
        lex_advance($lexer);
        lex_advance($lexer);
        $lexer->{"expect_regex"} = 1;
        my hash %token = ();
        $token{"type"} = "FAT_ARROW";
        $token{"value"} = "=>";
        $token{"line"} = $token_line;
        return \%token;
    }

    # +=
    if ($code == '+' && $code2 == '=') {
        lex_advance($lexer);
        lex_advance($lexer);
        my hash %token = ();
        $token{"type"} = "PLUS_ASSIGN";
        $token{"value"} = "+=";
        $token{"line"} = $token_line;
        return \%token;
    }

    # -=
    if ($code == '-' && $code2 == '=') {
        lex_advance($lexer);
        lex_advance($lexer);
        my hash %token = ();
        $token{"type"} = "MINUS_ASSIGN";
        $token{"value"} = "-=";
        $token{"line"} = $token_line;
        return \%token;
    }

    # ++
    if ($code == '+' && $code2 == '+') {
        lex_advance($lexer);
        lex_advance($lexer);
        my hash %token = ();
        $token{"type"} = "PLUSPLUS";
        $token{"value"} = "++";
        $token{"line"} = $token_line;
        return \%token;
    }

    # --
    if ($code == '-' && $code2 == '-') {
        lex_advance($lexer);
        lex_advance($lexer);
        my hash %token = ();
        $token{"type"} = "MINUSMINUS";
        $token{"value"} = "--";
        $token{"line"} = $token_line;
        return \%token;
    }

    # **= - power-assign (checked before **)
    if ($code == '*' && $code2 == '*' && char_at($lexer->{"source"}, $lexer->{"pos"} + 2) == '=') {
        lex_advance($lexer);
        lex_advance($lexer);
        lex_advance($lexer);
        my hash %token = ();
        $token{"type"} = "POWER_ASSIGN";
        $token{"value"} = "**=";
        $token{"line"} = $token_line;
        return \%token;
    }

    # ** - exponentiation
    if ($code == '*' && $code2 == '*') {
        lex_advance($lexer);
        lex_advance($lexer);
        my hash %token = ();
        $token{"type"} = "POWER";
        $token{"value"} = "**";
        $token{"line"} = $token_line;
        return \%token;
    }

    # %= - mod-assign. A real hash sigil is always followed by
    # an identifier/sigil char, never '=', so this can't shadow %hash syntax.
    if ($code == '%' && $code2 == '=') {
        lex_advance($lexer);
        lex_advance($lexer);
        my hash %token = ();
        $token{"type"} = "MOD_ASSIGN";
        $token{"value"} = "%=";
        $token{"line"} = $token_line;
        return \%token;
    }

    # *= — checked after **/**= so those lex first
    if ($code == '*' && $code2 == '=') {
        lex_advance($lexer);
        lex_advance($lexer);
        my hash %token = ();
        $token{"type"} = "STAR_ASSIGN";
        $token{"value"} = "*=";
        $token{"line"} = $token_line;
        return \%token;
    }

    # /= — safe w.r.t. regex literals: a / in regex position is
    # consumed by the expect_regex branch above before this scan runs, and
    # // is a different second char so defined-or is unaffected
    if ($code == '/' && $code2 == '=') {
        lex_advance($lexer);
        lex_advance($lexer);
        my hash %token = ();
        $token{"type"} = "SLASH_ASSIGN";
        $token{"value"} = "/=";
        $token{"line"} = $token_line;
        return \%token;
    }

    # .=
    if ($code == '.' && $code2 == '=') {
        lex_advance($lexer);
        lex_advance($lexer);
        my hash %token = ();
        $token{"type"} = "DOT_ASSIGN";
        $token{"value"} = ".=";
        $token{"line"} = $token_line;
        return \%token;
    }

    # &=
    if ($code == '&' && $code2 == '=') {
        lex_advance($lexer);
        lex_advance($lexer);
        my hash %token = ();
        $token{"type"} = "BIT_AND_ASSIGN";
        $token{"value"} = "&=";
        $token{"line"} = $token_line;
        return \%token;
    }

    # |=
    if ($code == '|' && $code2 == '=') {
        lex_advance($lexer);
        lex_advance($lexer);
        my hash %token = ();
        $token{"type"} = "BIT_OR_ASSIGN";
        $token{"value"} = "|=";
        $token{"line"} = $token_line;
        return \%token;
    }

    # ^=
    if ($code == '^' && $code2 == '=') {
        lex_advance($lexer);
        lex_advance($lexer);
        my hash %token = ();
        $token{"type"} = "BIT_XOR_ASSIGN";
        $token{"value"} = "^=";
        $token{"line"} = $token_line;
        return \%token;
    }

    # =~
    if ($code == '=' && $code2 == '~') {
        lex_advance($lexer);
        lex_advance($lexer);
        $lexer->{"expect_regex"} = 1;
        $lexer->{"expect_subst"} = 1;
        my hash %token = ();
        $token{"type"} = "MATCH_OP";
        $token{"value"} = "=~";
        $token{"line"} = $token_line;
        return \%token;
    }

    # !~
    if ($code == '!' && $code2 == '~') {
        lex_advance($lexer);
        lex_advance($lexer);
        $lexer->{"expect_regex"} = 1;
        my hash %token = ();
        $token{"type"} = "NOT_MATCH_OP";
        $token{"value"} = "!~";
        $token{"line"} = $token_line;
        return \%token;
    }

    # ... (ellipsis) and .. (range)
    if ($code == '.' && $code2 == '.') {
        my int $code3 = char_at($source, $pos + 2);
        if ($code3 == '.') {
            lex_advance($lexer);
            lex_advance($lexer);
            lex_advance($lexer);
            my hash %token = ();
            $token{"type"} = "ELLIPSIS";
            $token{"value"} = "...";
            $token{"line"} = $token_line;
            return \%token;
        }
        # Just ..
        lex_advance($lexer);
        lex_advance($lexer);
        my hash %token = ();
        $token{"type"} = "RANGE";
        $token{"value"} = "..";
        $token{"line"} = $token_line;
        return \%token;
    }

    # Single-character tokens
    my str $single_val = substr_bytes($source, $pos, 1);
    lex_advance($lexer);

    my hash %token = ();
    $token{"value"} = $single_val;
    $token{"line"} = $token_line;

    if ($code == '(') { $token{"type"} = "LPAREN"; $lexer->{"expect_regex"} = 1; return \%token; }
    if ($code == ')') { $token{"type"} = "RPAREN"; return \%token; }
    if ($code == '{') { $token{"type"} = "LBRACE"; $lexer->{"expect_regex"} = 1; return \%token; }
    if ($code == '}') { $token{"type"} = "RBRACE"; return \%token; }
    if ($code == '[') { $token{"type"} = "LBRACKET"; $lexer->{"expect_regex"} = 1; return \%token; }
    if ($code == ']') { $token{"type"} = "RBRACKET"; return \%token; }
    if ($code == ';') { $token{"type"} = "SEMI"; $lexer->{"expect_regex"} = 1; return \%token; }
    if ($code == ',') { $token{"type"} = "COMMA"; $lexer->{"expect_regex"} = 1; return \%token; }
    if ($code == ':') { $token{"type"} = "COLON"; $lexer->{"expect_regex"} = 1; return \%token; }
    if ($code == '$') { $token{"type"} = "DOLLAR"; $lexer->{"after_sigil"} = 1; return \%token; }
    if ($code == '@') { $token{"type"} = "AT"; $lexer->{"after_sigil"} = 1; return \%token; }
    if ($code == '%') { $token{"type"} = "PERCENT"; $lexer->{"after_sigil"} = 1; return \%token; }
    if ($code == '+') { $token{"type"} = "PLUS"; return \%token; }
    if ($code == '-') { $token{"type"} = "MINUS"; return \%token; }
    if ($code == '*') { $token{"type"} = "MULT"; return \%token; }
    if ($code == '/') { $token{"type"} = "DIV"; return \%token; }
    if ($code == '.') { $token{"type"} = "DOT"; return \%token; }
    if ($code == '=') { $token{"type"} = "ASSIGN"; $lexer->{"expect_regex"} = 1; return \%token; }
    if ($code == '<') { $token{"type"} = "LT"; return \%token; }
    if ($code == '>') { $token{"type"} = "GT"; return \%token; }
    if ($code == '!') { $token{"type"} = "NOT"; $lexer->{"expect_regex"} = 1; return \%token; }
    if ($code == '\\') { $token{"type"} = "BACKSLASH"; return \%token; }
    if ($code == '&') { $token{"type"} = "AMPERSAND"; return \%token; }
    if ($code == '|') { $token{"type"} = "PIPE"; return \%token; }
    if ($code == '^') { $token{"type"} = "CARET"; return \%token; }
    if ($code == '~') { $token{"type"} = "TILDE"; return \%token; }
    if ($code == '?') { $token{"type"} = "QUESTION"; $lexer->{"expect_regex"} = 1; return \%token; }

    lex_error($lexer, "Unexpected character: " . $single_val, $token_line, $token_col);
}

func lex_tokenize(str $source) array {
    return lex_tokenize_file($source, "");
}

# Tokenize with a filename for diagnostics: lexer errors report "file:line:".
func lex_tokenize_file(str $source, str $filename) array {
    return lex_tokenize_file_defs($source, $filename, 0);
}

# Tokenize with command-line defines (a hash of NAME => 1) for #ifdef. The
# defines are also attached to the EOF token so the parser can hand them to
# every `use`d module.
func lex_tokenize_file_defs(str $source, str $filename, scalar $cli_defs) array {
    my hash $lexer = lex_new($source);
    $lexer->{"file"} = $filename;
    lex_pp_init($lexer);
    if ($cli_defs) {
        my scalar $defs = $lexer->{"pp_defines"};
        my array @dk = keys(%{$cli_defs});
        my int $dki = 0;
        while ($dki < size(@dk)) {
            $defs->{$dk[$dki]} = $cli_defs->{$dk[$dki]};
            $dki = $dki + 1;
        }
    }
    my array @tokens = ();
    my str $prev_type = "";
    my int $prev_is_word = 0;
    my str $prev2_type = "";
    my str $prev3_type = "";
    my array @brace_is_expr = ();
    my int $brace_depth = 0;
    my int $last_rbrace_is_expr = 0;

    while (1) {
        my scalar $token = lex_next_token($lexer);
        $token->{"column"} = $lexer->{"tok_col"};
        my str $cur_type = $token->{"type"};

        # Track whether `{` opens a subscript/deref/braced-var expression
        # (`$h{k}`, `$r->{k}`, `${x}`, `$a[0]{k}`, `$h{a}{b}`) vs a code block
        # or anonymous hash (`sort { ... } %h`, `if (...) { ... } %h`, `{ a => 1 }`).
        if ($cur_type eq "LBRACE") {
            my int $is_expr_brace = 0;
            if ($prev_type eq "ARROW" || $prev_type eq "DOLLAR" || $prev_type eq "AT" || $prev_type eq "PERCENT" || $prev_type eq "RBRACKET") {
                $is_expr_brace = 1;
            } elsif ($prev_type eq "RBRACE" && $last_rbrace_is_expr == 1) {
                $is_expr_brace = 1;
            } elsif ($prev_is_word == 1 && ($prev2_type eq "DOLLAR" || $prev2_type eq "AT" || $prev2_type eq "PERCENT") && $prev3_type ne "CASE") {
                $is_expr_brace = 1;
            }
            $brace_is_expr[$brace_depth] = $is_expr_brace;
            $brace_depth = $brace_depth + 1;
        } elsif ($cur_type eq "RBRACE") {
            if ($brace_depth > 0) {
                $brace_depth = $brace_depth - 1;
                $last_rbrace_is_expr = $brace_is_expr[$brace_depth];
            } else {
                $last_rbrace_is_expr = 0;
            }
        }

        # Disambiguate PERCENT (hash sigil) vs MOD (modulo operator)
        # If previous token could end a value expression, % is modulo
        if ($cur_type eq "PERCENT") {
            if (lex_prev_ends_value($prev_type, $prev_is_word, $prev2_type, $last_rbrace_is_expr) == 1) {
                $token->{"type"} = "MOD";
                $cur_type = "MOD";
            }
        }

        my int $cur_is_word = 0;
        if ($token->{"is_word"} != 0) {
            $cur_is_word = 1;
        }
        $lexer->{"after_value"} = lex_prev_ends_value($cur_type, $cur_is_word, $prev_type, $last_rbrace_is_expr);

        push(@tokens, $token);
        $prev3_type = $prev2_type;
        $prev2_type = $prev_type;
        $prev_type = $cur_type;
        $prev_is_word = $cur_is_word;

        if ($cur_type eq "EOF") {
            $token->{"pp_cli_defines"} = $cli_defs;
            return \@tokens;
        }
    }
}

# Shared helper: returns 1 when the previous token closes a value expression
# (used to disambiguate both `%` as MOD vs hash sigil and `<<` as LSHIFT vs heredoc).
func lex_prev_ends_value(str $prev_type, int $prev_is_word, str $prev2_type, int $last_rbrace_is_expr) int {
    if ($prev_type eq "RBRACE") {
        return $last_rbrace_is_expr;
    }
    if ($prev_is_word == 1 && $prev2_type eq "DOLLAR") {
        return 1;
    }
    return lex_is_value_ending_token($prev_type);
}

# Check if a token type can end a value expression
# These tokens, when followed by %, indicate modulo not hash sigil
func lex_is_value_ending_token(str $type) int {
    # Closing brackets/parens (RBRACE is handled via brace_is_expr stack so
    # `$h{"k"} % 2` is MOD while `sort { ... } %h` and `if (...) { ... } %h` stay PERCENT)
    if ($type eq "RPAREN") { return 1; }
    if ($type eq "RBRACKET") { return 1; }

    # Literals (actual token types used by lexer)
    if ($type eq "INT_LITERAL") { return 1; }
    if ($type eq "NUM_LITERAL") { return 1; }
    if ($type eq "STR_LITERAL") { return 1; }
    if ($type eq "INTERP_STRING") { return 1; }
    if ($type eq "QW_LITERAL") { return 1; }
    if ($type eq "DIAMOND") { return 1; }
    if ($type eq "UNDEF") { return 1; }
    if ($type eq "DUNDER_LINE") { return 1; }
    if ($type eq "DUNDER_FILE") { return 1; }
    if ($type eq "DUNDER_PACKAGE") { return 1; }

    # Identifiers (variable names, function calls)
    if ($type eq "IDENT") { return 1; }

    # Post-increment/decrement
    if ($type eq "PLUSPLUS") { return 1; }
    if ($type eq "MINUSMINUS") { return 1; }

    return 0;
}
