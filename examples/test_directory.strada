# test_directory.strada - Test directory functions

func main() int {
    say("=== Directory Functions Test ===");
    say("");

    # A scratch directory with known contents, so the listings below are
    # reproducible (the contents of /tmp or the current directory vary).
    my str $dir = "/tmp/strada_dir_test_" . core::getpid();
    sys::mkdir($dir);
    foreach my str $f ("alpha.txt", "beta.txt", "gamma.txt") { sys::spew($dir . "/" . $f, "x"); }

    # Test readdir (entry order is up to the file system: sort it)
    say("=== Reading the scratch directory ===");
    my scalar $files = sys::readdir($dir);
    if (defined($files)) {
        my int $count = size($files);
        say("Found " . $count . " entries");
        foreach my str $name (sort(@{$files})) {
            say("  " . $name);
        }
    } else {
        say("Could not read " . $dir);
    }
    say("");

    # Test is_dir and is_file
    say("=== Path Type Checks ===");
    say("/tmp is_dir: " . sys::is_dir("/tmp"));
    say("/tmp is_file: " . sys::is_file("/tmp"));
    say("/etc/passwd is_dir: " . sys::is_dir("/etc/passwd"));
    say("/etc/passwd is_file: " . sys::is_file("/etc/passwd"));
    say("");

    # Test readdir_full: entries prefixed with the directory path
    say("=== Reading with full paths ===");
    my scalar $full_paths = sys::readdir_full($dir);
    if (defined($full_paths)) {
        my int $count = size($full_paths);
        say("Found " . $count . " entries");
        foreach my str $path (sort(@{$full_paths})) {
            # show the part after the (per-run) directory name
            say("  <dir>" . substr($path, length($dir)));
        }
    }
    say("");

    foreach my str $f ("alpha.txt", "beta.txt", "gamma.txt") { sys::unlink($dir . "/" . $f); }
    sys::rmdir($dir);
    say("Directory tests completed!");
    return 0;
}
