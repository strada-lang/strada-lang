# my array @a = (f()) / ($o->m()) where the call returns a plain scalar is a
# one-element list; arrays still pass through; undef gives an empty list.
package Rec;
func new_rec(int $id) scalar { my hash %h = ("id" => $id); return bless(\%h, "Rec"); }
func id(scalar $self) int { return $self->{"id"}; }
func tags(scalar $self) array { my array @t = ("a", "b"); return @t; }
package main;
func five() int { return 5; }
func nothing() scalar { return undef; }
func pair() array { my array @p = (1, 2); return @p; }
func a_hashref() scalar { return {"id" => "t1"}; }
func an_arrayref() scalar { my array @x = (7, 8, 9); return \@x; }
func main() int {
    my int $fail = 0;
    my scalar $r = Rec::new_rec(7);
    my array @a = ($r->id());
    if (scalar(@a) != 1 || $a[0] != 7) { say("FAIL method scalar"); $fail = 1; }
    my array @b = five();
    if (scalar(@b) != 1 || $b[0] != 5) { say("FAIL function scalar"); $fail = 1; }
    my array @c = pair();
    if (scalar(@c) != 2) { say("FAIL array function"); $fail = 1; }
    my array @d = $r->tags();
    if (scalar(@d) != 2) { say("FAIL array method"); $fail = 1; }
    my array @e = nothing();
    if (scalar(@e) != 0) { say("FAIL undef"); $fail = 1; }
    my str $nm = "Wile";
    my array @f = (lc($nm));
    if (scalar(@f) != 1 || $f[0] ne "wile") { say("FAIL builtin scalar"); $fail = 1; }
    my array @g = split(",", "x,y,z");
    if (scalar(@g) != 3) { say("FAIL builtin array"); $fail = 1; }
    my array @h = ({"v" => 1});
    push(@h, {"v" => 2});
    if (scalar(@h) != 2 || $h[0]->{"v"} != 1) { say("FAIL single hash literal"); $fail = 1; }
    my array @i = ();
    @i = ({"v" => 1});
    if (scalar(@i) != 1) { say("FAIL assign hash literal"); $fail = 1; }
    @i = five();
    if (scalar(@i) != 1 || $i[0] != 5) { say("FAIL assign scalar call"); $fail = 1; }
    @i = ($r->id());
    if (scalar(@i) != 1) { say("FAIL assign method"); $fail = 1; }
    @i = pair();
    if (scalar(@i) != 2) { say("FAIL assign array call"); $fail = 1; }
    @i = nothing();
    if (scalar(@i) != 0) { say("FAIL assign undef"); $fail = 1; }
    my array @hr = (a_hashref());
    push(@hr, {"id" => "t2"});
    if (scalar(@hr) != 2 || $hr[0]->{"id"} ne "t1") { say("FAIL hash ref result is one element"); $fail = 1; }
    my array @ar = an_arrayref();
    if (scalar(@ar) != 3) { say("FAIL array ref result is the list"); $fail = 1; }
    @hr = (a_hashref());
    if (scalar(@hr) != 1) { say("FAIL assign hash ref result"); $fail = 1; }
    if ($fail == 0) { say("all array from scalar call tests passed"); }
    return $fail;
}
