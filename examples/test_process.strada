# test_process.strada - Test sleep, usleep, fork, and process functions

func main() int {
    say("=== Process Control Test ===");
    say("");

    # Test getpid
    # (PIDs differ on every run, so the checks below print relations)
    my int $pid = sys::getpid();
    say("Current PID is positive: " . ($pid > 0 ? "yes" : "no"));

    # Test usleep (100ms = 100000 microseconds)
    say("Sleeping for 100ms...");
    sys::usleep(100000);
    say("Woke up!");

    # Test fork
    say("");
    say("Forking...");
    my int $child = sys::fork();

    if ($child == 0) {
        # Child process: it prints while the parent is blocked in wait()
        say("  Child: Hello from child! PPID is the parent: " . (sys::getppid() == $pid ? "yes" : "no"));
        sys::usleep(50000);
        say("  Child: Exiting");
        exit(42);
    } elsif ($child > 0) {
        # Parent process: print only after wait(), so the output order is fixed
        my int $waited = sys::wait();
        say("  Parent: Forked child and waited for it: " . ($waited == $child ? "yes" : "no"));
    } else {
        say("  Fork failed!");
        return 1;
    }

    say("");
    say("=== Test Complete ===");
    return 0;
}
