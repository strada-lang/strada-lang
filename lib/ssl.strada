=head1 NAME

ssl - SSL/TLS Socket Module for Strada

=head1 SYNOPSIS

    use lib "lib";
    use ssl;

    # Connect to HTTPS server
    my int $conn = ssl::connect("example.com", 443);
    ssl::write($conn, "GET / HTTP/1.1\r\nHost: example.com\r\n\r\n");
    my str $response = ssl::read($conn, 4096);
    ssl::close($conn);

    # Convenience function for HTTP GET
    my str $page = ssl::http_get("example.com", 443, "/path");

=head1 DESCRIPTION

The ssl module provides SSL/TLS socket operations using OpenSSL.
It supports both client and server modes with full TLS 1.3 support.

B<Compile with:> C<./strada myapp.strada -lssl -lcrypto>

=head1 CLIENT FUNCTIONS

=head2 connect($host, $port)

Connect to an SSL/TLS server. Returns a connection handle (int) or 0 on failure.

    my int $conn = ssl::connect("api.example.com", 443);
    if ($conn == 0) {
        say("Connection failed: " . ssl::error());
    }

=head2 write($conn, $data)

Write data to the SSL connection. Returns bytes written or -1 on error.

    my int $sent = ssl::write($conn, "Hello, server!");

=head2 read($conn, $max_len)

Read up to C<$max_len> bytes from the connection.

    my str $data = ssl::read($conn, 4096);

=head2 readline($conn, $max_len)

Read a line (up to newline) from the connection.

    my str $line = ssl::readline($conn, 1024);

On a non-blocking connection (for example one made with C<attach_fd>),
C<read>, C<readline>, C<write> and C<write_binary> wait for the peer for
at most the connection's timeout (default 5000 ms). If nothing arrives in
that time, reads return C<""> and writes return the bytes written so far
(or -1). Blocking sockets are governed by the kernel (SO_RCVTIMEO /
SO_SNDTIMEO) instead.

=head2 set_timeout($conn, $ms)

Set how long blocking-style reads/writes on this connection wait for a
non-blocking peer: C<$ms> milliseconds, C<0> to not wait at all, or a
negative value to wait indefinitely. Returns 1 on success, 0 for a bad handle.

    ssl::set_timeout($conn, 30000);   # slow peer: allow 30 s

=head2 set_default_timeout($ms)

Set the process-wide default used by connections that have not called
C<set_timeout> (initially 5000 ms; same meaning of 0 and negative values).
Returns the previous default.

=head2 close($conn)

Close the SSL connection and free resources.

    ssl::close($conn);

=head1 SERVER FUNCTIONS

=head2 server($port, $cert_file, $key_file)

Create an SSL server socket. Returns server handle or 0 on failure.

    my int $server = ssl::server(8443, "cert.pem", "key.pem");

=head2 accept($server)

Accept a client connection. Returns client handle or 0 on failure.

    my int $client = ssl::accept($server);
    if ($client != 0) {
        my str $request = ssl::read($client, 4096);
        ssl::write($client, "HTTP/1.1 200 OK\r\n\r\nHello!");
        ssl::close($client);
    }

=head1 UTILITY FUNCTIONS

=head2 init()

Initialize OpenSSL (called automatically by connect/server).

=head2 error()

Get the last SSL error message.

    say("Error: " . ssl::error());

=head2 peer_cert($conn)

Get the peer certificate subject.

    my str $subject = ssl::peer_cert($conn);

=head2 get_version($conn)

Get the SSL/TLS protocol version in use.

    my str $ver = ssl::get_version($conn);  # e.g., "TLSv1.3"

=head2 cipher($conn)

Get the cipher suite in use.

    my str $cipher = ssl::cipher($conn);  # e.g., "TLS_AES_256_GCM_SHA384"

=head2 verify($conn)

Verify the server certificate. Returns 0 if valid, error code otherwise.

    my int $result = ssl::verify($conn);
    if ($result == 0) {
        say("Certificate is valid");
    }

=head2 fd($conn)

Get the underlying socket file descriptor.

=head2 http_get($host, $port, $path)

Convenience function for HTTPS GET requests.

    my str $response = ssl::http_get("api.example.com", 443, "/v1/data");

=head1 EXAMPLE

    use lib "lib";
    use ssl;

    # HTTPS client
    my int $conn = ssl::connect("httpbin.org", 443);
    if ($conn == 0) {
        die("Connection failed");
    }

    say("Connected using " . ssl::get_version($conn));
    say("Cipher: " . ssl::cipher($conn));

    my str $request = "GET /ip HTTP/1.1\r\n";
    $request = $request . "Host: httpbin.org\r\n";
    $request = $request . "Connection: close\r\n\r\n";

    ssl::write($conn, $request);

    my str $response = "";
    my str $chunk = ssl::read($conn, 4096);
    while (core::byte_length($chunk) > 0) {
        $response = $response . $chunk;
        $chunk = ssl::read($conn, 4096);
    }

    say($response);
    ssl::close($conn);

=head1 SEE ALSO

L<LWP_SSL>, L<LWP>

=cut

package ssl;

# Auto-link OpenSSL for any program that `use`s this module
link_lib "ssl";
link_lib "crypto";

# C includes and type definitions
__C__ {
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>
#include <signal.h>
#include <sys/socket.h>
#include <sys/time.h>
#include <netinet/in.h>
#include <arpa/inet.h>
#include <netdb.h>
#include <poll.h>
#include <errno.h>
#include <openssl/ssl.h>
#include <openssl/err.h>
#include <openssl/x509v3.h>

typedef struct {
    int socket_fd;
    SSL *ssl;
    SSL_CTX *ctx;
    int is_server;
    int last_want;   /* after a would-block: 1 = want-read, 2 = want-write */
    int borrowed_fd; /* fd owned by a Strada socket SV — do not close here */
    int wait_ms;     /* per-connection wait limit (see ssl::set_timeout) */
    int wait_ms_set; /* 0 = use the process default (ssl::set_default_timeout) */
} SSLConnection;

static int ssl_initialized = 0;
static char ssl_errbuf[256];

static int ssl_has_crlf(const char *s) {
    if (!s) return 0;
    for (; *s; s++) {
        if (*s == '\r' || *s == '\n') return 1;
    }
    return 0;
}

static const char *ssl_extract_bytes(StradaValue *sv, size_t *out_len, char **out_owned) {
    *out_owned = NULL;
    if (!sv) {
        *out_len = 0;
        return "";
    }
    if (!STRADA_IS_TAGGED_INT(sv)) {
        if (sv->type == STRADA_STR && !(sv->meta && sv->meta->is_tied)) {
            *out_len = STRADA_STR_BYTELEN(sv);
            return sv->value.pv ? sv->value.pv : "";
        }
        if (sv->type == STRADA_UNDEF) {
            *out_len = 0;
            return "";
        }
    }
    char *s = strada_to_str(sv);
    *out_owned = s;
    *out_len = s ? strlen(s) : 0;
    return s ? s : "";
}

/* How long a blocking-style read/write waits for a non-blocking fd to
 * become ready before giving up (peer went silent). Milliseconds; < 0 waits
 * indefinitely, 0 does not wait. Process default, overridable per
 * connection: ssl::set_default_timeout / ssl::set_timeout. */
static int ssl_default_wait_ms = 5000;

static void ssl_apply_sock_timeout(SSLConnection *c) {
    if (!c || c->socket_fd < 0) return;
    int wait_ms = c->wait_ms_set ? c->wait_ms : ssl_default_wait_ms;
    struct timeval tv;
    if (wait_ms < 0) {
        tv.tv_sec = 0;
        tv.tv_usec = 0;
    } else if (wait_ms == 0) {
        tv.tv_sec = 0;
        tv.tv_usec = 1;
    } else {
        tv.tv_sec = wait_ms / 1000;
        tv.tv_usec = (wait_ms % 1000) * 1000;
    }
    setsockopt(c->socket_fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
    setsockopt(c->socket_fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
}

/* Wait for the fd to become ready after SSL_ERROR_WANT_READ/WRITE.
 * Returns 1 if the caller should retry the SSL call, 0 if it should give up:
 *   - blocking fd: WANT_* only happens when SO_RCVTIMEO/SO_SNDTIMEO already
 *     expired in the kernel, so give up at once (the caller's timeout);
 *   - non-blocking fd: poll for up to the connection's wait limit (default
 *     5000 ms); give up on timeout or poll error. Without this bound a
 *     silent peer hung read() forever. */
static int ssl_wait_want(SSLConnection *c, int err) {
    if (!c || c->socket_fd < 0) return 0;
    int fl = fcntl(c->socket_fd, F_GETFL, 0);
    if (fl < 0 || !(fl & O_NONBLOCK)) return 0;
    int wait_ms = c->wait_ms_set ? c->wait_ms : ssl_default_wait_ms;
    if (wait_ms == 0) return 0;
    if (wait_ms < 0) wait_ms = -1;   /* poll(): infinite */
    struct pollfd pfd;
    pfd.fd = c->socket_fd;
    pfd.events = (err == SSL_ERROR_WANT_WRITE) ? POLLOUT : POLLIN;
    pfd.revents = 0;
    int r;
    do {
        r = poll(&pfd, 1, wait_ms);
    } while (r < 0 && errno == EINTR);
    return r > 0 ? 1 : 0;
}

static int ssl_read_retry(SSLConnection *c, char *buf, int max_len) {
    for (;;) {
        int n = SSL_read(c->ssl, buf, max_len);
        if (n > 0) return n;
        int err = SSL_get_error(c->ssl, n);
        if (err == SSL_ERROR_WANT_READ || err == SSL_ERROR_WANT_WRITE) {
            if (!ssl_wait_want(c, err)) return n;
            continue;
        }
        if (err == SSL_ERROR_SYSCALL && errno == EINTR) continue;
        return n;
    }
}

static int ssl_write_all_retry(SSLConnection *c, const char *data, size_t len) {
    size_t total = 0;
    while (total < len) {
        size_t chunk = len - total;
        if (chunk > 0x40000000UL) chunk = 0x40000000UL;
        int n = SSL_write(c->ssl, data + total, (int)chunk);
        if (n > 0) {
            total += (size_t)n;
            continue;
        }
        int err = SSL_get_error(c->ssl, n);
        if (err == SSL_ERROR_WANT_READ || err == SSL_ERROR_WANT_WRITE) {
            if (!ssl_wait_want(c, err)) return total > 0 ? (int)total : -1;
            continue;
        }
        if (err == SSL_ERROR_SYSCALL && errno == EINTR) continue;
        return total > 0 ? (int)total : -1;
    }
    return (int)total;
}
}

# Initialize OpenSSL (called automatically by connect/server)
func init() int {
    __C__ {
        if (!ssl_initialized) {
            signal(SIGPIPE, SIG_IGN);
            SSL_library_init();
            SSL_load_error_strings();
            OpenSSL_add_all_algorithms();
            ssl_initialized = 1;
        }
    }
    return 0;
}

# Connect to an SSL/TLS server
# Returns connection handle (int, actually pointer) or 0 on failure
func connect_impl(str $host, int $port, int $verify) int {
    my int $result = 0;
    __C__ {
        if (!ssl_initialized) {
            signal(SIGPIPE, SIG_IGN);
            SSL_library_init();
            SSL_load_error_strings();
            OpenSSL_add_all_algorithms();
            ssl_initialized = 1;
        }

        char *host_str = strada_to_str(host);
        int port_val = (int)strada_to_int(port);
        int do_verify = (int)strada_to_int(verify);

        if (!host_str || !host_str[0] || ssl_has_crlf(host_str) || port_val <= 0 || port_val > 65535) {
            free(host_str);
        } else {
            /* Strip optional [...] around IPv6 literal */
            const char *clean_host = host_str;
            char *unbracketed = NULL;
            size_t hlen = strlen(host_str);
            if (hlen >= 2 && host_str[0] == '[' && host_str[hlen - 1] == ']') {
                unbracketed = malloc(hlen - 1);
                if (unbracketed) {
                    memcpy(unbracketed, host_str + 1, hlen - 2);
                    unbracketed[hlen - 2] = '\0';
                    clean_host = unbracketed;
                }
            }

            struct in_addr ipv4_tmp;
            struct in6_addr ipv6_tmp;
            int is_ip = (inet_pton(AF_INET, clean_host, &ipv4_tmp) == 1 ||
                         inet_pton(AF_INET6, clean_host, &ipv6_tmp) == 1) ? 1 : 0;

            char port_buf[16];
            snprintf(port_buf, sizeof(port_buf), "%d", port_val);

            struct addrinfo hints;
            struct addrinfo *res = NULL;
            memset(&hints, 0, sizeof(hints));
            hints.ai_family = AF_UNSPEC;
            hints.ai_socktype = SOCK_STREAM;

            int sock_fd = -1;
            if (getaddrinfo(clean_host, port_buf, &hints, &res) == 0 && res) {
                int timeout_ms = ssl_default_wait_ms;
                for (struct addrinfo *rp = res; rp != NULL; rp = rp->ai_next) {
                    int fd = socket(rp->ai_family, rp->ai_socktype, rp->ai_protocol);
                    if (fd < 0) continue;
                    int fl = fcntl(fd, F_GETFL, 0);
                    int ok = 0;
                    if (timeout_ms >= 0 && fl >= 0 && fcntl(fd, F_SETFL, fl | O_NONBLOCK) == 0) {
                        int cr = connect(fd, rp->ai_addr, rp->ai_addrlen);
                        if (cr == 0) {
                            ok = 1;
                        } else if (errno == EINPROGRESS) {
                            struct pollfd pfd;
                            pfd.fd = fd;
                            pfd.events = POLLOUT;
                            pfd.revents = 0;
                            int pr;
                            do {
                                pr = poll(&pfd, 1, timeout_ms);
                            } while (pr < 0 && errno == EINTR);
                            if (pr > 0) {
                                int so_err = 0;
                                socklen_t slen = sizeof(so_err);
                                if (getsockopt(fd, SOL_SOCKET, SO_ERROR, &so_err, &slen) == 0 && so_err == 0) {
                                    ok = 1;
                                }
                            }
                        }
                        fcntl(fd, F_SETFL, fl);
                    } else {
                        if (connect(fd, rp->ai_addr, rp->ai_addrlen) == 0) ok = 1;
                    }
                    if (ok) {
                        sock_fd = fd;
                        break;
                    }
                    close(fd);
                }
                freeaddrinfo(res);
            }

            if (sock_fd >= 0) {
                SSLConnection *conn = malloc(sizeof(SSLConnection));
                if (!conn) {
                    close(sock_fd);
                } else {
                    memset(conn, 0, sizeof(SSLConnection));
                    conn->is_server = 0;
                    conn->socket_fd = sock_fd;
                    ssl_apply_sock_timeout(conn);

                    const SSL_METHOD *method = TLS_client_method();
                    conn->ctx = SSL_CTX_new(method);
                    if (!conn->ctx) {
                        close(sock_fd);
                        free(conn);
                    } else {
                        if (do_verify) {
                            /* Verify the peer cert chain against the system trust store. */
                            SSL_CTX_set_verify(conn->ctx, SSL_VERIFY_PEER, NULL);
                            SSL_CTX_set_default_verify_paths(conn->ctx);
                        }
                        conn->ssl = SSL_new(conn->ctx);
                        if (!conn->ssl) {
                            close(sock_fd);
                            SSL_CTX_free(conn->ctx);
                            free(conn);
                        } else {
                            SSL_set_fd(conn->ssl, conn->socket_fd);
                            if (!is_ip) {
                                SSL_set_tlsext_host_name(conn->ssl, clean_host);
                            }
                            if (do_verify) {
                                if (is_ip) {
                                    X509_VERIFY_PARAM *vparam = SSL_get0_param(conn->ssl);
                                    if (!vparam || X509_VERIFY_PARAM_set1_ip_asc(vparam, clean_host) != 1) {
                                        SSL_set_verify(conn->ssl, SSL_VERIFY_PEER, NULL);
                                        /* Force failure if param cannot be set */
                                    }
                                } else {
                                    SSL_set1_host(conn->ssl, clean_host);
                                }
                            }
                            if (SSL_connect(conn->ssl) <= 0) {
                                SSL_free(conn->ssl);
                                close(conn->socket_fd);
                                SSL_CTX_free(conn->ctx);
                                free(conn);
                            } else {
                                strada_decref(result);
                                result = strada_new_int((int64_t)(intptr_t)conn);
                            }
                        }
                    }
                }
            }
            free(unbracketed);
            free(host_str);
        }
    }
    return $result;
}

# Connect with certificate + hostname verification (the secure default).
func connect(str $host, int $port) int {
    return connect_impl($host, $port, 1);
}

# INSECURE: connect WITHOUT certificate/hostname verification. Use only when you
# knowingly accept the MITM risk (e.g. a self-signed dev endpoint or pinned-out
# environment).
func connect_insecure(str $host, int $port) int {
    return connect_impl($host, $port, 0);
}

# Create an SSL server socket
func server(int $port, str $cert_file, str $key_file) int {
    my int $result = 0;
    __C__ {
        if (!ssl_initialized) {
            signal(SIGPIPE, SIG_IGN);
            SSL_library_init();
            SSL_load_error_strings();
            OpenSSL_add_all_algorithms();
            ssl_initialized = 1;
        }

        int port_val = (int)strada_to_int(port);
        char *cert_str = strada_to_str(cert_file);
        char *key_str = strada_to_str(key_file);

        SSLConnection *conn = malloc(sizeof(SSLConnection));
        if (conn) {
            memset(conn, 0, sizeof(SSLConnection));
            conn->is_server = 1;

            const SSL_METHOD *method = TLS_server_method();
            conn->ctx = SSL_CTX_new(method);
            if (!conn->ctx) {
                free(conn);
            } else if (SSL_CTX_use_certificate_file(conn->ctx, cert_str, SSL_FILETYPE_PEM) <= 0) {
                SSL_CTX_free(conn->ctx);
                free(conn);
            } else if (SSL_CTX_use_PrivateKey_file(conn->ctx, key_str, SSL_FILETYPE_PEM) <= 0) {
                SSL_CTX_free(conn->ctx);
                free(conn);
            } else if (!SSL_CTX_check_private_key(conn->ctx)) {
                SSL_CTX_free(conn->ctx);
                free(conn);
            } else {
                conn->socket_fd = socket(AF_INET, SOCK_STREAM, 0);
                if (conn->socket_fd < 0) {
                    SSL_CTX_free(conn->ctx);
                    free(conn);
                } else {
                    int opt = 1;
                    setsockopt(conn->socket_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

                    struct sockaddr_in addr;
                    memset(&addr, 0, sizeof(addr));
                    addr.sin_family = AF_INET;
                    addr.sin_addr.s_addr = INADDR_ANY;
                    addr.sin_port = htons(port_val);

                    if (bind(conn->socket_fd, (struct sockaddr*)&addr, sizeof(addr)) < 0) {
                        close(conn->socket_fd);
                        SSL_CTX_free(conn->ctx);
                        free(conn);
                    } else if (listen(conn->socket_fd, 10) < 0) {
                        close(conn->socket_fd);
                        SSL_CTX_free(conn->ctx);
                        free(conn);
                    } else {
                        strada_decref(result);
                        result = strada_new_int((int64_t)(intptr_t)conn);
                    }
                }
            }
        }
        free(cert_str);
        free(key_str);
    }
    return $result;
}

# Accept connection on SSL server
func accept(int $server) int {
    my int $result = 0;
    __C__ {
        SSLConnection *server_conn = (SSLConnection*)(intptr_t)strada_to_int(server);
        if (server_conn && server_conn->is_server) {
            struct sockaddr_in client_addr;
            socklen_t addr_len = sizeof(client_addr);
            int client_fd = accept(server_conn->socket_fd, (struct sockaddr*)&client_addr, &addr_len);
            if (client_fd >= 0) {
                SSLConnection *conn = malloc(sizeof(SSLConnection));
                if (!conn) {
                    close(client_fd);
                } else {
                    memset(conn, 0, sizeof(SSLConnection));
                    conn->socket_fd = client_fd;
                    conn->ctx = NULL; /* owned by server_conn */
                    conn->is_server = 0;
                    ssl_apply_sock_timeout(conn);
                    conn->ssl = SSL_new(server_conn->ctx);
                    if (!conn->ssl) {
                        close(client_fd);
                        free(conn);
                    } else {
                        SSL_set_fd(conn->ssl, client_fd);
                        if (SSL_accept(conn->ssl) <= 0) {
                            SSL_free(conn->ssl);
                            close(client_fd);
                            free(conn);
                        } else {
                            strada_decref(result);
                            result = strada_new_int((int64_t)(intptr_t)conn);
                        }
                    }
                }
            }
        }
    }
    return $result;
}

# Read data from SSL connection
func read(int $conn, int $max_len) str {
    my str $result = "";
    __C__ {
        SSLConnection *c = (SSLConnection*)(intptr_t)strada_to_int(conn);
        int max = (int)strada_to_int(max_len);
        if (c && c->ssl && max > 0) {
            char *buffer = malloc((size_t)max + 1);
            if (buffer) {
                int n = ssl_read_retry(c, buffer, max);
                if (n > 0) {
                    buffer[n] = '\0';
                    strada_decref(result);
                    result = strada_new_str_len(buffer, (size_t)n);
                }
                free(buffer);
            }
        }
    }
    return $result;
}

# Read a line from SSL connection
func readline(int $conn, int $max_len) str {
    my str $result = "";
    __C__ {
        SSLConnection *c = (SSLConnection*)(intptr_t)strada_to_int(conn);
        int max = (int)strada_to_int(max_len);
        if (c && c->ssl && max > 0) {
            char *buffer = malloc((size_t)max + 1);
            if (buffer) {
                int pos = 0;
                char ch;
                while (pos < max) {
                    int n = ssl_read_retry(c, &ch, 1);
                    if (n <= 0) break;
                    buffer[pos++] = ch;
                    if (ch == '\n') break;
                }
                buffer[pos] = '\0';
                strada_decref(result);
                result = strada_new_str_len(buffer, (size_t)pos);
                free(buffer);
            }
        }
    }
    return $result;
}

# Write string to SSL connection
func write(int $conn, str $data) int {
    my int $result = 0;
    __C__ {
        SSLConnection *c = (SSLConnection*)(intptr_t)strada_to_int(conn);
        if (!c || !c->ssl) {
            strada_decref(result);
            result = strada_new_int(-1);
        } else {
            size_t len = 0;
            char *owned = NULL;
            const char *data_str = ssl_extract_bytes(data, &len, &owned);
            int written = (len == 0) ? 0 : ssl_write_all_retry(c, data_str, len);
            free(owned);
            strada_decref(result);
            result = strada_new_int(written);
        }
    }
    return $result;
}

# Read binary data from SSL connection (handles NUL bytes)
# Use this for protocols like LDAP/BER that may contain NUL bytes
func read_binary(int $conn, int $max_len) str {
    my str $result = "";
    __C__ {
        SSLConnection *c = (SSLConnection*)(intptr_t)strada_to_int(conn);
        int max = (int)strada_to_int(max_len);
        if (c && c->ssl && max > 0) {
            char *buffer = malloc((size_t)max + 1);
            if (buffer) {
                int n = ssl_read_retry(c, buffer, max);
                if (n > 0) {
                    strada_decref(result);
                    result = strada_new_str_len(buffer, (size_t)n);
                }
                free(buffer);
            }
        }
    }
    return $result;
}

# Write binary data to SSL connection (handles NUL bytes)
# Use this for protocols like LDAP/BER that may contain NUL bytes
func write_binary(int $conn, str $data) int {
    my int $result = 0;
    __C__ {
        SSLConnection *c = (SSLConnection*)(intptr_t)strada_to_int(conn);
        if (!c || !c->ssl) {
            strada_decref(result);
            result = strada_new_int(-1);
        } else {
            size_t len = 0;
            char *owned = NULL;
            const char *data_str = ssl_extract_bytes(data, &len, &owned);
            int written = (len == 0) ? 0 : ssl_write_all_retry(c, data_str, len);
            free(owned);
            strada_decref(result);
            result = strada_new_int(written);
        }
    }
    return $result;
}

# Per-connection wait limit for blocking-style reads/writes on a non-blocking
# fd: milliseconds, 0 = don't wait, < 0 = wait indefinitely.
# Returns 1, or 0 for an invalid handle.
func set_timeout(int $conn, int $ms) int {
    my int $result = 0;
    __C__ {
        SSLConnection *c = (SSLConnection*)(intptr_t)strada_to_int(conn);
        if (c) {
            int64_t v = strada_to_int(ms);
            if (v > 2147483647LL) v = 2147483647LL;
            if (v < 0) v = -1;
            c->wait_ms = (int)v;
            c->wait_ms_set = 1;
            ssl_apply_sock_timeout(c);
            strada_decref(result);
            result = strada_new_int(1);
        }
    }
    return $result;
}

# Process-wide default wait limit (initially 5000 ms) for connections that
# have not called set_timeout. Returns the previous default.
func set_default_timeout(int $ms) int {
    my int $result = 0;
    __C__ {
        int64_t v = strada_to_int(ms);
        if (v > 2147483647LL) v = 2147483647LL;
        if (v < 0) v = -1;
        strada_decref(result);
        result = strada_new_int(ssl_default_wait_ms);
        ssl_default_wait_ms = (int)v;
    }
    return $result;
}

# Close SSL connection
func close(int $conn) void {
    __C__ {
        SSLConnection *c = (SSLConnection*)(intptr_t)strada_to_int(conn);
        if (c) {
            if (c->ssl) {
                SSL_shutdown(c->ssl);
                SSL_free(c->ssl);
            }
            if (c->socket_fd >= 0 && !c->borrowed_fd) {
                close(c->socket_fd);
            }
            /* Free the ctx whenever this connection owns one. (Client
             * connections own theirs too — the old is_server-only check
             * leaked an SSL_CTX per ssl::connect/attach_fd.) Connections
             * from attach_server_fd share the server handle's ctx and
             * carry ctx == NULL. */
            if (c->ctx) {
                SSL_CTX_free(c->ctx);
            }
            free(c);
        }
    }
}

# Get last SSL error message
func error() str {
    my str $result = "";
    __C__ {
        unsigned long err = ERR_get_error();
        strada_decref(result);
        if (err == 0) {
            result = strada_new_str("No error");
        } else {
            ERR_error_string_n(err, ssl_errbuf, sizeof(ssl_errbuf));
            result = strada_new_str(ssl_errbuf);
        }
    }
    return $result;
}

# Get peer certificate subject
func peer_cert(int $conn) str {
    my str $result = "";
    __C__ {
        static char cert_buf[1024];
        SSLConnection *c = (SSLConnection*)(intptr_t)strada_to_int(conn);
        if (c && c->ssl) {
            X509 *cert = SSL_get_peer_certificate(c->ssl);
            strada_decref(result);
            if (!cert) {
                result = strada_new_str("No certificate");
            } else {
                char *subject = X509_NAME_oneline(X509_get_subject_name(cert), cert_buf, sizeof(cert_buf));
                X509_free(cert);
                result = strada_new_str(subject ? subject : "Unknown");
            }
        }
    }
    return $result;
}

# Get SSL/TLS version
func get_version(int $conn) str {
    my str $result = "";
    __C__ {
        SSLConnection *c = (SSLConnection*)(intptr_t)strada_to_int(conn);
        strada_decref(result);
        if (!c || !c->ssl) {
            result = strada_new_str("Not connected");
        } else {
            result = strada_new_str(SSL_get_version(c->ssl));
        }
    }
    return $result;
}

# Get cipher in use
func cipher(int $conn) str {
    my str $result = "";
    __C__ {
        SSLConnection *c = (SSLConnection*)(intptr_t)strada_to_int(conn);
        strada_decref(result);
        if (!c || !c->ssl) {
            result = strada_new_str("Not connected");
        } else {
            result = strada_new_str(SSL_get_cipher(c->ssl));
        }
    }
    return $result;
}

# Get socket file descriptor
func fd(int $conn) int {
    my int $result = 0;
    __C__ {
        SSLConnection *c = (SSLConnection*)(intptr_t)strada_to_int(conn);
        strada_decref(result);
        if (!c) {
            result = strada_new_int(-1);
        } else {
            result = strada_new_int(c->socket_fd);
        }
    }
    return $result;
}

# Verify server certificate
func verify(int $conn) int {
    my int $result = 0;
    __C__ {
        SSLConnection *c = (SSLConnection*)(intptr_t)strada_to_int(conn);
        strada_decref(result);
        if (!c || !c->ssl) {
            result = strada_new_int(-1);
        } else {
            long r = SSL_get_verify_result(c->ssl);
            result = strada_new_int((r == X509_V_OK) ? 0 : (int)r);
        }
    }
    return $result;
}

# Convenience: HTTP GET over SSL
func http_get(str $host, int $port, str $path) str {
    if (index($host, "\r") >= 0 || index($host, "\n") >= 0 ||
        index($path, "\r") >= 0 || index($path, "\n") >= 0) {
        return "";
    }
    my int $conn = ssl::connect($host, $port);
    if ($conn == 0) {
        return "";
    }

    my str $request = "GET " . $path . " HTTP/1.1\r\n";
    $request = $request . "Host: " . $host . "\r\n";
    $request = $request . "Connection: close\r\n";
    $request = $request . "\r\n";

    ssl::write($conn, $request);

    my str $response = "";
    my str $chunk = ssl::read($conn, 4096);
    while (core::byte_length($chunk) > 0) {
        $response = $response . $chunk;
        $chunk = ssl::read($conn, 4096);
    }

    ssl::close($conn);
    return $response;
}

# ============================================================
# Non-blocking primitives (Async::TaskSSL support).
# A handshake/read/write that cannot progress reports WHICH readiness
# it needs (ssl::want: 1 = read, 2 = write) so an event loop can park
# the task on the right mask. All handles are the same SSLConnection
# int-pointers as the blocking API.
# ============================================================

# Wrap an already-connected TCP fd in a CLIENT session (no handshake yet).
# Sets the fd non-blocking. Returns conn handle or 0.
#
# When $verify is true a non-empty $host is REQUIRED: SSL_VERIFY_PEER only
# validates the certificate CHAIN, while SSL_set1_host is what binds the
# expected hostname (checked against the cert's SAN/CN). Enabling verification
# without a host would accept any CA-valid certificate for ANY hostname — i.e.
# trivial MITM — so this case is refused (returns 0) rather than silently
# giving name-blind verification. Use $verify = 0 to deliberately skip checks.
func attach_fd(int $fd, int $verify, str $host) int {
    init();
    my int $result = 0;
    __C__ {
        int raw_fd = (int)strada_to_int(fd);
        int do_verify = (int)strada_to_int(verify);
        SSL_CTX *ctx = SSL_CTX_new(TLS_client_method());
        if (ctx) {
            if (do_verify) {
                SSL_CTX_set_verify(ctx, SSL_VERIFY_PEER, NULL);
                SSL_CTX_set_default_verify_paths(ctx);
            }
            SSL *ssl = SSL_new(ctx);
            if (ssl) {
                char *hname = strada_to_str(host);
                if (ssl_has_crlf(hname) || (do_verify && (!hname || !hname[0]))) {
                    /* Reject CRLF in host/SNI, or verification requested without
                     * hostname to bind. */
                    free(hname);
                    SSL_free(ssl);
                    SSL_CTX_free(ctx);
                    /* result stays 0 */
                } else {
                    if (hname && hname[0]) {
                        SSL_set_tlsext_host_name(ssl, hname);
                        SSL_set1_host(ssl, hname);
                    }
                    free(hname);
                    SSL_set_fd(ssl, raw_fd);
                    SSL_set_connect_state(ssl);
                    int fl = fcntl(raw_fd, F_GETFL, 0);
                    fcntl(raw_fd, F_SETFL, fl | O_NONBLOCK);
                    SSLConnection *c = calloc(1, sizeof(SSLConnection));
                    c->socket_fd = raw_fd;
                    c->ssl = ssl;
                    c->ctx = ctx;
                    c->is_server = 0;
                    c->borrowed_fd = 1;   /* owned by the Strada socket SV */
                    strada_decref(result);
                    result = strada_new_int((int64_t)(intptr_t)c);
                }
            } else {
                SSL_CTX_free(ctx);
            }
        }
    }
    return $result;
}

# Wrap an accepted TCP fd in a SERVER session using a listening server
# handle's certificate context. Returns conn handle or 0.
func attach_server_fd(int $server, int $fd) int {
    my int $result = 0;
    __C__ {
        SSLConnection *srv = (SSLConnection*)(intptr_t)strada_to_int(server);
        int raw_fd = (int)strada_to_int(fd);
        if (srv && srv->ctx) {
            SSL *ssl = SSL_new(srv->ctx);
            if (ssl) {
                SSL_set_fd(ssl, raw_fd);
                SSL_set_accept_state(ssl);
                int fl = fcntl(raw_fd, F_GETFL, 0);
                fcntl(raw_fd, F_SETFL, fl | O_NONBLOCK);
                SSLConnection *c = calloc(1, sizeof(SSLConnection));
                c->socket_fd = raw_fd;
                c->ssl = ssl;
                c->ctx = NULL;   /* owned by the server handle */
                c->is_server = 1;
                strada_decref(result);
                result = strada_new_int((int64_t)(intptr_t)c);
            }
        }
    }
    return $result;
}

# Drive the handshake one step: 0 = done, 1 = want-read, 2 = want-write,
# -1 = failed.
func handshake_step(int $conn) int {
    my int $result = 0 - 1;
    __C__ {
        SSLConnection *c = (SSLConnection*)(intptr_t)strada_to_int(conn);
        if (c && c->ssl) {
            int r = SSL_do_handshake(c->ssl);
            int code = -1;
            if (r == 1) {
                code = 0;
            } else {
                int err = SSL_get_error(c->ssl, r);
                if (err == SSL_ERROR_WANT_READ) code = 1;
                else if (err == SSL_ERROR_WANT_WRITE) code = 2;
            }
            c->last_want = code > 0 ? code : 0;
            strada_decref(result);
            result = strada_new_int(code);
        }
    }
    return $result;
}

# Which readiness unblocked-IO last asked for: 1 = read, 2 = write.
func want(int $conn) int {
    my int $result = 1;
    __C__ {
        SSLConnection *c = (SSLConnection*)(intptr_t)strada_to_int(conn);
        if (c && c->last_want == 2) {
            strada_decref(result);
            result = strada_new_int(2);
        }
    }
    return $result;
}

# Non-blocking read: data; "" = closed/EOF; undef = would-block (consult
# ssl::want for the direction — renegotiation can want WRITE).
func try_read(int $conn, int $max_len) str {
    my scalar $result = undef;
    __C__ {
        SSLConnection *c = (SSLConnection*)(intptr_t)strada_to_int(conn);
        int max = (int)strada_to_int(max_len);
        if (!c || !c->ssl || max <= 0) {
            strada_decref(result);
            result = strada_new_str("");
        } else {
            char *buffer = malloc((size_t)max);
            if (!buffer) {
                strada_decref(result);
                result = strada_new_str("");
            } else {
                int n = SSL_read(c->ssl, buffer, max);
                if (n > 0) {
                    strada_decref(result);
                    result = strada_new_str_len(buffer, (size_t)n);
                } else {
                    int err = SSL_get_error(c->ssl, n);
                    if (err == SSL_ERROR_WANT_READ) {
                        c->last_want = 1;          /* stays undef */
                    } else if (err == SSL_ERROR_WANT_WRITE) {
                        c->last_want = 2;          /* stays undef */
                    } else {
                        strada_decref(result);
                        result = strada_new_str("");   /* closed/error */
                    }
                }
                free(buffer);
            }
        }
    }
    return $result;
}

# Non-blocking write: bytes written; 0 = would-block (ssl::want says
# which direction); -1 = error.
func try_write(int $conn, str $data) int {
    my int $result = 0 - 1;
    __C__ {
        SSLConnection *c = (SSLConnection*)(intptr_t)strada_to_int(conn);
        if (c && c->ssl) {
            size_t len = 0;
            char *owned = NULL;
            const char *bytes = ssl_extract_bytes(data, &len, &owned);
            if (len == 0) {
                free(owned);
                strada_decref(result);
                result = strada_new_int(0);
            } else {
                int n = SSL_write(c->ssl, bytes, (int)len);
                free(owned);
                if (n > 0) {
                    strada_decref(result);
                    result = strada_new_int(n);
                } else {
                    int err = SSL_get_error(c->ssl, n);
                    if (err == SSL_ERROR_WANT_READ) {
                        c->last_want = 1;
                        strada_decref(result);
                        result = strada_new_int(0);
                    } else if (err == SSL_ERROR_WANT_WRITE) {
                        c->last_want = 2;
                        strada_decref(result);
                        result = strada_new_int(0);
                    }
                }
            }
        }
    }
    return $result;
}

# Accept a pending TCP connection on a listening server handle without
# blocking. Returns the raw client fd, or -1 when none is pending.
func try_accept_fd(int $server) int {
    my int $result = 0 - 1;
    __C__ {
        SSLConnection *srv = (SSLConnection*)(intptr_t)strada_to_int(server);
        if (srv) {
            int fl = fcntl(srv->socket_fd, F_GETFL, 0);
            if (!(fl & O_NONBLOCK)) fcntl(srv->socket_fd, F_SETFL, fl | O_NONBLOCK);
            int cfd = accept(srv->socket_fd, NULL, NULL);
            if (cfd >= 0) {
                strada_decref(result);
                result = strada_new_int(cfd);
            }
        }
    }
    return $result;
}
