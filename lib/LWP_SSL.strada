=head1 NAME

LWP_SSL - HTTP/HTTPS client library with SSL support for Strada

=head1 SYNOPSIS

    use lib "lib";
    use ssl;       # Required for HTTPS
    use LWP_SSL;

    # Simple GET request
    my hash %response = LWP_SSL::get("https://example.com");
    if ($response{"success"}) {
        say($response{"content"});
    }

    # POST with form data
    my hash %form = ();
    $form{"username"} = "john";
    $form{"password"} = "secret";
    my hash %resp = LWP_SSL::post_form("https://api.example.com/login", %form);

=head1 DESCRIPTION

LWP_SSL is a standalone HTTP client that supports both HTTP and HTTPS.
It provides a simple interface for making web requests. SSL/TLS support
is provided via the ssl module using extern "C".

B<Compile with:>

    ./strada myapp.strada -l ssl -l crypto

=head1 FUNCTIONS

=head2 get($url)

Perform an HTTP/HTTPS GET request. Returns a response hash.

    my hash %resp = LWP_SSL::get("https://example.com/api/data");

=head2 get_with_options($url, %options)

GET request with custom options (headers, user agent).

    my hash %opts = ();
    $opts{"user_agent"} = "MyApp/1.0";
    $opts{"headers"} = { "Authorization" => "Bearer token123" };
    my hash %resp = LWP_SSL::get_with_options($url, %opts);

=head2 post($url, $data)

Perform a POST request with raw body data.

    my hash %resp = LWP_SSL::post("https://api.example.com", $json_data);

=head2 post_with_options($url, $data, %options)

POST with custom options.

=head2 post_form($url, %form_data)

Perform a POST request with form-encoded data.

    my hash %form = ();
    $form{"key"} = "value";
    my hash %resp = LWP_SSL::post_form("https://api.example.com", %form);

=head2 put($url, $data)

Make a PUT request.

=head2 put_with_options($url, $data, %options)

PUT with custom options.

=head2 patch($url, $data)

Make a PATCH request (partial update).

=head2 patch_with_options($url, $data, %options)

PATCH with custom options.

=head2 delete_req($url)

Make a DELETE request.

=head2 delete_with_options($url, %options)

DELETE with custom options.

=head2 head($url)

Make a HEAD request (get headers only).

=head2 head_with_options($url, %options)

HEAD with custom options.

=head2 options($url)

Make an OPTIONS request (get supported methods).

=head2 options_with_options($url, %options)

OPTIONS with custom options.

=head2 get_content($url)

Simple content fetch - returns just the body or empty string on error.

    my str $html = LWP_SSL::get_content("https://example.com");

=head2 is_reachable($url)

Check if a URL is reachable (HEAD request).

=head2 get_header(%response, $name)

Get a response header value (case-insensitive).

    my str $type = LWP_SSL::get_header(%resp, "Content-Type");

=head1 LOW-LEVEL REQUEST

=head2 do_request($method, $url, $body, %options)

Make an HTTP/HTTPS request with full control over method, body, and options.
All other request functions are wrappers around this. Automatically selects
HTTP or HTTPS based on the URL scheme.

B<Parameters:>

=over 4

=item B<$method> - HTTP method string ("GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS", or any custom method)

=item B<$url> - Full URL including scheme, host, port, path, and query

=item B<$body> - Request body (empty string for no body)

=item B<%options> - Hash with optional keys:

=over 4

=item B<user_agent> - Custom User-Agent string (default: "Strada-LWP/1.0")

=item B<headers> - Hash reference of custom headers

=item B<max_header_bytes> - Largest response header section accepted
(default 65536). A server whose status line and headers exceed this gets the
error C<"HTTP response headers exceed N bytes"> instead of being buffered
without limit; 0 disables the check.

=item B<max_response_bytes> - Largest whole response (headers and body)
accepted (default 67108864, i.e. 64 MiB). A bigger response stops being read
and the request fails with C<"HTTP response exceeds N bytes"> rather than
being silently truncated; 0 disables the check.

=back

=back

Returns a response hash (see RESPONSE HASH below).

    my hash %opts = ();
    $opts{"headers"} = { "Content-Type" => "application/json" };
    my hash %resp = LWP_SSL::do_request("PATCH", "https://api.example.com/item/1",
        JSON::encode({ "status" => "active" }), %opts);

=head2 parse_url($url)

Parse a URL into components. Returns hash with: scheme, host, port, path, query.

    my hash %parts = LWP_SSL::parse_url("https://example.com:8080/path?q=1");
    # $parts{"scheme"} = "https"
    # $parts{"host"} = "example.com"
    # $parts{"port"} = 8080
    # $parts{"path"} = "/path"
    # $parts{"query"} = "q=1"

=head2 url_encode($string)

URL-encode a string.

    my str $encoded = LWP_SSL::url_encode("hello world");
    # "hello%20world"

=head2 build_query(%params)

Build a query string from a hash.

    my hash %p = ();
    $p{"a"} = "1";
    $p{"b"} = "2";
    my str $qs = LWP_SSL::build_query(%p);
    # "a=1&b=2"

=head2 ssl_available()

Check if SSL is available (always returns 1 when linked properly).

=head1 RESPONSE HASH

All request functions return a response hash with:

=over 4

=item B<success> - 1 if status is 2xx, 0 otherwise

=item B<status> - HTTP status code (200, 404, etc.)

=item B<reason> - HTTP reason phrase ("OK", "Not Found", etc.)

=item B<content> - Response body

=item B<error> - Error message if connection failed

=back

=head1 EXAMPLE

    use lib "lib";
    use ssl;
    use LWP_SSL;

    # Fetch JSON API
    my hash %resp = LWP_SSL::get("https://api.example.com/users/1");

    if ($resp{"success"}) {
        say("Status: " . $resp{"status"});
        say("Body: " . $resp{"content"});
    } else {
        say("Error: " . $resp{"error"});
    }

    # Post form data
    my hash %login = ();
    $login{"user"} = "admin";
    $login{"pass"} = "secret";
    my hash %result = LWP_SSL::post_form("https://example.com/login", %login);

=head1 SEE ALSO

L<LWP>, L<ssl>

=cut

use ssl;

package LWP_SSL;

func _has_crlf(str $s) int {
    return (index($s, "\r") >= 0 || index($s, "\n") >= 0) ? 1 : 0;
}

func _strip_crlf(str $s) str {
    my str $out = replace_all($s, "\r", "");
    return replace_all($out, "\n", "");
}

# Parse a URL into components
func parse_url(str $url) hash {
    my hash %result = ();
    $result{"scheme"} = "http";
    $result{"host"} = "";
    $result{"port"} = 80;
    $result{"path"} = "/";
    $result{"query"} = "";

    my str $remaining = $url;

    my int $scheme_end = index($remaining, "://");
    if ($scheme_end > 0) {
        $result{"scheme"} = substr($remaining, 0, $scheme_end);
        $remaining = substr($remaining, $scheme_end + 3, length($remaining) - $scheme_end - 3);
        if ($result{"scheme"} eq "https") {
            $result{"port"} = 443;
        }
    }

    my int $path_start = index($remaining, "/");
    my int $q_start_raw = index($remaining, "?");
    my str $host_part = "";
    if ($q_start_raw >= 0 && ($path_start < 0 || $q_start_raw < $path_start)) {
        $host_part = substr($remaining, 0, $q_start_raw);
        $remaining = "/" . substr($remaining, $q_start_raw, length($remaining) - $q_start_raw);
    } elsif ($path_start < 0) {
        $host_part = $remaining;
        $remaining = "/";
    } else {
        $host_part = substr($remaining, 0, $path_start);
        $remaining = substr($remaining, $path_start, length($remaining) - $path_start);
    }

    if (length($host_part) >= 2 && substr($host_part, 0, 1) eq "[") {
        my int $close_br = index($host_part, "]");
        if ($close_br > 1) {
            $result{"host"} = substr($host_part, 1, $close_br - 1);
            if ($close_br + 1 < length($host_part) && substr($host_part, $close_br + 1, 1) eq ":") {
                my str $port_str = substr($host_part, $close_br + 2, length($host_part) - $close_br - 2);
                if (length($port_str) > 0) {
                    $result{"port"} = cast_int($port_str);
                }
            }
        } else {
            $result{"host"} = $host_part;
        }
    } else {
        my int $port_sep = index($host_part, ":");
        if ($port_sep > 0) {
            $result{"host"} = substr($host_part, 0, $port_sep);
            my str $port_str = substr($host_part, $port_sep + 1, length($host_part) - $port_sep - 1);
            $result{"port"} = cast_int($port_str);
        } else {
            $result{"host"} = $host_part;
        }
    }

    my int $query_start = index($remaining, "?");
    if ($query_start >= 0) {
        $result{"path"} = substr($remaining, 0, $query_start);
        $result{"query"} = substr($remaining, $query_start + 1, length($remaining) - $query_start - 1);
    } else {
        $result{"path"} = $remaining;
    }

    if (length($result{"path"}) == 0) {
        $result{"path"} = "/";
    }

    return %result;
}

# URL encode (percent-encodes raw UTF-8 bytes per RFC 3986)
func url_encode(str $s) str {
    my str $result = "";
    my int $blen = core::byte_length($s);
    my int $i = 0;
    while ($i < $blen) {
        my int $code = core::get_byte($s, $i);
        if (($code >= 65 && $code <= 90) || ($code >= 97 && $code <= 122) ||
            ($code >= 48 && $code <= 57) ||
            $code == 45 || $code == 46 || $code == 95 || $code == 126) {
            $result = $result . chr($code);
        } else {
            my int $hi = ($code / 16) % 16;
            my int $lo = $code % 16;
            my str $hex = "%";
            if ($hi < 10) { $hex = $hex . chr(48 + $hi); } else { $hex = $hex . chr(55 + $hi); }
            if ($lo < 10) { $hex = $hex . chr(48 + $lo); } else { $hex = $hex . chr(55 + $lo); }
            $result = $result . $hex;
        }
        $i = $i + 1;
    }
    return $result;
}

# Build query string from hash
func build_query(hash %params) str {
    my str $result = "";
    my array @keys = keys(%params);
    my int $i = 0;
    while ($i < scalar(@keys)) {
        my str $key = $keys[$i];
        if ($i > 0) { $result = $result . "&"; }
        $result = $result . LWP_SSL::url_encode($key) . "=" . LWP_SSL::url_encode($params{$key});
        $i = $i + 1;
    }
    return $result;
}

# Parse response headers
func parse_headers(str $header_block) hash {
    my hash %headers = ();
    my array @lines = split("\r\n", $header_block);

    my int $i = 0;
    while ($i < scalar(@lines)) {
        my str $line = $lines[$i];
        my int $colon = index($line, ":");
        if ($colon > 0) {
            my str $name = substr($line, 0, $colon);
            my str $value = substr($line, $colon + 1, length($line) - $colon - 1);
            while (length($value) > 0 && substr($value, 0, 1) eq " ") {
                $value = substr($value, 1, length($value) - 1);
            }
            $headers{lc($name)} = $value;
        }
        $i = $i + 1;
    }

    return %headers;
}

# Internal: parse hex chunk size (stops at ';' chunk extension)
func _parse_hex_len(str $line) int {
    my int $semi = index($line, ";");
    if ($semi >= 0) {
        $line = substr($line, 0, $semi);
    }
    my int $i = 0;
    my int $n = 0;
    my int $digits = 0;
    my int $len = length($line);
    while ($i < $len) {
        my str $ch = substr($line, $i, 1);
        if ($ch eq " " || $ch eq "\t") {
            if ($digits > 0) { last; }
            $i = $i + 1;
            next;
        }
        my int $o = ord($ch);
        my int $d = -1;
        if ($o >= 48 && $o <= 57) { $d = $o - 48; }
        elsif ($o >= 97 && $o <= 102) { $d = $o - 97 + 10; }
        elsif ($o >= 65 && $o <= 70) { $d = $o - 65 + 10; }
        else { last; }
        if ($n > 576460752303423487) { return -1; }
        $n = ($n * 16) + $d;
        $digits = $digits + 1;
        $i = $i + 1;
    }
    return ($digits > 0) ? $n : -1;
}

# Internal: decode HTTP Transfer-Encoding: chunked body using raw byte offsets
func _decode_chunked(str $raw_body) str {
    my str $out = "";
    my int $pos = 0;
    my int $total = core::byte_length($raw_body);
    while ($pos < $total) {
        my int $nl = core::byte_index($raw_body, "\r\n", $pos);
        if ($nl < 0) {
            return $out;
        }
        my str $size_line = core::byte_substr($raw_body, $pos, $nl - $pos);
        my int $chunk_len = LWP_SSL::_parse_hex_len($size_line);
        if ($chunk_len < 0) {
            return $out;
        }
        $pos = $nl + 2;
        if ($chunk_len == 0) {
            last;
        }
        if ($pos + $chunk_len > $total) {
            $out = $out . core::byte_substr($raw_body, $pos, $total - $pos);
            last;
        }
        $out = $out . core::byte_substr($raw_body, $pos, $chunk_len);
        $pos = $pos + $chunk_len;
        if ($pos + 2 <= $total && core::byte_substr($raw_body, $pos, 2) eq "\r\n") {
            $pos = $pos + 2;
        }
    }
    return $out;
}

# Internal: return 1 when chunked response body has received its 0-length terminator
func _chunked_complete(str $raw, int $pos) int {
    my int $total = core::byte_length($raw);
    while ($pos < $total) {
        my int $nl = core::byte_index($raw, "\r\n", $pos);
        if ($nl < 0) { return 0; }
        my str $size_line = core::byte_substr($raw, $pos, $nl - $pos);
        my int $chunk_len = LWP_SSL::_parse_hex_len($size_line);
        if ($chunk_len < 0) { return 1; }
        $pos = $nl + 2;
        if ($chunk_len == 0) {
            return (core::byte_index($raw, "\r\n", $pos) >= 0) ? 1 : 0;
        }
        if ($pos + $chunk_len + 2 > $total) { return 0; }
        $pos = $pos + $chunk_len + 2;
    }
    return 0;
}

# Internal: return 1 for interim 1xx status codes preceding a final response (100, 102..199; not 101)
func _is_interim_status(int $status) int {
    if ($status == 100 || ($status >= 102 && $status < 200)) {
        return 1;
    }
    return 0;
}

# Internal: find trimmed lowercase value of a header at start of a header line, or undef if absent
func _find_header_value(str $headers_part, str $hdr_lower_colon) scalar {
    my int $first_eol = core::byte_index($headers_part, "\r\n");
    if ($first_eol < 0) {
        $first_eol = core::byte_index($headers_part, "\n");
    }
    if ($first_eol < 0) {
        return undef;
    }
    my int $hlen = core::byte_length($headers_part);
    my str $tail_lc = lc(core::byte_substr($headers_part, $first_eol, $hlen - $first_eol));
    my str $needle = "\n" . $hdr_lower_colon;
    my int $found = core::byte_index($tail_lc, $needle);
    if ($found < 0) {
        return undef;
    }
    my int $val_start = $found + core::byte_length($needle);
    my int $val_end = core::byte_index($tail_lc, "\n", $val_start);
    if ($val_end < 0) {
        $val_end = core::byte_length($tail_lc);
    }
    my str $val = core::byte_substr($tail_lc, $val_start, $val_end - $val_start);
    my int $vlen = core::byte_length($val);
    if ($vlen > 0 && core::byte_substr($val, $vlen - 1, 1) eq "\r") {
        $val = core::byte_substr($val, 0, $vlen - 1);
    }
    while (length($val) > 0 && (substr($val, 0, 1) eq " " || substr($val, 0, 1) eq "\t")) {
        $val = substr($val, 1, length($val) - 1);
    }
    return $val;
}

# Internal: check case-insensitively whether a header exists in custom headers hash ref
func _has_header_ci(scalar $headers, str $target_lower) int {
    if (!defined($headers)) { return 0; }
    foreach my str $hk (keys($headers)) {
        if (lc($hk) eq $target_lower) {
            return 1;
        }
    }
    return 0;
}

# Internal: compare scheme, host, and port of two URLs
func _same_origin(str $u1, str $u2) int {
    my hash %p1 = LWP_SSL::parse_url($u1);
    my hash %p2 = LWP_SSL::parse_url($u2);
    if (lc($p1{"scheme"}) ne lc($p2{"scheme"})) { return 0; }
    if (lc($p1{"host"}) ne lc($p2{"host"})) { return 0; }
    if (($p1{"port"} + 0) != ($p2{"port"} + 0)) { return 0; }
    return 1;
}

# Internal: strip Authorization/Cookie/Proxy-Authorization when redirecting cross-origin
func _redirect_options(hash %orig, str $prev_url, str $next_url) hash {
    my int $same = LWP_SSL::_same_origin($prev_url, $next_url);
    if ($same) {
        return %orig;
    }
    my hash %copy = ();
    foreach my str $k (keys(%orig)) {
        if ($k eq "headers") { next; }
        $copy{$k} = $orig{$k};
    }
    if (defined($orig{"headers"})) {
        my scalar $oh = $orig{"headers"};
        my hash %nh = ();
        foreach my str $hk (keys($oh)) {
            my str $lhk = lc($hk);
            if ($lhk eq "authorization" || $lhk eq "cookie" || $lhk eq "proxy-authorization") {
                next;
            }
            $nh{$hk} = $oh->{$hk};
        }
        $copy{"headers"} = \%nh;
    }
    return %copy;
}

# Internal: send all bytes of $data on socket, looping on partial writes
func _send_all(scalar $sock, str $data) int {
    my int $total = core::byte_length($data);
    my int $sent = 0;
    while ($sent < $total) {
        my str $slice = ($sent == 0) ? $data : core::byte_substr($data, $sent, $total - $sent);
        my int $n = core::socket_send($sock, $slice);
        if ($n <= 0) {
            return -1;
        }
        $sent = $sent + $n;
    }
    return $sent;
}

# Internal: return 1 if buffered HTTP response contains the complete message
func _response_complete(str $response, str $method) int {
    my int $hdr_start = 0;
    my int $header_end = -1;
    my str $headers_part = "";
    my int $status = 0;
    while (1) {
        $header_end = core::byte_index($response, "\r\n\r\n", $hdr_start);
        if ($header_end < 0) { return 0; }
        $headers_part = core::byte_substr($response, $hdr_start, $header_end - $hdr_start);
        my int $first_eol = core::byte_index($headers_part, "\r\n");
        my str $status_line = ($first_eol > 0) ? core::byte_substr($headers_part, 0, $first_eol) : $headers_part;
        my array @sp = split(" ", $status_line);
        $status = (scalar(@sp) >= 2) ? cast_int($sp[1]) : 0;
        if (LWP_SSL::_is_interim_status($status)) {
            $hdr_start = $header_end + 4;
            next;
        }
        last;
    }
    if (uc($method) eq "HEAD" || $status == 204 || $status == 304 || ($status >= 100 && $status < 200)) {
        return 1;
    }

    my scalar $te_val = LWP_SSL::_find_header_value($headers_part, "transfer-encoding:");
    if (defined($te_val)) {
        if (index($te_val, "chunked") >= 0) {
            return LWP_SSL::_chunked_complete($response, $header_end + 4);
        }
    }

    my scalar $cl_val = LWP_SSL::_find_header_value($headers_part, "content-length:");
    if (defined($cl_val)) {
        my int $content_length = cast_int($cl_val);
        my int $body_bytes = core::byte_length($response) - ($header_end + 4);
        if ($body_bytes >= $content_length) {
            return 1;
        }
    }
    return 0;
}

# Internal: format Host header value (bracketing IPv6 and appending non-default port)
func _format_host_header(str $scheme, str $host, int $port) str {
    my str $h = (index($host, ":") >= 0 && substr($host, 0, 1) ne "[") ? ("[" . $host . "]") : $host;
    my int $def_port = ($scheme eq "https") ? 443 : 80;
    if ($port != $def_port && $port > 0) {
        return $h . ":" . $port;
    }
    return $h;
}

# Internal: resolve relative or absolute redirect Location against base URL
func _resolve_url(str $base_url, str $location) str {
    if (index($location, "://") > 0) {
        return $location;
    }
    my hash %bu = LWP_SSL::parse_url($base_url);
    my str $authority = LWP_SSL::_format_host_header($bu{"scheme"}, $bu{"host"}, $bu{"port"});
    if (length($location) >= 2 && substr($location, 0, 2) eq "//") {
        return $bu{"scheme"} . ":" . $location;
    }
    if (length($location) > 0 && substr($location, 0, 1) eq "/") {
        return $bu{"scheme"} . "://" . $authority . $location;
    }
    my str $dir = $bu{"path"};
    my int $slash = rindex($dir, "/");
    if ($slash >= 0) {
        $dir = substr($dir, 0, $slash + 1);
    } else {
        $dir = "/";
    }
    return $bu{"scheme"} . "://" . $authority . $dir . $location;
}

# Parse HTTP response
func parse_response(str $raw) hash {
    my hash %response = ();
    $response{"success"} = 0;
    $response{"status"} = 0;
    $response{"reason"} = "";
    $response{"content"} = "";

    my int $raw_bytes = core::byte_length($raw);
    my int $hdr_start = 0;
    my int $sep = -1;
    my str $header_section = "";
    my str $status_line = "";
    my str $headers_text = "";
    while (1) {
        $sep = core::byte_index($raw, "\r\n\r\n", $hdr_start);
        if ($sep < 0) {
            $response{"error"} = "Invalid HTTP response";
            return %response;
        }
        $header_section = core::byte_substr($raw, $hdr_start, $sep - $hdr_start);
        my int $first_line_end = core::byte_index($header_section, "\r\n");
        if ($first_line_end > 0) {
            $status_line = core::byte_substr($header_section, 0, $first_line_end);
            $headers_text = core::byte_substr($header_section, $first_line_end + 2, core::byte_length($header_section) - $first_line_end - 2);
        } else {
            $status_line = $header_section;
            $headers_text = "";
        }
        my array @sp_chk = split(" ", $status_line);
        my int $st_chk = (scalar(@sp_chk) >= 2) ? cast_int($sp_chk[1]) : 0;
        if (LWP_SSL::_is_interim_status($st_chk)) {
            $hdr_start = $sep + 4;
            next;
        }
        last;
    }

    my str $body = core::byte_substr($raw, $sep + 4, $raw_bytes - $sep - 4);

    my array @status_parts = split(" ", $status_line);
    if (scalar(@status_parts) >= 2) {
        $response{"protocol"} = $status_parts[0];
        $response{"status"} = cast_int($status_parts[1]);
        if (scalar(@status_parts) >= 3) {
            my str $reason = "";
            my int $i = 2;
            while ($i < scalar(@status_parts)) {
                if ($i > 2) { $reason = $reason . " "; }
                $reason = $reason . $status_parts[$i];
                $i = $i + 1;
            }
            $response{"reason"} = $reason;
        }
    }

    my hash %hdrs = LWP_SSL::parse_headers($headers_text);
    $response{"headers"} = \%hdrs;
    if (defined($hdrs{"transfer-encoding"}) && index(lc($hdrs{"transfer-encoding"}), "chunked") >= 0) {
        $body = LWP_SSL::_decode_chunked($body);
    }
    $response{"content"} = $body;

    my int $status = $response{"status"};
    if ($status >= 200 && $status < 300) {
        $response{"success"} = 1;
    }

    return %response;
}

# SSL is now linked via extern "C" - no dynamic loading needed

# Build HTTP request
func build_request(str $method, str $host, str $path, str $body, hash %options) str {
    $method = LWP_SSL::_strip_crlf($method);
    $host = LWP_SSL::_strip_crlf($host);
    $path = LWP_SSL::_strip_crlf($path);
    my str $request = $method . " " . $path . " HTTP/1.1\r\n";
    $request = $request . "Host: " . $host . "\r\n";

    # User-Agent
    my str $ua = "Strada-LWP/1.0";
    if (defined($options{"user_agent"})) {
        $ua = LWP_SSL::_strip_crlf("" . $options{"user_agent"});
    }
    $request = $request . "User-Agent: " . $ua . "\r\n";
    $request = $request . "Connection: close\r\n";

    # Custom headers
    if (defined($options{"headers"})) {
        my scalar $custom_headers = $options{"headers"};
        my array @hkeys = keys($custom_headers);
        my int $i = 0;
        while ($i < scalar(@hkeys)) {
            my str $hname = replace(LWP_SSL::_strip_crlf($hkeys[$i]), ":", "");
            my str $hval = LWP_SSL::_strip_crlf("" . $custom_headers->{$hkeys[$i]});
            $request = $request . $hname . ": " . $hval . "\r\n";
            $i++;
        }
    }

    my int $body_len = core::byte_length($body);
    if ($body_len > 0) {
        if (!defined($options{"headers"}) || !LWP_SSL::_has_header_ci($options{"headers"}, "content-type")) {
            $request = $request . "Content-Type: application/x-www-form-urlencoded\r\n";
        }
        $request = $request . "Content-Length: " . $body_len . "\r\n";
    }

    $request = $request . "\r\n";
    if ($body_len > 0) {
        $request = $request . $body;
    }
    return $request;
}

# Internal: max_header_bytes option (default 65536; 0 = no limit)
func _max_header_bytes(hash %options) int {
    if (defined($options{"max_header_bytes"})) {
        my int $m = $options{"max_header_bytes"} + 0;
        if ($m < 0) { $m = 0; }
        return $m;
    }
    return 65536;
}

# Internal: max_response_bytes option (default 64 MiB; 0 = no limit)
func _max_response_bytes(hash %options) int {
    if (defined($options{"max_response_bytes"})) {
        my int $m = $options{"max_response_bytes"} + 0;
        if ($m < 0) { $m = 0; }
        return $m;
    }
    return 67108864;
}

# Internal: does a raw response's header section exceed $max bytes?
func _headers_too_large(str $raw, int $max) int {
    if ($max <= 0) { return 0; }
    my int $sep = core::byte_index($raw, "\r\n\r\n");
    if ($sep < 0) { return core::byte_length($raw) > $max ? 1 : 0; }
    return $sep > $max ? 1 : 0;
}

# Read HTTP response from socket. Stops early once more than
# $max_header_bytes arrive without the end of the headers, or once the
# response grows past $max_response_bytes (0 = no limit for either).
func read_http_response(scalar $sock, int $max_header_bytes = 65536, int $max_response_bytes = 67108864, str $method = "GET", int $timeout_ms = 0) str {
    my str $response = "";
    while (1) {
        if ($timeout_ms > 0) {
            my scalar $ready = core::socket_select([$sock], $timeout_ms);
            if (!defined($ready) || scalar($ready) == 0) {
                break;
            }
        }
        my str $chunk = core::socket_recv($sock, 8192);
        if (!defined($chunk) || core::byte_length($chunk) == 0) {
            break;
        }
        $response = $response . $chunk;
        if ($max_response_bytes > 0 && core::byte_length($response) > $max_response_bytes) {
            break;
        }
        if (core::byte_index($response, "\r\n\r\n") < 0
            && LWP_SSL::_headers_too_large($response, $max_header_bytes)) {
            break;
        }
        if (LWP_SSL::_response_complete($response, $method)) {
            break;
        }
    }
    return $response;
}

# Internal: Make HTTP request (plain)
func do_http_request(str $host, int $port, str $request, int $max_header_bytes = 65536, int $max_response_bytes = 67108864, str $method = "GET", int $timeout_ms = 0) hash {
    my hash %response = ();
    $response{"success"} = 0;

    my scalar $sock = core::socket_client($host, $port);
    if (!defined($sock)) {
        $response{"error"} = "Connection failed to " . $host . ":" . $port;
        return %response;
    }

    if (LWP_SSL::_send_all($sock, $request) < 0) {
        core::socket_close($sock);
        $response{"error"} = "Send failed to " . $host . ":" . $port;
        return %response;
    }
    my str $raw_response = LWP_SSL::read_http_response($sock, $max_header_bytes, $max_response_bytes, $method, $timeout_ms);
    core::socket_close($sock);

    if ($max_response_bytes > 0 && core::byte_length($raw_response) > $max_response_bytes) {
        $response{"error"} = "HTTP response exceeds " . $max_response_bytes . " bytes";
        return %response;
    }
    if (LWP_SSL::_headers_too_large($raw_response, $max_header_bytes)) {
        $response{"error"} = "HTTP response headers exceed " . $max_header_bytes . " bytes";
        return %response;
    }
    return LWP_SSL::parse_response($raw_response);
}

# Internal: Make HTTPS request (uses ssl module via extern "C")
func do_https_request(str $host, int $port, str $request, int $max_header_bytes = 65536, int $max_response_bytes = 67108864, str $method = "GET", int $timeout_ms = 0, int $verify = 1) hash {
    my hash %response = ();
    $response{"success"} = 0;

    # Connect using ssl module (extern "C")
    my int $conn = $verify ? ssl::connect($host, $port) : ssl::connect_insecure($host, $port);
    if (c::is_null($conn)) {
        $response{"error"} = "SSL connection failed to " . $host . ":" . $port;
        return %response;
    }
    if ($timeout_ms > 0) {
        ssl::set_timeout($conn, $timeout_ms);
    }

    # Write request
    ssl::write($conn, $request);

    # Read response
    my str $raw_response = "";
    my str $chunk = ssl::read($conn, 8192);
    while (core::byte_length($chunk) > 0) {
        $raw_response = $raw_response . $chunk;
        if ($max_response_bytes > 0 && core::byte_length($raw_response) > $max_response_bytes) {
            last;
        }
        if (core::byte_index($raw_response, "\r\n\r\n") < 0
            && LWP_SSL::_headers_too_large($raw_response, $max_header_bytes)) {
            last;
        }
        if (LWP_SSL::_response_complete($raw_response, $method)) {
            last;
        }
        $chunk = ssl::read($conn, 8192);
    }

    # Close connection
    ssl::close($conn);

    if ($max_response_bytes > 0 && core::byte_length($raw_response) > $max_response_bytes) {
        $response{"error"} = "HTTP response exceeds " . $max_response_bytes . " bytes";
        return %response;
    }
    if (LWP_SSL::_headers_too_large($raw_response, $max_header_bytes)) {
        $response{"error"} = "HTTP response headers exceed " . $max_header_bytes . " bytes";
        return %response;
    }
    return LWP_SSL::parse_response($raw_response);
}

# Internal: perform one HTTP/HTTPS request without following redirects
func _do_single_request(str $method, str $url, str $body, hash %options) hash {
    my hash %err_resp = ();
    $err_resp{"success"} = 0;
    if (LWP_SSL::_has_crlf($method) || LWP_SSL::_has_crlf($url)) {
        $err_resp{"error"} = "Invalid CR/LF in HTTP request";
        return %err_resp;
    }
    if (defined($options{"user_agent"}) && LWP_SSL::_has_crlf("" . $options{"user_agent"})) {
        $err_resp{"error"} = "Invalid CR/LF in User-Agent header";
        return %err_resp;
    }
    if (defined($options{"headers"})) {
        my scalar $ch = $options{"headers"};
        foreach my str $hk (keys($ch)) {
            if (LWP_SSL::_has_crlf($hk) || LWP_SSL::_has_crlf("" . $ch->{$hk}) || index($hk, ":") >= 0) {
                $err_resp{"error"} = "Invalid HTTP header";
                return %err_resp;
            }
        }
    }

    my hash %url_parts = LWP_SSL::parse_url($url);
    my str $host = $url_parts{"host"};
    my int $port = $url_parts{"port"};
    my str $path = $url_parts{"path"};
    my str $query = $url_parts{"query"};
    my str $scheme = $url_parts{"scheme"};

    if (length($query) > 0) {
        $path = $path . "?" . $query;
    }

    my str $host_hdr = LWP_SSL::_format_host_header($scheme, $host, $port);
    my str $request = LWP_SSL::build_request($method, $host_hdr, $path, $body, %options);

    my int $max_hdr = LWP_SSL::_max_header_bytes(%options);
    my int $max_resp = LWP_SSL::_max_response_bytes(%options);
    my int $timeout_ms = 0;
    if (defined($options{"timeout"}) && ($options{"timeout"} + 0) > 0) {
        $timeout_ms = ($options{"timeout"} + 0) * 1000;
    }
    my int $verify = 1;
    if (defined($options{"verify"})) {
        $verify = ($options{"verify"} + 0) ? 1 : 0;
    }
    if ($scheme eq "https") {
        return LWP_SSL::do_https_request($host, $port, $request, $max_hdr, $max_resp, $method, $timeout_ms, $verify);
    } else {
        return LWP_SSL::do_http_request($host, $port, $request, $max_hdr, $max_resp, $method, $timeout_ms);
    }
}

# Main request function (with automatic redirect handling; disable with max_redirects => 0)
func do_request(str $method, str $url, str $body, hash %options) hash {
    my int $max_redir = 5;
    if (defined($options{"max_redirects"})) {
        $max_redir = $options{"max_redirects"} + 0;
    }
    my str $cur_method = $method;
    my str $cur_url = $url;
    my str $cur_body = $body;
    my hash %cur_opts = %options;
    my int $hops = 0;
    while (1) {
        my hash %resp = LWP_SSL::_do_single_request($cur_method, $cur_url, $cur_body, %cur_opts);
        my int $st = defined($resp{"status"}) ? ($resp{"status"} + 0) : 0;
        if (($st == 301 || $st == 302 || $st == 303 || $st == 307 || $st == 308) && $hops < $max_redir) {
            my str $loc = "";
            if (defined($resp{"headers"}) && defined($resp{"headers"}->{"location"})) {
                $loc = $resp{"headers"}->{"location"};
            }
            if (length($loc) > 0) {
                if (LWP_SSL::_has_crlf($loc)) {
                    $resp{"success"} = 0;
                    $resp{"error"} = "Invalid CR/LF in redirect Location";
                    return %resp;
                }
                my str $next_url = LWP_SSL::_resolve_url($cur_url, $loc);
                %cur_opts = LWP_SSL::_redirect_options(%cur_opts, $cur_url, $next_url);
                $cur_url = $next_url;
                if (($st == 301 || $st == 302 || $st == 303) && uc($cur_method) eq "POST") {
                    $cur_method = "GET";
                    $cur_body = "";
                }
                $hops = $hops + 1;
                next;
            }
        }
        return %resp;
    }
}

# GET request
func get(str $url) hash {
    my hash %empty = ();
    return LWP_SSL::do_request("GET", $url, "", %empty);
}

# GET request with options
func get_with_options(str $url, hash %options) hash {
    return LWP_SSL::do_request("GET", $url, "", %options);
}

# POST request
func post(str $url, str $data) hash {
    my hash %empty = ();
    return LWP_SSL::do_request("POST", $url, $data, %empty);
}

# POST request with options
func post_with_options(str $url, str $data, hash %options) hash {
    return LWP_SSL::do_request("POST", $url, $data, %options);
}

# POST form data
func post_form(str $url, hash %form_data) hash {
    my str $body = LWP_SSL::build_query(%form_data);
    my hash %empty = ();
    return LWP_SSL::do_request("POST", $url, $body, %empty);
}

# PUT request
func put(str $url, str $data) hash {
    my hash %empty = ();
    return LWP_SSL::do_request("PUT", $url, $data, %empty);
}

# PUT request with options
func put_with_options(str $url, str $data, hash %options) hash {
    return LWP_SSL::do_request("PUT", $url, $data, %options);
}

# DELETE request
func delete_req(str $url) hash {
    my hash %empty = ();
    return LWP_SSL::do_request("DELETE", $url, "", %empty);
}

# DELETE request with options
func delete_with_options(str $url, hash %options) hash {
    return LWP_SSL::do_request("DELETE", $url, "", %options);
}

# PATCH request
func patch(str $url, str $data) hash {
    my hash %empty = ();
    return LWP_SSL::do_request("PATCH", $url, $data, %empty);
}

# PATCH request with options
func patch_with_options(str $url, str $data, hash %options) hash {
    return LWP_SSL::do_request("PATCH", $url, $data, %options);
}

# OPTIONS request
func options(str $url) hash {
    my hash %empty = ();
    return LWP_SSL::do_request("OPTIONS", $url, "", %empty);
}

# OPTIONS request with options
func options_with_options(str $url, hash %options) hash {
    return LWP_SSL::do_request("OPTIONS", $url, "", %options);
}

# HEAD request
func head(str $url) hash {
    my hash %empty = ();
    return LWP_SSL::do_request("HEAD", $url, "", %empty);
}

# HEAD request with options
func head_with_options(str $url, hash %options) hash {
    return LWP_SSL::do_request("HEAD", $url, "", %options);
}

# Simple content fetch
func get_content(str $url) str {
    my hash %resp = LWP_SSL::get($url);
    if ($resp{"success"}) {
        return $resp{"content"};
    }
    return "";
}

# Check if URL is reachable
func is_reachable(str $url) int {
    my hash %resp = LWP_SSL::head($url);
    return $resp{"success"};
}

# Get response header value
func get_header(hash %response, str $name) str {
    if (!defined($response{"headers"})) {
        return "";
    }
    my scalar $headers = $response{"headers"};
    my str $lc_name = lc($name);
    if (defined($headers->{$lc_name})) {
        return $headers->{$lc_name};
    }
    return "";
}

# SSL is always available when linked via extern "C"
func ssl_available() int {
    return 1;
}
