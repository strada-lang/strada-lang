=head1 NAME

LWP - Library for WWW access in Strada

=head1 SYNOPSIS

    use lib "lib";
    use LWP;

    # Simple GET request
    my hash %response = LWP::get("http://example.com");
    if ($response{"success"}) {
        say($response{"content"});
    }

    # POST request
    my hash %response = LWP::post("http://example.com/api", "data=value");

    # Just get the content
    my str $html = LWP::get_content("http://example.com");

=head1 DESCRIPTION

LWP provides functions for making HTTP requests, similar to Perl's
LWP::UserAgent module. It supports GET, POST, PUT, DELETE, and HEAD requests.

B<Note:> For HTTPS support, use L<LWP_SSL> or the L<ssl> module.

=head1 RESPONSE HASH

All request functions return a hash with:

=over 4

=item B<success> - 1 if status is 2xx, 0 otherwise

=item B<status> - HTTP status code (200, 404, etc.)

=item B<reason> - HTTP reason phrase ("OK", "Not Found", etc.)

=item B<content> - Response body

=item B<headers> - Hash reference of response headers (lowercase keys)

=item B<error> - Error message if request failed

=back

=head1 REQUEST FUNCTIONS

=head2 get($url)

Make a GET request.

    my hash %resp = LWP::get("http://api.example.com/users");
    if ($resp{"success"}) {
        my scalar $data = JSON::decode($resp{"content"});
    }

=head2 get_with_options($url, %options)

GET request with custom options (headers, user agent).

    my hash %opts = ();
    $opts{"user_agent"} = "MyApp/1.0";
    $opts{"headers"} = { "Authorization" => "Bearer token123" };
    my hash %resp = LWP::get_with_options($url, %opts);

=head2 post($url, $data)

Make a POST request with form data.

    my hash %resp = LWP::post("http://api.example.com/login",
        "username=alice&password=secret");

=head2 post_with_options($url, $data, %options)

POST with custom options.

=head2 post_form($url, %form_data)

POST form data from a hash (automatically URL-encoded).

    my hash %form = ();
    $form{"username"} = "alice";
    $form{"password"} = "secret";
    my hash %resp = LWP::post_form("http://example.com/login", %form);

=head2 put($url, $data)

Make a PUT request.

=head2 put_with_options($url, $data, %options)

PUT with custom options.

=head2 patch($url, $data)

Make a PATCH request (partial update).

=head2 patch_with_options($url, $data, %options)

PATCH with custom options.

=head2 delete_req($url)

Make a DELETE request.

=head2 delete_with_options($url, %options)

DELETE with custom options.

=head2 head($url)

Make a HEAD request (get headers only).

=head2 head_with_options($url, %options)

HEAD with custom options.

=head2 options($url)

Make an OPTIONS request (get supported methods).

=head2 options_with_options($url, %options)

OPTIONS with custom options.

=head1 LOW-LEVEL REQUEST

=head2 do_request($method, $url, $body, %options)

Make an HTTP request with full control over method, body, and options.
All other request functions are wrappers around this.

B<Parameters:>

=over 4

=item B<$method> - HTTP method string ("GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS", or any custom method)

=item B<$url> - Full URL including scheme, host, port, path, and query

=item B<$body> - Request body (empty string for no body)

=item B<%options> - Hash with optional keys:

=over 4

=item B<user_agent> - Custom User-Agent string (default: "Strada-LWP/1.0")

=item B<headers> - Hash reference of custom headers

=item B<max_header_bytes> - Largest response header section accepted
(default 65536). A server whose status line and headers exceed this gets the
error C<"HTTP response headers exceed N bytes"> instead of being buffered
without limit; 0 disables the check.

=item B<max_response_bytes> - Largest whole response (headers and body)
accepted (default 67108864, i.e. 64 MiB). A bigger response stops being read
and the request fails with C<"HTTP response exceeds N bytes"> rather than
being silently truncated; 0 disables the check.

=back

=back

Returns a response hash (see RESPONSE HASH above).

    # Custom method
    my hash %opts = ();
    $opts{"headers"} = { "Content-Type" => "application/json" };
    my hash %resp = LWP::do_request("PATCH", "http://api.example.com/item/1",
        JSON::encode({ "status" => "active" }), %opts);

    # WebDAV methods
    my hash %resp = LWP::do_request("PROPFIND", "http://dav.example.com/files/", "", %opts);

=head1 CONVENIENCE FUNCTIONS

=head2 get_content($url)

Fetch URL and return just the content (empty string on error).

    my str $html = LWP::get_content("http://example.com");

=head2 is_reachable($url)

Check if a URL is reachable (HEAD request).

    if (LWP::is_reachable("http://api.example.com")) {
        say("API is up!");
    }

=head2 get_header(%response, $name)

Get a response header value (case-insensitive).

    my str $type = LWP::get_header(%resp, "Content-Type");

=head1 URL FUNCTIONS

=head2 parse_url($url)

Parse a URL into components (scheme, host, port, path, query).

    my hash %parts = LWP::parse_url("http://example.com:8080/path?q=test");
    # $parts{"host"} = "example.com"
    # $parts{"port"} = 8080
    # $parts{"path"} = "/path"
    # $parts{"query"} = "q=test"

=head2 url_encode($string)

URL-encode a string.

    my str $safe = LWP::url_encode("hello world!");
    # "hello%20world%21"

=head2 url_decode($string)

URL-decode a string.

=head2 build_query(%params)

Build a query string from a hash.

    my hash %p = ();
    $p{"name"} = "Alice";
    $p{"city"} = "New York";
    my str $qs = LWP::build_query(%p);
    # "name=Alice&city=New%20York"

=head1 USERAGENT CLASS

For more control, use the UserAgent functions:

    my hash %ua = LWP::UserAgent_new();
    LWP::UserAgent_set_agent(%ua, "MyApp/2.0");
    LWP::UserAgent_set_header(%ua, "Accept", "application/json");

    my hash %resp = LWP::UserAgent_get(%ua, $url);
    my hash %resp = LWP::UserAgent_post(%ua, $url, $data);

=head1 EXAMPLE

    use lib "lib";
    use LWP;
    use JSON;

    # Fetch JSON API
    my hash %resp = LWP::get("http://api.example.com/users");
    if ($resp{"success"}) {
        my scalar $users = JSON::decode($resp{"content"});
        foreach my scalar $user (@{$users}) {
            say($user->{"name"});
        }
    } else {
        say("Error: " . $resp{"error"});
    }

    # POST JSON data
    my hash %opts = ();
    $opts{"headers"} = { "Content-Type" => "application/json" };
    my str $json = JSON::encode({ "name" => "Bob" });
    my hash %resp = LWP::post_with_options($url, $json, %opts);

=head1 SEE ALSO

L<LWP_SSL>, L<ssl>, L<JSON>

=cut

package LWP;

# Helper: check if string contains CR or LF (CWE-93 header injection guard)
func _has_crlf(str $s) int {
    return (index($s, "\r") >= 0 || index($s, "\n") >= 0) ? 1 : 0;
}

# Parse a URL into components
# Returns hash with: scheme, host, port, path, query
func parse_url(str $url) hash {
    my hash %result = ();

    # Default values
    $result{"scheme"} = "http";
    $result{"host"} = "";
    $result{"port"} = 80;
    $result{"path"} = "/";
    $result{"query"} = "";

    my str $remaining = $url;

    # Extract scheme
    my int $scheme_end = index($remaining, "://");
    if ($scheme_end > 0) {
        $result{"scheme"} = substr($remaining, 0, $scheme_end);
        $remaining = substr($remaining, $scheme_end + 3, length($remaining) - $scheme_end - 3);

        if ($result{"scheme"} eq "https") {
            $result{"port"} = 443;
        }
    }

    # Extract host and port (handle '?' preceding '/' e.g. http://example.com?a=1/2)
    my int $path_start = index($remaining, "/");
    my int $q_start_raw = index($remaining, "?");
    my str $host_part = "";
    if ($q_start_raw >= 0 && ($path_start < 0 || $q_start_raw < $path_start)) {
        $host_part = substr($remaining, 0, $q_start_raw);
        $remaining = "/" . substr($remaining, $q_start_raw, length($remaining) - $q_start_raw);
    } elsif ($path_start < 0) {
        $host_part = $remaining;
        $remaining = "/";
    } else {
        $host_part = substr($remaining, 0, $path_start);
        $remaining = substr($remaining, $path_start, length($remaining) - $path_start);
    }

    # Check for port in host (supporting bracketed IPv6 literals like [::1]:8080)
    if (length($host_part) >= 2 && substr($host_part, 0, 1) eq "[") {
        my int $close_br = index($host_part, "]");
        if ($close_br > 1) {
            $result{"host"} = substr($host_part, 1, $close_br - 1);
            if ($close_br + 1 < length($host_part) && substr($host_part, $close_br + 1, 1) eq ":") {
                my str $port_str = substr($host_part, $close_br + 2, length($host_part) - $close_br - 2);
                if (length($port_str) > 0) {
                    $result{"port"} = cast_int($port_str);
                }
            }
        } else {
            $result{"host"} = $host_part;
        }
    } else {
        my int $port_sep = index($host_part, ":");
        if ($port_sep > 0) {
            $result{"host"} = substr($host_part, 0, $port_sep);
            my str $port_str = substr($host_part, $port_sep + 1, length($host_part) - $port_sep - 1);
            $result{"port"} = cast_int($port_str);
        } else {
            $result{"host"} = $host_part;
        }
    }

    # Extract path and query
    my int $query_start = index($remaining, "?");
    if ($query_start >= 0) {
        $result{"path"} = substr($remaining, 0, $query_start);
        $result{"query"} = substr($remaining, $query_start + 1, length($remaining) - $query_start - 1);
    } else {
        $result{"path"} = $remaining;
    }

    if (length($result{"path"}) == 0) {
        $result{"path"} = "/";
    }

    return %result;
}

# URL encode a string (percent-encodes raw UTF-8 bytes per RFC 3986)
func url_encode(str $s) str {
    my str $result = "";
    my int $blen = core::byte_length($s);
    my int $i = 0;
    while ($i < $blen) {
        my int $code = core::get_byte($s, $i);

        # Unreserved characters (RFC 3986): A-Z, a-z, 0-9, '-', '.', '_', '~'
        if (($code >= 65 && $code <= 90) ||
            ($code >= 97 && $code <= 122) ||
            ($code >= 48 && $code <= 57) ||
            $code == 45 || $code == 46 || $code == 95 || $code == 126) {
            $result = $result . chr($code);
        } else {
            my int $hi = ($code / 16) % 16;
            my int $lo = $code % 16;
            my str $hex = "%";
            if ($hi < 10) { $hex = $hex . chr(48 + $hi); }
            else { $hex = $hex . chr(55 + $hi); }
            if ($lo < 10) { $hex = $hex . chr(48 + $lo); }
            else { $hex = $hex . chr(55 + $lo); }
            $result = $result . $hex;
        }
        $i = $i + 1;
    }
    return $result;
}

# URL decode a string (binary/UTF-8 byte-accurate)
func url_decode(str $s) str {
    my str $result = "";
    my int $blen = core::byte_length($s);
    my int $i = 0;
    while ($i < $blen) {
        my int $b = core::get_byte($s, $i);
        if ($b == 37 && $i + 2 < $blen) {
            my int $h1 = core::get_byte($s, $i + 1);
            my int $h2 = core::get_byte($s, $i + 2);
            my int $v1 = -1;
            my int $v2 = -1;
            if ($h1 >= 48 && $h1 <= 57) { $v1 = $h1 - 48; }
            elsif ($h1 >= 65 && $h1 <= 70) { $v1 = $h1 - 55; }
            elsif ($h1 >= 97 && $h1 <= 102) { $v1 = $h1 - 87; }
            if ($h2 >= 48 && $h2 <= 57) { $v2 = $h2 - 48; }
            elsif ($h2 >= 65 && $h2 <= 70) { $v2 = $h2 - 55; }
            elsif ($h2 >= 97 && $h2 <= 102) { $v2 = $h2 - 87; }
            if ($v1 >= 0 && $v2 >= 0) {
                $result = $result . core::byte($v1 * 16 + $v2);
                $i = $i + 3;
                next;
            }
        }
        if ($b == 43) {
            $result = $result . " ";
        } else {
            $result = $result . core::byte($b);
        }
        $i = $i + 1;
    }
    return $result;
}

# Build query string from hash
func build_query(hash %params) str {
    my str $result = "";
    my array @keys = keys(%params);
    my int $i = 0;
    while ($i < scalar(@keys)) {
        my str $key = $keys[$i];
        if ($i > 0) {
            $result = $result . "&";
        }
        $result = $result . LWP::url_encode($key) . "=" . LWP::url_encode($params{$key});
        $i = $i + 1;
    }
    return $result;
}

# Parse response headers
func parse_headers(str $header_block) hash {
    my hash %headers = ();
    my array @lines = split("\r\n", $header_block);

    my int $i = 0;
    while ($i < scalar(@lines)) {
        my str $line = $lines[$i];
        my int $colon = index($line, ":");
        if ($colon > 0) {
            my str $name = substr($line, 0, $colon);
            my str $value = substr($line, $colon + 1, length($line) - $colon - 1);
            # Trim leading space from value
            while (length($value) > 0 && substr($value, 0, 1) eq " ") {
                $value = substr($value, 1, length($value) - 1);
            }
            # Store lowercase header name for easy lookup
            $headers{lc($name)} = $value;
        }
        $i = $i + 1;
    }

    return %headers;
}

# Internal: parse hex chunk size (stops at ';' chunk extension)
func _parse_hex_len(str $line) int {
    my int $semi = index($line, ";");
    if ($semi >= 0) {
        $line = substr($line, 0, $semi);
    }
    my int $i = 0;
    my int $n = 0;
    my int $digits = 0;
    my int $len = length($line);
    while ($i < $len) {
        my str $ch = substr($line, $i, 1);
        if ($ch eq " " || $ch eq "\t") {
            if ($digits > 0) { last; }
            $i = $i + 1;
            next;
        }
        my int $o = ord($ch);
        my int $d = -1;
        if ($o >= 48 && $o <= 57) { $d = $o - 48; }
        elsif ($o >= 97 && $o <= 102) { $d = $o - 97 + 10; }
        elsif ($o >= 65 && $o <= 70) { $d = $o - 65 + 10; }
        else { last; }
        $n = ($n * 16) + $d;
        $digits = $digits + 1;
        $i = $i + 1;
    }
    return ($digits > 0) ? $n : -1;
}

# Internal: decode HTTP Transfer-Encoding: chunked body using raw byte offsets
func _decode_chunked(str $raw_body) str {
    my str $out = "";
    my int $pos = 0;
    my int $total = core::byte_length($raw_body);
    while ($pos < $total) {
        my int $nl = core::byte_index($raw_body, "\r\n", $pos);
        if ($nl < 0) {
            return $out;
        }
        my str $size_line = core::byte_substr($raw_body, $pos, $nl - $pos);
        my int $chunk_len = LWP::_parse_hex_len($size_line);
        if ($chunk_len < 0) {
            return $out;
        }
        $pos = $nl + 2;
        if ($chunk_len == 0) {
            last;
        }
        if ($pos + $chunk_len > $total) {
            $out = $out . core::byte_substr($raw_body, $pos, $total - $pos);
            last;
        }
        $out = $out . core::byte_substr($raw_body, $pos, $chunk_len);
        $pos = $pos + $chunk_len;
        if ($pos + 2 <= $total && core::byte_substr($raw_body, $pos, 2) eq "\r\n") {
            $pos = $pos + 2;
        }
    }
    return $out;
}

# Internal: return 1 when chunked response body has received its 0-length terminator
func _chunked_complete(str $raw, int $pos) int {
    my int $total = core::byte_length($raw);
    while ($pos < $total) {
        my int $nl = core::byte_index($raw, "\r\n", $pos);
        if ($nl < 0) { return 0; }
        my str $size_line = core::byte_substr($raw, $pos, $nl - $pos);
        my int $chunk_len = LWP::_parse_hex_len($size_line);
        if ($chunk_len < 0) { return 1; }
        $pos = $nl + 2;
        if ($chunk_len == 0) {
            return (core::byte_index($raw, "\r\n", $pos) >= 0) ? 1 : 0;
        }
        if ($pos + $chunk_len + 2 > $total) { return 0; }
        $pos = $pos + $chunk_len + 2;
    }
    return 0;
}

# Internal: return 1 if buffered HTTP response contains the complete message
func _response_complete(str $response, str $method) int {
    my int $header_end = core::byte_index($response, "\r\n\r\n");
    if ($header_end < 0) { return 0; }

    my str $headers_part = core::byte_substr($response, 0, $header_end);
    my int $first_eol = core::byte_index($headers_part, "\r\n");
    my str $status_line = ($first_eol > 0) ? core::byte_substr($headers_part, 0, $first_eol) : $headers_part;
    my array @sp = split(" ", $status_line);
    my int $status = (scalar(@sp) >= 2) ? cast_int($sp[1]) : 0;
    if (uc($method) eq "HEAD" || $status == 204 || $status == 304 || ($status >= 100 && $status < 200)) {
        return 1;
    }

    my str $headers_lower = lc($headers_part);
    my int $te_pos = core::byte_index($headers_lower, "transfer-encoding:");
    if ($te_pos >= 0) {
        my int $te_end = core::byte_index($headers_part, "\r\n", $te_pos);
        if ($te_end < 0) { $te_end = core::byte_length($headers_part); }
        my str $te_val = lc(core::byte_substr($headers_part, $te_pos + 18, $te_end - $te_pos - 18));
        if (index($te_val, "chunked") >= 0) {
            return LWP::_chunked_complete($response, $header_end + 4);
        }
    }

    my int $cl_pos = core::byte_index($headers_lower, "content-length:");
    if ($cl_pos >= 0) {
        my int $cl_end = core::byte_index($headers_part, "\r\n", $cl_pos);
        if ($cl_end < 0) { $cl_end = core::byte_length($headers_part); }
        my str $cl_line = core::byte_substr($headers_part, $cl_pos + 15, $cl_end - $cl_pos - 15);
        while (length($cl_line) > 0 && (substr($cl_line, 0, 1) eq " " || substr($cl_line, 0, 1) eq "\t")) {
            $cl_line = substr($cl_line, 1, length($cl_line) - 1);
        }
        my int $content_length = cast_int($cl_line);
        my int $body_bytes = core::byte_length($response) - ($header_end + 4);
        if ($body_bytes >= $content_length) {
            return 1;
        }
    }
    return 0;
}

# Internal: format Host header value (bracketing IPv6 and appending non-default port)
func _format_host_header(str $scheme, str $host, int $port) str {
    my str $h = (index($host, ":") >= 0 && substr($host, 0, 1) ne "[") ? ("[" . $host . "]") : $host;
    my int $def_port = ($scheme eq "https") ? 443 : 80;
    if ($port != $def_port && $port > 0) {
        return $h . ":" . $port;
    }
    return $h;
}

# Internal: resolve relative or absolute redirect Location against base URL
func _resolve_url(str $base_url, str $location) str {
    if (index($location, "://") > 0) {
        return $location;
    }
    my hash %bu = LWP::parse_url($base_url);
    my str $authority = LWP::_format_host_header($bu{"scheme"}, $bu{"host"}, $bu{"port"});
    if (length($location) >= 2 && substr($location, 0, 2) eq "//") {
        return $bu{"scheme"} . ":" . $location;
    }
    if (length($location) > 0 && substr($location, 0, 1) eq "/") {
        return $bu{"scheme"} . "://" . $authority . $location;
    }
    my str $dir = $bu{"path"};
    my int $slash = rindex($dir, "/");
    if ($slash >= 0) {
        $dir = substr($dir, 0, $slash + 1);
    } else {
        $dir = "/";
    }
    return $bu{"scheme"} . "://" . $authority . $dir . $location;
}

# Parse HTTP response
func parse_response(str $raw) hash {
    my hash %response = ();
    $response{"success"} = 0;
    $response{"status"} = 0;
    $response{"reason"} = "";
    $response{"content"} = "";

    # Find header/body separator using raw byte offset
    my int $sep = core::byte_index($raw, "\r\n\r\n");
    if ($sep < 0) {
        $response{"error"} = "Invalid HTTP response: no header separator";
        return %response;
    }

    my str $header_section = core::byte_substr($raw, 0, $sep);
    my int $raw_bytes = core::byte_length($raw);
    my str $body = core::byte_substr($raw, $sep + 4, $raw_bytes - $sep - 4);

    # Parse status line
    my int $first_line_end = core::byte_index($header_section, "\r\n");
    my str $status_line = "";
    my str $headers_text = "";
    if ($first_line_end > 0) {
        $status_line = core::byte_substr($header_section, 0, $first_line_end);
        $headers_text = core::byte_substr($header_section, $first_line_end + 2, core::byte_length($header_section) - $first_line_end - 2);
    } else {
        $status_line = $header_section;
    }

    # Parse "HTTP/1.1 200 OK"
    my array @status_parts = split(" ", $status_line);
    if (scalar(@status_parts) >= 2) {
        $response{"protocol"} = $status_parts[0];
        $response{"status"} = cast_int($status_parts[1]);
        if (scalar(@status_parts) >= 3) {
            # Join remaining parts for reason phrase
            my str $reason = "";
            my int $i = 2;
            while ($i < scalar(@status_parts)) {
                if ($i > 2) { $reason = $reason . " "; }
                $reason = $reason . $status_parts[$i];
                $i = $i + 1;
            }
            $response{"reason"} = $reason;
        }
    }

    # Parse headers
    my hash %hdrs = LWP::parse_headers($headers_text);
    $response{"headers"} = \%hdrs;

    if (defined($hdrs{"transfer-encoding"}) && index(lc($hdrs{"transfer-encoding"}), "chunked") >= 0) {
        $body = LWP::_decode_chunked($body);
    }

    # Set content
    $response{"content"} = $body;

    # Determine success (2xx status codes)
    my int $status = $response{"status"};
    if ($status >= 200 && $status < 300) {
        $response{"success"} = 1;
    }

    return %response;
}

# Internal: max_header_bytes option (default 65536; 0 = no limit)
func _max_header_bytes(hash %options) int {
    if (defined($options{"max_header_bytes"})) {
        my int $m = $options{"max_header_bytes"} + 0;
        if ($m < 0) { $m = 0; }
        return $m;
    }
    return 65536;
}

# Internal: max_response_bytes option (default 64 MiB; 0 = no limit)
func _max_response_bytes(hash %options) int {
    if (defined($options{"max_response_bytes"})) {
        my int $m = $options{"max_response_bytes"} + 0;
        if ($m < 0) { $m = 0; }
        return $m;
    }
    return 67108864;
}

# Internal: does a raw response's header section exceed $max bytes?
func _headers_too_large(str $raw, int $max) int {
    if ($max <= 0) { return 0; }
    my int $sep = core::byte_index($raw, "\r\n\r\n");
    if ($sep < 0) { return core::byte_length($raw) > $max ? 1 : 0; }
    return $sep > $max ? 1 : 0;
}

# Internal: read HTTP response from socket. Stops early once more than
# $max_header_bytes arrive without the end of the headers, or once the
# response grows past $max_response_bytes (0 = no limit for either).
func read_response(scalar $sock, int $max_header_bytes = 65536, int $max_response_bytes = 67108864, str $method = "GET", int $timeout_ms = 0) str {
    my str $response = "";

    while (1) {
        if ($timeout_ms > 0) {
            my scalar $ready = core::socket_select([$sock], $timeout_ms);
            if (!defined($ready) || scalar($ready) == 0) {
                break;
            }
        }
        my str $chunk = core::socket_recv($sock, 8192);
        if (!defined($chunk) || core::byte_length($chunk) == 0) {
            break;
        }
        $response = $response . $chunk;
        if ($max_response_bytes > 0 && core::byte_length($response) > $max_response_bytes) {
            break;
        }

        if (core::byte_index($response, "\r\n\r\n") < 0 && LWP::_headers_too_large($response, $max_header_bytes)) {
            break;
        }
        if (LWP::_response_complete($response, $method)) {
            break;
        }
    }

    return $response;
}

# Internal: perform one HTTP roundtrip (no redirect loop)
func _do_single_request(str $method, str $url, str $body, hash %options) hash {
    my hash %response = ();
    $response{"success"} = 0;

    if (LWP::_has_crlf($method) || LWP::_has_crlf($url)) {
        $response{"error"} = "Invalid CR/LF in HTTP request";
        return %response;
    }

    my hash %url_parts = LWP::parse_url($url);

    my str $host = $url_parts{"host"};
    my int $port = $url_parts{"port"};
    my str $path = $url_parts{"path"};
    my str $query = $url_parts{"query"};
    my str $scheme = $url_parts{"scheme"};

    if (LWP::_has_crlf($host) || LWP::_has_crlf($path) || LWP::_has_crlf($query)) {
        $response{"error"} = "Invalid CR/LF in URL";
        return %response;
    }

    if (length($query) > 0) {
        $path = $path . "?" . $query;
    }

    # Build request
    my str $request = $method . " " . $path . " HTTP/1.1\r\n";
    $request = $request . "Host: " . LWP::_format_host_header($scheme, $host, $port) . "\r\n";

    # User-Agent
    my str $ua = "Strada-LWP/1.0";
    if (defined($options{"user_agent"})) {
        $ua = $options{"user_agent"};
    }
    if (LWP::_has_crlf($ua)) {
        $response{"error"} = "Invalid CR/LF in User-Agent header";
        return %response;
    }
    $request = $request . "User-Agent: " . $ua . "\r\n";

    # Connection
    $request = $request . "Connection: close\r\n";

    # Custom headers
    if (defined($options{"headers"})) {
        my scalar $custom_headers = $options{"headers"};
        my array @hkeys = keys($custom_headers);
        my int $i = 0;
        while ($i < scalar(@hkeys)) {
            my str $hname = $hkeys[$i];
            my str $hval = "" . $custom_headers->{$hname};
            if (LWP::_has_crlf($hname) || LWP::_has_crlf($hval) || index($hname, ":") >= 0) {
                $response{"error"} = "Invalid HTTP header";
                return %response;
            }
            $request = $request . $hname . ": " . $hval . "\r\n";
            $i = $i + 1;
        }
    }

    # Body for POST/PUT
    my int $body_len = core::byte_length($body);
    if ($body_len > 0) {
        if (!defined($options{"headers"}) || !defined($options{"headers"}->{"Content-Type"})) {
            $request = $request . "Content-Type: application/x-www-form-urlencoded\r\n";
        }
        $request = $request . "Content-Length: " . $body_len . "\r\n";
    }

    $request = $request . "\r\n";

    if ($body_len > 0) {
        $request = $request . $body;
    }

    if ($scheme eq "https") {
        # Keep pure LWP free of mandatory -lssl/-lcrypto link deps; use LWP_SSL for HTTPS.
        $response{"error"} = "HTTPS requires LWP_SSL (use LWP_SSL for https:// requests)";
        return %response;
    }

    # Plain HTTP
    my scalar $sock = core::socket_client($host, $port);
    if (!defined($sock)) {
        $response{"error"} = "Connection failed to " . $host . ":" . $port;
        return %response;
    }

    core::socket_send($sock, $request);

    my int $max_hdr = LWP::_max_header_bytes(%options);
    my int $max_resp = LWP::_max_response_bytes(%options);
    my int $timeout_ms = 0;
    if (defined($options{"timeout"}) && ($options{"timeout"} + 0) > 0) {
        $timeout_ms = ($options{"timeout"} + 0) * 1000;
    }
    my str $raw_response = LWP::read_response($sock, $max_hdr, $max_resp, $method, $timeout_ms);
    core::socket_close($sock);

    if ($max_resp > 0 && core::byte_length($raw_response) > $max_resp) {
        $response{"error"} = "HTTP response exceeds " . $max_resp . " bytes";
        return %response;
    }
    if (LWP::_headers_too_large($raw_response, $max_hdr)) {
        $response{"error"} = "HTTP response headers exceed " . $max_hdr . " bytes";
        return %response;
    }
    return LWP::parse_response($raw_response);
}

# Make HTTP request (with automatic redirect handling; disable with max_redirects => 0)
func do_request(str $method, str $url, str $body, hash %options) hash {
    my int $max_redir = 5;
    if (defined($options{"max_redirects"})) {
        $max_redir = $options{"max_redirects"} + 0;
    }
    my str $cur_method = $method;
    my str $cur_url = $url;
    my str $cur_body = $body;
    my int $hops = 0;
    while (1) {
        my hash %resp = LWP::_do_single_request($cur_method, $cur_url, $cur_body, %options);
        my int $st = defined($resp{"status"}) ? ($resp{"status"} + 0) : 0;
        if (($st == 301 || $st == 302 || $st == 303 || $st == 307 || $st == 308) && $hops < $max_redir) {
            my str $loc = "";
            if (defined($resp{"headers"}) && defined($resp{"headers"}->{"location"})) {
                $loc = $resp{"headers"}->{"location"};
            }
            if (length($loc) > 0) {
                $cur_url = LWP::_resolve_url($cur_url, $loc);
                if (($st == 301 || $st == 302 || $st == 303) && uc($cur_method) eq "POST") {
                    $cur_method = "GET";
                    $cur_body = "";
                }
                $hops = $hops + 1;
                next;
            }
        }
        return %resp;
    }
}

# GET request
func get(str $url) hash {
    my hash %empty = ();
    return LWP::do_request("GET", $url, "", %empty);
}

# GET request with options
func get_with_options(str $url, hash %options) hash {
    return LWP::do_request("GET", $url, "", %options);
}

# POST request
func post(str $url, str $data) hash {
    my hash %empty = ();
    return LWP::do_request("POST", $url, $data, %empty);
}

# POST request with options
func post_with_options(str $url, str $data, hash %options) hash {
    return LWP::do_request("POST", $url, $data, %options);
}

# POST form data (from hash)
func post_form(str $url, hash %form_data) hash {
    my str $body = LWP::build_query(%form_data);
    my hash %empty = ();
    return LWP::do_request("POST", $url, $body, %empty);
}

# PUT request
func put(str $url, str $data) hash {
    my hash %empty = ();
    return LWP::do_request("PUT", $url, $data, %empty);
}

# PUT request with options
func put_with_options(str $url, str $data, hash %options) hash {
    return LWP::do_request("PUT", $url, $data, %options);
}

# DELETE request
func delete_req(str $url) hash {
    my hash %empty = ();
    return LWP::do_request("DELETE", $url, "", %empty);
}

# DELETE request with options
func delete_with_options(str $url, hash %options) hash {
    return LWP::do_request("DELETE", $url, "", %options);
}

# PATCH request
func patch(str $url, str $data) hash {
    my hash %empty = ();
    return LWP::do_request("PATCH", $url, $data, %empty);
}

# PATCH request with options
func patch_with_options(str $url, str $data, hash %options) hash {
    return LWP::do_request("PATCH", $url, $data, %options);
}

# OPTIONS request
func options(str $url) hash {
    my hash %empty = ();
    return LWP::do_request("OPTIONS", $url, "", %empty);
}

# OPTIONS request with options
func options_with_options(str $url, hash %options) hash {
    return LWP::do_request("OPTIONS", $url, "", %options);
}

# HEAD request (get headers only)
func head(str $url) hash {
    my hash %empty = ();
    return LWP::do_request("HEAD", $url, "", %empty);
}

# HEAD request with options
func head_with_options(str $url, hash %options) hash {
    return LWP::do_request("HEAD", $url, "", %options);
}

# Simple content fetch (returns just the content string or empty on error)
func get_content(str $url) str {
    my hash %resp = LWP::get($url);
    if ($resp{"success"}) {
        return $resp{"content"};
    }
    return "";
}

# Check if URL is reachable
func is_reachable(str $url) int {
    my hash %resp = LWP::head($url);
    return $resp{"success"};
}

# Get response header value
func get_header(hash %response, str $name) str {
    if (!defined($response{"headers"})) {
        return "";
    }
    my scalar $headers = $response{"headers"};
    my str $lc_name = lc($name);
    if (defined($headers->{$lc_name})) {
        return $headers->{$lc_name};
    }
    return "";
}

# UserAgent class for more complex usage
func UserAgent_new() hash {
    my hash %ua = ();
    $ua{"user_agent"} = "Strada-LWP/1.0";
    $ua{"timeout"} = 30;
    $ua{"default_headers"} = {};
    return %ua;
}

func UserAgent_set_agent(hash %ua, str $agent) void {
    $ua{"user_agent"} = $agent;
}

func UserAgent_set_timeout(hash %ua, int $timeout) void {
    $ua{"timeout"} = $timeout;
}

func UserAgent_set_header(hash %ua, str $name, str $value) void {
    my scalar $headers = $ua{"default_headers"};
    $headers->{$name} = $value;
}

func UserAgent_get(hash %ua, str $url) hash {
    my hash %options = ();
    $options{"user_agent"} = $ua{"user_agent"};
    $options{"headers"} = $ua{"default_headers"};
    $options{"timeout"} = $ua{"timeout"};
    return LWP::do_request("GET", $url, "", %options);
}

func UserAgent_post(hash %ua, str $url, str $data) hash {
    my hash %options = ();
    $options{"user_agent"} = $ua{"user_agent"};
    $options{"headers"} = $ua{"default_headers"};
    $options{"timeout"} = $ua{"timeout"};
    return LWP::do_request("POST", $url, $data, %options);
}
