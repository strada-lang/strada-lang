# DBI against a live MySQL/MariaDB server (driven by t/t_dbi_mysql.sh).
#
#   STRADA_TEST_MYSQL_DSN="dbi:mysql:database=test;host=127.0.0.1;port=3306"
#   STRADA_TEST_MYSQL_USER=...  STRADA_TEST_MYSQL_PASSWORD=...
#
# Regressions (2026-11):
#   * begin_work/commit/rollback ran BEGIN/COMMIT/ROLLBACK through the
#     prepared-statement protocol, which MySQL rejects - transactions never
#     worked on MySQL.
#   * an empty string parameter was bound as NULL.
use DBI;

my int $g_fail = 0;

func check(int $ok, str $name) void {
    if ($ok) { say("ok - " . $name); } else { say("not ok - " . $name); $g_fail = $g_fail + 1; }
}

func count_s(scalar $dbh, str $s) int {
    my scalar $n = DBI::selectcol($dbh, "SELECT COUNT(*) FROM strada_dbi_mysql_t WHERE s = ?", [$s]);
    return core::atoi("" . $n);
}

func main() int {
    my str $dsn = core::getenv("STRADA_TEST_MYSQL_DSN");
    my scalar $dbh = DBI::connect_attrs($dsn, core::getenv("STRADA_TEST_MYSQL_USER"),
        core::getenv("STRADA_TEST_MYSQL_PASSWORD"), {"RaiseError" => 1, "PrintError" => 0});
    if (!defined($dbh)) { say("FAIL: cannot connect to " . $dsn); return 1; }

    DBI::do_sql($dbh, "CREATE TEMPORARY TABLE strada_dbi_mysql_t (id INT AUTO_INCREMENT PRIMARY KEY, s VARCHAR(20) NOT NULL, n VARCHAR(20) NULL) ENGINE=InnoDB");

    # Empty string is a value, undef is NULL
    my int $ins_ok = 1;
    try { DBI::exec($dbh, "INSERT INTO strada_dbi_mysql_t (s, n) VALUES (?, ?)", ["", undef]); }
    catch ($e) { $ins_ok = 0; say("  insert failed: " . $e); }
    check($ins_ok == 1, "insert of an empty string into a NOT NULL column");
    my scalar $row = DBI::selectrow_hashref($dbh, "SELECT s, n, s IS NULL AS s_is_null FROM strada_dbi_mysql_t ORDER BY id LIMIT 1", []);
    check(defined($row) && defined($row->{"s"}) && $row->{"s"} eq "", "empty string stored as empty string");
    check(defined($row) && ("" . $row->{"s_is_null"}) eq "0", "empty string is not NULL");
    check(defined($row) && !defined($row->{"n"}), "undef stored as NULL");

    # Transactions
    my int $bw = -1;
    try { $bw = DBI::begin_work($dbh); } catch ($e) { say("  begin_work: " . $e); }
    check($bw >= 0, "begin_work succeeds");
    DBI::exec($dbh, "INSERT INTO strada_dbi_mysql_t (s) VALUES (?)", ["rolled"]);
    check(count_s($dbh, "rolled") == 1, "row visible inside transaction");
    check(DBI::rollback($dbh) >= 0, "rollback succeeds");
    check(count_s($dbh, "rolled") == 0, "rollback discards the row");

    check(DBI::begin_work($dbh) >= 0, "begin_work again");
    DBI::exec($dbh, "INSERT INTO strada_dbi_mysql_t (s) VALUES (?)", ["kept"]);
    check(DBI::commit($dbh) >= 0, "commit succeeds");
    check(count_s($dbh, "kept") == 1, "commit keeps the row");

    # An error inside a transaction can still be rolled back
    DBI::begin_work($dbh);
    DBI::exec($dbh, "INSERT INTO strada_dbi_mysql_t (s) VALUES (?)", ["doomed"]);
    my int $threw = 0;
    try { DBI::exec($dbh, "INSERT INTO no_such_table_xyz VALUES (1)", []); } catch ($e) { $threw = 1; }
    check($threw == 1, "RaiseError throws inside a transaction");
    DBI::rollback($dbh);
    check(count_s($dbh, "doomed") == 0, "rollback after an error");

    # Binary data (NUL bytes) round-trips intact through bind and fetch
    DBI::do_sql($dbh, "CREATE TEMPORARY TABLE strada_dbi_mysql_bin (id INT AUTO_INCREMENT PRIMARY KEY, b MEDIUMBLOB NOT NULL, t VARCHAR(40) NOT NULL)");
    my str $bin = "";
    for (my int $k = 0; $k < 1200; $k = $k + 1) { $bin = $bin . core::pack("C", $k % 256); }
    my str $txt = "Wile" . chr(0) . "Coyote";
    DBI::exec($dbh, "INSERT INTO strada_dbi_mysql_bin (b, t) VALUES (?, ?)", [$bin, $txt]);
    check(("" . DBI::selectcol($dbh, "SELECT LENGTH(b) FROM strada_dbi_mysql_bin", [])) eq "1200", "a binary parameter is stored whole");
    my scalar $brow = DBI::selectrow_hashref($dbh, "SELECT b, t FROM strada_dbi_mysql_bin", []);
    check(defined($brow) && bytes($brow->{"b"}) == 1200 && $brow->{"b"} eq $bin, "a binary column is fetched whole (hash row)");
    check(defined($brow) && $brow->{"t"} eq $txt, "a NUL inside text survives");
    my scalar $brows = DBI::selectall_arrayref_bind($dbh, "SELECT b FROM strada_dbi_mysql_bin", []);
    check(defined($brows) && scalar(@{$brows}) == 1 && $brows->[0]->[0] eq $bin, "a binary column is fetched whole (array row)");
    check(defined(DBI::selectrow_hashref($dbh, "SELECT id FROM strada_dbi_mysql_bin WHERE b = ?", [$bin])), "a binary value matches in WHERE");

    # EvilCRM / Cannoli regression: non-temporary schema_migrations-style table,
    # empty SELECT returning [] (never undef), prepared SELECT execute() >= 0 & re-exec,
    # DECIMAL scale preservation, BIGINT UNSIGNED > INT64_MAX, UTF-8 DBI::quote
    DBI::do_sql($dbh, "DROP TABLE IF EXISTS strada_dbi_mig_t");
    DBI::do_sql($dbh, "CREATE TABLE strada_dbi_mig_t (version VARCHAR(190) NOT NULL PRIMARY KEY, price DECIMAL(16,2) NOT NULL DEFAULT 0, big BIGINT UNSIGNED NOT NULL DEFAULT 0) ENGINE=InnoDB");

    my scalar $empty_sh = DBI::selectall_hashref($dbh, "SELECT version FROM strada_dbi_mig_t", []);
    check(defined($empty_sh) && scalar(@{$empty_sh}) == 0, "empty SELECT selectall_hashref returns [] not undef");
    my scalar $empty_sr = DBI::selectrow_hashref($dbh, "SELECT version FROM strada_dbi_mig_t", []);
    check(!defined($empty_sr), "empty SELECT selectrow_hashref returns undef");
    my scalar $empty_sc = DBI::selectcol($dbh, "SELECT MAX(version) FROM strada_dbi_mig_t", []);
    check(!defined($empty_sc), "empty MAX() selectcol returns undef");
    my scalar $empty_aa = DBI::selectall_arrayref($dbh, "SELECT version FROM strada_dbi_mig_t");
    check(defined($empty_aa) && scalar(@{$empty_aa}) == 0, "empty selectall_arrayref returns []");
    my scalar $empty_ab = DBI::selectall_arrayref_bind($dbh, "SELECT version FROM strada_dbi_mig_t WHERE version = ?", ["missing"]);
    check(defined($empty_ab) && scalar(@{$empty_ab}) == 0, "empty selectall_arrayref_bind returns []");

    DBI::exec($dbh, "INSERT INTO strada_dbi_mig_t (version, price, big) VALUES (?, ?, ?)", ["001_init", "1250.00", "42"]);
    DBI::do_sql($dbh, "INSERT INTO strada_dbi_mig_t (version, price, big) VALUES ('002_jobs', 0.00, 18446744073709551600)");

    my scalar $sth_sel = DBI::prepare($dbh, "SELECT version, price, big FROM strada_dbi_mig_t WHERE version = ?");
    my int $exec_rc1 = DBI::execute($sth_sel, ["001_init"]);
    check($exec_rc1 >= 0, "prepared SELECT execute() returns >= 0");
    my scalar $r1 = DBI::fetchrow_hashref($sth_sel);
    check(defined($r1) && $r1->{"version"} eq "001_init", "prepared SELECT fetches version");
    check(defined($r1) && ("" . $r1->{"price"}) eq "1250.00", "DECIMAL(16,2) preserves trailing .00 scale");
    check(defined($r1) && $r1->{"big"} == 42, "BIGINT UNSIGNED <= INT64_MAX returns int 42");
    DBI::finish($sth_sel);

    my int $exec_rc2 = DBI::execute($sth_sel, ["002_jobs"]);
    check($exec_rc2 >= 0, "prepared SELECT re-execute returns >= 0");
    my scalar $r2 = DBI::fetchrow_hashref($sth_sel);
    check(defined($r2) && ("" . $r2->{"price"}) eq "0.00", "DECIMAL(16,2) 0.00 preserves scale");
    check(defined($r2) && ("" . $r2->{"big"}) eq "18446744073709551600", "BIGINT UNSIGNED > INT64_MAX preserves full digits as str");
    DBI::_destroy_st($sth_sel);

    my scalar $migs = DBI::selectall_hashref($dbh, "SELECT version FROM strada_dbi_mig_t", []);
    my hash %done = ();
    foreach my scalar $mr (@{$migs}) {
        $done{$mr->{"version"}} = 1;
    }
    check(scalar(@{$migs}) == 2 && exists(%done, "001_init") && exists(%done, "002_jobs"), "Migrator::applied SELECT returns all versions");
    my scalar $cur_ver = DBI::selectcol($dbh, "SELECT MAX(version) FROM strada_dbi_mig_t", []);
    check(defined($cur_ver) && ("" . $cur_ver) eq "002_jobs", "Migrator::current MAX(version) returns 002_jobs");

    # Tagged-int (int), num, 0, negative int, and undef bind parameters on MySQL
    my int $bind_id = 77;
    my int $bind_zero = 0;
    my num $bind_price = 19.75;
    DBI::exec($dbh, "INSERT INTO strada_dbi_mig_t (version, price, big) VALUES (?, ?, ?)", ["003_int_bind", $bind_price, $bind_id]);
    DBI::exec($dbh, "INSERT INTO strada_dbi_mig_t (version, price, big) VALUES (?, ?, ?)", ["004_zero_bind", 0, $bind_zero]);
    my scalar $int_row = DBI::selectrow_hashref($dbh, "SELECT version, price, big FROM strada_dbi_mig_t WHERE big = ?", [$bind_id]);
    check(defined($int_row) && $int_row->{"version"} eq "003_int_bind", "SELECT with tagged-int bind parameter matches row");
    check(defined($int_row) && ("" . $int_row->{"price"}) eq "19.75", "num bind parameter stored as 19.75");
    check(defined($int_row) && $int_row->{"big"} == 77, "int bind parameter stored as 77");
    my scalar $zero_row = DBI::selectrow_hashref($dbh, "SELECT version, big FROM strada_dbi_mig_t WHERE big = ?", [0]);
    check(defined($zero_row) && $zero_row->{"version"} eq "004_zero_bind" && $zero_row->{"big"} == 0, "tagged-int 0 bind parameter works");
    DBI::exec($dbh, "INSERT INTO strada_dbi_mysql_t (s, n) VALUES (?, ?)", [-42, undef]);
    my scalar $neg_cnt = DBI::selectcol($dbh, "SELECT COUNT(*) FROM strada_dbi_mysql_t WHERE s = ?", [-42]);
    check(core::atoi("" . $neg_cnt) == 1, "negative tagged-int bind parameter works");
    check(DBI::quote($dbh, 12345) eq "'12345'", "DBI::quote handles tagged-int value");

    my str $u8 = "café's";
    utf8::upgrade($u8);
    my str $qu8 = DBI::quote($dbh, $u8);
    check(utf8::is_utf8($qu8) == 1 && index($qu8, "café") >= 0, "DBI::quote preserves UTF-8 flag");

    DBI::do_sql($dbh, "DROP TABLE strada_dbi_mig_t");

    # Dangling statement destroyed after disconnect should not crash
    my scalar $dangling_sth = DBI::prepare($dbh, "SELECT 1");
    DBI::execute($dangling_sth, []);
    DBI::disconnect($dbh);
    if ($g_fail > 0) { say("FAIL: " . $g_fail . " DBI MySQL check(s) failed"); return 1; }
    say("PASS: All DBI MySQL tests passed");
    return 0;
}
