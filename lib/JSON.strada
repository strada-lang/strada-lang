=head1 NAME

JSON - fast C-accelerated JSON encoding and decoding for Strada

=head1 SYNOPSIS

    use lib "lib";
    use JSON;

    my str $json = JSON::encode(\%data);
    my str $json_sorted = JSON::encode_opts(\%data, { "canonical" => 1 });
    my scalar $data = JSON::decode($json);

=head1 DESCRIPTION

Drop-in C implementation of the JSON module: the encoder and decoder walk
StradaValue structures directly in C (no per-character Strada string
operations), making both roughly an order of magnitude faster than the
original pure-Strada implementation — which remains available, unchanged
in behavior, as L<JSON::PS>.

Semantics match JSON::PS:

=over 4

=item * unblessed hashrefs -> objects (insertion order; C<canonical> sorts)

=item * unblessed arrayrefs -> arrays; scalar refs encode their target

=item * C<undef> -> null; null -> C<undef>; true/false -> 1/0

=item * numeric-looking strings encode unquoted (JSON::PS compatibility)

=item * invalid JSON decodes to C<undef>

=item * C<\uXXXX> escapes (including surrogate pairs) decode to UTF-8

=back

=head1 FUNCTIONS

=head2 encode($data)

Encode a Strada data structure to a JSON string.

=head2 encode_opts($data, $options)

Encode with options. Supports B<canonical> (sort object keys).

=head2 decode($json)

Decode a JSON string to a Strada data structure. Returns C<undef> for
invalid JSON.

=head1 SEE ALSO

L<JSON::PS> - the pure-Strada implementation

=cut

package JSON;
version "2.0.0";

__C__ {
#include <string.h>
#include <stdlib.h>
#include <stdio.h>
#include <math.h>
#include <errno.h>

/* ============================================================
 * Encoder: walk StradaValue structures, build into a growable
 * byte buffer. Mirrors JSON::PS semantics exactly (see POD).
 * ============================================================ */

typedef struct {
    char *buf;
    size_t len, cap;
    int oom;
} JsonB;

static int jb_grow(JsonB *b, size_t need) {
    if (b->oom) return 0;
    if (b->len + need + 1 <= b->cap) return 1;
    size_t ncap = b->cap ? b->cap : 256;
    while (b->len + need + 1 > ncap) ncap *= 2;
    char *nb = realloc(b->buf, ncap);
    if (!nb) { b->oom = 1; return 0; }
    b->buf = nb; b->cap = ncap;
    return 1;
}
static void jb_put(JsonB *b, const char *s, size_t n) {
    if (!jb_grow(b, n)) return;
    memcpy(b->buf + b->len, s, n);
    b->len += n;
}
static void jb_putc(JsonB *b, char c) {
    if (!jb_grow(b, 1)) return;
    b->buf[b->len++] = c;
}

/* Escape ASCII control chars 0x00..0x1F (\b, \f, \n, \r, \t, \u00XX) plus " and \. */
static void jb_put_escaped(JsonB *b, const char *s, size_t n) {
    static const char hex[] = "0123456789abcdef";
    jb_putc(b, '"');
    size_t run = 0;
    for (size_t i = 0; i < n; i++) {
        unsigned char uc = (unsigned char)s[i];
        if (uc == '"' || uc == '\\' || uc < 0x20) {
            if (run) jb_put(b, s + i - run, run);
            run = 0;
            switch (uc) {
                case '"':  jb_put(b, "\\\"", 2); break;
                case '\\': jb_put(b, "\\\\", 2); break;
                case '\b': jb_put(b, "\\b", 2);  break;
                case '\f': jb_put(b, "\\f", 2);  break;
                case '\n': jb_put(b, "\\n", 2);  break;
                case '\r': jb_put(b, "\\r", 2);  break;
                case '\t': jb_put(b, "\\t", 2);  break;
                default: {
                    char uesc[6];
                    uesc[0] = '\\';
                    uesc[1] = 'u';
                    uesc[2] = '0';
                    uesc[3] = '0';
                    uesc[4] = hex[(uc >> 4) & 0x0F];
                    uesc[5] = hex[uc & 0x0F];
                    jb_put(b, uesc, 6);
                    break;
                }
            }
        } else {
            run++;
        }
    }
    if (run) jb_put(b, s + n - run, run);
    jb_putc(b, '"');
}

static int json_keycmp(const void *a, const void *b) {
    const StradaHashEntry *ea = *(const StradaHashEntry* const*)a;
    const StradaHashEntry *eb = *(const StradaHashEntry* const*)b;
    size_t la = ea->key->len;
    size_t lb = eb->key->len;
    size_t minlen = la < lb ? la : lb;
    int cmp = minlen ? memcmp(ea->key->data, eb->key->data, minlen) : 0;
    if (cmp != 0) return cmp;
    if (la < lb) return -1;
    if (la > lb) return 1;
    return 0;
}

static void json_enc(JsonB *b, StradaValue *v, int canonical, int depth);

static void json_enc_hash(JsonB *b, StradaHash *hv, int canonical, int depth) {
    jb_putc(b, '{');
    int first = 1;
    if (!hv) { jb_putc(b, '}'); return; }
    if (canonical && hv->num_entries > 0) {
        size_t n = 0;
        StradaHashEntry **order = malloc(hv->next_slot * sizeof(StradaHashEntry*));
        if (order) {
            for (size_t i = 0; i < hv->next_slot; i++)
                if (hv->entries[i].key) order[n++] = &hv->entries[i];
            qsort(order, n, sizeof(StradaHashEntry*), json_keycmp);
            for (size_t i = 0; i < n; i++) {
                if (!first) jb_putc(b, ',');
                first = 0;
                jb_put_escaped(b, order[i]->key->data, order[i]->key->len);
                jb_putc(b, ':');
                json_enc(b, order[i]->value, canonical, depth + 1);
            }
            free(order);
            jb_putc(b, '}');
            return;
        }
        /* OOM on the order array: fall through to insertion order */
    }
    for (size_t i = 0; i < hv->next_slot; i++) {
        if (!hv->entries[i].key) continue;
        if (!first) jb_putc(b, ',');
        first = 0;
        jb_put_escaped(b, hv->entries[i].key->data, hv->entries[i].key->len);
        jb_putc(b, ':');
        json_enc(b, hv->entries[i].value, canonical, depth + 1);
    }
    jb_putc(b, '}');
}

static void json_enc(JsonB *b, StradaValue *v, int canonical, int depth) {
    if (depth > 512) { jb_put(b, "null", 4); return; }   /* RFC 8259 / depth cap */
    if (!v) { jb_put(b, "null", 4); return; }

    if (STRADA_IS_TAGGED_INT(v)) {
        char tmp[24];
        long long iv = (long long)STRADA_TAGGED_INT_VAL(v);
        int n = snprintf(tmp, sizeof(tmp), "%lld", iv);
        jb_put(b, tmp, (size_t)n);
        return;
    }

    if (strada_is_bool(v)) {
        if (v->value.iv) jb_put(b, "true", 4);
        else jb_put(b, "false", 5);
        return;
    }

    switch (v->type) {
        case STRADA_UNDEF:
            jb_put(b, "null", 4);
            return;
        case STRADA_INT: {
            char tmp[24];
            int n;
            if (STRADA_INT_IS_UV(v))
                n = snprintf(tmp, sizeof(tmp), "%llu", (unsigned long long)(uint64_t)v->value.iv);
            else
                n = snprintf(tmp, sizeof(tmp), "%lld", (long long)v->value.iv);
            jb_put(b, tmp, (size_t)n);
            return;
        }
        case STRADA_NUM: {
            double d = v->value.nv;
            if (isnan(d) || isinf(d)) {
                jb_put(b, "null", 4);
                return;
            }
            char tmp[40];
            int n = snprintf(tmp, sizeof(tmp), "%.15g", d);
            jb_put(b, tmp, (size_t)n);
            return;
        }
        case STRADA_STR: {
            const char *s = v->value.pv ? v->value.pv : "";
            size_t n = STRADA_STR_BYTELEN(v);
            jb_put_escaped(b, s, n);
            return;
        }
        case STRADA_REF: {
            /* Unblessed hash/array/scalar refs become objects/arrays/values. Anything
             * else (incl. blessed objects, matching ref()'s class-name
             * return making JSON::PS take the scalar path) stringifies. */
            int blessed = (v->meta && v->meta->blessed_package) ? 1 : 0;
            if (!blessed) {
                StradaValue *t = strada_is_slot_ref(v)
                    ? (v->value.ptr ? *(StradaValue **)v->value.ptr : NULL)
                    : v->value.rv;
                if (t) {
                    if (!STRADA_IS_TAGGED_INT(t)) {
                        if (t->type == STRADA_HASH) { json_enc_hash(b, t->value.hv, canonical, depth); return; }
                        if (t->type == STRADA_ARRAY) {
                            jb_putc(b, '[');
                            StradaArray *av = t->value.av;
                            size_t n = av ? strada_array_length(av) : 0;
                            for (size_t i = 0; i < n; i++) {
                                if (i) jb_putc(b, ',');
                                json_enc(b, strada_array_get(av, i), canonical, depth + 1);
                            }
                            jb_putc(b, ']');
                            return;
                        }
                    }
                    /* scalar ref (including tagged int): encode the target */
                    json_enc(b, t, canonical, depth + 1);
                    return;
                }
            }
            /* fall through to stringify */
            break;
        }
        case STRADA_HASH:
            json_enc_hash(b, v->value.hv, canonical, depth);
            return;
        case STRADA_ARRAY: {
            jb_putc(b, '[');
            StradaArray *av = v->value.av;
            size_t n = av ? strada_array_length(av) : 0;
            for (size_t i = 0; i < n; i++) {
                if (i) jb_putc(b, ',');
                json_enc(b, strada_array_get(av, i), canonical, depth + 1);
            }
            jb_putc(b, ']');
            return;
        }
        default:
            break;
    }

    /* Scalar fallback: always encode as JSON string. */
    {
        char *s = strada_to_str(v);
        size_t n = s ? strlen(s) : 0;
        jb_put_escaped(b, s ? s : "", n);
        free(s);
    }
}

/* ============================================================
 * Decoder: recursive descent over bytes.
 * ============================================================ */

#ifdef __TINYC__
static char json_last_err_buf[256] = "";
#else
static __thread char json_last_err_buf[256] = "";
#endif

static void jp_clear_err(void) {
    json_last_err_buf[0] = '\0';
}

static void jp_set_err(const char *msg, size_t pos) {
    if (json_last_err_buf[0] == '\0') {
        snprintf(json_last_err_buf, sizeof(json_last_err_buf), "%s at byte %zu", msg, pos);
    }
}

static StradaValue* jp_make_str_sv(const char *s, size_t len) {
    if (!s) return strada_new_str_len("", 0);
    int has_hi = 0;
    for (size_t i = 0; i < len; i++) {
        if ((unsigned char)s[i] >= 0x80) { has_hi = 1; break; }
    }
    if (has_hi && strada_utf8_is_valid(s, len)) {
        return strada_new_str_len_utf8(s, len);
    }
    return strada_new_str_len(s, len);
}

typedef struct {
    const char *s;
    size_t pos, len;
    int err;
} JsonP;

static void jp_ws(JsonP *p) {
    while (p->pos < p->len) {
        char c = p->s[p->pos];
        if (c == ' ' || c == '\t' || c == '\n' || c == '\r') p->pos++;
        else break;
    }
}

static int jp_hex4(JsonP *p) {
    if (p->pos + 4 > p->len) return -1;
    int v = 0;
    for (int i = 0; i < 4; i++) {
        char c = p->s[p->pos++];
        int d;
        if (c >= '0' && c <= '9') d = c - '0';
        else if (c >= 'a' && c <= 'f') d = c - 'a' + 10;
        else if (c >= 'A' && c <= 'F') d = c - 'A' + 10;
        else return -1;
        v = v * 16 + d;
    }
    return v;
}

static void jb_put_utf8(JsonB *b, unsigned int cp) {
    if (cp < 0x80) jb_putc(b, (char)cp);
    else if (cp < 0x800) {
        jb_putc(b, (char)(0xC0 | (cp >> 6)));
        jb_putc(b, (char)(0x80 | (cp & 0x3F)));
    } else if (cp < 0x10000) {
        jb_putc(b, (char)(0xE0 | (cp >> 12)));
        jb_putc(b, (char)(0x80 | ((cp >> 6) & 0x3F)));
        jb_putc(b, (char)(0x80 | (cp & 0x3F)));
    } else {
        jb_putc(b, (char)(0xF0 | (cp >> 18)));
        jb_putc(b, (char)(0x80 | ((cp >> 12) & 0x3F)));
        jb_putc(b, (char)(0x80 | ((cp >> 6) & 0x3F)));
        jb_putc(b, (char)(0x80 | (cp & 0x3F)));
    }
}

/* Parse a JSON string body (opening quote consumed) into a fresh buffer.
 * Returns 1 and fills out/out_len on success (caller frees), 0 on error. */
static int jp_string(JsonP *p, char **out, size_t *out_len) {
    JsonB b = {0};
    while (p->pos < p->len) {
        char c = p->s[p->pos++];
        if (c == '"') {
            if (b.oom) { free(b.buf); return 0; }
            if (!b.buf) { b.buf = malloc(1); if (!b.buf) return 0; }
            b.buf[b.len] = '\0';
            *out = b.buf; *out_len = b.len;
            return 1;
        }
        if (c == '\\') {
            if (p->pos >= p->len) break;
            char e = p->s[p->pos++];
            switch (e) {
                case '"':  jb_putc(&b, '"'); break;
                case '\\': jb_putc(&b, '\\'); break;
                case '/':  jb_putc(&b, '/'); break;
                case 'n':  jb_putc(&b, '\n'); break;
                case 'r':  jb_putc(&b, '\r'); break;
                case 't':  jb_putc(&b, '\t'); break;
                case 'b':  jb_putc(&b, '\b'); break;
                case 'f':  jb_putc(&b, '\f'); break;
                case 'u': {
                    int cp = jp_hex4(p);
                    if (cp < 0) { jp_set_err("Invalid Unicode escape", p->pos); free(b.buf); return 0; }
                    if (cp >= 0xD800 && cp <= 0xDBFF) {
                        if (p->pos + 1 < p->len && p->s[p->pos] == '\\' && p->s[p->pos+1] == 'u') {
                            size_t saved_pos = p->pos;
                            p->pos += 2;
                            int lo = jp_hex4(p);
                            if (lo < 0) { jp_set_err("Invalid Unicode escape", p->pos); free(b.buf); return 0; }
                            if (lo >= 0xDC00 && lo <= 0xDFFF) {
                                cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
                            } else {
                                p->pos = saved_pos;
                                cp = 0xFFFD;
                            }
                        } else {
                            cp = 0xFFFD;
                        }
                    } else if (cp >= 0xDC00 && cp <= 0xDFFF) {
                        cp = 0xFFFD;
                    }
                    jb_put_utf8(&b, (unsigned)cp);
                    break;
                }
                default:
                    /* JSON::PS passes unknown escapes through */
                    jb_putc(&b, e);
                    break;
            }
        } else {
            if ((unsigned char)c < 0x20) {
                jp_set_err("Unescaped control character in JSON string", p->pos);
                free(b.buf);
                return 0;
            }
            jb_putc(&b, c);
        }
    }
    jp_set_err("Unterminated JSON string", p->pos);
    free(b.buf);
    return 0;   /* unterminated */
}

static StradaValue* jp_value(JsonP *p, int depth);

static StradaValue* jp_value(JsonP *p, int depth) {
    if (depth > 512) { jp_set_err("Maximum nesting depth (512) exceeded", p->pos); p->err = 1; return NULL; }
    jp_ws(p);
    if (p->pos >= p->len) { jp_set_err("Unexpected end of JSON input", p->pos); p->err = 1; return NULL; }
    char c = p->s[p->pos];

    if (c == '{') {
        p->pos++;
        StradaValue *hv_sv = strada_new_hash();
        jp_ws(p);
        if (p->pos < p->len && p->s[p->pos] == '}') {
            p->pos++;
            return strada_ref_create_take(hv_sv);
        }
        for (;;) {
            jp_ws(p);
            if (p->pos >= p->len || p->s[p->pos] != '"') { jp_set_err("Expected object key string", p->pos); p->err = 1; break; }
            p->pos++;
            char *key; size_t klen;
            if (!jp_string(p, &key, &klen)) { p->err = 1; break; }
            jp_ws(p);
            if (p->pos >= p->len || p->s[p->pos] != ':') { jp_set_err("Expected ':' after object key", p->pos); free(key); p->err = 1; break; }
            p->pos++;
            StradaValue *val = jp_value(p, depth + 1);
            if (p->err) { free(key); break; }
            StradaValue *ksv = jp_make_str_sv(key, klen);
            StradaValue **slot = strada_hv_fetch_lvalue_sv_key(hv_sv, ksv, 1);
            if (slot) {
                if (*slot) strada_decref(*slot);
                *slot = val ? val : strada_new_undef();
            } else {
                strada_decref(val ? val : strada_new_undef());
            }
            strada_decref(ksv);
            free(key);
            jp_ws(p);
            if (p->pos < p->len && p->s[p->pos] == ',') { p->pos++; continue; }
            if (p->pos < p->len && p->s[p->pos] == '}') { p->pos++; return strada_ref_create_take(hv_sv); }
            jp_set_err("Expected ',' or '}' in object", p->pos);
            p->err = 1; break;
        }
        strada_decref(hv_sv);
        return NULL;
    }

    if (c == '[') {
        p->pos++;
        StradaValue *av_sv = strada_new_array();
        jp_ws(p);
        if (p->pos < p->len && p->s[p->pos] == ']') {
            p->pos++;
            return strada_ref_create_take(av_sv);
        }
        for (;;) {
            StradaValue *val = jp_value(p, depth + 1);
            if (p->err) break;
            strada_array_push_take(av_sv->value.av, val ? val : strada_new_undef());
            jp_ws(p);
            if (p->pos < p->len && p->s[p->pos] == ',') { p->pos++; continue; }
            if (p->pos < p->len && p->s[p->pos] == ']') { p->pos++; return strada_ref_create_take(av_sv); }
            p->err = 1; break;
        }
        strada_decref(av_sv);
        return NULL;
    }

    if (c == '"') {
        p->pos++;
        char *str; size_t slen;
        if (!jp_string(p, &str, &slen)) { p->err = 1; return NULL; }
        StradaValue *sv = jp_make_str_sv(str, slen);
        free(str);
        return sv;
    }

    if (c == 't') {
        if (p->len - p->pos >= 4 && memcmp(p->s + p->pos, "true", 4) == 0) {
            p->pos += 4;
            return strada_new_bool(1);
        }
        jp_set_err("Invalid token (expected 'true')", p->pos);
        p->err = 1; return NULL;
    }
    if (c == 'f') {
        if (p->len - p->pos >= 5 && memcmp(p->s + p->pos, "false", 5) == 0) {
            p->pos += 5;
            return strada_new_bool(0);
        }
        jp_set_err("Invalid token (expected 'false')", p->pos);
        p->err = 1; return NULL;
    }
    if (c == 'n') {
        if (p->len - p->pos >= 4 && memcmp(p->s + p->pos, "null", 4) == 0) {
            p->pos += 4;
            return strada_new_undef();
        }
        jp_set_err("Invalid token (expected 'null')", p->pos);
        p->err = 1; return NULL;
    }

    if (c == '-' || (c >= '0' && c <= '9')) {
        size_t start = p->pos;
        if (c == '-') {
            p->pos++;
            if (p->pos >= p->len || p->s[p->pos] < '0' || p->s[p->pos] > '9') {
                p->err = 1;
                return NULL;
            }
        }
        int is_int = 1;
        if (p->s[p->pos] == '0') {
            p->pos++;
            if (p->pos < p->len && p->s[p->pos] >= '0' && p->s[p->pos] <= '9') {
                p->err = 1;
                return NULL;
            }
        } else {
            while (p->pos < p->len && p->s[p->pos] >= '0' && p->s[p->pos] <= '9') p->pos++;
        }
        if (p->pos < p->len && p->s[p->pos] == '.') {
            is_int = 0;
            p->pos++;
            if (p->pos >= p->len || p->s[p->pos] < '0' || p->s[p->pos] > '9') {
                p->err = 1;
                return NULL;
            }
            while (p->pos < p->len && p->s[p->pos] >= '0' && p->s[p->pos] <= '9') p->pos++;
        }
        if (p->pos < p->len && (p->s[p->pos] == 'e' || p->s[p->pos] == 'E')) {
            is_int = 0;
            p->pos++;
            if (p->pos < p->len && (p->s[p->pos] == '+' || p->s[p->pos] == '-')) p->pos++;
            if (p->pos >= p->len || p->s[p->pos] < '0' || p->s[p->pos] > '9') {
                p->err = 1;
                return NULL;
            }
            while (p->pos < p->len && p->s[p->pos] >= '0' && p->s[p->pos] <= '9') p->pos++;
        }
        size_t n = p->pos - start;
        char tmp[64];
        if (n >= sizeof(tmp)) { is_int = 0; }
        if (is_int && n < sizeof(tmp)) {
            memcpy(tmp, p->s + start, n); tmp[n] = '\0';
            errno = 0;
            long long iv = strtoll(tmp, NULL, 10);
            if (errno == 0) return strada_new_int((int64_t)iv);
        }
        {
            char *big = malloc(n + 1);
            if (!big) { p->err = 1; return NULL; }
            memcpy(big, p->s + start, n); big[n] = '\0';
            double d = strtod(big, NULL);
            free(big);
            return strada_new_num(d);
        }
    }

    p->err = 1;
    return NULL;
}

static StradaValue* strada_json_decode_c(StradaValue *json_sv) {
    jp_clear_err();
    if (!json_sv) {
        jp_set_err("Empty JSON input", 0);
        return strada_new_undef();
    }
    const char *s;
    size_t n;
    char _tb[256];
    if (!STRADA_IS_TAGGED_INT(json_sv) && json_sv->type == STRADA_STR) {
        s = json_sv->value.pv ? json_sv->value.pv : "";
        n = STRADA_STR_BYTELEN(json_sv);
    } else {
        s = strada_to_str_buf(json_sv, _tb, sizeof(_tb));
        n = s ? strlen(s) : 0;
    }
    JsonP p = { s, 0, n, 0 };
    StradaValue *v = jp_value(&p, 0);
    if (!p.err) {
        jp_ws(&p);
        if (p.pos != p.len) {
            jp_set_err("Trailing characters after JSON value", p.pos);
            p.err = 1;
        }
    } else {
        jp_set_err("Invalid JSON value", p.pos);
    }
    if (p.err) {
        if (v) strada_decref(v);
        return strada_new_undef();
    }
    return v ? v : strada_new_undef();
}

static StradaValue* strada_json_encode_c(StradaValue *v, int canonical) {
    JsonB b = {0};
    json_enc(&b, v, canonical, 0);
    if (b.oom) { free(b.buf); return strada_new_str(""); }
    StradaValue *out = jp_make_str_sv(b.buf ? b.buf : "", b.len);
    free(b.buf);
    return out;
}
}

# Return a JSON boolean true value (distinct from integer 1 via is_bool()).
func true() scalar {
    my scalar $v = undef;
    __C__ {
        strada_decref(v);
        v = strada_new_bool(1);
    }
    return $v;
}

# Return a JSON boolean false value (distinct from integer 0 via is_bool()).
func false() scalar {
    my scalar $v = undef;
    __C__ {
        strada_decref(v);
        v = strada_new_bool(0);
    }
    return $v;
}

# Return 1 if $value is a JSON boolean returned by true(), false(), or decode().
func is_bool(scalar $value) int {
    my int $b = 0;
    __C__ {
        strada_decref(b);
        b = strada_new_int(strada_is_bool(value) ? 1 : 0);
    }
    return $b;
}

# Return last parse error description from decode() / decode_strict(), or "".
func last_error() str {
    my str $err = "";
    __C__ {
        strada_decref(err);
        err = strada_new_str(json_last_err_buf);
    }
    return $err;
}

# Encode a Strada data structure to a JSON string.
func encode(scalar $value) str {
    my str $out = "";
    __C__ {
        strada_decref(out);
        out = strada_json_encode_c(value, 0);
    }
    return $out;
}

# Encode with options. Supports "canonical" (sort object keys).
func encode_opts(scalar $value, scalar $options) str {
    my int $canonical = 0;
    if (defined($options)) {
        if (defined($options->{"canonical"})) {
            $canonical = $options->{"canonical"};
        }
    }
    my str $out = "";
    __C__ {
        strada_decref(out);
        out = strada_json_encode_c(value, (int)strada_to_int(canonical));
    }
    return $out;
}

# Decode a JSON string. Returns undef for invalid JSON.
func decode(str $json) scalar {
    my scalar $result = undef;
    __C__ {
        strada_decref(result);
        result = strada_json_decode_c(json);
    }
    return $result;
}

# Decode a JSON string strictly, throwing on parse errors (while returning undef for "null").
func decode_strict(str $json) scalar {
    my scalar $result = JSON::decode($json);
    my str $err = JSON::last_error();
    if ($err ne "") {
        die("JSON decode error: " . $err);
    }
    return $result;
}

# ============================================================
# Documented helpers, kept API-compatible with JSON::PS.
# ============================================================

# Escape a string for JSON output.
func escape_str(str $s) str {
    my str $hex = "0123456789abcdef";
    my str $result = "";
    my int $len = core::byte_length($s);
    my int $i = 0;
    while ($i < $len) {
        my int $b = core::get_byte($s, $i);
        if ($b == 34) {
            $result = $result . "\\\"";
        } elsif ($b == 92) {
            $result = $result . "\\\\";
        } elsif ($b == 8) {
            $result = $result . "\\b";
        } elsif ($b == 12) {
            $result = $result . "\\f";
        } elsif ($b == 10) {
            $result = $result . "\\n";
        } elsif ($b == 13) {
            $result = $result . "\\r";
        } elsif ($b == 9) {
            $result = $result . "\\t";
        } elsif ($b < 32) {
            my int $hi = ($b / 16) % 16;
            my int $lo = $b % 16;
            $result = $result . "\\u00" . substr($hex, $hi, 1) . substr($hex, $lo, 1);
        } else {
            my int $start = $i;
            $i = $i + 1;
            while ($i < $len) {
                my int $nb = core::get_byte($s, $i);
                if ($nb == 34 || $nb == 92 || $nb < 32) {
                    last;
                }
                $i = $i + 1;
            }
            $result = $result . core::byte_substr($s, $start, $i - $start);
            next;
        }
        $i = $i + 1;
    }
    return $result;
}

# Check if a string strictly matches RFC 8259 JSON number syntax.
func looks_like_num(str $s) int {
    my int $len = core::byte_length($s);
    if ($len == 0) {
        return 0;
    }
    my int $i = 0;
    my int $b = core::get_byte($s, 0);
    if ($b == 45) {
        $i = 1;
        if ($i >= $len) {
            return 0;
        }
        $b = core::get_byte($s, $i);
    }
    if ($b == 48) {
        $i = $i + 1;
        if ($i < $len) {
            my int $nb = core::get_byte($s, $i);
            if ($nb >= 48 && $nb <= 57) {
                return 0;
            }
        }
    } elsif ($b >= 49 && $b <= 57) {
        $i = $i + 1;
        while ($i < $len) {
            my int $nb = core::get_byte($s, $i);
            if ($nb < 48 || $nb > 57) {
                last;
            }
            $i = $i + 1;
        }
    } else {
        return 0;
    }
    if ($i < $len && core::get_byte($s, $i) == 46) {
        $i = $i + 1;
        if ($i >= $len) {
            return 0;
        }
        my int $fb = core::get_byte($s, $i);
        if ($fb < 48 || $fb > 57) {
            return 0;
        }
        while ($i < $len) {
            my int $nb = core::get_byte($s, $i);
            if ($nb < 48 || $nb > 57) {
                last;
            }
            $i = $i + 1;
        }
    }
    if ($i < $len) {
        my int $eb = core::get_byte($s, $i);
        if ($eb == 101 || $eb == 69) {
            $i = $i + 1;
            if ($i < $len) {
                my int $sb = core::get_byte($s, $i);
                if ($sb == 43 || $sb == 45) {
                    $i = $i + 1;
                }
            }
            if ($i >= $len) {
                return 0;
            }
            my int $db = core::get_byte($s, $i);
            if ($db < 48 || $db > 57) {
                return 0;
            }
            while ($i < $len) {
                my int $nb = core::get_byte($s, $i);
                if ($nb < 48 || $nb > 57) {
                    last;
                }
                $i = $i + 1;
            }
        }
    }
    return ($i == $len) ? 1 : 0;
}
