=head1 NAME

JSON::PS - pure-Strada JSON encoding and decoding for Strada

=head1 SYNOPSIS

    use lib "lib";
    use JSON::PS;

    # Encode Strada data to JSON
    my str $json = JSON::PS::encode(\%data);

    # Encode with sorted keys (canonical)
    my str $json_sorted = JSON::PS::encode_opts(\%data, { "canonical" => 1 });

    # Decode JSON to Strada data structure
    my scalar $data = JSON::PS::decode($json);

=head1 DESCRIPTION

JSON provides functions for encoding Strada data structures (hashes, arrays,
scalars) to JSON strings and decoding JSON strings back to Strada data.

The encoder handles:

=over 4

=item * Hash references -> JSON objects

=item * Array references -> JSON arrays

=item * Strings -> JSON strings (with proper escaping)

=item * Numbers -> JSON numbers

=item * C<undef> -> JSON null

=back

=head1 FUNCTIONS

=head2 encode($data)

Encode a Strada data structure to a JSON string.

    my hash %user = ();
    $user{"name"} = "Alice";
    $user{"age"} = 30;
    my str $json = JSON::PS::encode(\%user);
    # {"name":"Alice","age":30}

=head2 encode_opts($data, $options)

Encode with options. Currently supports:

=over 4

=item B<canonical> - Sort hash keys alphabetically for deterministic output

=back

    my str $json = JSON::PS::encode_opts(\%data, { "canonical" => 1 });

=head2 decode($json)

Decode a JSON string to a Strada data structure.

    my str $json = '{"name":"Bob","scores":[85,90,78]}';
    my scalar $data = JSON::PS::decode($json);
    say($data->{"name"});           # Bob
    say($data->{"scores"}->[0]);    # 85

Returns C<undef> for invalid JSON.

=head1 HELPER FUNCTIONS

=head2 escape_str($s)

Escape a string for JSON output (handles quotes, backslashes, newlines, etc.)

=head2 looks_like_num($s)

Check if a string looks like a number.

=head1 EXAMPLE

    use lib "lib";
    use JSON::PS;

    # Build a complex structure
    my hash %config = ();
    $config{"debug"} = 1;
    $config{"servers"} = ["web1", "web2", "web3"];
    $config{"database"} = { "host" => "localhost", "port" => 5432 };

    # Encode to JSON
    my str $json = JSON::PS::encode(\%config);
    say($json);

    # Decode back
    my scalar $parsed = JSON::PS::decode($json);
    say($parsed->{"database"}->{"host"});  # localhost

=head1 SEE ALSO

L<YAML>

=cut

package JSON::PS;
version "1.0.0";

our str $g_last_error = "";

# Return a JSON boolean true value (distinct from integer 1 via is_bool()).
func true() scalar {
    my scalar $v = undef;
    __C__ {
        strada_decref(v);
        v = strada_new_bool(1);
    }
    return $v;
}

# Return a JSON boolean false value (distinct from integer 0 via is_bool()).
func false() scalar {
    my scalar $v = undef;
    __C__ {
        strada_decref(v);
        v = strada_new_bool(0);
    }
    return $v;
}

# Return 1 if $value is a JSON boolean returned by true(), false(), or decode().
func is_bool(scalar $value) int {
    my int $b = 0;
    __C__ {
        strada_decref(b);
        b = strada_new_int(strada_is_bool(value) ? 1 : 0);
    }
    return $b;
}

# Return last parse error description from decode() / decode_strict(), or "".
func last_error() str {
    return $g_last_error;
}

# ============================================================
# JSON Encoding
# ============================================================

# Escape a string for JSON output
func escape_str(str $s) str {
    my str $hex = "0123456789abcdef";
    my str $result = "";
    my int $len = core::byte_length($s);
    my int $i = 0;

    while ($i < $len) {
        my int $b = core::get_byte($s, $i);

        if ($b == 34) {
            $result = $result . "\\\"";
        } elsif ($b == 92) {
            $result = $result . "\\\\";
        } elsif ($b == 8) {
            $result = $result . "\\b";
        } elsif ($b == 12) {
            $result = $result . "\\f";
        } elsif ($b == 10) {
            $result = $result . "\\n";
        } elsif ($b == 13) {
            $result = $result . "\\r";
        } elsif ($b == 9) {
            $result = $result . "\\t";
        } elsif ($b < 32) {
            my int $hi = ($b / 16) % 16;
            my int $lo = $b % 16;
            $result = $result . "\\u00" . substr($hex, $hi, 1) . substr($hex, $lo, 1);
        } else {
            my int $start = $i;
            $i = $i + 1;
            while ($i < $len) {
                my int $nb = core::get_byte($s, $i);
                if ($nb == 34 || $nb == 92 || $nb < 32) {
                    last;
                }
                $i = $i + 1;
            }
            $result = $result . core::byte_substr($s, $start, $i - $start);
            next;
        }

        $i = $i + 1;
    }

    return $result;
}

# Check if a string strictly matches RFC 8259 JSON number syntax
func looks_like_num(str $s) int {
    my int $len = core::byte_length($s);
    if ($len == 0) {
        return 0;
    }
    my int $i = 0;
    my int $b = core::get_byte($s, 0);
    if ($b == 45) {
        $i = 1;
        if ($i >= $len) {
            return 0;
        }
        $b = core::get_byte($s, $i);
    }
    if ($b == 48) {
        $i = $i + 1;
        if ($i < $len) {
            my int $nb = core::get_byte($s, $i);
            if ($nb >= 48 && $nb <= 57) {
                return 0;
            }
        }
    } elsif ($b >= 49 && $b <= 57) {
        $i = $i + 1;
        while ($i < $len) {
            my int $nb = core::get_byte($s, $i);
            if ($nb < 48 || $nb > 57) {
                last;
            }
            $i = $i + 1;
        }
    } else {
        return 0;
    }
    if ($i < $len && core::get_byte($s, $i) == 46) {
        $i = $i + 1;
        if ($i >= $len) {
            return 0;
        }
        my int $fb = core::get_byte($s, $i);
        if ($fb < 48 || $fb > 57) {
            return 0;
        }
        while ($i < $len) {
            my int $nb = core::get_byte($s, $i);
            if ($nb < 48 || $nb > 57) {
                last;
            }
            $i = $i + 1;
        }
    }
    if ($i < $len) {
        my int $eb = core::get_byte($s, $i);
        if ($eb == 101 || $eb == 69) {
            $i = $i + 1;
            if ($i < $len) {
                my int $sb = core::get_byte($s, $i);
                if ($sb == 43 || $sb == 45) {
                    $i = $i + 1;
                }
            }
            if ($i >= $len) {
                return 0;
            }
            my int $db = core::get_byte($s, $i);
            if ($db < 48 || $db > 57) {
                return 0;
            }
            while ($i < $len) {
                my int $nb = core::get_byte($s, $i);
                if ($nb < 48 || $nb > 57) {
                    last;
                }
                $i = $i + 1;
            }
        }
    }
    return ($i == $len) ? 1 : 0;
}

# Encode any value to JSON
func do_encode(scalar $value, int $canonical, int $depth) str {
    # Prevent infinite recursion
    if ($depth > 512) {
        return "null";
    }

    # Handle undef -> null
    if (!defined($value)) {
        return "null";
    }

    if (JSON::PS::is_bool($value)) {
        return $value ? "true" : "false";
    }

    # Check what type of reference it is
    my str $rtype = ref($value);

    if ($rtype eq "HASH") {
        # Hash reference
        my str $result = "{";
        my array @k = keys($value);
        my int $len = size(@k);

        if ($canonical) {
            @k = sort(@k);
        }

        my int $i = 0;
        while ($i < $len) {
            if ($i > 0) {
                $result = $result . ",";
            }
            my str $key = $k[$i];
            $result = $result . "\"" . JSON::PS::escape_str($key) . "\":";
            $result = $result . JSON::PS::do_encode($value->{$key}, $canonical, $depth + 1);
            $i = $i + 1;
        }
        return $result . "}";
    }

    if ($rtype eq "ARRAY") {
        # Array reference
        my str $result = "[";
        my int $len = size($value);
        my int $i = 0;

        while ($i < $len) {
            if ($i > 0) {
                $result = $result . ",";
            }
            $result = $result . JSON::PS::do_encode($value->[$i], $canonical, $depth + 1);
            $i = $i + 1;
        }
        return $result . "]";
    }

    if ($rtype eq "REF") {
        # Scalar reference - dereference and encode
        return JSON::PS::do_encode(deref($value), $canonical, $depth + 1);
    }

    # Non-reference: preserve dynamic type (int/num vs str) per RFC 8259
    my str $vt = typeof($value);
    if ($vt eq "int") {
        return "" . $value;
    }
    if ($vt eq "num") {
        my str $num_str = "" . $value;
        if ($num_str eq "NaN" || $num_str eq "Inf" || $num_str eq "-Inf" ||
            $num_str eq "nan" || $num_str eq "inf" || $num_str eq "-inf") {
            return "null";
        }
        return $num_str;
    }

    # String or fallback: always encode as JSON string
    return "\"" . JSON::PS::escape_str("" . $value) . "\"";
}

# Public encode function - simple version
func encode(scalar $value) str {
    return JSON::PS::do_encode($value, 0, 0);
}

# Public encode function with options
func encode_opts(scalar $value, scalar $options) str {
    my int $canonical = 0;

    if (defined($options)) {
        if (defined($options->{"canonical"})) {
            $canonical = $options->{"canonical"};
        }
    }

    return JSON::PS::do_encode($value, $canonical, 0);
}

# ============================================================
# JSON Decoding
# ============================================================

# Parser state
func make_parser(str $json) scalar {
    return {
        "json" => $json,
        "pos" => 0,
        "len" => length($json),
        "err" => 0
    };
}

# Get current character without advancing
func peek(scalar $p) str {
    if ($p->{"pos"} >= $p->{"len"}) {
        return "";
    }
    return substr($p->{"json"}, $p->{"pos"}, 1);
}

# Get current character and advance
func advance(scalar $p) str {
    if ($p->{"pos"} >= $p->{"len"}) {
        return "";
    }
    my str $ch = substr($p->{"json"}, $p->{"pos"}, 1);
    $p->{"pos"} = $p->{"pos"} + 1;
    return $ch;
}

# Skip whitespace
func skip_ws(scalar $p) void {
    while ($p->{"pos"} < $p->{"len"}) {
        my str $ch = JSON::PS::peek($p);
        if ($ch eq " " || $ch eq "\t" || $ch eq "\n" || $ch eq "\r") {
            JSON::PS::advance($p);
        } else {
            return;
        }
    }
}

# Parse a JSON string
func parse_str(scalar $p) str {
    my str $result = "";

    # Skip opening quote
    JSON::PS::advance($p);

    while ($p->{"pos"} < $p->{"len"}) {
        my str $ch = JSON::PS::advance($p);

        if ($ch eq "\"") {
            my int $blen = core::byte_length($result);
            my int $bi = 0;
            my int $has_hi = 0;
            while ($bi < $blen) {
                if (core::get_byte($result, $bi) >= 128) {
                    $has_hi = 1;
                    last;
                }
                $bi = $bi + 1;
            }
            if ($has_hi && utf8::valid($result)) {
                utf8::decode($result);
            }
            return $result;
        }

        if ($ch eq "\\") {
            if ($p->{"pos"} >= $p->{"len"}) {
                $p->{"err"} = 1;
                $p->{"err_msg"} = "Unterminated escape in JSON string at char " . $p->{"pos"};
                return "";
            }
            my str $escaped = JSON::PS::advance($p);
            if ($escaped eq "\"") {
                $result = $result . "\"";
            } elsif ($escaped eq "\\") {
                $result = $result . "\\";
            } elsif ($escaped eq "/") {
                $result = $result . "/";
            } elsif ($escaped eq "n") {
                $result = $result . "\n";
            } elsif ($escaped eq "r") {
                $result = $result . "\r";
            } elsif ($escaped eq "t") {
                $result = $result . "\t";
            } elsif ($escaped eq "b") {
                $result = $result . core::byte(8);
            } elsif ($escaped eq "f") {
                $result = $result . core::byte(12);
            } elsif ($escaped eq "u") {
                # \uXXXX escape (with surrogate-pair handling) -> UTF-8
                my int $cp = JSON::PS::parse_hex4($p);
                if ($cp < 0) {
                    $p->{"err"} = 1;
                    $p->{"err_msg"} = "Invalid Unicode escape at char " . $p->{"pos"};
                    return "";
                }
                if ($cp >= 55296 && $cp <= 56319) {
                    # high surrogate: expect \uDC00-\uDFFF
                    if ($p->{"pos"} + 1 < $p->{"len"} && substr($p->{"json"}, $p->{"pos"}, 2) eq "\\u") {
                        my int $saved_pos = $p->{"pos"};
                        $p->{"pos"} = $p->{"pos"} + 2;
                        my int $lo = JSON::PS::parse_hex4($p);
                        if ($lo < 0) {
                            $p->{"err"} = 1;
                            $p->{"err_msg"} = "Invalid Unicode escape at char " . $p->{"pos"};
                            return "";
                        }
                        if ($lo >= 56320 && $lo <= 57343) {
                            $cp = 65536 + (($cp - 55296) * 1024) + ($lo - 56320);
                        } else {
                            $p->{"pos"} = $saved_pos;
                            $cp = 65533;
                        }
                    } else {
                        $cp = 65533;
                    }
                } elsif ($cp >= 56320 && $cp <= 57343) {
                    $cp = 65533;
                }
                if ($cp == 0) {
                    $result = $result . core::byte(0);
                } else {
                    $result = $result . chr($cp);
                }
            } else {
                $result = $result . $escaped;
            }
        } else {
            $result = $result . $ch;
        }
    }

    $p->{"err"} = 1;
    $p->{"err_msg"} = "Unterminated JSON string at char " . $p->{"pos"};
    return "";
}

# Read exactly four hex digits at the parser position; returns the code
# unit value, or -1 on malformed input (position still advances past what
# was consumed).
func parse_hex4(scalar $p) int {
    my int $v = 0;
    my int $i = 0;
    while ($i < 4) {
        if ($p->{"pos"} >= $p->{"len"}) {
            return -1;
        }
        my str $ch = JSON::PS::advance($p);
        my int $c = ord($ch);
        if ($c >= ord("0") && $c <= ord("9")) {
            $v = $v * 16 + ($c - ord("0"));
        } elsif ($c >= ord("a") && $c <= ord("f")) {
            $v = $v * 16 + ($c - ord("a") + 10);
        } elsif ($c >= ord("A") && $c <= ord("F")) {
            $v = $v * 16 + ($c - ord("A") + 10);
        } else {
            return -1;
        }
        $i = $i + 1;
    }
    return $v;
}

# Check if character is a digit
func is_digit(str $ch) int {
    return ($ch ne "" && $ch ge "0" && $ch le "9") ? 1 : 0;
}

# Parse a JSON number
func parse_num(scalar $p) scalar {
    my str $num_str = "";

    # Handle negative
    if (JSON::PS::peek($p) eq "-") {
        $num_str = $num_str . JSON::PS::advance($p);
        if (!JSON::PS::is_digit(JSON::PS::peek($p))) {
            $p->{"err"} = 1;
            return undef;
        }
    }

    # Integer part: 0 or [1-9][0-9]*
    if (JSON::PS::peek($p) eq "0") {
        $num_str = $num_str . JSON::PS::advance($p);
        if (JSON::PS::is_digit(JSON::PS::peek($p))) {
            $p->{"err"} = 1;
            return undef;
        }
    } elsif (JSON::PS::is_digit(JSON::PS::peek($p))) {
        while ($p->{"pos"} < $p->{"len"} && JSON::PS::is_digit(JSON::PS::peek($p))) {
            $num_str = $num_str . JSON::PS::advance($p);
        }
    } else {
        $p->{"err"} = 1;
        return undef;
    }

    # Decimal part
    if (JSON::PS::peek($p) eq ".") {
        $num_str = $num_str . JSON::PS::advance($p);
        if (!JSON::PS::is_digit(JSON::PS::peek($p))) {
            $p->{"err"} = 1;
            return undef;
        }
        while ($p->{"pos"} < $p->{"len"} && JSON::PS::is_digit(JSON::PS::peek($p))) {
            $num_str = $num_str . JSON::PS::advance($p);
        }
    }

    # Exponent part
    my str $ch = JSON::PS::peek($p);
    if ($ch eq "e" || $ch eq "E") {
        $num_str = $num_str . JSON::PS::advance($p);
        $ch = JSON::PS::peek($p);
        if ($ch eq "+" || $ch eq "-") {
            $num_str = $num_str . JSON::PS::advance($p);
        }
        if (!JSON::PS::is_digit(JSON::PS::peek($p))) {
            $p->{"err"} = 1;
            return undef;
        }
        while ($p->{"pos"} < $p->{"len"} && JSON::PS::is_digit(JSON::PS::peek($p))) {
            $num_str = $num_str . JSON::PS::advance($p);
        }
    }

    return $num_str + 0;
}

# Check if string matches keyword at current position
func match_kw(scalar $p, str $keyword) int {
    my int $klen = length($keyword);
    my int $pos = $p->{"pos"};

    if ($pos + $klen > $p->{"len"}) {
        return 0;
    }

    my str $sub = substr($p->{"json"}, $pos, $klen);
    if ($sub eq $keyword) {
        $p->{"pos"} = $pos + $klen;
        return 1;
    }

    return 0;
}

# Parse any JSON value (recursive)
func do_parse(scalar $p, int $depth) scalar {
    if ($depth > 512) {
        $p->{"err"} = 1;
        $p->{"err_msg"} = "Maximum nesting depth (512) exceeded at char " . $p->{"pos"};
        return undef;
    }

    JSON::PS::skip_ws($p);

    if ($p->{"pos"} >= $p->{"len"}) {
        $p->{"err"} = 1;
        $p->{"err_msg"} = "Unexpected end of JSON input at char " . $p->{"pos"};
        return undef;
    }

    my str $ch = JSON::PS::peek($p);

    # String
    if ($ch eq "\"") {
        my str $s = JSON::PS::parse_str($p);
        if ($p->{"err"}) {
            return undef;
        }
        return $s;
    }

    # Array - return as array reference
    if ($ch eq "[") {
        JSON::PS::advance($p);
        JSON::PS::skip_ws($p);

        my scalar $result = [];

        if ($p->{"pos"} < $p->{"len"} && JSON::PS::peek($p) eq "]") {
            JSON::PS::advance($p);
            return $result;
        }

        while (1) {
            JSON::PS::skip_ws($p);
            my scalar $val = JSON::PS::do_parse($p, $depth + 1);
            if ($p->{"err"}) {
                return undef;
            }
            push($result, $val);

            JSON::PS::skip_ws($p);
            if ($p->{"pos"} >= $p->{"len"}) {
                $p->{"err"} = 1;
                return undef;
            }
            $ch = JSON::PS::peek($p);

            if ($ch eq "]") {
                JSON::PS::advance($p);
                return $result;
            }

            if ($ch eq ",") {
                JSON::PS::advance($p);
            } else {
                $p->{"err"} = 1;
                return undef;
            }
        }
    }

    # Object - return as hash reference
    if ($ch eq "{") {
        JSON::PS::advance($p);
        JSON::PS::skip_ws($p);

        my scalar $result = {};

        if ($p->{"pos"} < $p->{"len"} && JSON::PS::peek($p) eq "}") {
            JSON::PS::advance($p);
            return $result;
        }

        while (1) {
            JSON::PS::skip_ws($p);

            if ($p->{"pos"} >= $p->{"len"} || JSON::PS::peek($p) ne "\"") {
                $p->{"err"} = 1;
                return undef;
            }
            my str $key = JSON::PS::parse_str($p);
            if ($p->{"err"}) {
                return undef;
            }

            JSON::PS::skip_ws($p);

            if ($p->{"pos"} >= $p->{"len"} || JSON::PS::peek($p) ne ":") {
                $p->{"err"} = 1;
                return undef;
            }
            JSON::PS::advance($p);

            JSON::PS::skip_ws($p);

            my scalar $val = JSON::PS::do_parse($p, $depth + 1);
            if ($p->{"err"}) {
                return undef;
            }
            $result->{$key} = $val;

            JSON::PS::skip_ws($p);
            if ($p->{"pos"} >= $p->{"len"}) {
                $p->{"err"} = 1;
                return undef;
            }
            $ch = JSON::PS::peek($p);

            if ($ch eq "}") {
                JSON::PS::advance($p);
                return $result;
            }

            if ($ch eq ",") {
                JSON::PS::advance($p);
            } else {
                $p->{"err"} = 1;
                return undef;
            }
        }
    }

    # Number
    if ($ch eq "-" || JSON::PS::is_digit($ch)) {
        return JSON::PS::parse_num($p);
    }

    # Keywords
    if (JSON::PS::match_kw($p, "true")) {
        return JSON::PS::true();
    }

    if (JSON::PS::match_kw($p, "false")) {
        return JSON::PS::false();
    }

    if (JSON::PS::match_kw($p, "null")) {
        return undef;
    }

    $p->{"err"} = 1;
    $p->{"err_msg"} = "Invalid JSON value at char " . $p->{"pos"};
    return undef;
}

# Public decode function
func decode(str $json) scalar {
    $g_last_error = "";
    my scalar $p = JSON::PS::make_parser($json);
    my scalar $res = JSON::PS::do_parse($p, 0);
    if ($p->{"err"}) {
        if (defined($p->{"err_msg"}) && $p->{"err_msg"} ne "") {
            $g_last_error = $p->{"err_msg"};
        } else {
            $g_last_error = "Invalid JSON value at char " . $p->{"pos"};
        }
        return undef;
    }
    JSON::PS::skip_ws($p);
    if ($p->{"pos"} != $p->{"len"}) {
        $g_last_error = "Trailing characters after JSON value at char " . $p->{"pos"};
        return undef;
    }
    return $res;
}

# Decode a JSON string strictly, throwing on parse errors (while returning undef for "null")
func decode_strict(str $json) scalar {
    my scalar $res = JSON::PS::decode($json);
    if ($g_last_error ne "") {
        die("JSON decode error: " . $g_last_error);
    }
    return $res;
}
