=head1 NAME

Net::SMTP - SMTP client library for Strada

=head1 SYNOPSIS

    use lib "lib";
    use Net::SMTP;

    my scalar $smtp = SMTP::new("smtp.example.com", 587);
    $smtp->ehlo("mydomain.com");
    $smtp->auth("user", "password");

    my array @to = ("recipient@example.com");
    $smtp->send_mail("sender@example.com", \@to, "Subject", "Body text");
    $smtp->quit();

=head1 DESCRIPTION

Net::SMTP provides an SMTP client for sending emails. It supports:

=over 4

=item * Plain TCP connections (ports 25, 587)

=item * AUTH LOGIN and AUTH PLAIN authentication

=item * Multiple recipients

=item * Debug mode for troubleshooting

=back

B<Note:> For TLS (STARTTLS on 587, or implicit TLS on 465) use
L<Net::SMTP_SSL>, which needs the ssl module.

=head1 CONSTRUCTOR

=head2 new($host, $port)

Create SMTP connection. Returns blessed object or undef on failure.

    my scalar $smtp = SMTP::new("smtp.gmail.com", 587);

=head1 METHODS

=head2 debug($on)

Enable/disable debug output (prints SMTP conversation).

    $smtp->debug(1);

=head2 helo($domain)

Send HELO command (simple greeting).

    $smtp->helo("mydomain.com");

=head2 ehlo($domain)

Send EHLO command (extended greeting). Returns server capabilities.

    $smtp->ehlo("mydomain.com");

=head2 auth($username, $password)

Authenticate using AUTH LOGIN mechanism.

    if ($smtp->auth("user", "pass")) {
        say("Authenticated!");
    }

=head2 auth_plain($username, $password)

Authenticate using AUTH PLAIN mechanism.

=head2 starttls()

Send STARTTLS command. Net::SMTP_SSL::starttls() sends it and does the
TLS handshake.

=head2 supports($ext)

Whether the last EHLO advertised an extension ("STARTTLS", "AUTH", ...).

=head2 send_message($from, $to_list, $message)

Send a message that already has its headers.

=head2 set_timeout($seconds)

Give up on a server that stops answering (default 30 seconds).

=head2 set_max_line($bytes)

Longest reply line accepted from the server (default 8192 bytes; RFC 5321
limits reply lines to 512). A longer line, or a multi-line reply of more
than 1000 lines, is treated as a broken connection: the connection is
closed and C<code()> returns 0. Returns the previous limit.

=head2 mail($from)

Set sender (MAIL FROM command).

    $smtp->mail("sender@example.com");

=head2 rcpt_to($recipient)

Add recipient (RCPT TO command). Call multiple times for multiple recipients.

    $smtp->rcpt_to("user1@example.com");
    $smtp->rcpt_to("user2@example.com");

=head2 data($message)

Send message body. Include headers and body separated by blank line.

    my str $msg = "Subject: Hello\r\n\r\nMessage body here.";
    $smtp->data($msg);

=head2 send_mail($from, $to_list, $subject, $body)

Convenience method to send a complete email.

    my array @recipients = ("user@example.com");
    $smtp->send_mail("me@example.com", \@recipients, "Subject", "Body text");

=head2 reset()

Reset session (RSET command).

=head2 noop()

No-op command (keep-alive).

=head2 verify($address)

Verify an email address (VRFY command).

=head2 quit()

Close connection (QUIT command).

=head2 code()

Get last response code.

=head2 message()

Get last response message.

=head1 EXAMPLE

    use lib "lib";
    use Net::SMTP;

    my scalar $smtp = SMTP::new("smtp.example.com", 587);
    if (!defined($smtp)) {
        die("Could not connect to SMTP server");
    }

    $smtp->debug(1);  # Show conversation

    if (!$smtp->ehlo("mydomain.com")) {
        die("EHLO failed");
    }

    if (!$smtp->auth("username", "password")) {
        die("Authentication failed");
    }

    my array @to = ("recipient@example.com", "another@example.com");
    if (!$smtp->send_mail("sender@example.com", \@to,
                          "Test Subject", "This is the body.")) {
        die("Failed to send: " . $smtp->message());
    }

    $smtp->quit();
    say("Email sent successfully!");

=head1 SEE ALSO

L<ssl>, L<LWP>

=cut

package SMTP;

__C__ {
#include <sys/socket.h>
#include <sys/time.h>
}

# Create new SMTP connection
# Returns blessed hash reference or undef on failure
func new(str $host, int $port) scalar {
    my scalar $obj = SMTP::make($host, $port);
    my scalar $sock = core::socket_client($host, $port);
    if (!defined($sock)) { return undef; }
    $obj->{"socket"} = $sock;
    SMTP::set_timeout($obj, 30);
    if (!SMTP::greeting($obj)) { SMTP::close($obj); return undef; }
    return $obj;
}

# An unconnected client (Net::SMTP_SSL connects it over TLS itself).
func make(str $host, int $port) scalar {
    my hash %self = ();
    $self{"host"} = $host;
    $self{"port"} = $port;
    $self{"socket"} = undef;
    $self{"debug"} = 0;
    $self{"last_code"} = 0;
    $self{"last_response"} = "";
    $self{"buf"} = "";
    $self{"timeout"} = 30;
    $self{"max_line"} = 8192;   # longest reply line accepted (set_max_line)
    # set by Net::SMTP_SSL once the connection is encrypted
    $self{"send_fn"} = undef;
    $self{"recv_fn"} = undef;
    return bless(\%self, "SMTP");
}

# Read the server's 220 greeting; closes the connection if it isn't one.
func greeting(scalar $self) int {
    SMTP::recv_response($self);
    if ($self->{"last_code"} != 220) {
        SMTP::close($self);
        return 0;
    }
    return 1;
}

# Give up on a server that stops answering (seconds, for reads and writes).
func set_timeout(scalar $self, int $seconds) void {
    $self->{"timeout"} = $seconds;
    if (!defined($self->{"socket"})) { return; }
    my int $fd = core::socket_fd($self->{"socket"});
    __C__ {
        struct timeval tv;
        tv.tv_sec = (long)strada_to_int(seconds);
        tv.tv_usec = 0;
        int sfd = (int)strada_to_int(fd);
        setsockopt(sfd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
        setsockopt(sfd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
    }
}

# Longest reply line accepted from the server, in bytes (default 8192).
# Returns the previous limit. Values <= 0 are ignored.
func set_max_line(scalar $self, int $bytes) int {
    my int $prev = $self->{"max_line"};
    if ($bytes > 0) { $self->{"max_line"} = $bytes; }
    return $prev;
}

# Enable debug mode (prints SMTP conversation)
func debug(scalar $self, int $on) void {
    $self->{"debug"} = $on;
}

# Internal: write raw bytes (over TLS once Net::SMTP_SSL has upgraded)
func send_raw(scalar $self, str $data) int {
    my scalar $fn = $self->{"send_fn"};
    if (defined($fn)) { return $fn->($data); }
    my scalar $sock = $self->{"socket"};
    if (!defined($sock)) { return 0; }
    my int $total = core::byte_length($data);
    my int $sent = 0;
    while ($sent < $total) {
        my str $slice = ($sent == 0) ? $data : core::byte_substr($data, $sent, $total - $sent);
        my int $n = core::socket_send($sock, $slice);
        if ($n <= 0) {
            return $sent > 0 ? $sent : -1;
        }
        $sent = $sent + $n;
    }
    return $sent;
}

# Internal: read some bytes ("" when the connection closed or timed out)
func recv_raw(scalar $self) str {
    my scalar $fn = $self->{"recv_fn"};
    if (defined($fn)) { return $fn->(4096); }
    if (!defined($self->{"socket"})) { return ""; }
    my str $chunk = core::socket_recv($self->{"socket"}, 4096);
    if (!defined($chunk)) { return ""; }
    return $chunk;
}

# Internal: send command to server
func send_cmd(scalar $self, str $cmd) int {
    if ($self->{"debug"} == 1) {
        say("C: " . $cmd);
    }
    return SMTP::send_raw($self, $cmd . "\r\n");
}

# Internal: one line from the server, without its line ending (undef at EOF,
# or when the server sends a line longer than max_line: the connection is
# closed rather than buffering without limit).
func read_line(scalar $self) scalar {
    my int $max = $self->{"max_line"};
    while (core::byte_index($self->{"buf"}, "\n") < 0) {
        if ($max > 0 && core::byte_length($self->{"buf"}) > $max + 1) {
            SMTP::_line_too_long($self);
            return undef;
        }
        my str $chunk = SMTP::recv_raw($self);
        if (core::byte_length($chunk) == 0) {
            if (core::byte_length($self->{"buf"}) == 0) { return undef; }
            my str $rest = $self->{"buf"};
            $self->{"buf"} = "";
            return $rest;
        }
        $self->{"buf"} = $self->{"buf"} . $chunk;
    }
    my str $b = $self->{"buf"};
    my int $blen = core::byte_length($b);
    my int $nl = core::byte_index($b, "\n");
    my str $line = core::byte_substr($b, 0, $nl);
    $self->{"buf"} = core::byte_substr($b, $nl + 1, $blen - $nl - 1);
    my int $llen = core::byte_length($line);
    if ($llen > 0 && core::byte_substr($line, $llen - 1, 1) eq "\r") {
        $llen = $llen - 1;
        $line = core::byte_substr($line, 0, $llen);
    }
    if ($max > 0 && $llen > $max) {
        SMTP::_line_too_long($self);
        return undef;
    }
    return $line;
}

# Internal: the server sent an over-long line (or endless reply); drop the
# connection (the rest of the stream can't be trusted to be in sync).
func _line_too_long(scalar $self, str $why = "") void {
    if ($self->{"debug"} == 1) {
        if ($why eq "") { $why = "reply line longer than " . $self->{"max_line"} . " bytes"; }
        say("S: <" . $why . "; closing>");
    }
    $self->{"buf"} = "";
    SMTP::close($self);
}

# Internal: receive a (possibly multi-line) response. Replies are read a
# line at a time: a server may send every line of a multi-line reply in
# one packet ("250-a\r\n250 b\r\n"), and the last line is the one whose
# code is followed by a space. last_code is 0 if the connection dropped.
func recv_response(scalar $self) str {
    my str $response = "";
    my int $code = 0;
    my int $nlines = 0;
    while (1) {
        my scalar $line = SMTP::read_line($self);
        if (!defined($line)) { $code = 0; last; }
        $nlines = $nlines + 1;
        if ($nlines > 1000) {   # endless "250-..." continuation: give up
            SMTP::_line_too_long($self, "reply longer than 1000 lines");
            $code = 0;
            last;
        }
        $response = $response . $line . "\r\n";
        if (core::byte_length($line) < 3 || $line !~ /^[0-9]{3}/) { $code = 0; last; }
        $code = core::atoi(core::byte_substr($line, 0, 3));
        if (core::byte_length($line) == 3 || core::byte_substr($line, 3, 1) ne "-") { last; }
    }

    $self->{"last_code"} = $code;
    $self->{"last_response"} = $response;

    if ($self->{"debug"} == 1) {
        say("S: " . trim($response));
    }

    return $response;
}

# Internal: send command and get response
func command(scalar $self, str $cmd) int {
    SMTP::send_cmd($self, $cmd);
    SMTP::recv_response($self);
    return $self->{"last_code"};
}

func _has_crlf(str $s) int {
    return (core::byte_index($s, "\r") >= 0 || core::byte_index($s, "\n") >= 0) ? 1 : 0;
}

# HELO command - simple greeting
func helo(scalar $self, str $domain) int {
    if (SMTP::_has_crlf($domain)) { return 0; }
    my int $code = SMTP::command($self, "HELO " . $domain);
    return ($code == 250);
}

# EHLO command - extended greeting (capabilities: see supports())
func ehlo(scalar $self, str $domain) int {
    if (SMTP::_has_crlf($domain)) { return 0; }
    my int $code = SMTP::command($self, "EHLO " . $domain);
    if ($code == 250) { $self->{"ehlo"} = uc($self->{"last_response"}); }
    return ($code == 250);
}

# Did the last EHLO advertise this extension (e.g. "STARTTLS", "AUTH")?
func supports(scalar $self, str $ext) int {
    my str $caps = "" . $self->{"ehlo"};
    my str $e = uc($ext);
    foreach my str $line (split("\r\n", $caps)) {
        if (length($line) < 4) { next; }
        my str $rest = substr($line, 4, length($line) - 4);
        if ($rest eq $e || index($rest, $e . " ") == 0) { return 1; }
    }
    return 0;
}

# STARTTLS - ask the server to switch to TLS. Net::SMTP_SSL::starttls()
# sends this and then does the TLS handshake.
func starttls(scalar $self) int {
    my int $code = SMTP::command($self, "STARTTLS");
    return ($code == 220);
}

# AUTH LOGIN - authenticate with username/password
func auth(scalar $self, str $username, str $password) int {
    my int $code = SMTP::command($self, "AUTH LOGIN");
    if ($code != 334) {
        return 0;
    }
    $code = SMTP::command($self, core::base64_encode($username));
    if ($code != 334) {
        return 0;
    }
    $code = SMTP::command($self, core::base64_encode($password));
    return ($code == 235);
}

# AUTH PLAIN - authenticate with PLAIN mechanism
func auth_plain(scalar $self, str $username, str $password) int {
    # PLAIN format: \0username\0password
    my str $auth_str = core::byte(0) . $username . core::byte(0) . $password;
    my int $code = SMTP::command($self, "AUTH PLAIN " . core::base64_encode($auth_str));
    return ($code == 235);
}

# MAIL FROM - specify sender
func mail(scalar $self, str $from) int {
    if (SMTP::_has_crlf($from)) { return 0; }
    my int $code = SMTP::command($self, "MAIL FROM:<" . $from . ">");
    return ($code == 250);
}

# RCPT TO - specify recipient (call multiple times for multiple recipients)
func rcpt_to(scalar $self, str $recipient) int {
    if (SMTP::_has_crlf($recipient)) { return 0; }
    my int $code = SMTP::command($self, "RCPT TO:<" . $recipient . ">");
    return ($code == 250 || $code == 251);
}

# Alias for rcpt_to()
func recipient(scalar $self, str $rcpt) int {
    return SMTP::rcpt_to($self, $rcpt);
}

# DATA - send message body
# The message should include headers and body separated by blank line
func data(scalar $self, str $message) int {
    my int $code = SMTP::command($self, "DATA");
    if ($code != 354) {
        return 0;
    }
    # dot-stuffed, every line ending in CRLF, then the lone "."
    if ($self->{"debug"} == 1) { say("C: (message, " . core::byte_length($message) . " bytes)"); }
    SMTP::send_raw($self, SMTP::dot_stuff($message));
    $code = SMTP::command($self, ".");
    return ($code == 250);
}

# RSET - reset the session
func reset(scalar $self) int {
    my int $code = SMTP::command($self, "RSET");
    return ($code == 250);
}

# NOOP - no operation (keep-alive)
func noop(scalar $self) int {
    my int $code = SMTP::command($self, "NOOP");
    return ($code == 250);
}

# VRFY - verify address (often disabled on servers)
func verify(scalar $self, str $address) int {
    if (SMTP::_has_crlf($address)) { return 0; }
    my int $code = SMTP::command($self, "VRFY " . $address);
    return ($code == 250 || $code == 251 || $code == 252);
}

# QUIT - close connection
func quit(scalar $self) int {
    my int $code = SMTP::command($self, "QUIT");
    SMTP::close($self);
    return ($code == 221);
}

# Drop the connection (TLS too) without QUIT.
func close(scalar $self) void {
    my scalar $cf = $self->{"close_fn"};
    if (defined($cf)) { $cf->(); $self->{"close_fn"} = undef; }
    $self->{"send_fn"} = undef;
    $self->{"recv_fn"} = undef;
    if (defined($self->{"socket"})) {
        core::socket_close($self->{"socket"});
        $self->{"socket"} = undef;
    }
}

# Get last response code
func code(scalar $self) int {
    return $self->{"last_code"};
}

# Get last response message
func message(scalar $self) str {
    return $self->{"last_response"};
}

# Send a message that already has its headers (envelope from/to given).
func send_message(scalar $self, str $from, scalar $to_list, str $message) int {
    if (SMTP::_has_crlf($from)) {
        return 0;
    }
    foreach my str $rcpt_chk (@{$to_list}) {
        if (SMTP::_has_crlf($rcpt_chk)) {
            return 0;
        }
    }
    if (!SMTP::mail($self, $from)) {
        return 0;
    }
    foreach my str $rcpt (@{$to_list}) {
        if (!SMTP::rcpt_to($self, $rcpt)) {
            return 0;
        }
    }
    return SMTP::data($self, $message);
}

# Convenience method: send a complete plain-text email
func send_mail(scalar $self, str $from, scalar $to_list, str $subject, str $body) int {
    if (SMTP::_has_crlf($from) || SMTP::_has_crlf($subject)) {
        return 0;
    }
    foreach my str $rcpt_chk (@{$to_list}) {
        if (SMTP::_has_crlf($rcpt_chk)) {
            return 0;
        }
    }
    my str $msg = "From: " . $from . "\r\n";
    $msg = $msg . "To: " . join(", ", @{$to_list}) . "\r\n";
    $msg = $msg . "Subject: " . $subject . "\r\n";
    $msg = $msg . "Date: " . core::strftime("%a, %d %b %Y %H:%M:%S +0000", core::gmtime(core::time())) . "\r\n";
    $msg = $msg . "MIME-Version: 1.0\r\n";
    $msg = $msg . "Content-Type: text/plain; charset=UTF-8\r\n";
    $msg = $msg . "\r\n";
    $msg = $msg . $body;
    return SMTP::send_message($self, $from, $to_list, $msg);
}

# Internal: dot-stuffing for DATA command. Lines starting with "." get an
# extra "."; every line ends in CRLF, preserving trailing blank lines (such
# as the blank header/body separator when $body is empty).
func dot_stuff(str $text) str {
    if (core::byte_length($text) == 0) {
        return "";
    }
    my str $t = $text;
    $t =~ s/\r\n/\n/g;
    $t =~ s/\r/\n/g;
    my int $len = core::byte_length($t);
    my int $pos = 0;
    my str $result = "";
    while ($pos < $len) {
        my int $nl = core::byte_index($t, "\n", $pos);
        my str $line = "";
        if ($nl < 0) {
            $line = core::byte_substr($t, $pos, $len - $pos);
            $pos = $len;
        } else {
            $line = core::byte_substr($t, $pos, $nl - $pos);
            $pos = $nl + 1;
        }
        if (core::byte_length($line) > 0 && core::byte_substr($line, 0, 1) eq ".") {
            $line = "." . $line;
        }
        $result = $result . $line . "\r\n";
    }
    return $result;
}
