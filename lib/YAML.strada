=head1 NAME

YAML - Simple YAML parser and dumper for Strada

=head1 SYNOPSIS

    use lib "lib";
    use YAML;

    # Parse YAML string
    my scalar $data = YAML::Load($yaml_string);

    # Dump data structure to YAML
    my str $yaml = YAML::Dump($data);

=head1 DESCRIPTION

YAML provides functions for parsing YAML documents into Strada data structures
and dumping Strada data back to YAML format.

This is a simple YAML 1.1 implementation that supports:

=over 4

=item * Mappings (hashes)

=item * Sequences (arrays)

=item * Scalars (strings, numbers, booleans, null)

=item * Multi-line literal blocks (|)

=item * Inline notation ({} and [])

=item * Comments (#)

=item * Quoted strings (single and double)

=back

=head1 FUNCTIONS

=head2 Load($yaml)

Parse a YAML string and return the corresponding Strada data structure.

    my str $yaml = "name: Alice\nage: 30\n";
    my scalar $data = YAML::Load($yaml);
    say($data->{"name"});  # Alice

=head2 Dump($data)

Convert a Strada data structure to a YAML string.

    my hash %user = ();
    $user{"name"} = "Bob";
    $user{"scores"} = [85, 90, 78];
    my str $yaml = YAML::Dump(\%user);

=head1 YAML SYNTAX

=head2 Basic Mappings

    key: value
    name: Alice
    age: 30

=head2 Nested Mappings

    database:
      host: localhost
      port: 5432

=head2 Sequences

    colors:
      - red
      - green
      - blue

=head2 Inline Notation

    servers: [web1, web2, web3]
    config: {debug: true, timeout: 30}

=head2 Multi-line Strings

    description: |
      This is a multi-line
      string that preserves
      newlines.

=head2 Special Values

    enabled: true     # or yes, on -> 1
    disabled: false   # or no, off -> 0
    nothing: null     # or ~ -> undef

=head1 EXAMPLE

    use lib "lib";
    use YAML;

    my str $config_yaml = "
    server:
      host: localhost
      port: 8080
    database:
      driver: sqlite
      name: app.db
    features:
      - logging
      - caching
      - compression
    ";

    my scalar $config = YAML::Load($config_yaml);

    say("Server: " . $config->{"server"}->{"host"});
    say("DB: " . $config->{"database"}->{"name"});

    # Modify and dump back
    $config->{"server"}->{"port"} = 9000;
    say(YAML::Dump($config));

=head1 SEE ALSO

L<JSON>

=cut

package YAML;
version "1.1.0";

# ============================================================
# YAML Parsing
# ============================================================

# Get indentation level of a line (number of leading spaces)
func get_indent(str $line) int {
    my int $len = length($line);
    my int $indent = 0;

    while ($indent < $len) {
        my str $ch = substr($line, $indent, 1);
        if ($ch eq " ") {
            $indent = $indent + 1;
        } else {
            return $indent;
        }
    }

    return $indent;
}

# Strip leading whitespace
func ltrim(str $s) str {
    my int $len = length($s);
    my int $i = 0;

    while ($i < $len) {
        my str $ch = substr($s, $i, 1);
        if ($ch eq " " || $ch eq "\t") {
            $i = $i + 1;
        } else {
            return substr($s, $i, $len - $i);
        }
    }

    return "";
}

# Strip trailing whitespace
func rtrim(str $s) str {
    my int $len = length($s);

    while ($len > 0) {
        my str $ch = substr($s, $len - 1, 1);
        if ($ch eq " " || $ch eq "\t" || $ch eq "\r" || $ch eq "\n") {
            $len = $len - 1;
        } else {
            return substr($s, 0, $len);
        }
    }

    return "";
}

# Trim both ends
func trim(str $s) str {
    my int $len = length($s);
    if ($len == 0) {
        return "";
    }

    # Find start (skip leading whitespace)
    my int $start = 0;
    my int $found_start = 0;
    while ($start < $len && !$found_start) {
        my str $ch = substr($s, $start, 1);
        if ($ch eq " " || $ch eq "\t") {
            $start = $start + 1;
        } else {
            $found_start = 1;
        }
    }

    if ($start >= $len) {
        return "";
    }

    # Find end (skip trailing whitespace)
    my int $end = $len;
    my int $found_end = 0;
    while ($end > $start && !$found_end) {
        my str $ch = substr($s, $end - 1, 1);
        if ($ch eq " " || $ch eq "\t" || $ch eq "\r" || $ch eq "\n") {
            $end = $end - 1;
        } else {
            $found_end = 1;
        }
    }

    if ($start >= $end) {
        return "";
    }

    return substr($s, $start, $end - $start);
}

# Check if line is empty or comment
func is_empty_or_comment(str $line) int {
    my str $trimmed = YAML::trim($line);
    if (length($trimmed) == 0) {
        return 1;
    }
    if (substr($trimmed, 0, 1) eq "#") {
        return 1;
    }
    return 0;
}

# Process escape sequences in double-quoted strings
func process_escapes(str $s) str {
    my str $result = "";
    my int $len = length($s);
    my int $i = 0;

    while ($i < $len) {
        my str $ch = substr($s, $i, 1);

        if ($ch eq "\\" && $i + 1 < $len) {
            my str $next = substr($s, $i + 1, 1);

            if ($next eq "n") {
                $result = $result . "\n";
                $i = $i + 2;
            } elsif ($next eq "t") {
                $result = $result . "\t";
                $i = $i + 2;
            } elsif ($next eq "r") {
                $result = $result . "\r";
                $i = $i + 2;
            } elsif ($next eq "\\") {
                $result = $result . "\\";
                $i = $i + 2;
            } elsif ($next eq "\"") {
                $result = $result . "\"";
                $i = $i + 2;
            } elsif ($next eq "0") {
                $result = $result . "\0";
                $i = $i + 2;
            } elsif ($next eq "/") {
                $result = $result . "/";
                $i = $i + 2;
            } elsif ($next eq "b") {
                # Backspace - ASCII 8
                $result = $result . chr(8);
                $i = $i + 2;
            } elsif ($next eq "f") {
                # Form feed - ASCII 12
                $result = $result . chr(12);
                $i = $i + 2;
            } else {
                # Unknown escape, keep as-is
                $result = $result . $ch;
                $i = $i + 1;
            }
        } else {
            $result = $result . $ch;
            $i = $i + 1;
        }
    }

    return $result;
}

# Strip trailing # comment outside quotes (when preceded by whitespace/SOL/closing quote)
func strip_comment(str $s) str {
    my int $len = length($s);
    my int $i = 0;
    my int $in_single = 0;
    my int $in_double = 0;
    my int $just_closed_quote = 0;

    while ($i < $len) {
        my str $ch = substr($s, $i, 1);

        if ($in_single) {
            if ($ch eq "'") {
                if ($i + 1 < $len && substr($s, $i + 1, 1) eq "'") {
                    $i = $i + 2;
                    next;
                }
                $in_single = 0;
                $just_closed_quote = 1;
            }
            $i = $i + 1;
            next;
        }

        if ($in_double) {
            if ($ch eq "\\" && $i + 1 < $len) {
                $i = $i + 2;
                next;
            }
            if ($ch eq "\"") {
                $in_double = 0;
                $just_closed_quote = 1;
            }
            $i = $i + 1;
            next;
        }

        if ($ch eq "'") {
            $in_single = 1;
            $just_closed_quote = 0;
            $i = $i + 1;
            next;
        }
        if ($ch eq "\"") {
            $in_double = 1;
            $just_closed_quote = 0;
            $i = $i + 1;
            next;
        }

        if ($ch eq "#") {
            if ($i == 0 || $just_closed_quote) {
                return YAML::trim(substr($s, 0, $i));
            }
            my str $prev = substr($s, $i - 1, 1);
            if ($prev eq " " || $prev eq "\t") {
                return YAML::trim(substr($s, 0, $i));
            }
        }

        $just_closed_quote = 0;
        $i = $i + 1;
    }

    return YAML::trim($s);
}

# Find YAML mapping colon (outside quotes/brackets, followed by space/tab or EOL)
func find_mapping_colon(str $s) int {
    my int $len = length($s);
    if ($len == 0) {
        return -1;
    }
    my str $first = substr($s, 0, 1);
    if ($first eq "{" || $first eq "[") {
        return -1;
    }

    my int $i = 0;
    if ($first eq "'") {
        $i = 1;
        while ($i < $len) {
            my str $ch = substr($s, $i, 1);
            if ($ch eq "'") {
                if ($i + 1 < $len && substr($s, $i + 1, 1) eq "'") {
                    $i = $i + 2;
                    next;
                }
                $i = $i + 1;
                last;
            }
            $i = $i + 1;
        }
        while ($i < $len && (substr($s, $i, 1) eq " " || substr($s, $i, 1) eq "\t")) {
            $i = $i + 1;
        }
        if ($i < $len && substr($s, $i, 1) eq ":") {
            if ($i + 1 == $len || substr($s, $i + 1, 1) eq " " || substr($s, $i + 1, 1) eq "\t") {
                return $i;
            }
        }
        return -1;
    }

    if ($first eq "\"") {
        $i = 1;
        while ($i < $len) {
            my str $ch = substr($s, $i, 1);
            if ($ch eq "\\" && $i + 1 < $len) {
                $i = $i + 2;
                next;
            }
            if ($ch eq "\"") {
                $i = $i + 1;
                last;
            }
            $i = $i + 1;
        }
        while ($i < $len && (substr($s, $i, 1) eq " " || substr($s, $i, 1) eq "\t")) {
            $i = $i + 1;
        }
        if ($i < $len && substr($s, $i, 1) eq ":") {
            if ($i + 1 == $len || substr($s, $i + 1, 1) eq " " || substr($s, $i + 1, 1) eq "\t") {
                return $i;
            }
        }
        return -1;
    }

    while ($i < $len) {
        my str $ch = substr($s, $i, 1);
        if ($ch eq ":" && $i > 0) {
            if ($i + 1 == $len) {
                return $i;
            }
            my str $nx = substr($s, $i + 1, 1);
            if ($nx eq " " || $nx eq "\t") {
                return $i;
            }
        }
        $i = $i + 1;
    }
    return -1;
}

# Unquote a YAML key if wrapped in single or double quotes
func unquote_key(str $k) str {
    my str $t = YAML::trim($k);
    my int $len = length($t);
    if ($len >= 2) {
        my str $f = substr($t, 0, 1);
        my str $l = substr($t, $len - 1, 1);
        if ($f eq "'" && $l eq "'") {
            return replace_all(substr($t, 1, $len - 2), "''", "'");
        }
        if ($f eq "\"" && $l eq "\"") {
            return YAML::process_escapes(substr($t, 1, $len - 2));
        }
    }
    return $t;
}

# Parse a YAML value (handles quotes, numbers, booleans)
func parse_value(str $s) scalar {
    my str $trimmed = YAML::strip_comment($s);
    my int $len = length($trimmed);

    if ($len == 0) {
        return "";
    }

    # Check for quoted string
    my str $first = substr($trimmed, 0, 1);
    if ($first eq "'" || $first eq "\"") {
        if ($len >= 2) {
            my str $last_ch = substr($trimmed, $len - 1, 1);
            if ($last_ch eq $first) {
                my str $content = substr($trimmed, 1, $len - 2);
                # Process escape sequences for double-quoted strings
                if ($first eq "\"") {
                    return YAML::process_escapes($content);
                }
                return replace_all($content, "''", "'");
            }
        }
        throw "YAML parse error: unterminated quoted string";
    }

    # Check for inline hash { ... }
    if ($first eq "{") {
        return YAML::parse_inline_hash($trimmed);
    }

    # Check for inline array [ ... ]
    if ($first eq "[") {
        return YAML::parse_inline_array($trimmed);
    }

    # Check for boolean/null values (case-insensitive YAML 1.1)
    my str $low = lc($trimmed);
    if ($low eq "true" || $low eq "yes" || $low eq "on") {
        return 1;
    }
    if ($low eq "false" || $low eq "no" || $low eq "off") {
        return 0;
    }
    if ($low eq "null" || $trimmed eq "~") {
        return undef;
    }

    # Check if it looks like a number
    if (YAML::looks_like_num($trimmed)) {
        if (index($trimmed, ".") < 0 && index($trimmed, "e") < 0 && index($trimmed, "E") < 0) {
            return cast_int($trimmed);
        }
        return $trimmed + 0;
    }

    return $trimmed;
}

# Check if a string looks like a number (decimal int/float/scientific)
func looks_like_num(str $s) int {
    my int $len = length($s);
    if ($len == 0) {
        return 0;
    }

    my int $i = 0;
    my str $ch = substr($s, 0, 1);
    if ($ch eq "-" || $ch eq "+") {
        $i = 1;
        if ($len == 1) {
            return 0;
        }
    }

    my int $has_dot = 0;
    my int $has_exp = 0;
    my int $has_digit = 0;

    while ($i < $len) {
        $ch = substr($s, $i, 1);
        if ($ch ge "0" && $ch le "9") {
            $has_digit = 1;
        } elsif ($ch eq "." && !$has_dot && !$has_exp) {
            $has_dot = 1;
        } elsif (($ch eq "e" || $ch eq "E") && $has_digit && !$has_exp) {
            $has_exp = 1;
            $has_digit = 0;
            if ($i + 1 < $len) {
                my str $nx = substr($s, $i + 1, 1);
                if ($nx eq "+" || $nx eq "-") {
                    $i = $i + 1;
                }
            }
        } else {
            return 0;
        }
        $i = $i + 1;
    }

    return $has_digit;
}

# Parse inline hash { key: value, key2: value2 }
func verify_outer_flow_enclosure(str $s, str $open_ch, str $close_ch, str $kind) void {
    my int $len = length($s);
    if ($len < 2 || substr($s, 0, 1) ne $open_ch || substr($s, $len - 1, 1) ne $close_ch) {
        throw "YAML parse error: unclosed inline " . $kind;
    }
    my int $bdepth = 0;
    my int $sdepth = 0;
    my int $in_sq = 0;
    my int $in_dq = 0;
    my int $i = 0;
    while ($i < $len) {
        my str $ch = substr($s, $i, 1);
        if ($in_dq == 1) {
            if ($ch eq "\\") {
                $i = $i + 2;
                next;
            }
            if ($ch eq "\"") { $in_dq = 0; }
        } elsif ($in_sq == 1) {
            if ($ch eq "'") {
                if ($i + 1 < $len && substr($s, $i + 1, 1) eq "'") {
                    $i = $i + 2;
                    next;
                }
                $in_sq = 0;
            }
        } else {
            if ($ch eq "\"") {
                $in_dq = 1;
            } elsif ($ch eq "'") {
                $in_sq = 1;
            } elsif ($ch eq "{") {
                $bdepth = $bdepth + 1;
            } elsif ($ch eq "}") {
                $bdepth = $bdepth - 1;
                if ($bdepth < 0) {
                    throw "YAML parse error: unexpected '}' in inline " . $kind;
                }
            } elsif ($ch eq "[") {
                $sdepth = $sdepth + 1;
            } elsif ($ch eq "]") {
                $sdepth = $sdepth - 1;
                if ($sdepth < 0) {
                    throw "YAML parse error: unexpected ']' in inline " . $kind;
                }
            }
            if ($i < $len - 1 && $bdepth == 0 && $sdepth == 0) {
                throw "YAML parse error: trailing content after inline " . $kind;
            }
        }
        $i = $i + 1;
    }
    if ($in_dq == 1 || $in_sq == 1) {
        throw "YAML parse error: unterminated quoted string in inline " . $kind;
    }
    if ($bdepth != 0 || $sdepth != 0) {
        throw "YAML parse error: unclosed inline " . $kind;
    }
}

func split_inline_items(str $s) array {
    my array @items = ();
    my str $trimmed = YAML::trim($s);
    if (length($trimmed) == 0) {
        return @items;
    }
    my int $len = length($s);
    my int $i = 0;
    my int $start = 0;
    my int $brace_depth = 0;
    my int $bracket_depth = 0;
    my int $in_sq = 0;
    my int $in_dq = 0;

    while ($i < $len) {
        my str $ch = substr($s, $i, 1);
        if ($in_dq == 1) {
            if ($ch eq "\\") {
                $i = $i + 2;
                next;
            }
            if ($ch eq "\"") {
                $in_dq = 0;
            }
        } elsif ($in_sq == 1) {
            if ($ch eq "'") {
                if ($i + 1 < $len && substr($s, $i + 1, 1) eq "'") {
                    $i = $i + 2;
                    next;
                }
                $in_sq = 0;
            }
        } else {
            if ($ch eq "\"") {
                $in_dq = 1;
            } elsif ($ch eq "'") {
                $in_sq = 1;
            } elsif ($ch eq "{") {
                $brace_depth = $brace_depth + 1;
            } elsif ($ch eq "}") {
                $brace_depth = $brace_depth - 1;
                if ($brace_depth < 0) {
                    throw "YAML parse error: unexpected '}' in inline collection";
                }
            } elsif ($ch eq "[") {
                $bracket_depth = $bracket_depth + 1;
            } elsif ($ch eq "]") {
                $bracket_depth = $bracket_depth - 1;
                if ($bracket_depth < 0) {
                    throw "YAML parse error: unexpected ']' in inline collection";
                }
            } elsif ($ch eq "," && $brace_depth == 0 && $bracket_depth == 0) {
                push(@items, substr($s, $start, $i - $start));
                $start = $i + 1;
            }
        }
        $i = $i + 1;
    }
    if ($in_dq == 1 || $in_sq == 1) {
        throw "YAML parse error: unterminated quoted string in inline collection";
    }
    if ($brace_depth != 0 || $bracket_depth != 0) {
        throw "YAML parse error: unclosed inline collection";
    }
    push(@items, substr($s, $start, $len - $start));
    return @items;
}

func parse_inline_hash(str $s) scalar {
    YAML::verify_outer_flow_enclosure($s, "{", "}", "mapping");
    my scalar $result = {};
    my int $len = length($s);
    $s = substr($s, 1, $len - 2);

    my array @parts = YAML::split_inline_items($s);
    my int $count = size(@parts);
    my int $i = 0;

    while ($i < $count) {
        my str $part = YAML::trim($parts[$i]);

        # Find the colon outside quotes
        my int $colon_pos = YAML::find_mapping_colon($part);
        if ($colon_pos > 0) {
            my str $key = YAML::unquote_key(substr($part, 0, $colon_pos));
            my str $val_str = "";
            if ($colon_pos + 1 < length($part)) {
                $val_str = substr($part, $colon_pos + 1, length($part) - $colon_pos - 1);
            }
            my scalar $val = YAML::parse_value($val_str);
            $result->{$key} = $val;
        }

        $i = $i + 1;
    }

    return $result;
}

# Parse inline array [ item1, item2 ]
func parse_inline_array(str $s) scalar {
    YAML::verify_outer_flow_enclosure($s, "[", "]", "sequence");
    my scalar $result = [];
    my int $len = length($s);
    $s = substr($s, 1, $len - 2);

    my array @parts = YAML::split_inline_items($s);
    my int $count = size(@parts);
    my int $i = 0;

    while ($i < $count) {
        my str $part = YAML::trim($parts[$i]);
        if (length($part) > 0) {
            push($result, YAML::parse_value($part));
        }
        $i = $i + 1;
    }

    return $result;
}

func is_doc_start(str $line) int {
    if (YAML::get_indent($line) != 0) { return 0; }
    my str $c = YAML::trim(YAML::strip_comment($line));
    if ($c eq "---") { return 1; }
    if (length($c) >= 4 && (substr($c, 0, 4) eq "--- " || substr($c, 0, 4) eq "---\t")) {
        return 1;
    }
    return 0;
}

func is_doc_end(str $line) int {
    if (YAML::get_indent($line) != 0) { return 0; }
    my str $c = YAML::trim(YAML::strip_comment($line));
    if ($c eq "...") { return 1; }
    if (length($c) >= 4 && (substr($c, 0, 4) eq "... " || substr($c, 0, 4) eq "...\t")) {
        return 1;
    }
    return 0;
}

# Main YAML Load function - parse YAML string into Strada data structure
func Load(str $yaml) scalar {
    my array @lines = split("\n", $yaml);
    if (length($yaml) > 0 && substr($yaml, length($yaml) - 1, 1) eq "\n" &&
        size(@lines) > 0 && $lines[size(@lines) - 1] eq "") {
        pop(@lines);
    }
    my int $line_count = size(@lines);

    # Index for tracking current position
    my scalar $state = {
        "lines" => \@lines,
        "count" => $line_count,
        "pos" => 0
    };

    # Skip leading empty/comment lines and consume document start marker (---)
    while ($state->{"pos"} < $line_count && YAML::is_empty_or_comment($lines[$state->{"pos"}])) {
        $state->{"pos"} = $state->{"pos"} + 1;
    }
    if ($state->{"pos"} < $line_count && YAML::is_doc_start($lines[$state->{"pos"}]) == 1) {
        my str $doc_clean = YAML::trim(YAML::strip_comment($lines[$state->{"pos"}]));
        $state->{"pos"} = $state->{"pos"} + 1;
        if (length($doc_clean) > 3) {
            my str $after_doc = YAML::trim(substr($doc_clean, 3, length($doc_clean) - 3));
            if (length($after_doc) > 0) {
                if (YAML::is_block_scalar_spec($after_doc) == 1) {
                    return YAML::parse_block_scalar($state, 0 - 1, $after_doc);
                }
                return YAML::parse_value($after_doc);
            }
        }
    }

    return YAML::parse_block($state, 0);
}

# Parse a block of YAML at a given indentation level
func parse_block(scalar $state, int $base_indent) scalar {
    my int $depth = 0;
    if (defined($state->{"depth"})) {
        $depth = $state->{"depth"} + 0;
    }
    if ($depth >= 64) {
        throw "YAML: maximum nesting depth (64) exceeded";
    }
    $state->{"depth"} = $depth + 1;
    my scalar $res = YAML::parse_block_inner($state, $base_indent);
    $state->{"depth"} = $depth;
    return $res;
}

func parse_block_inner(scalar $state, int $base_indent) scalar {
    my scalar $lines = $state->{"lines"};
    my int $count = $state->{"count"};

    # Skip empty/comment lines and find first real line
    my int $found = 0;
    while ($state->{"pos"} < $count && !$found) {
        my str $line = $lines->[$state->{"pos"}];
        if (YAML::is_empty_or_comment($line)) {
            $state->{"pos"} = $state->{"pos"} + 1;
        } else {
            $found = 1;
        }
    }

    if ($state->{"pos"} >= $count) {
        return undef;
    }

    my str $first_line = $lines->[$state->{"pos"}];
    if (YAML::is_doc_end($first_line) == 1 || YAML::is_doc_start($first_line) == 1) {
        return undef;
    }
    my int $indent = YAML::get_indent($first_line);
    my str $content = YAML::trim($first_line);

    # Check if this line starts an array (- prefix)
    if (substr($content, 0, 2) eq "- ") {
        return YAML::parse_array($state, $indent);
    }
    if ($content eq "-") {
        return YAML::parse_array($state, $indent);
    }

    # Check if this line is a key: value
    my int $colon_pos = YAML::find_mapping_colon($content);
    if ($colon_pos > 0) {
        return YAML::parse_hash($state, $indent);
    }

    # Simple value
    $state->{"pos"} = $state->{"pos"} + 1;
    return YAML::parse_value($content);
}

# Parse a hash (key: value pairs)
func parse_hash(scalar $state, int $base_indent) scalar {
    my scalar $result = {};
    my scalar $lines = $state->{"lines"};
    my int $count = $state->{"count"};

    while ($state->{"pos"} < $count) {
        my str $line = $lines->[$state->{"pos"}];

        # Skip empty/comment lines
        if (YAML::is_empty_or_comment($line)) {
            $state->{"pos"} = $state->{"pos"} + 1;
            next;
        }

        if (YAML::is_doc_end($line) == 1 || YAML::is_doc_start($line) == 1) {
            return $result;
        }

        my int $indent = YAML::get_indent($line);

        # If indent is less than base, we're done with this block
        if ($indent < $base_indent) {
            return $result;
        }

        my str $content = YAML::trim($line);

        # Parse key: value
        my int $colon_pos = YAML::find_mapping_colon($content);
        if ($colon_pos <= 0) {
            # Not a key-value line, done
            return $result;
        }

        my str $key = YAML::unquote_key(substr($content, 0, $colon_pos));
        my str $after_colon = "";
        if ($colon_pos + 1 < length($content)) {
            $after_colon = substr($content, $colon_pos + 1, length($content) - $colon_pos - 1);
        }
        $after_colon = YAML::trim($after_colon);

        $state->{"pos"} = $state->{"pos"} + 1;

        if (length($after_colon) > 0) {
            # Value on same line
            if (YAML::is_block_scalar_spec($after_colon) == 1) {
                $result->{$key} = YAML::parse_block_scalar($state, $indent, $after_colon);
            } else {
                $result->{$key} = YAML::parse_value($after_colon);
            }
        } else {
            # Value might be on next lines (nested structure)
            # Look ahead to see what's next
            while ($state->{"pos"} < $count && YAML::is_empty_or_comment($lines->[$state->{"pos"}])) {
                $state->{"pos"} = $state->{"pos"} + 1;
            }

            if ($state->{"pos"} < $count) {
                my str $next_line = $lines->[$state->{"pos"}];
                my int $next_indent = YAML::get_indent($next_line);
                my str $next_trim = YAML::trim($next_line);

                if ($next_indent > $indent || ($next_indent == $indent && (substr($next_trim, 0, 2) eq "- " || $next_trim eq "-"))) {
                    # Nested block (including indentless YAML sequences at same indent)
                    $result->{$key} = YAML::parse_block($state, $next_indent);
                } else {
                    # Empty value
                    $result->{$key} = "";
                }
            } else {
                $result->{$key} = "";
            }
        }
    }

    return $result;
}

# Parse an array (- prefixed items)
func parse_array(scalar $state, int $base_indent) scalar {
    my scalar $result = [];
    my scalar $lines = $state->{"lines"};
    my int $count = $state->{"count"};

    while ($state->{"pos"} < $count) {
        my str $line = $lines->[$state->{"pos"}];

        # Skip empty/comment lines
        if (YAML::is_empty_or_comment($line)) {
            $state->{"pos"} = $state->{"pos"} + 1;
            next;
        }

        if (YAML::is_doc_end($line) == 1 || YAML::is_doc_start($line) == 1) {
            return $result;
        }

        my int $indent = YAML::get_indent($line);

        # If indent is less than base, we're done with this block
        if ($indent < $base_indent) {
            return $result;
        }

        my str $content = YAML::trim($line);

        # Must start with -
        if (substr($content, 0, 1) ne "-") {
            return $result;
        }

        # Get content after -
        my str $after_dash = "";
        if (length($content) > 1) {
            $after_dash = substr($content, 1, length($content) - 1);
            if (length($after_dash) > 0 && substr($after_dash, 0, 1) eq " ") {
                $after_dash = substr($after_dash, 1, length($after_dash) - 1);
            }
        }
        $after_dash = YAML::trim($after_dash);

        $state->{"pos"} = $state->{"pos"} + 1;

        if (length($after_dash) > 0) {
            # Check if after dash is an inline hash or a mapping entry (colon followed by space/tab/EOL outside quotes)
            my int $colon_pos = YAML::find_mapping_colon($after_dash);
            if (substr($after_dash, 0, 1) eq "{") {
                # Inline hash
                push($result, YAML::parse_inline_hash(YAML::strip_comment($after_dash)));
            } elsif ($colon_pos > 0) {
                # This is a hash entry starting on the - line
                # Parse as nested hash
                my scalar $item = {};
                my str $key = YAML::unquote_key(substr($after_dash, 0, $colon_pos));
                my str $val_str = "";
                if ($colon_pos + 1 < length($after_dash)) {
                    $val_str = YAML::trim(substr($after_dash, $colon_pos + 1, length($after_dash) - $colon_pos - 1));
                }

                if (length($val_str) > 0) {
                    if (YAML::is_block_scalar_spec($val_str) == 1) {
                        $item->{$key} = YAML::parse_block_scalar($state, $indent + 2, $val_str);
                    } else {
                        $item->{$key} = YAML::parse_value($val_str);
                    }
                } else {
                    my int $look = $state->{"pos"};
                    while ($look < $count && YAML::is_empty_or_comment($lines->[$look]) == 1) {
                        $look = $look + 1;
                    }
                    if ($look < $count) {
                        my int $sub_indent = YAML::get_indent($lines->[$look]);
                        my str $sub_trim = YAML::trim($lines->[$look]);
                        my int $sub_is_arr = (substr($sub_trim, 0, 2) eq "- " || $sub_trim eq "-") ? 1 : 0;
                        if (($sub_is_arr == 1 && $sub_indent > $indent) || $sub_indent > $indent + 2) {
                            $state->{"pos"} = $look;
                            $item->{$key} = YAML::parse_block($state, $sub_indent);
                        } else {
                            $item->{$key} = "";
                        }
                    } else {
                        $item->{$key} = "";
                    }
                }

                # Check for more key:value pairs at higher indent
                my int $done_item = 0;
                while ($state->{"pos"} < $count && !$done_item) {
                    my str $next_line = $lines->[$state->{"pos"}];
                    if (YAML::is_empty_or_comment($next_line)) {
                        $state->{"pos"} = $state->{"pos"} + 1;
                    } else {
                        my int $next_indent = YAML::get_indent($next_line);
                        if ($next_indent <= $indent) {
                            $done_item = 1;
                        } else {
                            my str $next_content = YAML::trim($next_line);
                            my int $next_colon = YAML::find_mapping_colon($next_content);
                            if ($next_colon > 0) {
                                my str $next_key = YAML::unquote_key(substr($next_content, 0, $next_colon));
                                my str $next_val_str = "";
                                if ($next_colon + 1 < length($next_content)) {
                                    $next_val_str = YAML::trim(substr($next_content, $next_colon + 1, length($next_content) - $next_colon - 1));
                                }

                                $state->{"pos"} = $state->{"pos"} + 1;

                                if (length($next_val_str) > 0) {
                                    if (YAML::is_block_scalar_spec($next_val_str) == 1) {
                                        $item->{$next_key} = YAML::parse_block_scalar($state, $next_indent, $next_val_str);
                                    } else {
                                        $item->{$next_key} = YAML::parse_value($next_val_str);
                                    }
                                } else {
                                    # Check for nested structure
                                    while ($state->{"pos"} < $count && YAML::is_empty_or_comment($lines->[$state->{"pos"}])) {
                                        $state->{"pos"} = $state->{"pos"} + 1;
                                    }
                                    if ($state->{"pos"} < $count) {
                                        my str $sub_line = $lines->[$state->{"pos"}];
                                        my int $sub_indent = YAML::get_indent($sub_line);
                                        my str $sub_trim = YAML::trim($sub_line);
                                        if ($sub_indent > $next_indent || ($sub_indent == $next_indent && (substr($sub_trim, 0, 2) eq "- " || $sub_trim eq "-"))) {
                                            $item->{$next_key} = YAML::parse_block($state, $sub_indent);
                                        } else {
                                            $item->{$next_key} = "";
                                        }
                                    } else {
                                        $item->{$next_key} = "";
                                    }
                                }
                            } else {
                                $done_item = 1;
                            }
                        }
                    }
                }

                push($result, $item);
            } else {
                # Simple value
                push($result, YAML::parse_value($after_dash));
            }
        } else {
            # Check next line for nested content
            while ($state->{"pos"} < $count && YAML::is_empty_or_comment($lines->[$state->{"pos"}])) {
                $state->{"pos"} = $state->{"pos"} + 1;
            }

            if ($state->{"pos"} < $count) {
                my str $next_line = $lines->[$state->{"pos"}];
                my int $next_indent = YAML::get_indent($next_line);

                if ($next_indent > $indent) {
                    push($result, YAML::parse_block($state, $next_indent));
                } else {
                    push($result, undef);
                }
            } else {
                push($result, undef);
            }
        }
    }

    return $result;
}

# Internal: read raw block scalar text along with leading/trailing blank metadata
private func _read_block_scalar_raw(scalar $state, int $base_indent) hash {
    my str $result = "";
    my scalar $lines = $state->{"lines"};
    my int $count = $state->{"count"};
    my int $block_indent = -1;
    my int $leading_blanks = 0;
    my int $trailing_blanks = 0;
    my int $has_content = 0;

    while ($state->{"pos"} < $count) {
        my str $line = $lines->[$state->{"pos"}];
        my int $llen = length($line);
        if ($llen > 0 && substr($line, $llen - 1, 1) eq "\r") {
            $line = substr($line, 0, $llen - 1);
        }
        my int $indent = YAML::get_indent($line);

        # Empty / whitespace-only lines inside block scalar
        if (YAML::trim($line) eq "") {
            if ($block_indent < 0) {
                $leading_blanks = $leading_blanks + 1;
            } else {
                $trailing_blanks = $trailing_blanks + 1;
            }
            $state->{"pos"} = $state->{"pos"} + 1;
            next;
        }

        # Check if we've exited the block (including empty block before next key at <= base_indent)
        if ($indent <= $base_indent) {
            last;
        }

        # Set block indent on first content line
        if ($block_indent < 0) {
            $block_indent = $indent;
            my int $lb = 0;
            while ($lb < $leading_blanks) {
                $result = $result . "\n";
                $lb = $lb + 1;
            }
        } else {
            my int $tb = 0;
            while ($tb <= $trailing_blanks) {
                $result = $result . "\n";
                $tb = $tb + 1;
            }
            $trailing_blanks = 0;
        }

        $has_content = 1;
        $result = $result . substr($line, $block_indent, length($line) - $block_indent);
        $state->{"pos"} = $state->{"pos"} + 1;
    }

    my hash %info = ();
    $info{"raw"} = $result;
    $info{"has_content"} = $has_content;
    $info{"leading_blanks"} = $leading_blanks;
    $info{"trailing_blanks"} = $trailing_blanks;
    return %info;
}

# Parse literal block (|)
func parse_literal_block(scalar $state, int $base_indent) str {
    return YAML::parse_block_scalar($state, $base_indent, "|");
}

func clean_block_spec(str $s) str {
    return YAML::trim(YAML::strip_comment($s));
}

func is_block_scalar_spec(str $s) int {
    my str $c = YAML::clean_block_spec($s);
    if ($c eq "|" || $c eq "|-" || $c eq "|+" || $c eq ">" || $c eq ">-" || $c eq ">+") {
        return 1;
    }
    return 0;
}

func parse_block_scalar(scalar $state, int $base_indent, str $spec) str {
    $spec = YAML::clean_block_spec($spec);
    my int $is_folded = (substr($spec, 0, 1) eq ">") ? 1 : 0;
    my str $chomp = (length($spec) >= 2) ? substr($spec, 1, 1) : "";
    my hash %info = YAML::_read_block_scalar_raw($state, $base_indent);
    my int $has_content = $info{"has_content"};
    if ($has_content == 0) {
        if ($chomp eq "+") {
            my str $bl = "";
            my int $bi = 0;
            while ($bi < $info{"leading_blanks"}) {
                $bl = $bl . "\n";
                $bi = $bi + 1;
            }
            return $bl;
        }
        return "";
    }

    my str $raw = $info{"raw"};
    my str $out = $raw;
    if ($is_folded == 1 && length($raw) > 0) {
        my array @lines = split("\n", $raw);
        my str $folded = "";
        my int $n = size(@lines);
        my int $li = 0;
        my int $prev_blank = 1;
        while ($li < $n) {
            my str $ln = $lines[$li];
            if (length($ln) == 0) {
                $folded = $folded . "\n";
                $prev_blank = 1;
            } else {
                if ($li > 0 && $prev_blank == 0) {
                    $folded = $folded . " ";
                }
                $folded = $folded . $ln;
                $prev_blank = 0;
            }
            $li = $li + 1;
        }
        $out = $folded;
    }

    if ($chomp eq "-") {
        return $out;
    }
    if ($chomp eq "+") {
        my int $tb = 0;
        while ($tb <= $info{"trailing_blanks"}) {
            $out = $out . "\n";
            $tb = $tb + 1;
        }
        return $out;
    }
    return $out . "\n";
}

# ============================================================
# YAML Dumping
# ============================================================

# Dump a Strada data structure to YAML string
func Dump(scalar $data) str {
    return YAML::dump_value($data, 0);
}

# Dump a value with indentation
func dump_value(scalar $value, int $indent) str {
    if (!defined($value)) {
        return "~";
    }

    my str $rtype = ref($value);

    if ($rtype eq "HASH") {
        return YAML::dump_hash($value, $indent);
    }

    if ($rtype eq "ARRAY") {
        return YAML::dump_array($value, $indent);
    }

    # Scalar value
    my str $vtype = typeof($value);
    my str $str_val = "" . $value;
    if ($vtype eq "int" || $vtype eq "num") {
        return $str_val;
    }

    # Strings containing control characters (\n, \r, \t) use double-quoted escapes
    if (index($str_val, "\n") >= 0 || index($str_val, "\r") >= 0 || index($str_val, "\t") >= 0) {
        return "\"" . YAML::escape_double_quote($str_val) . "\"";
    }

    # Check if string needs quoting
    if (YAML::needs_quote($str_val)) {
        return "'" . YAML::escape_single_quote($str_val) . "'";
    }

    return $str_val;
}

# Escape double-quoted YAML strings
func escape_double_quote(str $s) str {
    my str $result = "";
    my int $len = length($s);
    my int $i = 0;
    while ($i < $len) {
        my str $ch = substr($s, $i, 1);
        if ($ch eq "\\") {
            $result = $result . "\\\\";
        } elsif ($ch eq "\"") {
            $result = $result . "\\\"";
        } elsif ($ch eq "\n") {
            $result = $result . "\\n";
        } elsif ($ch eq "\r") {
            $result = $result . "\\r";
        } elsif ($ch eq "\t") {
            $result = $result . "\\t";
        } else {
            $result = $result . $ch;
        }
        $i = $i + 1;
    }
    return $result;
}

# Check if string needs quoting
func needs_quote(str $s) int {
    my int $len = length($s);
    if ($len == 0) {
        return 1;
    }

    # Leading or trailing spaces
    my str $first = substr($s, 0, 1);
    my str $last = substr($s, $len - 1, 1);
    if ($first eq " " || $last eq " ") {
        return 1;
    }

    # Check for special first characters
    if ($first eq "'" || $first eq "\"" || $first eq "{" || $first eq "[" ||
        $first eq "-" || $first eq ":" || $first eq "#" || $first eq "&" ||
        $first eq "*" || $first eq "!" || $first eq "|" || $first eq ">" ||
        $first eq "%" || $first eq "@" || $first eq "`" || $first eq "?" ||
        $first eq "~") {
        return 1;
    }

    # Check for YAML 1.1 boolean / null keywords (case-insensitive)
    my str $low = lc($s);
    if ($low eq "true" || $low eq "false" || $low eq "null" ||
        $low eq "yes" || $low eq "no" || $low eq "on" || $low eq "off" ||
        $low eq "y" || $low eq "n" || $s eq "~") {
        return 1;
    }

    # Numeric-looking strings must be quoted so they stay strings on Load
    if (YAML::looks_like_num($s)) {
        return 1;
    }

    # Check for colon, hash comment character, or newline/tab
    if (index($s, ":") >= 0 || index($s, "#") >= 0 ||
        index($s, "\n") >= 0 || index($s, "\r") >= 0 || index($s, "\t") >= 0) {
        return 1;
    }

    return 0;
}

# Escape single quotes
func escape_single_quote(str $s) str {
    my str $result = "";
    my int $len = length($s);
    my int $i = 0;

    while ($i < $len) {
        my str $ch = substr($s, $i, 1);
        if ($ch eq "'") {
            $result = $result . "''";
        } else {
            $result = $result . $ch;
        }
        $i = $i + 1;
    }

    return $result;
}

func format_key(str $k) str {
    my int $kl = length($k);
    my int $i = 0;
    my int $has_ctrl = 0;
    while ($i < $kl) {
        my int $c = ord(substr($k, $i, 1));
        if ($c < 32 || $c == 127) {
            $has_ctrl = 1;
            last;
        }
        $i = $i + 1;
    }
    if ($has_ctrl == 1) {
        return "\"" . YAML::escape_double_quote($k) . "\"";
    }
    if (YAML::needs_quote($k) == 1) {
        return "'" . YAML::escape_single_quote($k) . "'";
    }
    return $k;
}

# Dump hash
func dump_hash(scalar $hval, int $indent) str {
    my str $result = "";
    my array @keys = keys($hval);
    my int $count = size(@keys);
    my int $i = 0;
    my str $pad = YAML::make_indent($indent);

    while ($i < $count) {
        my str $key = $keys[$i];
        my scalar $val = $hval->{$key};
        my str $rtype = ref($val);

        my str $qkey = YAML::format_key($key);
        if ($rtype eq "HASH") {
            my array @hk = keys($val);
            if (size(@hk) == 0) {
                $result = $result . $pad . $qkey . ": {}\n";
            } else {
                $result = $result . $pad . $qkey . ":\n";
                $result = $result . YAML::dump_value($val, $indent + 2);
            }
        } elsif ($rtype eq "ARRAY") {
            if (size($val) == 0) {
                $result = $result . $pad . $qkey . ": []\n";
            } else {
                $result = $result . $pad . $qkey . ":\n";
                $result = $result . YAML::dump_value($val, $indent + 2);
            }
        } else {
            $result = $result . $pad . $qkey . ": " . YAML::dump_value($val, 0) . "\n";
        }

        $i = $i + 1;
    }

    return $result;
}

# Dump array
func dump_array(scalar $arr, int $indent) str {
    my str $result = "";
    my int $count = size($arr);
    my int $i = 0;
    my str $pad = YAML::make_indent($indent);

    while ($i < $count) {
        my scalar $val = $arr->[$i];
        my str $rtype = ref($val);

        if ($rtype eq "HASH") {
            # First key on same line as dash
            my array @keys = keys($val);
            if (size(@keys) > 0) {
                my str $first_key = $keys[0];
                my scalar $first_val = $val->{$first_key};
                my str $first_rtype = ref($first_val);

                my str $qfirst_key = YAML::format_key($first_key);
                if ($first_rtype eq "HASH") {
                    my array @fk = keys($first_val);
                    if (size(@fk) == 0) {
                        $result = $result . $pad . "- " . $qfirst_key . ": {}\n";
                    } else {
                        $result = $result . $pad . "- " . $qfirst_key . ":\n";
                        $result = $result . YAML::dump_value($first_val, $indent + 4);
                    }
                } elsif ($first_rtype eq "ARRAY") {
                    if (size($first_val) == 0) {
                        $result = $result . $pad . "- " . $qfirst_key . ": []\n";
                    } else {
                        $result = $result . $pad . "- " . $qfirst_key . ":\n";
                        $result = $result . YAML::dump_value($first_val, $indent + 4);
                    }
                } else {
                    $result = $result . $pad . "- " . $qfirst_key . ": " . YAML::dump_value($first_val, 0) . "\n";
                }

                # Rest of keys
                my int $j = 1;
                while ($j < size(@keys)) {
                    my str $key = $keys[$j];
                    my scalar $kval = $val->{$key};
                    my str $krtype = ref($kval);

                    my str $qkey = YAML::format_key($key);
                    if ($krtype eq "HASH") {
                        my array @kk = keys($kval);
                        if (size(@kk) == 0) {
                            $result = $result . $pad . "  " . $qkey . ": {}\n";
                        } else {
                            $result = $result . $pad . "  " . $qkey . ":\n";
                            $result = $result . YAML::dump_value($kval, $indent + 4);
                        }
                    } elsif ($krtype eq "ARRAY") {
                        if (size($kval) == 0) {
                            $result = $result . $pad . "  " . $qkey . ": []\n";
                        } else {
                            $result = $result . $pad . "  " . $qkey . ":\n";
                            $result = $result . YAML::dump_value($kval, $indent + 4);
                        }
                    } else {
                        $result = $result . $pad . "  " . $qkey . ": " . YAML::dump_value($kval, 0) . "\n";
                    }

                    $j = $j + 1;
                }
            } else {
                $result = $result . $pad . "- {}\n";
            }
        } elsif ($rtype eq "ARRAY") {
            if (size($val) == 0) {
                $result = $result . $pad . "- []\n";
            } else {
                $result = $result . $pad . "-\n";
                $result = $result . YAML::dump_array($val, $indent + 2);
            }
        } else {
            $result = $result . $pad . "- " . YAML::dump_value($val, 0) . "\n";
        }

        $i = $i + 1;
    }

    return $result;
}

# Make indentation string
func make_indent(int $n) str {
    my str $result = "";
    my int $i = 0;

    while ($i < $n) {
        $result = $result . " ";
        $i = $i + 1;
    }

    return $result;
}
