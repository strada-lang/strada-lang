=head1 NAME

YAML - Simple YAML parser and dumper for Strada

=head1 SYNOPSIS

    use lib "lib";
    use YAML;

    # Parse YAML string
    my scalar $data = YAML::Load($yaml_string);

    # Dump data structure to YAML
    my str $yaml = YAML::Dump($data);

=head1 DESCRIPTION

YAML provides functions for parsing YAML documents into Strada data structures
and dumping Strada data back to YAML format.

This is a simple YAML 1.1 implementation that supports:

=over 4

=item * Mappings (hashes)

=item * Sequences (arrays)

=item * Scalars (strings, numbers, booleans, null)

=item * Multi-line literal blocks (|)

=item * Inline notation ({} and [])

=item * Comments (#)

=item * Quoted strings (single and double)

=back

=head1 FUNCTIONS

=head2 Load($yaml)

Parse a YAML string and return the corresponding Strada data structure.

    my str $yaml = "name: Alice\nage: 30\n";
    my scalar $data = YAML::Load($yaml);
    say($data->{"name"});  # Alice

=head2 Dump($data)

Convert a Strada data structure to a YAML string.

    my hash %user = ();
    $user{"name"} = "Bob";
    $user{"scores"} = [85, 90, 78];
    my str $yaml = YAML::Dump(\%user);

=head1 YAML SYNTAX

=head2 Basic Mappings

    key: value
    name: Alice
    age: 30

=head2 Nested Mappings

    database:
      host: localhost
      port: 5432

=head2 Sequences

    colors:
      - red
      - green
      - blue

=head2 Inline Notation

    servers: [web1, web2, web3]
    config: {debug: true, timeout: 30}

=head2 Multi-line Strings

    description: |
      This is a multi-line
      string that preserves
      newlines.

=head2 Special Values

    enabled: true     # or yes, on -> 1
    disabled: false   # or no, off -> 0
    nothing: null     # or ~ -> undef

=head1 EXAMPLE

    use lib "lib";
    use YAML;

    my str $config_yaml = "
    server:
      host: localhost
      port: 8080
    database:
      driver: sqlite
      name: app.db
    features:
      - logging
      - caching
      - compression
    ";

    my scalar $config = YAML::Load($config_yaml);

    say("Server: " . $config->{"server"}->{"host"});
    say("DB: " . $config->{"database"}->{"name"});

    # Modify and dump back
    $config->{"server"}->{"port"} = 9000;
    say(YAML::Dump($config));

=head1 SEE ALSO

L<JSON>

=cut

package YAML;
version "1.1.0";

# ============================================================
# YAML Parsing
# ============================================================

# Get indentation level of a line (number of leading spaces)
func get_indent(str $line) int {
    my int $len = length($line);
    my int $indent = 0;

    while ($indent < $len) {
        my str $ch = substr($line, $indent, 1);
        if ($ch eq " ") {
            $indent = $indent + 1;
        } else {
            return $indent;
        }
    }

    return $indent;
}

# Strip leading whitespace
func ltrim(str $s) str {
    my int $len = length($s);
    my int $i = 0;

    while ($i < $len) {
        my str $ch = substr($s, $i, 1);
        if ($ch eq " " || $ch eq "\t") {
            $i = $i + 1;
        } else {
            return substr($s, $i, $len - $i);
        }
    }

    return "";
}

# Strip trailing whitespace
func rtrim(str $s) str {
    my int $len = length($s);

    while ($len > 0) {
        my str $ch = substr($s, $len - 1, 1);
        if ($ch eq " " || $ch eq "\t" || $ch eq "\r" || $ch eq "\n") {
            $len = $len - 1;
        } else {
            return substr($s, 0, $len);
        }
    }

    return "";
}

# Trim both ends
func trim(str $s) str {
    my int $len = length($s);
    if ($len == 0) {
        return "";
    }

    # Find start (skip leading whitespace)
    my int $start = 0;
    my int $found_start = 0;
    while ($start < $len && !$found_start) {
        my str $ch = substr($s, $start, 1);
        if ($ch eq " " || $ch eq "\t") {
            $start = $start + 1;
        } else {
            $found_start = 1;
        }
    }

    if ($start >= $len) {
        return "";
    }

    # Find end (skip trailing whitespace)
    my int $end = $len;
    my int $found_end = 0;
    while ($end > $start && !$found_end) {
        my str $ch = substr($s, $end - 1, 1);
        if ($ch eq " " || $ch eq "\t" || $ch eq "\r" || $ch eq "\n") {
            $end = $end - 1;
        } else {
            $found_end = 1;
        }
    }

    if ($start >= $end) {
        return "";
    }

    return substr($s, $start, $end - $start);
}

# Check if line is empty or comment
func is_empty_or_comment(str $line) int {
    my str $trimmed = YAML::trim($line);
    if (length($trimmed) == 0) {
        return 1;
    }
    if (substr($trimmed, 0, 1) eq "#") {
        return 1;
    }
    return 0;
}

func hex_val(str $ch) int {
    my int $o = ord($ch);
    if ($o >= 48 && $o <= 57) { return $o - 48; } # '0'-'9'
    if ($o >= 97 && $o <= 102) { return $o - 97 + 10; } # 'a'-'f'
    if ($o >= 65 && $o <= 70) { return $o - 65 + 10; } # 'A'-'F'
    return -1;
}

# Value of $n hex digits of $s starting at $start, or -1 if any is missing/invalid
func hex_digits_val(str $s, int $start, int $n) int {
    if ($start + $n > length($s)) {
        return -1;
    }
    my int $v = 0;
    my int $k = 0;
    while ($k < $n) {
        my int $h = YAML::hex_val(substr($s, $start + $k, 1));
        if ($h < 0) {
            return -1;
        }
        $v = $v * 16 + $h;
        $k = $k + 1;
    }
    return $v;
}

# Process escape sequences in double-quoted strings
func process_escapes(str $s) str {
    my str $result = "";
    my int $len = length($s);
    my int $i = 0;

    while ($i < $len) {
        my str $ch = substr($s, $i, 1);

        if ($ch eq "\\" && $i + 1 < $len) {
            my str $next = substr($s, $i + 1, 1);

            if ($next eq "n") {
                $result = $result . "\n";
                $i = $i + 2;
            } elsif ($next eq "t") {
                $result = $result . "\t";
                $i = $i + 2;
            } elsif ($next eq "r") {
                $result = $result . "\r";
                $i = $i + 2;
            } elsif ($next eq "\\") {
                $result = $result . "\\";
                $i = $i + 2;
            } elsif ($next eq "\"") {
                $result = $result . "\"";
                $i = $i + 2;
            } elsif ($next eq "0") {
                $result = $result . "\0";
                $i = $i + 2;
            } elsif ($next eq "/") {
                $result = $result . "/";
                $i = $i + 2;
            } elsif ($next eq "b") {
                # Backspace - ASCII 8
                $result = $result . chr(8);
                $i = $i + 2;
            } elsif ($next eq "f") {
                # Form feed - ASCII 12
                $result = $result . chr(12);
                $i = $i + 2;
            } elsif ($next eq "x" && $i + 3 < $len) {
                my int $h1 = YAML::hex_val(substr($s, $i + 2, 1));
                my int $h2 = YAML::hex_val(substr($s, $i + 3, 1));
                if ($h1 >= 0 && $h2 >= 0) {
                    $result = $result . chr($h1 * 16 + $h2);
                    $i = $i + 4;
                } else {
                    $result = $result . $ch;
                    $i = $i + 1;
                }
            } elsif ($next eq "u" || $next eq "U") {
                # \uXXXX / \UXXXXXXXX (a \u surrogate pair is combined)
                my int $nd = ($next eq "u") ? 4 : 8;
                my int $cp = YAML::hex_digits_val($s, $i + 2, $nd);
                if ($cp < 0) {
                    throw "YAML parse error: invalid \\" . $next . " escape in double-quoted string";
                }
                $i = $i + 2 + $nd;
                if ($cp >= 0xD800 && $cp <= 0xDBFF && $i + 5 < $len &&
                    substr($s, $i, 2) eq "\\u") {
                    my int $lo = YAML::hex_digits_val($s, $i + 2, 4);
                    if ($lo >= 0xDC00 && $lo <= 0xDFFF) {
                        $cp = 0x10000 + ($cp - 0xD800) * 1024 + ($lo - 0xDC00);
                        $i = $i + 6;
                    }
                }
                if ($cp > 0x10FFFF) {
                    throw "YAML parse error: invalid \\U escape in double-quoted string";
                }
                $result = $result . chr($cp);
            } elsif ($next eq "N") {
                $result = $result . chr(0x85);
                $i = $i + 2;
            } elsif ($next eq "_") {
                $result = $result . chr(0xA0);
                $i = $i + 2;
            } elsif ($next eq "L") {
                $result = $result . chr(0x2028);
                $i = $i + 2;
            } elsif ($next eq "P") {
                $result = $result . chr(0x2029);
                $i = $i + 2;
            } elsif ($next eq "e") {
                $result = $result . chr(27);
                $i = $i + 2;
            } elsif ($next eq "a") {
                $result = $result . chr(7);
                $i = $i + 2;
            } elsif ($next eq "v") {
                $result = $result . chr(11);
                $i = $i + 2;
            } elsif ($next eq " ") {
                $result = $result . " ";
                $i = $i + 2;
            } elsif ($next eq "\t") {
                $result = $result . "\t";
                $i = $i + 2;
            } else {
                # Unknown escape, keep as-is
                $result = $result . $ch;
                $i = $i + 1;
            }
        } else {
            $result = $result . $ch;
            $i = $i + 1;
        }
    }

    return $result;
}

# Strip trailing # comment outside quotes (when preceded by whitespace/SOL/closing quote)
func strip_comment(str $s) str {
    my int $len = length($s);
    my int $i = 0;
    my int $in_single = 0;
    my int $in_double = 0;
    my int $just_closed_quote = 0;

    while ($i < $len) {
        my str $ch = substr($s, $i, 1);

        if ($in_single) {
            if ($ch eq "'") {
                if ($i + 1 < $len && substr($s, $i + 1, 1) eq "'") {
                    $i = $i + 2;
                    next;
                }
                $in_single = 0;
                $just_closed_quote = 1;
            }
            $i = $i + 1;
            next;
        }

        if ($in_double) {
            if ($ch eq "\\" && $i + 1 < $len) {
                $i = $i + 2;
                next;
            }
            if ($ch eq "\"") {
                $in_double = 0;
                $just_closed_quote = 1;
            }
            $i = $i + 1;
            next;
        }

        if ($ch eq "'") {
            $in_single = 1;
            $just_closed_quote = 0;
            $i = $i + 1;
            next;
        }
        if ($ch eq "\"") {
            $in_double = 1;
            $just_closed_quote = 0;
            $i = $i + 1;
            next;
        }

        if ($ch eq "#") {
            if ($i == 0 || $just_closed_quote) {
                return YAML::trim(substr($s, 0, $i));
            }
            my str $prev = substr($s, $i - 1, 1);
            if ($prev eq " " || $prev eq "\t") {
                return YAML::trim(substr($s, 0, $i));
            }
        }

        $just_closed_quote = 0;
        $i = $i + 1;
    }

    return YAML::trim($s);
}

# Find YAML mapping colon (outside quotes/brackets, followed by space/tab or EOL)
func find_mapping_colon(str $s) int {
    my int $len = length($s);
    if ($len == 0) {
        return -1;
    }
    my str $first = substr($s, 0, 1);
    if ($first eq "{" || $first eq "[") {
        return -1;
    }

    my int $i = 0;
    if ($first eq "'") {
        $i = 1;
        while ($i < $len) {
            my str $ch = substr($s, $i, 1);
            if ($ch eq "'") {
                if ($i + 1 < $len && substr($s, $i + 1, 1) eq "'") {
                    $i = $i + 2;
                    next;
                }
                $i = $i + 1;
                last;
            }
            $i = $i + 1;
        }
        while ($i < $len && (substr($s, $i, 1) eq " " || substr($s, $i, 1) eq "\t")) {
            $i = $i + 1;
        }
        if ($i < $len && substr($s, $i, 1) eq ":") {
            if ($i + 1 == $len || substr($s, $i + 1, 1) eq " " || substr($s, $i + 1, 1) eq "\t") {
                return $i;
            }
        }
        return -1;
    }

    if ($first eq "\"") {
        $i = 1;
        while ($i < $len) {
            my str $ch = substr($s, $i, 1);
            if ($ch eq "\\" && $i + 1 < $len) {
                $i = $i + 2;
                next;
            }
            if ($ch eq "\"") {
                $i = $i + 1;
                last;
            }
            $i = $i + 1;
        }
        while ($i < $len && (substr($s, $i, 1) eq " " || substr($s, $i, 1) eq "\t")) {
            $i = $i + 1;
        }
        if ($i < $len && substr($s, $i, 1) eq ":") {
            if ($i + 1 == $len || substr($s, $i + 1, 1) eq " " || substr($s, $i + 1, 1) eq "\t") {
                return $i;
            }
        }
        return -1;
    }

    while ($i < $len) {
        my str $ch = substr($s, $i, 1);
        if ($ch eq ":" && $i > 0) {
            if ($i + 1 == $len) {
                return $i;
            }
            my str $nx = substr($s, $i + 1, 1);
            if ($nx eq " " || $nx eq "\t") {
                return $i;
            }
        }
        $i = $i + 1;
    }
    return -1;
}

private func scan_quoted_end(str $s, str $quote) int {
    my int $len = length($s);
    my int $i = 1;
    while ($i < $len) {
        my str $ch = substr($s, $i, 1);
        if ($quote eq "'") {
            if ($ch eq "'") {
                if ($i + 1 < $len && substr($s, $i + 1, 1) eq "'") {
                    $i = $i + 2;
                    next;
                }
                return $i;
            }
        } else {
            if ($ch eq "\\") {
                if ($i + 1 >= $len) {
                    return -1;
                }
                $i = $i + 2;
                next;
            }
            if ($ch eq "\"") {
                return $i;
            }
        }
        $i = $i + 1;
    }
    return -1;
}

# Unquote a YAML key if wrapped in single or double quotes
func unquote_key(str $k) str {
    my str $t = YAML::trim($k);
    my int $len = length($t);
    if ($len >= 1) {
        my str $f = substr($t, 0, 1);
        if ($f eq "'" || $f eq "\"") {
            my int $end_pos = YAML::scan_quoted_end($t, $f);
            if ($end_pos < 0) {
                throw "YAML parse error: unterminated quoted key";
            }
            if ($end_pos != $len - 1) {
                throw "YAML parse error: unexpected trailing content in quoted key";
            }
            my str $inner = substr($t, 1, $end_pos - 1);
            if ($f eq "'") {
                return replace_all($inner, "''", "'");
            }
            return YAML::process_escapes($inner);
        }
    }
    return $t;
}

# Parse a YAML value (handles quotes, numbers, booleans)
func parse_value(str $s) scalar {
    return YAML::parse_value_d($s, 0);
}

func parse_value_d(str $s, int $depth) scalar {
    if ($depth >= 64) {
        throw "YAML: maximum nesting depth (64) exceeded";
    }
    my str $trimmed = YAML::strip_comment($s);
    my int $len = length($trimmed);

    if ($len == 0) {
        # An empty node is null (YAML 1.1/1.2), as for "- " sequence entries
        return undef;
    }

    # Check for quoted string
    my str $first = substr($trimmed, 0, 1);
    if ($first eq "'" || $first eq "\"") {
        my int $end_pos = YAML::scan_quoted_end($trimmed, $first);
        if ($end_pos < 0) {
            throw "YAML parse error: unterminated quoted string";
        }
        if ($end_pos != $len - 1) {
            throw "YAML parse error: unexpected trailing content after quoted string";
        }
        my str $content = substr($trimmed, 1, $end_pos - 1);
        # Process escape sequences for double-quoted strings
        if ($first eq "\"") {
            return YAML::process_escapes($content);
        }
        return replace_all($content, "''", "'");
    }

    # Check for inline hash { ... }
    if ($first eq "{") {
        return YAML::parse_inline_hash_d($trimmed, $depth);
    }

    # Check for inline array [ ... ]
    if ($first eq "[") {
        return YAML::parse_inline_array_d($trimmed, $depth);
    }

    # Check for boolean/null values (case-insensitive YAML 1.1)
    my str $low = lc($trimmed);
    if ($low eq "true" || $low eq "yes" || $low eq "on") {
        return 1;
    }
    if ($low eq "false" || $low eq "no" || $low eq "off") {
        return 0;
    }
    if ($low eq "null" || $trimmed eq "~") {
        return undef;
    }

    # Check if it looks like a number
    if (YAML::looks_like_num($trimmed)) {
        if (index($trimmed, ".") < 0 && index($trimmed, "e") < 0 && index($trimmed, "E") < 0) {
            # 19+ digits may not fit int64: numify like Perl (IV -> UV -> NV)
            # instead of saturating
            my str $digits = $trimmed;
            my str $sg = substr($trimmed, 0, 1);
            if ($sg eq "-" || $sg eq "+") {
                $digits = substr($trimmed, 1, length($trimmed) - 1);
            }
            if (length($digits) >= 19) {
                return $trimmed + 0;
            }
            return cast_int($trimmed);
        }
        return $trimmed + 0;
    }

    return $trimmed;
}

# Parse a value that starts on the current line ($s) and may continue as a
# multi-line plain scalar: following lines indented more than $min_indent are
# folded in (a line break becomes a space, each blank line a newline), as in
# YAML 1.1/1.2. Quoted and flow values are parsed as single-line values.
func parse_value_folded(scalar $state, str $s, int $min_indent) scalar {
    my str $first = YAML::strip_comment($s);
    my str $c0 = substr($first, 0, 1);
    if (length($first) == 0 || $c0 eq "\"" || $c0 eq "'" || $c0 eq "[" || $c0 eq "{" ||
        length($first) != length(YAML::trim($s))) {
        # empty, quoted, flow, or the line ended in a comment
        return YAML::parse_value($s);
    }
    my scalar $lines = $state->{"lines"};
    my int $count = $state->{"count"};
    my int $p = $state->{"pos"};
    my str $folded = $first;
    my int $blanks = 0;
    my int $more = 0;
    while ($p < $count) {
        my str $ln = $lines->[$p];
        my str $t = YAML::trim($ln);
        if ($t eq "") {
            $blanks = $blanks + 1;
            $p = $p + 1;
            next;
        }
        my int $ind = YAML::get_indent($ln);
        if ($ind <= $min_indent || substr($t, 0, 1) eq "#") {
            last;
        }
        if ($ind == 0 && (YAML::is_doc_end($ln) == 1 || YAML::is_doc_start($ln) == 1)) {
            last;
        }
        my str $piece = YAML::strip_comment($t);
        if (YAML::find_mapping_colon($piece) > 0) {
            # "key: value" is not a continuation; leave it to the caller
            last;
        }
        if ($blanks == 0) {
            $folded = $folded . " ";
        } else {
            my int $b = 0;
            while ($b < $blanks) {
                $folded = $folded . "\n";
                $b = $b + 1;
            }
        }
        $folded = $folded . $piece;
        $blanks = 0;
        $more = 1;
        $p = $p + 1;
        $state->{"pos"} = $p;
        if (length($piece) != length($t)) {
            # a comment ends the scalar
            last;
        }
    }
    if ($more == 0) {
        return YAML::parse_value($s);
    }
    return $folded;
}

# Check if a string looks like a number (decimal int/float/scientific)
func looks_like_num(str $s) int {
    my int $len = length($s);
    if ($len == 0) {
        return 0;
    }

    my int $i = 0;
    my str $ch = substr($s, 0, 1);
    if ($ch eq "-" || $ch eq "+") {
        $i = 1;
        if ($len == 1) {
            return 0;
        }
    }

    my int $has_dot = 0;
    my int $has_exp = 0;
    my int $has_digit = 0;

    while ($i < $len) {
        $ch = substr($s, $i, 1);
        if ($ch ge "0" && $ch le "9") {
            $has_digit = 1;
        } elsif ($ch eq "." && !$has_dot && !$has_exp) {
            $has_dot = 1;
        } elsif (($ch eq "e" || $ch eq "E") && $has_digit && !$has_exp) {
            $has_exp = 1;
            $has_digit = 0;
            if ($i + 1 < $len) {
                my str $nx = substr($s, $i + 1, 1);
                if ($nx eq "+" || $nx eq "-") {
                    $i = $i + 1;
                }
            }
        } else {
            return 0;
        }
        $i = $i + 1;
    }

    return $has_digit;
}

# Parse inline hash { key: value, key2: value2 }
func verify_outer_flow_enclosure(str $s, str $open_ch, str $close_ch, str $kind) void {
    my int $len = length($s);
    if ($len < 2 || substr($s, 0, 1) ne $open_ch || substr($s, $len - 1, 1) ne $close_ch) {
        throw "YAML parse error: unclosed inline " . $kind;
    }
    my int $bdepth = 0;
    my int $sdepth = 0;
    my int $in_sq = 0;
    my int $in_dq = 0;
    my int $i = 0;
    while ($i < $len) {
        my str $ch = substr($s, $i, 1);
        if ($in_dq == 1) {
            if ($ch eq "\\") {
                $i = $i + 2;
                next;
            }
            if ($ch eq "\"") { $in_dq = 0; }
        } elsif ($in_sq == 1) {
            if ($ch eq "'") {
                if ($i + 1 < $len && substr($s, $i + 1, 1) eq "'") {
                    $i = $i + 2;
                    next;
                }
                $in_sq = 0;
            }
        } else {
            if ($ch eq "\"") {
                $in_dq = 1;
            } elsif ($ch eq "'") {
                $in_sq = 1;
            } elsif ($ch eq "{") {
                $bdepth = $bdepth + 1;
            } elsif ($ch eq "}") {
                $bdepth = $bdepth - 1;
                if ($bdepth < 0) {
                    throw "YAML parse error: unexpected '}' in inline " . $kind;
                }
            } elsif ($ch eq "[") {
                $sdepth = $sdepth + 1;
            } elsif ($ch eq "]") {
                $sdepth = $sdepth - 1;
                if ($sdepth < 0) {
                    throw "YAML parse error: unexpected ']' in inline " . $kind;
                }
            }
            if ($i < $len - 1 && $bdepth == 0 && $sdepth == 0) {
                throw "YAML parse error: trailing content after inline " . $kind;
            }
        }
        $i = $i + 1;
    }
    if ($in_dq == 1 || $in_sq == 1) {
        throw "YAML parse error: unterminated quoted string in inline " . $kind;
    }
    if ($bdepth != 0 || $sdepth != 0) {
        throw "YAML parse error: unclosed inline " . $kind;
    }
}

func split_inline_items(str $s) array {
    my array @items = ();
    my str $trimmed = YAML::trim($s);
    if (length($trimmed) == 0) {
        return @items;
    }
    my int $len = length($s);
    my int $i = 0;
    my int $start = 0;
    my int $brace_depth = 0;
    my int $bracket_depth = 0;
    my int $in_sq = 0;
    my int $in_dq = 0;

    while ($i < $len) {
        my str $ch = substr($s, $i, 1);
        if ($in_dq == 1) {
            if ($ch eq "\\") {
                $i = $i + 2;
                next;
            }
            if ($ch eq "\"") {
                $in_dq = 0;
            }
        } elsif ($in_sq == 1) {
            if ($ch eq "'") {
                if ($i + 1 < $len && substr($s, $i + 1, 1) eq "'") {
                    $i = $i + 2;
                    next;
                }
                $in_sq = 0;
            }
        } else {
            if ($ch eq "\"") {
                $in_dq = 1;
            } elsif ($ch eq "'") {
                $in_sq = 1;
            } elsif ($ch eq "{") {
                $brace_depth = $brace_depth + 1;
            } elsif ($ch eq "}") {
                $brace_depth = $brace_depth - 1;
                if ($brace_depth < 0) {
                    throw "YAML parse error: unexpected '}' in inline collection";
                }
            } elsif ($ch eq "[") {
                $bracket_depth = $bracket_depth + 1;
            } elsif ($ch eq "]") {
                $bracket_depth = $bracket_depth - 1;
                if ($bracket_depth < 0) {
                    throw "YAML parse error: unexpected ']' in inline collection";
                }
            } elsif ($ch eq "," && $brace_depth == 0 && $bracket_depth == 0) {
                push(@items, substr($s, $start, $i - $start));
                $start = $i + 1;
            }
        }
        $i = $i + 1;
    }
    if ($in_dq == 1 || $in_sq == 1) {
        throw "YAML parse error: unterminated quoted string in inline collection";
    }
    if ($brace_depth != 0 || $bracket_depth != 0) {
        throw "YAML parse error: unclosed inline collection";
    }
    push(@items, substr($s, $start, $len - $start));
    return @items;
}

func parse_inline_hash(str $s) scalar {
    return YAML::parse_inline_hash_d($s, 0);
}

func parse_inline_hash_d(str $s, int $depth) scalar {
    if ($depth >= 64) {
        throw "YAML: maximum nesting depth (64) exceeded";
    }
    YAML::verify_outer_flow_enclosure($s, "{", "}", "mapping");
    my scalar $result = {};
    my int $len = length($s);
    $s = substr($s, 1, $len - 2);

    my array @parts = YAML::split_inline_items($s);
    my int $count = size(@parts);
    my int $i = 0;

    while ($i < $count) {
        my str $part = YAML::trim($parts[$i]);

        # Find the colon outside quotes
        my int $colon_pos = YAML::find_mapping_colon($part);
        if ($colon_pos > 0) {
            my str $key = YAML::unquote_key(substr($part, 0, $colon_pos));
            my str $val_str = "";
            if ($colon_pos + 1 < length($part)) {
                $val_str = substr($part, $colon_pos + 1, length($part) - $colon_pos - 1);
            }
            my scalar $val = YAML::parse_value_d($val_str, $depth + 1);
            $result->{$key} = $val;
        } elsif (length($part) > 0) {
            throw "YAML parse error: invalid entry in inline mapping: " . $part;
        } elsif ($i < $count - 1) {
            throw "YAML parse error: empty entry in inline mapping";
        }

        $i = $i + 1;
    }

    return $result;
}

# Parse inline array [ item1, item2 ]
func parse_inline_array(str $s) scalar {
    return YAML::parse_inline_array_d($s, 0);
}

func parse_inline_array_d(str $s, int $depth) scalar {
    if ($depth >= 64) {
        throw "YAML: maximum nesting depth (64) exceeded";
    }
    YAML::verify_outer_flow_enclosure($s, "[", "]", "sequence");
    my scalar $result = [];
    my int $len = length($s);
    $s = substr($s, 1, $len - 2);

    my array @parts = YAML::split_inline_items($s);
    my int $count = size(@parts);
    my int $i = 0;

    while ($i < $count) {
        my str $part = YAML::trim($parts[$i]);
        if (length($part) > 0) {
            push($result, YAML::parse_value_d($part, $depth + 1));
        }
        $i = $i + 1;
    }

    return $result;
}

func is_doc_start(str $line) int {
    if (YAML::get_indent($line) != 0) { return 0; }
    my str $c = YAML::trim(YAML::strip_comment($line));
    if ($c eq "---") { return 1; }
    if (length($c) >= 4 && (substr($c, 0, 4) eq "--- " || substr($c, 0, 4) eq "---\t")) {
        return 1;
    }
    return 0;
}

func is_doc_end(str $line) int {
    if (YAML::get_indent($line) != 0) { return 0; }
    my str $c = YAML::trim(YAML::strip_comment($line));
    if ($c eq "...") { return 1; }
    if (length($c) >= 4 && (substr($c, 0, 4) eq "... " || substr($c, 0, 4) eq "...\t")) {
        return 1;
    }
    return 0;
}

# Main YAML Load function - parse YAML string into Strada data structure
func Load(str $yaml) scalar {
    # limit -1 keeps trailing blank lines (needed by "|+" keep chomping)
    my array @lines = split("\n", $yaml, -1);
    if (length($yaml) > 0 && substr($yaml, length($yaml) - 1, 1) eq "\n" &&
        size(@lines) > 0 && $lines[size(@lines) - 1] eq "") {
        pop(@lines);
    }
    my int $line_count = size(@lines);

    # Index for tracking current position
    my scalar $state = {
        "lines" => \@lines,
        "count" => $line_count,
        "pos" => 0
    };

    # Skip leading empty/comment lines and consume document start marker (---)
    while ($state->{"pos"} < $line_count && YAML::is_empty_or_comment($lines[$state->{"pos"}])) {
        $state->{"pos"} = $state->{"pos"} + 1;
    }
    if ($state->{"pos"} < $line_count && YAML::is_doc_start($lines[$state->{"pos"}]) == 1) {
        my str $doc_clean = YAML::trim(YAML::strip_comment($lines[$state->{"pos"}]));
        $state->{"pos"} = $state->{"pos"} + 1;
        if (length($doc_clean) > 3) {
            my str $after_doc = YAML::trim(substr($doc_clean, 3, length($doc_clean) - 3));
            if (length($after_doc) > 0) {
                if (YAML::is_block_scalar_spec($after_doc) == 1) {
                    return YAML::parse_block_scalar($state, 0 - 1, $after_doc);
                }
                return YAML::parse_value($after_doc);
            }
        }
    }

    my scalar $doc = YAML::parse_block($state, 0);
    # Everything up to the end of the document must have been consumed
    while ($state->{"pos"} < $line_count && YAML::is_empty_or_comment($lines[$state->{"pos"}])) {
        $state->{"pos"} = $state->{"pos"} + 1;
    }
    if ($state->{"pos"} < $line_count && YAML::is_doc_end($lines[$state->{"pos"}]) == 0 &&
        YAML::is_doc_start($lines[$state->{"pos"}]) == 0) {
        throw "YAML parse error: unexpected content at line " . ($state->{"pos"} + 1);
    }
    return $doc;
}

# Parse a block of YAML at a given indentation level
func parse_block(scalar $state, int $base_indent) scalar {
    my int $depth = 0;
    if (defined($state->{"depth"})) {
        $depth = $state->{"depth"} + 0;
    }
    if ($depth >= 64) {
        throw "YAML: maximum nesting depth (64) exceeded";
    }
    $state->{"depth"} = $depth + 1;
    my scalar $res = YAML::parse_block_inner($state, $base_indent);
    $state->{"depth"} = $depth;
    return $res;
}

func parse_block_inner(scalar $state, int $base_indent) scalar {
    my scalar $lines = $state->{"lines"};
    my int $count = $state->{"count"};

    # Skip empty/comment lines and find first real line
    my int $found = 0;
    while ($state->{"pos"} < $count && !$found) {
        my str $line = $lines->[$state->{"pos"}];
        if (YAML::is_empty_or_comment($line)) {
            $state->{"pos"} = $state->{"pos"} + 1;
        } else {
            $found = 1;
        }
    }

    if ($state->{"pos"} >= $count) {
        return undef;
    }

    my str $first_line = $lines->[$state->{"pos"}];
    if (YAML::is_doc_end($first_line) == 1 || YAML::is_doc_start($first_line) == 1) {
        return undef;
    }
    my int $indent = YAML::get_indent($first_line);
    my str $content = YAML::trim($first_line);

    # Check if this line starts an array (- prefix)
    if (substr($content, 0, 2) eq "- ") {
        return YAML::parse_array($state, $indent);
    }
    if ($content eq "-") {
        return YAML::parse_array($state, $indent);
    }

    # Check if this line is a key: value
    my int $colon_pos = YAML::find_mapping_colon($content);
    if ($colon_pos > 0) {
        return YAML::parse_hash($state, $indent);
    }

    # Simple value (a multi-line plain scalar continues on lines indented
    # at least as far as the block)
    $state->{"pos"} = $state->{"pos"} + 1;
    return YAML::parse_value_folded($state, $content, $base_indent - 1);
}

# Parse a hash (key: value pairs)
func parse_hash(scalar $state, int $base_indent) scalar {
    my scalar $result = {};
    my scalar $lines = $state->{"lines"};
    my int $count = $state->{"count"};

    while ($state->{"pos"} < $count) {
        my str $line = $lines->[$state->{"pos"}];

        # Skip empty/comment lines
        if (YAML::is_empty_or_comment($line)) {
            $state->{"pos"} = $state->{"pos"} + 1;
            next;
        }

        if (YAML::is_doc_end($line) == 1 || YAML::is_doc_start($line) == 1) {
            return $result;
        }

        my int $indent = YAML::get_indent($line);

        # If indent is less than base, we're done with this block
        if ($indent < $base_indent) {
            return $result;
        }

        my str $content = YAML::trim($line);

        # Parse key: value
        my int $colon_pos = YAML::find_mapping_colon($content);
        if ($colon_pos <= 0) {
            # A line at or inside this mapping that is not "key: value"
            # (continuation lines were already folded into the value)
            throw "YAML parse error: unexpected content at line " . ($state->{"pos"} + 1);
        }

        my str $key = YAML::unquote_key(substr($content, 0, $colon_pos));
        my str $after_colon = "";
        if ($colon_pos + 1 < length($content)) {
            $after_colon = substr($content, $colon_pos + 1, length($content) - $colon_pos - 1);
        }
        $after_colon = YAML::strip_comment($after_colon);

        $state->{"pos"} = $state->{"pos"} + 1;

        if (length($after_colon) > 0) {
            # Value on same line
            if (YAML::is_block_scalar_spec($after_colon) == 1) {
                $result->{$key} = YAML::parse_block_scalar($state, $indent, $after_colon);
            } else {
                $result->{$key} = YAML::parse_value_folded($state, $after_colon, $indent);
            }
        } else {
            # Value might be on next lines (nested structure)
            # Look ahead to see what's next
            while ($state->{"pos"} < $count && YAML::is_empty_or_comment($lines->[$state->{"pos"}])) {
                $state->{"pos"} = $state->{"pos"} + 1;
            }

            if ($state->{"pos"} < $count) {
                my str $next_line = $lines->[$state->{"pos"}];
                my int $next_indent = YAML::get_indent($next_line);
                my str $next_trim = YAML::trim($next_line);

                if ($next_indent > $indent || ($next_indent == $indent && (substr($next_trim, 0, 2) eq "- " || $next_trim eq "-"))) {
                    # Nested block (including indentless YAML sequences at same indent)
                    $result->{$key} = YAML::parse_block($state, $next_indent);
                } else {
                    # Empty value
                    $result->{$key} = undef;
                }
            } else {
                $result->{$key} = undef;
            }
        }
    }

    return $result;
}

# Parse an array (- prefixed items)
func parse_array(scalar $state, int $base_indent) scalar {
    my scalar $result = [];
    my scalar $lines = $state->{"lines"};
    my int $count = $state->{"count"};

    while ($state->{"pos"} < $count) {
        my str $line = $lines->[$state->{"pos"}];

        # Skip empty/comment lines
        if (YAML::is_empty_or_comment($line)) {
            $state->{"pos"} = $state->{"pos"} + 1;
            next;
        }

        if (YAML::is_doc_end($line) == 1 || YAML::is_doc_start($line) == 1) {
            return $result;
        }

        my int $indent = YAML::get_indent($line);

        # If indent is less than base, we're done with this block
        if ($indent < $base_indent) {
            return $result;
        }

        my str $content = YAML::trim($line);

        # Must start with "- " or be bare "-"
        if (substr($content, 0, 2) ne "- " && $content ne "-") {
            return $result;
        }

        # Get content after - (and the column it starts at)
        my str $after_dash = "";
        my int $key_col = $indent + 2;
        if (length($content) > 1) {
            $after_dash = substr($content, 1, length($content) - 1);
            my int $ws = 0;
            while ($ws < length($after_dash) && (substr($after_dash, $ws, 1) eq " " || substr($after_dash, $ws, 1) eq "\t")) {
                $ws = $ws + 1;
            }
            $key_col = $indent + 1 + $ws;
            $after_dash = substr($after_dash, $ws, length($after_dash) - $ws);
        }
        $after_dash = YAML::strip_comment($after_dash);

        $state->{"pos"} = $state->{"pos"} + 1;

        if (substr($after_dash, 0, 2) eq "- " || $after_dash eq "-") {
            # Compact nested sequence ("- - x"): the entry is a block sequence
            # whose first item sits on this line at column $key_col
            $state->{"pos"} = $state->{"pos"} - 1;
            my str $raw_line = $lines->[$state->{"pos"}];
            $lines->[$state->{"pos"}] = YAML::make_indent($key_col) . substr($raw_line, $key_col, length($raw_line) - $key_col);
            push($result, YAML::parse_block($state, $key_col));
            next;
        }

        if (length($after_dash) > 0) {
            # Check if after dash is an inline hash or a mapping entry (colon followed by space/tab/EOL outside quotes)
            my int $colon_pos = YAML::find_mapping_colon($after_dash);
            if (substr($after_dash, 0, 1) eq "{") {
                # Inline hash
                push($result, YAML::parse_inline_hash($after_dash));
            } elsif ($colon_pos > 0) {
                # This is a hash entry starting on the - line
                # Parse as nested hash
                my scalar $item = {};
                my str $key = YAML::unquote_key(substr($after_dash, 0, $colon_pos));
                my str $val_str = "";
                if ($colon_pos + 1 < length($after_dash)) {
                    $val_str = YAML::strip_comment(substr($after_dash, $colon_pos + 1, length($after_dash) - $colon_pos - 1));
                }

                if (length($val_str) > 0) {
                    if (YAML::is_block_scalar_spec($val_str) == 1) {
                        $item->{$key} = YAML::parse_block_scalar($state, $key_col, $val_str);
                    } else {
                        $item->{$key} = YAML::parse_value_folded($state, $val_str, $key_col);
                    }
                } else {
                    my int $look = $state->{"pos"};
                    while ($look < $count && YAML::is_empty_or_comment($lines->[$look]) == 1) {
                        $look = $look + 1;
                    }
                    if ($look < $count) {
                        my int $sub_indent = YAML::get_indent($lines->[$look]);
                        my str $sub_trim = YAML::trim($lines->[$look]);
                        my int $sub_is_arr = (substr($sub_trim, 0, 2) eq "- " || $sub_trim eq "-") ? 1 : 0;
                        if (($sub_is_arr == 1 && $sub_indent > $indent) || $sub_indent > $indent + 2) {
                            $state->{"pos"} = $look;
                            $item->{$key} = YAML::parse_block($state, $sub_indent);
                        } else {
                            $item->{$key} = undef;
                        }
                    } else {
                        $item->{$key} = undef;
                    }
                }

                # Check for more key:value pairs at higher indent
                my int $done_item = 0;
                while ($state->{"pos"} < $count && !$done_item) {
                    my str $next_line = $lines->[$state->{"pos"}];
                    if (YAML::is_empty_or_comment($next_line)) {
                        $state->{"pos"} = $state->{"pos"} + 1;
                    } else {
                        my int $next_indent = YAML::get_indent($next_line);
                        if ($next_indent <= $indent) {
                            $done_item = 1;
                        } else {
                            my str $next_content = YAML::trim($next_line);
                            my int $next_colon = YAML::find_mapping_colon($next_content);
                            if ($next_colon > 0) {
                                my str $next_key = YAML::unquote_key(substr($next_content, 0, $next_colon));
                                my str $next_val_str = "";
                                if ($next_colon + 1 < length($next_content)) {
                                    $next_val_str = YAML::strip_comment(substr($next_content, $next_colon + 1, length($next_content) - $next_colon - 1));
                                }

                                $state->{"pos"} = $state->{"pos"} + 1;

                                if (length($next_val_str) > 0) {
                                    if (YAML::is_block_scalar_spec($next_val_str) == 1) {
                                        $item->{$next_key} = YAML::parse_block_scalar($state, $next_indent, $next_val_str);
                                    } else {
                                        $item->{$next_key} = YAML::parse_value_folded($state, $next_val_str, $next_indent);
                                    }
                                } else {
                                    # Check for nested structure
                                    while ($state->{"pos"} < $count && YAML::is_empty_or_comment($lines->[$state->{"pos"}])) {
                                        $state->{"pos"} = $state->{"pos"} + 1;
                                    }
                                    if ($state->{"pos"} < $count) {
                                        my str $sub_line = $lines->[$state->{"pos"}];
                                        my int $sub_indent = YAML::get_indent($sub_line);
                                        my str $sub_trim = YAML::trim($sub_line);
                                        if ($sub_indent > $next_indent || ($sub_indent == $next_indent && (substr($sub_trim, 0, 2) eq "- " || $sub_trim eq "-"))) {
                                            $item->{$next_key} = YAML::parse_block($state, $sub_indent);
                                        } else {
                                            $item->{$next_key} = undef;
                                        }
                                    } else {
                                        $item->{$next_key} = undef;
                                    }
                                }
                            } else {
                                $done_item = 1;
                            }
                        }
                    }
                }

                push($result, $item);
            } elsif (YAML::is_block_scalar_spec($after_dash) == 1) {
                push($result, YAML::parse_block_scalar($state, $indent, $after_dash));
            } else {
                # Simple value
                push($result, YAML::parse_value_folded($state, $after_dash, $indent));
            }
        } else {
            # Check next line for nested content
            while ($state->{"pos"} < $count && YAML::is_empty_or_comment($lines->[$state->{"pos"}])) {
                $state->{"pos"} = $state->{"pos"} + 1;
            }

            if ($state->{"pos"} < $count) {
                my str $next_line = $lines->[$state->{"pos"}];
                my int $next_indent = YAML::get_indent($next_line);

                if ($next_indent > $indent) {
                    push($result, YAML::parse_block($state, $next_indent));
                } else {
                    push($result, undef);
                }
            } else {
                push($result, undef);
            }
        }
    }

    return $result;
}

# Internal: read raw block scalar text along with leading/trailing blank metadata
private func _read_block_scalar_raw(scalar $state, int $base_indent, int $explicit_indent) hash {
    my str $result = "";
    my scalar $lines = $state->{"lines"};
    my int $count = $state->{"count"};
    my int $block_indent = -1;
    my int $leading_blanks = 0;
    my int $trailing_blanks = 0;
    my int $has_content = 0;

    while ($state->{"pos"} < $count) {
        my str $line = $lines->[$state->{"pos"}];
        my int $llen = length($line);
        if ($llen > 0 && substr($line, $llen - 1, 1) eq "\r") {
            $line = substr($line, 0, $llen - 1);
        }
        my int $indent = YAML::get_indent($line);

        # Empty / whitespace-only lines inside block scalar
        if (YAML::trim($line) eq "") {
            if ($block_indent < 0) {
                $leading_blanks = $leading_blanks + 1;
            } else {
                $trailing_blanks = $trailing_blanks + 1;
            }
            $state->{"pos"} = $state->{"pos"} + 1;
            next;
        }

        # Check if we've exited the block (including empty block before next key at <= base_indent
        # or document start/end markers at column 0)
        if ($indent <= $base_indent) {
            last;
        }
        if ($indent == 0 && (YAML::is_doc_end($line) == 1 || YAML::is_doc_start($line) == 1)) {
            last;
        }

        # Set block indent on first content line
        if ($block_indent < 0) {
            $block_indent = $indent;
            if ($explicit_indent > 0) {
                if ($indent < $explicit_indent) {
                    throw "YAML parse error: block scalar line indented less than block indent";
                }
                $block_indent = $explicit_indent;
            }
            my int $lb = 0;
            while ($lb < $leading_blanks) {
                $result = $result . "\n";
                $lb = $lb + 1;
            }
        } else {
            if ($indent < $block_indent) {
                if (substr(YAML::trim($line), 0, 1) eq "#") {
                    last;
                }
                throw "YAML parse error: block scalar line indented less than block indent";
            }
            my int $tb = 0;
            while ($tb <= $trailing_blanks) {
                $result = $result . "\n";
                $tb = $tb + 1;
            }
            $trailing_blanks = 0;
        }

        $has_content = 1;
        $result = $result . substr($line, $block_indent, length($line) - $block_indent);
        $state->{"pos"} = $state->{"pos"} + 1;
    }

    my hash %info = ();
    $info{"raw"} = $result;
    $info{"has_content"} = $has_content;
    $info{"leading_blanks"} = $leading_blanks;
    $info{"trailing_blanks"} = $trailing_blanks;
    return %info;
}

# Parse literal block (|)
func parse_literal_block(scalar $state, int $base_indent) str {
    return YAML::parse_block_scalar($state, $base_indent, "|");
}

func clean_block_spec(str $s) str {
    return YAML::trim(YAML::strip_comment($s));
}

# Block scalar header: "|" or ">" then an optional indentation indicator
# (1-9) and an optional chomping indicator (+/-), in either order.
# Returns [chomp, explicit_indent] (indent 0 = auto-detect) or undef.
func parse_block_header(str $s) scalar {
    my str $c = YAML::clean_block_spec($s);
    my int $len = length($c);
    if ($len == 0 || $len > 3) {
        return undef;
    }
    my str $style = substr($c, 0, 1);
    if ($style ne "|" && $style ne ">") {
        return undef;
    }
    my str $chomp = "";
    my int $ind = 0;
    my int $i = 1;
    while ($i < $len) {
        my str $ch = substr($c, $i, 1);
        if (($ch eq "+" || $ch eq "-") && $chomp eq "") {
            $chomp = $ch;
        } elsif ($ch ge "1" && $ch le "9" && $ind == 0) {
            $ind = ord($ch) - 48;
        } else {
            return undef;
        }
        $i = $i + 1;
    }
    return [$chomp, $ind];
}

func is_block_scalar_spec(str $s) int {
    if (defined(YAML::parse_block_header($s))) {
        return 1;
    }
    return 0;
}

func parse_block_scalar(scalar $state, int $base_indent, str $spec) str {
    $spec = YAML::clean_block_spec($spec);
    my int $is_folded = (substr($spec, 0, 1) eq ">") ? 1 : 0;
    my scalar $hdr = YAML::parse_block_header($spec);
    if (!defined($hdr)) {
        throw "YAML parse error: invalid block scalar header '" . $spec . "'";
    }
    my str $chomp = $hdr->[0];
    my int $explicit = 0;
    if ($hdr->[1] > 0) {
        # Indentation indicator: content indent relative to the parent node
        $explicit = (($base_indent >= 0) ? $base_indent : 0) + $hdr->[1];
    }
    my hash %info = YAML::_read_block_scalar_raw($state, $base_indent, $explicit);
    my int $has_content = $info{"has_content"};
    if ($has_content == 0) {
        if ($chomp eq "+") {
            my str $bl = "";
            my int $bi = 0;
            while ($bi < $info{"leading_blanks"}) {
                $bl = $bl . "\n";
                $bi = $bi + 1;
            }
            return $bl;
        }
        return "";
    }

    my str $raw = $info{"raw"};
    my str $out = $raw;
    if ($is_folded == 1 && length($raw) > 0) {
        my array @lines = split("\n", $raw);
        my str $folded = "";
        my int $n = size(@lines);
        my int $li = 0;
        my int $blanks = 0;
        my int $seen = 0;
        my int $prev_more = 0;
        while ($li < $n) {
            my str $ln = $lines[$li];
            if (length($ln) == 0) {
                $blanks = $blanks + 1;
            } else {
                # Lines indented more than the block (starting with
                # whitespace) are not folded: their line breaks are kept
                my str $lc0 = substr($ln, 0, 1);
                my int $more = ($lc0 eq " " || $lc0 eq "\t") ? 1 : 0;
                if ($seen == 0) {
                    my int $b0 = 0;
                    while ($b0 < $blanks) {
                        $folded = $folded . "\n";
                        $b0 = $b0 + 1;
                    }
                } elsif ($blanks == 0 && $more == 0 && $prev_more == 0) {
                    $folded = $folded . " ";
                } else {
                    my int $nb = $blanks;
                    if ($more == 1 || $prev_more == 1) {
                        $nb = $nb + 1;
                    }
                    my int $b1 = 0;
                    while ($b1 < $nb) {
                        $folded = $folded . "\n";
                        $b1 = $b1 + 1;
                    }
                }
                $folded = $folded . $ln;
                $blanks = 0;
                $seen = 1;
                $prev_more = $more;
            }
            $li = $li + 1;
        }
        $out = $folded;
    }

    if ($chomp eq "-") {
        return $out;
    }
    if ($chomp eq "+") {
        my int $tb = 0;
        while ($tb <= $info{"trailing_blanks"}) {
            $out = $out . "\n";
            $tb = $tb + 1;
        }
        return $out;
    }
    return $out . "\n";
}

# ============================================================
# YAML Dumping
# ============================================================

# Dump a Strada data structure to YAML string
func Dump(scalar $data) str {
    return YAML::dump_value($data, 0);
}

# Dump a value with indentation
func dump_value(scalar $value, int $indent) str {
    return YAML::dump_value_d($value, $indent, 0);
}

private func _unwrap_tied_scalar(scalar $v) scalar {
    my scalar $cur = $v;
    __C__ {
        for (int depth = 0; depth < 16 && cur && !STRADA_IS_TAGGED_INT(cur) &&
             cur->meta && cur->meta->is_tied &&
             cur->type != STRADA_ARRAY && cur->type != STRADA_HASH; depth++) {
            StradaValue *fetched = strada_tied_scalar_fetch(cur);
            strada_decref(cur);
            cur = fetched ? fetched : strada_new_undef();
        }
    }
    return $cur;
}

func dump_value_d(scalar $value_in, int $indent, int $depth) str {
    if ($depth >= 64 || $indent > 512) {
        throw "YAML: maximum nesting depth (64) exceeded";
    }
    # A fresh local, not `$value_in = ...`: assigning to a tied parameter
    # would STORE into the caller's tied scalar instead of rebinding.
    my scalar $value = YAML::_unwrap_tied_scalar($value_in);
    if (!defined($value)) {
        return "~";
    }

    my str $rtype = ref($value);

    if ($rtype eq "HASH") {
        if ($depth == 0 && size(keys($value)) == 0) {
            # Empty top-level mapping: flow form so it loads back as {}
            return "{}\n";
        }
        return YAML::dump_hash_d($value, $indent, $depth);
    }

    if ($rtype eq "ARRAY") {
        if ($depth == 0 && size($value) == 0) {
            return "[]\n";
        }
        return YAML::dump_array_d($value, $indent, $depth);
    }

    # Scalar value
    my str $vtype = typeof($value);
    my str $str_val = "" . $value;
    if ($vtype eq "int" || $vtype eq "num") {
        return $str_val;
    }

    # Strings containing control characters use double-quoted escapes
    if (YAML::has_control_char($str_val)) {
        return "\"" . YAML::escape_double_quote($str_val) . "\"";
    }

    # Check if string needs quoting
    if (YAML::needs_quote($str_val)) {
        return "'" . YAML::escape_single_quote($str_val) . "'";
    }

    return $str_val;
}

func has_control_char(str $s) int {
    my int $blen = core::byte_length($s);
    my int $i = 0;
    while ($i < $blen) {
        my int $b = core::get_byte($s, $i);
        if ($b < 32 || $b == 127) {
            return 1;
        }
        $i = $i + 1;
    }
    return 0;
}

# Escape double-quoted YAML strings
func escape_double_quote(str $s) str {
    my str $result = "";
    my str $hex = "0123456789abcdef";
    my int $blen = core::byte_length($s);
    my int $start = 0;
    my int $i = 0;
    while ($i < $blen) {
        my int $b = core::get_byte($s, $i);
        my str $esc = "";
        if ($b == 92) { # '\\'
            $esc = "\\\\";
        } elsif ($b == 34) { # '"'
            $esc = "\\\"";
        } elsif ($b == 0) { # '\0'
            $esc = "\\0";
        } elsif ($b == 8) { # '\b'
            $esc = "\\b";
        } elsif ($b == 9) { # '\t'
            $esc = "\\t";
        } elsif ($b == 10) { # '\n'
            $esc = "\\n";
        } elsif ($b == 12) { # '\f'
            $esc = "\\f";
        } elsif ($b == 13) { # '\r'
            $esc = "\\r";
        } elsif ($b < 32 || $b == 127) {
            $esc = "\\x" . substr($hex, ($b >> 4) & 15, 1) . substr($hex, $b & 15, 1);
        }
        if (length($esc) > 0) {
            if ($i > $start) {
                $result = $result . core::byte_substr($s, $start, $i - $start);
            }
            $result = $result . $esc;
            $start = $i + 1;
        }
        $i = $i + 1;
    }
    if ($start < $blen) {
        $result = $result . core::byte_substr($s, $start, $blen - $start);
    }
    return $result;
}

# Check if string needs quoting
func needs_quote(str $s) int {
    my int $len = length($s);
    if ($len == 0) {
        return 1;
    }

    # Leading or trailing spaces
    my str $first = substr($s, 0, 1);
    my str $last = substr($s, $len - 1, 1);
    if ($first eq " " || $last eq " ") {
        return 1;
    }

    # Check for special first characters
    if ($first eq "'" || $first eq "\"" || $first eq "{" || $first eq "[" ||
        $first eq "-" || $first eq ":" || $first eq "#" || $first eq "&" ||
        $first eq "*" || $first eq "!" || $first eq "|" || $first eq ">" ||
        $first eq "%" || $first eq "@" || $first eq "`" || $first eq "?" ||
        $first eq "~") {
        return 1;
    }

    # Check for YAML 1.1 boolean / null keywords (case-insensitive)
    my str $low = lc($s);
    if ($low eq "true" || $low eq "false" || $low eq "null" ||
        $low eq "yes" || $low eq "no" || $low eq "on" || $low eq "off" ||
        $low eq "y" || $low eq "n" || $s eq "~") {
        return 1;
    }

    # Numeric-looking strings must be quoted so they stay strings on Load
    if (YAML::looks_like_num($s)) {
        return 1;
    }

    # Check for colon, hash comment character, or newline/tab
    if (index($s, ":") >= 0 || index($s, "#") >= 0 ||
        index($s, "\n") >= 0 || index($s, "\r") >= 0 || index($s, "\t") >= 0) {
        return 1;
    }

    return 0;
}

# Escape single quotes
func escape_single_quote(str $s) str {
    my str $result = "";
    my int $len = length($s);
    my int $i = 0;

    while ($i < $len) {
        my str $ch = substr($s, $i, 1);
        if ($ch eq "'") {
            $result = $result . "''";
        } else {
            $result = $result . $ch;
        }
        $i = $i + 1;
    }

    return $result;
}

func format_key(str $k) str {
    if (YAML::has_control_char($k)) {
        return "\"" . YAML::escape_double_quote($k) . "\"";
    }
    if (YAML::needs_quote($k) == 1) {
        return "'" . YAML::escape_single_quote($k) . "'";
    }
    return $k;
}

# Dump hash
func dump_hash(scalar $hval, int $indent) str {
    return YAML::dump_hash_d($hval, $indent, 0);
}

func dump_hash_d(scalar $hval, int $indent, int $depth) str {
    if ($depth >= 64 || $indent > 512) {
        throw "YAML: maximum nesting depth (64) exceeded";
    }
    my str $result = "";
    my array @keys = keys($hval);
    my int $count = size(@keys);
    my int $i = 0;
    my str $pad = YAML::make_indent($indent);

    while ($i < $count) {
        my str $key = $keys[$i];
        my scalar $val = YAML::_unwrap_tied_scalar($hval->{$key});
        my str $rtype = ref($val);

        my str $qkey = YAML::format_key($key);
        if ($rtype eq "HASH") {
            my array @hk = keys($val);
            if (size(@hk) == 0) {
                $result = $result . $pad . $qkey . ": {}\n";
            } else {
                $result = $result . $pad . $qkey . ":\n";
                $result = $result . YAML::dump_value_d($val, $indent + 2, $depth + 1);
            }
        } elsif ($rtype eq "ARRAY") {
            if (size($val) == 0) {
                $result = $result . $pad . $qkey . ": []\n";
            } else {
                $result = $result . $pad . $qkey . ":\n";
                $result = $result . YAML::dump_value_d($val, $indent + 2, $depth + 1);
            }
        } else {
            $result = $result . $pad . $qkey . ": " . YAML::dump_value_d($val, 0, $depth + 1) . "\n";
        }

        $i = $i + 1;
    }

    return $result;
}

# Dump array
func dump_array(scalar $arr, int $indent) str {
    return YAML::dump_array_d($arr, $indent, 0);
}

func dump_array_d(scalar $arr, int $indent, int $depth) str {
    if ($depth >= 64 || $indent > 512) {
        throw "YAML: maximum nesting depth (64) exceeded";
    }
    my str $result = "";
    my int $count = size($arr);
    my int $i = 0;
    my str $pad = YAML::make_indent($indent);

    while ($i < $count) {
        my scalar $val = YAML::_unwrap_tied_scalar($arr->[$i]);
        my str $rtype = ref($val);

        if ($rtype eq "HASH") {
            # First key on same line as dash
            my array @keys = keys($val);
            if (size(@keys) > 0) {
                my str $first_key = $keys[0];
                my scalar $first_val = YAML::_unwrap_tied_scalar($val->{$first_key});
                my str $first_rtype = ref($first_val);

                my str $qfirst_key = YAML::format_key($first_key);
                if ($first_rtype eq "HASH") {
                    my array @fk = keys($first_val);
                    if (size(@fk) == 0) {
                        $result = $result . $pad . "- " . $qfirst_key . ": {}\n";
                    } else {
                        $result = $result . $pad . "- " . $qfirst_key . ":\n";
                        $result = $result . YAML::dump_value_d($first_val, $indent + 4, $depth + 1);
                    }
                } elsif ($first_rtype eq "ARRAY") {
                    if (size($first_val) == 0) {
                        $result = $result . $pad . "- " . $qfirst_key . ": []\n";
                    } else {
                        $result = $result . $pad . "- " . $qfirst_key . ":\n";
                        $result = $result . YAML::dump_value_d($first_val, $indent + 4, $depth + 1);
                    }
                } else {
                    $result = $result . $pad . "- " . $qfirst_key . ": " . YAML::dump_value_d($first_val, 0, $depth + 1) . "\n";
                }

                # Rest of keys
                my int $j = 1;
                while ($j < size(@keys)) {
                    my str $key = $keys[$j];
                    my scalar $kval = YAML::_unwrap_tied_scalar($val->{$key});
                    my str $krtype = ref($kval);

                    my str $qkey = YAML::format_key($key);
                    if ($krtype eq "HASH") {
                        my array @kk = keys($kval);
                        if (size(@kk) == 0) {
                            $result = $result . $pad . "  " . $qkey . ": {}\n";
                        } else {
                            $result = $result . $pad . "  " . $qkey . ":\n";
                            $result = $result . YAML::dump_value_d($kval, $indent + 4, $depth + 1);
                        }
                    } elsif ($krtype eq "ARRAY") {
                        if (size($kval) == 0) {
                            $result = $result . $pad . "  " . $qkey . ": []\n";
                        } else {
                            $result = $result . $pad . "  " . $qkey . ":\n";
                            $result = $result . YAML::dump_value_d($kval, $indent + 4, $depth + 1);
                        }
                    } else {
                        $result = $result . $pad . "  " . $qkey . ": " . YAML::dump_value_d($kval, 0, $depth + 1) . "\n";
                    }

                    $j = $j + 1;
                }
            } else {
                $result = $result . $pad . "- {}\n";
            }
        } elsif ($rtype eq "ARRAY") {
            if (size($val) == 0) {
                $result = $result . $pad . "- []\n";
            } else {
                $result = $result . $pad . "-\n";
                $result = $result . YAML::dump_array_d($val, $indent + 2, $depth + 1);
            }
        } else {
            $result = $result . $pad . "- " . YAML::dump_value_d($val, 0, $depth + 1) . "\n";
        }

        $i = $i + 1;
    }

    return $result;
}

# Make indentation string
func make_indent(int $n) str {
    my str $result = "";
    my int $i = 0;

    while ($i < $n) {
        $result = $result . " ";
        $i = $i + 1;
    }

    return $result;
}
