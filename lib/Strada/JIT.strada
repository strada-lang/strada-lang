=head1 NAME

Strada::JIT - Runtime eval() for Strada

=head1 SYNOPSIS

    use lib "lib";
    use Strada::JIT;

    # Initialize with auto-detected compiler (tcc preferred, gcc fallback)
    Strada::JIT::init();

    # Or specify compiler explicitly
    Strada::JIT::init("gcc");

    # Evaluate expressions - returns the result
    my scalar $result = Strada::JIT::eval("1 + 2");             # returns 3
    my scalar $s = Strada::JIT::eval("\"hello\" . \" world\""); # returns "hello world"

    # Variables persist across eval calls
    Strada::JIT::eval("my int \$x = 42;");
    my scalar $val = Strada::JIT::eval("\$x * 2");   # returns 84

    # Function definitions persist
    Strada::JIT::eval("func twice(int \$n) int { return \$n * 2; }");
    my scalar $r = Strada::JIT::eval("twice(21)");   # returns 42

    # Void calls (say, print, etc.) return undef
    Strada::JIT::eval("say(\"hello from eval\");");

    # Error handling - compilation/runtime errors throw exceptions
    try {
        Strada::JIT::eval("this is not valid code");
    } catch ($e) {
        say("Eval error: " . $e);
    }

    # Get/set variables directly
    Strada::JIT::set("x", 100);
    my scalar $v = Strada::JIT::get("x");   # returns 100

    # Add library search paths
    Strada::JIT::add_lib_path("/path/to/libs");

    # Reset all state
    Strada::JIT::reset();

=head1 DESCRIPTION

Strada::JIT provides runtime code evaluation for Strada programs, similar to
Perl's C<eval STRING>. It compiles Strada code to C via stradac, then
to a shared library via tcc or gcc, loads it with dlopen, and executes
it. Variables and function definitions persist across eval calls via a
shared state hash.

This enables programs to compile and execute Strada code at runtime for
use cases like plugin systems, configuration evaluation, scripting
engines, and interactive tools.

=head1 FUNCTIONS

=head2 Strada::JIT::init(str ...@args)

Initialize the JIT engine. Must be called before C<eval()>.

Auto-detects the stradac compiler, runtime path, and C compiler. Prefers
tcc for faster compilation, falls back to gcc.

Pass an optional compiler name to override auto-detection:

    Strada::JIT::init();        # auto-detect
    Strada::JIT::init("tcc");   # force tcc
    Strada::JIT::init("gcc");   # force gcc

Throws an exception if stradac or a C compiler cannot be found.

=head2 Strada::JIT::eval(str $code) scalar

Evaluate Strada code and return the result.

Expressions return their value. For multi-statement code, the value is the
LAST expression (Perl-ish C<eval> semantics) — e.g.
C<eval("my %h=(); $h{'a'}=41; $h{'a'}+1")> returns 42. Code whose final
top-level statement ends in C<;>, or a trailing void call (C<say>, C<print>,
etc.), returns undef.

Variables declared with C<my> persist across eval calls. Function
definitions (C<func ...>) are accumulated and available in subsequent
evals. Import statements (C<use>, C<import_lib>) are registered and
included in all subsequent evals. Package declarations set the current
package context.

Throws an exception on compilation or runtime errors.

=head2 Strada::JIT::get(str $name) scalar

Get a variable value from the persistent state hash. Returns undef if
the variable does not exist.

    Strada::JIT::eval("my int \$x = 42;");
    my scalar $v = Strada::JIT::get("x");   # 42

=head2 Strada::JIT::set(str $name, scalar $value)

Set a variable value in the persistent state hash. Also registers the
variable type as C<scalar> if not already known.

    Strada::JIT::set("count", 0);

=head2 Strada::JIT::add_lib_path(str $path)

Add a library search path for stradac (equivalent to C<-L> flag).
Duplicate paths are ignored.

    Strada::JIT::add_lib_path("lib");
    Strada::JIT::add_lib_path("/usr/local/lib/strada");

=head2 Strada::JIT::reset()

Clear all persistent state: variables, function definitions, imports,
package name, and the eval counter.

=head2 Strada::JIT::debug(int $enabled)

Enable (1) or disable (0) debug mode. When enabled, the generated Strada
source for each eval is printed to stdout.

=head2 Strada::JIT::compiler() str

Returns the name of the detected C compiler ("tcc" or "gcc").

=head1 ARCHITECTURE

Each C<Strada::JIT::eval()> call performs these steps:

=over

=item 1. Scan code for variable declarations, function definitions, imports

=item 2. Generate a complete Strada source file wrapping the code

=item 3. Compile with stradac to C

=item 4. Compile with tcc/gcc to a shared library (.so)

=item 5. Load with dlopen, find the entry function with dlsym

=item 6. Call the function via core::dl_call_sv, passing the state hash

=item 7. Clean up temp files

=back

The generated source restores persisted variables from the state hash at
the start of the function and exports them back at the end.

=head1 LIMITATIONS

=over

=item * Variables persist via save/restore through the global registry.
All variable types (scalars, arrays, hashes) use real C<my> declarations
with C<__C__> blocks to save and restore values between eval calls.
This means C<$i++>, C<s///>, and C<for (my int $i ...)> all work correctly.

=item * C<const> and C<enum> declarations require the gcc backend (tcc does
not run C<__attribute__((constructor))> for dlopen'd shared libraries).

=item * C<try/catch> requires the gcc backend (tcc lacks setjmp support).

=item * C<fn> is supported as an alias for C<func> in function definitions.

=item * Each eval invocation compiles and links a new shared library, so
there is overhead per call. Use tcc for faster compilation of simple code.

=item * The C<libtcc> in-process backend is not supported (only the
external tcc and gcc compilers).

=back

=head1 SEE ALSO

C<tools/strada-jit.strada> - Interactive REPL that uses the same
compile-load-execute approach.

=cut

package Strada::JIT;

__C__ {
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>

static int repl_command_exists(const char *cmd) {
    char path[256];
    snprintf(path, sizeof(path), "which %s >/dev/null 2>&1", cmd);
    return system(path) == 0;
}
}

# Internal state
my hash %g_var_types = ();
my array @g_functions = ();
my array @g_imports = ();
my array @g_lib_paths = ();
my str $g_stradac_path = "";
my str $g_runtime_path = "";
my str $g_compiler = "";
my int $g_eval_count = 0;
my str $g_tmpdir = "/tmp";
my int $g_tmpdir_owned = 0;
my int $g_initialized = 0;
my str $g_current_package = "";
my int $g_debug = 0;
my int $g_cdebug = 0;
my array @g_open_libs = ();
my array @g_so_files = ();
my array @g_constants = ();
my hash %g_oop_packages = ();

# Detect stradac path
private func detect_stradac() str {
    my int $exists = 0;

    if (core::is_file("./stradac") == 1) {
        return "./stradac";
    }

    __C__ {
        exists = strada_new_int(repl_command_exists("stradac"));
    }
    if ($exists == 1) {
        return "stradac";
    }

    if (core::is_file("/usr/local/bin/stradac") == 1) {
        return "/usr/local/bin/stradac";
    }
    if (core::is_file("/usr/bin/stradac") == 1) {
        return "/usr/bin/stradac";
    }

    return "";
}

# Detect runtime path
private func detect_runtime() str {
    if (core::is_file("./runtime/strada_runtime_tcc.h") == 1) {
        return "./runtime";
    }

    if ($g_stradac_path ne "" && $g_stradac_path ne "stradac") {
        my str $stradac_dir = core::dirname($g_stradac_path);
        my str $relative_runtime = $stradac_dir . "/../lib/strada/runtime";
        if (core::is_file($relative_runtime . "/strada_runtime_tcc.h") == 1) {
            return $relative_runtime;
        }
    }

    if (core::is_file("/usr/local/lib/strada/runtime/strada_runtime_tcc.h") == 1) {
        return "/usr/local/lib/strada/runtime";
    }
    if (core::is_file("/usr/lib/strada/runtime/strada_runtime_tcc.h") == 1) {
        return "/usr/lib/strada/runtime";
    }

    return "";
}

# Detect available C compiler. Prefers gcc — tcc is faster but has
# known correctness gaps (see project_perla_tcc_dclone_bug in memory):
# tcc-compiled output can silently misbehave on edge cases that gcc
# handles correctly. With strada's -O0 speed flags, gcc is fast enough
# for JIT use without giving up correctness.
private func detect_compiler() str {
    my int $has_tcc = 0;
    my int $has_gcc = 0;

    __C__ {
        has_tcc = strada_new_int(repl_command_exists("tcc"));
        has_gcc = strada_new_int(repl_command_exists("gcc"));
    }

    if ($has_gcc == 1) {
        return "gcc";
    }
    if ($has_tcc == 1) {
        return "tcc";
    }
    return "";
}

# Single-quote a string safely for /bin/sh
private func shell_quote(str $s) str {
    my str $out = "'";
    my int $i = 0;
    my int $len = length($s);
    while ($i < $len) {
        my str $ch = substr($s, $i, 1);
        if ($ch eq "'") {
            $out = $out . "'\\''";
        } else {
            $out = $out . $ch;
        }
        $i = $i + 1;
    }
    return $out . "'";
}

# Check if input looks like a function definition
private func get_target_package() str {
    if ($g_current_package ne "" && $g_current_package ne "main") {
        return $g_current_package;
    }
    return "repl";
}

private func track_oop_package(str $pkg) void {
    if ($pkg ne "" && $pkg ne "main") {
        $g_oop_packages{$pkg} = 1;
    }
}

# Check if input is a function definition
private func is_function_def(str $input) int {
    # Accepts both parens form `func name(...)` and no-parens form `func name { ... }`
    # (or `func name rettype { ... }`).
    if ($input =~ /^\s*(private\s+|async\s+)*(func|fn)\s+\w+\s*(\(|(\w+\s+)?\{)/) {
        return 1;
    }
    return 0;
}

# Check if input is a method modifier (before/after/around)
private func is_modifier_def(str $input) int {
    if ($input =~ /^\s*(before|after|around)\s+/) {
        return 1;
    }
    return 0;
}

# Extract function name from a function definition (including optional package prefix)
private func get_function_name(str $func_def) str {
    my str $s = $func_def;
    $s =~ s/^\s*//;
    my str $pkg = "";
    if ($s =~ /^package\s+([A-Za-z_][A-Za-z0-9_:]*)\s*;/) {
        $pkg = $s;
        $pkg =~ s/^package\s+([A-Za-z_][A-Za-z0-9_:]*)\s*;[\s\S]*$/$1/;
        $s =~ s/^package\s+[A-Za-z_][A-Za-z0-9_:]*\s*;\s*//;
    }
    $s =~ s/^(private\s+|async\s+)+//;
    if (!($s =~ /^(func|fn)\s+/)) {
        return "";
    }
    $s =~ s/^(func|fn)\s+//;
    my int $i = 0;
    my int $len = length($s);
    while ($i < $len) {
        my str $ch = substr($s, $i, 1);
        if ($ch eq "(" || $ch eq "{" || $ch eq " " || $ch eq "\t" || $ch eq "\n" || $ch eq "\r") {
            last;
        }
        $i = $i + 1;
    }
    if ($i > 0) {
        my str $fname = substr($s, 0, $i);
        if ($pkg ne "" && $pkg ne "repl" && $pkg ne "main") {
            return $pkg . "::" . $fname;
        }
        return $fname;
    }
    return "";
}

# Replace or add a function definition
private func register_function(str $func_def) int {
    my str $tagged_def = $func_def;
    if (!($tagged_def =~ /^\s*package\s+/)) {
        my str $tpkg = get_target_package();
        track_oop_package($tpkg);
        $tagged_def = "package " . $tpkg . ";\n" . $tagged_def;
    } elsif ($tagged_def =~ /^\s*package\s+([A-Za-z_][A-Za-z0-9_:]*)\s*;/) {
        my str $epkg = $tagged_def;
        $epkg =~ s/^\s*package\s+([A-Za-z_][A-Za-z0-9_:]*)\s*;[\s\S]*$/$1/;
        track_oop_package($epkg);
    }
    my str $name = get_function_name($tagged_def);
    if ($name eq "") {
        push(@g_functions, $tagged_def);
        return 0;
    }

    my int $i = 0;
    my int $count = scalar(@g_functions);
    while ($i < $count) {
        my str $existing_name = get_function_name($g_functions[$i]);
        if ($existing_name eq $name) {
            $g_functions[$i] = $tagged_def;
            return 1;
        }
        $i = $i + 1;
    }

    push(@g_functions, $tagged_def);
    return 0;
}

# Extract function definition from input, returns array: [func_def, remainder]
private func extract_function_def(str $input) array {
    my array @result = ("", "");
    my int $len = length($input);
    my int $in_str = 0;
    my int $in_cmt = 0;
    my int $brace_pos = -1;
    my int $scan = 0;

    while ($scan < $len) {
        my str $c = substr($input, $scan, 1);
        if ($in_cmt == 1) {
            if ($c eq "\n") { $in_cmt = 0; }
            $scan = $scan + 1;
            next;
        }
        if ($in_str == 1) {
            if ($c eq "\\" && $scan + 1 < $len) { $scan = $scan + 2; next; }
            if ($c eq "\"") { $in_str = 0; }
            $scan = $scan + 1;
            next;
        }
        if ($in_str == 2) {
            if ($c eq "\\" && $scan + 1 < $len) { $scan = $scan + 2; next; }
            if ($c eq "'") { $in_str = 0; }
            $scan = $scan + 1;
            next;
        }
        if ($c eq "\"") { $in_str = 1; $scan = $scan + 1; next; }
        if ($c eq "'") { $in_str = 2; $scan = $scan + 1; next; }
        if ($c eq "#") { $in_cmt = 1; $scan = $scan + 1; next; }
        if ($c eq "{") { $brace_pos = $scan; last; }
        $scan = $scan + 1;
    }

    if ($brace_pos < 0) {
        $result[0] = $input;
        return @result;
    }

    my int $depth = 0;
    my int $i = $brace_pos;
    $in_str = 0;
    $in_cmt = 0;
    my int $end_pos = -1;

    while ($i < $len) {
        my str $c = substr($input, $i, 1);

        if ($in_cmt == 1) {
            if ($c eq "\n") { $in_cmt = 0; }
            $i = $i + 1;
            next;
        }
        if ($in_str == 1) {
            if ($c eq "\\" && $i + 1 < $len) { $i = $i + 2; next; }
            if ($c eq "\"") { $in_str = 0; }
            $i = $i + 1;
            next;
        }
        if ($in_str == 2) {
            if ($c eq "\\" && $i + 1 < $len) { $i = $i + 2; next; }
            if ($c eq "'") { $in_str = 0; }
            $i = $i + 1;
            next;
        }

        if ($c eq "\"") { $in_str = 1; $i = $i + 1; next; }
        if ($c eq "'") { $in_str = 2; $i = $i + 1; next; }
        if ($c eq "#") { $in_cmt = 1; $i = $i + 1; next; }

        if ($c eq "{") {
            $depth = $depth + 1;
        } elsif ($c eq "}") {
            $depth = $depth - 1;
            if ($depth == 0) {
                $end_pos = $i;
                last;
            }
        }

        $i = $i + 1;
    }

    if ($end_pos >= 0) {
        $result[0] = substr($input, 0, $end_pos + 1);
        if ($end_pos + 1 < $len) {
            my str $remainder = substr($input, $end_pos + 1, $len - $end_pos - 1);
            $remainder =~ s/^\s*;\s*//;
            $remainder =~ s/^\s+//;
            $remainder =~ s/\s+$//;
            $result[1] = $remainder;
        }
    } else {
        $result[0] = $input;
    }

    return @result;
}

# Check if input is a package declaration
private func is_package_decl(str $input) int {
    if ($input =~ /^\s*package\s+[A-Za-z_][A-Za-z0-9_:]*/) {
        return 1;
    }
    return 0;
}

# Check if input is an OOP class declaration statement (has, extends, use overload)
private func is_oop_decl(str $input) int {
    if ($input =~ /^\s*(has|extends)\s+/) {
        return 1;
    }
    if ($input =~ /^\s*use\s+overload\b/) {
        return 1;
    }
    return 0;
}

# Check if input is a use/import statement
private func is_import(str $input) int {
    if ($input =~ /^[ \t]*use[ \t]+overload\b/) {
        return 0;
    }
    if ($input =~ /^[ \t]*use[ \t]+/) {
        return 1;
    }
    if ($input =~ /^[ \t]*import_lib[ \t]+/) {
        return 1;
    }
    if ($input =~ /^[ \t]*import_object[ \t]+/) {
        return 1;
    }
    if ($input =~ /^[ \t]*import_archive[ \t]+/) {
        return 1;
    }
    return 0;
}

# Register a use/import statement (avoid duplicates)
private func register_import(str $import_stmt) void {
    my str $normalized = $import_stmt;
    $normalized =~ s/[ \t]+$//;
    $normalized =~ s/;$//;
    $normalized =~ s/[ \t]+$//;

    # Handle "use lib" specially
    if ($normalized =~ /^use[ \t]+lib[ \t]+/) {
        my str $path = $normalized;
        $path =~ s/^use[ \t]+lib[ \t]+//;
        $path =~ s/^"//;
        $path =~ s/"$//;
        $path =~ s/^'//;
        $path =~ s/'$//;
        add_lib_path($path);
        return;
    }

    foreach my str $existing (@g_imports) {
        my str $existing_norm = $existing;
        $existing_norm =~ s/[ \t]+$//;
        $existing_norm =~ s/;$//;
        $existing_norm =~ s/[ \t]+$//;
        if ($existing_norm eq $normalized) {
            return;
        }
    }

    push(@g_imports, $normalized . ";");
}

# Replace string literals and # comments with spaces so regex scans don't false-positive
private func strip_strings_and_comments(str $input) str {
    my str $out = "";
    my int $len = length($input);
    my int $i = 0;
    my int $in_str = 0;
    my int $in_cmt = 0;
    while ($i < $len) {
        my str $c = substr($input, $i, 1);
        if ($in_cmt == 1) {
            if ($c eq "\n") { $in_cmt = 0; $out = $out . "\n"; }
            else { $out = $out . " "; }
            $i = $i + 1;
            next;
        }
        if ($in_str == 1) {
            if ($c eq "\\" && $i + 1 < $len) { $out = $out . "  "; $i = $i + 2; next; }
            if ($c eq "\"") { $in_str = 0; }
            $out = $out . " ";
            $i = $i + 1;
            next;
        }
        if ($in_str == 2) {
            if ($c eq "\\" && $i + 1 < $len) { $out = $out . "  "; $i = $i + 2; next; }
            if ($c eq "'") { $in_str = 0; }
            $out = $out . " ";
            $i = $i + 1;
            next;
        }
        if ($c eq "\"") { $in_str = 1; $out = $out . " "; $i = $i + 1; next; }
        if ($c eq "'") { $in_str = 2; $out = $out . " "; $i = $i + 1; next; }
        if ($c eq "#") { $in_cmt = 1; $out = $out . " "; $i = $i + 1; next; }
        $out = $out . $c;
        $i = $i + 1;
    }
    return $out;
}

# Check if input declares a specific variable
private func input_declares_var(str $input, str $name, str $sigil) int {
    my str $code = strip_strings_and_comments($input);
    my str $pattern = "\\bmy\\s+([A-Za-z_][A-Za-z0-9_:]*\\s+)?\\" . $sigil . $name . "\\b";
    if ($code =~ /$pattern/) {
        return 1;
    }
    return 0;
}

# Register variables from input (only at brace/paren/bracket depth 0, skipping strings & comments)
private func register_variables(str $input) void {
    my int $i = 0;
    my int $len = length($input);
    my int $depth = 0;
    my int $pdepth = 0;
    my int $bdepth = 0;
    my int $in_str = 0;
    my int $in_cmt = 0;

    while ($i < $len) {
        my str $c = substr($input, $i, 1);

        if ($in_cmt == 1) {
            if ($c eq "\n") { $in_cmt = 0; }
            $i = $i + 1;
            next;
        }
        if ($in_str == 1) {
            if ($c eq "\\" && $i + 1 < $len) { $i = $i + 2; next; }
            if ($c eq "\"") { $in_str = 0; }
            $i = $i + 1;
            next;
        }
        if ($in_str == 2) {
            if ($c eq "\\" && $i + 1 < $len) { $i = $i + 2; next; }
            if ($c eq "'") { $in_str = 0; }
            $i = $i + 1;
            next;
        }
        if ($c eq "\"") { $in_str = 1; $i = $i + 1; next; }
        if ($c eq "'") { $in_str = 2; $i = $i + 1; next; }
        if ($c eq "#") { $in_cmt = 1; $i = $i + 1; next; }

        if ($c eq "{") { $depth = $depth + 1; $i = $i + 1; next; }
        if ($c eq "}") { $depth = $depth - 1; $i = $i + 1; next; }
        if ($c eq "(") { $pdepth = $pdepth + 1; $i = $i + 1; next; }
        if ($c eq ")") { $pdepth = $pdepth - 1; $i = $i + 1; next; }
        if ($c eq "[") { $bdepth = $bdepth + 1; $i = $i + 1; next; }
        if ($c eq "]") { $bdepth = $bdepth - 1; $i = $i + 1; next; }

        if ($depth == 0 && $pdepth == 0 && $bdepth == 0 && $c eq "m" && $i + 2 < $len && substr($input, $i + 1, 1) eq "y") {
            my str $after_my = substr($input, $i + 2, 1);
            my int $word_ok = 0;
            if ($after_my eq " " || $after_my eq "\t") {
                if ($i == 0) {
                    $word_ok = 1;
                } else {
                    my str $prev = substr($input, $i - 1, 1);
                    if (!($prev =~ /[a-zA-Z0-9_]/)) { $word_ok = 1; }
                }
            }
            if ($word_ok == 1) {
                my int $pos = $i + 2;
                while ($pos < $len && (substr($input, $pos, 1) eq " " || substr($input, $pos, 1) eq "\t")) {
                    $pos = $pos + 1;
                }
                my str $type = "scalar";
                my int $word_start = $pos;
                my str $next_word = "";
                while ($pos < $len) {
                    my str $wc = substr($input, $pos, 1);
                    if ($wc =~ /[a-zA-Z0-9_:]/) {
                        $next_word = $next_word . $wc;
                        $pos = $pos + 1;
                    } else {
                        last;
                    }
                }
                if ($next_word eq "int" || $next_word eq "num" || $next_word eq "str" || $next_word eq "scalar" || $next_word eq "array" || $next_word eq "hash") {
                    $type = $next_word;
                    while ($pos < $len && (substr($input, $pos, 1) eq " " || substr($input, $pos, 1) eq "\t")) {
                        $pos = $pos + 1;
                    }
                } elsif ($next_word ne "") {
                    my int $look = $pos;
                    while ($look < $len && (substr($input, $look, 1) eq " " || substr($input, $look, 1) eq "\t")) {
                        $look = $look + 1;
                    }
                    if ($look < $len) {
                        my str $sc = substr($input, $look, 1);
                        if ($sc eq "\$" || $sc eq "@" || $sc eq "%") {
                            $pos = $look;
                        } else {
                            $pos = $word_start;
                        }
                    } else {
                        $pos = $word_start;
                    }
                } else {
                    $pos = $word_start;
                }
                if ($pos < $len) {
                    my str $sigil = substr($input, $pos, 1);
                    if ($sigil eq "\$" || $sigil eq "@" || $sigil eq "%") {
                        if ($sigil eq "@") { $type = "array"; }
                        if ($sigil eq "%") { $type = "hash"; }
                        $pos = $pos + 1;
                        my str $name = "";
                        while ($pos < $len && (substr($input, $pos, 1) =~ /[a-zA-Z0-9_]/)) {
                            $name = $name . substr($input, $pos, 1);
                            $pos = $pos + 1;
                        }
                        if ($name ne "") {
                            $g_var_types{$name} = $type;
                        }
                        $i = $pos;
                        next;
                    }
                }
            }
        }
        $i = $i + 1;
    }
}

# Convert my declarations to our in user code for variable persistence
# Only converts at brace depth 0 — declarations inside blocks stay as 'my'
private func convert_my_to_our(str $input) str {
    my str $result = "";
    my int $len = length($input);
    my int $i = 0;
    my int $depth = 0;
    my int $in_str = 0;
    my int $in_cmt = 0;

    while ($i < $len) {
        my str $c = substr($input, $i, 1);

        if ($in_cmt == 1) {
            $result = $result . $c;
            if ($c eq "\n") { $in_cmt = 0; }
            $i = $i + 1;
            next;
        }
        if ($in_str == 1) {
            if ($c eq "\\" && $i + 1 < $len) {
                $result = $result . substr($input, $i, 2);
                $i = $i + 2;
                next;
            }
            if ($c eq "\"") { $in_str = 0; }
            $result = $result . $c;
            $i = $i + 1;
            next;
        }
        if ($in_str == 2) {
            if ($c eq "\\" && $i + 1 < $len) {
                $result = $result . substr($input, $i, 2);
                $i = $i + 2;
                next;
            }
            if ($c eq "'") { $in_str = 0; }
            $result = $result . $c;
            $i = $i + 1;
            next;
        }

        if ($c eq "\"") { $in_str = 1; $result = $result . $c; $i = $i + 1; next; }
        if ($c eq "'") { $in_str = 2; $result = $result . $c; $i = $i + 1; next; }
        if ($c eq "#") { $in_cmt = 1; $result = $result . $c; $i = $i + 1; next; }

        # Track brace depth
        if ($c eq "{") {
            $depth = $depth + 1;
            $result = $result . $c;
            $i = $i + 1;
            next;
        }
        if ($c eq "}") {
            $depth = $depth - 1;
            $result = $result . $c;
            $i = $i + 1;
            next;
        }

        # At depth > 0, copy through unchanged
        if ($depth > 0) {
            $result = $result . $c;
            $i = $i + 1;
            next;
        }

        # At depth 0, check for "my" keyword at word boundary
        if ($c eq "m" && $i + 2 < $len && substr($input, $i + 1, 1) eq "y") {
            my str $after_my = substr($input, $i + 2, 1);
            # Check word boundary: "my" must be followed by space or tab
            if ($after_my eq " " || $after_my eq "\t") {
                # Check that "my" is at start or preceded by non-word char
                my int $is_word_start = 0;
                if ($i == 0) {
                    $is_word_start = 1;
                } else {
                    my str $before = substr($input, $i - 1, 1);
                    if (!($before =~ /[a-zA-Z0-9_]/)) {
                        $is_word_start = 1;
                    }
                }

                if ($is_word_start == 1) {
                    # Look ahead to determine the declaration pattern
                    my int $j = $i + 2;
                    while ($j < $len && (substr($input, $j, 1) eq " " || substr($input, $j, 1) eq "\t")) {
                        $j = $j + 1;
                    }
                    if ($j < $len) {
                        my str $next = substr($input, $j, 1);
                        if ($next eq "$" || $next eq "@" || $next eq "%") {
                            if ($next eq "$") {
                                $result = $result . "our scalar ";
                            } elsif ($next eq "@") {
                                $result = $result . "our array ";
                            } else {
                                $result = $result . "our hash ";
                            }
                            $i = $i + 2;
                            while ($i < $len && (substr($input, $i, 1) eq " " || substr($input, $i, 1) eq "\t")) {
                                $i = $i + 1;
                            }
                            next;
                        } else {
                            $result = $result . "our";
                            $i = $i + 2;
                            next;
                        }
                    }
                }
            }
        }

        $result = $result . $c;
        $i = $i + 1;
    }

    return $result;
}

private func first_toplevel_semi(str $s) int {
    my int $n = length($s);
    my int $i = 0;
    my int $depth = 0;
    my int $in_str = 0;
    my int $in_cmt = 0;
    while ($i < $n) {
        my int $c = char_at($s, $i);
        my int $adv = 1;
        if ($in_cmt == 1) {
            if ($c == 10) { $in_cmt = 0; }
        } elsif ($in_str == 1) {
            if ($c == 92) { $adv = 2; }
            elsif ($c == 34) { $in_str = 0; }
        } elsif ($in_str == 2) {
            if ($c == 92) { $adv = 2; }
            elsif ($c == 39) { $in_str = 0; }
        } else {
            if ($c == 34) { $in_str = 1; }
            elsif ($c == 39) { $in_str = 2; }
            elsif ($c == 35) { $in_cmt = 1; }
            elsif ($c == 123 || $c == 40 || $c == 91) { $depth = $depth + 1; }
            elsif ($c == 125 || $c == 41 || $c == 93) { $depth = $depth - 1; }
            elsif ($c == 59 && $depth == 0) { return $i; }
        }
        $i = $i + $adv;
    }
    return -1;
}

# Index of the last top-level ';' in $s that has non-whitespace content after
# it, or -1 if there is none. Respects "double" / 'single' string literals,
# # comments, and (){}[] nesting. Used so multi-statement evals capture the trailing expression.
private func last_toplevel_semi(str $s) int {
    my int $n = length($s);
    my int $i = 0;
    my int $depth = 0;
    my int $in_str = 0;        # 0 normal, 1 inside "", 2 inside ''
    my int $in_cmt = 0;
    my int $last_semi = -1;
    while ($i < $n) {
        my int $c = char_at($s, $i);
        my int $adv = 1;
        if ($in_cmt == 1) {
            if ($c == 10) { $in_cmt = 0; }
        } elsif ($in_str == 1) {
            if ($c == 92) { $adv = 2; }          # backslash escape
            elsif ($c == 34) { $in_str = 0; }    # "
        } elsif ($in_str == 2) {
            if ($c == 92) { $adv = 2; }
            elsif ($c == 39) { $in_str = 0; }    # '
        } else {
            if ($c == 34) { $in_str = 1; }
            elsif ($c == 39) { $in_str = 2; }
            elsif ($c == 35) { $in_cmt = 1; }    # # comment
            elsif ($c == 123 || $c == 40 || $c == 91) { $depth = $depth + 1; }   # { ( [
            elsif ($c == 125 || $c == 41 || $c == 93) { $depth = $depth - 1; }   # } ) ]
            elsif ($c == 59 && $depth == 0) { $last_semi = $i; }                 # ;
        }
        $i = $i + $adv;
    }
    if ($last_semi < 0) { return -1; }
    # Require non-whitespace / non-comment after the candidate ';' (else trailing ';' = no result).
    my int $j = $last_semi + 1;
    while ($j < $n) {
        my int $cc = char_at($s, $j);
        if ($cc == 35) {
            while ($j < $n && char_at($s, $j) != 10) { $j = $j + 1; }
            next;
        }
        if ($cc != 32 && $cc != 9 && $cc != 10 && $cc != 13) { return $last_semi; }
        $j = $j + 1;
    }
    return -1;
}

# Strip top-level (depth 0) `my [TYPE] SIGIL+name` prefixes so declarations
# inside the wrapped helper closure assign to repl_eval()'s captured locals
# instead of shadowing them inside the closure.
private func strip_toplevel_my(str $input) str {
    my str $result = "";
    my int $len = length($input);
    my int $i = 0;
    my int $depth = 0;
    my int $pdepth = 0;
    my int $bdepth = 0;
    my int $in_str = 0;
    my int $in_cmt = 0;

    while ($i < $len) {
        my str $c = substr($input, $i, 1);

        if ($in_cmt == 1) {
            $result = $result . $c;
            if ($c eq "\n") { $in_cmt = 0; }
            $i = $i + 1;
            next;
        }

        if ($in_str == 1) {
            if ($c eq "\\" && $i + 1 < $len) {
                $result = $result . substr($input, $i, 2);
                $i = $i + 2;
                next;
            }
            if ($c eq "\"") { $in_str = 0; }
            $result = $result . $c;
            $i = $i + 1;
            next;
        }

        if ($in_str == 2) {
            if ($c eq "\\" && $i + 1 < $len) {
                $result = $result . substr($input, $i, 2);
                $i = $i + 2;
                next;
            }
            if ($c eq "'") { $in_str = 0; }
            $result = $result . $c;
            $i = $i + 1;
            next;
        }

        if ($c eq "\"") { $in_str = 1; $result = $result . $c; $i = $i + 1; next; }
        if ($c eq "'") { $in_str = 2; $result = $result . $c; $i = $i + 1; next; }
        if ($c eq "#") { $in_cmt = 1; $result = $result . $c; $i = $i + 1; next; }

        if ($c eq "{") { $depth = $depth + 1; $result = $result . $c; $i = $i + 1; next; }
        if ($c eq "}") { $depth = $depth - 1; $result = $result . $c; $i = $i + 1; next; }
        if ($c eq "(") { $pdepth = $pdepth + 1; $result = $result . $c; $i = $i + 1; next; }
        if ($c eq ")") { $pdepth = $pdepth - 1; $result = $result . $c; $i = $i + 1; next; }
        if ($c eq "[") { $bdepth = $bdepth + 1; $result = $result . $c; $i = $i + 1; next; }
        if ($c eq "]") { $bdepth = $bdepth - 1; $result = $result . $c; $i = $i + 1; next; }

        if ($depth == 0 && $pdepth == 0 && $bdepth == 0 && $c eq "m" && $i + 2 < $len && substr($input, $i + 1, 1) eq "y") {
            my str $after_my = substr($input, $i + 2, 1);
            if ($after_my eq " " || $after_my eq "\t") {
                my int $word_ok = 0;
                if ($i == 0) {
                    $word_ok = 1;
                } else {
                    my str $prev = substr($input, $i - 1, 1);
                    if (!($prev =~ /[a-zA-Z0-9_]/)) {
                        $word_ok = 1;
                    }
                }
                if ($word_ok == 1) {
                    my int $j = $i + 2;
                    while ($j < $len && (substr($input, $j, 1) eq " " || substr($input, $j, 1) eq "\t")) {
                        $j = $j + 1;
                    }
                    my str $vtype = "scalar";
                    my int $wstart = $j;
                    my str $word = "";
                    while ($j < $len) {
                        my str $wc = substr($input, $j, 1);
                        if ($wc =~ /[a-zA-Z0-9_:]/) {
                            $word = $word . $wc;
                            $j = $j + 1;
                        } else {
                            last;
                        }
                    }
                    if ($word eq "int" || $word eq "num" || $word eq "str" || $word eq "scalar" || $word eq "array" || $word eq "hash") {
                        $vtype = $word;
                        while ($j < $len && (substr($input, $j, 1) eq " " || substr($input, $j, 1) eq "\t")) {
                            $j = $j + 1;
                        }
                    } elsif ($word ne "") {
                        my int $look = $j;
                        while ($look < $len && (substr($input, $look, 1) eq " " || substr($input, $look, 1) eq "\t")) {
                            $look = $look + 1;
                        }
                        if ($look < $len) {
                            my str $sc = substr($input, $look, 1);
                            if ($sc eq "\$" || $sc eq "@" || $sc eq "%") {
                                $j = $look;
                            } else {
                                $j = $wstart;
                            }
                        } else {
                            $j = $wstart;
                        }
                    } else {
                        $j = $wstart;
                    }
                    if ($j < $len) {
                        my str $sigil = substr($input, $j, 1);
                        if ($sigil eq "$" || $sigil eq "@" || $sigil eq "%") {
                            $j = $j + 1;
                            my str $vname = "";
                            while ($j < $len && (substr($input, $j, 1) =~ /[a-zA-Z0-9_]/)) {
                                $vname = $vname . substr($input, $j, 1);
                                $j = $j + 1;
                            }
                            if ($vname ne "") {
                                my int $k = $j;
                                while ($k < $len && (substr($input, $k, 1) eq " " || substr($input, $k, 1) eq "\t")) {
                                    $k = $k + 1;
                                }
                                if ($k < $len && substr($input, $k, 1) eq ";") {
                                    # Standalone `my int $x;` -> reset to default value
                                    my str $defv = "undef";
                                    if ($sigil eq "@" || $sigil eq "%") { $defv = "()"; }
                                    elsif ($vtype eq "int") { $defv = "0"; }
                                    elsif ($vtype eq "num") { $defv = "0.0"; }
                                    elsif ($vtype eq "str") { $defv = "\"\""; }
                                    $result = $result . $sigil . $vname . " = " . $defv;
                                    $i = $k;
                                    next;
                                } else {
                                    # `my int $x = expr` -> `$x = expr`
                                    $result = $result . $sigil . $vname;
                                    $i = $j;
                                    next;
                                }
                            }
                        }
                    }
                }
            }
        }

        $result = $result . $c;
        $i = $i + 1;
    }

    return $result;
}

# Generate Strada source wrapping user code
private func generate_source(str $input) str {
    my str $src = "";

    # Import statements
    foreach my str $imp (@g_imports) {
        $src = $src . $imp . "\n";
    }
    if (scalar(@g_imports) > 0) {
        $src = $src . "\n";
    }

    # Always use repl package for variable persistence via global registry
    $src = $src . "package repl;\n\n";
    $src = $src . "__C__ {\n    static StradaValue ***__repl_caps = NULL;\n    static StradaValue ***__repl_caps_stack[64];\n    static int __repl_caps_sp = 0;\n}\n\n";

    # Constants, enums, and OOP class declarations (must be at package level)
    foreach my str $const_decl (@g_constants) {
        $src = $src . $const_decl . "\n";
    }
    if (scalar(@g_constants) > 0) {
        $src = $src . "\n";
    }

    # User-defined functions
    foreach my str $fndef (@g_functions) {
        $src = $src . $fndef . "\n\n";
    }

    my int $use_closure_wrap = (index($input, "__C__") < 0) ? 1 : 0;

    # Main eval function (always in package repl even if functions above switched package)
    $src = $src . "package repl;\n";
    $src = $src . "func repl_eval() scalar {\n";

    # Declare tracked variables as real C `my` locals in repl_eval() and restore
    # previously-saved values from the global registry (unless redeclared in $input).
    my str $restore_code = "";
    foreach my str $vname (keys(%g_var_types)) {
        my str $type = $g_var_types{$vname};
        my str $sigil = "\$";
        if ($type eq "array") { $sigil = "@"; }
        if ($type eq "hash") { $sigil = "%"; }

        my int $redecl = input_declares_var($input, $vname, $sigil);
        if ($use_closure_wrap == 0 && $redecl == 1) {
            next;
        }

        # Emit my TYPE SIGIL+name declaration with default value
        if ($type eq "array") {
            $src = $src . "    my array @" . $vname . " = ();\n";
        } elsif ($type eq "hash") {
            $src = $src . "    my hash %" . $vname . " = ();\n";
        } elsif ($type eq "int") {
            $src = $src . "    my int \$" . $vname . " = 0;\n";
        } elsif ($type eq "num") {
            $src = $src . "    my num \$" . $vname . " = 0.0;\n";
        } elsif ($type eq "str") {
            $src = $src . "    my str \$" . $vname . " = \"\";\n";
        } else {
            $src = $src . "    my scalar \$" . $vname . " = undef;\n";
        }

        if ($redecl == 0) {
            $restore_code = $restore_code . "        StradaValue *__saved_" . $vname . " = strada_global_get(strada_new_str(\"repl::" . $vname . "\"));\n";
            $restore_code = $restore_code . "        if (STRADA_IS_TAGGED_INT(__saved_" . $vname . ") || __saved_" . $vname . "->type != STRADA_UNDEF) {\n";
            $restore_code = $restore_code . "            strada_decref(" . $vname . ");\n";
            $restore_code = $restore_code . "            " . $vname . " = __saved_" . $vname . ";\n";
            $restore_code = $restore_code . "        } else {\n";
            $restore_code = $restore_code . "            strada_decref(__saved_" . $vname . ");\n";
            $restore_code = $restore_code . "        }\n";
        }
    }

    # Emit restore __C__ block if we have variables to restore
    if ($restore_code ne "") {
        $src = $src . "    __C__ {\n";
        $src = $src . $restore_code;
        $src = $src . "    }\n\n";
    }

    $src = $src . "    # User code\n";

    my str $body_input = ($use_closure_wrap == 1) ? strip_toplevel_my($input) : $input;
    my str $tail = $body_input;
    my int $split_at = last_toplevel_semi($body_input);
    my str $prefix_stmts = "";
    if ($split_at >= 0) {
        $prefix_stmts = substr($body_input, 0, $split_at + 1);
        $tail = substr($body_input, $split_at + 1, length($body_input) - $split_at - 1);
    }

    my str $trimmed = $tail;
    $trimmed =~ s/^\s+//;
    $trimmed =~ s/\s+$//;

    # Check if this is a void function call (prints output, returns nothing useful)
    my int $is_void_call = 0;
    if ($trimmed =~ /^(say|print|warn|push|pop|shift|unshift)\(/) {
        $is_void_call = 1;
    }
    foreach my str $fndef (@g_functions) {
        if ($fndef =~ /\)\s*void\s*\{/) {
            my str $vfn_name = get_function_name($fndef);
            if ($vfn_name ne "") {
                my int $cpos = rindex($vfn_name, "::");
                my str $bare_fn = ($cpos >= 0) ? substr($vfn_name, $cpos + 2, length($vfn_name) - $cpos - 2) : $vfn_name;
                my str $qprefix = $vfn_name . "(";
                my str $bprefix = $bare_fn . "(";
                if ((length($trimmed) >= length($qprefix) && substr($trimmed, 0, length($qprefix)) eq $qprefix) ||
                    (length($trimmed) >= length($bprefix) && substr($trimmed, 0, length($bprefix)) eq $bprefix)) {
                    $is_void_call = 1;
                }
            }
        }
    }

    my int $is_return_stmt = 0;
    if ($trimmed =~ /^return(\s|;|\(|$)/) { $is_return_stmt = 1; }

    # Check if this is a statement (not an expression to capture)
    my int $is_statement = 0;
    if ($trimmed =~ /^my\s+/) { $is_statement = 1; }
    if ($trimmed =~ /^our\s+/) { $is_statement = 1; }
    if ($trimmed =~ /^const\s+/) { $is_statement = 1; }
    if ($trimmed =~ /^if\s*\(/) { $is_statement = 1; }
    if ($trimmed =~ /^unless\s/) { $is_statement = 1; }
    if ($trimmed =~ /^while\s*\(/) { $is_statement = 1; }
    if ($trimmed =~ /^until\s*\(/) { $is_statement = 1; }
    if ($trimmed =~ /^do\s*\{/) { $is_statement = 1; }
    if ($trimmed =~ /^for\s/) { $is_statement = 1; }
    if ($trimmed =~ /^foreach\s/) { $is_statement = 1; }
    if ($trimmed =~ /^try\s*\{/) { $is_statement = 1; }
    if ($trimmed =~ /^\{/) { $is_statement = 1; }
    if ($trimmed =~ /^[\$\@\%]\w+\s*=[^=~]/) { $is_statement = 1; }
    if ($trimmed =~ /^[\$\@\%]\w+\s*=$/) { $is_statement = 1; }

    my str $last_char = "";
    if (length($trimmed) > 0) {
        $last_char = substr($trimmed, length($trimmed) - 1, 1);
    }

    if ($use_closure_wrap == 1) {
        # Wrap user body in a helper closure so even an explicit `return EXPR;`
        # returns to repl_eval(), which then saves live *__repl_caps[i] cells!
        my array @tracked_names = keys(%g_var_types);
        my int $tracked_count = scalar(@tracked_names);
        $src = $src . "    my scalar \$__repl_fn = func() scalar {\n";
        if ($tracked_count > 0) {
            $src = $src . "        if (0) {\n";
            my int $ti = 0;
            while ($ti < $tracked_count) {
                my str $tvn = $tracked_names[$ti];
                my str $tvt = $g_var_types{$tvn};
                if ($tvt eq "array") {
                    $src = $src . "            my scalar \$__touch_" . $ti . " = \\@" . $tvn . ";\n";
                } elsif ($tvt eq "hash") {
                    $src = $src . "            my scalar \$__touch_" . $ti . " = \\%" . $tvn . ";\n";
                } else {
                    $src = $src . "            my scalar \$__touch_" . $ti . " = \$" . $tvn . ";\n";
                }
                $ti = $ti + 1;
            }
            $src = $src . "        }\n";
            $src = $src . "        __C__ { __repl_caps = __captures; }\n";
        }
        if ($prefix_stmts ne "") {
            $src = $src . "        " . $prefix_stmts . "\n";
        }
        if ($is_return_stmt == 1) {
            my str $code_line = $tail;
            if ($last_char ne ";") { $code_line = $tail . ";"; }
            $src = $src . "        " . $code_line . "\n";
            $src = $src . "        return undef;\n";
        } elsif ($is_statement == 1) {
            my str $code_line = $tail;
            if ($last_char ne ";" && $last_char ne "}") {
                $code_line = $tail . ";";
            }
            $src = $src . "        " . $code_line . "\n";
            $src = $src . "        return undef;\n";
        } elsif ($is_void_call == 1) {
            my str $code_line = $tail;
            if ($last_char ne ";") { $code_line = $tail . ";"; }
            $src = $src . "        " . $code_line . "\n";
            $src = $src . "        return undef;\n";
        } else {
            my str $expr = $trimmed;
            if ($last_char eq ";") {
                $expr = substr($trimmed, 0, length($trimmed) - 1);
            }
            if ($expr eq "") {
                $src = $src . "        return undef;\n";
            } else {
                $src = $src . "        return " . $expr . ";\n";
            }
        }
        $src = $src . "    };\n";
        if ($tracked_count > 0) {
            my str $persist_caps = "        __C__ {\n"
                . "            if (__repl_caps) {\n";
            my int $si = 0;
            while ($si < $tracked_count) {
                my str $svn = $tracked_names[$si];
                $persist_caps = $persist_caps
                    . "                strada_incref(*__repl_caps[" . $si . "]);\n"
                    . "                strada_global_set(strada_new_str(\"repl::" . $svn . "\"), *__repl_caps[" . $si . "]);\n";
                $si = $si + 1;
            }
            $persist_caps = $persist_caps
                . "            }\n"
                . "            __repl_caps = (__repl_caps_sp > 0) ? __repl_caps_stack[--__repl_caps_sp] : NULL;\n"
                . "        }\n";
            $src = $src . "    __C__ {\n"
                . "        if (__repl_caps_sp < 64) { __repl_caps_stack[__repl_caps_sp++] = __repl_caps; }\n"
                . "        __repl_caps = NULL;\n"
                . "    }\n";
            $src = $src . "    my scalar \$__result = undef;\n";
            $src = $src . "    try {\n";
            $src = $src . "        \$__result = \$__repl_fn->();\n";
            $src = $src . "    } catch (\$__jit_e) {\n";
            $src = $src . $persist_caps;
            $src = $src . "        throw \$__jit_e;\n";
            $src = $src . "    }\n";
            $src = $src . $persist_caps;
        } else {
            $src = $src . "    my scalar \$__result = \$__repl_fn->();\n";
        }
    } else {
        if ($prefix_stmts ne "") {
            $src = $src . "    " . $prefix_stmts . "\n";
        }
        if ($is_return_stmt == 1 || $is_statement == 1) {
            my str $code_line = $tail;
            if ($last_char ne ";" && $last_char ne "}") {
                $code_line = $tail . ";";
            }
            $src = $src . "    " . $code_line . "\n";
            $src = $src . "    my scalar \$__result = undef;\n";
        } elsif ($is_void_call == 1) {
            my str $code_line = $tail;
            if ($last_char ne ";") { $code_line = $tail . ";"; }
            $src = $src . "    " . $code_line . "\n";
            $src = $src . "    my scalar \$__result = undef;\n";
        } else {
            my str $expr = $trimmed;
            if ($last_char eq ";") {
                $expr = substr($trimmed, 0, length($trimmed) - 1);
            }
            $src = $src . "    my scalar \$__result = " . $expr . ";\n";
        }

        # Save all tracked variables back to global registry (inline __C__ path)
        my str $save_c = "";
        foreach my str $vname (keys(%g_var_types)) {
            $save_c = $save_c . "        strada_incref(" . $vname . ");\n";
            $save_c = $save_c . "        strada_global_set(strada_new_str(\"repl::" . $vname . "\"), " . $vname . ");\n";
        }
        if ($save_c ne "") {
            $src = $src . "\n    __C__ {\n";
            $src = $src . $save_c;
            $src = $src . "    }\n";
        }
    }

    $src = $src . "\n    return \$__result;\n";
    $src = $src . "}\n";

    return $src;
}

# Create a private 0700 temp directory if we don't have one yet
private func ensure_private_tmpdir() void {
    if ($g_tmpdir_owned == 1 && length($g_tmpdir) > 0 && core::is_dir($g_tmpdir) == 1) {
        return;
    }
    my str $d = core::mkdtemp("/tmp/strada_jit_XXXXXX");
    if (length($d) == 0) {
        throw "Strada::JIT: Could not create private temp directory";
    }
    $g_tmpdir = $d;
    $g_tmpdir_owned = 1;
}

# Compile and execute a single eval, returns result
private func eval_one(str $input) scalar {
    ensure_private_tmpdir();
    $g_eval_count = $g_eval_count + 1;

    my str $base = $g_tmpdir . "/strada_repl_lib_" . $g_eval_count;
    my str $src_file = $base . ".strada";
    my str $c_file = $base . ".c";
    my str $so_file = $base . ".so";

    # Register any new variables
    register_variables($input);

    # Generate Strada source
    my str $strada_src = generate_source($input);

    if ($g_debug == 1) {
        say("[JIT DEBUG] Generated source:");
        say($strada_src);
    }

    # Write source file
    my scalar $fh = core::open($src_file, "w");
    if (!defined($fh)) {
        throw "JIT: Could not create temp file: " . $src_file;
    }
    core::fwrite($fh, $strada_src);
    core::close($fh);

    # Step 1: stradac → C
    my str $stradac_cmd = shell_quote($g_stradac_path) . " ";
    foreach my str $lp (@g_lib_paths) {
        $stradac_cmd = $stradac_cmd . "-L " . shell_quote($lp) . " ";
    }
    $stradac_cmd = $stradac_cmd . shell_quote($src_file) . " " . shell_quote($c_file) . " 2>&1";
    my scalar $pipe = core::popen($stradac_cmd, "r");
    my str $compile_output = "";
    if (defined($pipe)) {
        my scalar $line = core::fgets($pipe, 4096);
        while (defined($line)) {
            $compile_output = $compile_output . $line;
            $line = core::fgets($pipe, 4096);
        }
        core::pclose($pipe);
    }

    if (core::is_file($c_file) == 0) {
        # Clean up
        core::unlink($src_file);
        # Extract useful error message
        my str $err_msg = $compile_output;
        $err_msg =~ s/^Strada Compiler[^\n]*\n//;
        $err_msg =~ s/^Compiling:[^\n]*\n//;
        $err_msg =~ s/^\s+//;
        $err_msg =~ s/\s+$//;
        throw "JIT compile error: " . $err_msg;
    }

    if ($g_cdebug == 1) {
        say("[JIT CDEBUG] Generated C: " . $c_file);
        my scalar $cfh = core::open($c_file, "r");
        if (defined($cfh)) {
            my str $cline = <$cfh>;
            while (defined($cline)) {
                print($cline);
                $cline = <$cfh>;
            }
            core::close($cfh);
        }
    }

    my scalar $result = undef;

    # Step 2: C → .so
    if ($g_compiler eq "tcc") {
        if ($g_runtime_path eq "") {
            core::unlink($src_file);
            core::unlink($c_file);
            throw "JIT: Could not find Strada runtime files for tcc backend";
        }

        my str $c_content = core::slurp($c_file);
        my str $hdr_line = "#include \"strada_runtime.h\"\n";
        my str $tcc_line = "#include \"strada_runtime_tcc.h\"\n";
        if (length($c_content) >= length($hdr_line) && substr($c_content, 0, length($hdr_line)) eq $hdr_line) {
            $c_content = $tcc_line . substr($c_content, length($hdr_line), length($c_content) - length($hdr_line));
        } else {
            my int $hpos = index($c_content, "\n" . $hdr_line);
            if ($hpos >= 0) {
                my int $after_h = $hpos + 1 + length($hdr_line);
                $c_content = substr($c_content, 0, $hpos + 1) . $tcc_line
                    . substr($c_content, $after_h, length($c_content) - $after_h);
            }
        }
        core::spew($c_file, $c_content);

        my str $tcc_cmd = "tcc -shared -o " . shell_quote($so_file) . " " . shell_quote($c_file) . " -I" . shell_quote($g_runtime_path) . " -ldl -lm -lpthread 2>&1";
        $pipe = core::popen($tcc_cmd, "r");
        my str $tcc_output = "";
        if (defined($pipe)) {
            my scalar $line = core::fgets($pipe, 4096);
            while (defined($line)) {
                $tcc_output = $tcc_output . $line;
                $line = core::fgets($pipe, 4096);
            }
            core::pclose($pipe);
        }

        if (core::is_file($so_file) == 0) {
            core::unlink($src_file);
            core::unlink($c_file);
            throw "JIT C compile error (tcc): " . $tcc_output;
        }
    } else {
        # gcc via the strada wrapper.
        # -O0 explicitly: snippets are one-shot (dlopen'd, executed, discarded),
        # so any -O2 + LTO time is pure overhead. -O0 also triggers strada's
        # speed flags (-pipe, -fno-var-tracking, etc).
        my str $gcc_cmd = "./strada -O0 --shared " . shell_quote($src_file) . " -o " . shell_quote($so_file) . " 2>&1";
        # If stradac is not in ./, try using the strada wrapper from stradac's dir
        if ($g_stradac_path ne "./stradac" && $g_stradac_path ne "stradac") {
            my str $stradac_dir = core::dirname($g_stradac_path);
            my str $strada_bin = $stradac_dir . "/strada";
            if (core::is_file($strada_bin) == 1) {
                $gcc_cmd = shell_quote($strada_bin) . " -O0 --shared " . shell_quote($src_file) . " -o " . shell_quote($so_file) . " 2>&1";
            }
        }
        $pipe = core::popen($gcc_cmd, "r");
        my str $output = "";
        if (defined($pipe)) {
            my scalar $line = core::fgets($pipe, 4096);
            while (defined($line)) {
                $output = $output . $line;
                $line = core::fgets($pipe, 4096);
            }
            core::pclose($pipe);
        }

        if (core::is_file($so_file) == 0) {
            core::unlink($src_file);
            if (core::is_file($c_file) == 1) {
                core::unlink($c_file);
            }
            throw "JIT C compile error (gcc): " . $output;
        }
    }

    # Step 3: Load and execute
    my array @mod_pkgs = keys(%g_oop_packages);
    my int $mpi = 0;
    my int $mp_count = scalar(@mod_pkgs);
    while ($mpi < $mp_count) {
        my str $mpkg = $mod_pkgs[$mpi];
        __C__ {
            char *p = strada_to_str(mpkg);
            if (p) {
                strada_oop_clear_modifiers(p);
                free(p);
            }
        }
        $mpi = $mpi + 1;
    }

    my int $lib = core::dl_open($so_file);
    if ($lib == 0) {
        my str $dl_err = core::dl_error();
        core::unlink($src_file);
        if (core::is_file($c_file) == 1) {
            core::unlink($c_file);
        }
        core::unlink($so_file);
        throw "JIT: Could not load compiled library: " . $dl_err;
    }

    # Keep handle tracked and unlink temp files immediately (unlinking an open .so keeps its mapping alive)
    push(@g_open_libs, $lib);
    core::unlink($src_file);
    if (core::is_file($c_file) == 1) {
        core::unlink($c_file);
    }
    if (core::is_file($so_file) == 1) {
        core::unlink($so_file);
    }

    my int $fn = core::dl_sym($lib, "repl_eval");
    if ($fn != 0) {
        $result = core::dl_call_sv($fn, undef);
    }

    return $result;
}

# ============================================================
# Public API
# ============================================================

# Initialize the JIT engine
# $compiler_pref: optional compiler preference ("tcc" or "gcc"), empty for auto-detect
func init(str ...@args) void {
    my str $compiler_pref = "";
    if (scalar(@args) > 0) {
        $compiler_pref = $args[0];
    }

    $g_stradac_path = detect_stradac();
    if ($g_stradac_path eq "") {
        throw "Strada::JIT::init: Could not find stradac compiler. Make sure stradac is in your PATH or run from the Strada directory.";
    }

    $g_runtime_path = detect_runtime();

    if ($compiler_pref ne "") {
        my int $available = 0;
        if ($compiler_pref eq "tcc") {
            __C__ {
                available = strada_new_int(repl_command_exists("tcc"));
            }
        } elsif ($compiler_pref eq "gcc") {
            __C__ {
                available = strada_new_int(repl_command_exists("gcc"));
            }
        } else {
            throw "Strada::JIT::init: Unknown compiler: " . $compiler_pref . " (valid: tcc, gcc)";
        }
        if ($available == 0) {
            throw "Strada::JIT::init: Compiler not available: " . $compiler_pref;
        }
        $g_compiler = $compiler_pref;
    } else {
        $g_compiler = detect_compiler();
        if ($g_compiler eq "") {
            throw "Strada::JIT::init: No C compiler found (need tcc or gcc)";
        }
    }

    ensure_private_tmpdir();
    $g_initialized = 1;
}

# Evaluate Strada code and return the result
func eval(str $code) scalar {
    if ($g_initialized == 0) {
        throw "Strada::JIT::eval: Not initialized. Call Strada::JIT::init() first.";
    }

    my str $input = $code;
    $input =~ s/^\s+//;
    $input =~ s/\s+$//;

    if ($input eq "") {
        return undef;
    }

    # Check for import statement (split trailing remainder after ';' if present)
    if (is_import($input)) {
        my int $semi = first_toplevel_semi($input);
        if ($semi >= 0) {
            my str $stmt = substr($input, 0, $semi + 1);
            my str $rem = substr($input, $semi + 1, length($input) - $semi - 1);
            $rem =~ s/^\s+//;
            $rem =~ s/\s+$//;
            register_import($stmt);
            if ($rem ne "") {
                return eval($rem);
            }
            return undef;
        }
        register_import($input);
        return undef;
    }

    # Check for package declaration (split trailing remainder after ';' if present)
    if (is_package_decl($input)) {
        my int $semi = first_toplevel_semi($input);
        my str $pkg_stmt = $input;
        my str $rem = "";
        if ($semi >= 0) {
            $pkg_stmt = substr($input, 0, $semi);
            $rem = substr($input, $semi + 1, length($input) - $semi - 1);
            $rem =~ s/^\s+//;
            $rem =~ s/\s+$//;
        }
        my str $pkg_name = $pkg_stmt;
        $pkg_name =~ s/^\s*package\s+//;
        $pkg_name =~ s/\s*;.*$//;
        $pkg_name =~ s/\s+$//;
        $g_current_package = $pkg_name;
        if ($rem ne "") {
            return eval($rem);
        }
        return undef;
    }

    # Check for const declaration (split trailing remainder if present)
    if ($input =~ /^\s*const\s+/) {
        my int $semi = first_toplevel_semi($input);
        my str $const_line = $input;
        my str $rem = "";
        if ($semi >= 0) {
            $const_line = substr($input, 0, $semi + 1);
            $rem = substr($input, $semi + 1, length($input) - $semi - 1);
            $rem =~ s/^\s+//;
            $rem =~ s/\s+$//;
        } else {
            $const_line =~ s/\s+$//;
            if (substr($const_line, length($const_line) - 1, 1) ne ";") {
                $const_line = $const_line . ";";
            }
        }
        push(@g_constants, "package " . get_target_package() . ";\n" . $const_line);
        if ($rem ne "") {
            return eval($rem);
        }
        return undef;
    }

    # Check for enum declaration
    if ($input =~ /^\s*enum\s+/) {
        my array @eparts = extract_function_def($input);
        my str $enum_line = $eparts[0];
        $enum_line =~ s/\s+$//;
        if (substr($enum_line, length($enum_line) - 1, 1) ne "}") {
            if (substr($enum_line, length($enum_line) - 1, 1) ne ";") {
                $enum_line = $enum_line . ";";
            }
        }
        push(@g_constants, "package " . get_target_package() . ";\n" . $enum_line);
        if ($eparts[1] ne "") {
            return eval($eparts[1]);
        }
        return undef;
    }

    # Check for OOP package-level statements (has, extends, use overload)
    if (is_oop_decl($input)) {
        my int $semi = first_toplevel_semi($input);
        my str $oop_stmt = $input;
        my str $rem = "";
        if ($semi >= 0) {
            $oop_stmt = substr($input, 0, $semi + 1);
            $rem = substr($input, $semi + 1, length($input) - $semi - 1);
            $rem =~ s/^\s+//;
            $rem =~ s/\s+$//;
        } else {
            $oop_stmt =~ s/\s+$//;
            if (substr($oop_stmt, length($oop_stmt) - 1, 1) ne ";") {
                $oop_stmt = $oop_stmt . ";";
            }
        }
        my str $tpkg = get_target_package();
        track_oop_package($tpkg);
        push(@g_constants, "package " . $tpkg . ";\n" . $oop_stmt);
        if ($rem ne "") {
            return eval($rem);
        }
        return undef;
    }

    # Check for method modifier (before/after/around)
    if (is_modifier_def($input)) {
        my array @mparts = extract_function_def($input);
        my str $tpkg = get_target_package();
        track_oop_package($tpkg);
        push(@g_functions, "package " . $tpkg . ";\n" . $mparts[0]);
        if ($mparts[1] ne "") {
            return eval($mparts[1]);
        }
        return undef;
    }

    # Check for function definition
    if (is_function_def($input)) {
        my array @parts = extract_function_def($input);
        register_function($parts[0]);

        # If there's a remainder after the function def, evaluate it recursively
        if ($parts[1] ne "") {
            return eval($parts[1]);
        }
        return undef;
    }

    return eval_one($input);
}

# Compile a script file as a complete program in one shot and exec it.
# Returns the script's exit code (the rc from the compiled binary, or a
# non-zero compile-error code if stradac/cc fails).
#
# This is the whole-file counterpart to eval(): it avoids the per-statement
# compile overhead of the REPL-style chunked path by handing the whole file
# to stradac at once, then exec'ing the resulting executable. Intended for
# the `strada --script FILE` entry point.
#
# Reuses the `strada` driver script for the compile (so it benefits from
# PCRE2 / runtime path / optimization handling without duplicating logic).
func run_file(str $filename) int {
    if ($g_initialized == 0) {
        throw "Strada::JIT::run_file: Not initialized. Call init() first.";
    }
    ensure_private_tmpdir();
    if (core::is_file($filename) == 0) {
        throw "Strada::JIT::run_file: File not found: " . $filename;
    }

    # Locate the strada driver next to the stradac we already found.
    my str $strada_bin = "";
    if ($g_stradac_path ne "" && $g_stradac_path ne "stradac") {
        my str $cand = core::dirname($g_stradac_path) . "/strada";
        if (core::is_file($cand) == 1) {
            $strada_bin = $cand;
        }
    }
    if ($strada_bin eq "") {
        $strada_bin = "strada";  # fall back to PATH
    }

    my int $pid = core::getpid();
    my str $exe_file = $g_tmpdir . "/strada_script_" . $pid;

    # Compile via the driver — quote paths defensively in case they contain spaces.
    my str $compile_cmd = shell_quote($strada_bin) . " -o " . shell_quote($exe_file) . " " . shell_quote($filename);
    my int $rc = core::system($compile_cmd);
    if ($rc != 0 || core::is_file($exe_file) == 0) {
        if ($rc == 0) { $rc = 1; }
        return $rc;
    }

    # Exec and propagate the script's exit code.
    $rc = core::system(shell_quote($exe_file));
    core::unlink($exe_file);
    return $rc;
}

# Get a variable value from the persistent state (global registry)
func get(str $name) scalar {
    my str $key = "repl::" . $name;
    return core::global_get($key);
}

# Set a variable value in the persistent state (global registry)
func set(str $name, scalar $value) void {
    my str $key = "repl::" . $name;
    core::global_set($key, $value);
    # Also register the type if not already known
    if (!exists($g_var_types{$name})) {
        $g_var_types{$name} = "scalar";
    }
}

# Add a library search path
func add_lib_path(str $path) void {
    foreach my str $existing (@g_lib_paths) {
        if ($existing eq $path) {
            return;
        }
    }
    push(@g_lib_paths, $path);
}

# Reset all state (variables, functions, imports)
func reset() void {
    # Delete all repl:: globals from the registry
    # NOTE: must iterate keys BEFORE clearing the hash (parser bug:
    # %hash = () after while/foreach block is mis-parsed as MOD operator)
    my array @var_names = keys(%g_var_types);
    my int $vi = 0;
    my int $var_count = scalar(@var_names);
    my array @oop_pkgs = keys(%g_oop_packages);
    my int $opi = 0;
    my int $oop_pkg_count = scalar(@oop_pkgs);

    # Clear state hashes/arrays first (before any loops)
    %g_var_types = ();
    %g_oop_packages = ();
    @g_functions = ();
    @g_constants = ();
    @g_imports = ();
    $g_current_package = "";
    $g_eval_count = 0;

    # Now delete globals using the saved key list
    while ($vi < $var_count) {
        core::global_delete("repl::" . $var_names[$vi]);
        $vi = $vi + 1;
    }

    # Collect cyclic closures before dlclosing their shared libraries
    core::gc_collect();

    # Close accumulated library handles and clean up .so files
    my array @libs_to_close = @g_open_libs;
    my array @files_to_delete = @g_so_files;
    @g_open_libs = ();
    @g_so_files = ();

    # Reset OOP metadata for JIT-loaded packages before dlclosing their .so mappings
    while ($opi < $oop_pkg_count) {
        my str $opkg = $oop_pkgs[$opi];
        __C__ {
            char *p = strada_to_str(opkg);
            if (p) {
                strada_oop_reset_package(p);
                free(p);
            }
        }
        $opi = $opi + 1;
    }

    my int $li = 0;
    my int $lib_count = scalar(@libs_to_close);
    while ($li < $lib_count) {
        core::dl_close($libs_to_close[$li]);
        $li = $li + 1;
    }
    my int $fi = 0;
    my int $file_count = scalar(@files_to_delete);
    while ($fi < $file_count) {
        if (core::is_file($files_to_delete[$fi]) == 1) {
            core::unlink($files_to_delete[$fi]);
        }
        $fi = $fi + 1;
    }
    if ($g_tmpdir_owned == 1 && length($g_tmpdir) > 0 && $g_tmpdir ne "/tmp") {
        core::rmdir($g_tmpdir);
        $g_tmpdir = "/tmp";
        $g_tmpdir_owned = 0;
    }
}

# Enable/disable debug mode (shows generated source)
func debug(int $enabled) void {
    $g_debug = $enabled;
}

# Enable/disable C debug mode (shows generated C code)
func cdebug(int $enabled) void {
    $g_cdebug = $enabled;
}

# Get the detected compiler name
func compiler() str {
    return $g_compiler;
}

# Get variable names and types as a hash (name -> type)
func var_types() hash {
    return %g_var_types;
}

# Get accumulated function definitions as an array
func functions() array {
    return @g_functions;
}

# Get accumulated import statements as an array
func imports() array {
    return @g_imports;
}

# Get library search paths as an array
func lib_paths() array {
    return @g_lib_paths;
}

# Get/set current package name
func current_package() str {
    return $g_current_package;
}

func set_package(str $name) void {
    $g_current_package = $name;
}

# Get the state hash (for direct access by JIT tools)
# Fetches current values from the global registry
func state() hash {
    my hash %result = ();
    my array @var_names = keys(%g_var_types);
    my int $si = 0;
    my int $scount = scalar(@var_names);
    while ($si < $scount) {
        my str $vname = $var_names[$si];
        my scalar $val = core::global_get("repl::" . $vname);
        $result{$vname} = $val;
        $si = $si + 1;
    }
    return %result;
}

# Check if input is a function definition (public wrapper)
func check_function_def(str $input) int {
    return is_function_def($input);
}

# Check if input is an import statement (public wrapper)
func check_import(str $input) int {
    return is_import($input);
}

# Check if input is a package declaration (public wrapper)
func check_package_decl(str $input) int {
    return is_package_decl($input);
}

# Check if braces/parens/brackets are balanced
func is_balanced(str $input) int {
    my int $braces = 0;
    my int $parens = 0;
    my int $brackets = 0;
    my int $in_str = 0;
    my int $in_cmt = 0;

    my int $len = length($input);
    my int $i = 0;
    while ($i < $len) {
        my str $c = substr($input, $i, 1);

        if ($in_cmt == 1) {
            if ($c eq "\n") { $in_cmt = 0; }
            $i = $i + 1;
            next;
        }
        if ($in_str == 1) {
            if ($c eq "\\" && $i + 1 < $len) { $i = $i + 2; next; }
            if ($c eq "\"") { $in_str = 0; }
            $i = $i + 1;
            next;
        }
        if ($in_str == 2) {
            if ($c eq "\\" && $i + 1 < $len) { $i = $i + 2; next; }
            if ($c eq "'") { $in_str = 0; }
            $i = $i + 1;
            next;
        }

        if ($c eq "\"") { $in_str = 1; $i = $i + 1; next; }
        if ($c eq "'") { $in_str = 2; $i = $i + 1; next; }
        if ($c eq "#") { $in_cmt = 1; $i = $i + 1; next; }

        if ($c eq "{") { $braces = $braces + 1; }
        if ($c eq "}") { $braces = $braces - 1; }
        if ($c eq "(") { $parens = $parens + 1; }
        if ($c eq ")") { $parens = $parens - 1; }
        if ($c eq "[") { $brackets = $brackets + 1; }
        if ($c eq "]") { $brackets = $brackets - 1; }

        $i = $i + 1;
    }

    if ($braces == 0 && $parens == 0) {
        if (index($input, "{") < 0) {
            if ($input =~ /^func\s+/ || $input =~ /^fn\s+/ || $input =~ /^async\s+/ || $input =~ /^private\s+/) {
                return 0;
            }
        }
    }

    if ($braces == 0 && $parens == 0 && $brackets == 0) {
        return 1;
    }
    return 0;
}

END {
    Strada::JIT::reset();
}
