# Strada::Eval - runtime eval() via bytecode VM

package Strada::Interpreter;

# eval(code) — evaluates Strada source via the bytecode VM.
func eval(str $code) scalar {
    return eval_string_vm($code);
}

# eval_with(code, backend) — retained for API compatibility; always uses VM.
func eval_with(str $code, str $backend) scalar {
    return eval_string_vm($code);
}
