=head1 NAME

Strada::Interpreter - Bytecode VM interpreter and eval engine for Strada

=head1 SYNOPSIS

    use lib "lib";
    use Eval;

    # Evaluate Strada expressions and statements via the bytecode VM
    my scalar $result = Strada::Interpreter::eval("1 + 2");        # returns 3
    my scalar $s = Strada::Interpreter::eval("\"hi\" . \"!\"");    # returns "hi!"

    # Variables persist across eval calls
    Strada::Interpreter::eval("my int \$x = 10;");
    my scalar $v = Strada::Interpreter::eval("\$x * 5");           # returns 50

    # Function definitions persist
    Strada::Interpreter::eval("func square(int \$n) int { return \$n * \$n; }");
    my scalar $r = Strada::Interpreter::eval("square(7)");         # returns 49

    # Reset all eval session state
    Strada::Interpreter::reset();

=head1 DESCRIPTION

C<Strada::Interpreter> provides runtime Strada evaluation backed by the
bytecode VM (C<interpreter/vm.c> and C<interpreter/vm_compiler.c>).
It reuses the compiler's Lexer and Parser for the front-end, compiles AST
programs to bytecode, and executes them on the VM without spawning an
external C compiler.

=head1 PUBLIC EVAL API

=head2 Strada::Interpreter::init()

No-op initializer kept for backwards compatibility. Calling C<eval()> or
C<eval_string()> initializes session state automatically on demand.

=head2 Strada::Interpreter::eval(str $code) scalar

=head2 Strada::Interpreter::eval_string(str $code) scalar

=head2 Strada::Interpreter::eval_string_vm(str $code) scalar

Parse, compile to bytecode, and evaluate a string of Strada code.
Top-level variables, functions, packages, enums, constants, and OOP
definitions persist across calls until C<reset()> is called.
Throws an exception on parse, compile, or runtime errors.

=head2 Strada::Interpreter::reset()

Reset all persisted eval session state (globals, declarations, functions,
and active package).

=head2 Strada::Interpreter::set_eval_backend(str $backend)

=head2 Strada::Interpreter::get_eval_backend() str

Legacy backend configuration accessors retained for API compatibility.
Always uses C<"vm">.

=head1 SEE ALSO

=over

=item * C<interpreter/Main.strada> - Standalone bytecode VM interpreter and REPL

=item * L<Strada::JIT> - JIT eval via compile-to-C (requires a C compiler at runtime)

=back

=cut

package Strada::Interpreter;

# Interpreter-local node type constants (compiled to #define, zero overhead)
enum NI {
    PROGRAM = 1, FUNC = 2, PARAM = 3, BLOCK = 4, VAR_DECL = 5,
    IF_STMT = 6, WHILE_STMT = 7, FOR_STMT = 8, RETURN_STMT = 9,
    EXPR_STMT = 10, BINARY_OP = 11, UNARY_OP = 12, CALL = 13,
    VARIABLE = 14, INT_LITERAL = 15, NUM_LITERAL = 16, STR_LITERAL = 17,
    ASSIGN = 18, SUBSCRIPT = 19, HASH_ACCESS = 20, REF = 21,
    DEREF_HASH = 22, DEREF_ARRAY = 23, DEREF_SCALAR = 24,
    ANON_HASH = 25, ANON_ARRAY = 26, EXTERN_FUNC = 27, USE = 29,
    FIELD_ACCESS = 30, FUNC_REF = 31, METHOD_CALL = 32,
    DUNDER_PACKAGE = 33, REGEX_MATCH = 34, REGEX_SUBST = 35,
    DUNDER_FILE = 36, DUNDER_LINE = 37,
    LAST = 100, NEXT = 101, UNDEF = 102, MAP = 103, SORT = 104,
    GREP = 105, TRY_CATCH = 106, THROW = 107, LABEL = 108,
    GOTO = 109, FOREACH_STMT = 110, ANON_FUNC = 111,
    CLOSURE_CALL = 112, TERNARY = 113, SWITCH = 114, RANGE = 115,
    SUPER_CALL = 116, INCREMENT = 117, ENUM_DECL = 118, C_BLOCK = 119,
    SPREAD = 120, CATCH_CLAUSE = 121, ASYNC_FUNC = 122, AWAIT = 123,
    READLINE = 124, DESTRUCTURE = 125, DO_WHILE_STMT = 126,
    CONST_DECL = 127, BEGIN_BLOCK = 128, END_BLOCK = 129,
    ARRAY_SLICE = 130, HASH_SLICE = 131, OUR_DECL = 132, REDO = 133,
    TR = 134, LOCAL_DECL = 135, CAPTURE_VAR = 136, DYN_METHOD_CALL = 137,
    DO_EXPR = 138
}

__C__ {
#include <stdlib.h>
#include <string.h>
#include <stdio.h>
#include <unistd.h>
#include <pthread.h>

/* VM bytecode backend for eval (linked from runtime/vm.o + runtime/vm_compiler.o) */
#include "vm.h"
#include "vm_compiler.h"

static pthread_mutex_t g_eval_vm_mutex;
static pthread_once_t g_eval_vm_once = PTHREAD_ONCE_INIT;
static void eval_vm_init_once(void) {
    pthread_mutexattr_t attr;
    pthread_mutexattr_init(&attr);
    pthread_mutexattr_settype(&attr, PTHREAD_MUTEX_RECURSIVE);
    pthread_mutex_init(&g_eval_vm_mutex, &attr);
    pthread_mutexattr_destroy(&attr);
}
static inline void eval_vm_lock(void) {
    pthread_once(&g_eval_vm_once, eval_vm_init_once);
    /* GC-safe while waiting: the holder may start a stop-the-world cycle
     * collection, which must not wait for us (V5-1). */
    strada_gc_mutex_lock(&g_eval_vm_mutex);
}
static inline void eval_vm_unlock(void) {
    pthread_mutex_unlock(&g_eval_vm_mutex);
}

#define EVAL_ACTIVE_MAX 64
typedef struct {
    VM *vms[EVAL_ACTIVE_MAX];
    int depth;
} EvalActiveStack;
#ifndef STRADA_NO_TLS
static __thread EvalActiveStack g_eval_active_stack = {{NULL}, 0};
static EvalActiveStack *eval_active_stack_get(void) { return &g_eval_active_stack; }
#else
static pthread_key_t g_eval_active_key;
static pthread_once_t g_eval_active_once = PTHREAD_ONCE_INIT;
static void eval_active_destroy(void *p) { free(p); }
static void eval_active_key_init(void) { pthread_key_create(&g_eval_active_key, eval_active_destroy); }
static EvalActiveStack *eval_active_stack_get(void) {
    pthread_once(&g_eval_active_once, eval_active_key_init);
    EvalActiveStack *s = (EvalActiveStack *)pthread_getspecific(g_eval_active_key);
    if (!s) {
        s = calloc(1, sizeof(EvalActiveStack));
        pthread_setspecific(g_eval_active_key, s);
    }
    return s;
}
#endif

/* ---- Session sync for closures / methods of non-active eval VMs ----
 * Every eval runs in its own VM, seeded from and exported back to the
 * session store (%g_eval_vm_globals). A closure or object made by an earlier
 * eval still runs in that earlier VM, so around such a call the VM is synced
 * with the store (V5-6): before, the running eval (if any) is exported and
 * the target seeded when it is behind; after, the target is exported and the
 * running eval re-seeded. g_eval_store_gen counts store updates; a VM whose
 * eval_sync_gen matches is current. reset() starts a new epoch: VMs of an
 * older epoch keep their own state and never touch the new session. */
static StradaValue *g_eval_store_sv = NULL;   /* ref to %g_eval_vm_globals */
static uint64_t g_eval_store_gen = 1;
static uint32_t g_eval_epoch = 1;
static VM *g_eval_host_vm = NULL;             /* latest eval's VM: host method dispatch */
static VMProgram *g_eval_host_prog = NULL;

static void eval_foreign_vm_hook(VM *target, int phase) {
    if (!target || !g_eval_store_sv) return;
    eval_vm_lock();
    if (target->eval_epoch != g_eval_epoch || target->eval_running) {
        eval_vm_unlock();
        return;
    }
    EvalActiveStack *es = eval_active_stack_get();
    VM *cur = (es->depth > 0) ? es->vms[es->depth - 1] : NULL;
    if (cur == target || (cur && cur->eval_epoch != g_eval_epoch)) cur = NULL;
    if (phase == 0) {
        if (cur) {
            vm_export_globals(cur, g_eval_store_sv);
            g_eval_store_gen++;
            cur->eval_sync_gen = g_eval_store_gen;
        }
        if (target->eval_sync_gen != g_eval_store_gen) {
            vm_seed_globals(target, g_eval_store_sv, NULL);
            target->eval_sync_gen = g_eval_store_gen;
        }
    } else {
        vm_export_globals(target, g_eval_store_sv);
        g_eval_store_gen++;
        target->eval_sync_gen = g_eval_store_gen;
        if (cur) {
            vm_seed_globals(cur, g_eval_store_sv, NULL);
            cur->eval_sync_gen = g_eval_store_gen;
        }
    }
    eval_vm_unlock();
}

/* AUTOLOAD registered in the host for classes defined in eval code: a method
 * call on such an object from host code runs the method in the latest eval
 * VM (whose program has every class of the session) -- V5-9. */
static StradaValue *eval_host_autoload(StradaValue *self, StradaValue *args) {
    char mname[256];
    mname[0] = 0;
    StradaArray *aa = (args && !STRADA_IS_TAGGED_INT(args) && args->type == STRADA_ARRAY) ? args->value.av : NULL;
    size_t an = aa ? aa->size : 0;
    if (an > 0) {
        char *m = strada_to_str(strada_array_get(aa, 0));
        if (m) { snprintf(mname, sizeof(mname), "%s", m); free(m); }
    }
    const char *cls = (self && !STRADA_IS_TAGGED_INT(self) && self->meta) ? self->meta->blessed_package : NULL;
    if (strcmp(mname, "DESTROY") == 0) return strada_new_undef();
    eval_vm_lock();
    VM *hv = g_eval_host_vm;
    if (hv) vm_retain(hv);
    eval_vm_unlock();
    StradaValue *res = NULL;
    if (hv && cls) {
        int argc = (int)(an > 0 ? an : 1);
        StradaValue *sbuf[16];
        StradaValue **argv = (argc > 16) ? malloc((size_t)argc * sizeof(StradaValue *)) : sbuf;
        argv[0] = self;
        for (size_t i = 1; i < an; i++) argv[i] = strada_array_get(aa, (int64_t)i);
        int cm = strada_cleanup_mark();
        if (setjmp(*STRADA_TRY_PUSH()) == 0) {
            res = vm_host_method_call(hv, cls, mname, argc, argv);
            STRADA_TRY_POP();
        } else {
            STRADA_TRY_POP();
            strada_cleanup_drain_to(cm);
            StradaValue *ex = strada_get_exception();
            /* strada_get_exception() hands over its reference */
            strada_clear_exception();
            if (argv != sbuf) free(argv);
            vm_free(hv);
            strada_throw_value(ex ? ex : strada_new_str("eval method failed"));
            return strada_new_undef();
        }
        if (argv != sbuf) free(argv);
    }
    if (hv) vm_free(hv);
    if (!res) {
        char msg[640];
        snprintf(msg, sizeof(msg), "Can't locate method \"%s\" via package \"%s\" or its parents", mname, cls ? cls : "");
        strada_throw(msg);
        return strada_new_undef();
    }
    return res;
}

/* Make the classes of an eval program known to host dispatch: inheritance
 * (typed catch / isa) and an AUTOLOAD into the VM for their methods. */
static void eval_register_host_classes(VMProgram *p, StradaValue *pkgs) {
    if (!p) return;
    for (int i = 0; i < p->inherit_count; i++) {
        if (p->inherits[i].child && p->inherits[i].parent)
            strada_inherit(p->inherits[i].child, p->inherits[i].parent);
    }
    if (pkgs && !STRADA_IS_TAGGED_INT(pkgs) && pkgs->type == STRADA_REF) pkgs = pkgs->value.rv;
    if (!pkgs || STRADA_IS_TAGGED_INT(pkgs) || pkgs->type != STRADA_ARRAY) return;
    for (size_t i = 0; i < pkgs->value.av->size; i++) {
        char *pkg = strada_to_str(strada_array_get(pkgs->value.av, (int64_t)i));
        if (pkg && pkg[0] && strada_method_lookup_package(pkg, "AUTOLOAD") == NULL)
            strada_method_register(pkg, "AUTOLOAD", eval_host_autoload);
        free(pkg);
    }
}
}

# Persistent VM eval / REPL session state
my str $g_eval_vm_pkg = "main";
my str $g_eval_vm_decls = "";
my int $g_eval_vm_decls_globals = 0;
my hash %g_eval_vm_globals = ();
my hash %g_eval_vm_our_names = ();
# import() functions already called by an earlier eval: the persisted
# `use` lines recompile with every eval, but a module imports once
my hash %g_eval_vm_imports_done = ();
my hash %g_eval_vm_funcs = ();
my array @g_eval_vm_lib_paths = ();
my str $g_eval_backend = "vm";

func eval_is_ident_char(str $ch) int {
    my int $o = ord($ch);
    if (($o >= 65 && $o <= 90) || ($o >= 97 && $o <= 122) || ($o >= 48 && $o <= 57) || $ch eq "_") {
        return 1;
    }
    return 0;
}

func eval_is_ws_char(str $ch) int {
    if ($ch eq " " || $ch eq "\t" || $ch eq "\n" || $ch eq "\r") {
        return 1;
    }
    return 0;
}

func eval_skip_ws_cmt(str $code, int $pos, int $len) int {
    my int $i = $pos;
    while ($i < $len) {
        my str $c = substr($code, $i, 1);
        if (eval_is_ws_char($c) == 1) {
            $i = $i + 1;
            next;
        }
        if ($c eq "#") {
            while ($i < $len && substr($code, $i, 1) ne "\n") {
                $i = $i + 1;
            }
            next;
        }
        if ($c eq "/" && $i + 1 < $len && substr($code, $i + 1, 1) eq "*") {
            $i = $i + 2;
            while ($i + 1 < $len && (substr($code, $i, 1) ne "*" || substr($code, $i + 1, 1) ne "/")) {
                $i = $i + 1;
            }
            if ($i + 1 < $len) { $i = $i + 2; } else { $i = $len; }
            next;
        }
        last;
    }
    return $i;
}

func eval_read_word(str $code, int $pos, int $len) str {
    my int $j = $pos;
    while ($j < $len && eval_is_ident_char(substr($code, $j, 1)) == 1) {
        $j = $j + 1;
    }
    return substr($code, $pos, $j - $pos);
}

func eval_scan_regex_body(str $code, int $pos, int $len, int $allow_cc) int {
    my int $i = $pos;
    my int $in_cc = 0;
    my int $cc_start = 0;
    while ($i < $len) {
        my str $c = substr($code, $i, 1);
        if ($c eq "\\" && $i + 1 < $len) {
            $cc_start = 0;
            $i = $i + 2;
            next;
        }
        if ($allow_cc == 1) {
            if ($in_cc == 1) {
                if ($c eq "^" && $cc_start == 1) {
                    $i = $i + 1;
                    next;
                }
                if ($c eq "]" && $cc_start == 0) {
                    $in_cc = 0;
                }
                $cc_start = 0;
                $i = $i + 1;
                next;
            }
            if ($c eq "[") {
                $in_cc = 1;
                $cc_start = 1;
                $i = $i + 1;
                next;
            }
        }
        if ($c eq "/") {
            return $i + 1;
        }
        $i = $i + 1;
    }
    return -1;
}

func eval_is_regex_prefix(str $prev_sig, str $prev_word) int {
    if ($prev_sig eq "" || $prev_sig eq "~" || $prev_sig eq "=" || $prev_sig eq "(" ||
        $prev_sig eq "[" || $prev_sig eq "{" || $prev_sig eq "," || $prev_sig eq ";" ||
        $prev_sig eq "!" || $prev_sig eq "?" || $prev_sig eq ":" || $prev_sig eq "&" ||
        $prev_sig eq "|") {
        return 1;
    }
    if ($prev_word eq "return" || $prev_word eq "if" || $prev_word eq "elsif" ||
        $prev_word eq "unless" || $prev_word eq "while" || $prev_word eq "until" ||
        $prev_word eq "split" || $prev_word eq "match") {
        return 1;
    }
    return 0;
}

func eval_is_heredoc_prefix(str $prev_sig, str $prev_word) int {
    if (eval_is_regex_prefix($prev_sig, $prev_word) == 1 || $prev_sig eq ".") {
        return 1;
    }
    if ($prev_word eq "say" || $prev_word eq "print" || $prev_word eq "warn" ||
        $prev_word eq "throw" || $prev_word eq "die" || $prev_word eq "push" ||
        $prev_word eq "unshift") {
        return 1;
    }
    return 0;
}

func eval_try_skip_regex(str $code, int $i, int $start, int $len, str $prev_sig, str $prev_word) int {
    my str $c = substr($code, $i, 1);
    if (($c eq "s" || $c eq "t" || $c eq "y" || $c eq "m") &&
        ($i == $start || eval_is_ident_char(substr($code, $i - 1, 1)) == 0)) {
        my str $w = eval_read_word($code, $i, $len);
        if ($w eq "s" || $w eq "tr" || $w eq "y" || $w eq "m") {
            my int $after_w = $i + length($w);
            if ($after_w < $len && substr($code, $after_w, 1) eq "/") {
                my int $use_cc = ($w eq "s" || $w eq "m") ? 1 : 0;
                my int $end1 = eval_scan_regex_body($code, $after_w + 1, $len, $use_cc);
                if ($end1 >= 0) {
                    if ($w ne "m") {
                        my int $end2 = eval_scan_regex_body($code, $end1, $len, 0);
                        if ($end2 >= 0) { $end1 = $end2; }
                    }
                    while ($end1 < $len && (substr($code, $end1, 1) =~ /[a-zA-Z]/)) {
                        $end1 = $end1 + 1;
                    }
                    return $end1;
                }
            }
        }
    }
    if ($c eq "/" && eval_is_regex_prefix($prev_sig, $prev_word) == 1) {
        if ($i + 1 < $len && substr($code, $i + 1, 1) eq "/" && $prev_sig ne "~") {
            return -1;
        }
        my int $endr = eval_scan_regex_body($code, $i + 1, $len, 1);
        if ($endr >= 0) {
            while ($endr < $len && (substr($code, $endr, 1) =~ /[a-zA-Z]/)) {
                $endr = $endr + 1;
            }
            return $endr;
        }
    }
    return -1;
}

func eval_try_parse_heredoc(str $code, int $i, int $len, str $prev_sig, str $prev_word) scalar {
    if ($i + 1 >= $len || substr($code, $i, 2) ne "<<") { return undef; }
    if (eval_is_heredoc_prefix($prev_sig, $prev_word) == 0) { return undef; }
    my int $hp = $i + 2;
    if ($hp >= $len) { return undef; }
    my str $hc0 = substr($code, $hp, 1);
    if (eval_is_ident_char($hc0) == 1 && !($hc0 ge "0" && $hc0 le "9")) {
        my str $tag = eval_read_word($code, $hp, $len);
        return { "tag" => $tag, "end" => $hp + length($tag) };
    }
    my int $qp = $hp;
    while ($qp < $len && (substr($code, $qp, 1) eq " " || substr($code, $qp, 1) eq "\t")) {
        $qp = $qp + 1;
    }
    if ($qp < $len) {
        my str $qc = substr($code, $qp, 1);
        if ($qc eq "'" || $qc eq "\"") {
            my int $qe = $qp + 1;
            while ($qe < $len && substr($code, $qe, 1) ne $qc && substr($code, $qe, 1) ne "\n") {
                $qe = $qe + 1;
            }
            if ($qe < $len && substr($code, $qe, 1) eq $qc && $qe > $qp + 1) {
                return { "tag" => substr($code, $qp + 1, $qe - ($qp + 1)), "end" => $qe + 1 };
            }
        }
    }
    return undef;
}

func eval_skip_heredoc_bodies(str $code, int $pos, int $len, array @tags) int {
    my int $i = $pos;
    my int $ti = 0;
    my int $tc = size(@tags);
    while ($ti < $tc && $i < $len) {
        my str $tag = $tags[$ti];
        $ti = $ti + 1;
        while ($i < $len) {
            my int $nl = index($code, "\n", $i);
            my int $lend = ($nl < 0) ? $len : $nl;
            my str $hline = substr($code, $i, $lend - $i);
            if (length($hline) > 0 && substr($hline, length($hline) - 1, 1) eq "\r") {
                $hline = substr($hline, 0, length($hline) - 1);
            }
            $i = ($nl < 0) ? $len : ($nl + 1);
            if ($hline eq $tag) { last; }
        }
    }
    return $i;
}

func eval_scan_unit(str $code, int $start, int $len, int $brace_mode) int {
    my int $i = $start;
    my int $depth = 0;
    my int $pdepth = 0;
    my int $bdepth = 0;
    my int $seen_brace = 0;
    my str $prev_sig = "";
    my str $prev_word = "";
    my array @heredoc_tags = ();

    while ($i < $len) {
        my str $c = substr($code, $i, 1);
        if ($c eq "\n" && size(@heredoc_tags) > 0) {
            $i = eval_skip_heredoc_bodies($code, $i + 1, $len, @heredoc_tags);
            @heredoc_tags = ();
            $prev_sig = "\"";
            $prev_word = "";
            next;
        }
        if ($c eq "#") {
            while ($i < $len && substr($code, $i, 1) ne "\n") {
                $i = $i + 1;
            }
            next;
        }
        if ($c eq "/" && $i + 1 < $len && substr($code, $i + 1, 1) eq "*") {
            $i = $i + 2;
            while ($i + 1 < $len && (substr($code, $i, 1) ne "*" || substr($code, $i + 1, 1) ne "/")) {
                $i = $i + 1;
            }
            if ($i + 1 < $len) { $i = $i + 2; } else { $i = $len; }
            next;
        }
        if ($c eq "\"" || $c eq "'") {
            my str $q = $c;
            $i = $i + 1;
            while ($i < $len) {
                my str $sc = substr($code, $i, 1);
                if ($sc eq "\\" && $i + 1 < $len) {
                    $i = $i + 2;
                    next;
                }
                if ($sc eq $q) {
                    $i = $i + 1;
                    last;
                }
                $i = $i + 1;
            }
            $prev_sig = $q;
            $prev_word = "";
            next;
        }

        if ($c eq "<") {
            my scalar $hd = eval_try_parse_heredoc($code, $i, $len, $prev_sig, $prev_word);
            if (defined($hd)) {
                push(@heredoc_tags, $hd->{"tag"});
                $i = $hd->{"end"};
                $prev_sig = "\"";
                $prev_word = "";
                next;
            }
        }

        my int $rx_end = eval_try_skip_regex($code, $i, $start, $len, $prev_sig, $prev_word);
        if ($rx_end >= 0) {
            $i = $rx_end;
            $prev_sig = "/";
            $prev_word = "";
            next;
        }

        if (eval_is_ident_char($c) == 1) {
            my str $w2 = eval_read_word($code, $i, $len);
            $prev_word = $w2;
            $prev_sig = "w";
            $i = $i + length($w2);
            next;
        }

        if ($c eq "{") {
            $depth = $depth + 1;
            $seen_brace = 1;
        } elsif ($c eq "}") {
            if ($depth > 0) { $depth = $depth - 1; }
            if ($brace_mode == 1 && $seen_brace == 1 && $depth == 0 && $pdepth == 0 && $bdepth == 0 && size(@heredoc_tags) == 0) {
                return $i + 1;
            }
        } elsif ($c eq "(") {
            $pdepth = $pdepth + 1;
        } elsif ($c eq ")") {
            if ($pdepth > 0) { $pdepth = $pdepth - 1; }
        } elsif ($c eq "[") {
            $bdepth = $bdepth + 1;
        } elsif ($c eq "]") {
            if ($bdepth > 0) { $bdepth = $bdepth - 1; }
        } elsif ($brace_mode == 0 && $c eq ";" && $depth == 0 && $pdepth == 0 && $bdepth == 0) {
            if (size(@heredoc_tags) == 0) {
                return $i + 1;
            }
            my int $nl = index($code, "\n", $i + 1);
            if ($nl < 0) { return $len; }
            return eval_skip_heredoc_bodies($code, $nl + 1, $len, @heredoc_tags);
        }

        if (eval_is_ws_char($c) == 0) {
            $prev_sig = $c;
            $prev_word = "";
        }
        $i = $i + 1;
    }
    return $len;
}

func eval_strip_our_init(str $chunk) str {
    my int $len = length($chunk);
    my int $i = 0;
    my int $depth = 0;
    while ($i < $len) {
        my str $c = substr($chunk, $i, 1);
        if ($c eq "\"" || $c eq "'") {
            my str $q = $c;
            $i = $i + 1;
            while ($i < $len) {
                my str $sc = substr($chunk, $i, 1);
                if ($sc eq "\\" && $i + 1 < $len) {
                    $i = $i + 2;
                    next;
                }
                if ($sc eq $q) {
                    $i = $i + 1;
                    last;
                }
                $i = $i + 1;
            }
            next;
        }
        if ($c eq "#") {
            while ($i < $len && substr($chunk, $i, 1) ne "\n") {
                $i = $i + 1;
            }
            next;
        }
        if ($c eq "/" && $i + 1 < $len && substr($chunk, $i + 1, 1) eq "*") {
            $i = $i + 2;
            while ($i + 1 < $len && (substr($chunk, $i, 1) ne "*" || substr($chunk, $i + 1, 1) ne "/")) {
                $i = $i + 1;
            }
            if ($i + 1 < $len) { $i = $i + 2; } else { $i = $len; }
            next;
        }
        if ($c eq "(" || $c eq "[" || $c eq "{") {
            $depth = $depth + 1;
        } elsif ($c eq ")" || $c eq "]" || $c eq "}") {
            if ($depth > 0) { $depth = $depth - 1; }
        } elsif ($c eq "=" && $depth == 0) {
            my str $prefix = substr($chunk, 0, $i);
            $prefix =~ s/\s+$//;
            return $prefix . ";";
        }
        $i = $i + 1;
    }
    return $chunk;
}

func eval_append_trailing_semi(str $code) str {
    my int $len = length($code);
    my int $i = 0;
    my str $last_sig = "";
    my str $prev_word = "";
    my int $in_line_cmt = 0;
    my int $saw_heredoc_eof = 0;
    my array @heredoc_tags = ();
    while ($i < $len) {
        my str $c = substr($code, $i, 1);
        if ($c eq "\n" && size(@heredoc_tags) > 0) {
            $in_line_cmt = 0;
            $i = eval_skip_heredoc_bodies($code, $i + 1, $len, @heredoc_tags);
            @heredoc_tags = ();
            if ($i >= $len) { $saw_heredoc_eof = 1; }
            $prev_word = "";
            next;
        }
        if (eval_is_ws_char($c) == 1) {
            if ($c eq "\n") { $in_line_cmt = 0; }
            $i = $i + 1;
            next;
        }
        if ($c eq "#") {
            $in_line_cmt = 1;
            while ($i < $len && substr($code, $i, 1) ne "\n") {
                $i = $i + 1;
            }
            if ($i < $len && size(@heredoc_tags) == 0) { $in_line_cmt = 0; }
            next;
        }
        if ($c eq "/" && $i + 1 < $len && substr($code, $i + 1, 1) eq "*") {
            $in_line_cmt = 0;
            $i = $i + 2;
            while ($i + 1 < $len && (substr($code, $i, 1) ne "*" || substr($code, $i + 1, 1) ne "/")) {
                $i = $i + 1;
            }
            if ($i + 1 < $len) { $i = $i + 2; } else { $i = $len; }
            next;
        }
        $in_line_cmt = 0;
        $saw_heredoc_eof = 0;
        if ($c eq "\"" || $c eq "'") {
            my str $q = $c;
            $last_sig = $q;
            $prev_word = "";
            $i = $i + 1;
            while ($i < $len) {
                my str $sc = substr($code, $i, 1);
                if ($sc eq "\\" && $i + 1 < $len) {
                    $i = $i + 2;
                    next;
                }
                if ($sc eq $q) {
                    $i = $i + 1;
                    last;
                }
                $i = $i + 1;
            }
            next;
        }
        if ($c eq "<") {
            my scalar $hd = eval_try_parse_heredoc($code, $i, $len, $last_sig, $prev_word);
            if (defined($hd)) {
                push(@heredoc_tags, $hd->{"tag"});
                $last_sig = "\"";
                $prev_word = "";
                $i = $hd->{"end"};
                next;
            }
        }
        my int $rx_end = eval_try_skip_regex($code, $i, 0, $len, $last_sig, $prev_word);
        if ($rx_end >= 0) {
            $last_sig = "/";
            $prev_word = "";
            $i = $rx_end;
            next;
        }
        if (eval_is_ident_char($c) == 1) {
            my str $w = eval_read_word($code, $i, $len);
            $prev_word = $w;
            $last_sig = "w";
            $i = $i + length($w);
            next;
        }
        $last_sig = $c;
        $prev_word = "";
        $i = $i + 1;
    }
    if (length($last_sig) == 0 || $last_sig eq ";") {
        return $code;
    }
    if ($in_line_cmt == 1 || $saw_heredoc_eof == 1) {
        return $code . "\n;";
    }
    return $code . ";";
}

func split_eval_units_ex(str $code, str $start_pkg, int $skip_main) scalar {
    my str $top = "";
    my str $top_persist = "";
    my str $body = "";
    my str $cur_pkg = $start_pkg;
    my str $body_pkg = $start_pkg;
    my int $has_body = 0;
    my array @body_segs = ();
    my str $last_seg_pkg = "";
    my array @top_parts = ();

    my int $len = length($code);
    my int $pos = eval_skip_ws_cmt($code, 0, $len);

    while ($pos < $len) {
        if (substr($code, $pos, 1) eq ";") {
            $pos = eval_skip_ws_cmt($code, $pos + 1, $len);
            next;
        }

        my str $kw = eval_read_word($code, $pos, $len);
        my int $is_brace_top = 0;
        my int $is_semi_top = 0;
        my int $is_oneshot = 0;
        my str $func_name = "";

        if ($kw eq "enum" || $kw eq "struct" || $kw eq "before" || $kw eq "after" || $kw eq "around") {
            $is_brace_top = 1;
        } elsif ($kw eq "BEGIN" || $kw eq "END") {
            $is_brace_top = 1;
            $is_oneshot = 1;
        } elsif ($kw eq "package" || $kw eq "version" || $kw eq "inherit" || $kw eq "extends" ||
                 $kw eq "with" || $kw eq "use" || $kw eq "import_lib" || $kw eq "import_object" ||
                 $kw eq "import_archive" || $kw eq "link_lib" || $kw eq "has" || $kw eq "const" || $kw eq "our") {
            $is_semi_top = 1;
        } elsif ($kw eq "func" || $kw eq "fn" || $kw eq "private" || $kw eq "async" || $kw eq "extern") {
            my int $scan_kw = $pos;
            my str $w_cur = $kw;
            my int $is_ext = 0;
            while ($w_cur eq "private" || $w_cur eq "async" || $w_cur eq "extern") {
                if ($w_cur eq "extern") { $is_ext = 1; }
                $scan_kw = eval_skip_ws_cmt($code, $scan_kw + length($w_cur), $len);
                $w_cur = eval_read_word($code, $scan_kw, $len);
            }
            if ($w_cur eq "func" || $w_cur eq "fn") {
                my int $after_fn = eval_skip_ws_cmt($code, $scan_kw + length($w_cur), $len);
                if ($after_fn < $len && eval_is_ident_char(substr($code, $after_fn, 1)) == 1) {
                    $func_name = eval_read_word($code, $after_fn, $len);
                    if ($is_ext == 1) { $is_semi_top = 1; }
                    else { $is_brace_top = 1; }
                }
            } elsif ($is_ext == 1) {
                $is_semi_top = 1;
            }
        }

        if ($is_brace_top == 1) {
            my int $end = eval_scan_unit($code, $pos, $len, 1);
            if (!($skip_main == 1 && $cur_pkg eq "main" && $func_name eq "main")) {
                my str $chunk = substr($code, $pos, $end - $pos);
                $top = $top . $chunk . "\n";
                push(@top_parts, [$chunk, $pos]);
                if ($is_oneshot == 0) {
                    $top_persist = $top_persist . $chunk . "\n";
                }
            }
            $pos = eval_skip_ws_cmt($code, $end, $len);
            next;
        }

        if ($is_semi_top == 1) {
            my int $end = eval_scan_unit($code, $pos, $len, 0);
            my str $chunk = substr($code, $pos, $end - $pos);
            $chunk =~ s/\s+$//;
            $chunk = eval_append_trailing_semi($chunk);
            $top = $top . $chunk . "\n";
            push(@top_parts, [$chunk, $pos]);
            if ($kw eq "our") {
                $top_persist = $top_persist . eval_strip_our_init($chunk) . "\n";
            } else {
                $top_persist = $top_persist . $chunk . "\n";
            }
            if ($kw eq "package") {
                my int $ps = eval_skip_ws_cmt($code, $pos + 7, $end);
                my int $pe = $ps;
                while ($pe < $end) {
                    my str $pc = substr($code, $pe, 1);
                    if (eval_is_ident_char($pc) == 1 || $pc eq ":") { $pe = $pe + 1; }
                    else { last; }
                }
                if ($pe > $ps) {
                    $cur_pkg = substr($code, $ps, $pe - $ps);
                }
            }
            $pos = eval_skip_ws_cmt($code, $end, $len);
            next;
        }

        # Body unit: handle labeled loops & control-flow blocks cleanly
        my str $ctrl_kw = $kw;
        if (length($kw) > 0) {
            my int $after_kw = eval_skip_ws_cmt($code, $pos + length($kw), $len);
            if ($after_kw < $len && substr($code, $after_kw, 1) eq ":" &&
                ($after_kw + 1 >= $len || substr($code, $after_kw + 1, 1) ne ":")) {
                my int $after_lbl = eval_skip_ws_cmt($code, $after_kw + 1, $len);
                $ctrl_kw = eval_read_word($code, $after_lbl, $len);
            }
        }

        my int $is_block_stmt = 0;
        if (substr($code, $pos, 1) eq "{" ||
            $ctrl_kw eq "if" || $ctrl_kw eq "unless" || $ctrl_kw eq "while" ||
            $ctrl_kw eq "until" || $ctrl_kw eq "for" || $ctrl_kw eq "foreach" ||
            $ctrl_kw eq "switch" || $ctrl_kw eq "try" || $ctrl_kw eq "do") {
            $is_block_stmt = 1;
        }

        my int $end = 0;
        my str $chunk = "";
        if ($is_block_stmt == 1) {
            $end = eval_scan_unit($code, $pos, $len, 1);
            if ($ctrl_kw eq "if" || $ctrl_kw eq "unless" || $ctrl_kw eq "try") {
                my int $more = 1;
                while ($more == 1) {
                    my int $p2 = eval_skip_ws_cmt($code, $end, $len);
                    my str $ckw = eval_read_word($code, $p2, $len);
                    if ($ckw eq "elsif" || $ckw eq "else" || $ckw eq "catch" || $ckw eq "finally") {
                        $end = eval_scan_unit($code, $p2, $len, 1);
                    } else {
                        $more = 0;
                    }
                }
            } elsif ($ctrl_kw eq "do") {
                my int $p2 = eval_skip_ws_cmt($code, $end, $len);
                if (eval_read_word($code, $p2, $len) eq "while") {
                    $end = eval_scan_unit($code, $p2, $len, 0);
                } elsif ($p2 < $len && substr($code, $p2, 1) eq ";") {
                    $end = $p2 + 1;
                }
            }
            $chunk = substr($code, $pos, $end - $pos);
        } else {
            $end = eval_scan_unit($code, $pos, $len, 0);
            $chunk = substr($code, $pos, $end - $pos);
            $chunk =~ s/\s+$//;
            $chunk = eval_append_trailing_semi($chunk);
        }

        if (length($chunk) > 0) {
            if ($has_body == 0) {
                $body_pkg = $cur_pkg;
                $has_body = 1;
            }
            $body = $body . $chunk . "\n";
            if (size(@body_segs) == 0 || $last_seg_pkg ne $cur_pkg) {
                my hash %seg = ();
                $seg{"pkg"} = $cur_pkg;
                $seg{"body"} = $chunk . "\n";
                my array @sparts = ();
                push(@sparts, [$chunk, $pos]);
                $seg{"parts"} = \@sparts;
                push(@body_segs, \%seg);
                $last_seg_pkg = $cur_pkg;
            } else {
                my scalar $lseg = $body_segs[size(@body_segs) - 1];
                $lseg->{"body"} = $lseg->{"body"} . $chunk . "\n";
                push(@{$lseg->{"parts"}}, [$chunk, $pos]);
            }
        }
        $pos = eval_skip_ws_cmt($code, $end, $len);
    }

    if ($has_body == 0) { $body_pkg = $cur_pkg; }

    my hash %res = ();
    $res{"top"} = $top;
    $res{"top_persist"} = $top_persist;
    $res{"body"} = $body;
    $res{"last_pkg"} = $cur_pkg;
    $res{"body_pkg"} = $body_pkg;
    $res{"segments"} = \@body_segs;
    $res{"top_parts"} = \@top_parts;
    return \%res;
}

func split_eval_units(str $code, str $start_pkg) scalar {
    return split_eval_units_ex($code, $start_pkg, 0);
}

func extract_last_package(str $code, str $cur_pkg) str {
    my scalar $u = split_eval_units($code, $cur_pkg);
    return $u->{"last_pkg"};
}

# Initialize the eval engine (no-op; state initializes lazily).
func init() void {
}

# Reset the eval engine state
func reset() void {
    __C__ { eval_vm_lock(); }
    try {
        %g_eval_vm_globals = ();
        %g_eval_vm_our_names = ();
        %g_eval_vm_funcs = ();
        $g_eval_vm_pkg = "main";
        $g_eval_vm_decls = "";
        $g_eval_vm_decls_globals = 0;
        %g_eval_vm_imports_done = ();
        __C__ {
            /* closures from before reset() keep their own VM state */
            g_eval_epoch++;
            g_eval_store_gen++;
            if (g_eval_host_vm) { vm_free(g_eval_host_vm); g_eval_host_vm = NULL; }
            if (g_eval_host_prog) { vm_program_free(g_eval_host_prog); g_eval_host_prog = NULL; }
        }
        core::gc_collect();
    } finally {
        __C__ { eval_vm_unlock(); }
    }
}

# Set search paths used by subsequent VM eval/REPL compiles.
func set_eval_lib_paths(scalar $paths) void {
    __C__ { eval_vm_lock(); }
    try {
        @g_eval_vm_lib_paths = ();
        if (!defined($paths)) { return; }
        my int $i = 0;
        my int $n = size($paths);
        while ($i < $n) {
            push(@g_eval_vm_lib_paths, $paths->[$i]);
            $i = $i + 1;
        }
    } finally {
        __C__ { eval_vm_unlock(); }
    }
}

func vm_eval_globals() scalar {
    return \%g_eval_vm_globals;
}

func vm_eval_funcs() scalar {
    return \%g_eval_vm_funcs;
}

func vm_eval_pkg() str {
    return $g_eval_vm_pkg;
}

# Legacy eval backend accessors (always "vm").
func set_eval_backend(str $backend) void {
    if ($backend eq "vm" || $backend eq "tree-walk") {
        $g_eval_backend = "vm";
    } else {
        say("Warning: unknown eval backend '" . $backend . "', using 'vm'");
        $g_eval_backend = "vm";
    }
}

func get_eval_backend() str {
    return $g_eval_backend;
}

func eval_vm_make_return_undef() scalar {
    my hash %undef_node = ();
    $undef_node{"type"} = NI::UNDEF;
    my hash %ret_u = ();
    $ret_u{"type"} = NI::RETURN_STMT;
    $ret_u{"value"} = \%undef_node;
    return \%ret_u;
}

# The value of an eval is a scalar: a trailing `@a` / `%h` (or `my @a = ...`)
# yields its count, as Perl's eval in scalar context does. (A container value
# otherwise reaches the host as a reference.)
func eval_vm_scalar_ctx(scalar $e) scalar {
    if (!defined($e) || ref($e) ne "HASH") { return $e; }
    if ($e->{"type"} == NI::VARIABLE) {
        my str $sg = defined($e->{"sigil"}) ? ("" . $e->{"sigil"}) : "";
        if ($sg eq "@" || $sg eq "%") {
            my scalar $call = ast_new_call("scalar");
            ast_add_arg($call, $e);
            if (defined($e->{"line"})) { $call->{"line"} = $e->{"line"}; }
            return $call;
        }
    }
    return $e;
}

func eval_vm_rewrite_tail_return(scalar $block) void {
    if (!defined($block)) { return; }
    my scalar $stmts = $block->{"statements"};
    if (!defined($stmts)) { return; }
    my int $scnt = size($stmts);
    if ($scnt <= 0) {
        push($stmts, eval_vm_make_return_undef());
        $block->{"statement_count"} = 1;
        return;
    }
    my scalar $last_stmt = $stmts->[$scnt - 1];
    if (!defined($last_stmt)) {
        push($stmts, eval_vm_make_return_undef());
        $block->{"statement_count"} = $scnt + 1;
        return;
    }
    my int $ltype = $last_stmt->{"type"};
    if ($ltype == NI::EXPR_STMT) {
        my hash %ret_node = ();
        $ret_node{"type"} = NI::RETURN_STMT;
        $ret_node{"value"} = eval_vm_scalar_ctx($last_stmt->{"expr"});
        $stmts->[$scnt - 1] = \%ret_node;
        return;
    }
    if ($ltype == NI::RETURN_STMT) {
        return;
    }
    if ($ltype == NI::VAR_DECL || $ltype == NI::OUR_DECL) {
        my str $vn = $last_stmt->{"name"};
        my str $vsig = $last_stmt->{"sigil"};
        if ($ltype == NI::OUR_DECL && defined($last_stmt->{"package"})) {
            my str $pkg = $last_stmt->{"package"};
            if (length($pkg) > 0 && $pkg ne "main" && index($vn, "::") < 0) {
                $vn = $pkg . "::" . $vn;
            }
        }
        my hash %var_node = ();
        $var_node{"type"} = NI::VARIABLE;
        $var_node{"name"} = $vn;
        $var_node{"sigil"} = $vsig;
        my hash %ret_v = ();
        $ret_v{"type"} = NI::RETURN_STMT;
        $ret_v{"value"} = eval_vm_scalar_ctx(\%var_node);
        push($stmts, \%ret_v);
        $block->{"statement_count"} = $scnt + 1;
        return;
    }
    if ($ltype == NI::BLOCK) {
        eval_vm_rewrite_tail_return($last_stmt);
        push($stmts, eval_vm_make_return_undef());
        $block->{"statement_count"} = $scnt + 1;
        return;
    }
    if ($ltype == NI::IF_STMT) {
        eval_vm_rewrite_tail_return($last_stmt->{"then_block"});
        my scalar $eblocks = $last_stmt->{"elsif_blocks"};
        my int $ecnt = $last_stmt->{"elsif_count"};
        my int $ei = 0;
        while ($ei < $ecnt) {
            eval_vm_rewrite_tail_return($eblocks->[$ei]);
            $ei = $ei + 1;
        }
        my scalar $else_blk = $last_stmt->{"else_block"};
        if ($else_blk) {
            eval_vm_rewrite_tail_return($else_blk);
        }
        push($stmts, eval_vm_make_return_undef());
        $block->{"statement_count"} = $scnt + 1;
        return;
    }
    if ($ltype == NI::TRY_CATCH) {
        eval_vm_rewrite_tail_return($last_stmt->{"try_block"});
        my scalar $cclauses = $last_stmt->{"catch_clauses"};
        my int $ccnt = $last_stmt->{"catch_count"};
        my int $ci = 0;
        while ($ci < $ccnt) {
            my scalar $cc = $cclauses->[$ci];
            if (defined($cc)) {
                eval_vm_rewrite_tail_return($cc->{"catch_block"});
            }
            $ci = $ci + 1;
        }
        push($stmts, eval_vm_make_return_undef());
        $block->{"statement_count"} = $scnt + 1;
        return;
    }
    if ($ltype == NI::SWITCH) {
        my scalar $sblocks = $last_stmt->{"blocks"};
        my int $scase = $last_stmt->{"case_count"};
        my int $sci = 0;
        while ($sci < $scase) {
            eval_vm_rewrite_tail_return($sblocks->[$sci]);
            $sci = $sci + 1;
        }
        if ($last_stmt->{"has_default"} == 1) {
            eval_vm_rewrite_tail_return($last_stmt->{"default_block"});
        }
        push($stmts, eval_vm_make_return_undef());
        $block->{"statement_count"} = $scnt + 1;
        return;
    }
    push($stmts, eval_vm_make_return_undef());
    $block->{"statement_count"} = $scnt + 1;
}

# The VM's global key of a session variable: arrays / hashes are "@x" /
# "Pkg::@x" (vm_compiler.c resolve_global_var_key_sig), so `my @x` and a
# later `my $x` are two variables.
private func eval_vm_gkey(str $qname, str $sigil) str {
    if ($sigil ne "@" && $sigil ne "%") { return $qname; }
    my int $li = rindex($qname, "::");
    if ($li < 0) { return $sigil . $qname; }
    return substr($qname, 0, $li + 2) . $sigil . substr($qname, $li + 2, length($qname) - $li - 2);
}

private func eval_vm_record_our(str $vn, str $vsig, int $vt, str $seg_pkg, scalar $program, scalar $prom_state, int $has_init) void {
    if (length($vn) == 0) { return; }
    my scalar $nd_ref = $prom_state->{"newly_declared"};
    my scalar $sk_ref = $prom_state->{"skip_seed"};
    my scalar $ao_ref = $prom_state->{"added_our"};
    my str $qvn = ($seg_pkg ne "" && $seg_pkg ne "main" && index($vn, "::") < 0) ? ($seg_pkg . "::" . $vn) : $vn;
    $qvn = eval_vm_gkey($qvn, $vsig);
    $nd_ref->{$qvn} = 1;
    # Only a declaration without initializer starts from undef. With one, the
    # old value stays visible to the initializer (`my $n = $n * 2`: the new
    # `my` is not in scope in its own initializer -- Perl; V5-15).
    if ($has_init == 0) { $sk_ref->{$qvn} = 1; }
    if (!exists(%g_eval_vm_our_names, $qvn) && !defined($ao_ref->{$qvn})) {
        $ao_ref->{$qvn} = 1;
        $prom_state->{"added_our_stubs"} = $prom_state->{"added_our_stubs"} . "package " . $seg_pkg . ";\nour " . $vsig . $vn . ";\n";
        $prom_state->{"added_our_cnt"} = $prom_state->{"added_our_cnt"} + 1;
        my scalar $od = ast_new_our_decl($vn, $vt, $vsig);
        $od->{"package"} = $seg_pkg;
        ast_add_global($program, $od);
    }
}

private func eval_vm_promote_body(scalar $body, str $seg_pkg, scalar $program, scalar $prom_state, int $rewrite_tail) void {
    if (!defined($body)) { return; }
    my scalar $stmts = $body->{"statements"};
    my int $scnt = $body->{"statement_count"};
    my int $si = 0;
    while ($si < $scnt) {
        my scalar $st = $stmts->[$si];
        if (defined($st) && $st->{"type"} == NI::VAR_DECL) {
            my str $vn = $st->{"name"};
            my str $vsig = $st->{"sigil"};
            my int $vt = $st->{"var_type"};
            $st->{"type"} = NI::OUR_DECL;
            $st->{"package"} = $seg_pkg;
            my int $vinit = (defined($st->{"init"}) && (length(ref($st->{"init"})) > 0 || $st->{"init"} != 0)) ? 1 : 0;
            eval_vm_record_our($vn, $vsig, $vt, $seg_pkg, $program, $prom_state, $vinit);
        } elsif (defined($st) && $st->{"type"} == NI::DESTRUCTURE && $st->{"is_decl"} == 1) {
            $st->{"is_decl"} = 0;
            my scalar $dvars = $st->{"vars"};
            my int $dvc = $st->{"var_count"};
            my int $dvi = 0;
            while ($dvi < $dvc) {
                my scalar $dv = $dvars->[$dvi];
                my str $vn = $dv->{"name"};
                my str $vsig = defined($dv->{"sigil"}) ? $dv->{"sigil"} : "\$";
                my int $vt = defined($dv->{"var_type"}) ? $dv->{"var_type"} : 0;
                eval_vm_record_our($vn, $vsig, $vt, $seg_pkg, $program, $prom_state, 1);
                $dvi = $dvi + 1;
            }
        }
        $si = $si + 1;
    }
    if ($rewrite_tail == 1) {
        eval_vm_rewrite_tail_return($body);
    }
}

# "VM compile error (line N): MSG" lines -> "FILE:N: MSG" (one per line);
# the "N error(s) during compilation" summary is dropped.
private func eval_vm_compile_error_text(str $msgs, str $fname) str {
    my array @out = ();
    foreach my str $ln (split("\n", $msgs)) {
        if ($ln =~ /^\s*$/) { next; }
        if ($ln =~ /^\d+ errors? during compilation/) { next; }
        if ($ln =~ /^VM compile error \(line (\d+)\): (.*)$/) {
            push(@out, $fname . ":" . $1 . ": " . $2);
        } elsif ($ln =~ /^VM compile error: (.*)$/) {
            push(@out, $fname . ": " . $1);
        } else {
            push(@out, $ln);
        }
    }
    if (size(@out) == 0) { return "VM compilation failed"; }
    return join("\n", @out);
}

# Source builder for eval_string_vm_ex: append wrapper TEXT
private func eval_sb_add(scalar $sb, str $text) void {
    if (length($text) == 0) { return; }
    my int $nl = 0;
    my int $p = index($text, "\n");
    while ($p >= 0) { $nl = $nl + 1; $p = index($text, "\n", $p + 1); }
    $sb->{"src"} = $sb->{"src"} . $text;
    $sb->{"line"} = $sb->{"line"} + $nl;
}

# Append user chunks ([text, offset-in-trimmed-code] pairs), each on a fresh
# line, recording which source lines hold which user line / column.
private func eval_sb_add_parts(scalar $sb, scalar $parts) void {
    if (!defined($parts)) { return; }
    my str $code = $sb->{"code"};
    my int $n = size($parts);
    my int $i = 0;
    while ($i < $n) {
        my scalar $pt = $parts->[$i];
        my str $text = $pt->[0];
        my int $pos = $pt->[1];
        my int $cline = 1;
        my int $q = index($code, "\n");
        while ($q >= 0 && $q < $pos) { $cline = $cline + 1; $q = index($code, "\n", $q + 1); }
        my int $lnl = ($pos > 0) ? rindex($code, "\n", $pos - 1) : -1;
        my int $ucol = $pos - $lnl;
        my str $cur = $sb->{"src"};
        if (length($cur) > 0 && substr($cur, length($cur) - 1, 1) ne "\n") {
            eval_sb_add($sb, "\n");
        }
        my int $start = $sb->{"line"};
        my int $tnl = 0;
        my int $tp = index($text, "\n");
        while ($tp >= 0) { $tnl = $tnl + 1; $tp = index($text, "\n", $tp + 1); }
        push(@{$sb->{"map"}}, [$start, $tnl + 1, $cline + $sb->{"lead"}, $ucol]);
        eval_sb_add($sb, $text . "\n");
        $i = $i + 1;
    }
}

# Rewrite token lines (and first-line columns) from wrapped-source positions
# to the user's code; wrapper tokens take the nearest preceding user line.
private func eval_sb_renumber_tokens(scalar $sb, scalar $tokens) void {
    my scalar $map = $sb->{"map"};
    my int $mn = size($map);
    if ($mn == 0) { return; }
    my int $mi = 0;
    my int $last_user = 1;
    my int $tn = size($tokens);
    my int $ti = 0;
    while ($ti < $tn) {
        my scalar $tok = $tokens->[$ti];
        my int $ln = defined($tok->{"line"}) ? $tok->{"line"} : 0;
        while ($mi < $mn && $map->[$mi]->[0] + $map->[$mi]->[1] <= $ln) {
            $last_user = $map->[$mi]->[2] + $map->[$mi]->[1] - 1;
            $mi = $mi + 1;
        }
        if ($mi < $mn && $ln >= $map->[$mi]->[0]) {
            my scalar $me = $map->[$mi];
            $tok->{"line"} = $me->[2] + ($ln - $me->[0]);
            if ($ln == $me->[0] && defined($tok->{"column"})) {
                $tok->{"column"} = $tok->{"column"} + $me->[3] - 1;
            }
        } else {
            $tok->{"line"} = $last_user;
        }
        $ti = $ti + 1;
    }
}

# Evaluate code using the bytecode VM backend with optional filename, search
# paths, and load-only mode (skips top-level main() and top-level body).
func eval_string_vm_ex(str $code, str $filename, scalar $extra_libs, int $is_load) scalar {
    my str $trimmed = $code;
    $trimmed =~ s/^\s+//;
    $trimmed =~ s/\s+$//;

    if (length($trimmed) == 0) {
        return undef;
    }

    my scalar $vm_result = undef;
    my scalar $globals_ref = undef;
    my int $had_vm_exc = 0;
    my scalar $vm_exc = undef;
    my int $locked = 0;
    __C__ {
        eval_vm_lock();
        strada_decref(locked);
        locked = STRADA_MAKE_TAGGED_INT(1);
    }
    try {
        $globals_ref = \%g_eval_vm_globals;
        __C__ {
            EvalActiveStack *es_pre = eval_active_stack_get();
            if (es_pre->depth > 0 && es_pre->vms[es_pre->depth - 1]) {
                vm_export_globals(es_pre->vms[es_pre->depth - 1], globals_ref);
                g_eval_store_gen++;
                es_pre->vms[es_pre->depth - 1]->eval_sync_gen = g_eval_store_gen;
            }
        }
        my str $prev_vm_pkg = $g_eval_vm_pkg;
        my scalar $units = split_eval_units_ex($trimmed, $prev_vm_pkg, $is_load);
        my str $next_vm_pkg = $units->{"last_pkg"};
        my str $body_pkg = $units->{"body_pkg"};
        my str $body_src = ($is_load == 1) ? "" : $units->{"body"};
        my scalar $segs = $units->{"segments"};
        my int $seg_cnt = ($is_load == 1 || !defined($segs)) ? 0 : size($segs);

        # The wrapped source is built piece by piece; every chunk of the
        # user's code is recorded with its line/column in that code, and the
        # tokens are renumbered after lexing, so parse and compile errors (and
        # __LINE__) report the user's lines, not the wrapper's (V5-8).
        my int $lead_nl = 0;
        if ($code =~ /^(\s+)/) {
            my str $lead_ws = $1;
            my int $lwp = index($lead_ws, "\n");
            while ($lwp >= 0) { $lead_nl = $lead_nl + 1; $lwp = index($lead_ws, "\n", $lwp + 1); }
        }
        my hash %sb = ();
        $sb{"src"} = "";
        $sb{"line"} = 1;
        my array @sb_map = ();
        $sb{"map"} = \@sb_map;
        $sb{"code"} = $trimmed;
        $sb{"lead"} = $lead_nl;
        eval_sb_add(\%sb, $g_eval_vm_decls);
        if (length($g_eval_vm_decls) > 0) {
            eval_sb_add(\%sb, "package __strada_eval_sep__;\nfunc __strada_eval_top_start__() void {}\n");
        }
        eval_sb_add(\%sb, "package " . $prev_vm_pkg . ";\n");
        eval_sb_add_parts(\%sb, $units->{"top_parts"});
        if ($seg_cnt > 1) {
            my str $dispatch_calls = "";
            my int $sgi = 0;
            while ($sgi < $seg_cnt) {
                my scalar $sg = $segs->[$sgi];
                my str $spkg = $sg->{"pkg"};
                my str $sfn = "__eval_seg_" . $sgi . "__";
                my str $sret = ($sgi == $seg_cnt - 1) ? "scalar" : "void";
                eval_sb_add(\%sb, "package " . $spkg . ";\nfunc " . $sfn . "() " . $sret . " {\n");
                eval_sb_add_parts(\%sb, $sg->{"parts"});
                eval_sb_add(\%sb, "\n}\n");
                my str $qcall = $spkg . "::" . $sfn . "()";
                if ($sgi == $seg_cnt - 1) {
                    $dispatch_calls = $dispatch_calls . "    return " . $qcall . ";\n";
                } else {
                    $dispatch_calls = $dispatch_calls . "    " . $qcall . ";\n";
                }
                $sgi = $sgi + 1;
            }
            eval_sb_add(\%sb, "package " . $next_vm_pkg . ";\nfunc __eval__() scalar {\n" . $dispatch_calls . "}\n");
        } elsif (length($body_src) > 0) {
            eval_sb_add(\%sb, "\npackage " . $body_pkg . ";\nfunc __eval__() scalar {\n");
            my int $bsi = 0;
            while ($bsi < $seg_cnt) {
                eval_sb_add_parts(\%sb, $segs->[$bsi]->{"parts"});
                $bsi = $bsi + 1;
            }
            eval_sb_add(\%sb, "\n}\n");
        } else {
            eval_sb_add(\%sb, "\npackage " . $next_vm_pkg . ";\nfunc __eval__() scalar { return undef; }\n");
        }
        my str $source = $sb{"src"};

        my array @lib_paths = ();
        if (defined($extra_libs)) {
            my int $eli = 0;
            my int $elcnt = size($extra_libs);
            while ($eli < $elcnt) {
                push(@lib_paths, $extra_libs->[$eli]);
                $eli = $eli + 1;
            }
        }
        my int $gli = 0;
        my int $glcnt = size(@g_eval_vm_lib_paths);
        while ($gli < $glcnt) {
            push(@lib_paths, $g_eval_vm_lib_paths[$gli]);
            $gli = $gli + 1;
        }

        # Parse
        my scalar $tokens = lex_tokenize($source);
        eval_sb_renumber_tokens(\%sb, $tokens);
        my scalar $parser = parser_new($tokens);
        parser_set_filename($parser, length($filename) > 0 ? $filename : "<eval-vm>");
        my array @empty = ();
        my scalar $program = parse_program($parser, \@lib_paths, \@empty, \@empty, \@empty);
        {
            my scalar $ic_list = $program->{"import_calls"};
            my int $ic_n = defined($program->{"import_call_count"}) ? $program->{"import_call_count"} : 0;
            my array @ic_keep = ();
            my int $ici = 0;
            while ($ici < $ic_n) {
                my scalar $ic = $ic_list->[$ici];
                my str $icf = "" . $ic->{"func_name"};
                if (!exists(%g_eval_vm_imports_done, $icf)) {
                    push(@ic_keep, $ic);
                    $g_eval_vm_imports_done{$icf} = 1;
                }
                $ici = $ici + 1;
            }
            $program->{"import_calls"} = \@ic_keep;
            $program->{"import_call_count"} = scalar(@ic_keep);
        }

        # Collect global declarations introduced by this call (after prior persistent decls)
        my hash %newly_declared = ();
        my hash %skip_seed = ();
        my scalar $pglobals = $program->{"globals"};
        my int $pglobal_cnt = defined($program->{"global_count"}) ? $program->{"global_count"} : 0;
        my int $top_new_globals = $pglobal_cnt - $g_eval_vm_decls_globals;
        if ($top_new_globals < 0) { $top_new_globals = 0; }
        my int $pgi = $g_eval_vm_decls_globals;
        while ($pgi < $pglobal_cnt) {
            my scalar $pg = $pglobals->[$pgi];
            if (defined($pg) && ($pg->{"type"} == NI::VAR_DECL || $pg->{"type"} == NI::OUR_DECL)) {
                my str $gn = $pg->{"name"};
                my str $gpkg = defined($pg->{"package"}) ? $pg->{"package"} : "";
                if (length($gpkg) > 0 && $gpkg ne "main" && index($gn, "::") < 0) {
                    $gn = $gpkg . "::" . $gn;
                }
                $gn = eval_vm_gkey($gn, defined($pg->{"sigil"}) ? ("" . $pg->{"sigil"}) : "$");
                if (length($gn) > 0) {
                    my int $has_init = (defined($pg->{"init"}) && (length(ref($pg->{"init"})) > 0 || $pg->{"init"} != 0)) ? 1 : 0;
                    if (!($pg->{"type"} == NI::OUR_DECL && exists(%g_eval_vm_our_names, $gn) && $has_init == 0)) {
                        $newly_declared{$gn} = 1;
                        if ($has_init == 0) { $skip_seed{$gn} = 1; }
                    }
                }
            }
            $pgi = $pgi + 1;
        }

        # Promote top-level my declarations in __eval__ (or __eval_seg_N__) to persistent our declarations,
        # and optionally rewrite trailing expression statement to NI::RETURN_STMT.
        my hash %added_our = ();
        my hash %new_funcs = ();
        my hash %prom_state = ();
        $prom_state{"newly_declared"} = \%newly_declared;
        $prom_state{"skip_seed"} = \%skip_seed;
        $prom_state{"added_our"} = \%added_our;
        $prom_state{"added_our_stubs"} = "";
        $prom_state{"added_our_cnt"} = 0;

        my scalar $pfuncs = $program->{"functions"};
        my int $pfcount = $program->{"function_count"};
        my str $eval_entry_name = "__eval__";
        my int $seen_top_start = (length($g_eval_vm_decls) == 0) ? 1 : 0;
        my int $has_new_main = 0;
        my int $pfi = 0;
        while ($pfi < $pfcount) {
            my scalar $pfn = $pfuncs->[$pfi];
            my str $fn_name = $pfn->{"name"};
            my str $bare = defined($pfn->{"bare_name"}) ? ("" . $pfn->{"bare_name"}) : "";
            if ($bare eq "") {
                # functions of package main carry no bare_name (V5-7: the last
                # segment of `package A; ...; package main; EXPR` was never
                # promoted / tail-rewritten, so the eval returned undef)
                my int $bcp = rindex($fn_name, "::");
                $bare = ($bcp >= 0) ? substr($fn_name, $bcp + 2, length($fn_name) - $bcp - 2) : $fn_name;
            }
            if ($fn_name eq "__eval__" || $bare eq "__eval__") {
                $eval_entry_name = $fn_name;
                if ($seg_cnt <= 1) {
                    eval_vm_promote_body($pfn->{"body"}, $body_pkg, $program, \%prom_state, 1);
                }
            } elsif ($seen_top_start == 1 && $seg_cnt > 1 && $bare =~ /^__eval_seg_[0-9]+__$/) {
                my int $sgi = cast_int(substr($bare, 11, length($bare) - 13));
                if ($sgi >= 0 && $sgi < $seg_cnt) {
                    eval_vm_promote_body($pfn->{"body"}, $segs->[$sgi]->{"pkg"}, $program, \%prom_state, ($sgi == $seg_cnt - 1) ? 1 : 0);
                }
            } elsif ($bare eq "__strada_eval_top_start__" || $fn_name eq "__strada_eval_sep____strada_eval_top_start__") {
                $seen_top_start = 1;
            } else {
                if ($seen_top_start == 1 && $fn_name eq "main") {
                    $has_new_main = 1;
                }
                $new_funcs{$fn_name} = defined($pfn->{"param_count"}) ? $pfn->{"param_count"} : 0;
            }
            $pfi = $pfi + 1;
        }
        my str $added_our_stubs = $prom_state{"added_our_stubs"};
        my int $added_our_cnt = $prom_state{"added_our_cnt"};
        if ($is_load == 0 && length($body_src) == 0 && $has_new_main == 1) {
            $eval_entry_name = "main";
        }

        # Compile to bytecode under lock, commit persistent declarations before execution so nested/threaded eval sees them
        my scalar $skip_ref = \%skip_seed;
        my array @class_list = ();
        {
            my hash %cl_seen = ();
            my int $cfi = 0;
            while ($cfi < $pfcount) {
                my scalar $cfn = $pfuncs->[$cfi];
                my str $cpk = defined($cfn->{"package"}) ? ("" . $cfn->{"package"}) : "";
                if ($cpk ne "" && $cpk ne "main" && index($cpk, "__strada_eval") != 0 && !exists($cl_seen{$cpk})) {
                    $cl_seen{$cpk} = 1;
                    push(@class_list, $cpk);
                }
                $cfi = $cfi + 1;
            }
        }
        my scalar $class_list_ref = \@class_list;
        my int $compiled_ok = 0;
        my int $vprog_handle = 0;
        my str $compile_msgs = "";
        __C__ {
            /* The VM compiler reports errors on stderr only; capture them so
             * the exception carries the real message (V5-8). */
            VMProgram *vprog = NULL;
            {
                FILE *cap = tmpfile();
                int saved_fd = -1;
                if (cap) {
                    fflush(stderr);
                    saved_fd = dup(2);
                    if (saved_fd < 0 || dup2(fileno(cap), 2) < 0) {
                        if (saved_fd >= 0) close(saved_fd);
                        saved_fd = -1;
                    }
                }
                vprog = vm_compile_program(program);
                if (saved_fd >= 0) {
                    fflush(stderr);
                    dup2(saved_fd, 2);
                    close(saved_fd);
                    long cn = ftell(cap);
                    if (cn > 0) {
                        if (cn > 65536) cn = 65536;
                        char *cbuf = malloc((size_t)cn + 1);
                        if (cbuf) {
                            rewind(cap);
                            size_t got = fread(cbuf, 1, (size_t)cn, cap);
                            cbuf[got] = 0;
                            strada_decref(compile_msgs);
                            compile_msgs = strada_new_str(cbuf);
                            free(cbuf);
                        }
                    }
                }
                if (cap) fclose(cap);
            }
            if (vprog) {
                /* Locate runtime header path for __C__ blocks compiled inside VM eval */
                {
                    const char *shome = getenv("STRADA_HOME");
                    char __rt[1200];
                    char __hdr[1400];
                    int __found_rt = 0;
                    if (shome && shome[0]) {
                        snprintf(__rt, sizeof(__rt), "%s/runtime", shome);
                        snprintf(__hdr, sizeof(__hdr), "%s/strada_runtime.h", __rt);
                        if (access(__hdr, R_OK) == 0) __found_rt = 1;
                    }
                    if (!__found_rt) {
                        char __exe[1024];
                        ssize_t __n = readlink("/proc/self/exe", __exe, sizeof(__exe) - 1);
                        if (__n > 0) {
                            __exe[__n] = 0;
                            char *__sl = strrchr(__exe, '/');
                            if (__sl) {
                                *__sl = 0;
                                snprintf(__rt, sizeof(__rt), "%s/../runtime", __exe);
                                snprintf(__hdr, sizeof(__hdr), "%s/strada_runtime.h", __rt);
                                if (access(__hdr, R_OK) != 0) {
                                    snprintf(__rt, sizeof(__rt), "%s/runtime", __exe);
                                    snprintf(__hdr, sizeof(__hdr), "%s/strada_runtime.h", __rt);
                                }
                                if (access(__hdr, R_OK) == 0) __found_rt = 1;
                            }
                        }
                    }
                    if (__found_rt) {
                        free(vprog->runtime_include_path);
                        vprog->runtime_include_path = strdup(__rt);
                    }
                }
                strada_decref(compiled_ok);
                compiled_ok = STRADA_MAKE_TAGGED_INT(1);
                strada_decref(vprog_handle);
                vprog_handle = strada_new_int((int64_t)(uintptr_t)vprog);
            }
        }
        if ($compiled_ok == 0) {
            throw(eval_vm_compile_error_text($compile_msgs, length($filename) > 0 ? $filename : "<eval-vm>"));
        }
        my str $rb_pkg = $g_eval_vm_pkg;
        my str $rb_decls = $g_eval_vm_decls;
        my int $rb_decls_globals = $g_eval_vm_decls_globals;
        my hash %rb_our_added = ();
        my hash %rb_funcs_added = ();
        my hash %rb_funcs_prev = ();

        $g_eval_vm_pkg = $next_vm_pkg;
        if (length($units->{"top_persist"}) > 0) {
            $g_eval_vm_decls = $g_eval_vm_decls . "package " . $prev_vm_pkg . ";\n" . $units->{"top_persist"} . "\n";
            $g_eval_vm_decls_globals = $g_eval_vm_decls_globals + $top_new_globals;
        }
        if ($added_our_cnt > 0) {
            $g_eval_vm_decls = $g_eval_vm_decls . $added_our_stubs;
            $g_eval_vm_decls_globals = $g_eval_vm_decls_globals + $added_our_cnt;
            foreach my str $ovn (keys(%added_our)) {
                if (!exists(%g_eval_vm_our_names, $ovn)) {
                    $rb_our_added{$ovn} = 1;
                }
                $g_eval_vm_our_names{$ovn} = 1;
            }
        }
        foreach my str $nvn (keys(%newly_declared)) {
            if (!exists(%g_eval_vm_our_names, $nvn)) {
                $rb_our_added{$nvn} = 1;
            }
            $g_eval_vm_our_names{$nvn} = 1;
        }
        foreach my str $fnk (keys(%new_funcs)) {
            if (exists(%g_eval_vm_funcs, $fnk)) {
                $rb_funcs_prev{$fnk} = $g_eval_vm_funcs{$fnk};
            } else {
                $rb_funcs_added{$fnk} = 1;
            }
            $g_eval_vm_funcs{$fnk} = $new_funcs{$fnk};
        }

        __C__ {
            VMProgram *exec_vprog = (VMProgram *)(uintptr_t)strada_to_int(vprog_handle);
            char *ebuf = strada_to_str(eval_entry_name);
            const char *req_entry = (ebuf && ebuf[0]) ? ebuf : "__eval__";
            const char *entry = NULL;
            if (vm_program_find_func(exec_vprog, req_entry) >= 0) entry = req_entry;
            else if (vm_program_find_func(exec_vprog, "main") >= 0) entry = "main";
            if (entry) {
                EvalActiveStack *es_run = eval_active_stack_get();
                if (g_eval_store_sv != globals_ref) {
                    /* refreshed on every eval (reset() clears the hash in
                     * place, but do not rely on that) */
                    StradaValue *old_store = g_eval_store_sv;
                    strada_incref(globals_ref);
                    g_eval_store_sv = globals_ref;
                    if (old_store) strada_decref(old_store);
                }
                vm_foreign_vm_call_hook = eval_foreign_vm_hook;
                eval_register_host_classes(exec_vprog, class_list_ref);
                VM *vvm = vm_new(exec_vprog);
                vvm->trap_uncaught = 1;
                vvm->eval_epoch = g_eval_epoch;
                vm_seed_globals(vvm, globals_ref, skip_ref);
                vvm->eval_sync_gen = g_eval_store_gen;
                int pushed = 0;
                if (es_run->depth < EVAL_ACTIVE_MAX) {
                    es_run->vms[es_run->depth++] = vvm;
                    pushed = 1;
                }
                if (strada_to_int(locked)) {
                    eval_vm_unlock();
                    strada_decref(locked);
                    locked = STRADA_MAKE_TAGGED_INT(0);
                }
                /* The result and the exported globals convert under one
                 * memo, so a returned container IS the one a global holds
                 * (no VM code may run inside: only when there are no END
                 * blocks). */
                volatile int conv_span = 0;
                int __cm = strada_cleanup_mark();
                int __lm = strada_local_depth_get();
                vvm->eval_running++;
                if (setjmp(*STRADA_TRY_PUSH()) == 0) {
                    vm_run_globals_init(vvm);
                    if (!vvm->has_exception) {
                        VMValue vres = vm_execute(vvm, entry);
                        if (!vvm->has_exception) {
                            if (exec_vprog->end_count == 0) { vm_conv_begin(); conv_span = 1; }
                            strada_decref(vm_result);
                            vm_result = vm_value_to_sv_scalar(vres);
                        }
                    }
                    if (vvm->has_exception) {
                        strada_decref(had_vm_exc);
                        had_vm_exc = STRADA_MAKE_TAGGED_INT(1);
                        strada_decref(vm_exc);
                        vm_exc = vm_value_to_sv_scalar(vvm->current_exception);
                        vvm->has_exception = 0;
                    }
                    vm_run_end_blocks(vvm);
                    if (vvm->has_exception && !strada_to_int(had_vm_exc)) {
                        strada_decref(had_vm_exc);
                        had_vm_exc = STRADA_MAKE_TAGGED_INT(1);
                        strada_decref(vm_exc);
                        vm_exc = vm_value_to_sv_scalar(vvm->current_exception);
                        vvm->has_exception = 0;
                    }
                    STRADA_TRY_POP();
                } else {
                    STRADA_TRY_POP();
                    if (conv_span) { vm_conv_end(); conv_span = 0; }
                    strada_local_restore_to(__lm);
                    strada_cleanup_drain_to(__cm);
                    StradaValue *__ce = strada_get_exception();
                    strada_clear_exception();
                    strada_decref(had_vm_exc);
                    had_vm_exc = STRADA_MAKE_TAGGED_INT(1);
                    strada_decref(vm_exc);
                    vm_exc = __ce ? __ce : strada_new_str("C exception");
                }
                vvm->eval_running--;
                eval_vm_lock();
                strada_decref(locked);
                locked = STRADA_MAKE_TAGGED_INT(1);
                if (pushed && es_run->depth > 0 && es_run->vms[es_run->depth - 1] == vvm) {
                    es_run->depth--;
                }
                if (!strada_to_int(had_vm_exc)) {
                    vm_export_globals(vvm, globals_ref);
                    g_eval_store_gen++;
                    vvm->eval_sync_gen = g_eval_store_gen;
                }
                if (conv_span) { vm_conv_end(); conv_span = 0; }
                if (!strada_to_int(had_vm_exc)) {
                    /* a nested eval: the enclosing eval's VM picks up what
                     * this one changed */
                    if (es_run->depth > 0 && es_run->vms[es_run->depth - 1]) {
                        VM *pvm = es_run->vms[es_run->depth - 1];
                        vm_seed_globals(pvm, globals_ref, NULL);
                        pvm->eval_sync_gen = g_eval_store_gen;
                    }
                    /* keep the latest VM: host calls of eval-defined methods
                     * run there */
                    VM *old_hv = g_eval_host_vm;
                    VMProgram *old_hp = g_eval_host_prog;
                    vm_retain(vvm);
                    vm_program_retain(exec_vprog);
                    g_eval_host_vm = vvm;
                    g_eval_host_prog = exec_vprog;
                    if (old_hv) vm_free(old_hv);
                    if (old_hp) vm_program_free(old_hp);
                }
                vm_suspend(vvm);
                vm_free(vvm);
            }
            free(ebuf);
            vm_program_free(exec_vprog);
        }
        if ($had_vm_exc == 1) {
            $g_eval_vm_pkg = $rb_pkg;
            $g_eval_vm_decls = $rb_decls;
            $g_eval_vm_decls_globals = $rb_decls_globals;
            foreach my str $ak (keys(%rb_our_added)) {
                delete($g_eval_vm_our_names{$ak});
            }
            foreach my str $fk (keys(%rb_funcs_added)) {
                delete($g_eval_vm_funcs{$fk});
            }
            foreach my str $fk (keys(%rb_funcs_prev)) {
                $g_eval_vm_funcs{$fk} = $rb_funcs_prev{$fk};
            }
        }
    } finally {
        __C__ {
            if (strada_to_int(locked)) {
                eval_vm_unlock();
            }
        }
    }
    if ($had_vm_exc == 1) {
        throw($vm_exc);
    }
    return $vm_result;
}

func eval_string_vm(str $code) scalar {
    return eval_string_vm_ex($code, "<eval-vm>", undef, 0);
}

func eval_string(str $code) scalar {
    return eval_string_vm($code);
}

func eval_auto(str $code) scalar {
    return eval_string_vm($code);
}
