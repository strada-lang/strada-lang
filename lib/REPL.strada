=head1 NAME

REPL - Compatibility wrapper delegating to L<Strada::JIT>

=head1 DESCRIPTION

Deprecated alias for L<Strada::JIT>. All functions forward directly to
C<Strada::JIT::*>. New code should C<use Strada::JIT;>.

=cut

package REPL;

use Strada::JIT;

func init(str ...@args) void {
    if (scalar(@args) > 0) {
        Strada::JIT::init($args[0]);
    } else {
        Strada::JIT::init();
    }
}

func eval(str $code) scalar {
    return Strada::JIT::eval($code);
}

func get(str $name) scalar {
    return Strada::JIT::get($name);
}

func set(str $name, scalar $value) void {
    Strada::JIT::set($name, $value);
}

func add_lib_path(str $path) void {
    Strada::JIT::add_lib_path($path);
}

func reset() void {
    Strada::JIT::reset();
}

func debug(int $enabled) void {
    Strada::JIT::debug($enabled);
}

func cdebug(int $enabled) void {
    Strada::JIT::cdebug($enabled);
}

func compiler() str {
    return Strada::JIT::compiler();
}

func var_types() hash {
    return Strada::JIT::var_types();
}

func functions() array {
    return Strada::JIT::functions();
}

func imports() array {
    return Strada::JIT::imports();
}

func lib_paths() array {
    return Strada::JIT::lib_paths();
}

func current_package() str {
    return Strada::JIT::current_package();
}

func set_package(str $name) void {
    Strada::JIT::set_package($name);
}

func state() hash {
    return Strada::JIT::state();
}

func check_function_def(str $input) int {
    return Strada::JIT::check_function_def($input);
}

func check_import(str $input) int {
    return Strada::JIT::check_import($input);
}

func check_package_decl(str $input) int {
    return Strada::JIT::check_package_decl($input);
}

func is_balanced(str $input) int {
    return Strada::JIT::is_balanced($input);
}
