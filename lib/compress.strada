=head1 NAME

compress - Gzip and deflate compression for Strada

=head1 SYNOPSIS

    use lib "lib";
    use compress;

    # Compress data
    my str $compressed = compress::gzip($data);

    # Decompress data
    my str $original = compress::gunzip($compressed);

    # Check if content should be compressed
    if (compress::should_compress("text/html", $body)) {
        $body = compress::gzip($body);
    }

=head1 DESCRIPTION

The compress module provides gzip and deflate compression/decompression
using zlib. This is useful for HTTP response compression and data storage.

B<Compile with:> C<./strada myapp.strada -lz>

=head1 FUNCTIONS

=head2 gzip($data)

Compress data using gzip format (with gzip header/trailer).
Returns compressed data or original data if compression fails.

    my str $compressed = compress::gzip($large_html);

=head2 gunzip($data)

Decompress gzip data. Returns decompressed data or original if decompression fails.

    my str $original = compress::gunzip($compressed);

=head2 deflate($data)

Compress data using raw deflate format (no header).
Used for HTTP deflate content encoding.

    my str $compressed = compress::deflate($data);

=head2 should_compress($content_type, $data)

Check if content should be compressed based on content type and size.
Returns 1 if compression is recommended, 0 otherwise.

Compresses text-based types (text/*, application/json, application/javascript).
Does not compress already-compressed formats (images, video, audio, zip).
Does not compress data smaller than 1KB.

    if (compress::should_compress($content_type, $body)) {
        $headers{"Content-Encoding"} = "gzip";
        $body = compress::gzip($body);
    }

=head1 EXAMPLE

    use lib "lib";
    use compress;

    # Compress an HTTP response
    my str $html = "<html>...large content...</html>";

    if (compress::should_compress("text/html", $html)) {
        my str $compressed = compress::gzip($html);
        say("Original: " . length($html) . " bytes");
        say("Compressed: " . length($compressed) . " bytes");

        # Later decompress
        my str $restored = compress::gunzip($compressed);
        say("Restored: " . length($restored) . " bytes");
    }

=head1 NOTES

=over 4

=item * Binary data is handled correctly (NUL bytes preserved)

=item * If compression fails, original data is returned unchanged

=item * Gzip format includes CRC32 checksum for data integrity

=back

=head1 SEE ALSO

L<LWP>, L<ssl>

=cut

package compress;
link_lib "z";

# C includes
__C__ {
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <limits.h>
#include <zlib.h>

#define COMPRESS_MAX_OUTPUT ((size_t)256U * 1024U * 1024U)

/* Get byte length from StradaValue - binary safe */
static size_t compress_get_byte_len(StradaValue *sv) {
    if (!sv) return 0;
    if (STRADA_IS_TAGGED_INT(sv)) {
        char *s = strada_to_str(sv);
        size_t n = s ? strlen(s) : 0;
        free(s);
        return n;
    }
    if (sv->type == STRADA_STR && !(sv->meta && sv->meta->is_tied)) {
        return STRADA_STR_BYTELEN(sv);
    }
    if (sv->type == STRADA_UNDEF) return 0;
    char *s = strada_to_str(sv);
    size_t n = s ? strlen(s) : 0;
    free(s);
    return n;
}

/* Get raw byte pointer from StradaValue - binary safe (does not copy) */
static const char* compress_get_bytes(StradaValue *sv) {
    if (!sv || STRADA_IS_TAGGED_INT(sv)) return "";
    if (sv->type == STRADA_STR && !(sv->meta && sv->meta->is_tied)) {
        return sv->value.pv ? sv->value.pv : "";
    }
    return "";
}

/* Extract raw bytes + length safely for any StradaValue */
static const char* compress_extract_bytes(StradaValue *sv, size_t *out_len, char **out_owned) {
    *out_owned = NULL;
    if (!sv) {
        *out_len = 0;
        return "";
    }
    if (!STRADA_IS_TAGGED_INT(sv)) {
        if (sv->type == STRADA_STR && !(sv->meta && sv->meta->is_tied)) {
            *out_len = STRADA_STR_BYTELEN(sv);
            return sv->value.pv ? sv->value.pv : "";
        }
        if (sv->type == STRADA_UNDEF) {
            *out_len = 0;
            return "";
        }
    }
    char *s = strada_to_str(sv);
    *out_owned = s;
    *out_len = s ? strlen(s) : 0;
    return s ? s : "";
}
static StradaValue* compress_deflate_common(StradaValue *data, int window_bits) {
    size_t input_len = 0;
    char *owned = NULL;
    const char *input = compress_extract_bytes(data, &input_len, &owned);

    size_t cap = (input_len < COMPRESS_MAX_OUTPUT) ? (compressBound((uLong)(input_len > UINT_MAX ? 65536 : input_len)) + 64) : 65536;
    if (cap < 1024) cap = 1024;
    char *output = malloc(cap);
    if (!output) {
        free(owned);
        return strada_new_str("");
    }

    z_stream strm;
    memset(&strm, 0, sizeof(strm));
    if (deflateInit2(&strm, Z_DEFAULT_COMPRESSION, Z_DEFLATED, window_bits, 8, Z_DEFAULT_STRATEGY) != Z_OK) {
        free(output);
        free(owned);
        return strada_new_str("");
    }

    size_t in_pos = 0;
    size_t out_pos = 0;
    int ok = 1;
    for (;;) {
        if (strm.avail_in == 0 && in_pos < input_len) {
            size_t rem = input_len - in_pos;
            uInt chunk = (rem > (size_t)UINT_MAX) ? UINT_MAX : (uInt)rem;
            strm.next_in = (Bytef*)(input + in_pos);
            strm.avail_in = chunk;
            in_pos += chunk;
        }
        if (out_pos == cap) {
            if (cap >= COMPRESS_MAX_OUTPUT) { ok = 0; break; }
            size_t new_cap = (cap > COMPRESS_MAX_OUTPUT / 2) ? COMPRESS_MAX_OUTPUT : cap * 2;
            char *tmp = realloc(output, new_cap);
            if (!tmp) { ok = 0; break; }
            output = tmp;
            cap = new_cap;
        }
        size_t avail = cap - out_pos;
        uInt out_chunk = (avail > (size_t)UINT_MAX) ? UINT_MAX : (uInt)avail;
        strm.next_out = (Bytef*)(output + out_pos);
        strm.avail_out = out_chunk;

        int flush = (in_pos >= input_len) ? Z_FINISH : Z_NO_FLUSH;
        int ret = deflate(&strm, flush);
        out_pos += (size_t)(out_chunk - strm.avail_out);
        if (ret == Z_STREAM_END) break;
        if (ret != Z_OK && ret != Z_BUF_ERROR) { ok = 0; break; }
    }

    deflateEnd(&strm);
    free(owned);
    if (!ok) {
        free(output);
        return strada_new_str("");
    }
    StradaValue *out_sv = strada_new_str_len(output, out_pos);
    free(output);
    return out_sv;
}

static StradaValue* compress_inflate_stream(const char *input, size_t input_len, int window_bits, int *truncated_out) {
    if (truncated_out) *truncated_out = 0;
    size_t cap = (input_len <= COMPRESS_MAX_OUTPUT / 4) ? (input_len * 4) : COMPRESS_MAX_OUTPUT;
    if (cap < 1024) cap = 1024;
    if (cap > COMPRESS_MAX_OUTPUT) cap = COMPRESS_MAX_OUTPUT;
    char *output = malloc(cap);
    if (!output) return NULL;

    z_stream strm;
    memset(&strm, 0, sizeof(strm));
    if (inflateInit2(&strm, window_bits) != Z_OK) {
        free(output);
        return NULL;
    }

    size_t in_pos = 0;
    size_t out_pos = 0;
    int ok = 1;
    for (;;) {
        if (strm.avail_in == 0 && in_pos < input_len) {
            size_t rem = input_len - in_pos;
            uInt chunk = (rem > (size_t)UINT_MAX) ? UINT_MAX : (uInt)rem;
            strm.next_in = (Bytef*)(input + in_pos);
            strm.avail_in = chunk;
            in_pos += chunk;
        }
        if (out_pos == cap) {
            if (cap >= COMPRESS_MAX_OUTPUT) { ok = 0; break; }
            size_t new_cap = (cap > COMPRESS_MAX_OUTPUT / 2) ? COMPRESS_MAX_OUTPUT : cap * 2;
            char *tmp = realloc(output, new_cap);
            if (!tmp) {
                if (truncated_out) *truncated_out = 1;
                ok = 0;
                break;
            }
            output = tmp;
            cap = new_cap;
        }
        size_t avail = cap - out_pos;
        uInt out_chunk = (avail > (size_t)UINT_MAX) ? UINT_MAX : (uInt)avail;
        strm.next_out = (Bytef*)(output + out_pos);
        strm.avail_out = out_chunk;

        int ret = inflate(&strm, Z_NO_FLUSH);
        out_pos += (size_t)(out_chunk - strm.avail_out);
        if (ret == Z_STREAM_END) {
            if (window_bits == (15 + 16) && (strm.avail_in > 0 || in_pos < input_len)) {
                if (inflateReset(&strm) != Z_OK) {
                    ok = 0;
                    break;
                }
                continue;
            }
            break;
        }
        if (ret == Z_BUF_ERROR && strm.avail_in == 0 && in_pos >= input_len && strm.avail_out > 0) {
            if (truncated_out) *truncated_out = 1;
            ok = 0;
            break;
        }
        if (ret != Z_OK && ret != Z_BUF_ERROR) {
            ok = 0;
            break;
        }
    }

    inflateEnd(&strm);
    if (!ok) {
        free(output);
        return NULL;
    }
    StradaValue *out_sv = strada_new_str_len(output, out_pos);
    free(output);
    return out_sv;
}
}

# Compress data using gzip format (returns "" on error)
func gzip(str $data) str {
    my str $result = "";
    __C__ {
        strada_decref(result);
        result = compress_deflate_common(data, 15 + 16);
    }
    return $result;
}

# Compress data using deflate format (no gzip header; returns "" on error)
func deflate(str $data) str {
    my str $result = "";
    __C__ {
        strada_decref(result);
        result = compress_deflate_common(data, -15);
    }
    return $result;
}

# Decompress gzip data (returns "" on invalid/truncated data)
func gunzip(str $data) str {
    my str $result = "";
    __C__ {
        size_t input_len = 0;
        char *owned = NULL;
        const char *input = compress_extract_bytes(data, &input_len, &owned);
        if (input_len > 0) {
            StradaValue *out = compress_inflate_stream(input, input_len, 15 + 16, NULL);
            if (out) {
                strada_decref(result);
                result = out;
            }
        }
        free(owned);
    }
    return $result;
}

# Decompress deflate data (raw deflate or zlib-wrapped; returns "" on error)
func inflate(str $data) str {
    my str $result = "";
    __C__ {
        size_t input_len = 0;
        char *owned = NULL;
        const char *input = compress_extract_bytes(data, &input_len, &owned);
        if (input_len > 0) {
            int wbits_list[2] = { -15, 15 };
            for (int wi = 0; wi < 2; wi++) {
                int truncated = 0;
                StradaValue *out = compress_inflate_stream(input, input_len, wbits_list[wi], &truncated);
                if (out) {
                    strada_decref(result);
                    result = out;
                    break;
                }
                if (truncated) break;
            }
        }
        free(owned);
    }
    return $result;
}

# Check if content should be compressed based on content-type
func should_compress(str $content_type, str $data) int {
    my int $result = 0;
    __C__ {
        size_t data_len = compress_get_byte_len(data);
        char *ct = strada_to_str(content_type);
        int should = 0;

        if (ct && data_len >= 1024) {
            if (strstr(ct, "text/") ||
                strstr(ct, "application/json") ||
                strstr(ct, "application/javascript") ||
                strstr(ct, "application/xml") ||
                strstr(ct, "application/xhtml") ||
                strstr(ct, "+xml") ||
                strstr(ct, "+json")) {
                /* Compress text-based content types */
                should = 1;
            }
        }
        free(ct);
        strada_decref(result);
        result = strada_new_int(should);
    }
    return $result;
}
