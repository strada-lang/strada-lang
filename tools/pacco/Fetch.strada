/*
 Strada Package Manager - Package fetching

 Downloads packages from various sources (git, registry, local).
*/

package Pacco::Fetch;

# Single-quote a string safely for /bin/sh
func shell_quote(str $s) str {
    my str $out = "'";
    my int $i = 0;
    my int $len = length($s);
    while ($i < $len) {
        my str $ch = substr($s, $i, 1);
        if ($ch eq "'") {
            $out = $out . "'\\''";
        } else {
            $out = $out . $ch;
        }
        $i = $i + 1;
    }
    return $out . "'";
}

# Validate a package/project/version token so it cannot traverse paths or inject flags
func is_safe_name(str $name) int {
    if (length($name) == 0) { return 0; }
    if ($name eq "." || $name eq "..") { return 0; }
    if (substr($name, 0, 1) eq "-" || substr($name, 0, 1) eq ".") { return 0; }
    if (index($name, "..") >= 0 || index($name, "/") >= 0 || index($name, "\\") >= 0) { return 0; }
    if ($name =~ /^[a-zA-Z0-9._-]+$/) { return 1; }
    return 0;
}

# Fetch a package from a git URL
func fetch_git(str $url, str $ref, str $dest) int {
    if (length($url) == 0 || substr($url, 0, 1) eq "-") {
        warn("Invalid git URL: " . $url);
        return 0;
    }
    if ($ref ne "" && substr($ref, 0, 1) eq "-") {
        warn("Invalid git ref: " . $ref);
        return 0;
    }

    # Remove destination if it exists
    if (core::dir_exists($dest) == 1) {
        my int $rm_result = core::system("rm -rf -- " . Pacco::Fetch::shell_quote($dest));
        if ($rm_result != 0) {
            warn("Failed to remove existing directory: " . $dest);
            return 0;
        }
    }

    # Clone with specific ref/tag
    my str $cmd = "";
    if ($ref ne "" && $ref ne "HEAD" && $ref ne "main" && $ref ne "master") {
        $cmd = "git clone --depth 1 --branch " . Pacco::Fetch::shell_quote($ref)
            . " -- " . Pacco::Fetch::shell_quote($url) . " " . Pacco::Fetch::shell_quote($dest) . " 2>&1";
    } else {
        $cmd = "git clone --depth 1 -- " . Pacco::Fetch::shell_quote($url)
            . " " . Pacco::Fetch::shell_quote($dest) . " 2>&1";
    }

    my int $result = core::system($cmd);
    if ($result != 0) {
        warn("Git clone failed: " . $cmd);
        return 0;
    }

    # Remove .git directory to save space
    core::system("rm -rf -- " . Pacco::Fetch::shell_quote($dest . "/.git"));

    return 1;
}

# Fetch a git repository handling explicit refs, version tags, or default branch
func fetch_git_smart(str $url, str $explicit_ref, str $ver_constraint, str $dest) int {
    if ($explicit_ref ne "") {
        return Pacco::Fetch::fetch_git($url, $explicit_ref, $dest);
    }

    if ($ver_constraint ne "" && $ver_constraint ne "*") {
        # If constraint looks like an exact version, try v<ver> and <ver> tags first
        if ($ver_constraint =~ /^v?[0-9]+\.[0-9]+/) {
            my str $v_tag = (substr($ver_constraint, 0, 1) eq "v") ? $ver_constraint : ("v" . $ver_constraint);
            if (Pacco::Fetch::fetch_git($url, $v_tag, $dest) == 1) {
                return 1;
            }
            if ($v_tag ne $ver_constraint && Pacco::Fetch::fetch_git($url, $ver_constraint, $dest) == 1) {
                return 1;
            }
        }
    }

    # Fall back to default branch (HEAD)
    return Pacco::Fetch::fetch_git($url, "", $dest);
}

# Copy a local package directory into destination (excluding .strada and .git)
func copy_dir(str $src_dir, str $dest_dir) int {
    if (core::dir_exists($src_dir) == 0) {
        return 0;
    }

    if (core::dir_exists($dest_dir) == 1) {
        my int $rm_rc = core::system("rm -rf -- " . Pacco::Fetch::shell_quote($dest_dir));
        if ($rm_rc != 0) {
            return 0;
        }
    }

    core::mkdir($dest_dir, 493);

    my str $cp_cmd = "cp -R -- " . Pacco::Fetch::shell_quote($src_dir . "/.") . " " . Pacco::Fetch::shell_quote($dest_dir . "/") . " 2>&1";
    my int $cp_rc = core::system($cp_cmd);
    if ($cp_rc != 0) {
        return 0;
    }

    core::system("rm -rf -- " . Pacco::Fetch::shell_quote($dest_dir . "/.strada") . " " . Pacco::Fetch::shell_quote($dest_dir . "/.git") . " 2>/dev/null");
    return 1;
}

# Parse a source string into components
# Formats:
#   github:user/repo           -> https://github.com/user/repo.git
#   github:user/repo@v1.0.0    -> https://github.com/user/repo.git, ref=v1.0.0
#   gitlab:user/repo           -> https://gitlab.com/user/repo.git
#   git:https://example.com/repo.git
#   path:/local/path
func parse_source(str $source) scalar {
    my hash %result = ();
    $result{"type"} = "unknown";
    $result{"url"} = "";
    $result{"ref"} = "";
    $result{"path"} = "";

    # Local path (do not split on '@')
    if (substr($source, 0, 5) eq "path:") {
        $result{"type"} = "path";
        $result{"path"} = substr($source, 5, length($source) - 5);
        return \%result;
    }

    # Check for ref specification (@tag or @branch) after last '/'
    my str $src = $source;
    my str $ref = "";
    my int $last_at = -1;
    my int $last_slash = -1;
    for (my int $i = 0; $i < length($source); $i++) {
        my str $c = substr($source, $i, 1);
        if ($c eq "@") { $last_at = $i; }
        if ($c eq "/") { $last_slash = $i; }
    }
    if ($last_at > 0 && ($last_slash < 0 || $last_at > $last_slash)) {
        $ref = substr($source, $last_at + 1, length($source) - $last_at - 1);
        $src = substr($source, 0, $last_at);
    }
    $result{"ref"} = $ref;

    # GitHub shorthand
    if (substr($src, 0, 7) eq "github:") {
        my str $repo = substr($src, 7, length($src) - 7);
        $result{"type"} = "git";
        $result{"url"} = "https://github.com/" . $repo . ".git";
        return \%result;
    }

    # GitLab shorthand
    if (substr($src, 0, 7) eq "gitlab:") {
        my str $repo = substr($src, 7, length($src) - 7);
        $result{"type"} = "git";
        $result{"url"} = "https://gitlab.com/" . $repo . ".git";
        return \%result;
    }

    # Generic git URL
    if (substr($src, 0, 4) eq "git:") {
        $result{"type"} = "git";
        $result{"url"} = substr($src, 4, length($src) - 4);
        return \%result;
    }

    # Plain URL (assume git)
    if (substr($src, 0, 8) eq "https://" || substr($src, 0, 7) eq "http://" || substr($src, 0, 6) eq "git://") {
        $result{"type"} = "git";
        $result{"url"} = $src;
        return \%result;
    }

    # Assume registry package name
    $result{"type"} = "registry";
    $result{"name"} = $src;
    return \%result;
}

# Fetch a package based on its source specification
func fetch_package(str $source, str $ver, str $deps_dir) scalar {
    my scalar $parsed = Pacco::Fetch::parse_source($source);
    my str $type = $parsed->{"type"};

    my hash %result = ();
    $result{"success"} = 0;
    $result{"path"} = "";
    $result{"error"} = "";

    if ($type eq "git") {
        my str $url = $parsed->{"url"};
        my str $ref = $parsed->{"ref"};
        my str $clean_ver = ($ver eq "*") ? "" : $ver;

        my str $name = Pacco::Fetch::extract_repo_name($url);
        if (Pacco::Fetch::is_safe_name($name) == 0) {
            $result{"error"} = "Unsafe package name: " . $name;
            return \%result;
        }
        my str $dest = $deps_dir . "/" . $name;

        if (Pacco::Fetch::fetch_git_smart($url, $ref, $clean_ver, $dest) == 1) {
            $result{"success"} = 1;
            $result{"path"} = $dest;
        } else {
            $result{"error"} = "Failed to clone " . $url;
        }
    } elsif ($type eq "path") {
        my str $path = $parsed->{"path"};
        if (core::dir_exists($path) == 1) {
            $result{"success"} = 1;
            $result{"path"} = $path;
        } else {
            $result{"error"} = "Local path not found: " . $path;
        }
    } elsif ($type eq "registry") {
        $result{"error"} = "Registry packages not yet supported. Use path:, git:, or github: source.";
    } else {
        $result{"error"} = "Unknown source type: " . $type;
    }

    return \%result;
}

# Extract repository name from a git URL or path
func extract_repo_name(str $url) str {
    my str $name = $url;

    # Strip trailing slashes
    while (length($name) > 1 && substr($name, length($name) - 1, 1) eq "/") {
        $name = substr($name, 0, length($name) - 1);
    }

    # Remove .git suffix
    if (length($name) > 4 && substr($name, length($name) - 4, 4) eq ".git") {
        $name = substr($name, 0, length($name) - 4);
    }

    # Get last path component
    my int $last_slash = -1;
    for (my int $i = 0; $i < length($name); $i++) {
        if (substr($name, $i, 1) eq "/") {
            $last_slash = $i;
        }
    }

    if ($last_slash >= 0) {
        $name = substr($name, $last_slash + 1, length($name) - $last_slash - 1);
    }

    return $name;
}

# Ensure deps directory exists
func ensure_deps_dir(str $project_dir) str {
    my str $deps_dir = $project_dir . "/.strada/deps";

    if (core::dir_exists($project_dir . "/.strada") == 0) {
        core::mkdir($project_dir . "/.strada", 493);  # 0755
    }

    if (core::dir_exists($deps_dir) == 0) {
        core::mkdir($deps_dir, 493);
    }

    return $deps_dir;
}

# Check if a package is already installed
func is_installed(str $deps_dir, str $name, str $ver) int {
    my str $path = $deps_dir . "/" . $name;
    if (core::dir_exists($path) == 1) {
        if (core::file_exists($path . "/Strada.toml") == 1) {
            if ($ver eq "" || $ver eq "*") {
                return 1;
            }
            my scalar $m = Pacco::Manifest::parse($path . "/Strada.toml");
            if (defined($m)) {
                my str $installed_ver = Pacco::Manifest::get_version($m);
                if (Pacco::SemVer::satisfies($installed_ver, $ver) == 1) {
                    return 1;
                }
            }
            return 0;
        }
        if ($ver eq "" || $ver eq "*") {
            if (core::dir_exists($path . "/src") == 1 || core::dir_exists($path . "/lib") == 1) {
                return 1;
            }
        }
    }

    if ($ver ne "" && $ver ne "*") {
        my str $vpath = $deps_dir . "/" . $name . "-" . $ver;
        if (core::dir_exists($vpath) == 1) {
            if (core::file_exists($vpath . "/Strada.toml") == 1 ||
                core::dir_exists($vpath . "/src") == 1 ||
                core::dir_exists($vpath . "/lib") == 1) {
                return 1;
            }
        }
    }

    return 0;
}

# Get the path to an installed package
func get_installed_path(str $deps_dir, str $name, str $ver) str {
    my str $path = $deps_dir . "/" . $name;
    if (core::dir_exists($path) == 1) {
        return $path;
    }

    if ($ver ne "" && $ver ne "*") {
        my str $vpath = $deps_dir . "/" . $name . "-" . $ver;
        if (core::dir_exists($vpath) == 1) {
            return $vpath;
        }
    }

    return "";
}

# Compute SHA256 checksum of a file
func checksum_file(str $path) str {
    my str $result = "";

    # Use sha256sum if available
    my str $cmd = "sha256sum -- " . Pacco::Fetch::shell_quote($path) . " 2>/dev/null | cut -d' ' -f1";
    my scalar $fh = core::popen($cmd, "r");
    if (defined($fh)) {
        $result = core::fgets($fh, 128);
        core::pclose($fh);

        # Trim newline
        if (length($result) > 0 && substr($result, length($result) - 1, 1) eq "\n") {
            $result = substr($result, 0, length($result) - 1);
        }
    }

    return $result;
}

# Compute checksum of a directory (hash of all file hashes)
func checksum_dir(str $path) str {
    my str $cmd = "find " . Pacco::Fetch::shell_quote($path) . " -type f -exec sha256sum {} \\; 2>/dev/null | sort | sha256sum | cut -d' ' -f1";
    my str $result = "";

    my scalar $fh = core::popen($cmd, "r");
    if (defined($fh)) {
        $result = core::fgets($fh, 128);
        core::pclose($fh);

        if (length($result) > 0 && substr($result, length($result) - 1, 1) eq "\n") {
            $result = substr($result, 0, length($result) - 1);
        }
    }

    return $result;
}
