# strada-repl - Compatibility shim that execs strada-jit

func main(int $argc, array @argv) int {
    my str $self_dir = core::dirname($argv[0]);
    my str $jit = $self_dir . "/strada-jit";
    if (core::is_file($jit) == 0) {
        $jit = "strada-jit";
    }
    my array @args = ($jit);
    my int $i = 1;
    while ($i < $argc) {
        push(@args, $argv[$i]);
        $i = $i + 1;
    }
    my int $rc = core::system_argv($jit, \@args);
    if ($rc < 0) {
        say("Error: could not execute strada-jit");
        return 1;
    }
    return $rc;
}
