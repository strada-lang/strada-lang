# stradapp - Strada Preprocessor
#
# A simple C-style preprocessor for Strada
#
# Supported directives:
#   #define NAME [value]    - Define a macro (value defaults to 1)
#   #undef NAME             - Undefine a macro
#   #ifdef NAME             - Include following code if NAME is defined
#   #ifndef NAME            - Include following code if NAME is NOT defined
#   #else                   - Toggle the condition
#   #endif                  - End conditional block
#   #include "file"         - Include file relative to current file
#   #include <file>         - Include file from include paths
#   #error "message"        - Abort with error message
#   #warning "message"      - Print warning message
#
# Usage: stradapp input.strada > output.strada
#        stradapp input.strada -o output.strada
#        stradapp -DDEBUG input.strada
#
# Note: Macro substitution in code is not yet supported.
#       #define values only affect #ifdef/#ifndef checks.

my hash %g_defines = ();
my array @g_include_paths = ();
my int $g_include_depth = 0;
my int $g_eval_depth = 0;

func pp_is_pure_int(str $s) int {
    my str $t = trim($s);
    my int $len = length($t);
    if ($len == 0) { return 0; }
    my int $i = 0;
    my str $first = substr($t, 0, 1);
    if ($first eq "-" || $first eq "+") { $i = 1; }
    if ($i >= $len) { return 0; }
    if ($i + 2 <= $len) {
        my str $pfx = substr($t, $i, 2);
        if ($pfx eq "0x" || $pfx eq "0X") {
            $i = $i + 2;
            if ($i >= $len) { return 0; }
            while ($i < $len) {
                my int $c = ord(substr($t, $i, 1));
                if (!(($c >= 48 && $c <= 57) || ($c >= 97 && $c <= 102) || ($c >= 65 && $c <= 70))) { return 0; }
                $i = $i + 1;
            }
            return 1;
        }
        if ($pfx eq "0b" || $pfx eq "0B") {
            $i = $i + 2;
            if ($i >= $len) { return 0; }
            while ($i < $len) {
                my int $c = ord(substr($t, $i, 1));
                if ($c != 48 && $c != 49) { return 0; }
                $i = $i + 1;
            }
            return 1;
        }
        if ($pfx eq "0o" || $pfx eq "0O") {
            $i = $i + 2;
            if ($i >= $len) { return 0; }
            while ($i < $len) {
                my int $c = ord(substr($t, $i, 1));
                if ($c < 48 || $c > 55) { return 0; }
                $i = $i + 1;
            }
            return 1;
        }
    }
    while ($i < $len) {
        my int $c = ord(substr($t, $i, 1));
        if ($c < 48 || $c > 57) { return 0; }
        $i = $i + 1;
    }
    return 1;
}

func pp_parse_int_lit(str $s) int {
    my str $t = trim($s);
    my int $len = length($t);
    if ($len == 0) { return 0; }
    my int $neg = 0;
    my int $i = 0;
    my str $first = substr($t, 0, 1);
    if ($first eq "-") {
        $neg = 1;
        $i = 1;
    } elsif ($first eq "+") {
        $i = 1;
    }
    if ($i >= $len) { return 0; }
    my int $val = 0;
    if ($i + 2 <= $len) {
        my str $pfx = substr($t, $i, 2);
        if ($pfx eq "0x" || $pfx eq "0X") {
            $i = $i + 2;
            while ($i < $len) {
                my int $c = ord(substr($t, $i, 1));
                my int $d = -1;
                if ($c >= 48 && $c <= 57) { $d = $c - 48; }
                elsif ($c >= 97 && $c <= 102) { $d = $c - 87; }
                elsif ($c >= 65 && $c <= 70) { $d = $c - 55; }
                if ($d < 0) { last; }
                $val = $val * 16 + $d;
                $i = $i + 1;
            }
            return $neg == 1 ? (0 - $val) : $val;
        }
        if ($pfx eq "0b" || $pfx eq "0B") {
            $i = $i + 2;
            while ($i < $len) {
                my int $c = ord(substr($t, $i, 1));
                if ($c == 48) { $val = $val * 2; }
                elsif ($c == 49) { $val = $val * 2 + 1; }
                else { last; }
                $i = $i + 1;
            }
            return $neg == 1 ? (0 - $val) : $val;
        }
        if ($pfx eq "0o" || $pfx eq "0O") {
            $i = $i + 2;
            while ($i < $len) {
                my int $c = ord(substr($t, $i, 1));
                if ($c >= 48 && $c <= 55) { $val = $val * 8 + ($c - 48); }
                else { last; }
                $i = $i + 1;
            }
            return $neg == 1 ? (0 - $val) : $val;
        }
    }
    if (substr($t, $i, 1) eq "0" && $len - $i > 1) {
        $i = $i + 1;
        while ($i < $len) {
            my int $c = ord(substr($t, $i, 1));
            if ($c >= 48 && $c <= 55) { $val = $val * 8 + ($c - 48); }
            else { last; }
            $i = $i + 1;
        }
        return $neg == 1 ? (0 - $val) : $val;
    }
    while ($i < $len) {
        my int $c = ord(substr($t, $i, 1));
        if ($c >= 48 && $c <= 57) {
            $val = $val * 10 + ($c - 48);
        } else {
            last;
        }
        $i = $i + 1;
    }
    return $neg == 1 ? (0 - $val) : $val;
}

func pp_resolve_macro_val(str $name, int $depth) int {
    if ($depth > 16 || $g_eval_depth > 16) { return 0; }
    if (!exists(%g_defines, $name)) { return 0; }
    my str $raw = trim("" . $g_defines{$name});
    if ($raw eq "") { return 0; }
    if (pp_is_pure_int($raw) == 1) {
        return pp_parse_int_lit($raw);
    }
    if (exists(%g_defines, $raw)) {
        return pp_resolve_macro_val($raw, $depth + 1);
    }
    $g_eval_depth = $g_eval_depth + 1;
    my int $res = pp_eval_expr($raw);
    $g_eval_depth = $g_eval_depth - 1;
    return $res;
}

func pp_skip_ws(str $s, int $pos, int $len) int {
    while ($pos < $len) {
        my int $c = ord(substr($s, $pos, 1));
        if ($c == 32 || $c == 9 || $c == 13) {
            $pos = $pos + 1;
        } else {
            last;
        }
    }
    return $pos;
}

func pp_parse_primary(str $s, scalar $pos_ref, int $len) int {
    my int $p = pp_skip_ws($s, $$pos_ref, $len);
    $$pos_ref = $p;
    if ($p >= $len) { return 0; }
    my str $ch = substr($s, $p, 1);
    if ($ch eq "(") {
        $$pos_ref = $p + 1;
        my int $v = pp_parse_or($s, $pos_ref, $len);
        $p = pp_skip_ws($s, $$pos_ref, $len);
        if ($p < $len && substr($s, $p, 1) eq ")") {
            $p = $p + 1;
        }
        $$pos_ref = $p;
        return $v;
    }
    my int $c = ord($ch);
    if ($c >= 48 && $c <= 57) {
        my int $start = $p;
        while ($p < $len) {
            my int $dc = ord(substr($s, $p, 1));
            if (($dc >= 48 && $dc <= 57) || ($dc >= 97 && $dc <= 122) || ($dc >= 65 && $dc <= 90)) {
                $p = $p + 1;
            } else {
                last;
            }
        }
        $$pos_ref = $p;
        return pp_parse_int_lit(substr($s, $start, $p - $start));
    }
    if (($c >= 97 && $c <= 122) || ($c >= 65 && $c <= 90) || $c == 95) {
        my int $start = $p;
        while ($p < $len && is_ident_char(substr($s, $p, 1)) == 1) {
            $p = $p + 1;
        }
        my str $ident = substr($s, $start, $p - $start);
        $$pos_ref = $p;
        if ($ident eq "defined") {
            $p = pp_skip_ws($s, $p, $len);
            my int $has_paren = 0;
            if ($p < $len && substr($s, $p, 1) eq "(") {
                $has_paren = 1;
                $p = pp_skip_ws($s, $p + 1, $len);
            }
            my int $ns = $p;
            while ($p < $len && is_ident_char(substr($s, $p, 1)) == 1) {
                $p = $p + 1;
            }
            my str $mname = substr($s, $ns, $p - $ns);
            if ($has_paren == 1) {
                $p = pp_skip_ws($s, $p, $len);
                if ($p < $len && substr($s, $p, 1) eq ")") {
                    $p = $p + 1;
                }
            }
            $$pos_ref = $p;
            if (length($mname) > 0 && exists(%g_defines, $mname)) { return 1; }
            return 0;
        }
        return pp_resolve_macro_val($ident, 0);
    }
    $$pos_ref = $p + 1;
    return 0;
}

func pp_parse_unary(str $s, scalar $pos_ref, int $len) int {
    my int $p = pp_skip_ws($s, $$pos_ref, $len);
    $$pos_ref = $p;
    if ($p >= $len) { return 0; }
    my str $ch = substr($s, $p, 1);
    if ($ch eq "!" && ($p + 1 >= $len || substr($s, $p + 1, 1) ne "=")) {
        $$pos_ref = $p + 1;
        return pp_parse_unary($s, $pos_ref, $len) == 0 ? 1 : 0;
    }
    if ($ch eq "~") {
        $$pos_ref = $p + 1;
        return (0 - 1) - pp_parse_unary($s, $pos_ref, $len);
    }
    if ($ch eq "-") {
        $$pos_ref = $p + 1;
        return 0 - pp_parse_unary($s, $pos_ref, $len);
    }
    if ($ch eq "+") {
        $$pos_ref = $p + 1;
        return pp_parse_unary($s, $pos_ref, $len);
    }
    return pp_parse_primary($s, $pos_ref, $len);
}

func pp_parse_mul(str $s, scalar $pos_ref, int $len) int {
    my int $left = pp_parse_unary($s, $pos_ref, $len);
    while (1) {
        my int $p = pp_skip_ws($s, $$pos_ref, $len);
        $$pos_ref = $p;
        if ($p >= $len) { last; }
        my str $ch = substr($s, $p, 1);
        if ($ch eq "*") {
            $$pos_ref = $p + 1;
            $left = $left * pp_parse_unary($s, $pos_ref, $len);
        } elsif ($ch eq "/") {
            $$pos_ref = $p + 1;
            my int $r = pp_parse_unary($s, $pos_ref, $len);
            if ($r != 0) { $left = $left / $r; } else { $left = 0; }
        } elsif ($ch eq "%") {
            $$pos_ref = $p + 1;
            my int $r = pp_parse_unary($s, $pos_ref, $len);
            if ($r != 0) { $left = $left % $r; } else { $left = 0; }
        } else {
            last;
        }
    }
    return $left;
}

func pp_parse_add(str $s, scalar $pos_ref, int $len) int {
    my int $left = pp_parse_mul($s, $pos_ref, $len);
    while (1) {
        my int $p = pp_skip_ws($s, $$pos_ref, $len);
        $$pos_ref = $p;
        if ($p >= $len) { last; }
        my str $ch = substr($s, $p, 1);
        if ($ch eq "+") {
            $$pos_ref = $p + 1;
            $left = $left + pp_parse_mul($s, $pos_ref, $len);
        } elsif ($ch eq "-") {
            $$pos_ref = $p + 1;
            $left = $left - pp_parse_mul($s, $pos_ref, $len);
        } else {
            last;
        }
    }
    return $left;
}

func pp_bit_shl(int $a, int $b) int {
    if ($b <= 0) { return $a; }
    if ($b >= 64) { return 0; }
    my int $r = $a;
    my int $i = 0;
    while ($i < $b) {
        $r = $r * 2;
        $i = $i + 1;
    }
    return $r;
}

func pp_bit_shr(int $a, int $b) int {
    if ($b <= 0) { return $a; }
    if ($b >= 63) {
        if ($a < 0) { return 0 - 1; }
        return 0;
    }
    my int $r = $a;
    my int $i = 0;
    while ($i < $b) {
        if ($r < 0 && ($r % 2) != 0) {
            $r = ($r / 2) - 1;
        } else {
            $r = $r / 2;
        }
        $i = $i + 1;
    }
    return $r;
}

func pp_bit_op(int $a, int $b, int $op) int {
    my int $sa = 0;
    my int $sb = 0;
    my int $half63 = 4611686018427387904;
    if ($a < 0) {
        $sa = 1;
        $a = ($a + $half63) + $half63;
    }
    if ($b < 0) {
        $sb = 1;
        $b = ($b + $half63) + $half63;
    }
    my int $res = 0;
    my int $pow = 1;
    my int $i = 0;
    while ($i < 63) {
        my int $ba = $a % 2;
        my int $bb = $b % 2;
        $a = $a / 2;
        $b = $b / 2;
        my int $br = 0;
        if ($op == 0) {
            if ($ba != 0 && $bb != 0) { $br = 1; }
        } elsif ($op == 1) {
            if ($ba != $bb) { $br = 1; }
        } else {
            if ($ba != 0 || $bb != 0) { $br = 1; }
        }
        if ($br != 0) { $res = $res + $pow; }
        if ($i < 62) { $pow = $pow * 2; }
        $i = $i + 1;
    }
    my int $sr = 0;
    if ($op == 0) {
        if ($sa != 0 && $sb != 0) { $sr = 1; }
    } elsif ($op == 1) {
        if ($sa != $sb) { $sr = 1; }
    } else {
        if ($sa != 0 || $sb != 0) { $sr = 1; }
    }
    if ($sr != 0) {
        $res = ($res - $half63) - $half63;
    }
    return $res;
}

func pp_parse_shift(str $s, scalar $pos_ref, int $len) int {
    my int $left = pp_parse_add($s, $pos_ref, $len);
    while (1) {
        my int $p = pp_skip_ws($s, $$pos_ref, $len);
        $$pos_ref = $p;
        if ($p + 1 >= $len) { last; }
        my str $op = substr($s, $p, 2);
        if ($op eq "<<") {
            $$pos_ref = $p + 2;
            $left = pp_bit_shl($left, pp_parse_add($s, $pos_ref, $len));
        } elsif ($op eq ">>") {
            $$pos_ref = $p + 2;
            $left = pp_bit_shr($left, pp_parse_add($s, $pos_ref, $len));
        } else {
            last;
        }
    }
    return $left;
}

func pp_parse_rel(str $s, scalar $pos_ref, int $len) int {
    my int $left = pp_parse_shift($s, $pos_ref, $len);
    while (1) {
        my int $p = pp_skip_ws($s, $$pos_ref, $len);
        $$pos_ref = $p;
        if ($p >= $len) { last; }
        if ($p + 1 < $len) {
            my str $op2 = substr($s, $p, 2);
            if ($op2 eq "<=") {
                $$pos_ref = $p + 2;
                if ($left <= pp_parse_shift($s, $pos_ref, $len)) { $left = 1; } else { $left = 0; }
                next;
            }
            if ($op2 eq ">=") {
                $$pos_ref = $p + 2;
                if ($left >= pp_parse_shift($s, $pos_ref, $len)) { $left = 1; } else { $left = 0; }
                next;
            }
            if ($op2 eq "<<" || $op2 eq ">>") { last; }
        }
        my str $ch = substr($s, $p, 1);
        if ($ch eq "<") {
            $$pos_ref = $p + 1;
            if ($left < pp_parse_shift($s, $pos_ref, $len)) { $left = 1; } else { $left = 0; }
            next;
        }
        if ($ch eq ">") {
            $$pos_ref = $p + 1;
            if ($left > pp_parse_shift($s, $pos_ref, $len)) { $left = 1; } else { $left = 0; }
            next;
        }
        last;
    }
    return $left;
}

func pp_parse_eq(str $s, scalar $pos_ref, int $len) int {
    my int $left = pp_parse_rel($s, $pos_ref, $len);
    while (1) {
        my int $p = pp_skip_ws($s, $$pos_ref, $len);
        $$pos_ref = $p;
        if ($p + 1 >= $len) { last; }
        my str $op = substr($s, $p, 2);
        if ($op eq "==") {
            $$pos_ref = $p + 2;
            if ($left == pp_parse_rel($s, $pos_ref, $len)) { $left = 1; } else { $left = 0; }
            next;
        }
        if ($op eq "!=") {
            $$pos_ref = $p + 2;
            if ($left != pp_parse_rel($s, $pos_ref, $len)) { $left = 1; } else { $left = 0; }
            next;
        }
        last;
    }
    return $left;
}

func pp_parse_bitand(str $s, scalar $pos_ref, int $len) int {
    my int $left = pp_parse_eq($s, $pos_ref, $len);
    while (1) {
        my int $p = pp_skip_ws($s, $$pos_ref, $len);
        $$pos_ref = $p;
        if ($p >= $len) { last; }
        if (substr($s, $p, 1) eq "&" && ($p + 1 >= $len || substr($s, $p + 1, 1) ne "&")) {
            $$pos_ref = $p + 1;
            $left = pp_bit_op($left, pp_parse_eq($s, $pos_ref, $len), 0);
            next;
        }
        last;
    }
    return $left;
}

func pp_parse_bitxor(str $s, scalar $pos_ref, int $len) int {
    my int $left = pp_parse_bitand($s, $pos_ref, $len);
    while (1) {
        my int $p = pp_skip_ws($s, $$pos_ref, $len);
        $$pos_ref = $p;
        if ($p >= $len) { last; }
        if (substr($s, $p, 1) eq "^") {
            $$pos_ref = $p + 1;
            $left = pp_bit_op($left, pp_parse_bitand($s, $pos_ref, $len), 1);
            next;
        }
        last;
    }
    return $left;
}

func pp_parse_bitor(str $s, scalar $pos_ref, int $len) int {
    my int $left = pp_parse_bitxor($s, $pos_ref, $len);
    while (1) {
        my int $p = pp_skip_ws($s, $$pos_ref, $len);
        $$pos_ref = $p;
        if ($p >= $len) { last; }
        if (substr($s, $p, 1) eq "|" && ($p + 1 >= $len || substr($s, $p + 1, 1) ne "|")) {
            $$pos_ref = $p + 1;
            $left = pp_bit_op($left, pp_parse_bitxor($s, $pos_ref, $len), 2);
            next;
        }
        last;
    }
    return $left;
}

func pp_parse_and(str $s, scalar $pos_ref, int $len) int {
    my int $left = pp_parse_bitor($s, $pos_ref, $len);
    while (1) {
        my int $p = pp_skip_ws($s, $$pos_ref, $len);
        $$pos_ref = $p;
        if ($p + 1 >= $len) { last; }
        if (substr($s, $p, 2) eq "&&") {
            $$pos_ref = $p + 2;
            my int $right = pp_parse_bitor($s, $pos_ref, $len);
            if ($left != 0 && $right != 0) { $left = 1; } else { $left = 0; }
            next;
        }
        last;
    }
    return $left;
}

func pp_parse_or(str $s, scalar $pos_ref, int $len) int {
    my int $left = pp_parse_and($s, $pos_ref, $len);
    while (1) {
        my int $p = pp_skip_ws($s, $$pos_ref, $len);
        $$pos_ref = $p;
        if ($p + 1 >= $len) { last; }
        if (substr($s, $p, 2) eq "||") {
            $$pos_ref = $p + 2;
            my int $right = pp_parse_and($s, $pos_ref, $len);
            if ($left != 0 || $right != 0) { $left = 1; } else { $left = 0; }
            next;
        }
        last;
    }
    return $left;
}

func pp_eval_expr(str $expr) int {
    if ($g_eval_depth > 16) { return 0; }
    $g_eval_depth = $g_eval_depth + 1;
    my int $pos = 0;
    my int $res = pp_parse_or($expr, \$pos, length($expr));
    $g_eval_depth = $g_eval_depth - 1;
    return $res;
}

func starts_with(str $s, str $prefix) int {
    my int $plen = length($prefix);
    if (length($s) < $plen) {
        return 0;
    }
    return substr($s, 0, $plen) eq $prefix;
}

func is_ident_char(str $ch) int {
    my int $c = ord($ch);
    if (($c >= 97 && $c <= 122) || ($c >= 65 && $c <= 90) || ($c >= 48 && $c <= 57) || $c == 95) {
        return 1;
    }
    return 0;
}

# Extract directive word immediately following '#' (at index 1), or "" if none.
func directive_word(str $trimmed) str {
    my int $len = length($trimmed);
    my int $end = 1;
    while ($end < $len && is_ident_char(substr($trimmed, $end, 1)) == 1) {
        $end++;
    }
    if ($end == 1) {
        return "";
    }
    my str $w = substr($trimmed, 1, $end - 1);
    if ($end < $len) {
        my str $next = substr($trimmed, $end, 1);
        if ($next ne " " && $next ne "\t") {
            if (!($w eq "include" && ($next eq "\"" || $next eq "<"))) {
                return "";
            }
        }
    }
    return $w;
}

# Strip trailing '# ...' comments outside single/double-quoted literals.
func strip_pp_comment(str $s) str {
    my int $len = length($s);
    my int $i = 0;
    my int $in_dq = 0;
    my int $in_sq = 0;
    while ($i < $len) {
        my str $ch = substr($s, $i, 1);
        if ($in_dq == 1) {
            if ($ch eq "\\") {
                $i = $i + 2;
                next;
            }
            if ($ch eq "\"") {
                $in_dq = 0;
            }
        } elsif ($in_sq == 1) {
            if ($ch eq "\\") {
                $i = $i + 2;
                next;
            }
            if ($ch eq "'") {
                $in_sq = 0;
            }
        } else {
            if ($ch eq "\"") {
                $in_dq = 1;
            } elsif ($ch eq "'") {
                $in_sq = 1;
            } elsif ($ch eq "#") {
                return trim(substr($s, 0, $i));
            }
        }
        $i++;
    }
    return trim($s);
}

# Find '__C__' outside Strada string literals and '#' comments; returns index or -1.
func find_c_block_kw(str $line) int {
    my int $len = length($line);
    my int $i = 0;
    my int $in_dq = 0;
    my int $in_sq = 0;
    while ($i < $len) {
        my str $ch = substr($line, $i, 1);
        if ($in_dq == 1) {
            if ($ch eq "\\") { $i = $i + 2; next; }
            if ($ch eq "\"") { $in_dq = 0; }
            $i++;
            next;
        }
        if ($in_sq == 1) {
            if ($ch eq "\\") { $i = $i + 2; next; }
            if ($ch eq "'") { $in_sq = 0; }
            $i++;
            next;
        }
        if ($ch eq "\"") { $in_dq = 1; $i++; next; }
        if ($ch eq "'") { $in_sq = 1; $i++; next; }
        if ($ch eq "#") { return -1; }
        if ($i + 5 <= $len && substr($line, $i, 5) eq "__C__") {
            my int $prev_ok = 1;
            if ($i > 0 && is_ident_char(substr($line, $i - 1, 1)) == 1) {
                $prev_ok = 0;
            }
            my int $next_ok = 1;
            if ($i + 5 < $len) {
                my str $nc = substr($line, $i + 5, 1);
                if ($nc ne " " && $nc ne "\t" && $nc ne "{") {
                    $next_ok = 0;
                }
            }
            if ($prev_ok == 1 && $next_ok == 1) {
                return $i;
            }
        }
        $i++;
    }
    return -1;
}

func file_exists(str $path) int {
    my hash %stat = core::stat($path);
    return exists(%stat, "size");
}

func find_include(str $filename, str $current_dir) str {
    # Try relative to current file first
    my str $path = $current_dir . "/" . $filename;
    if (file_exists($path)) {
        return $path;
    }

    # Try include paths
    my int $i = 0;
    my int $n = size(@g_include_paths);
    while ($i < $n) {
        $path = $g_include_paths[$i] . "/" . $filename;
        if (file_exists($path)) {
            return $path;
        }
        $i++;
    }

    # Try current directory
    if (file_exists($filename)) {
        return $filename;
    }

    return "";
}

func pp_is_pod_start(str $line) int {
    if (length($line) < 2 || substr($line, 0, 1) ne "=") { return 0; }
    my str $ch1 = substr($line, 1, 1);
    my int $c = ord($ch1);
    if (!(($c >= 97 && $c <= 122) || ($c >= 65 && $c <= 90))) { return 0; }
    if (starts_with($line, "=cut") == 1 && (length($line) == 4 || substr($line, 4, 1) eq " " || substr($line, 4, 1) eq "\t")) {
        return 0;
    }
    return 1;
}

func pp_is_pod_end(str $trimmed) int {
    if ($trimmed eq "=cut") { return 1; }
    if (starts_with($trimmed, "=cut ") == 1 || starts_with($trimmed, "=cut\t") == 1) { return 1; }
    return 0;
}

func pp_detect_heredoc_tag(str $line) str {
    my int $len = length($line);
    my int $i = 0;
    my int $in_dq = 0;
    my int $in_sq = 0;
    while ($i < $len) {
        my str $ch = substr($line, $i, 1);
        if ($in_dq == 1) {
            if ($ch eq "\\") { $i = $i + 2; next; }
            if ($ch eq "\"") { $in_dq = 0; }
            $i = $i + 1;
            next;
        }
        if ($in_sq == 1) {
            if ($ch eq "\\") { $i = $i + 2; next; }
            if ($ch eq "'") { $in_sq = 0; }
            $i = $i + 1;
            next;
        }
        if ($ch eq "\"") { $in_dq = 1; $i = $i + 1; next; }
        if ($ch eq "'") { $in_sq = 1; $i = $i + 1; next; }
        if ($ch eq "#") { return ""; }
        if ($ch eq "<" && $i + 2 < $len && substr($line, $i + 1, 1) eq "<") {
            my int $j = $i + 2;
            my str $q = "";
            if ($j < $len && (substr($line, $j, 1) eq "'" || substr($line, $j, 1) eq "\"")) {
                $q = substr($line, $j, 1);
                $j = $j + 1;
            }
            my int $start = $j;
            while ($j < $len && is_ident_char(substr($line, $j, 1)) == 1) {
                $j = $j + 1;
            }
            if ($j > $start) {
                my str $tag = substr($line, $start, $j - $start);
                if ($q eq "" || ($j < $len && substr($line, $j, 1) eq $q)) {
                    # Guard against bit-shift `$x << 1`: bareword heredoc tags are uppercase identifiers or quoted
                    if ($q ne "" || $tag =~ /^[A-Z_][A-Z0-9_]*$/) {
                        return $tag;
                    }
                }
            }
        }
        $i = $i + 1;
    }
    return "";
}

func pp_scan_strada_state(str $line, scalar $dq_ref, scalar $sq_ref, scalar $cmt_ref) void {
    my int $len = length($line);
    my int $i = 0;
    while ($i < $len) {
        my str $ch = substr($line, $i, 1);
        if ($$cmt_ref == 1) {
            if ($ch eq "*" && $i + 1 < $len && substr($line, $i + 1, 1) eq "/") {
                $$cmt_ref = 0;
                $i = $i + 2;
                next;
            }
            $i = $i + 1;
            next;
        }
        if ($$dq_ref == 1) {
            if ($ch eq "\\") { $i = $i + 2; next; }
            if ($ch eq "\"") { $$dq_ref = 0; }
            $i = $i + 1;
            next;
        }
        if ($$sq_ref == 1) {
            if ($ch eq "\\") { $i = $i + 2; next; }
            if ($ch eq "'") { $$sq_ref = 0; }
            $i = $i + 1;
            next;
        }
        if ($ch eq "/" && $i + 1 < $len && substr($line, $i + 1, 1) eq "*") {
            $$cmt_ref = 1;
            $i = $i + 2;
            next;
        }
        if ($ch eq "#") { last; }
        if ($ch eq "\"") { $$dq_ref = 1; }
        elsif ($ch eq "'") { $$sq_ref = 1; }
        $i = $i + 1;
    }
}

func preprocess(str $filename) str {
    my str $content = slurp($filename);
    if (!defined($content)) {
        die("stradapp: cannot read file: " . $filename);
    }

    my str $file_dir = core::dirname($filename);
    if ($file_dir eq "") {
        $file_dir = ".";
    }

    my array @lines = split("\n", $content);
    my str $output = "";
    my array @cond_stack = ();
    my array @cond_taken = ();
    my int $active = 1;
    my int $in_c_block = 0;       # 0 = outside, 1 = inside {..}, 2 = saw __C__ awaiting {
    my int $c_block_depth = 0;
    my int $c_in_block_cmt = 0;
    my int $c_in_str = 0;
    my int $c_in_chr = 0;
    my int $in_pod = 0;
    my int $in_ml_dq = 0;
    my int $in_ml_sq = 0;
    my int $in_block_cmt = 0;
    my str $heredoc_tag = "";
    my str $pending_heredoc = "";

    my int $i = 0;
    my int $num_lines = size(@lines);

    while ($i < $num_lines) {
        my str $line = $lines[$i];
        my str $trimmed = trim($line);
        # every input line yields an output line (blank when consumed: a
        # comment, a directive, an inactive branch) so compiler diagnostics
        # point at the right line of the original file
        my int $before = length($output);

        # Inside multiline POD / heredoc / quoted literal / C block comment:
        # never interpret `#...` as a preprocessor directive.
        if (length($heredoc_tag) > 0) {
            if ($trimmed eq $heredoc_tag) {
                $heredoc_tag = "";
            }
            if ($active) {
                $output = $output . $line . "\n";
            } else {
                $output = $output . "\n";
            }
            $i++;
            next;
        }
        if ($in_pod == 1) {
            if (pp_is_pod_end($trimmed) == 1) {
                $in_pod = 0;
            }
            if ($active) {
                $output = $output . $line . "\n";
            } else {
                $output = $output . "\n";
            }
            $i++;
            next;
        }
        if ($in_ml_dq == 1 || $in_ml_sq == 1 || $in_block_cmt == 1) {
            pp_scan_strada_state($line, \$in_ml_dq, \$in_ml_sq, \$in_block_cmt);
            if ($in_ml_dq == 0 && $in_ml_sq == 0 && $in_block_cmt == 0 && length($pending_heredoc) > 0) {
                $heredoc_tag = $pending_heredoc;
                $pending_heredoc = "";
            }
            if ($active) {
                $output = $output . $line . "\n";
            } else {
                $output = $output . "\n";
            }
            $i++;
            next;
        }
        if ($in_c_block == 0 && pp_is_pod_start($line) == 1) {
            $in_pod = 1;
            if ($active) {
                $output = $output . $line . "\n";
            } else {
                $output = $output . "\n";
            }
            $i++;
            next;
        }

        # Check for __C__ block start or continuation
        my int $c_scan_from = -1;
        if ($in_c_block != 0) {
            $c_scan_from = 0;
        } else {
            my int $kw_pos = find_c_block_kw($line);
            if ($kw_pos >= 0) {
                $in_c_block = 2;
                $c_block_depth = 0;
                $c_in_block_cmt = 0;
                $c_in_str = 0;
                $c_in_chr = 0;
                $c_scan_from = $kw_pos + 5;
            }
        }

        if ($c_scan_from >= 0) {
            my int $j = $c_scan_from;
            my int $llen = length($line);
            while ($j < $llen) {
                my str $ch = substr($line, $j, 1);
                if ($c_in_block_cmt == 1) {
                    if ($ch eq "*" && $j + 1 < $llen && substr($line, $j + 1, 1) eq "/") {
                        $c_in_block_cmt = 0;
                        $j = $j + 2;
                        next;
                    }
                    $j++;
                    next;
                }
                if ($c_in_str == 1) {
                    if ($ch eq "\\") { $j = $j + 2; next; }
                    if ($ch eq "\"") { $c_in_str = 0; }
                    $j++;
                    next;
                }
                if ($c_in_chr == 1) {
                    if ($ch eq "\\") { $j = $j + 2; next; }
                    if ($ch eq "'") { $c_in_chr = 0; }
                    $j++;
                    next;
                }
                if ($ch eq "/" && $j + 1 < $llen) {
                    my str $nch = substr($line, $j + 1, 1);
                    if ($nch eq "/") {
                        last;
                    }
                    if ($nch eq "*") {
                        $c_in_block_cmt = 1;
                        $j = $j + 2;
                        next;
                    }
                }
                if ($ch eq "\"") { $c_in_str = 1; $j++; next; }
                if ($ch eq "'") { $c_in_chr = 1; $j++; next; }
                if ($ch eq "{") {
                    if ($in_c_block == 2) {
                        $in_c_block = 1;
                        $c_block_depth = 1;
                    } else {
                        $c_block_depth++;
                    }
                } elsif ($ch eq "}" && $in_c_block == 1) {
                    $c_block_depth--;
                    if ($c_block_depth == 0) {
                        $in_c_block = 0;
                        last;
                    }
                }
                $j++;
            }
            # Pass through C code as-is
            if ($active) {
                $output = $output . $line . "\n";
            } else {
                $output = $output . "\n";
            }
            $i++;
            next;
        }

        if (substr($trimmed, 0, 1) eq "#") {
            if ($i == 0 && starts_with($trimmed, "#!")) {
                # Shebang (#!/usr/bin/env strada) on line 1: pass through untouched.
                if ($active) {
                    $output = $output . $line . "\n";
                }
            } else {
                my str $word = directive_word($trimmed);
                my str $raw_rest = "";
                if ($word ne "" && length($trimmed) > 1 + length($word)) {
                    $raw_rest = trim(substr($trimmed, 1 + length($word)));
                }

                if ($word eq "define") {
                    if ($active) {
                        my str $rest = strip_pp_comment($raw_rest);
                        if ($rest ne "") {
                            my int $ws_idx = -1;
                            my int $ri = 0;
                            while ($ri < length($rest)) {
                                my str $rch = substr($rest, $ri, 1);
                                if ($rch eq " " || $rch eq "\t") {
                                    $ws_idx = $ri;
                                    last;
                                }
                                $ri++;
                            }
                            my str $name = "";
                            my str $value = "1";
                            if ($ws_idx > 0) {
                                $name = substr($rest, 0, $ws_idx);
                                $value = trim(substr($rest, $ws_idx + 1));
                                if ($value eq "") { $value = "1"; }
                            } else {
                                $name = $rest;
                            }
                            $g_defines{$name} = $value;
                        }
                    }
                } elsif ($word eq "undef") {
                    if ($active) {
                        my str $name = strip_pp_comment($raw_rest);
                        if ($name ne "") {
                            delete(%g_defines, $name);
                        }
                    }
                } elsif ($word eq "ifdef") {
                    my str $name = strip_pp_comment($raw_rest);
                    push(@cond_stack, $active);
                    my int $taken = 0;
                    if ($active) {
                        $active = exists(%g_defines, $name) ? 1 : 0;
                        $taken = $active;
                    } else {
                        $taken = 1;
                    }
                    push(@cond_taken, $taken);
                } elsif ($word eq "ifndef") {
                    my str $name = strip_pp_comment($raw_rest);
                    push(@cond_stack, $active);
                    my int $taken = 0;
                    if ($active) {
                        $active = (!exists(%g_defines, $name)) ? 1 : 0;
                        $taken = $active;
                    } else {
                        $taken = 1;
                    }
                    push(@cond_taken, $taken);
                } elsif ($word eq "if") {
                    my str $expr = strip_pp_comment($raw_rest);
                    push(@cond_stack, $active);
                    my int $taken = 0;
                    if ($active) {
                        $active = (pp_eval_expr($expr) != 0) ? 1 : 0;
                        $taken = $active;
                    } else {
                        $taken = 1;
                    }
                    push(@cond_taken, $taken);
                } elsif ($word eq "elif") {
                    my str $expr = strip_pp_comment($raw_rest);
                    if (size(@cond_stack) == 0) {
                        die("stradapp: " . $filename . ":" . ($i + 1) . ": #elif without #if/#ifdef/#ifndef");
                    }
                    my int $top = size(@cond_stack) - 1;
                    my int $parent_active = $cond_stack[$top];
                    if ($parent_active && $cond_taken[$top] == 0) {
                        $active = (pp_eval_expr($expr) != 0) ? 1 : 0;
                        if ($active) {
                            $cond_taken[$top] = 1;
                        }
                    } else {
                        $active = 0;
                    }
                } elsif ($word eq "else") {
                    my str $extra = strip_pp_comment($raw_rest);
                    if ($extra eq "") {
                        if (size(@cond_stack) == 0) {
                            die("stradapp: " . $filename . ":" . ($i + 1) . ": #else without #if/#ifdef/#ifndef");
                        }
                        my int $top = size(@cond_stack) - 1;
                        my int $parent_active = $cond_stack[$top];
                        if ($parent_active && $cond_taken[$top] == 0) {
                            $active = 1;
                            $cond_taken[$top] = 1;
                        } else {
                            $active = 0;
                        }
                    }
                } elsif ($word eq "endif") {
                    my str $extra = strip_pp_comment($raw_rest);
                    if ($extra eq "") {
                        if (size(@cond_stack) == 0) {
                            die("stradapp: " . $filename . ":" . ($i + 1) . ": #endif without #if/#ifdef/#ifndef");
                        }
                        $active = pop(@cond_stack);
                        pop(@cond_taken);
                    }
                } elsif ($word eq "include") {
                    if ($active) {
                        my str $rest = strip_pp_comment($raw_rest);
                        my str $inc_file = "";
                        if (substr($rest, 0, 1) eq "\"") {
                            my int $end = index(substr($rest, 1), "\"");
                            if ($end > 0) {
                                $inc_file = substr($rest, 1, $end);
                            }
                        } elsif (substr($rest, 0, 1) eq "<") {
                            my int $end = index(substr($rest, 1), ">");
                            if ($end > 0) {
                                $inc_file = substr($rest, 1, $end);
                            }
                        }
                        if ($inc_file eq "") {
                            die("stradapp: " . $filename . ":" . ($i + 1) . ": invalid #include syntax");
                        }
                        my str $inc_path = find_include($inc_file, $file_dir);
                        if ($inc_path eq "") {
                            die("stradapp: " . $filename . ":" . ($i + 1) . ": cannot find include file: " . $inc_file);
                        }
                        if ($g_include_depth >= 64) {
                            die("stradapp: #include recursion depth exceeded (max 64) at " . $inc_path);
                        }
                        $g_include_depth = $g_include_depth + 1;
                        my str $inc_content = preprocess($inc_path);
                        $g_include_depth = $g_include_depth - 1;
                        $output = $output . $inc_content;
                    }
                } elsif ($word eq "error" && starts_with($raw_rest, "\"")) {
                    if ($active) {
                        my str $msg = strip_pp_comment($raw_rest);
                        if (length($msg) >= 2 && substr($msg, 0, 1) eq "\"" && substr($msg, length($msg) - 1, 1) eq "\"") {
                            $msg = substr($msg, 1, length($msg) - 2);
                        }
                        die("stradapp: " . $filename . ":" . ($i + 1) . ": error: " . $msg);
                    }
                } elsif ($word eq "warning" && starts_with($raw_rest, "\"")) {
                    if ($active) {
                        my str $msg = strip_pp_comment($raw_rest);
                        if (length($msg) >= 2 && substr($msg, 0, 1) eq "\"" && substr($msg, length($msg) - 1, 1) eq "\"") {
                            $msg = substr($msg, 1, length($msg) - 2);
                        }
                        warn("stradapp: " . $filename . ":" . ($i + 1) . ": warning: " . $msg);
                    }
                } else {
                    # Ordinary Strada comment (e.g. '# ...', '### banner', '#comment') — skip
                }
            }
        } else {
            my str $hd = pp_detect_heredoc_tag($line);
            pp_scan_strada_state($line, \$in_ml_dq, \$in_ml_sq, \$in_block_cmt);
            if ($in_ml_dq == 1 || $in_ml_sq == 1 || $in_block_cmt == 1) {
                $pending_heredoc = $hd;
            } elsif (length($hd) > 0) {
                $heredoc_tag = $hd;
            }
            if ($active) {
                $output = $output . $line . "\n";
            }
        }

        if (length($output) == $before) { $output = $output . "\n"; }
        $i++;
    }

    if (size(@cond_stack) > 0) {
        die("stradapp: " . $filename . ": unterminated #ifdef/#ifndef");
    }

    return $output;
}

func print_usage() void {
    say("stradapp - Strada Preprocessor");
    say("");
    say("Usage: stradapp [options] input.strada");
    say("");
    say("Options:");
    say("  -o FILE       Write output to FILE (default: stdout)");
    say("  -D NAME       Define NAME as 1");
    say("  -D NAME=VAL   Define NAME as VAL");
    say("  -I PATH       Add PATH to include search path");
    say("  -h, --help    Show this help");
    say("");
    say("Supported directives:");
    say("  #define NAME [value]");
    say("  #undef NAME");
    say("  #ifdef NAME / #ifndef NAME");
    say("  #else / #endif");
    say("  #include \"file\" / #include <file>");
    say("  #error \"message\"");
    say("  #warning \"message\"");
}

func main(int $argc, array @argv) int {
    my str $input_file = "";
    my str $output_file = "";

    my int $i = 1;
    while ($i < $argc) {
        my str $arg = $argv[$i];

        if ($arg eq "-h" || $arg eq "--help") {
            print_usage();
            return 0;
        } elsif ($arg eq "-o") {
            $i++;
            if ($i >= $argc) {
                die("stradapp: -o requires an argument");
            }
            $output_file = $argv[$i];
        } elsif (starts_with($arg, "-D")) {
            my str $def = "";
            if (length($arg) > 2) {
                $def = substr($arg, 2);
            } else {
                $i++;
                if ($i >= $argc) {
                    die("stradapp: -D requires an argument");
                }
                $def = $argv[$i];
            }
            my int $eq_idx = index($def, "=");
            if ($eq_idx > 0) {
                my str $name = substr($def, 0, $eq_idx);
                my str $value = substr($def, $eq_idx + 1);
                $g_defines{$name} = $value;
            } else {
                $g_defines{$def} = "1";
            }
        } elsif (starts_with($arg, "-I")) {
            my str $path = "";
            if (length($arg) > 2) {
                $path = substr($arg, 2);
            } else {
                $i++;
                if ($i >= $argc) {
                    die("stradapp: -I requires an argument");
                }
                $path = $argv[$i];
            }
            push(@g_include_paths, $path);
        } elsif (substr($arg, 0, 1) eq "-") {
            die("stradapp: unknown option: " . $arg);
        } else {
            if ($input_file ne "") {
                die("stradapp: multiple input files not supported");
            }
            $input_file = $arg;
        }

        $i++;
    }

    if ($input_file eq "") {
        print_usage();
        return 1;
    }

    my str $result = preprocess($input_file);

    if ($output_file ne "") {
        spew($output_file, $result);
    } else {
        print($result);
    }

    return 0;
}
