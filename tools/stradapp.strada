# stradapp - Strada Preprocessor
#
# A simple C-style preprocessor for Strada
#
# Supported directives:
#   #define NAME [value]    - Define a macro (value defaults to 1)
#   #undef NAME             - Undefine a macro
#   #ifdef NAME             - Include following code if NAME is defined
#   #ifndef NAME            - Include following code if NAME is NOT defined
#   #else                   - Toggle the condition
#   #endif                  - End conditional block
#   #include "file"         - Include file relative to current file
#   #include <file>         - Include file from include paths
#   #error "message"        - Abort with error message
#   #warning "message"      - Print warning message
#
# Usage: stradapp input.strada > output.strada
#        stradapp input.strada -o output.strada
#        stradapp -DDEBUG input.strada
#
# Note: Macro substitution in code is not yet supported.
#       #define values only affect #ifdef/#ifndef checks.

my hash %g_defines = ();
my array @g_include_paths = ();

func starts_with(str $s, str $prefix) int {
    my int $plen = length($prefix);
    if (length($s) < $plen) {
        return 0;
    }
    return substr($s, 0, $plen) eq $prefix;
}

func is_ident_char(str $ch) int {
    my int $c = ord($ch);
    if (($c >= 97 && $c <= 122) || ($c >= 65 && $c <= 90) || ($c >= 48 && $c <= 57) || $c == 95) {
        return 1;
    }
    return 0;
}

# Extract directive word immediately following '#' (at index 1), or "" if none.
func directive_word(str $trimmed) str {
    my int $len = length($trimmed);
    my int $end = 1;
    while ($end < $len && is_ident_char(substr($trimmed, $end, 1)) == 1) {
        $end++;
    }
    if ($end == 1) {
        return "";
    }
    my str $w = substr($trimmed, 1, $end - 1);
    if ($end < $len) {
        my str $next = substr($trimmed, $end, 1);
        if ($next ne " " && $next ne "\t") {
            if (!($w eq "include" && ($next eq "\"" || $next eq "<"))) {
                return "";
            }
        }
    }
    return $w;
}

# Strip trailing '# ...' comments outside single/double-quoted literals.
func strip_pp_comment(str $s) str {
    my int $len = length($s);
    my int $i = 0;
    my int $in_dq = 0;
    my int $in_sq = 0;
    while ($i < $len) {
        my str $ch = substr($s, $i, 1);
        if ($in_dq == 1) {
            if ($ch eq "\\") {
                $i = $i + 2;
                next;
            }
            if ($ch eq "\"") {
                $in_dq = 0;
            }
        } elsif ($in_sq == 1) {
            if ($ch eq "\\") {
                $i = $i + 2;
                next;
            }
            if ($ch eq "'") {
                $in_sq = 0;
            }
        } else {
            if ($ch eq "\"") {
                $in_dq = 1;
            } elsif ($ch eq "'") {
                $in_sq = 1;
            } elsif ($ch eq "#") {
                return trim(substr($s, 0, $i));
            }
        }
        $i++;
    }
    return trim($s);
}

# Find '__C__' outside Strada string literals and '#' comments; returns index or -1.
func find_c_block_kw(str $line) int {
    my int $len = length($line);
    my int $i = 0;
    my int $in_dq = 0;
    my int $in_sq = 0;
    while ($i < $len) {
        my str $ch = substr($line, $i, 1);
        if ($in_dq == 1) {
            if ($ch eq "\\") { $i = $i + 2; next; }
            if ($ch eq "\"") { $in_dq = 0; }
            $i++;
            next;
        }
        if ($in_sq == 1) {
            if ($ch eq "\\") { $i = $i + 2; next; }
            if ($ch eq "'") { $in_sq = 0; }
            $i++;
            next;
        }
        if ($ch eq "\"") { $in_dq = 1; $i++; next; }
        if ($ch eq "'") { $in_sq = 1; $i++; next; }
        if ($ch eq "#") { return -1; }
        if ($i + 5 <= $len && substr($line, $i, 5) eq "__C__") {
            my int $prev_ok = 1;
            if ($i > 0 && is_ident_char(substr($line, $i - 1, 1)) == 1) {
                $prev_ok = 0;
            }
            my int $next_ok = 1;
            if ($i + 5 < $len) {
                my str $nc = substr($line, $i + 5, 1);
                if ($nc ne " " && $nc ne "\t" && $nc ne "{") {
                    $next_ok = 0;
                }
            }
            if ($prev_ok == 1 && $next_ok == 1) {
                return $i;
            }
        }
        $i++;
    }
    return -1;
}

func file_exists(str $path) int {
    my hash %stat = core::stat($path);
    return exists(%stat, "size");
}

func find_include(str $filename, str $current_dir) str {
    # Try relative to current file first
    my str $path = $current_dir . "/" . $filename;
    if (file_exists($path)) {
        return $path;
    }

    # Try include paths
    my int $i = 0;
    my int $n = size(@g_include_paths);
    while ($i < $n) {
        $path = $g_include_paths[$i] . "/" . $filename;
        if (file_exists($path)) {
            return $path;
        }
        $i++;
    }

    # Try current directory
    if (file_exists($filename)) {
        return $filename;
    }

    return "";
}

func preprocess(str $filename) str {
    my str $content = slurp($filename);
    if (!defined($content)) {
        die("stradapp: cannot read file: " . $filename);
    }

    my str $file_dir = core::dirname($filename);
    if ($file_dir eq "") {
        $file_dir = ".";
    }

    my array @lines = split("\n", $content);
    my str $output = "";
    my array @cond_stack = ();
    my int $active = 1;
    my int $in_c_block = 0;       # 0 = outside, 1 = inside {..}, 2 = saw __C__ awaiting {
    my int $c_block_depth = 0;
    my int $c_in_block_cmt = 0;
    my int $c_in_str = 0;
    my int $c_in_chr = 0;

    my int $i = 0;
    my int $num_lines = size(@lines);

    while ($i < $num_lines) {
        my str $line = $lines[$i];
        my str $trimmed = trim($line);
        # every input line yields an output line (blank when consumed: a
        # comment, a directive, an inactive branch) so compiler diagnostics
        # point at the right line of the original file
        my int $before = length($output);

        # Check for __C__ block start or continuation
        my int $c_scan_from = -1;
        if ($in_c_block != 0) {
            $c_scan_from = 0;
        } else {
            my int $kw_pos = find_c_block_kw($line);
            if ($kw_pos >= 0) {
                $in_c_block = 2;
                $c_block_depth = 0;
                $c_in_block_cmt = 0;
                $c_in_str = 0;
                $c_in_chr = 0;
                $c_scan_from = $kw_pos + 5;
            }
        }

        if ($c_scan_from >= 0) {
            my int $j = $c_scan_from;
            my int $llen = length($line);
            while ($j < $llen) {
                my str $ch = substr($line, $j, 1);
                if ($c_in_block_cmt == 1) {
                    if ($ch eq "*" && $j + 1 < $llen && substr($line, $j + 1, 1) eq "/") {
                        $c_in_block_cmt = 0;
                        $j = $j + 2;
                        next;
                    }
                    $j++;
                    next;
                }
                if ($c_in_str == 1) {
                    if ($ch eq "\\") { $j = $j + 2; next; }
                    if ($ch eq "\"") { $c_in_str = 0; }
                    $j++;
                    next;
                }
                if ($c_in_chr == 1) {
                    if ($ch eq "\\") { $j = $j + 2; next; }
                    if ($ch eq "'") { $c_in_chr = 0; }
                    $j++;
                    next;
                }
                if ($ch eq "/" && $j + 1 < $llen) {
                    my str $nch = substr($line, $j + 1, 1);
                    if ($nch eq "/") {
                        last;
                    }
                    if ($nch eq "*") {
                        $c_in_block_cmt = 1;
                        $j = $j + 2;
                        next;
                    }
                }
                if ($ch eq "\"") { $c_in_str = 1; $j++; next; }
                if ($ch eq "'") { $c_in_chr = 1; $j++; next; }
                if ($ch eq "{") {
                    if ($in_c_block == 2) {
                        $in_c_block = 1;
                        $c_block_depth = 1;
                    } else {
                        $c_block_depth++;
                    }
                } elsif ($ch eq "}" && $in_c_block == 1) {
                    $c_block_depth--;
                    if ($c_block_depth == 0) {
                        $in_c_block = 0;
                        last;
                    }
                }
                $j++;
            }
            # Pass through C code as-is
            if ($active) {
                $output = $output . $line . "\n";
            } else {
                $output = $output . "\n";
            }
            $i++;
            next;
        }

        if (substr($trimmed, 0, 1) eq "#") {
            if ($i == 0 && starts_with($trimmed, "#!")) {
                # Shebang (#!/usr/bin/env strada) on line 1: pass through untouched.
                if ($active) {
                    $output = $output . $line . "\n";
                }
            } else {
                my str $word = directive_word($trimmed);
                my str $raw_rest = "";
                if ($word ne "" && length($trimmed) > 1 + length($word)) {
                    $raw_rest = trim(substr($trimmed, 1 + length($word)));
                }

                if ($word eq "define") {
                    if ($active) {
                        my str $rest = strip_pp_comment($raw_rest);
                        if ($rest ne "") {
                            my int $ws_idx = -1;
                            my int $ri = 0;
                            while ($ri < length($rest)) {
                                my str $rch = substr($rest, $ri, 1);
                                if ($rch eq " " || $rch eq "\t") {
                                    $ws_idx = $ri;
                                    last;
                                }
                                $ri++;
                            }
                            my str $name = "";
                            my str $value = "1";
                            if ($ws_idx > 0) {
                                $name = substr($rest, 0, $ws_idx);
                                $value = trim(substr($rest, $ws_idx + 1));
                                if ($value eq "") { $value = "1"; }
                            } else {
                                $name = $rest;
                            }
                            $g_defines{$name} = $value;
                        }
                    }
                } elsif ($word eq "undef") {
                    if ($active) {
                        my str $name = strip_pp_comment($raw_rest);
                        if ($name ne "") {
                            delete(%g_defines, $name);
                        }
                    }
                } elsif ($word eq "ifdef") {
                    my str $name = strip_pp_comment($raw_rest);
                    push(@cond_stack, $active);
                    if ($active) {
                        $active = exists(%g_defines, $name);
                    }
                } elsif ($word eq "ifndef") {
                    my str $name = strip_pp_comment($raw_rest);
                    push(@cond_stack, $active);
                    if ($active) {
                        $active = !exists(%g_defines, $name);
                    }
                } elsif ($word eq "else") {
                    my str $extra = strip_pp_comment($raw_rest);
                    if ($extra eq "") {
                        if (size(@cond_stack) == 0) {
                            die("stradapp: " . $filename . ":" . ($i + 1) . ": #else without #ifdef/#ifndef");
                        }
                        my int $parent_active = $cond_stack[size(@cond_stack) - 1];
                        if ($parent_active) {
                            $active = !$active;
                        }
                    }
                } elsif ($word eq "endif") {
                    my str $extra = strip_pp_comment($raw_rest);
                    if ($extra eq "") {
                        if (size(@cond_stack) == 0) {
                            die("stradapp: " . $filename . ":" . ($i + 1) . ": #endif without #ifdef/#ifndef");
                        }
                        $active = pop(@cond_stack);
                    }
                } elsif ($word eq "include") {
                    if ($active) {
                        my str $rest = strip_pp_comment($raw_rest);
                        my str $inc_file = "";
                        if (substr($rest, 0, 1) eq "\"") {
                            my int $end = index(substr($rest, 1), "\"");
                            if ($end > 0) {
                                $inc_file = substr($rest, 1, $end);
                            }
                        } elsif (substr($rest, 0, 1) eq "<") {
                            my int $end = index(substr($rest, 1), ">");
                            if ($end > 0) {
                                $inc_file = substr($rest, 1, $end);
                            }
                        }
                        if ($inc_file eq "") {
                            die("stradapp: " . $filename . ":" . ($i + 1) . ": invalid #include syntax");
                        }
                        my str $inc_path = find_include($inc_file, $file_dir);
                        if ($inc_path eq "") {
                            die("stradapp: " . $filename . ":" . ($i + 1) . ": cannot find include file: " . $inc_file);
                        }
                        my str $inc_content = preprocess($inc_path);
                        $output = $output . $inc_content;
                    }
                } elsif ($word eq "error" && starts_with($raw_rest, "\"")) {
                    if ($active) {
                        my str $msg = strip_pp_comment($raw_rest);
                        if (length($msg) >= 2 && substr($msg, 0, 1) eq "\"" && substr($msg, length($msg) - 1, 1) eq "\"") {
                            $msg = substr($msg, 1, length($msg) - 2);
                        }
                        die("stradapp: " . $filename . ":" . ($i + 1) . ": error: " . $msg);
                    }
                } elsif ($word eq "warning" && starts_with($raw_rest, "\"")) {
                    if ($active) {
                        my str $msg = strip_pp_comment($raw_rest);
                        if (length($msg) >= 2 && substr($msg, 0, 1) eq "\"" && substr($msg, length($msg) - 1, 1) eq "\"") {
                            $msg = substr($msg, 1, length($msg) - 2);
                        }
                        warn("stradapp: " . $filename . ":" . ($i + 1) . ": warning: " . $msg);
                    }
                } else {
                    # Ordinary Strada comment (e.g. '# ...', '### banner', '#comment') — skip
                }
            }
        } else {
            if ($active) {
                $output = $output . $line . "\n";
            }
        }

        if (length($output) == $before) { $output = $output . "\n"; }
        $i++;
    }

    if (size(@cond_stack) > 0) {
        die("stradapp: " . $filename . ": unterminated #ifdef/#ifndef");
    }

    return $output;
}

func print_usage() void {
    say("stradapp - Strada Preprocessor");
    say("");
    say("Usage: stradapp [options] input.strada");
    say("");
    say("Options:");
    say("  -o FILE       Write output to FILE (default: stdout)");
    say("  -D NAME       Define NAME as 1");
    say("  -D NAME=VAL   Define NAME as VAL");
    say("  -I PATH       Add PATH to include search path");
    say("  -h, --help    Show this help");
    say("");
    say("Supported directives:");
    say("  #define NAME [value]");
    say("  #undef NAME");
    say("  #ifdef NAME / #ifndef NAME");
    say("  #else / #endif");
    say("  #include \"file\" / #include <file>");
    say("  #error \"message\"");
    say("  #warning \"message\"");
}

func main(int $argc, array @argv) int {
    my str $input_file = "";
    my str $output_file = "";

    my int $i = 1;
    while ($i < $argc) {
        my str $arg = $argv[$i];

        if ($arg eq "-h" || $arg eq "--help") {
            print_usage();
            return 0;
        } elsif ($arg eq "-o") {
            $i++;
            if ($i >= $argc) {
                die("stradapp: -o requires an argument");
            }
            $output_file = $argv[$i];
        } elsif (starts_with($arg, "-D")) {
            my str $def = "";
            if (length($arg) > 2) {
                $def = substr($arg, 2);
            } else {
                $i++;
                if ($i >= $argc) {
                    die("stradapp: -D requires an argument");
                }
                $def = $argv[$i];
            }
            my int $eq_idx = index($def, "=");
            if ($eq_idx > 0) {
                my str $name = substr($def, 0, $eq_idx);
                my str $value = substr($def, $eq_idx + 1);
                $g_defines{$name} = $value;
            } else {
                $g_defines{$def} = "1";
            }
        } elsif (starts_with($arg, "-I")) {
            my str $path = "";
            if (length($arg) > 2) {
                $path = substr($arg, 2);
            } else {
                $i++;
                if ($i >= $argc) {
                    die("stradapp: -I requires an argument");
                }
                $path = $argv[$i];
            }
            push(@g_include_paths, $path);
        } elsif (substr($arg, 0, 1) eq "-") {
            die("stradapp: unknown option: " . $arg);
        } else {
            if ($input_file ne "") {
                die("stradapp: multiple input files not supported");
            }
            $input_file = $arg;
        }

        $i++;
    }

    if ($input_file eq "") {
        print_usage();
        return 1;
    }

    my str $result = preprocess($input_file);

    if ($output_file ne "") {
        spew($output_file, $result);
    } else {
        print($result);
    }

    return 0;
}
